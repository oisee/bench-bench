+  const n = sql.length;
+  let out = "";
+  let from = 0; // everything up to `from` is copied verbatim
+  let i = 0;
+  while (i < n) {
+    const open = sql.indexOf("'", i);
+    if (open < 0) break;
+    let close = -1;
+    let lastPair = -1;
+    let p = open + 1;
+    while (p < n) {
+      const q = sql.indexOf("'", p);
+      if (q < 0) break; // no quote left: the literal cannot close
+      if (q + 1 < n && sql.charCodeAt(q + 1) === QUOTE) {
+        lastPair = q;
+        p = q + 2;
+      } else {
