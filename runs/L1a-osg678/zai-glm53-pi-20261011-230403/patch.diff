+
+  it("every literal in the statement is trimmed, not just the first", async () => {
+    const {trimLiterals} = await import("../tools/sql-literals.mjs");
+    expect(trimLiterals("INSERT INTO t VALUES ('a  ', 'b  ', 'c')")).to.equal("INSERT INTO t VALUES ('a', 'b', 'c')");
+  });
+
+  it("keeps leading and inner blanks, tabs and newlines, and empties a blank literal", async () => {
+    const {trimLiterals} = await import("../tools/sql-literals.mjs");
+    expect(trimLiterals("VALUES ('  a\tb\n  ')")).to.equal("VALUES ('  a\tb\n')");
+    expect(trimLiterals("VALUES ('')")).to.equal("VALUES ('')");
+    expect(trimLiterals("VALUES ('   ')")).to.equal("VALUES ('')");
+  });
+
+  it("survives a literal the size of a full TEXT row", async () => {
+    // A WRITE of a ~15-million-character string used to die here with
+    // `RangeError: Maximum call stack size exceeded`: the trailing-blank
+    // rule was a regular expression, and the engine keeps a backtracking
+    // choice per character of the literal. The scan that replaced it has
+    // to answer, not crash -- and in both directions: blanks to trim, and
+    // an unterminated fragment of quotes that must keep its shape.
+    const {trimLiterals} = await import("../tools/sql-literals.mjs");
+    const body = "x".repeat(15000000);
+    expect(trimLiterals("INSERT INTO t VALUES ('" + body + "   ')")).to.equal("INSERT INTO t VALUES ('" + body + "')");
+    expect(trimLiterals("'" + body + "  '")).to.equal("'" + body + "'");
+  });
 });
