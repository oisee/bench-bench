+ *  and stays linear in the length of the statement. */
 export function trimLiterals(sql) {
-  return sql.replace(/'((?:[^']|'')*)'/g, (m, inner) => "'" + inner.replace(/ +$/, "") + "'");
+  const n = sql.length;
+  let out = "";   // statement rebuilt so far
+  let copied = 0; // sql[..copied) is already in `out`, unchanged
+  let i = 0;      // where the search for the next literal resumes
+  while (i < n) {
+    const q = sql.indexOf("'", i);
+    if (q === -1) break;
+    // The closing quote is a `'` that does not open a `''` pair; a `'` in
+    // the very last position closes too. `lastPair` remembers the first
+    // quote of the newest pair, which is the quote the old expression
+    // backtracked to when a fragment ran out of string before it ran out
+    // of quotes -- `'a''` trimmed as `'a'` and left the tail alone.
+    let c = q + 1;
+    let lastPair = -1;
+    while (c < n) {
+      c = sql.indexOf("'", c);
+      if (c === -1) break;
+      if (c + 1 < n && sql.charCodeAt(c + 1) === 39) {
+        lastPair = c;
+        c += 2;
+      } else {
+        break;
+      }
+    }
+    if (lastPair !== -1 && (c === -1 || c === n)) c = lastPair;
+    if (c === -1 || c === n) {
+      // Nothing that closes here: this quote is data after all.
+      i = q + 1;
+      continue;
+    }
+    let end = c; // blanks stop here: only the run right before the closer
+    while (end > q + 1 && sql.charCodeAt(end - 1) === 32) end--;
+    out += sql.slice(copied, q) + "'" + sql.slice(q + 1, end) + "'";
+    copied = i = c + 1;
+  }
+  return copied === 0 ? sql : out + sql.slice(copied);
 }
 
