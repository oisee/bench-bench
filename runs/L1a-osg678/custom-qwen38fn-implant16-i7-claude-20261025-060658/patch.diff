+ *  what they meant.
+ *
+ *  Scanned by hand rather than with a regex: `/'((?:[^']|'')*)'/` overflowed
+ *  V8's regex backtracking stack on a 15-million-character literal (a media
+ *  row's hex payload), RangeError where a scan gives an answer. The pairing
+ *  rule is the regex's: inside a literal, `''` is content and the literal
+ *  ends at the next lone quote; a statement that ends inside a doubled
+ *  quote closes the literal at that pair's first quote, as the regex's
+ *  backtracking did.
+ */
 export function trimLiterals(sql) {
-  return sql.replace(/'((?:[^']|'')*)'/g, (m, inner) => "'" + inner.replace(/ +$/, "") + "'");
+  const n = sql.length;
+  let out = "";
+  let plain = 0; // start of the run of untouched characters
+  let i = 0;
+  while (i < n) {
+    if (sql[i] !== "'") { i++; continue; }
+    // Find the closing quote the regex would have taken: greedy over `''`
+    // pairs, so the first lone quote; else the first quote of the last pair.
+    let closed = -1;
+    let lastPair = -1;
+    for (let j = i + 1; j < n; j++) {
+      if (sql[j] !== "'") continue;
+      if (j + 1 < n && sql[j + 1] === "'") { lastPair = j; j++; continue; }
+      closed = j;
+      break;
+    }
+    if (closed < 0 && lastPair >= 0) closed = lastPair;
+    if (closed < 0) { i++; continue; } // a lone quote with no literal: text
+    if (i > plain) out += sql.slice(plain, i);
+    // Drop ordinary spaces at the end of the literal's content, keep one.
+    let end = closed;
+    while (end > i + 1 && sql[end - 1] === " ") end--;
+    out += "'" + sql.slice(i + 1, end) + "'";
+    i = closed + 1;
+    plain = i;
+  }
+  if (n > plain) out += sql.slice(plain);
+  return out;
 }
 
