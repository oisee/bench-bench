+
+  it("handles the empty and the blank-only literal", async () => {
+    const {trimLiterals} = await import("../tools/sql-literals.mjs");
+    expect(trimLiterals("VALUES ('', '   ', 'k')")).to.equal("VALUES ('', '', 'k')");
+  });
+
+  it("and a fifteen-million-character literal answers, it does not overflow the stack", async () => {
+    // The rule used to be a regex, /'((?:[^']|'')*)'/g, which pushes a
+    // backtracking frame per character: a media-sized literal died with
+    // "Maximum call stack size exceeded" long before the write ever reached
+    // an engine. The scan is one pass, so this case is also the guard that
+    // the quote handling of a long literal is still the quote handling.
+    const {trimLiterals} = await import("../tools/sql-literals.mjs");
+    const body = "x".repeat(15_000_000) + "''   ";
+    const sql = "INSERT INTO t (a, b) VALUES ('" + body + "', 42)";
+    expect(trimLiterals(sql)).to.equal("INSERT INTO t (a, b) VALUES ('" + body.replace(/ +$/, "") + "', 42)");
+  });
 });
