+
+  it("an empty literal and a literal of nothing but blanks become the empty literal", async () => {
+    const {trimLiterals} = await import("../tools/sql-literals.mjs");
+    expect(trimLiterals("INSERT INTO t VALUES ('', '   ')")).to.equal("INSERT INTO t VALUES ('', '')");
+  });
+
+  it("a tab or a newline before the closing quote is data, not padding", async () => {
+    const {trimLiterals} = await import("../tools/sql-literals.mjs");
+    expect(trimLiterals("VALUES ('a\t\n  ', 'b \t')")).to.equal("VALUES ('a\t\n', 'b \t')");
+  });
+
+  it("a double-quoted name does not hide a literal inside it", async () => {
+    // the regex never knew about `"`, and neither does the walk: SQL's
+    // identifier quotes are not string quotes, but telling them apart is
+    // the caller's job and always was
+    const {trimLiterals} = await import("../tools/sql-literals.mjs");
+    expect(trimLiterals(`SELECT "a 'b  ' c" FROM t`)).to.equal(`SELECT "a 'b' c" FROM t`);
+  });
+
+  it("a statement with several literals trims each one", async () => {
+    const {trimLiterals} = await import("../tools/sql-literals.mjs");
+    expect(trimLiterals("UPDATE t SET a = 'a  ', b = 'b' WHERE k = 'k  '"))
+      .to.equal("UPDATE t SET a = 'a', b = 'b' WHERE k = 'k'");
+  });
+
+  it("a literal that never closes ends at its last escaped quote, as before", async () => {
+    // the regex, unwinding, closed the fragment at the last `''` it could
+    // read as a closer -- the walk reproduces that reading of a broken tail
+    const {trimLiterals} = await import("../tools/sql-literals.mjs");
+    expect(trimLiterals("VALUES ('a  ''")).to.equal("VALUES ('a''");
+  });
+
+  it("and a literal of fifteen million characters is trimmed, not a stack overflow", async () => {
+    // `'((?:[^']|'')*)'` spends one backtracking choice per character of
+    // the literal and V8 keeps those on the call stack, so the regex
+    // answered this size with `RangeError: Maximum call stack size
+    // exceeded` (measured 2026-10-11). A seeded STRING column hands over
+    // its value whole, so the size is not hypothetical.
+    const {trimLiterals} = await import("../tools/sql-literals.mjs");
+    const body = "a".repeat(15_000_000);
+    expect(trimLiterals("INSERT INTO t VALUES ('" + body + "   ')"))
+      .to.equal("INSERT INTO t VALUES ('" + body + "')");
+  });
 });
