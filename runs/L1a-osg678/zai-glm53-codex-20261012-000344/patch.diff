  *  touched: a column name, a keyword and the spacing of the statement mean
  *  what they meant. */
 export function trimLiterals(sql) {
-  return sql.replace(/'((?:[^']|'')*)'/g, (m, inner) => "'" + inner.replace(/ +$/, "") + "'");
+  let result = "";
+  let keptFrom = 0;
+  let inLiteral = false;
+  let trailingSpaces = 0;
+  let index = 0;
+
+  while (index < sql.length) {
+    if (sql[index] !== "'") {
+      if (inLiteral && sql[index] === " ") trailingSpaces++;
+      else if (trailingSpaces !== 0) trailingSpaces = 0;
+      index++;
+      continue;
+    }
+
+    if (!inLiteral) {
+      result += sql.slice(keptFrom, index) + "'";
+      index++;
+      keptFrom = index;
+      trailingSpaces = 0;
+      inLiteral = true;
+      continue;
+    }
+
+    if (sql[index + 1] === "'") {
+      index += 2;
+      trailingSpaces = 0;
+      continue;
+    }
+
+    result += sql.slice(keptFrom, index - trailingSpaces) + "'";
+    index++;
+    keptFrom = index;
+    trailingSpaces = 0;
+    inLiteral = false;
+  }
+
+  return result + sql.slice(keptFrom);
 }
 
