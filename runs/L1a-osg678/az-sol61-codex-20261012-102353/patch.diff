+import assert from "node:assert/strict";
+import {trimLiterals} from "../tools/sql-literals.mjs";
+
+describe("SQL literal trimming", function () {
+  it("trims every literal and preserves statement spacing", () => {
+    assert.equal(trimLiterals("  VALUES ('  a b  ', 'it''s  ', '', '   ')  "),
+      "  VALUES ('  a b', 'it''s', '', '')  ");
+  });
+
+  it("preserves tabs, newlines, doubled quotes and Unicode", () => {
+    assert.equal(trimLiterals("'  λ\t\n😀 '' x\t \n  '"), "'  λ\t\n😀 '' x\t \n'");
+    assert.equal(trimLiterals("'x \t' 'x \n' 'x  ''y  '"), "'x \t' 'x \n' 'x  ''y'");
+  });
+
+  it("recognizes single quotes inside double quotes and preserves unmatched text", () => {
+    assert.equal(trimLiterals('"a \'b  \' c " \'unfinished  '), '"a \'b\' c " \'unfinished  ');
+    assert.equal(trimLiterals("'a  ''"), "'a''");
+    assert.equal(trimLiterals("'a  '''"), "'a  '''");
+  });
+
+  it("matches the original transformation on exhaustive short fragments", () => {
+    const original = sql => sql.replace(/'((?:[^']|'')*)'/g,
+      (match, inner) => "'" + inner.replace(/ +$/, "") + "'");
+    const alphabet = ["'", " ", "a", '"', "\n"];
+    function check(sql, remaining) {
+      assert.equal(trimLiterals(sql), original(sql), JSON.stringify(sql));
+      if (remaining > 0) for (const char of alphabet) check(sql + char, remaining - 1);
+    }
+    check("", 7);
+  });
+
+  it("trims a 15-million-character literal alongside other literals", () => {
+    const content = "x".repeat(15_000_000);
+    assert.equal(trimLiterals(`VALUES ('first  ', '  ${content}   ', 'last  ')`),
+      `VALUES ('first', '  ${content}', 'last')`);
+  });
+
+  it("handles a 15-million-space literal and a large unchanged literal", () => {
+    assert.equal(trimLiterals(`'${" ".repeat(15_000_000)}'`), "''");
+    const sql = `'${"x".repeat(15_000_000)}'`;
+    assert.equal(trimLiterals(sql), sql);
+  });
+
+  it("preserves doubled quotes throughout a very large literal", () => {
+    const content = "a '' b\t\n".repeat(2_000_000);
+    assert.equal(trimLiterals(`'${content}   '`), `'${content}'`);
+  });
+});
