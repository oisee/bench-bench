  *  touched: a column name, a keyword and the spacing of the statement mean
  *  what they meant. */
 export function trimLiterals(sql) {
-  return sql.replace(/'((?:[^']|'')*)'/g, (m, inner) => "'" + inner.replace(/ +$/, "") + "'");
+  const parts = [];
+  let copied = 0;
+  let open = sql.indexOf("'");
+  while (open !== -1) {
+    let close = sql.indexOf("'", open + 1);
+    let fallback = -1;
+    while (close !== -1 && sql[close + 1] === "'") {
+      fallback = close;
+      close = sql.indexOf("'", close + 2);
+    }
+    // The old greedy pattern backtracked to the last doubled quote when
+    // no later closing quote existed. Keep that behavior for fragments.
+    if (close === -1) close = fallback;
+    if (close === -1) break;
+
+    let end = close;
+    while (end > open + 1 && sql[end - 1] === " ") end--;
+    if (end < close) {
+      parts.push(sql.slice(copied, end));
+      copied = close;
+    }
+    open = sql.indexOf("'", close + 1);
+  }
+  if (parts.length === 0) return sql;
+  parts.push(sql.slice(copied));
+  return parts.join("");
 }
 
