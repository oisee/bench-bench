 export function trimLiterals(sql) {
-  return sql.replace(/'((?:[^']|'')*)'/g, (m, inner) => "'" + inner.replace(/ +$/, "") + "'");
+  const n = sql.length;
+  const out = [];
+  let i = 0;
+  let inLiteral = false;
+  let contentStart = -1;
+  let emitted = 0;
+
+  while (i < n) {
+    if (sql[i] === "'") {
+      if (!inLiteral) {
+        inLiteral = true;
+        contentStart = i + 1;
+        i += 1;
+        continue;
+      }
+      if (i + 1 < n && sql[i + 1] === "'") {
+        i += 2;
+        continue;
+      }
+      out.push(sql.slice(emitted, contentStart - 1), "'", sql.slice(contentStart, i).replace(/ +$/, ""), "'");
+      emitted = i + 1;
+      inLiteral = false;
+      i += 1;
+      continue;
+    }
+    i += 1;
+  }
+
+  out.push(sql.slice(emitted));
+  return out.join("");
 }
 
