-  return sql.replace(/'((?:[^']|'')*)'/g, (m, inner) => "'" + inner.replace(/ +$/, "") + "'");
+  const parts = [];
+  let copied = 0;
+  let from = 0;
+  for (;;) {
+    const open = sql.indexOf("'", from);
+    if (open < 0) break;
+    let close = -1;
+    let lastPair = -1;
+    for (let at = open + 1; ;) {
+      const q = sql.indexOf("'", at);
+      if (q < 0) { close = lastPair; break; }
+      if (sql.charCodeAt(q + 1) === 39) { lastPair = q; at = q + 2; continue; }
+      close = q;
+      break;
+    }
+    if (close < 0) break;
+    let end = close;
+    while (end > open + 1 && sql.charCodeAt(end - 1) === 32) end--;
+    if (end < close) {
+      parts.push(sql.slice(copied, end));
+      copied = close;
+    }
+    from = close + 1;
+  }
+  if (copied === 0) return sql;
+  parts.push(sql.slice(copied));
+  return parts.join("");
