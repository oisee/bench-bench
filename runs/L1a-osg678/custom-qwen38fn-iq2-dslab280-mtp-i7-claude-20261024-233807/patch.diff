+  const parts = [];
+  let i = 0;
+  while (i < sql.length) {
+    const open = sql.indexOf("'", i);
+    if (open < 0) { parts.push(sql.slice(i)); break; }
+    if (open > i) parts.push(sql.slice(i, open));
+    let j = open + 1;
+    while (j < sql.length) {
+      if (sql[j] === "'") {
+        if (j + 1 < sql.length && sql[j + 1] === "'") { j += 2; continue; } // an escaped quote, part of the content
+        break; // the closing quote
+      }
