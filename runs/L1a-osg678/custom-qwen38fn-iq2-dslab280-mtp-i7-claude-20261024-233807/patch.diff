+
+  // The same rule, several times in one statement, and at the sizes the
+  // regex form could not reach: it recursed once per character of a literal
+  // and answered "Maximum call stack size exceeded" at fifteen million.
+  // These fail on a regex that recurses and pass on one that scans.
+  it("each literal in a multi-literal statement is trimmed at its own end", async () => {
+    const {trimLiterals} = await import("../tools/sql-literals.mjs");
+    expect(trimLiterals("INSERT INTO t VALUES ('a  ', 'b  ')")).to.equal("INSERT INTO t VALUES ('a', 'b')");
+  });
+
+  it("empty and space-only literals, and blanks that are not ordinary spaces", async () => {
+    const {trimLiterals} = await import("../tools/sql-literals.mjs");
+    expect(trimLiterals("VALUES ('', ' ')")).to.equal("VALUES ('', '')");
+    expect(trimLiterals("VALUES ('a\t ')")).to.equal("VALUES ('a\t')");
+    expect(trimLiterals("VALUES ('a\n  ')")).to.equal("VALUES ('a\n')");
+  });
+
+  it("a double quote is just a character, not a second kind of literal", async () => {
+    const {trimLiterals} = await import("../tools/sql-literals.mjs");
+    // a single-quote pair inside a double-quoted identifier is still a literal
+    expect(trimLiterals('VALUES ("a\'b  \'c")')).to.equal('VALUES ("a\'b\'c")');
+    // an unpaired single quote opens nothing, so its blanks are not trailing and stay
+    expect(trimLiterals('VALUES ("it\'s  ")')).to.equal('VALUES ("it\'s  ")');
+  });
+
+  it("a fifteen-million-character literal completes without a stack overflow", async () => {
+    const {trimLiterals} = await import("../tools/sql-literals.mjs");
+    const body = "x".repeat(15_000_000);
+    expect(trimLiterals("INSERT INTO t VALUES ('" + body + "  ')")).to.equal("INSERT INTO t VALUES ('" + body + "')");
+    // the same length with escaped quotes inside, so the pairing is exercised too
+    const half = "a".repeat(7_500_000);
+    expect(trimLiterals("INSERT INTO t VALUES ('" + half + "''" + half + "  ')")).to.equal("INSERT INTO t VALUES ('" + half + "''" + half + "')");
+  });
