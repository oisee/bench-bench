-  return sql.replace(/'((?:[^']|'')*)'/g, (m, inner) => "'" + inner.replace(/ +$/, "") + "'");
+  const parts = [];
+  let copiedThrough = 0;
+
+  // Walk the input instead of capturing each literal in a regular expression.
+  // Large regex captures can overflow the JavaScript stack on long SQL values.
+  for (let opening = 0; opening < sql.length; opening++) {
+    if (sql.charCodeAt(opening) !== 39) continue;
+
+    let closing = -1;
+    let lastEscapedPair = -1;
+    for (let i = opening + 1; i < sql.length;) {
+      if (sql.charCodeAt(i) !== 39) {
+        i++;
+      } else if (i + 1 < sql.length && sql.charCodeAt(i + 1) === 39) {
+        // A doubled quote is content. Keep its position as a fallback because
+        // the old matcher backtracked to the first quote if no later closer
+        // existed (for example, a short quote-balanced fragment ending in '').
+        lastEscapedPair = i;
+        i += 2;
+      } else {
+        closing = i;
+        break;
+      }
+    }
+
+    if (closing === -1) closing = lastEscapedPair;
+    if (closing === -1) continue;
+
+    let contentEnd = closing;
+    while (contentEnd > opening + 1 && sql.charCodeAt(contentEnd - 1) === 32) contentEnd--;
+    parts.push(sql.slice(copiedThrough, contentEnd), sql.slice(closing, closing + 1));
+    copiedThrough = closing + 1;
+    opening = closing;
+  }
+
+  return copiedThrough === 0 ? sql : parts.join("") + sql.slice(copiedThrough);
