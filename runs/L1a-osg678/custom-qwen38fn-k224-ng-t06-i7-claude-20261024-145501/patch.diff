+ *  A quote that opens nothing is left alone, as the regex left it. */
 export function trimLiterals(sql) {
-  return sql.replace(/'((?:[^']|'')*)'/g, (m, inner) => "'" + inner.replace(/ +$/, "") + "'");
+  const n = sql.length;
+  let out = null; // pieces of the rewritten prefix, once there is one
+  let cut = 0;    // start of the verbatim region not yet emitted
+  let i = 0;
+  while (i < n) {
+    if (sql[i] !== "'") { i++; continue; }
+    // Walk the literal body: non-quotes and `''` pairs, until a lone quote
+    // closes it or the input ends.
+    let j = i + 1;
+    let lastPair = -1; // first quote of the last `''` pair walked
+    let closed = false;
+    while (j < n) {
+      if (sql[j] !== "'") { j++; continue; }
+      if (j + 1 < n && sql[j + 1] === "'") { lastPair = j; j += 2; continue; }
+      closed = true; // sql[j] is the closing quote
+      break;
+    }
+    const close = closed ? j : lastPair; // end of input: the pair's first quote, as the regex backtracked to it
+    if (close === -1) { i++; continue; } // no literal starts here
+    let end = close; // drop ordinary spaces only, at the tail
+    while (end > i + 1 && sql[end - 1] === " ") end--;
+    out = (out ?? "") + sql.slice(cut, i) + "'" + sql.slice(i + 1, end) + "'";
+    cut = close + 1;
+    i = close + 1;
+  }
+  if (out === null) return sql;
+  return out + sql.slice(cut);
