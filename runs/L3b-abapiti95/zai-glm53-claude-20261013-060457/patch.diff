+// structuralTypes lists the checker types that can give an object literal a
+// shape when no named lowered shape exists: the object constituents of its
+// contextual type (a declaration, a parameter, a return type or a union
+// member), then the checker's own type of the literal.
+func (l *lowerer) structuralTypes(n *ast.Node) []*checker.Type {
+	var out []*checker.Type
+	if t := l.ck.GetContextualType(n, 0); t != nil {
+		out = append(out, l.contextualShapeConstituents(n, t)...)
+	}
+	if t := l.ck.GetTypeAtLocation(n); t != nil {
+		out = append(out, t)
+	}
+	return out
+}
+
+// contextualShapeConstituents unwraps optional and union contextual types to
+// the object constituents a literal can construct. A single constituent is
+// the shape; in a union, only the constituents the literal can fill qualify
+// (the first wins): every property of the literal must be declared, and every
+// required property of the constituent must be provided — unless the literal
+// spreads, which may supply the rest.
+func (l *lowerer) contextualShapeConstituents(n *ast.Node, t *checker.Type) []*checker.Type {
+	if t == nil {
+		return nil
+	}
+	if t.IsUnion() {
+		var out []*checker.Type
+		for _, c := range t.AsUnionOrIntersectionType().Types() {
+			if c.Flags()&(checker.TypeFlagsUndefined|checker.TypeFlagsNull) != 0 {
+				continue
+			}
+			out = append(out, l.contextualShapeConstituents(n, c)...)
+		}
+		if len(out) <= 1 {
+			return out
+		}
+		names := literalPropertyNames(n)
+		spreads := literalHasSpread(n)
+		var covered []*checker.Type
+		for _, c := range out {
+			ok := true
+			for _, p := range l.ck.GetPropertiesOfType(c) {
+				if _, named := names[p.Name]; named {
+					continue
+				}
+				// A member the literal does not spell out must be optional;
+				// a spread may still supply it.
+				ok = ok && (spreads || p.Flags&ast.SymbolFlagsOptional != 0)
+			}
+			for name := range names {
+				if l.ck.GetPropertyOfType(c, name) == nil {
+					ok = false
+					break
+				}
+			}
+			if ok {
+				covered = append(covered, c)
+			}
+		}
+		return covered
+	}
+	if t.Flags()&checker.TypeFlagsObject == 0 {
+		return nil
+	}
+	return []*checker.Type{t}
+}
+
+// literalHasSpread reports whether an object literal has a spread property.
+func literalHasSpread(n *ast.Node) bool {
+	for _, p := range n.AsObjectLiteralExpression().Properties.Nodes {
+		if p.Kind == ast.KindSpreadAssignment {
+			return true
+		}
+	}
+	return false
+}
+
+// emptyConstructible reports whether an empty object literal can take t as
+// its shape: an empty map, or a lowered shape whose constructor accepts every
+// field absent.
+func (l *lowerer) emptyConstructible(t hir.Type) bool {
+	switch t.Kind {
+	case hir.OrderedMap:
+		return true
+	case hir.ClassRef:
+		c := shapeClassOf(l.out.Classes, t)
+		if c == nil || c.Ctor == nil {
+			return false
+		}
+		for _, p := range c.Ctor.Params {
+			if p.Type.Kind != hir.Optional {
+				return false
+			}
+		}
+		return true
+	}
+	return false
+}
+
+// literalPropertyNames lists the literal property names of an object literal
+// node (spread properties and computed names have none to match on).
+func literalPropertyNames(n *ast.Node) map[string]bool {
+	names := map[string]bool{}
+	for _, p := range n.AsObjectLiteralExpression().Properties.Nodes {
+		if p.Kind != ast.KindPropertyAssignment && p.Kind != ast.KindShorthandPropertyAssignment {
+			continue
+		}
+		if nm := p.Name(); nm != nil && (nm.Kind == ast.KindIdentifier || nm.Kind == ast.KindStringLiteral) {
+			names[nm.Text()] = true
+		}
+	}
+	return names
+}
+
 func (l *lowerer) indexValue(x *hir.Expr) *hir.Expr {
 	if x != nil && x.Type.Kind == hir.Number {
 		return &hir.Expr{Kind: hir.RuntimeOp, Node: x.Node, Op: "number.index", Type: hir.T(hir.I32), X: x}
