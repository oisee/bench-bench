--- /dev/null
+++ b/probe/main.go
@@ -0,0 +1,53 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"sort"
+	"strings"
+
+	"github.com/oisee/abapiti/tsfront"
+)
+
+func main() {
+	dir := os.Args[1]
+	files := append([]string{}, tsfront.EmbeddedRegistryClosure().Files()...)
+	files = append(files, tsfront.RegistryHarnessPath)
+	registry, err := tsfront.RegistryOverrides()
+	if err != nil {
+		panic(err)
+	}
+	lowering, err := tsfront.LowerRegistry(dir, files, registry, nil)
+	if err != nil {
+		fmt.Println("ERR:", err)
+		os.Exit(2)
+	}
+	byCat := map[string]int{}
+	examples := map[string][]string{}
+	for _, d := range lowering.Diagnostics {
+		byCat[d.Category]++
+		examples[d.Category] = append(examples[d.Category], d.Loc+" | "+d.Message)
+	}
+	var cats []string
+	for c := range byCat {
+		if !strings.HasPrefix(c, "note-") && c != "skipped-computed-name" {
+			cats = append(cats, c)
+		}
+	}
+	sort.Strings(cats)
+	for _, c := range cats {
+		fmt.Printf("%s: %d\n", c, byCat[c])
+		ex := examples[c]
+		sort.Strings(ex)
+		for _, e := range ex {
+			if strings.Contains(e, "object literal") {
+				fmt.Printf("  %s\n", e)
+			}
+		}
+	}
+	fmt.Printf("blocking: %d, verify: %d\n", len(lowering.Blocking), len(lowering.Verification))
+	// dump full blocking list for object literal categories
+	raw, _ := json.MarshalIndent(lowering.Blocking, "", " ")
+	os.WriteFile("/tmp/probe-blocking.json", raw, 0644)
+}
