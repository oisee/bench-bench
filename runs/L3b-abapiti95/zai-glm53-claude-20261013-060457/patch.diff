diff --git a/tsfront/testdata/anonshapes/probe.ts b/tsfront/testdata/anonshapes/probe.ts
new file mode 100644
index 0000000..0576c27
--- /dev/null
+++ b/tsfront/testdata/anonshapes/probe.ts
@@ -0,0 +1,111 @@
+// Object literals whose structural type has no named class or alias, in
+// every context the lowering supports. Every method observes its own result
+// so the differential sees plain strings; the oracle comes from running this
+// file under Node (oracle.json).
+
+export interface ReadableView {
+  readonly name: string;
+  readonly count: number;
+}
+
+export class Probe {
+  // A literal with no annotation at all.
+  public static plain(): string {
+    const x = {a: 1, b: "s"};
+    return x.b + x.a;
+  }
+
+  // Two literals with the same fields in different orders: one shape.
+  public static reordered(): string {
+    const x = {a: 1, b: "s"};
+    const y = {b: "t", a: 2};
+    return x.a + y.a + y.b;
+  }
+
+  // Assignment of a second literal to the same variable.
+  public static assigned(): string {
+    let x = {a: 1, b: "x"};
+    x = {a: 2, b: "y"};
+    return x.b + x.a;
+  }
+
+  // A literal as an argument of an inline shape parameter.
+  public static argument(): string {
+    return Probe.take({a: 7, b: "arg"});
+  }
+  private static take(x: {a: number, b: string}): string {
+    return x.b + x.a;
+  }
+
+  // A literal returned from a method with an inline shape result.
+  public static returned(): string {
+    return Probe.back().b + Probe.back().a;
+  }
+  private static back(): {a: number, b: string} {
+    return {b: "ret", a: 3};
+  }
+
+  // Nested anonymous structures.
+  public static nested(): string {
+    const x = {a: 1, inner: {c: 2, d: {e: true}}};
+    return x.a + x.inner.c + (x.inner.d.e ? "T" : "F");
+  }
+
+  // A contextual union: each literal picks its member by its properties.
+  // (The union itself lowers to the object root, whose member use stays a
+  // located diagnostic; the literals still construct their member shape.)
+  public static union(which: string): string {
+    const a: {kind: string, a: number} | {kind: string, b: string} = {kind: "ka", a: 1};
+    const b: {kind: string, a: number} | {kind: string, b: string} = {kind: "kb", b: "other"};
+    return (a === undefined ? "A" : "a") + (b === undefined ? "B" : "b") + which;
+  }
+
+  // A contextual optional: undefined is a legal value of the variable.
+  public static optional(): string {
+    const x: {a: number, b?: string} | undefined = {a: 4};
+    if (x === undefined) {
+      return "absent";
+    }
+    return x.a + (x.b === undefined ? "none" : x.b);
+  }
+
+  // The empty literal takes the contextual shape, all fields absent.
+  public static empty(): string {
+    const x: {a?: number, b?: string} = {};
+    return (x.a === undefined ? "A" : "a") + (x.b === undefined ? "B" : "b");
+  }
+
+  // Optional and readonly properties keep their information.
+  public static members(): string {
+    const x: {a?: number, readonly b: string} = {b: "ro"};
+    return x.b + (x.a === undefined ? "none" : "some");
+  }
+
+  // A readonly view and a mutable view of one layout are one shape.
+  public static readonlyView(): string {
+    const view: ReadableView = {name: "n", count: 2};
+    const plain = {count: 3, name: "m"};
+    return view.name + view.count + plain.name + plain.count;
+  }
+
+  // A record-like literal lowers to a map, not a class shape.
+  public static record(): string {
+    const r: {[key: string]: number} = {a: 1, b: 2};
+    return r["a"] + ":" + r["b"];
+  }
+
+  // An empty literal as the default of a record-typed operand.
+  public static recordDefault(): string {
+    const vars: {[key: string]: {n: number}} = {};
+    for (const k in vars || {}) {
+      return "full";
+    }
+    return "empty";
+  }
+
+  // An empty literal with no context at all.
+  public static emptyAlone(): string {
+    const x = {};
+    return x === undefined ? "absent" : "present";
+  }
+}
