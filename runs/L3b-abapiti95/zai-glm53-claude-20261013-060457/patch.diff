+package tsfront
+
+import (
+	"os"
+	"testing"
+
+	"github.com/oisee/abapiti/hir"
+)
+
+func TestZZDumpHIR(t *testing.T) {
+	dir := os.Getenv("ABAPITI_PROBE_WORK")
+	if dir == "" {
+		t.Skip("probe only")
+	}
+	files := append([]string{}, EmbeddedRegistryClosure().Files()...)
+	files = append(files, RegistryHarnessPath)
+	registry, _ := RegistryOverrides()
+	coverage, _ := EmbeddedReachability()
+	lowering, err := LowerRegistry(dir, files, registry, coverage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	os.WriteFile(os.Getenv("ABAPITI_PROBE_HIR"), []byte(hir.Dump(lowering.Prog)), 0644)
+}
