diff --git a/tsfront/anon_shapes_emit_test.go b/tsfront/anon_shapes_emit_test.go
new file mode 100644
index 0000000..8cb895a
--- /dev/null
+++ b/tsfront/anon_shapes_emit_test.go
@@ -0,0 +1,304 @@
+package tsfront
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/oisee/abapiti/hir"
+	"github.com/oisee/abapiti/hir/abap"
+)
+
+// lowerAnonShapes lowers the anonymous-shape fixture: object literals whose
+// structural type has no named class or alias, in every context the lowering
+// supports (assignment, argument, return value, nesting, contextual union and
+// optional, record-like, empty).
+func lowerAnonShapes(t *testing.T) *hir.Program {
+	t.Helper()
+	dir := "testdata/anonshapes"
+	p, err := Load(filepath.Join(dir, "tsconfig.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	prog, diags, err := p.Lower([]string{"probe.ts"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, d := range diags {
+		if !strings.HasPrefix(d.Category, "note-") {
+			t.Fatal(d)
+		}
+	}
+	if errs := hir.Verify(prog); len(errs) > 0 {
+		t.Fatal(errs)
+	}
+	return prog
+}
+
+// TestLowerAnonymousShapes checks the structural promises of anonymous object
+// literals: equivalent field layouts share one synthesized shape whatever
+// order the properties are written in, a readonly view is the same physical
+// shape as a mutable one, optional and readonly members keep their
+// information, and record-like literals lower to maps.
+func TestLowerAnonymousShapes(t *testing.T) {
+	prog := lowerAnonShapes(t)
+
+	shapes := map[string]*hir.Class{}
+	for _, c := range prog.Classes {
+		if strings.HasPrefix(c.Name, "shape.") {
+			shapes[c.Name] = c
+		}
+	}
+	// {a: number, b: string} in every property order: exactly one shape.
+	// (The all-optional {a?: number, b?: string} of empty() is a different
+	// physical layout and stays its own shape.)
+	var ab *hir.Class
+	for _, c := range shapes {
+		if len(c.Fields) == 2 && c.Fields[0].Name == "a" && c.Fields[1].Name == "b" &&
+			c.Fields[0].Type.Kind == hir.Number && c.Fields[1].Type.Kind == hir.String {
+			if ab != nil {
+				t.Fatalf("two shapes for {a: number, b: string}: %s and %s", ab.Name, c.Name)
+			}
+			ab = c
+		}
+	}
+	if ab == nil {
+		t.Fatal("no synthesized shape for {a: number, b: string}")
+	}
+	if ab.Ctor == nil || len(ab.Ctor.Params) != 2 {
+		t.Fatalf("shape %s has no constructing ctor", ab.Name)
+	}
+
+	// The readonly data interface is the shape of the mutable literal too:
+	// one physical layout, the fields record readonlyness.
+	var view *hir.Class
+	for _, c := range prog.Classes {
+		if c.Name == "probe.ts.ReadableView" {
+			view = c
+		}
+	}
+	if view == nil {
+		t.Fatal("data interface probe.ts.ReadableView was not lowered")
+	}
+	if len(view.Fields) != 2 || !view.Fields[0].Readonly || !view.Fields[1].Readonly {
+		t.Fatalf("ReadableView fields lost readonly: %+v", view.Fields)
+	}
+	for _, c := range shapes {
+		if len(c.Fields) == 2 && c.Fields[0].Name == "count" && c.Fields[1].Name == "name" {
+			t.Fatalf("a second shape %s was synthesized for the layout of ReadableView", c.Name)
+		}
+	}
+	// The {count, name} literal constructs the interface's own class.
+	if !constructsClass(prog, "probe.ts.Probe", "readonlyView", view.Name) {
+		t.Fatal("readonlyView does not construct probe.ts.ReadableView")
+	}
+
+	// Optional members stay optional: the {a?, b} shape carries one optional
+	// and one required field, and b keeps its readonly flag.
+	var members *hir.Class
+	for _, c := range shapes {
+		if len(c.Fields) == 2 && c.Fields[0].Name == "a" && c.Fields[1].Name == "b" &&
+			c.Fields[0].Type.Kind == hir.Optional && c.Fields[1].Type.Kind == hir.String {
+			members = c
+		}
+	}
+	if members == nil {
+		for _, c := range shapes {
+			if len(c.Fields) == 2 && c.Fields[0].Name == "a" && c.Fields[1].Name == "b" {
+				t.Logf("shape %s: %s %s", c.Name, c.Fields[0].Type.String(), c.Fields[1].Type.String())
+			}
+		}
+		t.Fatal("no shape with a?: number and b: string")
+	}
+	if !members.Fields[1].Readonly {
+		t.Fatalf("readonly member b lost its flag: %+v", members.Fields[1])
+	}
+
+	// The record-like literal lowers to a map, not a class shape: the
+	// method builds a string-keyed OrderedMap and constructs no shape.
+	if m := methodOf(prog, "probe.ts.Probe", "record"); m == nil {
+		t.Fatal("probe.ts.Probe.record is not lowered")
+	} else {
+		mapped, constructed := false, false
+		walkAnon(m.Body, func(x *hir.Expr) {
+			if x.Type.Kind == hir.OrderedMap && x.Type.Args[0].Kind == hir.String {
+				mapped = true
+			}
+			if x.Kind == hir.New && x.Type.Kind == hir.ClassRef && strings.HasPrefix(x.Type.Name, "shape.") {
+				constructed = true
+			}
+		})
+		if !mapped || constructed {
+			t.Fatalf("record literal: map=%v shape constructed=%v", mapped, constructed)
+		}
+	}
+}
+
+// TestEmitAnonymousShapesGo runs the lowered fixture on the Go backend and
+// compares every observation with the original TypeScript under Node.
+func TestEmitAnonymousShapesGo(t *testing.T) {
+	if _, err := exec.LookPath("node"); err != nil {
+		t.Skip("Node absent")
+	}
+	prog := lowerAnonShapes(t)
+	var cases []struct {
+		Method   string `json:"method"`
+		Argument string `json:"argument"`
+		Expected string `json:"expected"`
+	}
+	raw, err := os.ReadFile(filepath.Join("testdata", "anonshapes", "oracle.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(raw, &cases); err != nil {
+		t.Fatal(err)
+	}
+	if len(cases) != 15 {
+		t.Fatal("missing oracle cases")
+	}
+	main := "out:=[]string{};"
+	for _, c := range cases {
+		main += fmt.Sprintf("out=append(out,%s(%s).String());", goEntry("probe.ts.Probe", c.Method), c.Argument)
+	}
+	main += "b,_:=json.Marshal(out);fmt.Println(string(b))"
+	var got []string
+	if err := json.Unmarshal([]byte(runGoHIR(t, prog, main)), &got); err != nil {
+		t.Fatal(err)
+	}
+	for i, c := range cases {
+		if got[i] != c.Expected {
+			t.Errorf("%s(%s): got %q want %q", c.Method, c.Argument, got[i], c.Expected)
+		}
+	}
+}
+
+// TestEmitAnonymousShapesAbap emits the fixture through the ABAP backend and
+// attaches an ABAP Unit driver with the same oracle, following the other
+// fixture tests; CI runs it on osgo and OSG-JS.
+func TestEmitAnonymousShapesAbap(t *testing.T) {
+	prog := lowerAnonShapes(t)
+	files, names, err := abap.EmitNamed(prog)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for name, src := range files {
+		for _, line := range strings.Split(src, "\n") {
+			if len(line) > 255 {
+				t.Errorf("%s: line of %d bytes", name, len(line))
+			}
+		}
+	}
+	class := names.Get("probe.ts.Probe")
+	if class == "" {
+		t.Fatal("probe.ts.Probe was not emitted")
+	}
+	var cases []struct {
+		Method   string `json:"method"`
+		Argument string `json:"argument"`
+		Expected string `json:"expected"`
+	}
+	raw, err := os.ReadFile(filepath.Join("testdata", "anonshapes", "oracle.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(raw, &cases); err != nil {
+		t.Fatal(err)
+	}
+	var b strings.Builder
+	line := func(format string, args ...any) { fmt.Fprintf(&b, format+"\n", args...) }
+	line("CLASS ltcl_anon_shapes DEFINITION FOR TESTING DURATION SHORT RISK LEVEL HARMLESS.")
+	line("PRIVATE SECTION.")
+	line("METHODS observations FOR TESTING.")
+	line("ENDCLASS.")
+	line("CLASS ltcl_anon_shapes IMPLEMENTATION.")
+	line("METHOD observations.")
+	line("DATA actual TYPE string.")
+	for _, c := range cases {
+		if c.Argument != "" {
+			continue // the string-argument case is covered by the Go driver
+		}
+		line("actual = %s=>%s( ).", class, names.Get("member."+c.Method))
+		line("cl_abap_unit_assert=>assert_equals( act = actual exp = `%s` msg = `%s` ).", c.Expected, c.Method)
+	}
+	line("ENDMETHOD.")
+	line("ENDCLASS.")
+	driver := b.String()
+	formatABAP(&driver)
+	for _, l := range strings.Split(driver, "\n") {
+		if len(l) > 255 {
+			t.Errorf("driver: line of %d bytes", len(l))
+		}
+	}
+	files[class+".clas.testclasses.abap"] = driver
+	if out := os.Getenv("ABAPITI_TEST_OUT"); out != "" {
+		if err := os.MkdirAll(out, 0755); err != nil {
+			t.Fatal(err)
+		}
+		for name, src := range files {
+			if err := os.WriteFile(filepath.Join(out, name), []byte(src), 0644); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+}
+
+func methodOf(prog *hir.Program, class, method string) *hir.Method {
+	for _, c := range prog.Classes {
+		if c.Name != class {
+			continue
+		}
+		for _, m := range c.Methods {
+			if m.Name == method {
+				return m
+			}
+		}
+	}
+	return nil
+}
+
+// constructsClass reports whether a method's body constructs the class.
+func constructsClass(prog *hir.Program, class, method, constructed string) bool {
+	found := false
+	if m := methodOf(prog, class, method); m != nil {
+		walkAnon(m.Body, func(x *hir.Expr) {
+			if x.Kind == hir.New && x.Type.Kind == hir.ClassRef && x.Type.Name == constructed {
+				found = true
+			}
+		})
+	}
+	return found
+}
+
+// walkAnon visits every statement and expression of a body, Seq statements
+// included.
+func walkAnon(s *hir.Stmt, fn func(*hir.Expr)) {
+	if s == nil {
+		return
+	}
+	for _, x := range []*hir.Expr{s.X, s.Y} {
+		walkAnonExpr(x, fn)
+	}
+	walkAnon(s.Body, fn)
+	walkAnon(s.Else, fn)
+	for _, child := range s.List {
+		walkAnon(child, fn)
+	}
+}
+
+func walkAnonExpr(x *hir.Expr, fn func(*hir.Expr)) {
+	if x == nil {
+		return
+	}
+	fn(x)
+	walkAnonExpr(x.X, fn)
+	walkAnonExpr(x.Y, fn)
+	walkAnonExpr(x.Z, fn)
+	for _, a := range x.Args {
+		walkAnonExpr(a, fn)
+	}
+	walkAnon(x.Stmt, fn)
+}
