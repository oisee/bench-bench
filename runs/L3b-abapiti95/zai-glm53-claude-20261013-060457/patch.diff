@@ -0,0 +1,63 @@
+package main
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"os"
+	"sort"
+	"strings"
+
+	gohir "github.com/oisee/abapiti/hir/golang"
+	"github.com/oisee/abapiti/hir/abap"
+	"github.com/oisee/abapiti/tsfront"
+)
+
+func main() {
+	dir := os.Args[1]
+	files := append([]string{}, tsfront.EmbeddedRegistryClosure().Files()...)
+	files = append(files, tsfront.RegistryHarnessPath)
+	registry, _ := tsfront.RegistryOverrides()
+	coverage, _ := tsfront.EmbeddedReachability()
+	lowering, err := tsfront.LowerRegistry(dir, files, registry, coverage)
+	if err != nil {
+		panic(err)
+	}
+	if err := lowering.Err(); err != nil {
+		panic(err)
+	}
+	out, names, err := abap.EmitNamed(lowering.Prog)
+	if err != nil {
+		panic(err)
+	}
+	var keys []string
+	for k := range out {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	h := sha256.New()
+	for _, k := range keys {
+		fmt.Fprintf(h, "%s:%x;", k, sha256.Sum256([]byte(out[k])))
+	}
+	fmt.Printf("abap files=%d sha=%x\n", len(out), sha256.Sum256(h.Sum(nil)))
+	shapes := 0
+	for _, c := range lowering.Prog.Classes {
+		if strings.HasPrefix(c.Name, "shape.") {
+			shapes++
+		}
+	}
+	fmt.Printf("shapes=%d names=%x\n", shapes, sha256.Sum256([]byte(names.Get("src/rules/line_length.ts.LineLength"))))
+	gofiles, err := gohir.Emit(lowering.Prog)
+	if err != nil {
+		panic(err)
+	}
+	gh := sha256.New()
+	var gkeys []string
+	for k := range gofiles {
+		gkeys = append(gkeys, k)
+	}
+	sort.Strings(gkeys)
+	for _, k := range gkeys {
+		fmt.Fprintf(gh, "%s:%x;", k, sha256.Sum256([]byte(gofiles[k])))
+	}
+	fmt.Printf("go files=%d sha=%x\n", len(gofiles), sha256.Sum256(gh.Sum(nil)))
+}
diff --git a/probe/main.go b/probe/main.go
new file mode 100644
