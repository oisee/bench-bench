+package tsfront
+
+import (
+	"os"
+	"testing"
+
+)
+
+func TestZZSerialPerFile(t *testing.T) {
+	dir := os.Getenv("ABAPITI_PROBE_WORK")
+	if dir == "" {
+		t.Skip("probe only")
+	}
+	files := append([]string{}, EmbeddedRegistryClosure().Files()...)
+	files = append(files, RegistryHarnessPath)
+	registry, err := RegistryOverrides()
+	if err != nil {
+		t.Fatal(err)
+	}
+	coverage, err := EmbeddedReachability()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := LowerRegistry(dir, files, registry, coverage); err != nil {
+		t.Fatal(err)
+	}
+}
