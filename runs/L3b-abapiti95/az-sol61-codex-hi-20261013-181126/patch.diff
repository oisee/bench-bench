+func TestAnonymousObjectInferredRecord(t *testing.T) {
+	prog := lowerStatementsProbe(t, map[string]string{"probe.ts": `
+export class Probe {
+  static run(): number {
+    const key = "a";
+    const record = {[key as string]: 7};
+    const copy: Record<string, number> = {...record, b: 2};
+    return copy.a + copy.b + ({nested: {[key as string]: 3}}).nested.a;
+  }
+}`}, []string{"probe.ts"})
+	var maps int
+	for _, c := range prog.Classes {
+		for _, m := range c.Methods {
+			walkNumberStmt(m.Body, func(*hir.Stmt) {}, func(e *hir.Expr) {
+				if e.Kind == hir.RuntimeOp && e.Op == "map.set" {
+					maps++
+				}
+			})
+		}
+	}
+	if maps == 0 {
+		t.Fatal("record was forced into a class shape")
+	}
+	if _, err := abap.Emit(prog); err != nil {
+		t.Fatal(err)
+	}
+	got := runGoHIR(t, prog, fmt.Sprintf("fmt.Println(%s())", goEntry("probe.ts.Probe", "run")))
+	if got != "12\n" {
+		t.Fatalf("record literals: %q", got)
+	}
+}
