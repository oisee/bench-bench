new file mode 100644
index 0000000..d4b9ab0
--- /dev/null
+++ b/tsfront/object_literal_test.go
@@ -0,0 +1,218 @@
+package tsfront
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/oisee/abapiti/hir"
+	"github.com/oisee/abapiti/hir/abap"
+)
+
+func TestAnonymousObjectLiterals(t *testing.T) {
+	prog := lowerStatementsProbe(t, map[string]string{"probe.ts": `
+export class Probe {
+  static take(x: {a: number, b: string}): string { return x.b + x.a; }
+  static make() { return {b: "r", a: 3}; }
+  static spread() { return {...{b: "s", a: 8}, a: 9}; }
+  static run(): string {
+    let x = {a: 1, b: "x"};
+    x = {b: "y", a: 2};
+    const nested = {row: {b: "n", a: 4}, rows: [{a: 5, b: "v"}]};
+    return Probe.take({b: "z", a: 6}) + Probe.take(x) + Probe.take(Probe.make())
+      + Probe.take(nested.row) + Probe.take(nested.rows[0]) + Probe.take(Probe.spread());
+  }
+}`}, []string{"probe.ts"})
+	var rows int
+	for _, c := range prog.Classes {
+		if strings.HasPrefix(c.Name, "shape.") && len(c.Fields) == 2 && c.Fields[0].Name == "a" && c.Fields[1].Name == "b" {
+			rows++
+		}
+	}
+	if rows != 1 {
+		t.Fatalf("equivalent rows use %d shapes, want 1", rows)
+	}
+	if _, err := abap.Emit(prog); err != nil {
+		t.Fatal(err)
+	}
+	got := runGoHIR(t, prog, fmt.Sprintf("fmt.Println(%s())", goEntry("probe.ts.Probe", "run")))
+	if got != "z6y2r3n4v5s9\n" {
+		t.Fatalf("anonymous literals: %q", got)
+	}
+}
+
+func TestAnonymousObjectPropertyEvaluationOrder(t *testing.T) {
+	prog := lowerStatementsProbe(t, map[string]string{"probe.ts": `
+export class Probe {
+  static counter = 0;
+  static next(): number {Probe.counter++; return Probe.counter;}
+  static run(): number {
+    const x = {b: Probe.next(), a: Probe.next()};
+    const y = {b: Probe.next(), ...x, a: Probe.next()};
+    return x.a * 1000 + x.b * 100 + y.a * 10 + y.b + Probe.counter;
+  }
+}`}, []string{"probe.ts"})
+	if _, err := abap.Emit(prog); err != nil {
+		t.Fatal(err)
+	}
+	got := runGoHIR(t, prog, fmt.Sprintf("fmt.Println(%s())", goEntry("probe.ts.Probe", "run")))
+	if got != "2145\n" {
+		t.Fatalf("property evaluation order: %q", got)
+	}
+}
+
+func TestAnonymousObjectContext(t *testing.T) {
+	prog := lowerStatementsProbe(t, map[string]string{"probe.ts": `
+type Named = {readonly label: string, count?: number};
+export class Probe {
+  static optional(x: {readonly value?: number} | undefined): number { return x?.value ?? 0; }
+  static empty(): {readonly value?: number} { return {}; }
+  static union(): {value?: number} | {text: string} { return {}; }
+  static unionValue(): {value?: number} | {text: string} { return {text: "u"}; }
+  static unionByType(): {value: number} | {value: string} { return {value: "u"}; }
+  static record(): Record<string, {value?: number}> { return {a: {}, b: {value: 2}}; }
+  static run(): string {
+    let x: {readonly value?: number} | undefined = {};
+    x = {value: 3};
+    const nested: {child: {value?: number}, children: {value?: number}[]} = {child: {}, children: [{}]};
+    const named: Named = {label: "n"};
+    const empty = {};
+    const again = {};
+    const record: {[key: string]: number} = {a: 4};
+    return named.label + Probe.optional(x) + Probe.optional({}) + Probe.optional(Probe.empty())
+      + Probe.optional(nested.child) + Probe.optional(nested.children[0]) + record.a
+      + (Probe.record().b.value ?? 0);
+  }
+}`}, []string{"probe.ts"})
+	var empty int
+	for _, c := range prog.Classes {
+		if strings.HasPrefix(c.Name, "shape.") && len(c.Fields) == 0 {
+			empty++
+		}
+		if c.Name == "probe.ts.Named" && (!c.Fields[0].Readonly || c.Fields[1].Type.Kind != hir.Optional) {
+			t.Fatal("named shape lost readonly or optional properties")
+		}
+	}
+	if empty != 1 {
+		t.Fatalf("empty literals use %d shapes, want 1", empty)
+	}
+	if _, err := abap.Emit(prog); err != nil {
+		t.Fatal(err)
+	}
+	got := runGoHIR(t, prog, fmt.Sprintf("fmt.Println(%s())", goEntry("probe.ts.Probe", "run")))
+	if got != "n3000042\n" {
+		t.Fatalf("contextual literals: %q", got)
+	}
+}
+
+func TestAnonymousObjectReusesNamedShape(t *testing.T) {
+	prog := lowerStatementsProbe(t, map[string]string{"probe.ts": `
+interface Named {readonly z: string, a: number, extra?: boolean}
+export class Probe {
+  static make(): Named {return {a: 2, z: "n"};}
+  static run(): string {
+    const inferred = Probe.make();
+    const named: Named = {z: "m", a: 3};
+    return inferred.z + inferred.a + named.z + named.a;
+  }
+}`}, []string{"probe.ts"})
+	for _, c := range prog.Classes {
+		if strings.HasPrefix(c.Name, "shape.") {
+			t.Fatalf("named layout acquired a duplicate anonymous shape: %s", c.Name)
+		}
+		if c.Name == "probe.ts.Named" && (!c.Fields[0].Readonly || c.Fields[2].Type.Kind != hir.Optional) {
+			t.Fatal("named interface lost readonly or optional properties")
+		}
+	}
+	if _, err := abap.Emit(prog); err != nil {
+		t.Fatal(err)
+	}
+	got := runGoHIR(t, prog, fmt.Sprintf("fmt.Println(%s())", goEntry("probe.ts.Probe", "run")))
+	if got != "n2m3\n" {
+		t.Fatalf("named shape reuse: %q", got)
+	}
+}
+
+func TestAnonymousShapeIdentityIgnoresPropertyOrder(t *testing.T) {
+	var names []string
+	for _, literal := range []string{`{b: {y: "s", x: 1}, a: true}`, `{a: true, b: {x: 1, y: "s"}}`} {
+		prog := lowerStatementsProbe(t, map[string]string{"probe.ts": `export class Probe { static make() { return ` + literal + `; } }`}, []string{"probe.ts"})
+		for _, c := range prog.Classes {
+			if c.Name == "probe.ts.Probe" {
+				names = append(names, c.Methods[0].Result.Name)
+			}
+		}
+	}
+	if len(names) != 2 || names[0] != names[1] {
+		t.Fatalf("property order changed structural identity: %v", names)
+	}
+}
+
+func TestAnonymousReadonlyShapeViews(t *testing.T) {
+	prog := lowerStatementsProbe(t, map[string]string{"probe.ts": `
+export class Probe {
+  static readonly(x: {readonly a: number, readonly b?: string}): number {return x.a;}
+  static mutable(x: {b?: string, a: number}): number {x.a = 7; return x.a;}
+  static onlyReadonly(x: {readonly flag?: boolean}): boolean {return x.flag ?? false;}
+  static run(): number {
+    const x: {a: number, b?: string} = {a: 2, b: "x"};
+    Probe.mutable(x);
+    const readonly: Readonly<{a: number, b?: string}> = {b: "y", a: 3};
+    return Probe.readonly(x) + Probe.readonly(readonly);
+  }
+}`}, []string{"probe.ts"})
+	var views int
+	for _, c := range prog.Classes {
+		if !strings.HasPrefix(c.Name, "shape.") {
+			continue
+		}
+		if len(c.Fields) == 2 && c.Fields[0].Name == "a" && c.Fields[1].Type.Kind == hir.Optional {
+			views++
+		}
+		if len(c.Fields) == 1 && c.Fields[0].Name == "flag" && (!c.Fields[0].Readonly || c.Fields[0].Type.Kind != hir.Optional) {
+			t.Fatal("anonymous shape lost readonly or optional properties")
+		}
+	}
+	if views != 1 {
+		t.Fatalf("readonly and mutable views use %d shapes, want 1", views)
+	}
+	if _, err := abap.Emit(prog); err != nil {
+		t.Fatal(err)
+	}
+	got := runGoHIR(t, prog, fmt.Sprintf("fmt.Println(%s())", goEntry("probe.ts.Probe", "run")))
+	if got != "10\n" {
+		t.Fatalf("readonly views: %q", got)
+	}
+}
