+	c := shapeClassOf(l.out.Classes, t)
+	if c == nil || c.Ctor == nil {
+		return false
+	}
+	fields := make(map[string]hir.Type, len(c.Fields))
+	for _, f := range c.Fields {
+		fields[f.Name] = f.Type
+	}
+	for name := range keys {
+		if _, ok := fields[name]; !ok {
+			return false
+		}
+	}
+	for name, typ := range fields {
+		if !keys[name] && typ.Kind != hir.Optional {
+			return false
+		}
+	}
+	return true
+}
