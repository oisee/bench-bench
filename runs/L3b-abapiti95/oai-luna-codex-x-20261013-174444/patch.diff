+// equivalentShapeViews reports whether two synthesized class references carry
+// the same named fields. Field order and readonly/optional views do not change
+// the object identity used by HIR; the original constructed reference remains
+// the safe runtime representation.
+func (l *lowerer) equivalentShapeViews(a, b hir.Type) bool {
+	if a.Kind != hir.ClassRef || b.Kind != hir.ClassRef {
+		return false
+	}
+	isShape := func(name string) bool {
+		return strings.HasPrefix(name, "shape.") || l.shapeLike[name]
+	}
+	if !isShape(a.Name) || !isShape(b.Name) {
+		return false
+	}
+	ca, cb := l.classByName(a.Name), l.classByName(b.Name)
+	if ca == nil || cb == nil || len(ca.Fields) != len(cb.Fields) {
+		return false
+	}
+	fields := make(map[string]hir.Type, len(ca.Fields))
+	for _, f := range ca.Fields {
+		fields[f.Name] = f.Type
+	}
+	for _, f := range cb.Fields {
+		other, ok := fields[f.Name]
+		if !ok || !sameShapeFieldView(other, f.Type) {
+			return false
+		}
+	}
+	return true
+}
+
+func sameShapeFieldView(a, b hir.Type) bool {
+	for a.Kind == hir.Optional && len(a.Args) == 1 {
+		a = a.Args[0]
+	}
+	for b.Kind == hir.Optional && len(b.Args) == 1 {
+		b = b.Args[0]
+	}
+	return a.Equal(b)
+}
