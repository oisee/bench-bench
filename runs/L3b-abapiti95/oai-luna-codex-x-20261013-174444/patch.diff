+		var name string
+		var value *ast.Node
+		switch p.Kind {
+		case ast.KindShorthandPropertyAssignment:
+			if p.Name() == nil {
+				return false
+			}
+			name, value = p.Name().Text(), p.Name()
+		case ast.KindPropertyAssignment:
+			property := propertyNameNode(p)
+			if property == nil {
+				return false
+			}
+			if property.Kind == ast.KindComputedPropertyName {
+				var ok bool
+				name, ok = l.constantKeyName(property)
+				if !ok {
+					return false
+				}
+			} else {
+				name = property.Text()
+			}
+			value = p.Initializer()
+		default:
+			return false
+		}
+		want := l.ck.GetTypeOfPropertyOfType(target, name)
+		got := l.ck.GetTypeAtLocation(value)
+		if want == nil || got == nil || !l.ck.IsTypeAssignableTo(got, want) {
+			return false
+		}
+	}
+	return true
