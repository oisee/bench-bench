@@ -0,0 +1,105 @@
+package tsfront
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/oisee/abapiti/hir"
+	"github.com/oisee/abapiti/hir/abap"
+	"github.com/oisee/abapiti/hir/golang"
+)
+
+func TestAnonymousObjectLiteralLowering(t *testing.T) {
+	dir := t.TempDir()
+	for name, source := range map[string]string{
+		"tsconfig.json": `{"compilerOptions":{"strict":true,"target":"ES2022"},"include":["*.ts"]}`,
+		"input.ts": `export class Probe {
+ static consume(v: { left: number; right?: string }): string { return v.right || v.left.toString(); }
+ static argument(): string { return Probe.consume({ left: 1 }); }
+ static assignment(): number {
+  let value: { left: number; right?: string } = { left: 1 };
+  value = { left: 2, right: "two" };
+  return value.left;
+ }
+ static returned(flag: boolean): { value: number; label?: string } {
+  return flag ? { label: "x", value: 3 } : { value: 4, label: "y" };
+ }
+ static nested(): { outer: { count: number } } { return { outer: { count: 1 } }; }
+ static union(flag: boolean): { a: number } | { b: string } {
+  return flag ? { a: 1 } : { b: "x" };
+ }
+ static typedUnion(flag: boolean): { value: number; n?: string } | { value: string; s?: boolean } {
+  return flag ? { value: 1 } : { value: "x" };
+ }
+ static optional(flag: boolean): { item: { value: number } } | undefined {
+  return flag ? { item: { value: 3 } } : undefined;
+ }
+ static empty(): { a?: number; b?: string } { return {}; }
+ static record(): Record<string, number> { return { first: 1, second: 2 }; }
+ static readonlyView(): Readonly<{ x: number }> { return { x: 1 }; }
+ static mutableView() { return { x: 2 }; }
+ static inferred() { return { second: "s", first: 1 }; }
+ static reuse() {
+  const left = { first: 1, second: "a" };
+  const right = { second: "b", first: 2 };
+  return left.first + right.first;
+ }
+}`,
+	} {
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(source), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	prog, diags := lowerProbe(t, dir)
+	for _, d := range diags {
+		if !strings.HasPrefix(d.Category, "note-") {
+			t.Errorf("blocking diagnostic: %s", d)
+		}
+	}
+	if errs := hir.Verify(prog); len(errs) > 0 {
+		t.Fatalf("HIR verification: %v", errs)
+	}
+	reused, readonly, optional, xShapes := 0, false, false, 0
+	for _, c := range prog.Classes {
+		if len(c.Fields) == 2 {
+			fields := map[string]hir.Type{}
+			for _, f := range c.Fields {
+				fields[f.Name] = f.Type
+			}
+			if fields["first"].Kind == hir.Number && fields["second"].Kind == hir.String {
+				reused++
+			}
+		}
+		for _, f := range c.Fields {
+			if f.Name == "x" && f.Type.Kind == hir.Number && f.Readonly {
+				readonly = true
+			}
+			if f.Name == "x" && f.Type.Kind == hir.Number {
+				xShapes++
+			}
+			if f.Name == "label" && f.Type.Kind == hir.Optional && f.Type.Args[0].Kind == hir.String {
+				optional = true
+			}
+		}
+	}
+	if reused != 1 {
+		t.Fatalf("property order produced %d equivalent shapes, want one\n%s", reused, hir.Dump(prog))
+	}
+	if !readonly {
+		t.Fatalf("Readonly view was not retained on its shape\n%s", hir.Dump(prog))
+	}
+	if xShapes != 1 {
+		t.Fatalf("readonly and mutable views produced %d physical x shapes, want one\n%s", xShapes, hir.Dump(prog))
+	}
+	if !optional {
+		t.Fatalf("optional property was not retained on its shape\n%s", hir.Dump(prog))
+	}
+	if _, _, err := abap.EmitNamed(prog); err != nil {
+		t.Fatalf("ABAP emission: %v", err)
+	}
+	if _, err := golang.Emit(prog); err != nil {
+		t.Fatalf("Go emission: %v", err)
+	}
+}
