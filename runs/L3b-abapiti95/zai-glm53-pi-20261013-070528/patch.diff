+// emptyObjectLayout reports whether t is an anonymous object type with no
+// members of any kind: no properties, no index signatures and no call or
+// construct signatures. Only such a type is the empty structural shape;
+// callable or index-signature objects keep their own representation.
+func (l *lowerer) emptyObjectLayout(t *checker.Type) bool {
+	if t == nil || t.Alias() != nil {
+		return false
+	}
+	if sym := t.Symbol(); sym != nil {
+		// Only a literal's own anonymous symbol (or a transient one) carries
+		// no named identity; anything else is a named type of its own.
+		if sym.Flags&^(ast.SymbolFlagsObjectLiteral|ast.SymbolFlagsTypeLiteral|ast.SymbolFlagsTransient) != 0 {
+			return false
+		}
+	}
+	if len(l.ck.GetPropertiesOfType(t)) != 0 || len(l.ck.GetIndexInfosOfType(t)) != 0 {
+		return false
+	}
+	return len(l.ck.GetSignaturesOfType(t, checker.SignatureKindCall)) == 0 &&
+		len(l.ck.GetSignaturesOfType(t, checker.SignatureKindConstruct)) == 0
+}
