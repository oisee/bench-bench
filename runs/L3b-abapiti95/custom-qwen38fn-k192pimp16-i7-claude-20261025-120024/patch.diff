+// propertyReadonly reports the TypeScript readonlyness of a property symbol:
+// a `readonly` modifier on its declaration, or the readonly check flag the
+// checker carries for a const-context view (`as const`, Readonly<T>). It is
+// not part of the physical layout: a writable view of the same field layout
+// reuses the same shape class.
+func propertyReadonly(p *ast.Symbol) bool {
+	if p == nil {
+		return false
+	}
+	if p.CheckFlags&ast.CheckFlagsReadonly != 0 {
+		return true
+	}
+	if d := p.ValueDeclaration; d != nil {
+		return d.ModifierFlags()&ast.ModifierFlagsReadonly != 0
+	}
+	return false
