+func TestObjectLiteralOptionalAbsentArguments(t *testing.T) {
+	prog := lowerStatementsProbe(t, map[string]string{"probe.ts": `
+export class Probe {
+run(): number {
+const opt: {m?: number; n: string} = {n: "u"};
+return (opt.m ?? 0) + opt.n.length;
+}
+}`}, []string{"probe.ts"})
+	shapes := objectLiteralShapes(prog)
+	if len(shapes) != 1 {
+		t.Fatalf("optional shape count: %d", len(shapes))
+	}
+	fields := shapes[0].Fields
+	if len(fields) != 2 || fields[0].Type.Kind != hir.Optional {
+		t.Fatalf("shape fields: %v", fields)
+	}
+	var constructed *hir.Expr
+	for _, d := range objectLiteralVarDecls(objectLiteralMethod(prog, "run")) {
+		if d.X.Kind == hir.New {
+			constructed = d.X
+		}
+	}
+	if constructed == nil || len(constructed.Args) != 2 {
+		t.Fatalf("shape construction arguments: %v", constructed)
+	}
+	if constructed.Args[0] == nil || constructed.Args[0].Kind != hir.Lit ||
+		constructed.Args[0].Type.Kind != hir.Optional {
+		t.Error("absent optional argument is not an unassigned optional value")
+	}
+}
