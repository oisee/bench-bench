+// singleObjectConstituent finds the one object constituent of a union a
+// literal may fill: the tagged view of `{a: number} | string` names exactly
+// one shape, so the literal builds that value instead of a record.
+func (l *lowerer) singleObjectConstituent(t *checker.Type) *checker.Type {
+	if t == nil || !t.IsUnion() {
+		return nil
+	}
+	var found *checker.Type
+	for _, c := range t.AsUnionOrIntersectionType().Types() {
+		if c.Flags()&checker.TypeFlagsObject == 0 || l.ck.IsArrayType(c) {
+			continue
+		}
+		if found != nil {
+			return nil
+		}
+		found = c
+	}
+	return found
+}
