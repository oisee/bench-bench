+// absentOptionalArgs builds the constructor arguments of a shape an empty
+// literal fills: every parameter stays at its absent optional. It reports
+// false for a shape with a required field, which an empty literal cannot
+// construct.
+func absentOptionalArgs(c *hir.Class) ([]*hir.Expr, bool) {
+	if c == nil || c.Ctor == nil {
+		return nil, false
+	}
+	args := []*hir.Expr{}
+	for _, p := range c.Ctor.Params {
+		if p.Type.Kind != hir.Optional {
+			return nil, false
+		}
+		args = append(args, &hir.Expr{Kind: hir.Lit, Type: p.Type})
+	}
+	return args, true
+}
