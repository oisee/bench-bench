+func TestObjectLiteralRecordContextStaysMap(t *testing.T) {
+	prog := lowerStatementsProbe(t, map[string]string{"probe.ts": `
+export class Probe {
+run(): number {
+const rec: Record<string, number> = {"k1": 6, "k2": 7};
+const empty: Record<string, number> = {};
+return rec["k1"] + rec["k2"] + Object.keys(empty).length;
+}
+}`}, []string{"probe.ts"})
+	for _, c := range objectLiteralShapes(prog) {
+		for _, f := range c.Fields {
+			if f.Name == "k1" || f.Name == "k2" {
+				t.Fatalf("record literal forced into class shape %s", c.Name)
+			}
+		}
+	}
+	var maps int
+	for _, d := range objectLiteralVarDecls(objectLiteralMethod(prog, "run")) {
+		if d.Type.Kind == hir.OrderedMap {
+			maps++
+		}
+	}
+	if maps != 2 {
+		t.Errorf("record locals lowered as maps: %d", maps)
+	}
+}
