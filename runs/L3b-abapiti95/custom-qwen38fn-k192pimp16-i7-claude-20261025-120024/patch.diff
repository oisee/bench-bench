--- /dev/null
+++ b/tsfront/object_literal_regression_test.go
@@ -0,0 +1,257 @@
+package tsfront
+
+import (
+	"fmt"
+	"os/exec"
+	"strings"
+	"testing"
+
+	"github.com/oisee/abapiti/hir"
+	"github.com/oisee/abapiti/hir/abap"
+	gohir "github.com/oisee/abapiti/hir/golang"
+)
+
+func objectLiteralShapes(p *hir.Program) []*hir.Class {
+	var shapes []*hir.Class
+	for _, c := range p.Classes {
+		if strings.HasPrefix(c.Name, "shape.") {
+			shapes = append(shapes, c)
+		}
+	}
+	return shapes
+}
+
+func objectLiteralMethod(p *hir.Program, name string) *hir.Method {
+	for _, c := range p.Classes {
+		for _, m := range c.Methods {
+			if m.Name == name {
+				return m
+			}
+		}
+	}
+	return nil
+}
+
+func objectLiteralVarDecls(m *hir.Method) []*hir.Stmt {
+	var found []*hir.Stmt
+	var walk func(s *hir.Stmt)
+	walk = func(s *hir.Stmt) {
+		if s == nil {
+			return
+		}
+		if s.Kind == hir.VarDecl {
+			found = append(found, s)
+		}
+		switch s.Kind {
+		case hir.Block:
+			for _, x := range s.List {
+				walk(x)
+			}
+		case hir.If, hir.While:
+			walk(s.Body)
+			walk(s.Else)
+		case hir.ForEach:
+			walk(s.Body)
+		case hir.Try, hir.Finally:
+			walk(s.Body)
+			walk(s.Else)
+		}
+	}
+	walk(m.Body)
+	return found
+}
+
+func TestObjectLiteralEquivalentLayoutsShareShape(t *testing.T) {
+	prog := lowerStatementsProbe(t, map[string]string{"probe.ts": `
+export class Probe {
+run(): number {
+const a = {m: 1, n: "s"};
+const b = {n: "t", m: 2};
+const c = {m: 3, n: "u"} as const;
+return a.m + b.m + c.m + a.n.length + b.n.length + c.n.length;
+}
+}`}, []string{"probe.ts"})
+	shapes := objectLiteralShapes(prog)
+	if len(shapes) != 1 {
+		t.Fatalf("equivalent layouts synthesized %d shapes", len(shapes))
+	}
+	if len(shapes[0].Fields) != 2 {
+		t.Fatalf("shape fields: %v", shapes[0].Fields)
+	}
+	if _, err := abap.Emit(prog); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestObjectLiteralReadonlyKeepsLayout(t *testing.T) {
+	prog := lowerStatementsProbe(t, map[string]string{"probe.ts": `
+export class Probe {
+run(): number {
+const ro: {readonly p?: number; q: string} = {q: "v"};
+const mut: {p?: number; q: string} = {q: "w"};
+mut.p = 4;
+return ro.q.length + mut.q.length + (ro.p ?? 0) + (mut.p ?? 0);
+}
+}`}, []string{"probe.ts"})
+	shapes := objectLiteralShapes(prog)
+	if len(shapes) != 1 {
+		t.Fatalf("readonly view synthesized %d shapes", len(shapes))
+	}
+	fields := shapes[0].Fields
+	if len(fields) != 2 || fields[0].Name != "p" || fields[1].Name != "q" {
+		t.Fatalf("shape fields: %v", fields)
+	}
+	if !fields[0].Readonly {
+		t.Error("readonly property lost its marker")
+	}
+	if fields[1].Readonly {
+		t.Error("a writable property became readonly")
+	}
+	if fields[0].Type.Kind != hir.Optional || len(fields[0].Type.Args) != 1 ||
+		fields[0].Type.Args[0].Kind != hir.Number {
+		t.Errorf("optional field type %s", fields[0].Type)
+	}
+	if fields[1].Type.Kind != hir.String {
+		t.Errorf("field q type %s", fields[1].Type)
+	}
+}
+
+func TestObjectLiteralEmptyLiteralUsesContext(t *testing.T) {
+	prog := lowerStatementsProbe(t, map[string]string{"probe.ts": `
+export class Probe {
+static empty(): {} { return {}; }
+static take(v: {}): number { return 0; }
+static uni(v: {} | string): number { return typeof v === "string" ? 1 : 0; }
+static opt(v?: {}): number { return v === undefined ? -1 : 0; }
+run(): number {
+const bare = {};
+const list = [{}];
+const rec: Record<string, {}> = {a: {}, b: {}};
+const nested = {k: {}};
+const pair: [{}] = [{}];
+const pick = true ? {} : {};
+const held: {} = nested.k;
+return Probe.take(bare) + Probe.take(list[0]) + Probe.take(nested.k) + Probe.take(pair[0]) + Probe.take(pick) + Probe.take(held) + Probe.take(Probe.empty()) + Probe.take(rec["a"]) + Probe.uni({}) + Probe.opt({}) + Probe.opt();
+}
+}`}, []string{"probe.ts"})
+	if _, err := abap.Emit(prog); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := gohir.Emit(prog); err != nil {
+		t.Fatal(err)
+	}
+}
