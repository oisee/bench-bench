+package tsfront
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/oisee/abapiti/hir"
+	"github.com/oisee/abapiti/hir/abap"
+	"github.com/oisee/abapiti/hir/golang"
+)
+
+func TestStatementsAnonymousObjectShapes(t *testing.T) {
+	source := `
+export function direct(): { a: string; b?: number } {
+  return { a: "x" };
+}
+export function nested(): { outer: { a: string; b?: number } } {
+  return { outer: { b: 2, a: "x" } };
+}
+export function argument(x: { readonly a: string; b?: number }): string {
+  return x.a;
+}
+export function callArgument(): string {
+  return argument({ b: 3, a: "x" });
+}
+export function assignment(): { a: string; b?: number } {
+  let x: { a: string; b?: number };
+  x = { a: "x" };
+  return x;
+}
+export function optional(): { a: string; b?: number } | undefined {
+  return { a: "x" };
+}
+export function empty(): { a?: string } {
+  return {};
+}
+export function record(): Record<string, number> {
+  const values: Record<string, number> = {};
+  return values;
+}
+export function inferred(): string {
+  const value = { a: "x" };
+  value.a = "y";
+  return value.a;
+}
+export function satisfies(): { readonly a: string } {
+  return { a: "x" } satisfies { readonly a: string };
+}
+type Alias = { readonly a: string };
+export function namedAlias(value: Alias): string {
+  return value.a;
+}
+`
+	prog := lowerStatementsProbe(t, map[string]string{"probe.ts": source}, []string{"probe.ts"})
+	dump := hir.Dump(prog)
+	shapeCount := strings.Count(dump, "class shape.")
+	if shapeCount != 4 {
+		t.Fatalf("expected structural reuse, got %d shape classes:\n%s", shapeCount, dump)
+	}
+	for _, class := range prog.Classes {
+		if !strings.HasPrefix(class.Name, "shape.") {
+			continue
+		}
+		for _, field := range class.Fields {
+			if field.Name == "a" && field.Type.Kind == hir.String && !field.Readonly {
+				t.Fatalf("readonly metadata missing from %s.%s", class.Name, field.Name)
+			}
+		}
+	}
+	var aliasReadonly bool
+	for _, class := range prog.Classes {
+		if class.Name != "probe.ts.Alias" || len(class.Fields) != 1 {
+			continue
+		}
+		aliasReadonly = class.Fields[0].Readonly
+	}
+	if !aliasReadonly {
+		t.Fatal("named shape lost readonly metadata")
+	}
+	if _, err := abap.Emit(prog); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := golang.Emit(prog); err != nil {
+		t.Fatal(err)
+	}
+}
