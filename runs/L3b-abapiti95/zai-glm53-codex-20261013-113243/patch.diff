+func propertyIsReadonly(p *ast.Symbol) bool {
+	if p == nil {
+		return false
+	}
+	if p.CheckFlags&ast.CheckFlagsReadonly != 0 {
+		return true
+	}
+	for _, declaration := range p.Declarations {
+		if ast.HasModifier(declaration, ast.ModifierFlagsReadonly) {
+			return true
+		}
+	}
+	return false
+}
