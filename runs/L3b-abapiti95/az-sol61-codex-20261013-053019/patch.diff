+package tsfront
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/oisee/abapiti/hir"
+	"github.com/oisee/abapiti/hir/abap"
+)
+
+func TestAnonymousObjectShapes(t *testing.T) {
+	p := lowerStatementsProbe(t, map[string]string{"probe.ts": `
+ export function take(value: {name: string; count: number}): number { return value.count; }
+ export function inferred() { return {name: "result", count: 7}; }
+ export function empty(): {} { return {}; }
+ export function optional(value?: {count?: number}): {count?: number} { return value ?? {}; }
+ export function nested(): {child: {name:string}; rows: {count:number}[]} {
+   return {child: {name:"nested"}, rows: [{count:3}]};
+ }
+ export function choice(flag: boolean): {left: number} | {right: string} {
+   if (flag) return {left: 4};
+   return {right: "right"};
+ }
+ export function sameKey(): {value:string} | {value:number} { return {value:8}; }
+ export function emptyChoice(): {count?: number} | {name: string} { return {}; }
+ export class Probe {static run(): number {
+   let a = {name:"first", count:1};
+   a = {count:2, name:"second"};
+   const b = {count:3, name:"third"};
+   const c: {readonly count:number; readonly name:string} = a;
+   const d: Readonly<{count:number; name:string}> = b;
+   take({count:4, name:"argument"});
+   nested(); empty(); optional(); emptyChoice(); choice(true); sameKey();
+   return a.count + b.count + c.count + d.count + inferred().count;
+ }}
+ `}, []string{"probe.ts"})
+	count := 0
+	for _, c := range p.Classes {
+		if strings.HasPrefix(c.Name, "shape.") && len(c.Fields) == 2 && c.Fields[0].Name == "count" && c.Fields[1].Name == "name" {
+			count++
+		}
+	}
+	if count != 1 {
+		t.Fatalf("equivalent layouts produced %d shapes, want 1", count)
+	}
+	if _, err := abap.Emit(p); err != nil {
+		t.Fatal(err)
+	}
+	if got := runGoHIR(t, p, "fmt.Print("+goEntry("probe.ts.Probe", "run")+"());"); got != "17" {
+		t.Fatalf("got %q, want 17", got)
+	}
+}
+
+func TestAnonymousObjectReadonlyAndOptional(t *testing.T) {
+	p := lowerStatementsProbe(t, map[string]string{"probe.ts": `
+ export function make(): {readonly label:string; count?:number} {return {label:"value"};}
+ export function view(value: {label:string; count?:number}): {readonly label:string; count?:number} { return value; }
+ `}, []string{"probe.ts"})
+	var shape *hir.Class
+	for _, c := range p.Classes {
+		if strings.HasPrefix(c.Name, "shape.") {
+			if shape != nil {
+				t.Fatal("readonly view changed layout")
+			}
+			shape = c
+		}
+	}
+	if shape == nil {
+		t.Fatal("missing shape")
+	}
+	for _, f := range shape.Fields {
+		if f.Name == "label" && !f.Readonly {
+			t.Fatal("readonly property was lost")
+		}
+		if f.Name == "count" && f.Type.Kind != hir.Optional {
+			t.Fatal("optional property was lost")
+		}
+	}
+	if _, err := abap.Emit(p); err != nil {
+		t.Fatal(err)
+	}
+	runGoHIR(t, p, "fmt.Print(\"ok\");")
+}
+
+func TestAnonymousRecordLiteral(t *testing.T) {
+	p := lowerStatementsProbe(t, map[string]string{"probe.ts": `
+ type Row = {name:string};
+ export function computed(key:string) {return {[key]: {name:"c"}};}
+ export function build(): {[key:string]: Row} { return {a:{name:"a"}, b:{name:"b"}}; }
+ export class Probe {static run(): string {const key="c"; const rows: {[key:string]:Row} = {...build(), [key]: {name:"c"}}; const inferred = computed(key); return rows[key].name + inferred[key].name;}}
+ `}, []string{"probe.ts"})
+	if _, err := abap.Emit(p); err != nil {
+		t.Fatal(err)
+	}
+	if got := runGoHIR(t, p, "fmt.Print("+goEntry("probe.ts.Probe", "run")+"().String());"); got != "cc" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestAnonymousShapeEvaluationOrder(t *testing.T) {
+	p := lowerStatementsProbe(t, map[string]string{"probe.ts": `
+ export class Probe {
+   static counter: number = 0;
+   static next(): number {this.counter += 1; return this.counter;}
+   static run(): number {
+     const value = {z: this.next(), a: this.next()};
+     return value.z * 10 + value.a;
+   }
+ }`}, []string{"probe.ts"})
+	if _, err := abap.Emit(p); err != nil {
+		t.Fatal(err)
+	}
+	if got := runGoHIR(t, p, "fmt.Print("+goEntry("probe.ts.Probe", "run")+"());"); got != "12" {
+		t.Fatalf("got %q, want 12", got)
+	}
+}
