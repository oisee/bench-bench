diff --git a/tsfront/lower_class2.go b/tsfront/lower_class2.go
index 28dd507..4428d35 100644
--- a/tsfront/lower_class2.go
+++ b/tsfront/lower_class2.go
@@ -1,6 +1,8 @@
 package tsfront
 
 import (
+	"strings"
+
 	"github.com/oisee/abapiti/hir"
 	"github.com/oisee/abapiti/internal/tsgo/ast"
 	"github.com/oisee/abapiti/internal/tsgo/checker"
@@ -439,10 +441,64 @@ func (l *lowerer) recordImplements(src hir.Type, dst hir.Type) {
 
 // coerce adapts a value flowing into a target type: boxing into Dynamic,
 // recording implicit interface implementations.
+// shapeView reports whether two synthesized shape classes are two views of
+// one physical layout: same field names, each field type equal once an
+// optional reference is unwrapped (a reference and its optional view share
+// one slot; readonly is metadata only, not a slot). Plain objects have no
+// identity of their own, so the views alias the same storage.
+func (l *lowerer) shapeView(a, b hir.Type) bool {
+	if a.Kind != hir.ClassRef || b.Kind != hir.ClassRef || a.Name == b.Name {
+		return false
+	}
+	synthesized := func(name string) bool {
+		return strings.HasPrefix(name, "shape.") || l.shapeLike[name]
+	}
+	if !synthesized(a.Name) || !synthesized(b.Name) {
+		return false
+	}
+	ca, cb := l.classesByQualifiedName(a.Name), l.classesByQualifiedName(b.Name)
+	if ca == nil || cb == nil || ca.Ctor == nil || cb.Ctor == nil || len(ca.Fields) != len(cb.Fields) {
+		return false
+	}
+	unwrap := func(t hir.Type) hir.Type {
+		if t.Kind == hir.Optional && t.Args[0].IsRef() {
+			return t.Args[0]
+		}
+		return t
+	}
+	for _, f := range ca.Fields {
+		var other *hir.Field
+		for k := range cb.Fields {
+			if cb.Fields[k].Name == f.Name {
+				other = &cb.Fields[k]
+			}
+		}
+		if other == nil || !unwrap(f.Type).Equal(unwrap(other.Type)) {
+			return false
+		}
+	}
+	return true
+}
+
 func (l *lowerer) coerce(x *hir.Expr, dst hir.Type) *hir.Expr {
 	if x == nil {
 		return nil
 	}
+	// A value of one synthesized shape flowing into a layout-compatible
+	// view (a readonly or optional modifier differs): the view is unchecked
+	// aliasing of the same slots, not a conversion.
+	if x.Type.Kind == hir.ClassRef && dst.Kind == hir.ClassRef && l.shapeView(x.Type, dst) {
+		l.diagf(nil, "note-shape-view", "shape %s flows as layout-compatible shape %s", x.Type.Name, dst.Name)
+		return &hir.Expr{Kind: hir.Cast, Node: x.Node, Type: dst, X: x}
+	}
+	if x.Type.Kind == hir.ClassRef && dst.Kind == hir.Optional && dst.Args[0].Kind == hir.ClassRef &&
+		l.shapeView(x.Type, dst.Args[0]) {
+		l.diagf(nil, "note-shape-view", "shape %s flows as optional view of layout-compatible shape %s", x.Type.Name, dst.Args[0].Name)
+		return &hir.Expr{Kind: hir.Conditional, Type: dst,
