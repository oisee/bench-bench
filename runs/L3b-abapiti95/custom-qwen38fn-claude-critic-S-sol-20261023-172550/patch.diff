diff --git a/tsfront/anonliterals_test.go b/tsfront/anonliterals_test.go
new file mode 100644
index 0000000..22bd47b
--- /dev/null
+++ b/tsfront/anonliterals_test.go
@@ -0,0 +1,176 @@
+package tsfront
+
+import (
+	"context"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/oisee/abapiti/hir"
+	"github.com/oisee/abapiti/hir/abap"
+	golang "github.com/oisee/abapiti/hir/golang"
+)
+
+// Anonymous object literals: every literal whose structural type has no
+// named class or alias gets a synthesized shape; equivalent layouts (even
+// with the properties in a different order) share one shape, readonly views
+// keep the physical layout of their mutable shape, empty literals take the
+// contextual shape or the empty shape, and record-like literals stay maps.
+func TestLowerAnonymousObjectLiterals(t *testing.T) {
+	dir := "testdata/anonliterals"
+	p, err := Load(filepath.Join(dir, "tsconfig.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, d := range p.CheckerDiagnostics(context.Background()) {
+		if d.Category == "error" {
+			t.Fatalf("checker: %s %s: %s", d.Category, d.Loc, d.Message)
+		}
+	}
+	prog, diags, err := p.Lower([]string{"probe.ts"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, d := range diags {
+		if !strings.HasPrefix(d.Category, "note-") {
+			t.Errorf("blocking diagnostic: %s", d)
+		}
+	}
+	if errs := hir.Verify(prog); len(errs) > 0 {
+		for _, e := range errs {
+			t.Errorf("verify: %s", e)
+		}
+	} else {
+		if _, _, err := abap.EmitNamed(prog); err != nil {
+			t.Errorf("abap emit: %v", err)
+		}
+		if _, err := golang.Emit(prog); err != nil {
+			t.Errorf("go emit: %v", err)
+		}
+	}
+
+	// One shape per field layout, regardless of property order.
+	layoutCount := map[string]int{}
+	readonlyLayout := ""
+	emptyShapes := 0
+	for _, c := range prog.Classes {
+		if !strings.HasPrefix(c.Name, "shape.") {
+			continue
+		}
+		names := make([]string, 0, len(c.Fields))
+		for _, f := range c.Fields {
+			names = append(names, f.Name+":"+kindKey(f.Type))
+		}
+		sort.Strings(names)
+		key := strings.Join(names, ";")
+		layoutCount[key]++
+		if len(c.Fields) == 0 {
+			emptyShapes++
+		}
+		if len(c.Fields) == 2 && c.Fields[0].Readonly && c.Fields[1].Readonly {
+			readonlyLayout = key
+			// Readonly views merge into the shared layout and the flag
+			// survives there: {readonly jn, readonly qs} from the roFn
+			// parameter (both orders), and the Orig fields seen through
+			// Readonly<Orig>.
+			for _, f := range c.Fields {
+				switch f.Name {
+				case "jn", "qs", "oa", "os":
+				default:
+					t.Errorf("unexpected readonly shape %s: %v", c.Name, c.Fields)
+				}
+			}
+		}
+	}
+	for _, want := range []string{
+		`pa:num;pb:str`, // p1/p2: one shape for both orders
+		`jn:num;qs:str`, // the readonly view, both orders
+		`x:num;y:num`,   // top1/top2: one shape for both orders
+	} {
+		if layoutCount[want] != 1 {
+			t.Errorf("layout %q lowered to %d shapes, want 1", want, layoutCount[want])
+		}
+	}
+	if readonlyLayout == "" {
+		t.Errorf("the readonly view kept no readonly property information")
+	}
+	if emptyShapes != 1 {
+		t.Errorf("%d empty shapes, want 1", emptyShapes)
+	}
+	// Record-like literals never become a class shape.
+	for _, c := range prog.Classes {
+		if !strings.HasPrefix(c.Name, "shape.") {
+			continue
+		}
+		names := make([]string, 0, len(c.Fields))
+		for _, f := range c.Fields {
+			names = append(names, f.Name+":"+kindKey(f.Type))
+		}
+		if strings.Join(names, ";") == "a:num;b:num;c:num" {
+			t.Errorf("record-like literal forced into class shape %s: %v", c.Name, c.Fields)
+		}
+	}
+
+	// Metadata and layout invariants of the merged views.
+	readonlyQ := 0
+	optionalZ := 0
+	dynItems := 0
+	for _, c := range prog.Classes {
+		if !strings.HasPrefix(c.Name, "shape.") {
+			continue
+		}
+		if len(c.Fields) == 1 && c.Fields[0].Name == "s" {
+			t.Errorf("record spread with an added key forced into class shape %s", c.Name)
+		}
+		if len(c.Fields) == 1 && c.Fields[0].Name == "1" {
+			t.Errorf("numeric record key forced into class shape %s", c.Name)
+		}
+		if len(c.Fields) != 1 {
+			continue
+		}
+		f := c.Fields[0]
+		switch {
+		case f.Name == "q" && kindKey(f.Type) == "num":
+			if !f.Readonly {
+				t.Errorf("the readonly view of {q} lost the readonly flag (%s)", c.Name)
+			}
+			readonlyQ++
+		case f.Name == "z":
+			if f.Type.Kind != hir.Optional {
+				t.Errorf("the optional view of {z} lost its optionality (%s: %s)", c.Name, f.Type.String())
+			}
+			optionalZ++
+		case f.Name == "items" && f.Type.Kind == hir.Array:
+			if f.Type.Args[0].Kind == hir.Void {
+				t.Errorf("empty array field kept a void element (%s)", c.Name)
+			}
+			dynItems++
+		}
+	}
+	if readonlyQ != 1 {
+		t.Errorf("%d shapes for {q}, want 1 shared layout", readonlyQ)
+	}
+	if optionalZ != 1 {
+		t.Errorf("%d shapes for {z}, want 1 shared reference storage", optionalZ)
+	}
+	if dynItems != 1 {
+		t.Errorf("%d shapes for {items: []}, want 1", dynItems)
+	}
+}
+
+// kindKey names a type layout slot, ignoring the integer-range
+// specialization of numeric storage.
+func kindKey(t hir.Type) string {
+	switch t.Kind {
+	case hir.Number, hir.I32, hir.I64:
+		return "num"
+	case hir.String:
+		return "str"
+	case hir.Bool:
+		return "bool"
+	case hir.Optional:
+		return "opt"
+	}
+	return string(t.Kind)
+}
diff --git a/tsfront/critic_repro_test.go b/tsfront/critic_repro_test.go
