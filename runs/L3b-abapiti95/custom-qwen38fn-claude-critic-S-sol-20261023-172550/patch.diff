index 0000000..7f93b97
--- /dev/null
+++ b/tsfront/critic_repro_test.go
@@ -0,0 +1,192 @@
+package tsfront
+
+import (
+	"context"
+	"os"
+	"fmt"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/oisee/abapiti/hir"
+	"github.com/oisee/abapiti/hir/abap"
+	golang "github.com/oisee/abapiti/hir/golang"
+)
+
+// Temporary critic reproduction harness.
+func runCritic(t *testing.T, name, src string) *hir.Program {
+	t.Helper()
+	dir := filepath.Join(t.TempDir(), name)
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "input.ts"), []byte(src), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	cfg := `{"compilerOptions":{"strict":true,"target":"es2020"},"files":["input.ts"]}`
+	if err := os.WriteFile(filepath.Join(dir, "tsconfig.json"), []byte(cfg), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	p, err := Load(filepath.Join(dir, "tsconfig.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, d := range p.CheckerDiagnostics(context.Background()) {
+		if d.Category == "error" {
+			t.Fatalf("checker: %s: %s", d.Loc, d.Message)
+		}
+	}
+	prog, diags, err := p.Lower([]string{"input.ts"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, d := range diags {
+		if !strings.HasPrefix(d.Category, "note-") {
+			t.Errorf("blocking: %s", d)
+		} else {
+			t.Logf("note: %s", d)
+		}
+	}
+	if t.Failed() {
+		return nil
+	}
+	if errs := hir.Verify(prog); len(errs) > 0 {
+		for _, e := range errs {
+			t.Errorf("verify: %s", e)
+		}
+		return nil
+	}
+	if _, _, err := abap.EmitNamed(prog); err != nil {
+		t.Errorf("abap emit: %v", err)
+	}
+	if _, err := golang.Emit(prog); err != nil {
+		t.Errorf("go emit: %v", err)
+	}
+	return prog
+}
+
+func TestCritic1EmptyArrayField(t *testing.T) {
+	runCritic(t, "c1", `
+export const box = { items: [] };
+export const size = box.items.length;
+`)
+}
+
+func TestCritic2RecordSpread(t *testing.T) {
+	runCritic(t, "c2", `
+export const rec: Record<string, number> = { a: 1 };
+export const copy = { ...rec, s: 2 };
+`)
+}
+
+func TestCritic2Probe(t *testing.T) {
+	dir := t.TempDir()
+	os.WriteFile(filepath.Join(dir, "input.ts"), []byte(`
+export const rec: Record<string, number> = { a: 1 };
+export const plain = { ...rec };
+export const copy = { ...rec, s: 2 };
+`), 0o644)
+	os.WriteFile(filepath.Join(dir, "tsconfig.json"), []byte(`{"compilerOptions":{"strict":true,"target":"es2020"},"files":["input.ts"]}`), 0o644)
+	p, err := Load(filepath.Join(dir, "tsconfig.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, diags, err := p.Lower([]string{"input.ts"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, d := range diags {
+		t.Logf("diag: %s", d)
+	}
+}
+
+func TestCritic3NumericKey(t *testing.T) {
+	runCritic(t, "c3", `
+export const rec: Record<string, number> = { 1: 2 };
+export const value = rec["1"];
+`)
+}
+
+func TestCritic4ReadonlyReuse(t *testing.T) {
+	both := func(order int) {
+		src := `
+export const mutable: { x: number } = { x: 1 };
+export const readonlyv: { readonly x: number } = { x: 2 };
+export const value = readonlyv.x + mutable.x;
+`
+		if order == 1 {
+			src = `
+export const readonlyv: { readonly x: number } = { x: 2 };
+export const mutable: { x: number } = { x: 1 };
+export const value = readonlyv.x + mutable.x;
+`
+		}
+		prog := runCritic(t, fmt.Sprintf("c4-%d", order), src)
+		if prog == nil {
+			return
+		}
+		shapes := 0
+		for _, c := range prog.Classes {
+			if strings.HasPrefix(c.Name, "shape.") && len(c.Fields) == 1 && c.Fields[0].Name == "x" {
+				shapes++
+				if !c.Fields[0].Readonly {
+					t.Errorf("order %d: readonly view lost: %s x readonly=%v", order, c.Name, c.Fields[0].Readonly)
+				}
+			}
+		}
+		if shapes != 1 {
+			t.Errorf("order %d: %d x-shapes, want 1 (shared layout)", order, shapes)
+		}
+	}
+	both(0)
+	both(1)
+}
+
+func TestCritic5OptionalReuse(t *testing.T) {
+	both := func(order int) {
+		src := `
+export const present = { x: { y: 1 } };
+export const missing: { x?: { y: number } } = {};
+export function read(): number { return missing.x?.y ?? 9; }
+`
+		if order == 1 {
+			src = `
+export const missing: { x?: { y: number } } = {};
+export const present = { x: { y: 1 } };
+export function read(): number { return missing.x?.y ?? 9; }
+`
+		}
+		prog := runCritic(t, fmt.Sprintf("c5-%d", order), src)
+		if prog == nil {
+			return
+		}
+		found := false
+		for _, c := range prog.Classes {
+			if strings.HasPrefix(c.Name, "shape.") && len(c.Fields) == 1 && c.Fields[0].Name == "x" {
+				found = true
+				if c.Fields[0].Type.Kind != hir.Optional {
+					t.Errorf("order %d: optional view lost: %s x kind=%v", order, c.Name, c.Fields[0].Type.Kind)
+				}
+			}
+		}
+		if !found {
+			t.Errorf("order %d: no x shape found", order)
+		}
+	}
+	both(0)
+	both(1)
+}
+
+func TestCriticProbeEmptyArray(t *testing.T) {
+	runCritic(t, "ea", `
+export const xs: string[] = [];
+export const n = xs.length;
+export const ys = [] as string[];
+export const m = ys.length;
+`)
+	runCritic(t, "eb", `
+export interface Bag { items: never[] }
+export const box: Bag = { items: [] };
+export const size = box.items.length;
+`)
+}
