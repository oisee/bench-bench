+package tsfront
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestDumpProbe(t *testing.T) {
+	p, err := Load(filepath.Join("testdata/anonliterals", "tsconfig.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, diags, err := p.Lower([]string{"probe.ts"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, d := range diags {
+		t.Logf("diag: %s", d)
+	}
+	prog, diags2, err := p.Lower([]string{"probe.ts"})
+	for _, d := range diags2 {
+		if strings.Contains(d.Category, "append") || strings.Contains(d.Message, "e12bad") {
+			t.Logf("diag2: %s", d)
+		}
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, c := range prog.Classes {
+		if len(c.Fields) == 0 {
+			continue
+		}
+		if c.Name == "shapeQ.e12bad578c217ae42ff71635e16a980b0c272d93726cb0aae13cf2e5a9154806" {
+			t.Logf("FULL class %s node=%v ctor=%v fields=%d", c.Name, c.Node.Source, c.Ctor != nil, len(c.Fields))
+			if c.Ctor != nil {
+				for _, pa := range c.Ctor.Params {
+					t.Logf("  param %s %s", pa.Name, pa.Type.String())
+				}
+			}
+			for _, f := range c.Fields {
+				t.Logf("  field %s type=%s ro=%v src=%v", f.Name, f.Type.String(), f.Readonly, f.Node.Source)
+			}
+		}
+		for _, f := range c.Fields {
+			if f.Name == "q" || f.Name == "z" || f.Name == "s" || f.Name == "items" {
+				t.Logf("class %s field %s type=%s ro=%v src=%v", c.Name, f.Name, f.Type.String(), f.Readonly, f.Node.Source)
+			}
+		}
+	}
+}
