+func TestAnonymousObjectLiterals(t *testing.T) {
+	cases := map[string]string{
+		"inferred_return": `export class Probe { static make() {return {item:{value:8}};} static run(): number {return Probe.make().item.value;} }`,
+		"notes":           `export class Probe {static make(value:any) {return {value};} static run(): number {Probe.make(4); return 11;} }`,
+		"evaluation":      `export class Probe { static run(): number {let n = 1; const value = {z:n++, a:n++, m:n}; return value.z * 100 + value.a * 10 + value.m;} }`,
+		"inferred":        `export class Probe { static run(): number { const a = {name:"a", count:1}; let b = {count:2, name:"b"}; b = {name:"c", count:3}; const nested = {item:{value:4}}; const rows = [{value:5}, {value:6}]; return a.count + b.count + nested.item.value + rows[0].value; } }`,
+		"contextual":      `export class Probe { static take(v:{count?:number}): number {return v.count ?? 7;} static make(): {count?:number} {return {};} static run(): number { let a:{count?:number}|undefined = {}; a = {count:2}; return Probe.take({}) + Probe.take(Probe.make()) + Probe.take(a); } }`,
+		"union":           `export class Probe { static make(): {left?:number}|{right:string} {return {};} static run(): number { const value:{left?:number}|{right:string} = {}; Probe.make(); return 9; } }`,
+		"empty":           `export class Probe { static run(): number { const value = {}; const other:{} = {}; return 10; } }`,
+		"record":          `export class Probe { static make(): {[key:string]:number} {return {one:1,two:2};} static run(): number { const values:Record<string,number> = {one:3}; const nested = {values:Probe.make()}; return values["one"] + nested.values["two"]; } }`,
+		"readonly":        `export class Probe { static take(value: {readonly count:number; readonly label?:string}): number {return value.count;} static run(): number {const a:Readonly<{count:number; label?:string}> = {count:4, label:"x"}; let b:{label?:string; count:number} = {count:5}; b.count = 6; return Probe.take(a) + Probe.take(b); } }`,
+	}
+	wants := map[string]string{"inferred_return": "8\n", "notes": "11\n", "evaluation": "123\n", "inferred": "13\n", "contextual": "16\n", "union": "9\n", "empty": "10\n", "record": "5\n", "readonly": "10\n"}
+	for name, source := range cases {
+		t.Run(name, func(t *testing.T) {
+			prog := lowerStatementsProbe(t, map[string]string{"probe.ts": source}, []string{"probe.ts"})
+			if t.Failed() {
+				t.Log(hir.Dump(prog))
+				return
+			}
+			if _, err := abap.Emit(prog); err != nil {
+				t.Fatal(err)
+			}
+			var entry string
+			for _, c := range prog.Classes {
+				if strings.HasSuffix(c.Name, ".Probe") {
+					entry = goEntry(c.Name, "run")
+				}
+			}
+			if got := runGoHIR(t, prog, "fmt.Println("+entry+"())"); got != wants[name] {
+				t.Fatalf("got %q, want %q", got, wants[name])
+			}
+		})
+	}
+}
+
+func TestAnonymousShapeLayoutAndMetadata(t *testing.T) {
+	prog := lowerStatementsProbe(t, map[string]string{"probe.ts": `
+ export class Probe {
+ static first(): {z:number; a:string} {return {z:1, a:"a"};}
+ static second(): {a:string; z:number} {return {a:"b", z:2};}
+ static mutable(): {value:number; label?:string} {return {value:3};}
+ static readonly(): Readonly<{label?:string; value:number}> {return {value:4};}
+ }`}, []string{"probe.ts"})
+	var pair, optional *hir.Class
+	for _, c := range prog.Classes {
+		if !strings.HasPrefix(c.Name, "shape.") {
+			continue
+		}
+		if len(c.Fields) != 2 {
+			t.Fatalf("unexpected shape: %+v", c)
+		}
+		switch c.Fields[0].Name {
+		case "a":
+			if pair != nil {
+				t.Fatal("property order produced duplicate shapes")
+			}
+			pair = c
+		case "label":
+			if optional != nil {
+				t.Fatal("readonly view produced duplicate shapes")
+			}
+			optional = c
+		default:
+			t.Fatalf("noncanonical layout: %+v", c.Fields)
+		}
+	}
+	if pair == nil || optional == nil {
+		t.Fatal("missing structural shapes")
+	}
+	if optional.Fields[0].Type.Kind != hir.Optional || !optional.Fields[0].Readonly || !optional.Fields[1].Readonly {
+		t.Fatalf("lost optional/readonly metadata: %+v", optional.Fields)
+	}
+	if _, err := abap.Emit(prog); err != nil {
+		t.Fatal(err)
+	}
+}
