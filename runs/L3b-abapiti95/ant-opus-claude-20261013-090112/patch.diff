+package tsfront
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/oisee/abapiti/hir"
+	"github.com/oisee/abapiti/hir/abap"
+)
+
+// Object literals without a named class or alias lower to structural shape
+// classes: assignments, arguments, returns, nested and spread members,
+// optional and record contexts, and empty literals.
+const anonymousShapesSource = `
+function take(p: {x: number, y: string}): number { return p.x; }
+function make(): {x: number, y: string} { return {y: "a", x: 3}; }
+function maybe(p?: {k: number, label?: string}): number { return p === undefined ? 100 : p.k; }
+function view(p: {readonly x: number, readonly y: string}): number { return p.x; }
+function inferred(n: number) { if (n > 0) { return {b: "y", a: n}; } return {a: 0, b: "z"}; }
+export class Probe {
+  static vars: {[k: string]: number} | undefined = undefined;
+  static run(): number {
+    const a = {x: 1, y: "s"};
+    const b = {y: "t", x: 2};
+    let v: {x: number, y: string};
+    v = {x: 4, y: "u"};
+    const nested = {inner: {a: 5}, list: [{a: 6}, {a: 7}], meta: {}};
+    const o: {x?: number, y?: string} = {};
+    const u: {k: number} | undefined = {k: 8};
+    const r: Record<string, number> = Probe.vars ?? {p: 9, q: 10};
+    let keys = 0;
+    for (const key in Probe.vars || {}) { keys += key.length; }
+    const spread = {...a, x: 11};
+    const e = {};
+    const w = {x: 12, y: "w"};
+    w.x = w.x + 1;
+    return a.x + b.x + take({y: "q", x: 2}) + make().x + v.x + nested.inner.a + nested.list[1].a +
+      (o.x ?? 0) + (u ? u.k : 0) + (r["q"] ?? 0) + keys + spread.x + maybe({k: 14}) + maybe() +
+      view(w) + view({x: 15, y: "r"}) + inferred(16).a + (e === undefined ? 1000 : 0);
+  }
+}
+`
+
+func TestAnonymousObjectLiteralShapes(t *testing.T) {
+	p := lowerStatementsProbe(t, map[string]string{"probe.ts": anonymousShapesSource}, []string{"probe.ts"})
+	// Literals and type literals with the fields x:number, y:string (in
+	// either order, readonly or not) share one physical class.
+	var xy []string
+	for _, c := range p.Classes {
+		if !strings.HasPrefix(c.Name, "shape.") || len(c.Fields) != 2 {
+			continue
+		}
+		names := map[string]hir.Type{}
+		for _, f := range c.Fields {
+			names[f.Name] = f.Type
+		}
+		if names["x"].Kind == hir.Number && names["y"].Kind == hir.String {
+			xy = append(xy, c.Name)
+			for _, f := range c.Fields {
+				if f.Readonly {
+					t.Errorf("%s.%s: a writable view shares the readonly layout", c.Name, f.Name)
+				}
+			}
+		}
+	}
+	if len(xy) != 1 {
+		t.Fatalf("x/y layouts: %v, want one shared shape", xy)
+	}
+	if _, err := abap.Emit(p); err != nil {
+		t.Fatal(err)
+	}
+	// Node: 1+2+2+3+4+5+7+0+8+10+0+11+14+100+13+15+16+0
+	got := runGoHIR(t, p, fmt.Sprintf("fmt.Println(%s())", goEntry("probe.ts.Probe", "run")))
+	if strings.TrimSpace(got) != "211" {
+		t.Fatalf("Go result %q, want 211", got)
+	}
+}
+
+// A readonly-only layout keeps its readonly fields.
+func TestAnonymousShapeReadonly(t *testing.T) {
+	p := lowerStatementsProbe(t, map[string]string{"probe.ts": `
+export class Probe {
+  static run(): number {
+    const r: {readonly id: number, readonly name?: string} = {id: 1};
+    return r.id;
+  }
+}
+`}, []string{"probe.ts"})
+	for _, c := range p.Classes {
+		if !strings.HasPrefix(c.Name, "shape.") {
+			continue
+		}
+		for _, f := range c.Fields {
+			if !f.Readonly {
+				t.Errorf("%s.%s lost readonly", c.Name, f.Name)
+			}
+			if f.Name == "name" && f.Type.Kind != hir.Optional {
+				t.Errorf("%s.name lost optional: %s", c.Name, f.Type)
+			}
+		}
+		return
+	}
+	t.Fatal("no structural shape")
+}
