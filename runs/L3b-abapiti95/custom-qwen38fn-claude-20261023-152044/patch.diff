diff --git a/tsfront/testdata/anonliterals/probe.ts b/tsfront/testdata/anonliterals/probe.ts
new file mode 100644
index 0000000..85903ed
--- /dev/null
+++ b/tsfront/testdata/anonliterals/probe.ts
@@ -0,0 +1,107 @@
+// Anonymous object literals: shapes without a named class or alias.
+// Every case must lower without blocking diagnostics, verify, and emit.
+
+// Plain literals and order-invariant layout reuse.
+export const p1 = { pa: 1, pb: "two" };
+export const p2 = { pb: "three", pa: 4 };
+export function readP(): number { return p1.pa + p1.pb.length + p2.pa + p2.pb.length; }
+
+// Empty literals without context.
+export const p3 = {};
+export function useAny(o: {}): number { return 1; }
+export const rAny = useAny(p3);
+export function emptyLocal(): number {
+  const v = {};
+  const w = {};
+  return useAny(v) + useAny(w);
+}
+
+// Literals as arguments, results, and in nested/array positions.
+export function f(x: { a: number }): number { return x.a; }
+export const rArg = f({ a: 7 });
+export function g(): { s: string; n: number } { return { n: 1, s: "x" }; }
+export const rRet = g().s.length + g().n;
+export const nested = { outer: { inner: 5 } };
+export const rNested = nested.outer.inner;
+export const arr = [{ a: 1 }, { a: 2 }];
+export const rArr = arr[0].a + arr[1].a;
+export const deep = { list: [{ k: 1 }, { k: 2 }], tail: { t: true } };
+export const rDeep = deep.list[0].k + deep.list[1].k + (deep.tail.t ? 1 : 0);
+
+// Contextual union (unrelated members) and optional types.
+export function h(x: { a: number } | { b: string }): number { return 0; }
+export const rUnionA = h({ a: 1 });
+export const rUnionB = h({ b: "z" });
+export const opt: { a: number } | undefined = { a: 3 };
+export const rOpt = opt ? opt.a : 0;
+export function optret(flag: boolean): { q: boolean } | undefined {
+  return flag ? { q: true } : undefined;
+}
+export const rOptRet = optret(true) ? 1 : 0;
+
+// Conditional branches.
+export function cond(flag: boolean): { a: number } {
+  return flag ? { a: 1 } : { a: 2 };
+}
+export const rCond = cond(true).a;
+
+// Readonly views reuse the layout; optionals and readonlyness survive.
+export function roFn(x: { readonly jn: number; readonly qs: string }): number {
+  return x.jn;
+}
+export const rRo1 = roFn({ jn: 1, qs: "r" });
+export const rRo2 = roFn({ qs: "t", jn: 2 });
+export interface Ro { readonly ra: number; readonly rb: string; }
+export function roIface(x: Ro): number { return x.ra; }
+export const rRoIface = roIface({ ra: 1, rb: "r" });
+export interface Orig { oa: number; os: string; }
+export function roMapped(x: Readonly<Orig>): number { return x.oa; }
+export const rRoMapped = roMapped({ oa: 1, os: "z" });
+
+// Optional properties: omitted or given in any order.
+export function maybe(m: { a: number; b?: string }): number {
+  return m.b === undefined ? m.a : m.a + 1;
+}
+export const rMaybe1 = maybe({ a: 5 });
+export const rMaybe2 = maybe({ b: "s", a: 6 });
+export function alloptions(o: { a?: number; b?: string }): number { return 0; }
+export const rAllOptional = alloptions({});
+
+// Assignment to annotated locals and re-assignment.
+export function assign(): number {
+  let v: { a: number; b?: string } = { a: 1 };
+  v = { b: "s", a: 2 };
+  return v.a + (v.b ? v.b.length : 0);
+}
+export const rAssign = assign();
+
+// Record-like literals stay maps.
+export const rec: Record<string, number> = { a: 1, b: 2 };
+export const rRec = rec["a"] + rec["b"];
+export const rec2: Record<string, number> = { ...rec, c: 5 };
+export const rRec2 = rec2["c"];
+
+// Spread and class fields.
+export const sp = { ...p1, c: 3 };
+export const rSp = sp.pa + sp.pb.length + sp.c;
+export class Holder {
+  f = { a: 1 };
+  public get19(): number { return this.f.a; }
+}
+export const rField = new Holder().get19();
+
+// Literals through a class method and a variable hop.
+export class Maker {
+  public make(): { ok: boolean; count: number } { return { count: 3, ok: true }; }
+}
+export const rMake = new Maker().make().count;
+export function viaVar(): number {
+  const lit = { n: 9, tag: "t" };
+  return f({ a: lit.n }) + lit.tag.length;
+}
+export const rVia = viaVar();
+
+// Order-invariant reuse across standalone literals.
+export const top1 = { x: 5, y: 6 };
+export const top2 = { y: 7, x: 8 };
+export const rTop = top1.x + top1.y + top2.x + top2.y;
