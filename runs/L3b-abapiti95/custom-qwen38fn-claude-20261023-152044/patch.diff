+// anonymousObjectType reports whether a checker object type is structural
+// rather than a declaration-backed nominal type: its symbol is absent or it
+// belongs to object literals and `{}`-style type literals only (a widened
+// literal type keeps that symbol). Types with call signatures are functions,
+// not shapes, and named declarations never synthesize a shape here.
+func (l *lowerer) anonymousObjectType(t *checker.Type) bool {
+	if t == nil || t.Flags()&checker.TypeFlagsObject == 0 {
+		return false
+	}
+	if len(l.ck.GetSignaturesOfType(t, checker.SignatureKindCall)) != 0 {
+		return false
+	}
+	sym := t.Symbol()
+	if sym == nil || len(sym.Declarations) == 0 {
+		// No declaring syntax: a checker-synthesized (anonymous) type.
+		return true
+	}
+	for _, d := range sym.Declarations {
+		if d.Kind != ast.KindObjectLiteralExpression && d.Kind != ast.KindTypeLiteral {
+			return false
+		}
+	}
+	return true
+}
