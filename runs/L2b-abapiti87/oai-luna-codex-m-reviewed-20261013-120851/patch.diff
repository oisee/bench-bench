diff --git a/hir/abap/format.go b/hir/abap/format.go
new file mode 100644
index 0000000..e77fa51
--- /dev/null
+++ b/hir/abap/format.go
@@ -0,0 +1,247 @@
+package abap
+
+import (
+	"fmt"
+	"strings"
+)
+
+// indent applies the fixed two-space indentation used for generated ABAP.
+func indent(src string) string {
+	lines := strings.Split(strings.TrimSuffix(src, "\n"), "\n")
+	var out strings.Builder
+	depth := 0
+	classImpl, classDef, iface, section := false, false, false, false
+	for _, raw := range lines {
+		trim := strings.TrimSpace(raw)
+		if trim == "" {
+			out.WriteByte('\n')
+			continue
+		}
+		if strings.HasPrefix(raw, "*") {
+			out.WriteString(raw + "\n")
+			continue
+		}
+		words := statementWords(trim)
+		first := ""
+		if len(words) > 0 {
+			first = words[0]
+		}
+		up := strings.ToUpper(first)
+		level := depth
+		if len(words) > 0 && (isReportEvent(words, 0) || up == "FORM" || up == "FUNCTION" || up == "MODULE") {
+			level = 0
+		}
+		if isCloser(up) && depth > 0 {
+			level = depth
+		}
+		if up == "ELSE" || up == "ELSEIF" || up == "WHEN" || up == "CATCH" || up == "CLEANUP" {
+			level = depth - 1
+		}
+		if up == "CLASS" || up == "INTERFACE" || up == "ENDCLASS" || up == "ENDINTERFACE" {
+			level = 0
+		}
+		if classDef && section && up != "PUBLIC" && up != "PROTECTED" && up != "PRIVATE" {
+			level = 2
+		}
+		if iface && up != "INTERFACE" && up != "ENDINTERFACE" {
+			level = 1
+		}
+		if classImpl && (up == "METHOD" || up == "ENDMETHOD") {
+			level = 1
+		}
+		if up == "PUBLIC" || up == "PROTECTED" || (up == "PRIVATE" && strings.Contains(strings.ToUpper(trim), "SECTION")) {
+			level = 1
+		}
+		if up == "ENDCLASS" || up == "ENDINTERFACE" {
+			level = 0
+		}
+		if up == "ENDMETHOD" && classImpl {
+			level = 1
+		}
+		if level < 0 {
+			level = 0
+		}
+		out.WriteString(strings.Repeat("  ", level) + trim + "\n")
+		// Process every statement start on this physical line, while the lexer
+		// excludes quoted text, templates, and comments.
+		for i, w := range words {
+			u := strings.ToUpper(w)
+			if w == "." {
+				continue
+			}
+			prev := ""
+			if i > 0 {
+				prev = strings.ToUpper(words[i-1])
+			}
+			switch u {
+			case "CLASS":
+				// Only a CLASS statement at the beginning of a statement is structural.
+				if i == 0 && containsSequence(words, "DEFINITION", "DEFERRED") {
+					break
+				}
+				if i == 0 && containsWord(words, "IMPLEMENTATION") {
+					classImpl = true
+					classDef = false
+					depth = 1
+				} else if i == 0 && containsWord(words, "DEFINITION") {
+					classDef = true
+					classImpl = false
+					section = false
+				}
+			case "ENDCLASS":
+				if i == 0 {
+					classImpl = false
+					classDef = false
+					section = false
+					depth = 0
+				}
+			case "INTERFACE":
+				if i == 0 {
+					iface = true
+				}
+			case "ENDINTERFACE":
+				if i == 0 {
+					iface = false
+				}
+			case "PUBLIC", "PROTECTED", "PRIVATE":
+				if i == 0 && containsWord(words, "SECTION") {
+					section = true
+				}
+			case "METHOD":
+				if i == 0 {
+					if classImpl {
+						depth = 2
+					} else {
+						depth++
+					}
+				}
+			case "ENDMETHOD":
+				if i == 0 {
+					if classImpl {
+						depth = 1
+					} else if depth > 0 {
+						depth--
+					}
+				}
+			case "IF", "CASE", "DO", "WHILE", "LOOP", "TRY", "FORM", "FUNCTION", "MODULE", "START-OF-SELECTION", "INITIALIZATION", "AT":
+				if statementToken(words, i) {
+					if u == "AT" && i+1 < len(words) && !strings.EqualFold(words[i+1], "SELECTION-SCREEN") {
+						break
+					}
+					if isReportEvent(words, i) {
+						depth = 1
+					} else {
+						depth++
+					}
+				}
+			case "ENDIF", "ENDCASE", "ENDDO", "ENDWHILE", "ENDLOOP", "ENDTRY", "ENDFORM", "ENDFUNCTION", "ENDMODULE":
+				if depth > 0 {
+					depth--
+				}
+			case "WHEN":
+				// WHEN is a branch within CASE, not another nesting level.
+			case "CATCH", "CLEANUP":
+				// Exception clauses are peers within TRY.
+			case "ELSE", "ELSEIF":
+				_ = prev
+			}
+		}
+	}
+	return strings.TrimSuffix(out.String(), "\n") + "\n"
+}
+
+func isCloser(s string) bool {
+	return strings.HasPrefix(s, "END") || s == "ELSE" || s == "ELSEIF" || s == "WHEN" || s == "CATCH" || s == "CLEANUP"
+}
+func containsWord(a []string, s string) bool {
+	for _, x := range a {
+		if strings.EqualFold(x, s) {
+			return true
+		}
+	}
+	return false
+}
+func containsSequence(a []string, x, y string) bool {
+	for i := 0; i+1 < len(a); i++ {
+		if strings.EqualFold(a[i], x) && strings.EqualFold(a[i+1], y) {
+			return true
+		}
+	}
+	return false
+}
+func statementToken(a []string, i int) bool {
+	return i == 0 || (i > 0 && a[i-1] == ".")
+}
+
+func isReportEvent(a []string, i int) bool {
+	u := strings.ToUpper(a[i])
+	if u == "START-OF-SELECTION" || u == "INITIALIZATION" {
+		return true
+	}
+	if u == "AT" && i+1 < len(a) && strings.EqualFold(a[i+1], "SELECTION-SCREEN") {
+		return true
+	}
+	return false
+}
+
+// statementWords returns identifiers outside literals and comments. Periods
+// terminate statements; escaped quote delimiters and doubled apostrophes work.
+func statementWords(s string) []string {
+	var words []string
+	quote := byte(0)
+	word := ""
+	flush := func() {
+		if word != "" {
+			words = append(words, word)
+			word = ""
+		}
+	}
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if quote != 0 {
+			if quote == '|' && c == '\\' {
+				i++
+				continue
+			}
+			if c == quote {
+				if quote == '\'' && i+1 < len(s) && s[i+1] == '\'' {
+					i++
+					continue
+				}
+				quote = 0
+			}
+			continue
+		}
+		if c == '\'' || c == '`' || c == '|' {
+			flush()
+			quote = c
+			continue
+		}
+		if c == '"' {
+			flush()
+			break
+		}
+		if c == '.' {
+			flush()
+			words = append(words, ".")
+			continue
+		}
+		if c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' || c == '-' {
+			word += string(c)
+		} else {
+			flush()
+		}
+	}
+	flush()
+	return words
+}
+
+// Format applies indentation and wraps statements at 255 bytes.
+func Format(src string) (string, error) {
+	formatted := indent(src)
+	out, err := wrap(formatted)
+	if err != nil {
+		return "", fmt.Errorf("ABAP format: %w", err)
+	}
+	return out, nil
+}
