new file mode 100644
index 0000000..66cea6c
--- /dev/null
+++ b/hir/abap/format_test.go
@@ -0,0 +1,100 @@
+package abap
+
+import "testing"
+
+func TestIndentBlocksAndLexicalContexts(t *testing.T) {
+	in := `CLASS lcl DEFINITION DEFERRED.
+CLASS lcl DEFINITION.
+PUBLIC SECTION.
+METHODS run.
+ENDCLASS.
+CLASS lcl IMPLEMENTATION.
+METHOD run.
+CASE x.
+WHEN 1.
+TRY.
+IF x = 'ENDIF.'. y = 1. ENDIF.
+CATCH cx_root.
+y = 2.
+CLEANUP.
+y = 3.
+ENDTRY.
+ENDCASE.
+ENDMETHOD.
+ENDCLASS.
+FORM one.
+WRITE / ` + "`text { 'ENDTRY.' }`" + `.
+ENDFORM.
+FORM two.
+ENDFORM.
+`
+	out := indent(in)
+	want := `CLASS lcl DEFINITION DEFERRED.
+CLASS lcl DEFINITION.
+  PUBLIC SECTION.
+    METHODS run.
+ENDCLASS.
+CLASS lcl IMPLEMENTATION.
+  METHOD run.
+    CASE x.
+      WHEN 1.
+        TRY.
+          IF x = 'ENDIF.'. y = 1. ENDIF.
+        CATCH cx_root.
+          y = 2.
+        CLEANUP.
+          y = 3.
+        ENDTRY.
+    ENDCASE.
+  ENDMETHOD.
+ENDCLASS.
+FORM one.
+  WRITE / ` + "`text { 'ENDTRY.' }`" + `.
+ENDFORM.
+FORM two.
+ENDFORM.
+`
+	if out != want {
+		t.Fatalf("indent mismatch\n--- got ---\n%s--- want ---\n%s", out, want)
+	}
+	if indent(out) != out {
+		t.Fatal("indent is not idempotent")
+	}
+}
+
+func TestFormatWrapsWithinByteLimit(t *testing.T) {
+	src := "METHOD m.\n" + "DATA value TYPE string VALUE '" + string(make([]byte, 0)) + "'.\nENDMETHOD.\n"
+	// Build an unbreakable-safe long statement from ordinary identifiers.
+	src = "METHOD m.\nWRITE " + stringsRepeat("value ", 50) + "value.\nENDMETHOD.\n"
+	out, err := Format(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, line := range splitLines(out) {
+		if len(line) > 255 {
+			t.Fatalf("line has %d bytes", len(line))
+		}
+	}
+	if again, _ := Format(out); again != out {
+		t.Fatal("Format is not idempotent")
+	}
+}
+
+func stringsRepeat(s string, n int) string {
+	r := ""
+	for i := 0; i < n; i++ {
+		r += s
+	}
+	return r
+}
+func splitLines(s string) []string {
+	var a []string
+	start := 0
+	for i := 0; i < len(s); i++ {
+		if s[i] == '\n' {
+			a = append(a, s[start:i])
+			start = i + 1
+		}
+	}
+	return a
+}
