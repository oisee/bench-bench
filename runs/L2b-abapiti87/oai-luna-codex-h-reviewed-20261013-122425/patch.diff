+++ b/hir/abap/format.go
@@ -0,0 +1,341 @@
+package abap
+
+import (
+	"fmt"
+	"strings"
+)
+
+// indent applies the fixed abaplint-style indentation used for generated ABAP.
+// It is deliberately syntax aware enough to ignore periods and keywords in
+// literals and comments, while leaving statement text untouched.
+func indent(src string) string {
+	lines := strings.Split(strings.TrimSuffix(src, "\n"), "\n")
+	var out strings.Builder
+	var blocks []indentBlock
+	classMode := ""
+	interfaceMode := false
+	classSection := false
+	inImplMethod := false
+	statementIndent := 0
+	reportEvent := false
+	quote := byte(0)
+	for _, raw := range lines {
+		if strings.TrimSpace(raw) == "" {
+			out.WriteByte('\n')
+			continue
+		}
+		quoteAtLineStart := quote != 0
+		if !quoteAtLineStart && strings.HasPrefix(raw, "*") {
+			out.WriteString(raw)
+			out.WriteByte('\n')
+			continue
+		}
+		visible, commentAt := maskABAPLine(raw, &quote)
+		trimmed := strings.TrimSpace(visible)
+		if trimmed == "" { // inline comment-only line
+			out.WriteString(raw)
+			out.WriteByte('\n')
+			continue
+		}
+		stmts := statements(trimmed)
+		first := ""
+		if len(stmts) != 0 {
+			first = keyword(stmts[0])
+		}
+		// Report events begin a fresh top-level section. GET is intentionally
+		// excluded: generated runtime GET statements are ordinary statements.
+		eventHeader := isReportEvent(first, trimmed)
+		if eventHeader {
+			blocks = nil
+			reportEvent = true
+		}
+		if first == "FORM" || first == "ENDFORM" {
+			reportEvent = false
+		}
+		level := blockIndent(blocks)
+		reportBase := 0
+		if reportEvent && !eventHeader {
+			reportBase = 1
+			level = reportBase + blockIndent(blocks)
+		}
+		// Closing and branch statements are aligned with their opener.
+		if first == "ENDCLASS" {
+			level, classMode, classSection, inImplMethod = 0, "", false, false
+			blocks = popKind(blocks, "class")
+		} else if first == "ENDINTERFACE" {
+			level = 0
+			interfaceMode = false
+			blocks = popKind(blocks, "interface")
+		} else if strings.HasPrefix(first, "END") && first != "ENDIF" && first != "ENDLOOP" && first != "ENDWHILE" && first != "ENDCASE" && first != "ENDTRY" && first != "ENDDO" && first != "ENDSELECT" && first != "ENDMETHOD" && first != "ENDFORM" {
+			// Other END* statements are not assumed to close an ordinary block.
+		} else if isClosing(first) {
+			level = blockIndent(blocks)
+			if len(blocks) > 0 {
+				level -= blocks[len(blocks)-1].body
+			}
+			level += reportBase
+		} else if first == "ELSE" || first == "ELSEIF" || first == "WHEN" || first == "CATCH" || first == "CLEANUP" {
+			level = reportBase + branchIndent(blocks, first)
+		}
+		if strings.HasPrefix(first, "CLASS") && first == "CLASS" && !strings.Contains(strings.ToUpper(trimmed), " DEFINITION DEFERRED") {
+			if strings.Contains(strings.ToUpper(trimmed), " DEFINITION") || strings.Contains(strings.ToUpper(trimmed), " IMPLEMENTATION") {
+				level = 0
+				classMode = "definition"
+				if strings.Contains(strings.ToUpper(trimmed), " IMPLEMENTATION") {
+					classMode = "implementation"
+				}
+				classSection, inImplMethod = false, false
+				blocks = append(blocks, indentBlock{kind: "class", body: 0})
+			}
+		}
+		if first == "INTERFACE" {
+			level = 0
+			interfaceMode = true
+			blocks = append(blocks, indentBlock{kind: "interface", body: 0})
+		}
+		if classMode == "definition" {
+			switch first {
+			case "PUBLIC", "PROTECTED", "PRIVATE":
+				if strings.Contains(strings.ToUpper(trimmed), " SECTION") {
+					level, classSection = 1, true
+				}
+			default:
+				if classSection {
+					level = 2
+				}
+			}
+		}
+		if classMode == "implementation" {
+			if first == "METHOD" {
+				level, inImplMethod = 1, true
+			} else if first == "ENDMETHOD" {
+				level = 1
+			} else if inImplMethod && !isClosing(first) && first != "ELSE" && first != "ELSEIF" && first != "WHEN" && first != "CATCH" && first != "CLEANUP" {
+				level = blockIndent(blocks)
+			}
+		}
+		if classMode == "definition" && first == "METHODS" || classMode == "definition" && first == "CLASS-METHODS" {
+			level = 2
+		}
+		if interfaceMode && first != "ENDINTERFACE" {
+			level = 1
+		}
+		// A continuation line follows the indentation of the statement begun
+		// on the preceding physical line. New lines that begin a new statement
+		// use the current block depth.
+		if len(stmts) == 0 {
+			level = statementIndent
+		}
+		if level < 0 {
+			level = 0
+		}
+		indentText := strings.Repeat("  ", level)
+		if quoteAtLineStart {
+			// Whitespace inside a multiline template is part of its value.
+			out.WriteString(raw)
+		} else {
+			if commentAt < 0 {
+				commentAt = len(raw)
+			}
+			code := strings.TrimLeft(raw[:commentAt], " \t")
+			out.WriteString(indentText)
+			out.WriteString(code)
+			out.WriteString(raw[commentAt:])
+		}
+		out.WriteByte('\n')
+		if len(stmts) == 0 {
+			continue
+		}
+		statementIndent = level
+		for _, st := range stmts {
+			kw := keyword(st)
+			if isClosing(kw) {
+				blocks = popForEnd(blocks, kw)
+				if kw == "ENDMETHOD" {
+					inImplMethod = false
+				}
+				continue
+			}
+			if isOpening(kw, st) {
+				body := 1
+				kind := kw
+				switch kw {
+				case "CASE":
+					kind, body = "case", 2
+				case "TRY":
+					kind, body = "try", 2
+				case "METHOD":
+					kind, body = "method", 2
+				case "FORM":
+					kind, body = "form", 1
+				case "IF":
+					kind = "if"
+				case "LOOP", "WHILE", "DO", "SELECT":
+					kind = "loop"
+				}
+				blocks = append(blocks, indentBlock{kind: kind, body: body})
+			}
+		}
+	}
+	return out.String()
+}
+
+type indentBlock struct {
+	kind string
+	body int
+}
+
+func blockIndent(b []indentBlock) int {
+	n := 0
+	for _, x := range b {
+		n += x.body
+	}
+	return n
+}
+func popKind(b []indentBlock, kind string) []indentBlock {
+	for i := len(b) - 1; i >= 0; i-- {
+		if b[i].kind == kind {
+			return b[:i]
+		}
+	}
+	return b
+}
+func popForEnd(b []indentBlock, end string) []indentBlock {
+	kind := map[string]string{"ENDIF": "if", "ENDLOOP": "loop", "ENDWHILE": "loop", "ENDDO": "loop", "ENDSELECT": "loop", "ENDCASE": "case", "ENDTRY": "try", "ENDMETHOD": "method", "ENDFORM": "form"}[end]
+	return popKind(b, kind)
+}
+func branchIndent(b []indentBlock, kw string) int {
+	for i := len(b) - 1; i >= 0; i-- {
+		if kw == "WHEN" && b[i].kind == "case" {
+			return blockIndent(b[:i+1]) - 1
+		}
+		if (kw == "CATCH" || kw == "CLEANUP") && b[i].kind == "try" {
+			return blockIndent(b[:i+1]) - 1
+		}
+		if (kw == "ELSE" || kw == "ELSEIF") && b[i].kind == "if" {
+			return blockIndent(b[:i])
+		}
+	}
+	return blockIndent(b)
+}
+func isClosing(k string) bool {
+	switch k {
+	case "ENDIF", "ENDLOOP", "ENDWHILE", "ENDDO", "ENDSELECT", "ENDCASE", "ENDTRY", "ENDMETHOD", "ENDFORM":
+		return true
+	}
+	return false
+}
+func isOpening(k, st string) bool {
+	switch k {
+	case "IF", "LOOP", "WHILE", "DO", "CASE", "TRY", "METHOD", "FORM", "SELECT":
+		return true
+	}
+	return false
+}
+func keyword(s string) string {
+	fields := strings.Fields(strings.ToUpper(s))
+	if len(fields) == 0 {
+		return ""
+	}
+	return strings.TrimSuffix(fields[0], ".")
+}
+func isReportEvent(k, statement string) bool {
+	switch k {
+	case "INITIALIZATION", "START-OF-SELECTION", "END-OF-SELECTION", "TOP-OF-PAGE", "END-OF-PAGE", "LOAD-OF-PROGRAM":
+		return true
+	case "AT":
+		upper := strings.ToUpper(statement)
+		return strings.HasPrefix(upper, "AT SELECTION-SCREEN") || strings.HasPrefix(upper, "AT LINE-SELECTION") || strings.HasPrefix(upper, "AT USER-COMMAND") || strings.HasPrefix(upper, "AT PF")
+	}
+	return false
+}
+
+// maskABAPLine hides literals and comments from the statement scanner while
+// carrying a quoted template across physical source lines.
+func maskABAPLine(s string, quote *byte) (string, int) {
+	var out strings.Builder
+	commentAt := -1
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if *quote != 0 {
+			if *quote == '|' && c == '\\' {
+				out.WriteByte(' ')
+				i++
+				if i < len(s) {
+					out.WriteByte(' ')
+				}
+				continue
+			}
+			if c == *quote {
+				if *quote != '|' && i+1 < len(s) && s[i+1] == *quote {
+					out.WriteString("  ")
+					i++
+					continue
+				}
+				*quote = 0
+			}
+			out.WriteByte(' ')
+			continue
+		}
+		if c == '"' {
+			commentAt = i
+			break
+		}
+		if c == '\'' || c == '`' || c == '|' {
+			*quote = c
+			out.WriteByte(' ')
+			continue
+		}
+		out.WriteByte(c)
+	}
+	return out.String(), commentAt
+}
+
+// Format applies indentation and wraps physical lines to 255 bytes.
+func Format(src string) (string, error) {
+	formatted, err := wrap(indent(src))
+	if err != nil {
+		return "", fmt.Errorf("format ABAP: %w", err)
+	}
+	return formatted, nil
+}
+
+func statements(s string) []string {
+	var out []string
+	start := 0
+	q := byte(0)
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if q != 0 {
+			if q == '|' && c == '\\' {
+				i++
+				continue
+			}
+			if c == q {
+				if q != '|' && i+1 < len(s) && s[i+1] == q {
+					i++
+					continue
+				}
+				q = 0
+			}
+			continue
+		}
+		if c == '\'' || c == '`' || c == '|' {
+			q = c
+			continue
+		}
+		if c == '"' {
+			break
+		}
+		if c == '.' && (i == 0 || s[i-1] < '0' || s[i-1] > '9' || i+1 == len(s) || s[i+1] < '0' || s[i+1] > '9') {
+			if x := strings.TrimSpace(s[start : i+1]); x != "" {
+				out = append(out, x)
+			}
+			start = i + 1
+		}
+	}
+	if x := strings.TrimSpace(s[start:]); x != "" {
+		out = append(out, x)
+	}
+	return out
+}
