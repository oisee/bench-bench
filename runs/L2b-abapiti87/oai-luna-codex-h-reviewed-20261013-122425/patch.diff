+package abap
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestFormatIndentAndIdempotence(t *testing.T) {
+	src := `CLASS zcl_demo DEFINITION.
+PUBLIC SECTION.
+METHODS run.
+ENDCLASS.
+CLASS zcl_demo IMPLEMENTATION.
+METHOD run.
+IF text = 'ENDIF. '' TRY.'.
+WRITE text.
+ELSE.
+CASE mode.
+WHEN 1.
+WRITE |ENDCASE. { 'x.y' }|.
+ENDCASE.
+ENDIF.
+TRY.
+WRITE text.
+CATCH cx_root.
+WRITE text.
+CLEANUP.
+WRITE text.
+ENDTRY.
+ENDMETHOD.
+ENDCLASS.
+`
+	want := `CLASS zcl_demo DEFINITION.
+  PUBLIC SECTION.
+    METHODS run.
+ENDCLASS.
+CLASS zcl_demo IMPLEMENTATION.
+  METHOD run.
+    IF text = 'ENDIF. '' TRY.'.
+      WRITE text.
+    ELSE.
+      CASE mode.
+        WHEN 1.
+          WRITE |ENDCASE. { 'x.y' }|.
+      ENDCASE.
+    ENDIF.
+    TRY.
+        WRITE text.
+      CATCH cx_root.
+        WRITE text.
+      CLEANUP.
+        WRITE text.
+    ENDTRY.
+  ENDMETHOD.
+ENDCLASS.
+`
+	got, err := Format(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != want {
+		t.Fatalf("formatted output differs:\n%s", got)
+	}
+	again, err := Format(got)
+	if err != nil || again != got {
+		t.Fatalf("Format is not idempotent: %v", err)
+	}
+	if indent(got) != got {
+		t.Fatal("indent is not idempotent")
+	}
+}
+
+func TestFormatReportAndComments(t *testing.T) {
+	src := `REPORT ztest.
+CLASS lcl_forward DEFINITION DEFERRED.
+START-OF-SELECTION.
+IF x = 1.
+WRITE 'GET. ENDIF.'. " END-OF-SELECTION.
+ENDIF.
+GET node.
+FORM run.
+WRITE x.
+ENDFORM.
+* column-zero comment
+`
+	got, err := Format(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{"START-OF-SELECTION.\n  IF x = 1.", "    WRITE 'GET. ENDIF.'. \" END-OF-SELECTION.", "GET node.\nFORM run.", "* column-zero comment\n"} {
+		if !strings.Contains(got, want) {
+			t.Fatalf("missing %q in:\n%s", want, got)
+		}
+	}
+}
+
+func TestFormatMultilineTemplateKeepsLiteralBytes(t *testing.T) {
+	src := "CLASS z DEFINITION.\nENDCLASS.\nCLASS z IMPLEMENTATION.\nMETHOD m.\nIF x = 1.\nvalue = |start\n  ENDIF. \" literal text\n|.\nENDIF.\nENDMETHOD.\nENDCLASS.\n"
+	got, err := Format(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(got, "value = |start\n  ENDIF. \" literal text\n|.\n    ENDIF.") {
+		t.Fatalf("template text changed or affected block state:\n%s", got)
+	}
+	again, err := Format(got)
+	if err != nil || again != got {
+		t.Fatalf("multiline template output is not idempotent: %v", err)
+	}
+}
+
+func TestFormatRejectsOverlongMultilineTemplateLine(t *testing.T) {
+	continuation := strings.Repeat("word ", 60)
+	src := "value = |first\n" + continuation + "\n|.\n"
+	if _, err := Format(src); err == nil {
+		t.Fatal("Format accepted an overlong template continuation and could change its value")
+	}
+}
+
+func TestFormatWrapPreservesIndentAndByteLimit(t *testing.T) {
+	src := "CLASS z DEFINITION.\nPUBLIC SECTION.\nMETHODS m IMPORTING p TYPE string.\nENDCLASS.\nCLASS z IMPLEMENTATION.\nMETHOD m.\nDATA value TYPE string.\nvalue = " + strings.Repeat("`value` && ", 30) + "`tail`.\nENDMETHOD.\nENDCLASS.\n"
+	got, err := Format(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, line := range strings.Split(strings.TrimSuffix(got, "\n"), "\n") {
+		if len([]byte(line)) > 255 {
+			t.Fatalf("line is %d bytes", len([]byte(line)))
+		}
+	}
+	for _, line := range strings.Split(got, "\n") {
+		if strings.Contains(line, "&&") && !strings.HasPrefix(line, "    ") {
+			t.Fatalf("wrapped statement lost indentation: %q", line)
+		}
+	}
+	again, err := Format(got)
+	if err != nil || again != got {
+		t.Fatalf("wrapped output is not idempotent: %v", err)
+	}
+}
+
+func TestFormatWrapPreservesComments(t *testing.T) {
+	full := "* " + strings.Repeat("comment ", 40) + "\n"
+	inline := "WRITE x. \" " + strings.Repeat("comment ", 40) + "\n"
+	for _, src := range []string{full, inline} {
+		got, err := Format(src)
+		if err != nil {
+			t.Fatalf("Format comment: %v", err)
+		}
+		lines := strings.Split(strings.TrimSuffix(got, "\n"), "\n")
+		if len(lines) < 2 {
+			t.Fatalf("expected comment to wrap, got %d lines", len(lines))
+		}
+		for _, line := range lines {
+			if len([]byte(line)) > 255 {
+				t.Fatalf("wrapped comment is %d bytes", len([]byte(line)))
+			}
+			if strings.HasPrefix(src, "*") {
+				if !strings.HasPrefix(line, "*") {
+					t.Fatalf("full-line comment continuation lost marker: %q", line)
+				}
+			} else if !strings.Contains(line, `"`) {
+				t.Fatalf("inline comment continuation lost marker: %q", line)
+			}
+		}
+		again, err := Format(got)
+		if err != nil || again != got {
+			t.Fatalf("wrapped comments are not idempotent: %v", err)
+		}
+	}
+}
