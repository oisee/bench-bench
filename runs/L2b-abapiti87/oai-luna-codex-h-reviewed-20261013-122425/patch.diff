new file mode 100644
index 0000000..ead1d1b
--- /dev/null
+++ b/tsfront/abap_format.go
@@ -0,0 +1,14 @@
+package tsfront
+
+import "github.com/oisee/abapiti/hir/abap"
+
+// formatGeneratedABAP applies the backend's fixed formatting to driver sources.
+// These small builders have no error return; generated input is kept intact if
+// an indivisible literal prevents safe wrapping.
+func formatGeneratedABAP(src string) string {
+	formatted, err := abap.Format(src)
+	if err != nil {
+		return src
+	}
+	return formatted
+}
