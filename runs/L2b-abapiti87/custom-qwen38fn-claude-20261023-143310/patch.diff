@@ -0,0 +1,493 @@
+package abap
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// indent and Format apply abaplint's default indentation style to generated
+// ABAP (the Indent pretty printer with alignTryCatch off): two spaces per
+// ordinary block level, class headers and ENDCLASS at column zero with
+// sections at two and their declarations at four, method headers at two in a
+// class implementation and bodies at four, WHEN clauses two inside CASE with
+// their bodies two further in, TRY bodies four inside TRY with CATCH and
+// CLEANUP two inside it and their bodies two further in, report event headers
+// at column zero with two-space bodies, and forms starting at column zero.
+// Apparent keywords and statement-ending periods inside literals, string
+// templates, escaped delimiters and comments are ignored, full-line *
+// comments stay at column zero, and both operations are idempotent.
+
+// statementKind classifies the leading words of one statement, mirroring the
+// branches of abaplint's Indent.getExpectedIndents.
+type statementKind int
+
+const (
+	kNormal       statementKind = iota // no indentation effect
+	kOpener                            // body +2
+	kCloser                            // line -2 (ENDIF, ENDLOOP, …)
+	kCloserOpener                      // ELSE, ELSEIF: line -2, body +2
+	kTry                               // body +4, base pushed
+	kCase                              // CASE (also CASE TYPE): body +2, base pushed
+	kWhen                              // WHEN … and class sections: line at stack top, body +2
+	kCatch                             // CATCH, CLEANUP: line at stack top -2, body +2
+	kEndTry                            // ENDTRY: line at stack top -4, pops
+	kEndCase                           // ENDCLASS, ENDCASE: line at stack top -2, pops
+	kEvent                             // report event header: line at column zero, body +2
+	kForm                              // FORM/MODULE header, INCLUDE after an event: column zero, body +2
+	kClass                             // CLASS … DEFINITION/IMPLEMENTATION header: column zero, body +2, base pushed
+)
+
+// classify maps the leading words of a statement (upper case, literals and
+// comments removed) to its indentation effect. afterEvent is abaplint's
+// parentIsEvent: set by a report event header, it makes an INCLUDE in the
+// event body reset to column zero and open the block like a form header.
+func classify(words []string, afterEvent bool) statementKind {
+	if len(words) == 0 {
+		return kNormal
+	}
+	w := func(i int) string {
+		if i < len(words) {
+			return words[i]
+		}
+		return ""
+	}
+	switch w(0) {
+	case "IF", "WHILE", "DO", "LOOP", "CHAIN", "INTERFACE", "METHOD", "DEFINE", "TEST-INJECTION", "TEST-SEAM", "SELECTLOOP":
+		return kOpener
+	case "EXEC":
+		if w(1) == "SQL" {
+			return kOpener
+		}
+	case "CATCH":
+		// CATCH SYSTEM-EXCEPTIONS is a plain opener: only CATCH and CLEANUP
+		// clauses sit two inside the TRY that pushed the stack entry.
+		if w(1) == "SYSTEM-EXCEPTIONS" {
+			return kOpener
+		}
+		return kCatch
+	case "CLEANUP":
+		return kCatch
+	case "WHEN":
+		return kWhen
+	case "PUBLIC", "PROTECTED", "PRIVATE":
+		if w(1) == "SECTION" {
+			return kWhen
+		}
+	case "CASE":
+		return kCase
+	case "TRY":
+		return kTry
+	case "CLASS":
+		// CLASS x DEFINITION and CLASS x IMPLEMENTATION open a block; a
+		// forward declaration (DEFINITION DEFERRED) opens nothing.
+		has := func(word string) bool {
+			for _, x := range words[1:min(len(words), 9)] {
+				if x == word {
+					return true
+				}
+			}
+			return false
+		}
+		if has("IMPLEMENTATION") {
+			return kClass
+		}
+		if has("DEFINITION") && !has("DEFERRED") {
+			return kClass
+		}
+	case "ELSE", "ELSEIF":
+		return kCloserOpener
+	case "ENDTRY":
+		return kEndTry
+	case "ENDCLASS", "ENDCASE":
+		return kEndCase
+	case "ENDIF", "ENDWHILE", "ENDDO", "ENDLOOP", "ENDMETHOD", "ENDFORM", "ENDINTERFACE",
+		"ENDCATCH", "ENDSELECT", "ENDAT", "ENDCHAIN", "ENDEXEC", "ENDMODULE", "ENDFUNCTION",
+		"END-OF-DEFINITION", "END-TEST-INJECTION", "END-TEST-SEAM":
+		return kCloser
+	case "AT":
+		switch w(1) {
+		case "SELECTION-SCREEN", "LINE-SELECTION", "PF", "USER-COMMAND":
+			return kEvent
+		}
+		return kOpener
+	case "PROCESS":
+		if w(1) == "AFTER" || w(1) == "BEFORE" || w(1) == "ON" {
+			return kEvent
+		}
+	case "START-OF-SELECTION", "INITIALIZATION", "LOAD-OF-PROGRAM", "END-OF-SELECTION", "TOP-OF-PAGE":
+		return kEvent
+	case "GET":
+		// A plain GET <tab> opens a database-read event block; the runtime's
+		// GET statements (GET RUN TIME FIELD, GET REFERENCE OF, …) are plain
+		// statements and must not reset the report indentation.
+		switch w(1) {
+		case "RUN", "REFERENCE", "CURSOR", "BIT", "PARAMETER", "BADI", "DATASET",
+			"LOCALE", "PERMISSIONS", "PROPERTY", "PF-STATUS", "TIME":
+			return kNormal
+		}
+		return kEvent
+	case "FORM", "MODULE":
+		return kForm
+	case "INCLUDE":
+		if w(1) != "TYPE" && w(1) != "STRUCTURE" && afterEvent {
+			return kForm
+		}
+	case "FUNCTION":
+		// A function module body header (paired with ENDFUNCTION); calls
+		// start with CALL and pools with the single word FUNCTION-POOL.
+		return kOpener
+	case "SELECT":
+		// Only the SELECT … ENDSELECT loop opens a block; abaplint
+		// reclassifies a SELECT as a loop by the shape of the query.
+		if isSelectLoop(words) {
+			return kOpener
+		}
+	}
+	return kNormal
+}
+
+// isSelectLoop mirrors abaplint's reclassifySelect: SELECT SINGLE and
+// INTO TABLE queries are one statement; SELECT … INTO wa loops until
+// ENDSELECT. Aggregations without GROUP BY and count patterns are single.
+func isSelectLoop(words []string) bool {
+	has := func(targets ...string) bool {
+		for _, word := range words {
+			for _, target := range targets {
+				if word == target {
+					return true
+				}
+			}
+		}
+		return false
+	}
+	aggregate := has("COUNT", "MAX", "MIN", "SUM", "AVG", "MEDIAN")
+	if has("SINGLE") {
+		return false
+	}
+	if has("PACKAGE") {
+		return true
+	}
+	if has("TABLE") {
+		return false
+	}
+	if has("UNION") {
+		return true
+	}
+	if !has("INTO") && aggregate && !has("GROUP", "HAVING", "ORDER") {
+		return false
+	}
+	if aggregate && !has("GROUP") {
+		return false
+	}
+	return true
+}
+
+// codeMask marks, for every byte of a line, whether it sits in top-level
+// code: not inside a literal, string template (text or interpolation) or
+// comment. A line always starts in code: no ABAP literal or comment spans
+// lines.
+func codeMask(line string) []bool {
+	mask := make([]bool, len(line))
+	type frame struct {
+		mode  byte // 'c' code, 'q' ' or ` literal, 't' string template
+		quote byte
+		depth int // open { } of a template interpolation
+	}
+	stack := []frame{{mode: 'c'}}
+	for i := 0; i < len(line); i++ {
+		c := line[i]
+		top := &stack[len(stack)-1]
+		mask[i] = top.mode == 'c' && top.depth == 0
+		switch top.mode {
+		case 'c':
+			switch {
+			case c == '"' && top.depth == 0:
+				mask[i] = false
+				return mask // comment runs to the end of the line
+			case c == '\'' || c == '`':
+				stack = append(stack, frame{mode: 'q', quote: c})
+			case c == '|':
+				stack = append(stack, frame{mode: 't'})
+			case c == '{' && top.depth > 0:
+				top.depth++
+			case c == '}' && top.depth > 0:
+				top.depth--
+				if top.depth == 0 {
+					stack = stack[:len(stack)-1] // back into the template
+				}
+			}
+		case 'q':
+			mask[i] = false
+			if c == top.quote {
+				if i+1 < len(line) && line[i+1] == top.quote {
+					i++ // a doubled delimiter is an escape
+				} else {
+					stack = stack[:len(stack)-1]
+				}
+			}
+		case 't':
+			mask[i] = false
+			switch {
+			case c == '\\':
+				i++ // escaped delimiter or backslash
+			case c == '|':
+				stack = stack[:len(stack)-1]
+			case c == '{':
+				stack = append(stack, frame{mode: 'c', depth: 1})
+			}
+		}
+	}
+	return mask
+}
+
+// decimalDot reports whether the period at i separates the integer and
+// fraction digits of a number; only periods outside numbers end statements.
+func decimalDot(line string, i int) bool {
+	digit := func(b byte) bool { return b >= '0' && b <= '9' }
+	return i > 0 && i+1 < len(line) && digit(line[i-1]) && digit(line[i+1])
+}
+
+func isWordByte(b byte) bool {
+	return b >= 'A' && b <= 'Z' || b >= 'a' && b <= 'z' || b >= '0' && b <= '9' || b == '_' || b == '-' || b == '#'
+}
+
+// maxWords caps the words remembered for one statement. Classification reads
+// the leading words and, for SELECT loops, the final one; lines are short
+// enough that the cap never bites in practice.
+const maxWords = 200
+
+// wordsIn returns the upper-cased word tokens of line[from:to] at code
+// positions; delimiters, literals, templates and comments are skipped.
+func wordsIn(line string, mask []bool, from, to int) []string {
+	var words []string
+	for i := from; i < to && len(words) < maxWords; {
+		if !isWordByte(line[i]) || !mask[i] {
+			i++
+			continue
+		}
+		j := i
+		for j < to && isWordByte(line[j]) && mask[j] {
+			j++
+		}
+		words = append(words, strings.ToUpper(line[i:j]))
+		i = j
+	}
+	return words
+}
+
+func appendCapped(dst, more []string) []string {
+	for _, w := range more {
+		if len(dst) >= maxWords {
+			break
+		}
+		dst = append(dst, w)
+	}
+	return dst
+}
+
+// hasCode reports whether line[from:to] contains anything but blanks at a
+// code position; a statement made of nothing else is empty and inert.
+func hasCode(line string, mask []bool, from, to int) bool {
+	for i := from; i < to; i++ {
+		if mask[i] && line[i] != ' ' && line[i] != '\t' {
+			return true
+		}
+	}
+	return false
+}
+
+// indent re-indents generated ABAP following abaplint's default indentation
+// style (see the package comment). It is a pure function of the statement
+// structure: re-running it on its own output changes nothing.
+func indent(src string) string {
+	lines := strings.Split(src, "\n")
+	out := make([]string, len(lines))
+	var (
+		level      int
+		stack      []int
+		afterEvent bool
+		open       bool     // a statement continues from the previous line
+		openIndent int      // indentation of that statement's lines
+		openWords  []string // words of that statement, for its effect on close
+		openHad    bool     // that statement contains code (not just blanks)
+	)
+
+	peek := func() int {
+		if len(stack) == 0 {
+			return level
+		}
+		return stack[len(stack)-1]
+	}
+	pop := func() int {
+		v := peek()
+		if len(stack) > 0 {
+			stack = stack[:len(stack)-1]
+		}
+		return v
+	}
+	// display is the indentation a statement line gets; commit applies a
+	// finished statement's effect on the following lines.
+	display := func(k statementKind) int {
+		switch k {
+		case kCloser, kCloserOpener:
+			return max(level-2, 0)
+		case kEvent, kForm, kClass:
+			return 0
+		case kWhen:
+			return peek()
+		case kCatch:
+			return max(peek()-2, 0)
+		case kEndTry:
+			return max(peek()-4, 0)
+		case kEndCase:
+			return max(peek()-2, 0)
+		}
+		return level
+	}
+	commit := func(k statementKind) {
+		switch k {
+		case kCloser:
+			level = max(level-2, 0)
+		case kCloserOpener:
+			level = max(level-2, 0) + 2
+		case kEvent:
+			level = 2
+			afterEvent = true
+		case kForm:
+			level = 2
+			afterEvent = false
+		case kClass:
+			level = 2
+			afterEvent = false
+			stack = append(stack, level)
+		case kWhen:
+			level = peek() + 2
+		case kCatch:
+			level = max(peek()-2, 0) + 2
+		case kEndTry:
+			level = max(pop()-4, 0)
+		case kEndCase:
+			level = max(pop()-2, 0)
+		case kOpener:
+			level += 2
+		case kTry:
+			level += 4
+			stack = append(stack, level)
+		case kCase:
+			level += 2
+			stack = append(stack, level)
+		}
+	}
+
+	for li, line := range lines {
+		if strings.HasPrefix(line, "*") {
+			out[li] = line // a full-line * comment stays at column zero
+			continue
+		}
+		body := strings.TrimLeft(line, " \t")
+		if !open && body == "" {
+			out[li] = line
+			continue
+		}
+		if !open && strings.HasPrefix(body, "\"") {
+			out[li] = line // a full-line comment keeps its place, as in abaplint
+			continue
+		}
+		mask := codeMask(line)
+		var periods []int
+		for i := 0; i < len(line); i++ {
+			if line[i] == '.' && mask[i] && !decimalDot(line, i) {
+				periods = append(periods, i)
+			}
+		}
+		// The physical line is indented as the statement it belongs to:
+		// a continuation keeps its statement's indentation, the first line
+		// of a statement gets the indentation its kind asks for.
+		lineIndent := openIndent
+		if !open {
+			end := len(line)
+			if len(periods) > 0 {
+				end = periods[0] + 1
+			}
+			lineIndent = display(classify(wordsIn(line, mask, 0, end), afterEvent))
+			open, openIndent, openWords, openHad = true, lineIndent, nil, false
+		}
+		// Every statement on the line, however many, takes effect on the
+		// following lines; they stay together on this one.
+		pos := 0
+		for _, p := range periods {
+			seg := wordsIn(line, mask, pos, p)
+			if len(seg) > 0 || hasCode(line, mask, pos, p) {
+				openHad = true
+				openWords = appendCapped(openWords, seg)
+			}
+			if openHad {
+				commit(classify(openWords, afterEvent))
+			}
+			open, openWords, openHad = false, nil, false
+			pos = p + 1
+		}
+		if hasCode(line, mask, pos, len(line)) {
+			if !open {
+				open, openIndent, openWords = true, lineIndent, nil
+			}
+			openHad = true
+			openWords = appendCapped(openWords, wordsIn(line, mask, pos, len(line)))
+		}
+		out[li] = strings.Repeat(" ", lineIndent) + body
+	}
+	return strings.Join(out, "\n")
+}
+
+// Format re-indents generated ABAP and wraps the line limit: no wrapped line
+// exceeds 255 bytes including its leading spaces, and wrapped continuation
+// lines keep the statement's indentation. Both formatting operations are
+// idempotent.
+func Format(src string) (string, error) {
+	return wrapLines(indent(src))
+}
+
+// wrapLines breaks source lines longer than 255 bytes at a space in code,
+// never inside a literal, string template, interpolation or comment, and
+// never where a continuation would begin at column zero with a comment
+// marker. Fragments keep the line's leading indentation.
+func wrapLines(src string) (string, error) {
+	var out strings.Builder
+	for _, line := range strings.Split(strings.TrimSuffix(src, "\n"), "\n") {
+		if len(line) > 255 {
+			trimmed := strings.TrimLeft(line, " \t")
+			if strings.HasPrefix(trimmed, "*") || strings.HasPrefix(trimmed, "\"") {
+				// Full-line comments are content as written; abaplint leaves
+				// them alone and so does the wrapper.
+				out.WriteString(line + "\n")
+				continue
+			}
+		}
+		for len(line) > 255 {
+			ind := len(line) - len(strings.TrimLeft(line, " "))
+			mask := codeMask(line)
+			cut := -1
+			for i := ind + 1; i < len(line) && i <= 240; i++ {
+				if line[i] != ' ' || !mask[i] {
+					continue
+				}
+				j := i + 1
+				for j < len(line) && line[j] == ' ' {
+					j++
+				}
+				if ind == 0 && j < len(line) && line[j] == '*' {
+					continue // a fragment at column zero would read as a comment
+				}
+				cut = i
+			}
+			if cut < 0 {
+				return "", fmt.Errorf("unbreakable source line (%s bytes)", strconv.Itoa(len(line)))
+			}
+			out.WriteString(line[:cut] + "\n")
+			line = line[:ind] + strings.TrimLeft(line[cut:], " \t")
+		}
+		out.WriteString(line + "\n")
+	}
+	return out.String(), nil
+}
