diff --git a/tsfront/abap_format.go b/tsfront/abap_format.go
new file mode 100644
index 0000000..83eebf8
--- /dev/null
+++ b/tsfront/abap_format.go
@@ -0,0 +1,15 @@
+package tsfront
+
+import "github.com/oisee/abapiti/hir/abap"
+
+// formatABAP puts driver and report sources through the same formatting as
+// emitted classes: abaplint's default indentation and the 255-byte line
+// wrap. The generators keep every line short by construction, so a wrap
+// failure cannot happen; if one ever did, the source is returned unchanged
+// rather than lost.
+func formatABAP(src string) string {
+	if out, err := abap.Format(src); err == nil {
+		return out
+	}
+	return src
+}
