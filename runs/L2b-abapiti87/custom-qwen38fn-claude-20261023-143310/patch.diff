+package abap
+
+import (
+	"strings"
+	"testing"
+)
+
+// check formats src and compares every line with want. Format must also be
+// idempotent: formatting the formatted output changes nothing.
+func check(t *testing.T, name, src, want string) {
+	t.Helper()
+	got, err := Format(src)
+	if err != nil {
+		t.Fatalf("%s: Format: %v", name, err)
+	}
+	if got != want {
+		t.Errorf("%s: got\n%s\nwant\n%s", name, got, want)
+	}
+	again, err := Format(got)
+	if err != nil {
+		t.Fatalf("%s: re-Format: %v", name, err)
+	}
+	if again != got {
+		t.Errorf("%s: Format is not idempotent:\n%s", name, again)
+	}
+	if twice := indent(got); twice != got {
+		t.Errorf("%s: indent is not idempotent:\n%s", name, twice)
+	}
+}
+
+func TestIndentClass(t *testing.T) {
+	src := "CLASS lcl DEFINITION PUBLIC.\nPUBLIC SECTION.\nDATA n TYPE i.\nMETHODS run IMPORTING p0 TYPE i RETURNING VALUE(result) TYPE i.\nPROTECTED SECTION.\nPRIVATE SECTION.\nENDCLASS.\nCLASS lcl IMPLEMENTATION.\nMETHOD run.\nDATA x TYPE i.\nx = p0.\nENDMETHOD.\nENDCLASS.\n"
+	want := "CLASS lcl DEFINITION PUBLIC.\n  PUBLIC SECTION.\n    DATA n TYPE i.\n    METHODS run IMPORTING p0 TYPE i RETURNING VALUE(result) TYPE i.\n  PROTECTED SECTION.\n  PRIVATE SECTION.\nENDCLASS.\nCLASS lcl IMPLEMENTATION.\n  METHOD run.\n    DATA x TYPE i.\n    x = p0.\n  ENDMETHOD.\nENDCLASS.\n"
+	check(t, "class", src, want)
+}
+
+func TestIndentControlFlow(t *testing.T) {
+	src := "METHOD run.\nIF a = 1.\nx = 1.\nELSEIF a = 2.\nx = 2.\nELSE.\nx = 3.\nENDIF.\nDO 3 TIMES.\nx = x + 1.\nENDDO.\nWHILE x > 0.\nx = x - 1.\nENDWHILE.\nLOOP AT items INTO i.\nIF i = 1.\nCONTINUE.\nENDIF.\nENDLOOP.\nENDMETHOD.\n"
+	want := "  METHOD run.\n    IF a = 1.\n      x = 1.\n    ELSEIF a = 2.\n      x = 2.\n    ELSE.\n      x = 3.\n    ENDIF.\n    DO 3 TIMES.\n      x = x + 1.\n    ENDDO.\n    WHILE x > 0.\n      x = x - 1.\n    ENDWHILE.\n    LOOP AT items INTO i.\n      IF i = 1.\n        CONTINUE.\n      ENDIF.\n    ENDLOOP.\n  ENDMETHOD.\n"
+	check(t, "control flow", "CLASS c IMPLEMENTATION.\n"+src+"ENDCLASS.\n", "CLASS c IMPLEMENTATION.\n"+want+"ENDCLASS.\n")
+}
+
+func TestIndentCase(t *testing.T) {
+	src := "CASE x.\nWHEN 1.\ny = 1.\nWHEN 2 OR 3.\ny = 2.\nWHEN OTHERS.\ny = 0.\nENDCASE.\n"
+	want := "CASE x.\n  WHEN 1.\n    y = 1.\n  WHEN 2 OR 3.\n    y = 2.\n  WHEN OTHERS.\n    y = 0.\nENDCASE.\n"
+	check(t, "case", src, want)
+	src = "CASE TYPE OF o.\nWHEN TYPE cl_a.\ny = 1.\nWHEN OTHERS.\ny = 0.\nENDCASE.\n"
+	want = "CASE TYPE OF o.\n  WHEN TYPE cl_a.\n    y = 1.\n  WHEN OTHERS.\n    y = 0.\nENDCASE.\n"
+	check(t, "case type", src, want)
+	// A nested CASE sits in the WHEN body.
+	src = "CASE a.\nWHEN 1.\nCASE b.\nWHEN 2.\nx = 1.\nENDCASE.\nWHEN OTHERS.\nx = 0.\nENDCASE.\n"
+	want = "CASE a.\n  WHEN 1.\n    CASE b.\n      WHEN 2.\n        x = 1.\n    ENDCASE.\n  WHEN OTHERS.\n    x = 0.\nENDCASE.\n"
+	check(t, "nested case", src, want)
+}
+
+func TestIndentTry(t *testing.T) {
+	src := "TRY.\nx = 1.\nCATCH cx_root.\ny = 2.\nCATCH cx_static_check.\nz = 3.\nCLEANUP.\nw = 4.\nENDTRY.\n"
+	want := "TRY.\n    x = 1.\n  CATCH cx_root.\n    y = 2.\n  CATCH cx_static_check.\n    z = 3.\n  CLEANUP.\n    w = 4.\nENDTRY.\n"
+	check(t, "try", src, want)
+	// A TRY inside a TRY body, and an IF inside a CATCH body.
+	src = "METHOD m.\nTRY.\nTRY.\nx = 1.\nCATCH cx_root.\nIF a = 1.\ny = 2.\nENDIF.\nENDTRY.\nCATCH cx_root.\nz = 3.\nENDTRY.\nENDMETHOD.\n"
+	want = "  METHOD m.\n    TRY.\n        TRY.\n            x = 1.\n          CATCH cx_root.\n            IF a = 1.\n              y = 2.\n            ENDIF.\n        ENDTRY.\n      CATCH cx_root.\n        z = 3.\n    ENDTRY.\n  ENDMETHOD.\n"
+	check(t, "nested try", "CLASS c IMPLEMENTATION.\n"+src+"ENDCLASS.\n", "CLASS c IMPLEMENTATION.\n"+want+"ENDCLASS.\n")
+}
+
+func TestIndentInterface(t *testing.T) {
+	src := "INTERFACE if_x PUBLIC.\nMETHODS m IMPORTING p0 TYPE i.\nENDINTERFACE.\n"
+	want := "INTERFACE if_x PUBLIC.\n  METHODS m IMPORTING p0 TYPE i.\nENDINTERFACE.\n"
+	check(t, "interface", src, want)
+}
+
+func TestIndentReport(t *testing.T) {
+	src := "REPORT z_x.\nPARAMETERS p TYPE string.\nINITIALIZATION.\np = `a`.\nAT SELECTION-SCREEN.\nIF p IS INITIAL.\nMESSAGE e001.\nENDIF.\nSTART-OF-SELECTION.\nGET RUN TIME FIELD t.\nWRITE: / p.\nEND-OF-SELECTION.\nWRITE: / t.\nFORM sub.\nDATA q TYPE i.\nq = 1.\nENDFORM.\n"
+	want := "REPORT z_x.\nPARAMETERS p TYPE string.\nINITIALIZATION.\n  p = `a`.\nAT SELECTION-SCREEN.\n  IF p IS INITIAL.\n    MESSAGE e001.\n  ENDIF.\nSTART-OF-SELECTION.\n  GET RUN TIME FIELD t.\n  WRITE: / p.\nEND-OF-SELECTION.\n  WRITE: / t.\nFORM sub.\n  DATA q TYPE i.\n  q = 1.\nENDFORM.\n"
+	check(t, "report", src, want)
+}
+
+func TestIndentForwardClass(t *testing.T) {
+	// A forward declaration does not open a block: the following class
+	// header stays at column zero and the sections are not doubled up.
+	src := "CLASS lcl_a DEFINITION DEFERRED.\nCLASS lcl_b DEFINITION PUBLIC CREATE PUBLIC DEFERRED.\nCLASS lcl DEFINITION PUBLIC.\nPUBLIC SECTION.\nDATA o TYPE REF TO lcl_a.\nENDCLASS.\n"
+	want := "CLASS lcl_a DEFINITION DEFERRED.\nCLASS lcl_b DEFINITION PUBLIC CREATE PUBLIC DEFERRED.\nCLASS lcl DEFINITION PUBLIC.\n  PUBLIC SECTION.\n    DATA o TYPE REF TO lcl_a.\nENDCLASS.\n"
+	check(t, "forward", src, want)
+}
+
+func TestIndentRuntimeGet(t *testing.T) {
+	// Runtime GET statements are plain statements: no event reset, no body.
+	src := "CLASS c IMPLEMENTATION.\nMETHOD m.\nDATA start TYPE i.\nGET RUN TIME FIELD start.\nx = 1.\nIF x = 1.\ny = 2.\nENDIF.\nGET REFERENCE OF x INTO r.\nENDMETHOD.\nENDCLASS.\n"
+	want := "CLASS c IMPLEMENTATION.\n  METHOD m.\n    DATA start TYPE i.\n    GET RUN TIME FIELD start.\n    x = 1.\n    IF x = 1.\n      y = 2.\n    ENDIF.\n    GET REFERENCE OF x INTO r.\n  ENDMETHOD.\nENDCLASS.\n"
+	check(t, "runtime get", src, want)
+}
+
+func TestIndentLiteralsAndComments(t *testing.T) {
+	// Apparent keywords and periods inside literals, templates, escaped
+	// delimiters and comments are ignored.
+	src := "DATA a TYPE string VALUE 'ENDIF. CASE x.'.\nDATA b TYPE string VALUE `WHEN 1.`.\nDATA c TYPE string VALUE `it''s`.\nDATA d TYPE string VALUE |a \\| b|.\nWRITE |{ 1 }|.\nIF s = 'x'.\ny = 'y'. \" ENDIF. does not close\nENDIF.\n"
+	want := "DATA a TYPE string VALUE 'ENDIF. CASE x.'.\nDATA b TYPE string VALUE `WHEN 1.`.\nDATA c TYPE string VALUE `it''s`.\nDATA d TYPE string VALUE |a \\| b|.\nWRITE |{ 1 }|.\nIF s = 'x'.\n  y = 'y'. \" ENDIF. does not close\nENDIF.\n"
+	check(t, "literals", src, want)
+	// Full-line comments: * stays at column zero, " keeps its place.
+	src = "* origin comment\nDATA x TYPE i.\n\" full-line quote comment\nDATA y TYPE i.\n"
+	check(t, "comments", src, src)
+	// An indented * comment line is left where it is, at column zero content.
+	src = "*TS: file\nDATA x TYPE i.\n"
+	check(t, "origin", src, src)
+}
+
+func TestIndentMultilineStatement(t *testing.T) {
+	// Every line of a statement carries the statement's indentation.
+	src := "METHOD m.\ncl_abap_unit_assert=>assert_equals(\nact = 1\nexp = 2\n).\nENDMETHOD.\n"
+	want := "  METHOD m.\n    cl_abap_unit_assert=>assert_equals(\n    act = 1\n    exp = 2\n    ).\n  ENDMETHOD.\n"
+	check(t, "multiline", "CLASS c IMPLEMENTATION.\n"+src+"ENDCLASS.\n", "CLASS c IMPLEMENTATION.\n"+want+"ENDCLASS.\n")
+}
+
+func TestIndentMultipleStatementsPerLine(t *testing.T) {
+	// Statements stay together and still take effect on following lines.
+	src := "METHOD m.\nIF a = 1. x = 2. ENDIF.\ny = 3.\nIF a = 1.\nx = 2. ENDIF.\ny = 3.\nENDMETHOD.\n"
+	want := "  METHOD m.\n    IF a = 1. x = 2. ENDIF.\n    y = 3.\n    IF a = 1.\n      x = 2. ENDIF.\n    y = 3.\n  ENDMETHOD.\n"
+	check(t, "multi statement", "CLASS c IMPLEMENTATION.\n"+src+"ENDCLASS.\n", "CLASS c IMPLEMENTATION.\n"+want+"ENDCLASS.\n")
+}
+
+func TestIndentNumberKeepsStatement(t *testing.T) {
+	src := "METHOD m.\nIF a = 3.14.\nx = 1.\nENDIF.\nENDMETHOD.\n"
+	want := "  METHOD m.\n    IF a = 3.14.\n      x = 1.\n    ENDIF.\n  ENDMETHOD.\n"
+	check(t, "decimal", "CLASS c IMPLEMENTATION.\n"+src+"ENDCLASS.\n", "CLASS c IMPLEMENTATION.\n"+want+"ENDCLASS.\n")
+}
+
+func TestIndentSelectLoop(t *testing.T) {
+	src := "METHOD m.\nSELECT * FROM t INTO wa.\nx = 1.\nENDSELECT.\nSELECT * FROM t INTO TABLE it.\nENDMETHOD.\n"
+	want := "  METHOD m.\n    SELECT * FROM t INTO wa.\n      x = 1.\n    ENDSELECT.\n    SELECT * FROM t INTO TABLE it.\n  ENDMETHOD.\n"
+	check(t, "select", "CLASS c IMPLEMENTATION.\n"+src+"ENDCLASS.\n", "CLASS c IMPLEMENTATION.\n"+want+"ENDCLASS.\n")
+}
+
+func TestFormatWrapsLongLines(t *testing.T) {
+	long := strings.Repeat("word ", 100)
+	src := "METHOD m.\nIF a = 1.\nx = f( " + long + " ).\nENDIF.\nENDMETHOD.\n"
+	got, err := Format("CLASS c IMPLEMENTATION.\n" + src + "ENDCLASS.\n")
+	if err != nil {
+		t.Fatalf("Format: %v", err)
+	}
+	lines := strings.Split(got, "\n")
+	var wrapped bool
+	for _, line := range lines {
+		if len(line) > 255 {
+			t.Fatalf("line of %d bytes: %s", len(line), line)
+		}
+		if strings.HasPrefix(strings.TrimLeft(line, " "), "word ") {
+			wrapped = true
+			if !strings.HasPrefix(line, "      ") {
+				t.Fatalf("wrapped line lost the statement indentation: %q", line)
+			}
+		}
+	}
+	if !wrapped {
+		t.Fatal("nothing was wrapped")
+	}
+	again, err := Format(got)
+	if err != nil || again != got {
+		t.Fatalf("Format not idempotent: %v", err)
+	}
+}
+
+func TestFormatWrapKeepsLiteralsIntact(t *testing.T) {
+	lit := strings.Repeat("x", 300)
+	src := "DATA a TYPE string VALUE `" + lit + "`.\n"
+	if _, err := Format(src); err == nil {
+		t.Fatal("expected an unbreakable error for a long unbreakable literal")
+	}
+	// With a space to break at, the literal is not split inside.
+	src = "DATA a TYPE string VALUE `" + strings.Repeat("x", 150) + "` && `" + strings.Repeat("y", 200) + "`.\n"
+	got, err := Format(src)
+	if err != nil {
+		t.Fatalf("Format: %v", err)
+	}
+	for _, line := range strings.Split(got, "\n") {
+		if len(line) > 255 {
+			t.Fatalf("line of %d bytes", len(line))
+		}
+		if strings.HasPrefix(line, "&& ") {
+			t.Fatalf("wrapped inside a token: %q", line)
+		}
+	}
+	if !strings.Contains(got, "`"+strings.Repeat("y", 200)+"`") {
+		t.Fatal("literal was split")
+	}
+}
+
+func TestFormatWrapTemplateAndComment(t *testing.T) {
+	// Wrap does not cut inside a template or its interpolation, and leaves
+	// full-line comments alone.
+	tmpl := "|{ " + strings.Repeat("pad ", 20) + "} tail |"
+	src := "METHOD m.\nIF a = 1.\nx = f( aaa bbb ccc ddd eee fff ggg hhh iii jjj kkk lll mmm nnn ooo ppp qqq rrr sss ttt uuu vvv www xxx yyy zzz aaa bbb ccc ) && " + tmpl + ".\nENDIF.\nENDMETHOD.\n"
+	got, err := Format("CLASS c IMPLEMENTATION.\n" + src + "ENDCLASS.\n")
+	if err != nil {
+		t.Fatalf("Format: %v", err)
+	}
+	for _, line := range strings.Split(got, "\n") {
+		if len(line) > 255 {
+			t.Fatalf("line of %d bytes", len(line))
+		}
+		if strings.Contains(line, "|") && !strings.Contains(line, tmpl) {
+			t.Fatalf("template split across lines: %q", line)
+		}
+	}
+	if !strings.Contains(got, tmpl) {
+		t.Fatal("template missing from output")
+	}
+	comment := "* " + strings.Repeat("long comment ", 30) + "\nDATA x TYPE i.\n"
+	got, err = Format(comment)
+	if err != nil || got != comment {
+		t.Fatalf("long full-line comment should pass through: %v", err)
+	}
+}
+
+func TestFormatWrapKeepsIndentationOfContinuations(t *testing.T) {
+	// Continuation fragments keep the statement's indentation and the whole
+	// fragment (leading spaces included) stays within 255 bytes.
+	long := strings.Repeat("tok ", 200)
+	src := "METHOD m.\nIF a = 1.\nx = f( " + long + " ).\nENDIF.\nENDMETHOD.\n"
+	got, err := Format("CLASS c IMPLEMENTATION.\n" + src + "ENDCLASS.\n")
+	if err != nil {
+		t.Fatalf("Format: %v", err)
+	}
+	for _, line := range strings.Split(got, "\n") {
+		if len(line) > 255 {
+			t.Fatalf("fragment of %d bytes including indentation: %q", len(line), line)
+		}
+		if strings.HasPrefix(strings.TrimLeft(line, " "), "tok ") || strings.HasPrefix(strings.TrimLeft(line, " "), ").") {
+			if line != strings.TrimLeft(line, " ") && strings.Count(line[:len(line)-len(strings.TrimLeft(line, " "))], " ") != 6 {
+				t.Fatalf("continuation indentation wrong: %q", line)
+			}
+		}
+	}
+}
+
+func TestIndentEmptyAndBlank(t *testing.T) {
+	src := "\n\nDATA x TYPE i.\n   \nDATA y TYPE i.\n"
+	got, err := Format(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != src {
+		t.Fatalf("blank lines changed:\n%q", got)
+	}
+}
