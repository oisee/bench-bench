@@ -0,0 +1,225 @@
+package abap
+
+import "testing"
+
+func lines(v ...string) string {
+	var s string
+	for _, x := range v {
+		s += x + "\n"
+	}
+	return s
+}
+
+// The formatter follows abaplint's default indentation: two spaces per block
+// level, closers aligned with openers, middles aligned with their branch.
+func TestIndentBlocks(t *testing.T) {
+	src := lines(
+		"CLASS zcl_a DEFINITION PUBLIC CREATE PUBLIC.",
+		"PUBLIC SECTION.",
+		"METHODS run RETURNING VALUE(result) TYPE i.",
+		"PROTECTED SECTION.",
+		"PRIVATE SECTION.",
+		"ENDCLASS.",
+		"CLASS zcl_a IMPLEMENTATION.",
+		"METHOD run.",
+		"IF a = 1.",
+		"result = 1.",
+		"ELSEIF a = 2.",
+		"result = 2.",
+		"ELSE.",
+		"result = 3.",
+		"ENDIF.",
+		"CASE a.",
+		"WHEN 1.",
+		"result = 1.",
+		"WHEN OTHERS.",
+		"result = 0.",
+		"ENDCASE.",
+		"TRY.",
+		"result = zcl_a=>run( ).",
+		"CATCH cx_root INTO e.",
+		"result = 1.",
+		"CLEANUP.",
+		"result = 2.",
+		"ENDTRY.",
+		"WHILE i < 3.",
+		"i = i + 1.",
+		"ENDWHILE.",
+		"ENDMETHOD.",
+		"ENDCLASS.",
+	)
+	want := lines(
+		"CLASS zcl_a DEFINITION PUBLIC CREATE PUBLIC.",
+		"  PUBLIC SECTION.",
+		"    METHODS run RETURNING VALUE(result) TYPE i.",
+		"  PROTECTED SECTION.",
+		"  PRIVATE SECTION.",
+		"ENDCLASS.",
+		"CLASS zcl_a IMPLEMENTATION.",
+		"  METHOD run.",
+		"    IF a = 1.",
+		"      result = 1.",
+		"    ELSEIF a = 2.",
+		"      result = 2.",
+		"    ELSE.",
+		"      result = 3.",
+		"    ENDIF.",
+		"    CASE a.",
+		"      WHEN 1.",
+		"        result = 1.",
+		"      WHEN OTHERS.",
+		"        result = 0.",
+		"    ENDCASE.",
+		"    TRY.",
+		"        result = zcl_a=>run( ).",
+		"      CATCH cx_root INTO e.",
+		"        result = 1.",
+		"      CLEANUP.",
+		"        result = 2.",
+		"    ENDTRY.",
+		"    WHILE i < 3.",
+		"      i = i + 1.",
+		"    ENDWHILE.",
+		"  ENDMETHOD.",
+		"ENDCLASS.",
+	)
+	if got := indent(src); got != want {
+		t.Fatalf("got:\n%s\nwant:\n%s", got, want)
+	}
+	if indent(want) != want {
+		t.Fatal("indent is not idempotent")
+	}
+}
+
+// Interfaces and forms indent like every other block.
+func TestIndentInterfaceAndForm(t *testing.T) {
+	src := lines(
+		"INTERFACE zif_a PUBLIC.",
+		"METHODS run RETURNING VALUE(result) TYPE i.",
+		"ENDINTERFACE.",
+		"FORM run USING iv_a TYPE i CHANGING rv TYPE i.",
+		"rv = iv_a.",
+		"ENDFORM.",
+	)
+	want := lines(
+		"INTERFACE zif_a PUBLIC.",
+		"  METHODS run RETURNING VALUE(result) TYPE i.",
+		"ENDINTERFACE.",
+		"FORM run USING iv_a TYPE i CHANGING rv TYPE i.",
+		"  rv = iv_a.",
+		"ENDFORM.",
+	)
+	if got := indent(src); got != want {
+		t.Fatalf("got:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+// Report event headers open at column zero; a following form returns there.
+// A deferred class declaration opens nothing and a runtime GET opens nothing.
+func TestIndentReportAndForward(t *testing.T) {
+	src := lines(
+		"REPORT zprog.",
+		"DATA x TYPE i.",
+		"GET RUN TIME FIELD t.",
+		"CLASS lcl_x DEFINITION DEFERRED.",
+		"FORM f1.",
+		"DATA y TYPE i.",
+		"ENDFORM.",
+	)
+	want := lines(
+		"REPORT zprog.",
+		"  DATA x TYPE i.",
+		"  GET RUN TIME FIELD t.",
+		"CLASS lcl_x DEFINITION DEFERRED.",
+		"FORM f1.",
+		"  DATA y TYPE i.",
+		"ENDFORM.",
+	)
+	if got := indent(src); got != want {
+		t.Fatalf("got:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+// Keywords and periods inside literals, templates, escapes and comments are
+// inert; a full-line * comment stays at column zero.
+func TestIndentIgnoresLiterals(t *testing.T) {
+	src := lines(
+		"METHOD run.",
+		"DATA s TYPE string.",
+		"s = 'CASE x. ENDCLASS.'.",
+		"WRITE: / |{ s } CASE |.",
+		"s = `a''b`.",
+		"x = 1. y = 2. IF x = 1.",
+		"z = 3.",
+		"ENDIF.",
+		"ENDMETHOD.",
+		"* full line comment",
+	)
+	want := lines(
+		"METHOD run.",
+		"  DATA s TYPE string.",
+		"  s = 'CASE x. ENDCLASS.'.",
+		"  WRITE: / |{ s } CASE |.",
+		"  s = `a''b`.",
+		"  x = 1. y = 2. IF x = 1.",
+		"    z = 3.",
+		"  ENDIF.",
+		"ENDMETHOD.",
+		"* full line comment",
+	)
+	if got := indent(src); got != want {
+		t.Fatalf("got:\n%s\nwant:\n%s", got, want)
+	}
+	if indent(want) != want {
+		t.Fatal("literal handling is not idempotent")
+	}
+}
+
+// A multiline statement keeps its indentation on every continuation line, and
+// Format wraps over-long statements at that indentation within 255 bytes.
+func TestFormatWraps(t *testing.T) {
+	long := "x = " + rep(100) + " " + rep(100) + " " + rep(100) + "."
+	src := lines("METHOD run.", "DATA x TYPE string.", long, "ENDMETHOD.")
+	out, err := Format(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	intact := false
+	for _, line := range splitLines(out) {
+		if len(line) > 255 {
+			t.Fatalf("line of %d bytes:\n%s", len(line), out)
+		}
+		if line == "  x = "+rep(100)+" "+rep(100)+" "+rep(100)+"." {
+			intact = true
+		}
+	}
+	if intact {
+		t.Fatal("the long statement was not wrapped")
+	}
+	if again, err := Format(out); err != nil || again != out {
+		t.Fatal("Format is not idempotent")
+	}
+	if indent(out) != out {
+		t.Fatalf("wrapped source is not stable under indent:\n%s", indent(out))
+	}
+}
+
+func rep(n int) string {
+	var b []byte
+	for i := 0; i < n; i++ {
+		b = append(b, 'a')
+	}
+	return string(b)
+}
+
+func splitLines(s string) []string {
+	var out []string
+	start := 0
+	for i := 0; i < len(s); i++ {
+		if s[i] == '\n' {
+			out = append(out, s[start:i])
+			start = i + 1
+		}
+	}
+	return out
+}
