diff --git a/hir/abap/format.go b/hir/abap/format.go
new file mode 100644
index 0000000..7c553f4
--- /dev/null
+++ b/hir/abap/format.go
@@ -0,0 +1,462 @@
+// format.go re-indents and wraps generated ABAP. Indentation follows abaplint's
+// default style: two spaces per block level, closing statements aligned with
+// their openers, and alternative branches aligned with the branch they continue.
+// Indentation is recomputed from the statement structure, so existing leading
+// whitespace never influences the result and both operations are idempotent.
+package abap
+
+import (
+	"fmt"
+	"strings"
+)
+
+// blockWidth is abaplint's default indentation: two spaces per block level.
+const blockWidth = 2
+
+// lineLimit is the longest source line the ABAP compilers accept, counted in
+// bytes and including the indentation of wrapped continuation lines.
+const lineLimit = 255
+
+// frame is one open block: the column its opener sits at and the column of the
+// statements inside it. TRY and CASE bodies sit deeper than their middles,
+// which is why body is not always indent + blockWidth.
+type frame struct {
+	kind   string
+	indent int
+	body   int
+}
+
+type formatter struct {
+	stack []frame
+	quote byte // literal delimiter carried across lines, 0 outside literals
+	cont  bool // the previous line ended inside a statement
+	stmt  int  // indentation of the statement being continued
+}
+
+// indent re-indents ABAP source. Statements keep their line layout: a
+// continuation line retains its statement's indentation and several statements
+// on one line stay together while still updating the following indentation.
+func indent(src string) string {
+	f := &formatter{}
+	lines := strings.Split(src, "\n")
+	if len(lines) > 0 && lines[len(lines)-1] == "" {
+		lines = lines[:len(lines)-1]
+	}
+	var out strings.Builder
+	for _, line := range lines {
+		out.WriteString(f.line(line))
+		out.WriteByte('\n')
+	}
+	return out.String()
+}
+
+// Format indents and wraps: every line stays within lineLimit bytes, and a
+// wrapped statement continues at its own indentation.
+func Format(src string) (string, error) {
+	return wrap(indent(src))
+}
+
+// line re-indents one physical line, carrying statement and literal state.
+func (f *formatter) line(line string) string {
+	trimmed := strings.TrimLeft(line, " \t")
+	if trimmed == "" {
+		return ""
+	}
+	// A full-line * comment is not code: it stays at column zero.
+	if f.quote == 0 && strings.HasPrefix(trimmed, "*") {
+		return trimmed
+	}
+	terms, comment := f.scan(line)
+	codeEnd := comment
+	if comment < 0 {
+		codeEnd = len(line)
+	}
+	lead := 0
+	for lead < codeEnd && (line[lead] == ' ' || line[lead] == '\t') {
+		lead++
+	}
+	core := line[lead:codeEnd]
+
+	// Split the code part into statements at the terminators outside literals.
+	var frags []string
+	start := 0
+	for _, t := range terms {
+		if t < lead {
+			continue
+		}
+		frags = append(frags, core[start:t-lead])
+		start = t + 1 - lead
+	}
+	open := start < len(core) && strings.TrimRight(core[start:], " \t") != ""
+	if open {
+		frags = append(frags, core[start:])
+	}
+
+	// The line's indentation comes from its first statement, except when it
+	// continues the statement of the previous line.
+	wasCont := f.cont
+	ind := f.cur()
+	if wasCont {
+		ind = f.stmt
+	} else if len(frags) > 0 {
+		ind = f.process(frags[0])
+		for k := 1; k < len(frags); k++ {
+			f.process(frags[k])
+		}
+	}
+	f.stmt = ind
+	f.cont = open
+
+	var out strings.Builder
+	out.WriteString(strings.Repeat(" ", ind))
+	out.WriteString(strings.TrimRight(core, " \t"))
+	if comment >= 0 {
+		out.WriteString(line[comment:])
+	}
+	return out.String()
+}
+
+// scan walks a physical line outside literals, returning the byte offsets of
+// statement terminators and the offset where a trailing " comment starts (-1
+// when there is none). Quote state carries across lines, so a literal that
+// spans lines hides its keywords and periods on every line it touches.
+func (f *formatter) scan(line string) (terms []int, comment int) {
+	comment = -1
+	for i := 0; i < len(line); i++ {
+		c := line[i]
+		if f.quote != 0 {
+			if f.quote == '|' && c == '\\' {
+				i++ // escaped character in a string template
+				continue
+			}
+			if c == f.quote {
+				// A doubled delimiter is an escaped one and keeps the literal
+				// open; templates escape with the backslash instead.
+				if f.quote != '|' && i+1 < len(line) && line[i+1] == f.quote {
+					i++
+					continue
+				}
+				f.quote = 0
+				continue
+			}
+			continue
+		}
+		if c == '\'' || c == '`' || c == '|' {
+			f.quote = c
+			continue
+		}
+		if c == '"' {
+			comment = i
+			return terms, comment
+		}
+		if c == '.' {
+			terms = append(terms, i)
+		}
+	}
+	return terms, comment
+}
+
+// process applies a statement's block effect and returns the column the
+// statement itself sits at. Openers push a frame, closers pop back to their
+// opener, and middles (ELSE, WHEN, CATCH, sections) realign with the block
+// they continue before opening their own body.
+func (f *formatter) process(s string) int {
+	w := firstWord(s)
+	switch w {
+	case "CLASS":
+		f.stack = nil
+		// A forward (deferred) declaration opens no block.
+		if hasWord(s, "DEFERRED") {
+			return 0
+		}
+		f.push("CLASS", 0, blockWidth)
+		return 0
+	case "INTERFACE", "REPORT":
+		f.stack = nil
+		f.push(w, 0, blockWidth)
+		return 0
+	case "FORM", "FUNCTION":
+		// A header returns to column zero, closing any open report.
+		f.stack = nil
+		f.push(w, 0, blockWidth)
+		return 0
+	case "ENDCLASS":
+		return f.popUntil("CLASS")
+	case "ENDINTERFACE":
+		return f.popUntil("INTERFACE")
+	case "ENDMETHOD":
+		return f.popUntil("METHOD")
+	case "ENDFORM":
+		return f.popUntil("FORM")
+	case "ENDFUNCTION":
+		return f.popUntil("FUNCTION")
+	case "ENDREPORT":
+		return f.popUntil("REPORT")
+	case "ENDIF":
+		return f.popUntil("IF")
+	case "ENDWHILE":
+		return f.popUntil("WHILE")
+	case "ENDDO":
+		return f.popUntil("DO")
+	case "ENDLOOP":
+		return f.popUntil("LOOP")
+	case "ENDAT":
+		return f.popUntil("AT")
+	case "ENDCASE", "ENDSELECT":
+		return f.popUntil("CASE")
+	case "ENDTRY":
+		return f.popUntil("TRY")
+	case "PUBLIC", "PROTECTED", "PRIVATE":
+		if !hasWord(s, "SECTION") {
+			return f.cur()
+		}
+		// Sections align with each other and open their declaration list.
+		for len(f.stack) > 0 && f.stack[len(f.stack)-1].kind == "SECTION" {
+			f.stack = f.stack[:len(f.stack)-1]
+		}
+		d := f.cur()
+		f.push("SECTION", d, d+blockWidth)
+		return d
+	case "METHOD":
+		d := f.cur()
+		f.push("METHOD", d, d+blockWidth)
+		return d
+	case "IF":
+		d := f.cur()
+		f.push("IF", d, d+blockWidth)
+		return d
+	case "ELSE", "ELSEIF":
+		d := f.popUntil("IF")
+		f.push("IF", d, d+blockWidth)
+		return d
+	case "CASE", "SELECT":
+		d := f.cur()
+		f.push("CASE", d, d+blockWidth)
+		return d
+	case "WHEN":
+		d := f.find("CASE")
+		if d < 0 {
+			return f.cur()
+		}
+		f.popAbove("CASE")
+		f.push("WHEN", d+blockWidth, d+2*blockWidth)
+		return d + blockWidth
+	case "WHILE", "DO", "LOOP", "AT":
+		d := f.cur()
+		f.push(w, d, d+blockWidth)
+		return d
+	case "TRY":
+		// TRY bodies sit two levels in; CATCH and CLEANUP sit one level in.
+		d := f.cur()
+		f.push("TRY", d, d+2*blockWidth)
+		return d
+	case "CATCH", "CLEANUP":
+		d := f.find("TRY")
+		if d < 0 {
+			return f.cur()
+		}
+		f.popAbove("TRY")
+		f.push("CATCH", d+blockWidth, d+2*blockWidth)
+		return d + blockWidth
+	default:
+		return f.cur()
+	}
+}
+
+func (f *formatter) push(kind string, ind, body int) {
+	f.stack = append(f.stack, frame{kind: kind, indent: ind, body: body})
+}
+
+func (f *formatter) cur() int {
+	if len(f.stack) == 0 {
+		return 0
+	}
+	return f.stack[len(f.stack)-1].body
+}
+
+// popUntil removes every frame above and including the innermost frame of the
+// given kind, returning that frame's column (the closer aligns with it).
+func (f *formatter) popUntil(kind string) int {
+	for k := len(f.stack) - 1; k >= 0; k-- {
+		if f.stack[k].kind == kind {
+			ind := f.stack[k].indent
+			f.stack = f.stack[:k]
+			return ind
+		}
+	}
+	return f.cur()
+}
+
+// find returns the column of the innermost frame of the given kind, or -1.
+func (f *formatter) find(kind string) int {
+	for k := len(f.stack) - 1; k >= 0; k-- {
+		if f.stack[k].kind == kind {
+			return f.stack[k].indent
+		}
+	}
+	return -1
+}
+
+// popAbove keeps the innermost frame of the given kind and drops the frames
+// opened inside it, so a middle aligns with its block.
+func (f *formatter) popAbove(kind string) {
+	for k := len(f.stack) - 1; k >= 0; k-- {
+		if f.stack[k].kind == kind {
+			f.stack = f.stack[:k+1]
+			return
+		}
+	}
+}
+
+// firstWord returns the leading keyword of a statement, uppercased. Hyphens
+// stay inside the word, so CLASS-DATA never reads as CLASS.
+func firstWord(s string) string {
+	var b []byte
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if len(b) == 0 && (c == ' ' || c == '\t') {
+			continue
+		}
+		if c >= 'a' && c <= 'z' {
+			b = append(b, c-96)
+		} else if (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-' {
+			b = append(b, c)
+		} else {
+			break
+		}
+	}
+	return string(b)
+}
+
+// hasWord reports whether the statement contains the standalone word.
+func hasWord(s, word string) bool {
+	i := 0
+	for i < len(s) {
+		if isWordByte(s[i]) {
+			j := i
+			for j < len(s) && isWordByte(s[j]) {
+				j++
+			}
+			if strings.ToUpper(s[i:j]) == word {
+				return true
+			}
+			i = j
+			continue
+		}
+		i++
+	}
+	return false
+}
+
+func isWordByte(c byte) bool {
+	return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '-'
+}
+
+// wrap splits every line that exceeds lineLimit bytes at a space outside
+// literals. Continuation lines keep the statement's indentation, so the byte
+// budget includes the leading spaces, and a trailing comment never gets split.
+func wrap(src string) (string, error) {
+	var out strings.Builder
+	lines := strings.Split(src, "\n")
+	if len(lines) > 0 && lines[len(lines)-1] == "" {
+		lines = lines[:len(lines)-1]
+	}
+	for _, line := range lines {
+		if len(line) <= lineLimit {
+			out.WriteString(line + "\n")
+			continue
+		}
+		trimmed := strings.TrimLeft(line, " \t")
+		if strings.HasPrefix(trimmed, "*") {
+			out.WriteString(line + "\n") // a full-line comment cannot wrap
+			continue
+		}
+		indent := line[:len(line)-len(strings.TrimLeft(line, " \t"))]
+		comment := commentOffset(line)
+		var breaks []int
+		var quote byte
+		end := len(line)
+		if comment >= 0 {
+			end = comment
+		}
+		for i := len(indent); i < end; i++ {
+			c := line[i]
+			if quote != 0 {
+				if quote == '|' && c == '\\' {
+					i++
+				} else if c == quote {
+					if quote != '|' && i+1 < len(line) && line[i+1] == quote {
+						i++
+					} else {
+						quote = 0
+					}
+				}
+				continue
+			}
+			if c == '\'' || c == '`' || c == '|' {
+				quote = c
+			} else if c == ' ' {
+				breaks = append(breaks, i)
+			}
+		}
+		start := len(indent)
+		for len(indent)+len(line)-start > lineLimit {
+			best := -1
+			for _, b := range breaks {
+				if b <= start {
+					continue
+				}
+				if len(indent)+b-start <= lineLimit {
+					best = b
+					continue
+				}
+				break
+			}
+			if best < 0 {
+				for _, b := range breaks {
+					if b > start {
+						best = b
+						break
+					}
+				}
+			}
+			if best <= start {
+				return "", fmt.Errorf("unbreakable source line (%d bytes)", len(line))
+			}
+			out.WriteString(indent + strings.TrimRight(line[start:best], " \t") + "\n")
+			start = best
+			for start < len(line) && line[start] == ' ' {
+				start++
+			}
+		}
+		out.WriteString(indent + line[start:] + "\n")
+	}
+	return out.String(), nil
+}
+
+// commentOffset returns where a trailing " comment starts outside literals,
+// or -1.
+func commentOffset(line string) int {
+	var quote byte
+	for i := 0; i < len(line); i++ {
+		c := line[i]
+		if quote != 0 {
+			if quote == '|' && c == '\\' {
+				i++
+			} else if c == quote {
+				if quote != '|' && i+1 < len(line) && line[i+1] == quote {
+					i++
+				} else {
+					quote = 0
+				}
+			}
+			continue
+		}
+		if c == '\'' || c == '`' || c == '|' {
+			quote = c
+		} else if c == '"' {
+			return i
+		}
+	}
+	return -1
+}
