diff --git a/hir/abap/format.go b/hir/abap/format.go
new file mode 100644
index 0000000..7888bda
--- /dev/null
+++ b/hir/abap/format.go
@@ -0,0 +1,351 @@
+package abap
+
+import (
+	"fmt"
+	"strings"
+)
+
+// sourceCode marks bytes outside comments and literals, including complete
+// string templates (whose expressions may themselves contain literals).
+func sourceCode(src string) []bool {
+	code := make([]bool, len(src))
+	type mode struct {
+		kind   byte
+		braces int
+	}
+	var modes []mode
+	comment, lineStart := false, true
+	for i := 0; i < len(src); i++ {
+		c := src[i]
+		if c == '\n' {
+			code[i] = len(modes) == 0
+			comment = false
+			lineStart = true
+			continue
+		}
+		if comment {
+			continue
+		}
+		if len(modes) > 0 {
+			m := &modes[len(modes)-1]
+			switch m.kind {
+			case '\'', '`':
+				if c == m.kind {
+					if i+1 < len(src) && src[i+1] == c {
+						i++
+					} else {
+						modes = modes[:len(modes)-1]
+					}
+				}
+			case '|':
+				if c == '\\' {
+					i++
+				} else if c == '|' {
+					modes = modes[:len(modes)-1]
+				} else if c == '{' {
+					modes = append(modes, mode{kind: '{', braces: 1})
+				}
+			case '{':
+				switch c {
+				case '\'', '`', '|':
+					modes = append(modes, mode{kind: c})
+				case '{':
+					m.braces++
+				case '}':
+					m.braces--
+					if m.braces == 0 {
+						modes = modes[:len(modes)-1]
+					}
+				case '"':
+					comment = true
+				}
+			}
+			lineStart = false
+			continue
+		}
+		if c == '"' || (lineStart && c == '*') {
+			comment = true
+			continue
+		}
+		lineStart = false
+		if c == '\'' || c == '`' || c == '|' {
+			modes = append(modes, mode{kind: c})
+			continue
+		}
+		code[i] = true
+	}
+	return code
+}
+
+type indentBlock struct {
+	kind string
+	base int
+}
+type abapStatement struct {
+	first, last int
+	words       []string
+}
+
+// indent applies abaplint's default, fixed two-space block indentation.
+// It changes only leading whitespace outside literals and comments.
+func indent(src string) string {
+	code := sourceCode(src)
+	lines := strings.Split(src, "\n")
+	levels := make([]int, len(lines))
+	opaque := make([]bool, len(lines))
+	var statements []abapStatement
+	stmt := abapStatement{first: -1}
+	line, word := 0, ""
+	flush := func() {
+		if word != "" {
+			stmt.words = append(stmt.words, strings.ToUpper(word))
+			word = ""
+		}
+	}
+	for i := 0; i < len(src); i++ {
+		c := src[i]
+		if c == '\n' {
+			flush()
+			line++
+			continue
+		}
+		if !code[i] {
+			flush()
+			// A literal on a continuation line must keep its literal whitespace.
+			if i == 0 || src[i-1] == '\n' {
+				opaque[line] = i > 0 && !code[i-1]
+			}
+			if stmt.first < 0 && (c == '\'' || c == '`' || c == '|') {
+				stmt.first = line
+			}
+			continue
+		}
+		if c == ' ' || c == '\t' || c == '\r' {
+			flush()
+			continue
+		}
+		if stmt.first < 0 {
+			stmt.first = line
+		}
+		if c == '.' && (i+1 == len(src) || strings.ContainsRune(" \t\r\n\"", rune(src[i+1]))) {
+			flush()
+			stmt.last = line
+			statements = append(statements, stmt)
+			stmt = abapStatement{first: -1}
+		} else {
+			word += string(c)
+		}
+	}
+	flush()
+	if stmt.first >= 0 {
+		stmt.last = line
+		statements = append(statements, stmt)
+	}
+	var stack []indentBlock
+	depth := 0
+	pop := func(kind string) int {
+		for i := len(stack) - 1; i >= 0; i-- {
+			if stack[i].kind == kind {
+				base := stack[i].base
+				stack = stack[:i]
+				depth = base
+				return base
+			}
+		}
+		return depth
+	}
+	push := func(kind string, base, body int) { stack = append(stack, indentBlock{kind, base}); depth = body }
+	nextLine := 0
+	for _, s := range statements {
+		for nextLine < s.first {
+			levels[nextLine] = depth
+			nextLine++
+		}
+		at := depth
+		if len(s.words) > 0 {
+			w := s.words[0]
+			joined := " " + strings.Join(s.words, " ") + " "
+			assignment := len(s.words) > 1 && (s.words[1] == "=" || s.words[1] == "?=" || s.words[1] == "+=" || s.words[1] == "-=")
+			if !assignment {
+				switch {
+				case w == "CLASS":
+					at = 0
+					if !strings.Contains(joined, " DEFERRED ") && !strings.Contains(joined, " LOAD ") {
+						stack = nil
+						push("CLASS", 0, 2)
+					}
+				case w == "PUBLIC" || w == "PROTECTED" || w == "PRIVATE":
+					if strings.Contains(joined, " SECTION ") {
+						at = 2
+						depth = 4
+					}
+				case w == "ENDCLASS":
+					at = pop("CLASS")
+				case w == "INTERFACE":
+					at = 0
+					push(w, at, at+2)
+				case w == "ENDINTERFACE":
+					at = pop("INTERFACE")
+				case w == "METHOD" || w == "FORM" || w == "FUNCTION" || w == "MODULE":
+					if w != "METHOD" {
+						stack = nil
+						at = 0
+					}
+					push(w, at, at+2)
+				case w == "ENDMETHOD" || w == "ENDFORM" || w == "ENDFUNCTION" || w == "ENDMODULE":
+					at = pop(strings.TrimPrefix(w, "END"))
+				case w == "ELSE" || w == "ELSEIF":
+					at = pop("IF")
+					push("IF", at, at+2)
+				case w == "WHEN":
+					base := pop("CASE")
+					at = base + 2
+					push("CASE", base, base+4)
+				case w == "CATCH" && len(s.words) > 1 && s.words[1] == "SYSTEM-EXCEPTIONS":
+					push("CATCH", at, at+2)
+				case w == "ENDCATCH":
+					at = pop("CATCH")
+				case w == "ON" && len(s.words) > 1 && s.words[1] == "CHANGE":
+					push("ON", at, at+2)
+				case w == "ENDON":
+					at = pop("ON")
+				case w == "CATCH" || w == "CLEANUP":
+					base := pop("TRY")
+					at = base + 2
+					push("TRY", base, base+4)
+				case w == "IF" || w == "DO" || w == "WHILE" || w == "LOOP" || w == "CASE" || w == "SELECT" && !strings.Contains(joined, " SINGLE ") && !strings.Contains(joined, " TABLE ") && !strings.Contains(joined, " COUNT(") && !strings.Contains(joined, " MAX(") && !strings.Contains(joined, " MIN(") && !strings.Contains(joined, " SUM(") && !strings.Contains(joined, " AVG("):
+					push(w, at, at+2)
+				case w == "DEFINE":
+					push("DEFINITION", at, at+2)
+				case w == "END-OF-DEFINITION":
+					at = pop("DEFINITION")
+				case w == "PROVIDE" || w == "TEST-SEAM" || w == "TEST-INJECTION":
+					push(w, at, at+2)
+				case w == "ENDPROVIDE":
+					at = pop("PROVIDE")
+				case w == "END-TEST-SEAM":
+					at = pop("TEST-SEAM")
+				case w == "END-TEST-INJECTION":
+					at = pop("TEST-INJECTION")
+				case w == "TRY":
+					push(w, at, at+4)
+				case w == "ENDIF" || w == "ENDDO" || w == "ENDWHILE" || w == "ENDLOOP" || w == "ENDCASE" || w == "ENDTRY" || w == "ENDSELECT" || w == "ENDAT":
+					at = pop(strings.TrimPrefix(w, "END"))
+				case w == "AT" && (strings.HasPrefix(joined, " AT NEW ") || strings.HasPrefix(joined, " AT END OF ") || strings.HasPrefix(joined, " AT FIRST ") || strings.HasPrefix(joined, " AT LAST ")):
+					push("AT", at, at+2)
+				case reportEvent(s.words):
+					stack = nil
+					at = 0
+					push("EVENT", 0, 2)
+				}
+			}
+		}
+		for n := s.first; n <= s.last; n++ {
+			if n >= nextLine {
+				levels[n] = at
+				nextLine = n + 1
+			}
+		}
+	}
+	for nextLine < len(lines) {
+		levels[nextLine] = depth
+		nextLine++
+	}
+	for n, l := range lines {
+		if opaque[n] || strings.HasPrefix(l, "*") {
+			continue
+		}
+		body := strings.TrimLeft(l, " \t")
+		if body == "" || body == "\r" {
+			lines[n] = body
+			continue
+		}
+		lines[n] = strings.Repeat(" ", levels[n]) + body
+	}
+	return strings.Join(lines, "\n")
+}
+
+func reportEvent(words []string) bool {
+	switch words[0] {
+	case "INITIALIZATION", "START-OF-SELECTION", "END-OF-SELECTION", "TOP-OF-PAGE", "END-OF-PAGE", "LOAD-OF-PROGRAM":
+		return true
+	case "AT":
+		return len(words) > 1 && (words[1] == "SELECTION-SCREEN" || words[1] == "LINE-SELECTION" || words[1] == "USER-COMMAND" || strings.HasPrefix(words[1], "PF"))
+	case "GET":
+		return (len(words) == 2 || len(words) == 3 && words[2] == "LATE") && words[1] != "REFERENCE" && words[1] != "TIME" && words[1] != "RUN" && words[1] != "BIT" && words[1] != "PARAMETER" && words[1] != "CURSOR" && words[1] != "DATASET" && words[1] != "LOCALE" && words[1] != "BADI" && words[1] != "PF-STATUS" && words[1] != "PROPERTY"
+	}
+	return false
+}
+
+// Format indents ABAP and wraps statements at whitespace outside literals and
+// comments. The 255-byte limit includes indentation. Unbreakable lines fail.
+func Format(src string) (string, error) {
+	// Wrapping can move a statement that followed an opener onto its own
+	// line. Recompute indentation until both layout operations agree.
+	for {
+		out, err := wrap(indent(src))
+		if err != nil {
+			return "", err
+		}
+		if out == src {
+			return out, nil
+		}
+		src = out
+	}
+}
+
+func wrap(src string) (string, error) {
+	code := sourceCode(src)
+	var out strings.Builder
+	offset := 0
+	for _, line := range strings.SplitAfter(src, "\n") {
+		body := strings.TrimSuffix(line, "\n")
+		prefix := body[:len(body)-len(strings.TrimLeft(body, " \t"))]
+		start := 0
+		for len(body)-start+len(prefix) > 255 {
+			// The first segment already includes its indentation.
+			added := len(prefix)
+			if start == 0 {
+				added = 0
+			}
+			if len(body)-start+added <= 255 {
+				break
+			}
+			cut := -1
+			for i := start; i < len(body) && i-start+added <= 255; i++ {
+				if code[offset+i] && (body[i] == ' ' || body[i] == '\t') && i > start && strings.TrimSpace(body[start:i]) != "" {
+					// A star at column zero would turn an operator into a comment.
+					next := i + 1
+					for next < len(body) && (body[next] == ' ' || body[next] == '\t') {
+						next++
+					}
+					if len(prefix) == 0 && next < len(body) && body[next] == '*' {
+						continue
+					}
+					cut = i
+				}
+			}
+			if cut < 0 {
+				return "", fmt.Errorf("unbreakable source line (%d bytes)", len(body)-start+added)
+			}
+			if start > 0 {
+				out.WriteString(prefix)
+			}
+			out.WriteString(body[start:cut])
+			out.WriteByte('\n')
+			start = cut + 1
+			for start < len(body) && code[offset+start] && (body[start] == ' ' || body[start] == '\t') {
+				start++
+			}
+		}
+		if start > 0 {
+			out.WriteString(prefix)
+		}
+		out.WriteString(body[start:])
+		if strings.HasSuffix(line, "\n") {
+			out.WriteByte('\n')
+		}
+		offset += len(line)
+	}
+	return out.String(), nil
+}
