@@ -0,0 +1,113 @@
+package abap
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestIndent(t *testing.T) {
+	cases := []struct{ name, src, want string }{
+		{"class", "CLASS lcl DEFINITION.\nPUBLIC SECTION.\nMETHODS run\nIMPORTING val TYPE i.\nPROTECTED SECTION.\nDATA val TYPE i.\nPRIVATE SECTION.\nENDCLASS.\nCLASS lcl IMPLEMENTATION.\nMETHOD run.\nIF val = 1.\nval = 2.\nELSEIF val = 2.\nval = 3.\nELSE.\nval = 4.\nENDIF.\nENDMETHOD.\nENDCLASS.\n", "CLASS lcl DEFINITION.\n  PUBLIC SECTION.\n    METHODS run\n    IMPORTING val TYPE i.\n  PROTECTED SECTION.\n    DATA val TYPE i.\n  PRIVATE SECTION.\nENDCLASS.\nCLASS lcl IMPLEMENTATION.\n  METHOD run.\n    IF val = 1.\n      val = 2.\n    ELSEIF val = 2.\n      val = 3.\n    ELSE.\n      val = 4.\n    ENDIF.\n  ENDMETHOD.\nENDCLASS.\n"},
+		{"case and try", "CASE val.\nWHEN 1.\nTRY.\nval = 2.\nCATCH cx_root.\nval = 3.\nCLEANUP.\nval = 4.\nENDTRY.\nWHEN OTHERS.\nval = 5.\nENDCASE.\n", "CASE val.\n  WHEN 1.\n    TRY.\n        val = 2.\n      CATCH cx_root.\n        val = 3.\n      CLEANUP.\n        val = 4.\n    ENDTRY.\n  WHEN OTHERS.\n    val = 5.\nENDCASE.\n"},
+		{"events and forms", "REPORT demo.\nCLASS lcl DEFINITION DEFERRED.\nINITIALIZATION.\nGET TIME STAMP FIELD stamp.\nGET REFERENCE OF stamp INTO ref.\nSTART-OF-SELECTION.\nGET RUN TIME FIELD timer.\nAT SELECTION-SCREEN.\nWRITE 'hello'.\nFORM run.\nDO 2 TIMES.\nWRITE 'x'.\nENDDO.\nENDFORM.\n", "REPORT demo.\nCLASS lcl DEFINITION DEFERRED.\nINITIALIZATION.\n  GET TIME STAMP FIELD stamp.\n  GET REFERENCE OF stamp INTO ref.\nSTART-OF-SELECTION.\n  GET RUN TIME FIELD timer.\nAT SELECTION-SCREEN.\n  WRITE 'hello'.\nFORM run.\n  DO 2 TIMES.\n    WRITE 'x'.\n  ENDDO.\nENDFORM.\n"},
+		{"interface", "INTERFACE lif.\nMETHODS run\nRETURNING VALUE(val) TYPE i.\nENDINTERFACE.", "INTERFACE lif.\n  METHODS run\n  RETURNING VALUE(val) TYPE i.\nENDINTERFACE."},
+		{"same line", "IF a = 1. DO 2 TIMES.\na = 2. ENDDO. ELSE.\na = 3.\nENDIF.\nb = 4.", "IF a = 1. DO 2 TIMES.\n    a = 2. ENDDO. ELSE.\n  a = 3.\nENDIF.\nb = 4."},
+		{"lexical", "IF a = 1.\n* ENDIF. ' comment contents\na = 'it''s ENDIF.'.\nb = `a``b. ELSE.`.\nc = |\\| ENDIF. { cond #( WHEN a = `|` THEN |nested { a }| ) }|.\n\" ENDIF. full comment\na = 1. \" ELSE.\nENDIF.", "IF a = 1.\n* ENDIF. ' comment contents\n  a = 'it''s ENDIF.'.\n  b = `a``b. ELSE.`.\n  c = |\\| ENDIF. { cond #( WHEN a = `|` THEN |nested { a }| ) }|.\n  \" ENDIF. full comment\n  a = 1. \" ELSE.\nENDIF."},
+		{"multiline literal", "IF a = 1.\na = |first\n  ENDIF. literal\n last|.\nENDIF.", "IF a = 1.\n  a = |first\n  ENDIF. literal\n last|.\nENDIF."},
+		{"keyword variable", "IF a = 1.\nclass = 1.\nif = 2.\nENDIF.", "IF a = 1.\n  class = 1.\n  if = 2.\nENDIF."},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := indent(tc.src)
+			if got != tc.want {
+				t.Fatalf("got:\n%s\nwant:\n%s", got, tc.want)
+			}
+			if indent(got) != got {
+				t.Fatal("indent is not idempotent")
+			}
+			formatted, err := Format(tc.src)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if formatted != tc.want {
+				t.Fatalf("Format = %q", formatted)
+			}
+		})
+	}
+}
+
+func TestFormatWrap(t *testing.T) {
+	literal := "'" + strings.Repeat("é", 70) + "'' ENDIF.'"
+	src := "CLASS lcl IMPLEMENTATION.\nMETHOD run.\ncall( " + strings.Repeat("param = "+literal+" ", 5) + "). \" final comment\nENDMETHOD.\nENDCLASS.\n"
+	got, err := Format(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, line := range strings.Split(got, "\n") {
+		if len(line) > 255 {
+			t.Fatalf("line is %d bytes", len(line))
+		}
+		if strings.Contains(line, "param") && !strings.HasPrefix(line, "    ") {
+			t.Fatalf("continuation indentation: %q", line)
+		}
+	}
+	if strings.Count(got, literal) != 5 || !strings.Contains(got, "\" final comment") {
+		t.Fatal("literal or comment changed")
+	}
+	again, err := Format(got)
+	if err != nil || again != got {
+		t.Fatalf("Format not idempotent: %v\n%s", err, again)
+	}
+	for _, src := range []string{"WRITE '" + strings.Repeat("x", 256) + "'.", "* " + strings.Repeat("x", 256), "WRITE x. \" " + strings.Repeat("x", 256)} {
+		if _, err := Format(src); err == nil {
+			t.Fatal("expected unbreakable line error")
+		}
+	}
+}
+
+func TestFormatSameLineWrap(t *testing.T) {
+	src := "IF flag = abap_true. call( " + strings.Repeat("param = value ", 60) + "). ENDIF.\n"
+	got, err := Format(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	again, err := Format(got)
+	if err != nil || got != again {
+		t.Fatalf("not idempotent: %v\nfirst:\n%s\nsecond:\n%s", err, got, again)
+	}
+}
+
+func TestFormatKeepsMultiplication(t *testing.T) {
+	src := "value = " + strings.Repeat("factor + ", 27) + "factor * 2.\n"
+	got, err := Format(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, line := range strings.Split(got, "\n") {
+		if strings.HasPrefix(line, "*") {
+			t.Fatalf("operator became a comment: %q", line)
+		}
+	}
+	again, err := Format(got)
+	if err != nil || again != got {
+		t.Fatal("not idempotent")
+	}
+}
+
+func TestGeneratedSourcesFormatted(t *testing.T) {
+	for _, fixture := range fixtures() {
+		files, err := Emit(fixture.p)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for name, src := range files {
+			formatted, err := Format(src)
+			if err != nil {
+				t.Fatalf("%s: %v", name, err)
+			}
+			if formatted != src {
+				t.Fatalf("%s was not formatted", name)
+			}
+		}
+	}
+}
