diff --git a/tsfront/driver_format_test.go b/tsfront/driver_format_test.go
new file mode 100644
index 0000000..a17d684
--- /dev/null
+++ b/tsfront/driver_format_test.go
@@ -0,0 +1,36 @@
+package tsfront
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/oisee/abapiti/hir"
+	"github.com/oisee/abapiti/hir/abap"
+)
+
+func TestDriversFormatted(t *testing.T) {
+	names := hir.NewNames()
+	sources := []string{
+		LexerTestClass(nil, DriverParams{}),
+		StatementsTestClass(nil, DriverParams{}, "tokens", "statements"),
+		StructuresBenchmarkReport(),
+		StructuresBenchmarkTest(),
+		RegistryRunClass("zcl_run", nil, "{}", "hash", 0, names),
+		RegistryRunCorpusClass("zcl_run", "hash", nil, names),
+		RegistryRunTest("zcl_run", "zcl_trap"),
+		RegistryRunReport("zreport", "zcl_run", false),
+		RegistryCLIReport("zreport", names),
+	}
+	for i, src := range sources {
+		got, err := abap.Format(src)
+		if err != nil {
+			t.Fatalf("driver %d: %v", i, err)
+		}
+		if got != src {
+			t.Fatalf("driver %d was not formatted", i)
+		}
+	}
+	if !strings.Contains(sources[3], "  METHOD benchmark.\n    DATA ok") {
+		t.Fatal("benchmark body indentation")
+	}
+}
