diff --git a/tsfront/harness_format_test.go b/tsfront/harness_format_test.go
new file mode 100644
index 0000000..069bdd4
--- /dev/null
+++ b/tsfront/harness_format_test.go
@@ -0,0 +1,56 @@
+package tsfront
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/oisee/abapiti/hir"
+	"github.com/oisee/abapiti/hir/abap"
+)
+
+// A driver or report program is generated ABAP like every other object: what
+// the builders return is already what the formatter produces, so formatting it
+// again changes nothing and no line is longer than the kernel reads.
+func TestHarnessTextsAreFormatted(t *testing.T) {
+	var names = hir.NewNames()
+	var one = StructureCase{Name: "a", Abap: "DATA x TYPE i.\nWRITE x.\n", Filename: "src/a.ts", Tokens: 2, Statements: 1}
+	var inputs = []RegistryFile{{Name: "src/a.ts", Raw: "DATA x TYPE i.\n"}, {Name: "src/deps/b.ts", Raw: "REPORT b.\n", Dependency: true}}
+	var negative = RegistryNegative{SHA: "deadbeef",
+		Extra:  []RegistryFile{{Name: "src/e.ts", Raw: "DATA e TYPE i.\n"}},
+		Append: []RegistryFile{{Name: "src/a.ts", Raw: "DATA e TYPE i.\n"}}}
+	var texts = map[string]string{
+		"registry run class":       RegistryRunClass("zcl_registry_run", inputs, `{"rules":{}}`, "sha", 0, names),
+		"registry test class":      RegistryRunTest("zcl_registry_run", "lx"),
+		"registry corpus class":    RegistryRunCorpusClass("zcl_registry_a4h", "sha", nil, names),
+		"registry corpus negative": RegistryRunCorpusClass("zcl_registry_a4h", "sha", &negative, names),
+		"registry run report":      RegistryRunReport("zlnt_registry_run", "zcl_registry_a4h", false),
+		"registry clean report":    RegistryRunReport("zlnt_registry_clean", "zcl_registry_a4h", true),
+		"registry cli report":      RegistryCLIReport("zabaplint", names),
+		"structures class":         StructuresBenchmarkClass(one, "a", "b", names),
+		"structures report":        StructuresBenchmarkReport(),
+		"structures test class":    StructuresBenchmarkTest(),
+	}
+	for name, text := range texts {
+		var laid, err = abap.Format(text)
+		if err != nil {
+			t.Fatalf("%s: Format: %v", name, err)
+		}
+		if laid != text {
+			t.Fatalf("%s: shipped layout is not the formatter's\n--- got\n%s--- want\n%s", name, laid, text)
+		}
+		for _, line := range strings.Split(text, "\n") {
+			if len(line) > 255 {
+				t.Fatalf("%s: %d byte line: %s", name, len(line), line)
+			}
+		}
+	}
+	// A report body sits two spaces inside its block; a file level statement
+	// under the REPORT header stays at column zero.
+	var report = RegistryRunReport("zlnt_registry_run", "zcl_registry_a4h", false)
+	if !strings.Contains(report, "WHILE off < strlen( report ).\n  part = substring(") {
+		t.Fatal("report body is not indented:\n" + report)
+	}
+	if !strings.HasPrefix(report, "REPORT zlnt_registry_run.\nDATA report TYPE string.") {
+		t.Fatal("report header moved:\n" + report)
+	}
+}
