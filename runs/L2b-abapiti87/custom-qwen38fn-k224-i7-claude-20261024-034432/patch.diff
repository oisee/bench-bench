 	"github.com/oisee/abapiti/hir"
+	"github.com/oisee/abapiti/hir/abap"
 )
 
+// harnessSource lays a driver or report text out the way EmitNamed lays out the
+// classes it drives: indentation first, then the wrap that keeps every line
+// inside the kernel's limit. The builders below write one statement per line
+// without thinking about blocks, so this is what puts them in abaplint's style.
+func harnessSource(src string) string {
+	out, err := abap.Format(src)
+	if err != nil {
+		panic(fmt.Errorf("tsfront: harness source is not formattable: %w", err))
+	}
+	return out
+}
