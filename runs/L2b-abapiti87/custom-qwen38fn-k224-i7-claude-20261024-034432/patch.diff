+++ b/hir/abap/format.go
@@ -0,0 +1,579 @@
+// Format normalises generated ABAP source: indentation first, then the line
+// wrap that keeps every source line inside the kernel's limit. Both operations
+// are idempotent, and neither one rewrites statement text, literals or comments.
+
+package abap
+
+import (
+	"fmt"
+	"strings"
+)
+
+// maxLineBytes is the longest source line the ABAP kernel reads, leading
+// indentation included.
+const maxLineBytes = 255
+
+// Roles one of the structural keywords gives the statement that opens with it.
+const (
+	sNeutral = 0
+	sOpen    = 1
+	sClose   = 2
+	sBranch  = 3
+)
+
+// Block kinds an opener and its closer agree on. kRoot is the file itself.
+const (
+	kRoot      = 0
+	kIf        = 1
+	kCase      = 2
+	kTry       = 3
+	kClass     = 4
+	kInterface = 5
+	kMethod    = 6
+	kForm      = 7
+	kFunction  = 8
+	kDo        = 9
+	kWhile     = 10
+	kLoop      = 11
+	kScreen    = 12
+)
+
+// Branch kinds pick where an alternative branch sits inside its block and how
+// far that branch's own body sits.
+const (
+	bIf      = 1
+	bWhen    = 2
+	bCatch   = 3
+	bSection = 4
+	bEvent   = 5
+)
+
+// block says what the statements beginning with a keyword do to the block
+// context: the block they open or close, how far its body sits, or which block
+// an alternative branch belongs to.
+type block struct {
+	role   int
+	kind   int
+	level  int
+	branch int
+	reset  bool // a file-level statement: it ends any open report event
+}
+
+// keyword maps an ABAP statement's first word to its block. Hyphenated words
+// (CLASS-DATA, START-OF-SELECTION, …) are single words and stay neutral unless
+// listed. CLASS and SELECTION-SCREEN are told apart by the words they carry.
+var keyword = map[string]block{
+	"IF":           block{sOpen, kIf, 1, 0, false},
+	"WHILE":        block{sOpen, kWhile, 1, 0, false},
+	"DO":           block{sOpen, kDo, 1, 0, false},
+	"LOOP":         block{sOpen, kLoop, 1, 0, false},
+	"CASE":         block{sOpen, kCase, 1, 0, false},
+	"SELECT":       block{sOpen, kCase, 1, 0, false},
+	"TRY":          block{sOpen, kTry, 2, 0, false},
+	"CLASS":        block{sOpen, kClass, 1, 0, true},
+	"INTERFACE":    block{sOpen, kInterface, 1, 0, true},
+	"METHOD":       block{sOpen, kMethod, 1, 0, false},
+	"FORM":         block{sOpen, kForm, 1, 0, true},
+	"FUNCTION":     block{sOpen, kFunction, 1, 0, true},
+	"ELSE":         block{sBranch, 0, 0, bIf, false},
+	"ELSEIF":       block{sBranch, 0, 0, bIf, false},
+	"WHEN":         block{sBranch, 0, 0, bWhen, false},
+	"CATCH":        block{sBranch, 0, 0, bCatch, false},
+	"CLEANUP":      block{sBranch, 0, 0, bCatch, false},
+	"ENDIF":        block{sClose, kIf, 0, 0, false},
+	"ENDCASE":      block{sClose, kCase, 0, 0, false},
+	"ENDSELECT":    block{sClose, kCase, 0, 0, false},
+	"ENDTRY":       block{sClose, kTry, 0, 0, false},
+	"ENDCATCH":     block{sClose, kTry, 0, 0, false},
+	"ENDCLASS":     block{sClose, kClass, 0, 0, false},
+	"ENDINTERFACE": block{sClose, kInterface, 0, 0, false},
+	"ENDMETHOD":    block{sClose, kMethod, 0, 0, false},
+	"ENDFORM":      block{sClose, kForm, 0, 0, false},
+	"ENDFUNCTION":  block{sClose, kFunction, 0, 0, false},
+	"ENDWHILE":     block{sClose, kWhile, 0, 0, false},
+	"ENDDO":        block{sClose, kDo, 0, 0, false},
+	"ENDLOOP":      block{sClose, kLoop, 0, 0, false},
+	// Report events: the header sits at column zero, its body two spaces in,
+	// and the next event header or file-level statement opens the next one.
+	"INITIALIZATION":     block{sBranch, 0, 0, bEvent, false},
+	"START-OF-SELECTION": block{sBranch, 0, 0, bEvent, false},
+	"END-OF-SELECTION":   block{sBranch, 0, 0, bEvent, false},
+	"AT":                 block{sBranch, 0, 0, bEvent, false},
+	"REPORT":             block{sNeutral, 0, 0, 0, true},
+}
+
+// lInfo is one physical source line as the analysis sees it.
+type lInfo struct {
+	text string
+	kind byte // 'n' statement line, 'b' blank, 'c' full-line comment, 'v' verbatim
+	open bool // a statement begun on this or an earlier line is still open
+	cuts []int
+}
+
+// stmt is one ABAP statement: the line it starts on, the block effect it has,
+// the block a branch belongs to, and whether the pairing found that block.
+type stmt struct {
+	line   int
+	role   int
+	kind   int
+	level  int
+	branch int
+	reset  bool
+	owner  int // statement index of the block a branch belongs to, -2 for events
+	dead   bool
+}
+
+// Format re-indents ABAP source and breaks every line that exceeds the kernel
+// limit; a continuation keeps its statement's indentation.
+func Format(src string) (string, error) {
+	var lines, stmts = analyse(src)
+	var ind = layout(lines, stmts)
+	return wrapLines(lines, ind)
+}
+
+// indent re-indents ABAP source, leaving line breaks where they already are.
+func indent(src string) string {
+	var lines, stmts = analyse(src)
+	return render(lines, layout(lines, stmts))
+}
+
+// analyse splits the source into lines and statements. Literals, string
+// templates, escaped delimiters and comments are walked but never segmented,
+// so keywords and statement-ending periods inside them are not mistaken for
+// structure.
+func analyse(src string) ([]lInfo, []stmt) {
+	var lines []lInfo
+	var stmts []stmt
+	var quote byte      // the open literal's delimiter, 0 outside literals
+	var carried = false // a statement begun on an earlier line is still open
+	for _, raw := range strings.Split(strings.TrimSuffix(src, "\n"), "\n") {
+		var body = strings.TrimRight(raw, "\r")
+		if quote != 0 {
+			// Inside a literal that spans lines: the leading blanks are value.
+			lines = append(lines, lInfo{body, 'v', carried, []int{}})
+			quote = walk(body, quote).q
+			continue
+		}
+		var trimmed = strings.TrimLeft(body, " \t")
+		if trimmed == "" {
+			lines = append(lines, lInfo{trimmed, 'b', carried, []int{}})
+			continue
+		}
+		if trimmed[0] == '*' {
+			lines = append(lines, lInfo{trimmed, 'c', carried, []int{}})
+			continue
+		}
+		var scan = walk(trimmed, quote)
+		quote = scan.q
+		var cuts []int
+		var p = 0
+		var pending = carried
+		for _, dot := range scan.dots {
+			if !pending {
+				var start = skipSpace(trimmed, p)
+				if start < dot {
+					stmts = append(stmts, statement(trimmed, start, len(lines), scan.comment))
+				}
+			}
+			cuts = addAll(cuts, innerCuts(trimmed, scan, p, dot))
+			p = dot + 1
+			pending = false
+		}
+		var end = len(trimmed)
+		if scan.comment >= 0 {
+			end = scan.comment
+		}
+		if skipSpace(trimmed, p) < end {
+			// Text past the last period runs on: it keeps this indentation.
+			if !pending {
+				stmts = append(stmts, statement(trimmed, skipSpace(trimmed, p), len(lines), scan.comment))
+			}
+			cuts = addAll(cuts, innerCuts(trimmed, scan, p, end))
+			pending = true
+		}
+		lines = append(lines, lInfo{trimmed, 'n', pending, cuts})
+	}
+	return lines, stmts
+}
+
+// lineScan reports what a line body holds outside literals: where statements
+// end, where a trailing comment starts and where words are separated.
+type lineScan struct {
+	q       byte // literal state after the line
+	dots    []int
+	comment int   // byte offset where a `"` comment starts, -1 when there is none
+	spaces  []int // first byte of every whitespace run outside literals
+}
+
+// walk scans one line body from the literal state it starts in.
+func walk(text string, q byte) lineScan {
+	var r = lineScan{q, []int{}, -1, []int{}}
+	var i = 0
+	for i < len(text) {
+		var c = text[i]
+		if r.q != 0 {
+			if r.q == '|' && c == '\\' {
+				i += 2 // a template backslash escapes the next character
+				continue
+			}
+			if c == r.q {
+				if r.q != '|' && i+1 < len(text) && text[i+1] == r.q {
+					i += 2 // a doubled delimiter is an escaped one
+					continue
+				}
+				r.q = 0
+				i++
+				continue
+			}
+			i++
+			continue
+		}
+		if c == '`' || c == '\'' || c == '|' {
+			r.q = c
+			i++
+			continue
+		}
+		if c == '"' {
+			r.comment = i // the rest of the line is comment text
+			break
+		}
+		if c == '.' {
+			r.dots = append(r.dots, i)
+			i++
+			continue
+		}
+		if c == ' ' || c == '\t' {
+			if i > 0 && (text[i-1] == ' ' || text[i-1] == '\t') {
+				i++
+				continue
+			}
+			r.spaces = append(r.spaces, i)
+			i++
+			continue
+		}
+		i++
+	}
+	return r
+}
+
+// statement records the block effect of the statement starting at col.
+func statement(text string, col, line, comment int) stmt {
+	var s = stmt{line, sNeutral, 0, 0, 0, false, -1, false}
+	var first, after = token(text, col)
+	var second, _ = token(text, skipSpace(text, after))
+	var b = keyword[first]
+	if first == "CLASS" && (hasWord(text, col, comment, "DEFINITION") || hasWord(text, col, comment, "IMPLEMENTATION")) {
+		b = keyword["CLASS"] // a class definition or implementation opens a block
+	}
+	if first == "SELECTION-SCREEN" {
+		if second == "BEGIN" {
+			b = block{sOpen, kScreen, 1, 0, false}
+		} else if second == "END" {
+			b = block{sClose, kScreen, 0, 0, false}
+		}
+	}
+	if second == "SECTION" {
+		b = block{sBranch, 0, 0, bSection, false} // PUBLIC / PROTECTED / PRIVATE
+	}
+	s.role = b.role
+	s.kind = b.kind
+	s.level = b.level
+	s.branch = b.branch
+	s.reset = b.reset
+	if b.branch == bEvent {
+		s.owner = -2 // report events belong to the file, not to an open block
+	}
+	return s
+}
+
+// hasWord reports whether one whole word of the statement matches.
+func hasWord(text string, from int, comment int, word string) bool {
+	var i = from
+	for i < len(text) && (comment < 0 || i < comment) {
+		var w, j = token(text, i)
+		if w == word {
+			return true
+		}
+		i = j
+		if j == i {
+			i++
+		}
+	}
+	return false
+}
+
+// token reads one word: letters, digits and ABAP's word punctuation.
+func token(text string, i int) (string, int) {
+	var j = i
+	for j < len(text) {
+		var c = text[j]
+		if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_' || c == '-' || c == '#' || c == '&' {
+			j++
+			continue
+		}
+		break
+	}
+	return strings.ToUpper(text[i:j]), j
+}
+
+// skipSpace advances past blanks.
+func skipSpace(text string, i int) int {
+	for i < len(text) && (text[i] == ' ' || text[i] == '\t') {
+		i++
+	}
+	return i
+}
+
+func addAll(a, b []int) []int {
+	for _, x := range b {
+		a = append(a, x)
+	}
+	return a
+}
+
+// innerCuts lists the offsets strictly inside one statement where a wrapped
+// line may break: never right before a period, which would strand it, and
+// never past the statement's last word.
+func innerCuts(text string, scan lineScan, from, to int) []int {
+	var out []int
+	for _, s := range scan.spaces {
+		if s <= from || s >= to {
+			continue
+		}
+		var next = skipSpace(text, s)
+		if next >= to || (next < len(text) && text[next] == '.') {
+			continue
+		}
+		out = append(out, s)
+	}
+	return out
+}
+
+// pair marks the structural statements whose block it cannot find. A forward
+// class declaration carries DEFINITION but no ENDCLASS, so treating it as a
+// block would indent everything after it.
+func pair(stmts []stmt) {
+	var open []int
+	for i := 0; i < len(stmts); i++ {
+		if stmts[i].role == sOpen {
+			open = append(open, i)
+			continue
+		}
+		if stmts[i].role == sClose {
+			var j = -1
+			for k := len(open) - 1; k >= 0; k-- {
+				if stmts[open[k]].kind == stmts[i].kind {
+					j = k
+					break
+				}
+			}
+			if j < 0 {
+				stmts[i].dead = true
+				continue
+			}
+			for k := j + 1; k < len(open); k++ {
+				stmts[open[k]].dead = true // blocks left unclosed inside it
+			}
+			open = open[:j]
+			continue
+		}
+		if stmts[i].role == sBranch && stmts[i].owner != -2 {
+			if len(open) > 0 {
+				stmts[i].owner = open[len(open)-1]
+			} else {
+				stmts[i].owner = -1
+			}
+		}
+	}
+	for _, i := range open {
+		stmts[i].dead = true
+	}
+	for i := 0; i < len(stmts); i++ {
+		if stmts[i].role != sBranch || stmts[i].owner == -2 {
+			continue
+		}
+		if stmts[i].owner < 0 || stmts[stmts[i].owner].dead {
+			stmts[i].dead = true
+		}
+	}
+}
+
+// frame is one open block: where its opener sits and where its body sits.
+type frame struct {
+	kind int
+	base int
+	cur  int
+}
+
+// ctx walks the open blocks while indentation is assigned.
+type ctx struct {
+	f []frame
+}
+
+func (c *ctx) cur() int { return c.f[len(c.f)-1].cur }
+
+// find locates the innermost open block of a kind.
+func (c *ctx) find(kind int) int {
+	for i := len(c.f) - 1; i >= 0; i-- {
+		if c.f[i].kind == kind {
+			return i
+		}
+	}
+	return -1
+}
+
+// apply reports the indentation a statement gets and moves the block context
+// along: an opener pushes its block, a closer returns to its opener and a
+// branch realigns the body that follows it.
+func (c *ctx) apply(s stmt) int {
+	if s.reset {
+		c.f[0].cur = 0 // a file-level statement ends an open report event
+	}
+	if s.dead {
+		return c.cur()
+	}
+	if s.role == sOpen {
+		var base = c.cur()
+		c.f = append(c.f, frame{s.kind, base, base + s.level})
+		return base
+	}
+	if s.role == sClose {
+		var j = c.find(s.kind)
+		if j < 0 {
+			return c.cur()
+		}
+		var base = c.f[j].base
+		c.f = c.f[:j]
+		return base
+	}
+	if s.role == sBranch {
+		switch s.branch {
+		case bIf:
+			var j = c.find(kIf)
+			if j >= 0 {
+				c.f[j].cur = c.f[j].base + 1
+				return c.f[j].base
+			}
+		case bWhen:
+			var j = c.find(kCase)
+			if j >= 0 {
+				c.f[j].cur = c.f[j].base + 2
+				return c.f[j].base + 1
+			}
+		case bCatch:
+			var j = c.find(kTry)
+			if j >= 0 {
+				c.f[j].cur = c.f[j].base + 2
+				return c.f[j].base + 1
+			}
+		case bSection:
+			var j = c.find(kClass)
+			if c.find(kInterface) > j {
+				j = c.find(kInterface)
+			}
+			if j >= 0 {
+				c.f[j].cur = c.f[j].base + 2
+				return c.f[j].base + 1
+			}
+		case bEvent:
+			c.f[0].cur = 1
+			return 0
+		}
+	}
+	return c.cur()
+}
+
+// layout gives every line its indentation level, two spaces per block: the
+// level its first statement sits at, or the level of the statement it continues.
+func layout(lines []lInfo, stmts []stmt) []int {
+	pair(stmts)
+	var c = ctx{[]frame{frame{kRoot, 0, 0}}}
+	var ind []int
+	var si = 0
+	for i := 0; i < len(lines); i++ {
+		var carried = i > 0 && lines[i-1].open
+		var level = c.cur()
+		if lines[i].kind == 'c' {
+			level = 0 // a full-line comment owns its line at column zero
+		}
+		if carried {
+			level = ind[i-1]
+		}
+		var first = true
+		for ; si < len(stmts) && stmts[si].line == i; si++ {
+			if !carried && first {
+				level = c.apply(stmts[si])
+			} else {
+				c.apply(stmts[si])
+			}
+			first = false
+		}
+		ind = append(ind, level)
+	}
+	return ind
+}
+
+// render writes the lines back at their assigned indentation. Full-line
+// comments and lines that continue a literal across the break keep their own
+// text.
+func render(lines []lInfo, ind []int) string {
+	var out strings.Builder
+	for i := 0; i < len(lines); i++ {
+		if lines[i].kind == 'n' && ind[i] > 0 {
+			out.WriteString(strings.Repeat("  ", ind[i]))
+		}
+		out.WriteString(lines[i].text)
+		out.WriteByte('\n')
+	}
+	return out.String()
+}
+
+// wrapLines breaks every source line that exceeds the limit at a space inside
+// one of its statements. The continuation keeps the statement's indentation,
+// which is what makes re-running the wrap do nothing.
+func wrapLines(lines []lInfo, ind []int) (string, error) {
+	var out strings.Builder
+	for i := 0; i < len(lines); i++ {
+		if lines[i].kind != 'n' {
+			if len(lines[i].text) > maxLineBytes {
+				return "", fmt.Errorf("unbreakable comment or literal line (%d bytes)", len(lines[i].text))
+			}
+			out.WriteString(lines[i].text)
+			out.WriteByte('\n')
+			continue
+		}
+		var prefix = strings.Repeat("  ", ind[i])
+		var start = 0
+		for {
+			var rest = strings.TrimLeft(lines[i].text[start:], " \t")
+			if len(prefix)+len(rest) <= maxLineBytes {
+				out.WriteString(prefix)
+				out.WriteString(strings.TrimRight(rest, " \t"))
+				out.WriteByte('\n')
+				break
+			}
+			var best = -1
+			for _, c := range lines[i].cuts {
+				if c <= start || c >= len(lines[i].text) {
+					continue
+				}
+				if skipSpace(lines[i].text, c) >= len(lines[i].text) {
+					continue // nothing would be left for the continuation
+				}
+				var head = strings.TrimRight(lines[i].text[start:c], " \t")
+				if head == "" || len(prefix)+len(head) > maxLineBytes {
+					continue
+				}
+				best = c
+			}
+			if best < 0 {
+				return "", fmt.Errorf("unbreakable source line (%d bytes)", len(prefix)+len(rest))
+			}
+			out.WriteString(prefix)
+			out.WriteString(strings.TrimRight(lines[i].text[start:best], " \t"))
+			out.WriteByte('\n')
+			start = skipSpace(lines[i].text, best)
+		}
+	}
+	return out.String(), nil
+}
