+package abap
+
+import (
+	"strings"
+	"testing"
+)
+
+// check compares the re-indented source with the expected text and re-runs
+// both operations, which must then change nothing.
+func check(t *testing.T, name, src, want string) {
+	var got = indent(src)
+	if got != want {
+		t.Fatalf("%s: indent\n--- got\n%s--- want\n%s", name, got, want)
+	}
+	if indent(got) != got {
+		t.Fatalf("%s: indent is not idempotent", name)
+	}
+	var wrapped, err = Format(src)
+	if err != nil {
+		t.Fatalf("%s: Format: %v", name, err)
+	}
+	if wrapped != want {
+		t.Fatalf("%s: Format\n--- got\n%s--- want\n%s", name, wrapped, want)
+	}
+	var again, err2 = Format(wrapped)
+	if err2 != nil || again != wrapped {
+		t.Fatalf("%s: Format is not idempotent: %v", name, err2)
+	}
+}
+
+// A class definition indents its sections one level and their declarations
+// two; the implementation gives methods the same two-space step, and every
+// class header and ENDCLASS starts at column zero.
+func TestClassShape(t *testing.T) {
+	var src = "CLASS zcl_a DEFINITION PUBLIC FINAL CREATE PUBLIC.\n" +
+		"PUBLIC SECTION.\n" +
+		"DATA iv_n TYPE i.\n" +
+		"METHODS run IMPORTING p TYPE i RETURNING VALUE(rv) TYPE i.\n" +
+		"PROTECTED SECTION.\n" +
+		"PRIVATE SECTION.\n" +
+		"ENDCLASS.\n" +
+		"CLASS zcl_a IMPLEMENTATION.\n" +
+		"METHOD run.\n" +
+		"DATA l TYPE i.\n" +
+		"rv = l + p.\n" +
+		"ENDMETHOD.\n" +
+		"ENDCLASS.\n"
+	var want = "CLASS zcl_a DEFINITION PUBLIC FINAL CREATE PUBLIC.\n" +
+		"  PUBLIC SECTION.\n" +
+		"    DATA iv_n TYPE i.\n" +
+		"    METHODS run IMPORTING p TYPE i RETURNING VALUE(rv) TYPE i.\n" +
+		"  PROTECTED SECTION.\n" +
+		"  PRIVATE SECTION.\n" +
+		"ENDCLASS.\n" +
+		"CLASS zcl_a IMPLEMENTATION.\n" +
+		"  METHOD run.\n" +
+		"    DATA l TYPE i.\n" +
+		"    rv = l + p.\n" +
+		"  ENDMETHOD.\n" +
+		"ENDCLASS.\n"
+	check(t, "class", src, want)
+}
+
+// Interfaces and forms open ordinary blocks: the body sits two spaces in and
+// the closing statement aligns with its opener.
+func TestInterfaceAndForm(t *testing.T) {
+	var src = "INTERFACE zif_a PUBLIC.\nMETHODS read RETURNING VALUE(rv) TYPE i.\nENDINTERFACE.\n" +
+		"FORM f1 USING iv_a TYPE i CHANGING rv TYPE i.\nrv = iv_a.\nENDFORM.\n" +
+		"FORM f2.\nrv = 2.\nENDFORM.\n"
+	var want = "INTERFACE zif_a PUBLIC.\n  METHODS read RETURNING VALUE(rv) TYPE i.\nENDINTERFACE.\n" +
+		"FORM f1 USING iv_a TYPE i CHANGING rv TYPE i.\n  rv = iv_a.\nENDFORM.\n" +
+		"FORM f2.\n  rv = 2.\nENDFORM.\n"
+	check(t, "interface and form", src, want)
+}
+
+// Control flow nests two spaces per level; alternative branches align with
+// the branch they follow.
+func TestControlFlow(t *testing.T) {
+	var src = "METHOD m.\n" +
+		"IF a = 1.\nx = 1.\nELSEIF a = 2.\nx = 2.\nELSE.\nx = 3.\nENDIF.\n" +
+		"WHILE i < n.\ni = i + 1.\nENDWHILE.\n" +
+		"DO 3.\ni = i + 1.\nENDDO.\n" +
+		"LOOP AT items INTO item.\nWRITE item.\nENDLOOP.\n" +
+		"ENDMETHOD.\n"
+	var want = "METHOD m.\n" +
+		"  IF a = 1.\n    x = 1.\n  ELSEIF a = 2.\n    x = 2.\n  ELSE.\n    x = 3.\n  ENDIF.\n" +
+		"  WHILE i < n.\n    i = i + 1.\n  ENDWHILE.\n" +
+		"  DO 3.\n    i = i + 1.\n  ENDDO.\n" +
+		"  LOOP AT items INTO item.\n    WRITE item.\n  ENDLOOP.\n" +
+		"ENDMETHOD.\n"
+	check(t, "control flow", src, want)
+}
+
+// WHEN clauses sit two spaces inside CASE and their bodies two further in.
+func TestCase(t *testing.T) {
+	var src = "CASE c.\nWHEN 1.\nx = 1.\nWHEN OTHERS.\nx = 0.\nENDCASE.\n"
+	var want = "CASE c.\n  WHEN 1.\n    x = 1.\n  WHEN OTHERS.\n    x = 0.\nENDCASE.\n"
+	check(t, "case", src, want)
+}
+
+// A TRY body sits four spaces inside TRY; CATCH and CLEANUP sit two in,
+// their own bodies two further, and ENDTRY aligns with TRY.
+func TestTry(t *testing.T) {
+	var src = "TRY.\nx = 1.\nCATCH lx.\ny = 2.\nCLEANUP.\nz = 3.\nENDTRY.\n"
+	var want = "TRY.\n    x = 1.\n  CATCH lx.\n    y = 2.\n  CLEANUP.\n    z = 3.\nENDTRY.\n"
+	check(t, "try", src, want)
+}
+
+// Report event headers start at column zero and own two-space bodies; the
+// next event or a following form returns to column zero. A runtime GET
+// statement is an ordinary statement, not an event header.
+func TestReportEvents(t *testing.T) {
+	var src = "REPORT zprog LINE-SIZE 1023.\n" +
+		"DATA lv_rc TYPE i.\n" +
+		"INITIALIZATION.\nsc_title = 'x'.\n" +
+		"AT SELECTION-SCREEN ON VALUE-REQUEST FOR p_file.\nGET RUN TIME FIELD lv_t.\n" +
+		"START-OF-SELECTION.\nWRITE: / lv_rc.\n" +
+		"FORM f1.\nrv = 1.\nENDFORM.\n"
+	var want = "REPORT zprog LINE-SIZE 1023.\n" +
+		"DATA lv_rc TYPE i.\n" +
+		"INITIALIZATION.\n  sc_title = 'x'.\n" +
+		"AT SELECTION-SCREEN ON VALUE-REQUEST FOR p_file.\n  GET RUN TIME FIELD lv_t.\n" +
+		"START-OF-SELECTION.\n  WRITE: / lv_rc.\n" +
+		"FORM f1.\n  rv = 1.\nENDFORM.\n"
+	check(t, "report events", src, want)
+	// A selection screen block nests inside the event body that holds it.
+	var screen = "REPORT zprog LINE-SIZE 1023.\nSTART-OF-SELECTION.\nSELECTION-SCREEN BEGIN BLOCK header WITH LINE.\nWRITE: / 'x'.\nSELECTION-SCREEN END BLOCK header.\nEND-OF-SELECTION.\nWRITE: / 'y'.\n"
+	var screenWant = "REPORT zprog LINE-SIZE 1023.\nSTART-OF-SELECTION.\n  SELECTION-SCREEN BEGIN BLOCK header WITH LINE.\n    WRITE: / 'x'.\n  SELECTION-SCREEN END BLOCK header.\nEND-OF-SELECTION.\n  WRITE: / 'y'.\n"
+	check(t, "selection screen in a report", screen, screenWant)
+}
+
+// A forward class declaration has no ENDCLASS, so it opens nothing: the
+// statements after it keep their own indentation.
+func TestForwardDeclaration(t *testing.T) {
+	var src = "CLASS zcl_missing DEFINITION CREATE PUBLIC.\n" +
+		"CLASS zcl_a DEFINITION PUBLIC CREATE PUBLIC.\n" +
+		"PUBLIC SECTION.\nDATA iv_n TYPE i.\nPRIVATE SECTION.\nENDCLASS.\n" +
+		"CLASS zcl_a IMPLEMENTATION.\nENDCLASS.\n"
+	var want = "CLASS zcl_missing DEFINITION CREATE PUBLIC.\n" +
+		"CLASS zcl_a DEFINITION PUBLIC CREATE PUBLIC.\n" +
+		"  PUBLIC SECTION.\n    DATA iv_n TYPE i.\n  PRIVATE SECTION.\nENDCLASS.\n" +
+		"CLASS zcl_a IMPLEMENTATION.\nENDCLASS.\n"
+	check(t, "forward declaration", src, want)
+}
+
+// Keywords, periods, comment markers and delimiters inside literals, string
+// templates and comments carry no structure. A full-line * comment stays at
+// column zero; a trailing comment keeps its line.
+func TestLiteralsAndComments(t *testing.T) {
+	var src = "IF a = `ENDIF `.\nx = '| CASE TRY |'.\ny = |{ a } IF { b }|.\nw = |a\\|b ENDIF|.\nz = 'it''s a TRY. ENDIF'.\nENDIF.\n" +
+		"* TS: src/a.ts A\n" +
+		"x = 1. \" after a period CASE IF\n"
+	var want = "IF a = `ENDIF `.\n  x = '| CASE TRY |'.\n  y = |{ a } IF { b }|.\n  w = |a\\|b ENDIF|.\n  z = 'it''s a TRY. ENDIF'.\nENDIF.\n" +
+		"* TS: src/a.ts A\n" +
+		"x = 1. \" after a period CASE IF\n"
+	check(t, "literals and comments", src, want)
+}
+
+// Several statements may share a line; they stay together and the block they
+// open or close still moves the lines that follow.
+func TestStatementsOnOneLine(t *testing.T) {
+	var src = "IF a = 1. x = 1. ENDIF.\ny = 2.\n"
+	var want = "IF a = 1. x = 1. ENDIF.\ny = 2.\n"
+	check(t, "one line", src, want)
+	// An opener that leaves its block open moves the lines that follow it.
+	var open = "IF a. x = 1.\ny = 2.\nENDIF.\n"
+	var openWant = "IF a. x = 1.\n  y = 2.\nENDIF.\n"
+	check(t, "one line, block left open", open, openWant)
+}
+
+// A statement that already spans lines keeps one indentation on every part,
+// and a line that was wrapped stays where its statement is.
+func TestMultilineStatement(t *testing.T) {
+	var src = "DATA: lv_a TYPE i,\n      lv_b TYPE i.\nIF a.\nx = 1.\nENDIF.\n"
+	var want = "DATA: lv_a TYPE i,\nlv_b TYPE i.\nIF a.\n  x = 1.\nENDIF.\n"
+	check(t, "multiline statement", src, want)
+	// Inside a method the whole statement, every physical line of it, sits at
+	// the method body's indentation.
+	var deep = "METHOD m.\nDATA: lv_a TYPE i,\n        lv_b TYPE i,\nlv_c TYPE i.\nENDMETHOD.\n"
+	var deepWant = "METHOD m.\n  DATA: lv_a TYPE i,\n  lv_b TYPE i,\n  lv_c TYPE i.\nENDMETHOD.\n"
+	check(t, "multiline statement in a method", deep, deepWant)
+}
+
+// Wrapping breaks a long statement at a space, never inside a literal, and
+// the continuation keeps the statement's indentation; the byte limit counts
+// the leading spaces.
+func TestWrap(t *testing.T) {
+	var src = "CLASS zcl_a DEFINITION PUBLIC CREATE PUBLIC.\nPUBLIC SECTION.\n" +
+		"METHODS run IMPORTING " + strings.Join(words(70), " ") + " RETURNING VALUE(rv) TYPE i.\n" +
+		"PRIVATE SECTION.\nENDCLASS.\n"
+	var files, err = Format(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, line := range strings.Split(files, "\n") {
+		if len(line) > 255 {
+			t.Fatalf("line of %d bytes: %s", len(line), line)
+		}
+	}
+	// Some parameter chunks moved to their own line; each one keeps the
+	// indentation of the declaration, which sits two spaces in.
+	var seen = 0
+	for _, line := range strings.Split(files, "\n") {
+		if !strings.HasPrefix(strings.TrimLeft(line, " "), "p_") {
+			continue
+		}
+		if !strings.HasPrefix(line, "    p_") || strings.HasPrefix(line, "     ") {
+			t.Fatalf("continuation %q is not at the statement's indentation", line)
+		}
+		seen = seen + 1
+	}
+	if seen == 0 {
+		t.Fatalf("nothing was wrapped:\n%s", files)
+	}
+	for _, line := range strings.Split(indent(files), "\n") {
+		if len(line) > 255 {
+			t.Fatalf("indent grew a long line: %s", line)
+		}
+	}
+	var again, err2 = Format(files)
+	if err2 != nil || again != files {
+		t.Fatalf("Format is not idempotent: %v", err2)
+	}
+}
+
+// words builds a parameter list long enough to need wrapping.
+func words(n int) []string {
+	var out []string
+	for i := 0; i < n; i++ {
+		out = append(out, "p_"+pad(i)+" TYPE i")
+	}
+	return out
+}
+
+// pad renders a two digit index without pulling in a formatting dependency.
+func pad(i int) string {
+	var digits = "0123456789"
+	if i < 10 {
+		return "0" + digits[i:i+1]
+	}
+	return digits[i/10:i/10+1] + digits[i%10:i%10+1]
+}
