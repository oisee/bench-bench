diff --git a/hir/abap/format.go b/hir/abap/format.go
new file mode 100644
index 0000000..12ca66d
--- /dev/null
+++ b/hir/abap/format.go
@@ -0,0 +1,357 @@
+package abap
+
+import (
+	"fmt"
+	"strings"
+)
+
+type indentBlock struct {
+	kind string
+	base int
+}
+
+// indent applies the package's fixed ABAP indentation style.
+func indent(src string) string {
+	lines := strings.Split(src, "\n")
+	if src == "" {
+		return ""
+	}
+	if strings.HasSuffix(src, "\n") {
+		lines = lines[:len(lines)-1]
+	}
+	depth := 0
+	mode := ""
+	method := false
+	caseBases := []int{}
+	blocks := []indentBlock{}
+	inSingle, inBacktick, inTemplate := false, false, false
+	var statement strings.Builder
+	var out strings.Builder
+	for _, raw := range lines {
+		line := strings.TrimLeft(raw, " \t")
+		if line == "" {
+			out.WriteString("\n")
+			continue
+		}
+		if strings.HasPrefix(line, "*") && !inSingle && !inBacktick && !inTemplate {
+			out.WriteString(line + "\n")
+			continue
+		}
+		indentLevel := depth
+		if statement.Len() == 0 {
+			first := firstWord(line)
+			if closeStatement(first) {
+				indentLevel = closeDepth(first, depth, mode, method)
+			}
+			if first == "ENDCASE" && len(caseBases) != 0 {
+				indentLevel = caseBases[len(caseBases)-1]
+			}
+			if base, ok := blockBase(blocks, first); ok {
+				indentLevel = base
+			}
+			if first == "WHEN" && len(caseBases) != 0 {
+				indentLevel = caseBases[len(caseBases)-1] + 2
+			}
+			if mode == "definition" || mode == "interface" {
+				switch first {
+				case "ENDCLASS", "ENDINTERFACE":
+					indentLevel = 0
+				case "PUBLIC", "PROTECTED", "PRIVATE":
+					indentLevel = 2
+				default:
+					indentLevel = 4
+				}
+				if mode == "interface" && first != "ENDINTERFACE" {
+					indentLevel = 2
+				}
+			}
+			if mode == "implementation" && first == "METHOD" {
+				indentLevel = 2
+			}
+			if mode == "implementation" && method && first == "ENDMETHOD" {
+				indentLevel = 2
+			}
+			if first == "CLASS" || first == "INTERFACE" || first == "FORM" || reportEvent(line) {
+				indentLevel = 0
+			}
+		}
+		if indentLevel < 0 {
+			indentLevel = 0
+		}
+		out.WriteString(strings.Repeat(" ", indentLevel) + line + "\n")
+		// Scan statements without changing source text. A statement can span lines,
+		// and several statements on a physical line update the following line.
+		inComment := false
+		for i := 0; i < len(line); i++ {
+			c := line[i]
+			if inComment {
+				break
+			}
+			if inSingle {
+				if c == '\'' {
+					if i+1 < len(line) && line[i+1] == '\'' {
+						i++
+					} else {
+						inSingle = false
+					}
+				}
+				statement.WriteByte(c)
+				continue
+			}
+			if inBacktick {
+				if c == '`' {
+					if i+1 < len(line) && line[i+1] == '`' {
+						i++
+					} else {
+						inBacktick = false
+					}
+				}
+				statement.WriteByte(c)
+				continue
+			}
+			if inTemplate {
+				if c == '\\' {
+					statement.WriteByte(c)
+					if i+1 < len(line) {
+						i++
+						statement.WriteByte(line[i])
+					}
+					continue
+				}
+				if c == '|' {
+					inTemplate = false
+				}
+				statement.WriteByte(c)
+				continue
+			}
+			switch c {
+			case '\'':
+				inSingle = true
+				statement.WriteByte(c)
+			case '`':
+				inBacktick = true
+				statement.WriteByte(c)
+			case '|':
+				inTemplate = true
+				statement.WriteByte(c)
+			case '"':
+				inComment = true
+			case '.':
+				statement.WriteByte(c)
+				depth, mode, method = advance(statement.String(), depth, mode, method, &caseBases, &blocks)
+				statement.Reset()
+			default:
+				if statement.Len() != 0 || c != ' ' && c != '\t' {
+					statement.WriteByte(c)
+				}
+			}
+		}
+	}
+	return out.String()
+}
+
+// Format applies indentation and wraps generated source to ABAP's 255-byte limit.
+func Format(src string) (string, error) {
+	return wrap(indent(src))
+}
+
+func firstWord(s string) string {
+	s = strings.TrimSpace(s)
+	i := strings.IndexAny(s, " \t.:,(")
+	if i >= 0 {
+		s = s[:i]
+	}
+	return strings.ToUpper(s)
+}
+
+func closeStatement(w string) bool {
+	return strings.HasPrefix(w, "END") || w == "ELSE" || w == "ELSEIF" || w == "WHEN" || w == "CATCH" || w == "CLEANUP"
+}
+
+func closeDepth(w string, depth int, mode string, method bool) int {
+	switch w {
+	case "ENDCLASS", "ENDINTERFACE", "FORM", "START-OF-SELECTION", "END-OF-SELECTION":
+		return 0
+	case "ENDMETHOD":
+		return 2
+	case "WHEN", "CATCH", "CLEANUP":
+		return max(0, depth-2)
+	case "ENDTRY":
+		return max(0, depth-4)
+	case "ELSE", "ELSEIF":
+		return max(0, depth-2)
+	default:
+		return max(0, depth-2)
+	}
+}
+
+func reportEvent(src string) bool {
+	w := firstWord(src)
+	switch w {
+	case "START-OF-SELECTION", "END-OF-SELECTION", "INITIALIZATION", "TOP-OF-PAGE", "END-OF-PAGE", "LOAD-OF-PROGRAM", "AT":
+		if w != "AT" {
+			return true
+		}
+		u := strings.ToUpper(strings.TrimSpace(src))
+		return strings.HasPrefix(u, "AT SELECTION-SCREEN") || strings.HasPrefix(u, "AT LINE-SELECTION") || strings.HasPrefix(u, "AT USER-COMMAND") || strings.HasPrefix(u, "AT PF") || strings.HasPrefix(u, "AT HELP-REQUEST")
+	}
+	return false
+}
+
+func advance(src string, depth int, mode string, method bool, caseBases *[]int, blocks *[]indentBlock) (int, string, bool) {
+	w := firstWord(src)
+	u := strings.ToUpper(strings.TrimSpace(src))
+	if strings.HasPrefix(u, "CLASS ") && strings.Contains(u, " DEFINITION") && !strings.Contains(u, " DEFERRED") {
+		return 2, "definition", false
+	}
+	if strings.HasPrefix(u, "CLASS ") && strings.Contains(u, " IMPLEMENTATION") {
+		return 2, "implementation", false
+	}
+	if strings.HasPrefix(u, "INTERFACE ") {
+		return 2, "interface", false
+	}
+	if w == "ENDCLASS" {
+		return 0, "", false
+	}
+	if w == "ENDINTERFACE" {
+		return 0, "", false
+	}
+	if mode == "definition" || mode == "interface" {
+		if w == "PUBLIC" || w == "PROTECTED" || w == "PRIVATE" {
+			return 4, mode, false
+		}
+		return depth, mode, method
+	}
+	if mode == "implementation" {
+		if w == "METHOD" {
+			return 4, mode, true
+		}
+		if w == "ENDMETHOD" {
+			return 2, mode, false
+		}
+	}
+	if strings.HasPrefix(u, "CLASS ") && strings.Contains(u, " DEFERRED") {
+		return depth, mode, method
+	}
+	if w == "FORM" || reportEvent(src) {
+		return 2, mode, false
+	}
+	if w == "ENDMETHOD" || w == "ENDFORM" || w == "END-OF-SELECTION" {
+		return 0, mode, false
+	}
+	switch w {
+	case "ENDIF", "ENDLOOP", "ENDWHILE", "ENDDO", "ENDSELECT", "ENDAT", "ENDON", "ENDWITH":
+		if base, ok := popBlock(blocks, w); ok {
+			depth = base
+		} else {
+			depth = max(0, depth-2)
+		}
+	case "ENDCASE":
+		if len(*caseBases) != 0 {
+			depth = (*caseBases)[len(*caseBases)-1]
+			*caseBases = (*caseBases)[:len(*caseBases)-1]
+		} else {
+			depth = max(0, depth-2)
+		}
+	case "ELSE", "ELSEIF", "CATCH", "CLEANUP":
+		if base, ok := branchBase(*blocks, w); ok {
+			depth = base + 2
+			if w == "CATCH" || w == "CLEANUP" {
+				depth = base + 4
+			}
+		}
+	case "WHEN":
+		if len(*caseBases) != 0 {
+			depth = (*caseBases)[len(*caseBases)-1] + 4
+		} else {
+			depth += 2
+		}
+	}
+	switch w {
+	case "IF", "LOOP", "WHILE", "DO", "SELECT", "AT", "ON":
+		kind := map[string]string{"IF": "ENDIF", "LOOP": "ENDLOOP", "WHILE": "ENDWHILE", "DO": "ENDDO", "SELECT": "ENDSELECT", "AT": "ENDAT", "ON": "ENDON"}[w]
+		*blocks = append(*blocks, indentBlock{kind: kind, base: depth})
+		depth += 2
+	case "CASE":
+		*caseBases = append(*caseBases, depth)
+		depth += 2
+	case "TRY":
+		*blocks = append(*blocks, indentBlock{kind: "ENDTRY", base: depth})
+		depth += 4
+	case "ENDTRY":
+		if base, ok := popBlock(blocks, w); ok {
+			depth = base
+		} else {
+			depth = max(0, depth-4)
+		}
+	}
+	return depth, mode, method
+}
+
+func blockBase(blocks []indentBlock, closer string) (int, bool) {
+	for i := len(blocks) - 1; i >= 0; i-- {
+		if blocks[i].kind == closer {
+			return blocks[i].base, true
+		}
+	}
+	return 0, false
+}
+func popBlock(blocks *[]indentBlock, closer string) (int, bool) {
+	for i := len(*blocks) - 1; i >= 0; i-- {
+		if (*blocks)[i].kind == closer {
+			base := (*blocks)[i].base
+			*blocks = (*blocks)[:i]
+			return base, true
+		}
+	}
+	return 0, false
+}
+func branchBase(blocks []indentBlock, branch string) (int, bool) {
+	want := "ENDIF"
+	if branch == "CATCH" || branch == "CLEANUP" {
+		want = "ENDTRY"
+	}
+	return blockBase(blocks, want)
+}
+
+// wrap only splits outside literal tokens and keeps each continuation's indent.
+func wrap(src string) (string, error) {
+	if src == "" {
+		return "", nil
+	}
+	var out strings.Builder
+	for _, line := range strings.Split(strings.TrimSuffix(src, "\n"), "\n") {
+		prefix := line[:len(line)-len(strings.TrimLeft(line, " "))]
+		for len(line) > 255 {
+			quote, cut := byte(0), -1
+			for i := 0; i < len(line) && i <= 255; i++ {
+				c := line[i]
+				if quote != 0 {
+					if quote == '|' && c == '\\' {
+						i++
+					} else if c == quote {
+						if quote != '|' && i+1 < len(line) && line[i+1] == quote {
+							i++
+						} else {
+							quote = 0
+						}
+					}
+				} else if c == '`' || c == '\'' || c == '|' {
+					quote = c
+				} else if c == ' ' {
+					cut = i
+				}
+			}
+			if cut <= len(prefix) {
+				return "", fmt.Errorf("unbreakable source line (%d bytes)", len(line))
+			}
+			out.WriteString(line[:cut] + "\n")
+			line = prefix + strings.TrimLeft(line[cut:], " ")
+		}
+		out.WriteString(line + "\n")
+	}
+	if !strings.HasSuffix(src, "\n") {
+		return strings.TrimSuffix(out.String(), "\n"), nil
+	}
+	return out.String(), nil
+}
