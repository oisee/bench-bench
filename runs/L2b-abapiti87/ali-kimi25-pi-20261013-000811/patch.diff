diff --git a/hir/abap/indent.go b/hir/abap/indent.go
new file mode 100644
index 0000000..f0780de
--- /dev/null
+++ b/hir/abap/indent.go
@@ -0,0 +1,444 @@
+package abap
+
+import (
+	"fmt"
+	"strings"
+)
+
+// Format applies indentation and line wrapping to ABAP source code.
+// It returns the formatted code or an error if a line cannot be wrapped.
+func Format(src string) (string, error) {
+	indented := indent(src)
+	return wrap(indented)
+}
+
+// indent applies consistent indentation to ABAP source code.
+// Uses two spaces per block level following abaplint's default style.
+func indent(src string) string {
+	lines := strings.Split(strings.TrimSuffix(src, "\n"), "\n")
+	
+	var result strings.Builder
+	
+	// Stack of indentation levels. Each entry is the indent level for that block.
+	// For control structures (if, while, etc.), the entry is the STATEMENT indent,
+	// and statements inside add 2.
+	indentStack := []int{0}
+	
+	// Track block types for proper nesting
+	blockTypes := []string{"root"}
+	
+	// Track context
+	inClassDef := false
+	inClassImpl := false
+	sectionLevel := 0
+	
+	for i, line := range lines {
+		if i > 0 {
+			result.WriteString("\n")
+		}
+		
+		trimmed := strings.TrimSpace(line)
+		if trimmed == "" {
+			continue
+		}
+		
+		// Full-line comments stay at column zero
+		if strings.HasPrefix(trimmed, "*") {
+			result.WriteString(trimmed)
+			continue
+		}
+		
+		upper := strings.ToUpper(trimmed)
+		
+		// Calculate indent level based on current stack
+		indentLevel := getIndent(indentStack, blockTypes)
+		
+		// Handle block ends and alternative branches
+		switch {
+		case strings.HasPrefix(upper, "ENDCLASS."):
+			inClassDef = false
+			inClassImpl = false
+			sectionLevel = 0
+			popToBlock(&indentStack, &blockTypes, "class")
+			indentLevel = getIndent(indentStack, blockTypes)
+			
+		case strings.HasPrefix(upper, "ENDINTERFACE."):
+			popToBlock(&indentStack, &blockTypes, "interface")
+			indentLevel = getIndent(indentStack, blockTypes)
+			
+		case strings.HasPrefix(upper, "ENDMETHOD."):
+			popToBlock(&indentStack, &blockTypes, "method")
+			// ENDMETHOD aligns with METHOD statement (no body offset)
+			if len(indentStack) > 0 {
+				indentLevel = indentStack[len(indentStack)-1]
+			}
+			
+		case strings.HasPrefix(upper, "ENDFORM."):
+			popToBlock(&indentStack, &blockTypes, "form")
+			indentLevel = getIndent(indentStack, blockTypes)
+			
+		case strings.HasPrefix(upper, "ENDIF."):
+			// Pop else/elseif/if
+			popBlock(&indentStack, &blockTypes, "else")
+			popBlock(&indentStack, &blockTypes, "elseif")
+			popBlock(&indentStack, &blockTypes, "if")
+			indentLevel = getIndent(indentStack, blockTypes)
+			
+		case strings.HasPrefix(upper, "ENDWHILE."):
+			popBlock(&indentStack, &blockTypes, "while")
+			indentLevel = getIndent(indentStack, blockTypes)
+			
+		case strings.HasPrefix(upper, "ENDLOOP."):
+			popBlock(&indentStack, &blockTypes, "loop")
+			indentLevel = getIndent(indentStack, blockTypes)
+			
+		case strings.HasPrefix(upper, "ENDCASE."):
+			// Pop all when blocks and case
+			for len(blockTypes) > 1 && (blockTypes[len(blockTypes)-1] == "when" || blockTypes[len(blockTypes)-1] == "case") {
+				indentStack = indentStack[:len(indentStack)-1]
+				blockTypes = blockTypes[:len(blockTypes)-1]
+			}
+			indentLevel = getIndent(indentStack, blockTypes)
+			
+		case strings.HasPrefix(upper, "ENDDO."):
+			popBlock(&indentStack, &blockTypes, "do")
+			indentLevel = getIndent(indentStack, blockTypes)
+			
+		case strings.HasPrefix(upper, "ENDTRY."):
+			// Pop cleanup/catch/try
+			popBlock(&indentStack, &blockTypes, "cleanup")
+			popBlock(&indentStack, &blockTypes, "catch")
+			popBlock(&indentStack, &blockTypes, "try")
+			indentLevel = getIndent(indentStack, blockTypes)
+			
+		case strings.HasPrefix(upper, "ELSE.") || strings.HasPrefix(upper, "ELSEIF "):
+			// Align with IF statement - use IF's statement indent
+			ifIdx := findBlock(blockTypes, "if")
+			if ifIdx >= 0 {
+				indentLevel = indentStack[ifIdx]
+			}
+			// Push for ELSE body
+			if strings.HasPrefix(upper, "ELSEIF ") {
+				indentStack = append(indentStack, indentLevel)
+				blockTypes = append(blockTypes, "elseif")
+			} else {
+				indentStack = append(indentStack, indentLevel)
+				blockTypes = append(blockTypes, "else")
+			}
+			
+		case strings.HasPrefix(upper, "WHEN ") || strings.HasPrefix(upper, "WHEN."):
+			// Align with CASE + 2
+			caseIdx := findBlock(blockTypes, "case")
+			if caseIdx >= 0 {
+				indentLevel = indentStack[caseIdx] + 2
+			}
+			// Push for WHEN body
+			indentStack = append(indentStack, indentLevel)
+			blockTypes = append(blockTypes, "when")
+			
+		case strings.HasPrefix(upper, "CATCH ") || strings.HasPrefix(upper, "CATCH."):
+			// Align with TRY + 2
+			tryIdx := findBlock(blockTypes, "try")
+			if tryIdx >= 0 {
+				indentLevel = indentStack[tryIdx] + 2
+			}
+			// Push for CATCH body
+			indentStack = append(indentStack, indentLevel)
+			blockTypes = append(blockTypes, "catch")
+			
+		case strings.HasPrefix(upper, "CLEANUP ") || strings.HasPrefix(upper, "CLEANUP."):
+			// Align with TRY + 2
+			tryIdx := findBlock(blockTypes, "try")
+			if tryIdx >= 0 {
+				indentLevel = indentStack[tryIdx] + 2
+			}
+			// Push for CLEANUP body
+			indentStack = append(indentStack, indentLevel)
+			blockTypes = append(blockTypes, "cleanup")
+			
+		default:
+			// Handle block starts
+			switch {
+			case strings.HasPrefix(upper, "CLASS ") && strings.Contains(upper, "DEFINITION"):
+				inClassDef = true
+				inClassImpl = false
+				sectionLevel = 0
+				indentLevel = 0
+				indentStack = append(indentStack, 0)
+				blockTypes = append(blockTypes, "class")
+				
+			case strings.HasPrefix(upper, "CLASS ") && strings.Contains(upper, "IMPLEMENTATION"):
+				inClassDef = true
+				inClassImpl = true
+				sectionLevel = 0
+				indentLevel = 0
+				indentStack = append(indentStack, 0)
+				blockTypes = append(blockTypes, "class")
+				
+			case strings.HasPrefix(upper, "INTERFACE ") && !strings.Contains(upper, "ENDINTERFACE"):
+				indentLevel = 0
+				indentStack = append(indentStack, 0)
+				blockTypes = append(blockTypes, "interface")
+				
+			case strings.HasPrefix(upper, "METHOD ") && !strings.HasPrefix(upper, "METHODS "):
+				// METHOD at 0, body at 2
+				indentLevel = 0
+				indentStack = append(indentStack, 0)
+				blockTypes = append(blockTypes, "method")
+				
+			case strings.HasPrefix(upper, "FORM "):
+				indentLevel = 0
+				indentStack = append(indentStack, 0)
+				blockTypes = append(blockTypes, "form")
+				
+			case (strings.HasPrefix(upper, "IF ") && hasStatementEnd(upper)) || strings.HasPrefix(upper, "IF."):
+				// IF statement at current indent
+				indentLevel = getIndent(indentStack, blockTypes)
+				// Store statement indent for ELSE/ENDIF to find
+				indentStack = append(indentStack, indentLevel)
+				blockTypes = append(blockTypes, "if")
+				
+			case strings.HasPrefix(upper, "WHILE ") && hasStatementEnd(upper):
+				indentLevel = getIndent(indentStack, blockTypes)
+				indentStack = append(indentStack, indentLevel)
+				blockTypes = append(blockTypes, "while")
+				
+			case strings.HasPrefix(upper, "DO ") && hasStatementEnd(upper):
+				indentLevel = getIndent(indentStack, blockTypes)
+				indentStack = append(indentStack, indentLevel)
+				blockTypes = append(blockTypes, "do")
+				
+			case strings.HasPrefix(upper, "LOOP "):
+				indentLevel = getIndent(indentStack, blockTypes)
+				indentStack = append(indentStack, indentLevel)
+				blockTypes = append(blockTypes, "loop")
+				
+			case strings.HasPrefix(upper, "CASE ") && hasStatementEnd(upper):
+				indentLevel = getIndent(indentStack, blockTypes)
+				indentStack = append(indentStack, indentLevel)
+				blockTypes = append(blockTypes, "case")
+				
+			case strings.HasPrefix(upper, "TRY."):
+				indentLevel = getIndent(indentStack, blockTypes)
+				// TRY body is at +4
+				indentStack = append(indentStack, indentLevel)
+				blockTypes = append(blockTypes, "try")
+				
+			case isReportEvent(upper):
+				indentLevel = 0
+				indentStack = append(indentStack, 2)
+				blockTypes = append(blockTypes, "report_event")
+			}
+		}
+		
+		// Handle class sections
+		if inClassDef && !inClassImpl {
+			if strings.HasPrefix(upper, "PUBLIC SECTION.") ||
+			   strings.HasPrefix(upper, "PROTECTED SECTION.") ||
+			   strings.HasPrefix(upper, "PRIVATE SECTION.") {
+				sectionLevel = 1
+				indentLevel = 2
+			} else if sectionLevel > 0 && !isBlockKeyword(upper) {
+				// Declarations at 4 spaces
+				indentLevel = 4
+			}
+		}
+		
+		// Handle class implementation bodies
+		if inClassImpl && !isBlockKeyword(upper) {
+			// Inside method body - use the calculated indent
+			indentLevel = getIndent(indentStack, blockTypes)
+		}
+		
+		// Write the line
+		result.WriteString(strings.Repeat(" ", indentLevel))
+		result.WriteString(trimmed)
+	}
+	
+	return result.String()
+}
+
+// getIndent returns the indent level for regular statements.
+// For control structures and method/form bodies, it adds 2 to get the body indent.
+func getIndent(stack []int, types []string) int {
+	if len(stack) == 0 {
+		return 0
+	}
+	// If top of stack is a control structure or method/form, add 2 for body
+	topType := types[len(types)-1]
+	switch topType {
+	case "if", "elseif", "else", "while", "do", "loop", "case", "when", "try", "catch", "cleanup", "method", "form":
+		return stack[len(stack)-1] + 2
+	default:
+		return stack[len(stack)-1]
+	}
+}
+
+// popBlock removes the top block of the given type.
+func popBlock(stack *[]int, types *[]string, typ string) {
+	for i := len(*types) - 1; i >= 0; i-- {
+		if (*types)[i] == typ {
+			*stack = (*stack)[:i]
+			*types = (*types)[:i]
+			return
+		}
+	}
+}
+
+// popToBlock removes blocks until the given type is found (and keeps that block).
+func popToBlock(stack *[]int, types *[]string, typ string) {
+	for i := len(*types) - 1; i >= 0; i-- {
+		if (*types)[i] == typ {
+			*stack = (*stack)[:i+1]
+			*types = (*types)[:i+1]
+			return
+		}
+	}
+}
+
+// findBlock finds the most recent block of the given type.
+func findBlock(types []string, typ string) int {
+	for i := len(types) - 1; i >= 0; i-- {
+		if types[i] == typ {
+			return i
+		}
+	}
+	return -1
+}
+
+// isBlockKeyword checks if the line starts a block or is a block-related keyword.
+func isBlockKeyword(upper string) bool {
+	return strings.HasPrefix(upper, "CLASS ") ||
+		strings.HasPrefix(upper, "ENDCLASS.") ||
+		strings.HasPrefix(upper, "INTERFACE ") ||
+		strings.HasPrefix(upper, "ENDINTERFACE.") ||
+		strings.HasPrefix(upper, "METHOD ") ||
+		strings.HasPrefix(upper, "ENDMETHOD.") ||
+		strings.HasPrefix(upper, "FORM ") ||
+		strings.HasPrefix(upper, "ENDFORM.") ||
+		strings.HasPrefix(upper, "IF ") ||
+		strings.HasPrefix(upper, "ELSE.") ||
+		strings.HasPrefix(upper, "ELSEIF ") ||
+		strings.HasPrefix(upper, "ENDIF.") ||
+		strings.HasPrefix(upper, "WHILE ") ||
+		strings.HasPrefix(upper, "ENDWHILE.") ||
+		strings.HasPrefix(upper, "DO ") ||
+		strings.HasPrefix(upper, "ENDDO.") ||
+		strings.HasPrefix(upper, "LOOP ") ||
+		strings.HasPrefix(upper, "ENDLOOP.") ||
+		strings.HasPrefix(upper, "CASE ") ||
+		strings.HasPrefix(upper, "WHEN ") ||
+		strings.HasPrefix(upper, "ENDCASE.") ||
+		strings.HasPrefix(upper, "TRY.") ||
+		strings.HasPrefix(upper, "CATCH ") ||
+		strings.HasPrefix(upper, "CLEANUP ") ||
+		strings.HasPrefix(upper, "ENDTRY.") ||
+		isReportEvent(upper)
+}
+
+// isReportEvent checks if a line is a report event header.
+func isReportEvent(upper string) bool {
+	return strings.HasPrefix(upper, "AT SELECTION-SCREEN") ||
+		strings.HasPrefix(upper, "START-OF-SELECTION") ||
+		strings.HasPrefix(upper, "INITIALIZATION") ||
+		strings.HasPrefix(upper, "END-OF-SELECTION")
+}
+
+// hasStatementEnd checks if a line has a statement-ending period outside literals.
+func hasStatementEnd(line string) bool {
+	inQuote := false
+	quoteChar := byte(0)
+	
+	for i := 0; i < len(line); i++ {
+		c := line[i]
+		
+		if inQuote {
+			if quoteChar == '|' && c == '\\' {
+				i++ // Skip escaped char
+			} else if c == quoteChar {
+				if quoteChar != '|' && i+1 < len(line) && line[i+1] == quoteChar {
+					i++ // Escaped quote in non-pipe string
+				} else {
+					inQuote = false
+					quoteChar = 0
+				}
+			}
+		} else if c == '`' || c == '\'' || c == '|' {
+			inQuote = true
+			quoteChar = c
+		} else if c == '.' {
+			return true
+		}
+	}
+	
+	return false
+}
+
+// wrap splits lines that exceed 255 bytes while preserving indentation.
+func wrap(src string) (string, error) {
+	var out strings.Builder
+	lines := strings.Split(strings.TrimSuffix(src, "\n"), "\n")
+	
+	for _, line := range lines {
+		if line == "" {
+			out.WriteString("\n")
+			continue
+		}
+		
+		// Calculate leading spaces for indentation preservation
+		indentLen := 0
+		for i := 0; i < len(line); i++ {
+			if line[i] == ' ' {
+				indentLen++
+			} else {
+				break
+			}
+		}
+		indentation := line[:indentLen]
+		
+		// Process the line, wrapping if needed
+		remaining := line
+		
+		for len(remaining) > 255 {
+			quote := byte(0)
+			cut := -1
+			
+			// Find a break point, respecting string literals
+			searchLimit := 240
+			if searchLimit > len(remaining) {
+				searchLimit = len(remaining) - 1
+			}
+			
+			for i := indentLen; i < len(remaining) && i <= searchLimit; i++ {
+				c := remaining[i]
+				
+				if quote != 0 {
+					if quote == '|' && c == '\\' {
+						i++ // Skip escaped char
+					} else if c == quote {
+						if quote != '|' && i+1 < len(remaining) && remaining[i+1] == quote {
+							i++ // Escaped quote
+						} else {
+							quote = 0
+						}
+					}
+				} else if c == '`' || c == '\'' || c == '|' {
+					quote = c
+				} else if c == ' ' {
+					cut = i
+				}
+			}
+			
+			if cut <= indentLen {
+				return "", fmt.Errorf("unbreakable source line (%d bytes)", len(remaining))
+			}
+			
+			out.WriteString(remaining[:cut] + "\n")
+			remaining = indentation + strings.TrimLeft(remaining[cut:], " ")
+		}
+		
+		out.WriteString(remaining + "\n")
+	}
+	
+	return out.String(), nil
+}
