@@ -0,0 +1,598 @@
+// Package abap provides ABAP code generation and formatting utilities.
+package abap
+
+import (
+	"strings"
+)
+
+// indentState tracks the current state for indentation
+type indentState struct {
+	blockDepth      int    // nesting depth inside method/form (for IF, WHILE, DO, LOOP - NOT CASE, TRY)
+	inClassDef      bool   // inside CLASS ... DEFINITION ... ENDCLASS
+	inClassImpl     bool   // inside CLASS ... IMPLEMENTATION ... ENDCLASS  
+	inInterface     bool   // inside INTERFACE ... ENDINTERFACE
+	inSection       bool   // inside PUBLIC/PROTECTED/PRIVATE section
+	inMethod        bool   // inside a method body
+	inForm          bool   // inside a form body
+	inReport        bool   // inside a report (REPORT ... ENDREPORT, but ABAP doesn't have ENDREPORT)
+	inReportBody    bool   // inside a report event body (after event header)
+	inCase          bool   // inside a CASE block
+	caseWhenDepth   int    // depth inside WHEN (0 = at CASE level, 1+ = inside WHEN body)
+	inTry           bool   // inside a TRY block
+	tryDepth        int    // depth for TRY blocks (0 or 1)
+	tryBodyDepth    int    // 0 = after TRY, 1 = inside TRY body (after TRY, before CATCH/CLEANUP/ENDTRY), 2+ = inside CATCH/CLEANUP body
+	selectDepth     int    // depth for SELECT blocks
+	functionDepth   int    // depth for FUNCTION blocks
+}
+
+// indent adds consistent indentation following abaplint's default style.
+func Indent(src string) string {
+	lines := strings.Split(strings.TrimSuffix(src, "\n"), "\n")
+	var out strings.Builder
+
+	st := indentState{}
+
+	for _, line := range lines {
+		trimmed := strings.TrimLeft(line, " ")
+		
+		// Check for full-line comments starting with * at column zero
+		if strings.HasPrefix(trimmed, "*") && !strings.HasPrefix(line, " ") {
+			out.WriteString(line + "\n")
+			continue
+		}
+		
+		// Calculate indent based on current state before processing this line
+		indent := calculateIndent(trimmed, st)
+		
+		// Write indented line - preserve content but add our indent
+		content := strings.TrimLeft(line, " ")
+		if indent > 0 {
+			out.WriteString(strings.Repeat(" ", indent))
+		}
+		if len(content) > 0 {
+			out.WriteString(content)
+		}
+		out.WriteString("\n")
+		
+		// Update state AFTER calculating indent for this line
+		updateState(&st, trimmed)
+	}
+
+	return out.String()
+}
+
+func isWhen(upper string) bool {
+	return strings.HasPrefix(upper, "WHEN ") || upper == "WHEN OTHERS."
+}
+
+// isReportEventHeader returns true if the line is a report event header
+func isReportEventHeader(upper string) bool {
+	events := []string{
+		"INITIALIZATION",
+		"AT SELECTION-SCREEN",
+		"START-OF-SELECTION",
+		"END-OF-SELECTION",
+		"AT LINE-SELECTION",
+		"AT USER-COMMAND",
+		"TOP-OF-PAGE",
+		"END-OF-PAGE",
+		"AT SELECTION-SCREEN ON",
+		"AT SELECTION-SCREEN OUTPUT",
+		"AT SELECTION-SCREEN ON EXIT",
+		"AT SELECTION-SCREEN ON BLOCK",
+		"AT SELECTION-SCREEN ON RADIOBUTTON",
+		"AT SELECTION-SCREEN ON VALUE-REQUEST",
+		"AT SELECTION-SCREEN ON HELP-REQUEST",
+		"LOAD-OF-PROGRAM",
+		"END-OF-PAGE",
+		"AT PF",
+		"AT SELECTION-SCREEN",
+	}
+	for _, ev := range events {
+		if strings.HasPrefix(upper, ev) {
+			return true
+		}
+	}
+	return false
+}
+
+func calculateIndent(trimmed string, st indentState) int {
+	if len(trimmed) == 0 {
+		return 0
+	}
+	
+	upper := strings.ToUpper(trimmed)
+	
+	// Check for full-line comments at column zero
+	if strings.HasPrefix(trimmed, "*") {
+		return 0
+	}
+	
+	// Class definition/implementation header - column 0
+	if strings.HasPrefix(upper, "CLASS ") && (strings.Contains(upper, " DEFINITION") || strings.Contains(upper, " IMPLEMENTATION")) {
+		return 0
+	}
+	
+	// ENDCLASS - column 0
+	if upper == "ENDCLASS." {
+		return 0
+	}
+	
+	// Interface header
+	if strings.HasPrefix(upper, "INTERFACE ") {
+		return 0
+	}
+	
+	// ENDINTERFACE
+	if upper == "ENDINTERFACE." {
+		return 0
+	}
+	
+	// Report statement at column zero
+	if strings.HasPrefix(upper, "REPORT ") {
+		return 0
+	}
+	
+	// Function definition at column zero
+	if strings.HasPrefix(upper, "FUNCTION ") {
+		return 0
+	}
+	
+	// ENDFUNCTION at column zero
+	if upper == "ENDFUNCTION." {
+		return 0
+	}
+	
+	// Form at column zero (top-level forms in reports)
+	if strings.HasPrefix(upper, "FORM ") {
+		return 0
+	}
+	
+	// ENDFORM at column zero
+	if upper == "ENDFORM." {
+		return 0
+	}
+	
+	// Report event header - at column 0
+	if isReportEventHeader(upper) {
+		return 0
+	}
+	
+	// Section headers (PUBLIC SECTION, PROTECTED SECTION, PRIVATE SECTION)
+	if strings.HasSuffix(upper, " SECTION.") {
+		return 2
+	}
+	
+	// Method in class implementation - 2 spaces
+	if strings.HasPrefix(upper, "METHOD ") && st.inClassImpl {
+		return 2
+	}
+	
+	// ENDMETHOD in class implementation - 2 spaces
+	if upper == "ENDMETHOD." && st.inClassImpl {
+		return 2
+	}
+	
+	// Method signatures in interface - 2 spaces
+	if strings.HasPrefix(upper, "METHODS ") && st.inInterface {
+		return 2
+	}
+	
+	// Form - 2 spaces (inside report)
+	if strings.HasPrefix(upper, "FORM ") {
+		return 2
+	}
+	
+	// ENDFORM - 2 spaces
+	if upper == "ENDFORM." {
+		return 2
+	}
+	
+	// Calculate base indent for method/form body or report event body
+	bodyBase := 0
+	if st.inMethod || st.inForm {
+		bodyBase = 4 // method/form starts at 2, statements at 4
+	} else if st.functionDepth > 0 {
+		bodyBase = 4
+	} else if st.inClassImpl {
+		bodyBase = 2 // method starts at 2
+	} else if st.inReportBody {
+		bodyBase = 2 // report event body at 2
+	}
+	
+	// Add block depth for nested structures (IF, WHILE, DO, LOOP - NOT TRY, NOT CASE)
+	bodyBase += st.blockDepth * 2
+	
+	// CASE statement - at bodyBase (does NOT increase blockDepth)
+	if strings.HasPrefix(upper, "CASE ") || upper == "CASE." {
+		return bodyBase
+	}
+	
+	// WHEN clause - bodyBase + 2 (2 inside CASE)
+	if isWhen(upper) {
+		if st.inCase {
+			return bodyBase + 2
+		}
+		return bodyBase
+	}
+	
+	// ENDCASE - aligns with CASE at bodyBase
+	if upper == "ENDCASE." {
+		return bodyBase
+	}
+	
+	// TRY - at bodyBase (NOT a block that increases depth like IF)
+	if strings.HasPrefix(upper, "TRY") || upper == "TRY." {
+		return bodyBase
+	}
+	
+	// CATCH - bodyBase + 2 (2 spaces inside TRY)
+	if strings.HasPrefix(upper, "CATCH ") {
+		if st.tryDepth > 0 {
+			return bodyBase + 2
+		}
+		return bodyBase
+	}
+	
+	// CLEANUP - bodyBase + 2 (aligns with CATCH)
+	if upper == "CLEANUP." {
+		if st.tryDepth > 0 {
+			return bodyBase + 2
+		}
+		return bodyBase
+	}
+	
+	// ENDTRY - aligns with TRY at bodyBase
+	if upper == "ENDTRY." {
+		return bodyBase
+	}
+	
+	// For statements inside WHEN body, add extra indent
+	if st.caseWhenDepth > 0 && st.inCase {
+		bodyBase += 2
+	}
+	
+	// For statements inside TRY body (after TRY, before CATCH/ENDTRY)
+	if st.tryBodyDepth > 0 && st.inTry {
+		bodyBase += st.tryBodyDepth * 2
+	}
+	
+	// IF statement - at bodyBase, increases block depth for next lines
+	if strings.HasPrefix(upper, "IF ") || upper == "IF." {
+		return bodyBase
+	}
+	
+	// ELSEIF - at bodyBase
+	if strings.HasPrefix(upper, "ELSEIF ") {
+		return bodyBase
+	}
+	
+	// ELSE - at bodyBase
+	if upper == "ELSE." {
+		return bodyBase
+	}
+	
+	// ENDIF - at bodyBase
+	if upper == "ENDIF." {
+		return bodyBase
+	}
+	
+	// WHILE - at bodyBase
+	if strings.HasPrefix(upper, "WHILE ") || upper == "WHILE." {
+		return bodyBase
+	}
+	
+	// ENDWHILE - at bodyBase
+	if upper == "ENDWHILE." {
+		return bodyBase
+	}
+	
+	// DO - at bodyBase
+	if strings.HasPrefix(upper, "DO") {
+		return bodyBase
+	}
+	
+	// ENDDO - at bodyBase
+	if upper == "ENDDO." {
+		return bodyBase
+	}
+	
+	// LOOP - at bodyBase
+	if strings.HasPrefix(upper, "LOOP ") || upper == "LOOP." {
+		return bodyBase
+	}
+	
+	// ENDLOOP - at bodyBase
+	if upper == "ENDLOOP." {
+		return bodyBase
+	}
+	
+	// SELECT - at bodyBase
+	if strings.HasPrefix(upper, "SELECT ") {
+		return bodyBase
+	}
+	
+	// ENDSELECT - at bodyBase
+	if upper == "ENDSELECT." {
+		return bodyBase
+	}
+	
+	// AT - at bodyBase
+	if strings.HasPrefix(upper, "AT ") {
+		return bodyBase
+	}
+	
+	// ENDAT - at bodyBase
+	if upper == "ENDAT." {
+		return bodyBase
+	}
+	
+	// Class data/methods in sections - 4 spaces (2 for section + 2 for item)
+	if st.inSection && (strings.HasPrefix(upper, "DATA ") || strings.HasPrefix(upper, "CLASS-DATA ") || 
+		strings.HasPrefix(upper, "FIELD-SYMBOLS ") || strings.HasPrefix(upper, "CONSTANTS ") ||
+		strings.HasPrefix(upper, "METHODS ") || strings.HasPrefix(upper, "CLASS-METHODS ") ||
+		strings.HasPrefix(upper, "EVENTS ") || strings.HasPrefix(upper, "EVENT METHODS ") ||
+		strings.HasPrefix(upper, "ALIASES ") || strings.HasPrefix(upper, "TYPES ") ||
+		strings.HasPrefix(upper, "CONSTANT ")) {
+		return 4
+	}
+	
+	// Data declarations in class definition (not in section)
+	if st.inClassDef && !st.inSection && (strings.HasPrefix(upper, "DATA ") || 
+		strings.HasPrefix(upper, "CLASS-DATA ") || strings.HasPrefix(upper, "CONSTANTS ") ||
+		strings.HasPrefix(upper, "TYPES ") || strings.HasPrefix(upper, "CONSTANT ")) {
+		return 2
+	}
+	
+	// Statements inside method or form
+	if st.inMethod || st.inForm {
+		return bodyBase
+	}
+	
+	// Statements inside function
+	if st.functionDepth > 0 {
+		return bodyBase
+	}
+	
+	// Statements inside report event body
+	if st.inReportBody {
+		return bodyBase
+	}
+	
+	// Default for interface methods
+	if st.inInterface {
+		return 2
+	}
+	
+	return 0
+}
+
+func updateState(st *indentState, trimmed string) {
+	upper := strings.ToUpper(trimmed)
+	
+	// Track report
+	if strings.HasPrefix(upper, "REPORT ") {
+		st.inReport = true
+	}
+	
+	// Track report event header
+	if isReportEventHeader(upper) {
+		st.inReportBody = true
+	}
+	
+	// FORM ends report event body
+	if strings.HasPrefix(upper, "FORM ") && st.inReport {
+		st.inReportBody = false
+	}
+	
+	// Track section changes
+	if strings.HasSuffix(upper, " SECTION.") {
+		st.inSection = true
+	}
+	
+	// Class definition starts
+	if strings.HasPrefix(upper, "CLASS ") && strings.Contains(upper, " DEFINITION") {
+		st.inClassDef = true
+		st.inClassImpl = false
+		st.inMethod = false
+		st.inForm = false
+		st.inReport = false
+		st.inReportBody = false
+		st.inSection = false
+		st.blockDepth = 0
+		st.inCase = false
+		st.caseWhenDepth = 0
+		st.inTry = false
+		st.tryDepth = 0
+		st.tryBodyDepth = 0
+		st.selectDepth = 0
+		st.functionDepth = 0
+	}
+	
+	// Class implementation starts
+	if strings.HasPrefix(upper, "CLASS ") && strings.Contains(upper, " IMPLEMENTATION") {
+		st.inClassImpl = true
+		st.inClassDef = false
+		st.inMethod = false
+		st.inForm = false
+		st.inReport = false
+		st.inReportBody = false
+		st.inSection = false
+		st.blockDepth = 0
+		st.inCase = false
+		st.caseWhenDepth = 0
+		st.inTry = false
+		st.tryDepth = 0
+		st.tryBodyDepth = 0
+		st.selectDepth = 0
+		st.functionDepth = 0
+	}
+	
+	// ENDCLASS
+	if upper == "ENDCLASS." {
+		st.inClassDef = false
+		st.inClassImpl = false
+		st.inSection = false
+		st.inMethod = false
+		st.inForm = false
+		st.blockDepth = 0
+		st.inCase = false
+		st.caseWhenDepth = 0
+		st.inTry = false
+		st.tryDepth = 0
+		st.tryBodyDepth = 0
+		st.selectDepth = 0
+		st.functionDepth = 0
+	}
+	
+	// Interface
+	if strings.HasPrefix(upper, "INTERFACE ") {
+		st.inInterface = true
+	}
+	
+	if upper == "ENDINTERFACE." {
+		st.inInterface = false
+	}
+	
+	// METHOD starts method body
+	if strings.HasPrefix(upper, "METHOD ") {
+		st.inMethod = true
+	}
+	
+	// ENDMETHOD ends method body
+	if upper == "ENDMETHOD." {
+		st.inMethod = false
+		st.blockDepth = 0
+		st.inCase = false
+		st.caseWhenDepth = 0
+		st.inTry = false
+		st.tryDepth = 0
+		st.tryBodyDepth = 0
+	}
+	
+	// FORM starts form body
+	if strings.HasPrefix(upper, "FORM ") {
+		st.inForm = true
+		st.inReportBody = false // FORM body is separate from report event body
+	}
+	
+	// ENDFORM ends form body
+	if upper == "ENDFORM." {
+		st.inForm = false
+		st.blockDepth = 0
+		st.inCase = false
+		st.caseWhenDepth = 0
+		st.inTry = false
+		st.tryDepth = 0
+		st.tryBodyDepth = 0
+	}
+	
+	// CASE opens a CASE block
+	if (strings.HasPrefix(upper, "CASE ") || upper == "CASE.") && (st.inMethod || st.inForm || st.functionDepth > 0 || st.inReportBody) {
+		st.inCase = true
+		st.caseWhenDepth = 0
+	}
+	
+	// WHEN marks entry into WHEN body
+	if isWhen(upper) && st.inCase {
+		st.caseWhenDepth = 1
+	}
+	
+	// ENDCASE closes a CASE block
+	if upper == "ENDCASE." {
+		st.inCase = false
+		st.caseWhenDepth = 0
+	}
+	
+	// TRY opens a TRY block
+	if (strings.HasPrefix(upper, "TRY") || upper == "TRY.") && (st.inMethod || st.inForm || st.functionDepth > 0 || st.inReportBody) {
+		st.inTry = true
+		st.tryDepth = 1
+		st.tryBodyDepth = 1 // After TRY, we're in TRY body
+	}
+	
+	// CATCH marks entry into CATCH body
+	if strings.HasPrefix(upper, "CATCH ") {
+		st.tryBodyDepth = 2 // Inside CATCH body now
+	}
+	
+	// CLEANUP - still in TRY but at CLEANUP level
+	if upper == "CLEANUP." {
+		st.tryBodyDepth = 2 // Same as CATCH body
+	}
+	
+	// ENDTRY closes TRY block
+	if upper == "ENDTRY." {
+		st.inTry = false
+		st.tryDepth = 0
+		st.tryBodyDepth = 0
+	}
+	
+	// IF opens a block
+	if (strings.HasPrefix(upper, "IF ") || upper == "IF.") && (st.inMethod || st.inForm || st.functionDepth > 0 || st.inReportBody) {
+		st.blockDepth++
+	}
+	// ELSEIF, ELSE don't change depth
+	// ENDIF closes a block
+	if upper == "ENDIF." && st.blockDepth > 0 {
+		st.blockDepth--
+	}
+	
+	// WHILE opens a block
+	if (strings.HasPrefix(upper, "WHILE ") || upper == "WHILE.") && (st.inMethod || st.inForm || st.functionDepth > 0 || st.inReportBody) {
+		st.blockDepth++
+	}
+	// ENDWHILE closes
+	if upper == "ENDWHILE." && st.blockDepth > 0 {
+		st.blockDepth--
+	}
+	
+	// DO opens a block
+	if strings.HasPrefix(upper, "DO") && (st.inMethod || st.inForm || st.functionDepth > 0 || st.inReportBody) {
+		st.blockDepth++
+	}
+	// ENDDO closes
+	if upper == "ENDDO." && st.blockDepth > 0 {
+		st.blockDepth--
+	}
+	
+	// LOOP opens a block
+	if (strings.HasPrefix(upper, "LOOP ") || upper == "LOOP.") && (st.inMethod || st.inForm || st.functionDepth > 0 || st.inReportBody) {
+		st.blockDepth++
+	}
+	// ENDLOOP closes
+	if upper == "ENDLOOP." && st.blockDepth > 0 {
+		st.blockDepth--
+	}
+	
+	// SELECT
+	if strings.HasPrefix(upper, "SELECT ") {
+		st.selectDepth++
+	}
+	if upper == "ENDSELECT." {
+		st.selectDepth--
+	}
+	
+	// FUNCTION/ENDFUNCTION
+	if strings.HasPrefix(upper, "FUNCTION ") {
+		st.functionDepth++
+	}
+	if upper == "ENDFUNCTION." {
+		st.functionDepth--
+	}
+}
+
+// Format applies indentation and line wrapping to ABAP source code.
+// It returns an error if lines cannot be wrapped to fit within 255 bytes.
+func Format(src string) (string, error) {
+	// First apply indentation
+	indented := Indent(src)
+	
+	// Then apply line wrapping (reuse existing wrap function)
+	wrapped, err := wrap(indented)
+	if err != nil {
+		return "", err
+	}
+	
+	return wrapped, nil
+}
