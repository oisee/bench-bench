@@ -0,0 +1,518 @@
+package abap
+
+import (
+	"fmt"
+	"strings"
+)
+
+const maximumABAPLineBytes = 255
+
+type abapFrameKind uint8
+
+const (
+	frameOrdinary abapFrameKind = iota
+	frameClass
+	frameCase
+	frameTry
+	frameReport
+)
+
+type abapFrame struct {
+	kind abapFrameKind
+	base int
+}
+
+type abapStatement struct {
+	first  string
+	second string
+	third  string
+	fourth string
+	done   bool
+}
+
+type abapTokenState struct {
+	quote    byte
+	template bool
+	braces   int
+}
+
+type abapLexer struct {
+	tokens        []abapTokenState
+	statementOpen bool
+}
+
+type abapScanResult struct {
+	statements []abapStatement
+	lastDone   bool
+}
+
+func (l *abapLexer) scan(line string) abapScanResult {
+	var result abapScanResult
+	var current *abapStatement
+
+	startStatement := func(index int) {
+		statement := abapStatement{}
+		statement.first, index = wordAt(line, index)
+		if index < len(line) {
+			statement.second, index = nextWord(line, index)
+		}
+		if index < len(line) {
+			statement.third, index = nextWord(line, index)
+		}
+		if index < len(line) {
+			statement.fourth, index = nextWord(line, index)
+		}
+		result.statements = append(result.statements, statement)
+		current = &result.statements[len(result.statements)-1]
+		l.statementOpen = true
+	}
+
+	for index := 0; index < len(line); {
+		char := line[index]
+		if len(l.tokens) != 0 {
+			token := &l.tokens[len(l.tokens)-1]
+			if char == '\\' && token.quote == '|' {
+				index++
+			} else if char == token.quote {
+				if token.quote != '|' && index+1 < len(line) && line[index+1] == token.quote {
+					index++
+				} else {
+					l.tokens = l.tokens[:len(l.tokens)-1]
+				}
+			} else if token.template {
+				if char == '{' {
+					token.braces++
+				} else if char == '}' && token.braces > 0 {
+					token.braces--
+				} else if (char == '\'' || char == '`') && token.braces > 0 {
+					l.tokens = append(l.tokens, abapTokenState{quote: char})
+				}
+			}
+			index++
+			continue
+		}
+
+		switch char {
+		case '"':
+			return result
+		case '\'', '`', '|':
+			l.tokens = append(l.tokens, abapTokenState{quote: char, template: char == '|'})
+			index++
+		case '.':
+			if isDecimalPoint(line, index) {
+				index++
+				continue
+			}
+			if current != nil {
+				current.done = true
+				result.lastDone = true
+				current = nil
+			} else if l.statementOpen {
+				result.statements = append(result.statements, abapStatement{done: true})
+				result.lastDone = true
+			}
+			l.statementOpen = false
+			index++
+		default:
+			if isABAPWordByte(char) && !l.statementOpen {
+				startStatement(index)
+			}
+			index++
+		}
+	}
+	return result
+}
+
+func wordAt(text string, index int) (string, int) {
+	start := index
+	for index < len(text) && isABAPWordByte(text[index]) {
+		index++
+	}
+	return strings.ToUpper(text[start:index]), index
+}
+
+func nextWord(text string, index int) (string, int) {
+	for index < len(text) && (text[index] == ' ' || text[index] == '\t') {
+		index++
+	}
+	if index >= len(text) || !isABAPWordByte(text[index]) {
+		return "", index
+	}
+	return wordAt(text, index)
+}
+
+func isDecimalPoint(text string, index int) bool {
+	return index > 0 && index+1 < len(text) &&
+		text[index-1] >= '0' && text[index-1] <= '9' &&
+		text[index+1] >= '0' && text[index+1] <= '9'
+}
+
+func isABAPWordByte(char byte) bool {
+	return char >= 'A' && char <= 'Z' || char >= 'a' && char <= 'z' ||
+		char >= '0' && char <= '9' || char == '_' || char == '-' || char == '/'
+}
+
+type abapIndenter struct {
+	depth     int
+	frames    []abapFrame
+	pending   *abapStatement
+	statement int
+	lexer     abapLexer
+}
+
+// indent applies the generated ABAP layout. It is intentionally fixed rather
+// than configurable: all emitted ABAP uses one house style.
+func indent(src string) string {
+	if src == "" {
+		return ""
+	}
+	indenter := &abapIndenter{}
+	lines := strings.Split(strings.TrimSuffix(src, "\n"), "\n")
+	output := make([]string, len(lines))
+
+	for lineIndex, rawLine := range lines {
+		rawLine = strings.TrimSuffix(rawLine, "\r")
+		trimmed := strings.TrimLeft(rawLine, " \t")
+		if trimmed == "" {
+			output[lineIndex] = trimmed
+			continue
+		}
+		if strings.HasPrefix(trimmed, "*") {
+			output[lineIndex] = trimmed
+			continue
+		}
+
+		scan := indenter.lexer.scan(rawLine)
+		lineIndent := 0
+		if indenter.pending == nil {
+			if len(scan.statements) == 0 {
+				output[lineIndex] = trimmed
+				continue
+			}
+			indenter.pending = &abapStatement{
+				first:  scan.statements[0].first,
+				second: scan.statements[0].second,
+				third:  scan.statements[0].third,
+				fourth: scan.statements[0].fourth,
+			}
+			lineIndent = indenter.statementIndent(*indenter.pending)
+		} else {
+			lineIndent = indenter.statement
+		}
+		indenter.statement = lineIndent
+		if indenter.pending != nil && len(scan.statements) > 0 {
+			continuation := &scan.statements[0]
+			continuation.first = indenter.pending.first
+			continuation.second = indenter.pending.second
+			continuation.third = indenter.pending.third
+			continuation.fourth = indenter.pending.fourth
+		}
+
+		for statementIndex := range scan.statements {
+			statement := &scan.statements[statementIndex]
+			if statementIndex > 0 {
+				pending := &abapStatement{
+					first:  statement.first,
+					second: statement.second,
+					third:  statement.third,
+					fourth: statement.fourth,
+				}
+				indenter.pending = pending
+				indenter.statement = indenter.statementIndent(*pending)
+			}
+			if statement.done {
+				indenter.apply(*statement)
+				indenter.pending = nil
+			}
+		}
+		output[lineIndex] = strings.Repeat(" ", lineIndent) + trimmed
+	}
+	return strings.Join(output, "\n") + "\n"
+}
+
+func (f *abapIndenter) statementIndent(statement abapStatement) int {
+	switch statement.first {
+	case "CLASS", "INTERFACE":
+		return 0
+	case "ENDCLASS", "ENDINTERFACE":
+		return 0
+	case "ENDTRY":
+		if frame := f.findFrame(frameTry); frame != nil {
+			return frame.base
+		}
+	case "ENDCASE":
+		if frame := f.findFrame(frameCase); frame != nil {
+			return frame.base
+		}
+	case "ENDIF", "ENDDO", "ENDWHILE", "ENDLOOP", "ENDMETHOD", "ENDFUNCTION",
+		"ENDMODULE", "ENDSELECT", "ENDWITH", "ENDAT", "ENDFORM":
+		if len(f.frames) > 0 {
+			return f.frames[len(f.frames)-1].base
+		}
+		return 0
+	case "END":
+		if statement.second == "OF" && len(f.frames) > 0 {
+			return f.frames[len(f.frames)-1].base
+		}
+	case "PUBLIC", "PROTECTED", "PRIVATE":
+		if statement.second != "SECTION" {
+			break
+		}
+		if class := f.findFrame(frameClass); class != nil {
+			return class.base + 2
+		}
+	case "WHEN":
+		if frame := f.findFrame(frameCase); frame != nil {
+			return frame.base + 2
+		}
+	case "CATCH", "CLEANUP":
+		if frame := f.findFrame(frameTry); frame != nil {
+			return frame.base + 2
+		}
+	case "FORM":
+		return 0
+	case "ELSE", "ELSEIF":
+		if len(f.frames) > 0 {
+			return f.frames[len(f.frames)-1].base
+		}
+	}
+	return f.depth
+}
+
+func (f *abapIndenter) apply(statement abapStatement) {
+	if f.isReportEvent(statement) {
+		f.closeReport()
+		f.frames = append(f.frames, abapFrame{kind: frameReport, base: 0})
+		f.depth = 2
+		return
+	}
+
+	switch statement.first {
+	case "CLASS":
+		if !(statement.third == "DEFINITION" && statement.fourth == "DEFERRED") {
+			f.closeReport()
+			f.frames = append(f.frames, abapFrame{kind: frameClass, base: f.depth})
+			f.depth += 2
+		}
+		return
+	case "INTERFACE":
+		if statement.third == "DEFERRED" {
+			return
+		}
+		f.frames = append(f.frames, abapFrame{kind: frameOrdinary, base: f.depth})
+		f.depth += 2
+		return
+	case "ENDCLASS":
+		if class := f.findFrame(frameClass); class != nil {
+			f.depth = class.base
+			f.removeFrame(frameClass)
+		} else {
+			f.depth = 0
+		}
+		return
+	case "ENDINTERFACE":
+		f.popFrame()
+		return
+	case "PUBLIC", "PROTECTED", "PRIVATE":
+		if statement.second != "SECTION" {
+			return
+		}
+		if class := f.findFrame(frameClass); class != nil {
+			f.depth = class.base + 4
+		}
+		return
+	case "WHEN":
+		if frame := f.findFrame(frameCase); frame != nil {
+			f.depth = frame.base + 4
+		}
+		return
+	case "ELSE", "ELSEIF":
+		if len(f.frames) > 0 {
+			f.depth = f.frames[len(f.frames)-1].base + 2
+		}
+		return
+	case "CATCH", "CLEANUP":
+		if frame := f.findFrame(frameTry); frame != nil {
+			f.depth = frame.base + 4
+		}
+		return
+	case "FORM":
+		f.closeReport()
+		f.frames = append(f.frames, abapFrame{kind: frameOrdinary, base: 0})
+		f.depth = 2
+		return
+	case "ENDFORM":
+		f.popFrame()
+		f.depth = 0
+		return
+	}
+
+	if f.isCloseStatement(statement.first) {
+		f.popFrame()
+		return
+	}
+	if statement.first == "END" && statement.second == "OF" {
+		f.popFrame()
+		return
+	}
+	if f.isOpenStatement(statement) {
+		f.frames = append(f.frames, abapFrame{kind: f.openFrameKind(statement.first), base: f.depth})
+		if statement.first == "TRY" {
+			f.depth += 4
+		} else {
+			f.depth += 2
+		}
+	}
+}
+
+func (f *abapIndenter) isOpenStatement(statement abapStatement) bool {
+	switch statement.first {
+	case "IF", "DO", "WHILE", "LOOP", "CASE", "TRY", "METHOD", "FUNCTION", "MODULE", "SELECT", "WITH":
+		return true
+	case "AT":
+		return !f.isReportEvent(statement)
+	case "DATA", "TYPES", "CONSTANTS":
+		return (statement.second == "BEGIN" && statement.third == "OF") ||
+			(statement.third == "BEGIN" && statement.fourth == "OF")
+	}
+	return false
+}
+
+func (f *abapIndenter) isCloseStatement(keyword string) bool {
+	switch keyword {
+	case "ENDIF", "ENDDO", "ENDWHILE", "ENDLOOP", "ENDCASE", "ENDTRY", "ENDMETHOD",
+		"ENDFUNCTION", "ENDMODULE", "ENDSELECT", "ENDWITH", "ENDAT":
+		return true
+	}
+	return false
+}
+
+func (f *abapIndenter) openFrameKind(keyword string) abapFrameKind {
+	switch keyword {
+	case "CASE":
+		return frameCase
+	case "TRY":
+		return frameTry
+	default:
+		return frameOrdinary
+	}
+}
+
+func (f *abapIndenter) isReportEvent(statement abapStatement) bool {
+	switch statement.first {
+	case "INITIALIZATION", "START-OF-SELECTION", "END-OF-SELECTION", "LOAD-OF-PROGRAM",
+		"TOP-OF-PAGE", "END-OF-PAGE":
+		return true
+	case "AT":
+		switch statement.second {
+		case "SELECTION-SCREEN", "LINE-SELECTION", "USER-COMMAND", "PF-STATUS":
+			return true
+		}
+	}
+	return false
+}
+
+func (f *abapIndenter) findFrame(kind abapFrameKind) *abapFrame {
+	for index := len(f.frames) - 1; index >= 0; index-- {
+		if f.frames[index].kind == kind {
+			return &f.frames[index]
+		}
+	}
+	return nil
+}
+
+func (f *abapIndenter) removeFrame(kind abapFrameKind) {
+	for index := len(f.frames) - 1; index >= 0; index-- {
+		if f.frames[index].kind == kind {
+			f.frames = append(f.frames[:index], f.frames[index+1:]...)
+			return
+		}
+	}
+}
+
+func (f *abapIndenter) popFrame() {
+	if len(f.frames) == 0 {
+		f.depth = max(f.depth-2, 0)
+		return
+	}
+	frame := f.frames[len(f.frames)-1]
+	f.frames = f.frames[:len(f.frames)-1]
+	if frame.kind == frameReport {
+		f.depth = 0
+	} else {
+		f.depth = frame.base
+	}
+}
+
+func (f *abapIndenter) closeReport() {
+	if f.findFrame(frameReport) != nil {
+		f.removeFrame(frameReport)
+		f.depth = 0
+	}
+}
+
+// Format indents generated ABAP and wraps every physical line to at most 255
+// bytes. Continuations receive the indentation of their opening statement.
+func Format(src string) (string, error) {
+	if src == "" {
+		return "", nil
+	}
+	indented := indent(src)
+	var output strings.Builder
+	for _, line := range strings.Split(strings.TrimSuffix(indented, "\n"), "\n") {
+		for len(line) > maximumABAPLineBytes {
+			prefixLen := len(line) - len(strings.TrimLeft(line, " "))
+			cut, inToken := safeABAPWrap(line, maximumABAPLineBytes)
+			if cut <= prefixLen || inToken {
+				return "", fmt.Errorf("unbreakable source line (%d bytes)", len(line))
+			}
+			output.WriteString(line[:cut] + "\n")
+			line = strings.Repeat(" ", prefixLen) + strings.TrimLeft(line[cut:], " ")
+		}
+		output.WriteString(line + "\n")
+	}
+	return output.String(), nil
+}
+
+func safeABAPWrap(line string, limit int) (int, bool) {
+	cut := -1
+	lexer := abapLexer{}
+	for index := 0; index < len(line); index++ {
+		char := line[index]
+		if len(lexer.tokens) != 0 {
+			token := &lexer.tokens[len(lexer.tokens)-1]
+			if char == '\\' && token.quote == '|' {
+				index++
+			} else if char == token.quote {
+				if token.quote != '|' && index+1 < len(line) && line[index+1] == token.quote {
+					index++
+				} else {
+					lexer.tokens = lexer.tokens[:len(lexer.tokens)-1]
+				}
+			} else if token.template {
+				if char == '{' {
+					token.braces++
+				} else if char == '}' && token.braces > 0 {
+					token.braces--
+				} else if (char == '\'' || char == '`') && token.braces > 0 {
+					lexer.tokens = append(lexer.tokens, abapTokenState{quote: char})
+				}
+			}
+			continue
+		}
+		if char == '"' {
+			return cut, true
+		}
+		if char == '\'' || char == '`' || char == '|' {
+			lexer.tokens = append(lexer.tokens, abapTokenState{quote: char, template: char == '|'})
+			continue
+		}
+		if index >= limit {
+			return cut, false
+		}
+		if char == ' ' || char == '\t' {
+			cut = index
+		}
+	}
+	return cut, false
+}
