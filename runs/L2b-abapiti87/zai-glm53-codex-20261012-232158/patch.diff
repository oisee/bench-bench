+package abap
+
+import (
+	"regexp"
+	"strings"
+	"testing"
+)
+
+func TestIndentGeneratedABAP(t *testing.T) {
+	const source = `CLASS zcl DEFINITION PUBLIC.
+PUBLIC SECTION.
+METHODS run IMPORTING input TYPE string.
+ENDCLASS.
+CLASS zcl IMPLEMENTATION.
+METHOD run.
+DATA value TYPE i.
+C value = 4.
+CASE value.
+WHEN 1
+OR 2.
+value = 2.
+WHEN OTHERS.
+TRY.
+value = 3.
+CATCH cx_root.
+value = 4.
+CLEANUP.
+CLEAR value.
+ENDTRY.
+ENDCASE.
+IF value = 4.
+value = 5.
+ELSE.
+value = 6.
+ENDIF.
+ENDMETHOD.
+ENDCLASS.
+INTERFACE zif PUBLIC.
+METHODS run.
+ENDINTERFACE.
+CLASS zfw DEFINITION DEFERRED.
+REPORT zprog.
+START-OF-SELECTION.
+GET RUN TIME FIELD value.
+value = 7. IF value = 7. value = 8. ENDIF.
+FORM run.
+value = 9.
+ENDFORM.
+* full-line comment
+DATA escaped TYPE string VALUE 'IF ENDIF.'.
+DATA template TYPE string VALUE |IF { 'ENDIF.' } ENDIF.|.
+IF value = 1.5.
+value = 2.
+ENDIF.
+`
+
+	const want = `CLASS zcl DEFINITION PUBLIC.
+  PUBLIC SECTION.
+    METHODS run IMPORTING input TYPE string.
+ENDCLASS.
+CLASS zcl IMPLEMENTATION.
+  METHOD run.
+    DATA value TYPE i.
+    C value = 4.
+    CASE value.
+      WHEN 1
+      OR 2.
+        value = 2.
+      WHEN OTHERS.
+        TRY.
+            value = 3.
+          CATCH cx_root.
+            value = 4.
+          CLEANUP.
+            CLEAR value.
+        ENDTRY.
+    ENDCASE.
+    IF value = 4.
+      value = 5.
+    ELSE.
+      value = 6.
+    ENDIF.
+  ENDMETHOD.
+ENDCLASS.
+INTERFACE zif PUBLIC.
+  METHODS run.
+ENDINTERFACE.
+CLASS zfw DEFINITION DEFERRED.
+REPORT zprog.
+START-OF-SELECTION.
+  GET RUN TIME FIELD value.
+  value = 7. IF value = 7. value = 8. ENDIF.
+FORM run.
+  value = 9.
+ENDFORM.
+* full-line comment
+DATA escaped TYPE string VALUE 'IF ENDIF.'.
+DATA template TYPE string VALUE |IF { 'ENDIF.' } ENDIF.|.
+IF value = 1.5.
+  value = 2.
+ENDIF.
+`
+
+	got := indent(source)
+	if got != want {
+		gotLines := strings.Split(got, "\n")
+		wantLines := strings.Split(want, "\n")
+		for index := 0; index < len(gotLines) && index < len(wantLines); index++ {
+			if gotLines[index] != wantLines[index] {
+				t.Errorf("first mismatch line %d: got %q, want %q", index+1, gotLines[index], wantLines[index])
+				break
+			}
+		}
+		t.Fatalf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+	if again := indent(got); again != got {
+		t.Fatalf("indent is not idempotent:\n%s", again)
+	}
+}
+
+func TestFormatWrapsContinuations(t *testing.T) {
+	source := "CLASS zcl IMPLEMENTATION.\nMETHOD run.\nresult = " + strings.Repeat("value ", 70) + ".\nENDMETHOD.\nENDCLASS.\n"
+	got, err := Format(source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, line := range strings.Split(strings.TrimSuffix(got, "\n"), "\n") {
+		if len(line) > maximumABAPLineBytes {
+			t.Fatalf("line has %d bytes: %q", len(line), line)
+		}
+	}
+	if !strings.HasPrefix(strings.Split(strings.Split(got, "\n")[2], "value")[0], "    ") {
+		t.Fatalf("continuation lost statement indentation:\n%s", got)
+	}
+	again, err := Format(got)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if again != got {
+		t.Fatalf("Format is not idempotent:\n%s", again)
+	}
+}
+
+func TestFormatWrappedMethodSignature(t *testing.T) {
+	source := "CLASS zcl IMPLEMENTATION.\nMETHOD run IMPORTING " +
+		strings.Repeat("p TYPE string ", 30) + "RETURNING VALUE(result) TYPE i.\n" +
+		"DATA value TYPE i.\nENDMETHOD.\nENDCLASS.\n"
+	got, err := Format(source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	again, err := Format(got)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if again != got {
+		t.Fatalf("wrapped METHOD is not idempotent:\nfirst:\n%s\nsecond:\n%s", got, again)
+	}
+	if !regexp.MustCompile(`(?m)^    DATA value TYPE i\.$`).MatchString(got) {
+		t.Fatalf("METHOD body lost indentation:\n%s", got)
+	}
+}
