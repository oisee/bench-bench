+package abap
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestIndentClassAndControlFlow(t *testing.T) {
+	src := `CLASS zcl_demo DEFINITION PUBLIC.
+PUBLIC SECTION.
+METHODS run.
+ENDCLASS.
+CLASS zcl_demo IMPLEMENTATION.
+METHOD run.
+IF condition = abap_true.
+CASE value.
+WHEN 1.
+result = 1.
+WHEN OTHERS.
+result = 0.
+ENDCASE.
+ELSE.
+TRY.
+work( ).
+CATCH cx_root INTO error.
+handle( ).
+CLEANUP.
+clean( ).
+ENDTRY.
+ENDIF.
+ENDMETHOD.
+ENDCLASS.
+`
+	want := `CLASS zcl_demo DEFINITION PUBLIC.
+  PUBLIC SECTION.
+    METHODS run.
+ENDCLASS.
+CLASS zcl_demo IMPLEMENTATION.
+  METHOD run.
+    IF condition = abap_true.
+      CASE value.
+        WHEN 1.
+          result = 1.
+        WHEN OTHERS.
+          result = 0.
+      ENDCASE.
+    ELSE.
+      TRY.
+          work( ).
+        CATCH cx_root INTO error.
+          handle( ).
+        CLEANUP.
+          clean( ).
+      ENDTRY.
+    ENDIF.
+  ENDMETHOD.
+ENDCLASS.
+`
+	if got := indent(src); got != want {
+		t.Fatalf("indent mismatch:\n--- got ---\n%s--- want ---\n%s", got, want)
+	}
+}
+
+func TestIndentInterfaceReportAndForwardClass(t *testing.T) {
+	src := `CLASS zcl_future DEFINITION DEFERRED.
+INTERFACE zif_demo PUBLIC.
+METHODS run.
+ENDINTERFACE.
+REPORT zreport.
+GET RUN TIME FIELD runtime.
+GET TIME STAMP FIELD timestamp.
+DATA before_events TYPE i.
+START-OF-SELECTION.
+WRITE runtime.
+AT LINE-SELECTION.
+WRITE runtime.
+FORM helper.
+WRITE 'END-OF-SELECTION.'.
+ENDFORM.
+`
+	want := `CLASS zcl_future DEFINITION DEFERRED.
+INTERFACE zif_demo PUBLIC.
+  METHODS run.
+ENDINTERFACE.
+REPORT zreport.
+GET RUN TIME FIELD runtime.
+GET TIME STAMP FIELD timestamp.
+DATA before_events TYPE i.
+START-OF-SELECTION.
+  WRITE runtime.
+AT LINE-SELECTION.
+  WRITE runtime.
+FORM helper.
+  WRITE 'END-OF-SELECTION.'.
+ENDFORM.
+`
+	if got := indent(src); got != want {
+		t.Fatalf("indent mismatch:\n--- got ---\n%s--- want ---\n%s", got, want)
+	}
+}
+
+func TestIndentLexicalBoundariesAndInlineStatements(t *testing.T) {
+	src := "CLASS zcl_demo IMPLEMENTATION.\nMETHOD run.\nIF text = 'ENDMETHOD.'. result = |ENDIF. \\| literal|.\nENDIF.\nIF ready. DATA value TYPE i.\nvalue = 1.\nENDIF. \" closing comment has ENDIF.\nDATA continued TYPE i VALUE\n\t* comment between continuation lines\n1.\n\t* comment at column zero\nDATA(value) = `ENDCLASS.`.\nENDMETHOD.\nENDCLASS.\n"
+	want := "CLASS zcl_demo IMPLEMENTATION.\n  METHOD run.\n    IF text = 'ENDMETHOD.'. result = |ENDIF. \\| literal|.\n    ENDIF.\n    IF ready. DATA value TYPE i.\n      value = 1.\n    ENDIF. \" closing comment has ENDIF.\n    DATA continued TYPE i VALUE\n* comment between continuation lines\n    1.\n* comment at column zero\n    DATA(value) = `ENDCLASS.`.\n  ENDMETHOD.\nENDCLASS.\n"
+	if got := indent(src); got != want {
+		t.Fatalf("indent mismatch:\n--- got ---\n%s--- want ---\n%s", got, want)
+	}
+}
+
+func TestFormatWrapsAtStatementIndentAndIsIdempotent(t *testing.T) {
+	statement := "WRITE: " + strings.TrimSuffix(strings.Repeat("/ some_long_identifier, ", 18), ", ") + "."
+	src := "FORM long_line.\n" + statement + "\nENDFORM.\n"
+	got, err := Format(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i, line := range strings.Split(strings.TrimSuffix(got, "\n"), "\n") {
+		if len([]byte(line)) > maxLineBytes {
+			t.Errorf("line %d has %d bytes", i+1, len([]byte(line)))
+		}
+		if i > 0 && i < len(strings.Split(strings.TrimSuffix(got, "\n"), "\n"))-1 && line != "ENDFORM." && !strings.HasPrefix(line, "  ") {
+			t.Errorf("wrapped form body lost its indentation: %q", line)
+		}
+	}
+	gotAgain, err := Format(got)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if gotAgain != got {
+		t.Fatalf("Format is not idempotent:\n%s\n---\n%s", got, gotAgain)
+	}
+	if gotIndentAgain := indent(got); gotIndentAgain != got {
+		t.Fatalf("indent is not idempotent:\n%s\n---\n%s", got, gotIndentAgain)
+	}
+}
