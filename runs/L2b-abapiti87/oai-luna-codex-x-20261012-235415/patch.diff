new file mode 100644
index 0000000..64516ac
--- /dev/null
+++ b/tsfront/format.go
@@ -0,0 +1,14 @@
+package tsfront
+
+import "github.com/oisee/abapiti/hir/abap"
+
+// formatGeneratedABAP applies the shared formatter to the auxiliary sources
+// whose public APIs return a string and therefore cannot report formatting
+// errors. Their generated literals are emitted in bounded chunks.
+func formatGeneratedABAP(src string) string {
+	formatted, err := abap.Format(src)
+	if err != nil {
+		panic(err)
+	}
+	return formatted
+}
