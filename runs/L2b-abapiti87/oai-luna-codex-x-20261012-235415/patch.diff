+func formatCompileResult(r *CompileResult) error {
+	formatMap := func(sources map[string]string) error {
+		for name, src := range sources {
+			if err := checkABAPNesting(src); err != nil {
+				return fmt.Errorf("%s: %w", name, err)
+			}
+			formatted, err := abap.Format(src)
+			if err != nil {
+				return fmt.Errorf("%s: %w", name, err)
+			}
+			sources[name] = formatted
+		}
+		return nil
+	}
+	if err := checkABAPNesting(r.MainClass); err != nil {
+		return fmt.Errorf("main class: %w", err)
+	}
+	if formatted, err := abap.Format(r.MainClass); err != nil {
+		return fmt.Errorf("main class: %w", err)
+	} else {
+		r.MainClass = formatted
+	}
+	if err := checkABAPNesting(r.StateClass); err != nil {
+		return fmt.Errorf("state class: %w", err)
+	}
+	if formatted, err := abap.Format(r.StateClass); err != nil {
+		return fmt.Errorf("state class: %w", err)
+	} else {
+		r.StateClass = formatted
+	}
+	if err := formatMap(r.ChunkClasses); err != nil {
+		return err
+	}
+	return formatMap(r.Interfaces)
+}
