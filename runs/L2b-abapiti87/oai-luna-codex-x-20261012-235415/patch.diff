diff --git a/hir/abap/format.go b/hir/abap/format.go
new file mode 100644
index 0000000..24fddc8
--- /dev/null
+++ b/hir/abap/format.go
@@ -0,0 +1,650 @@
+package abap
+
+import (
+	"fmt"
+	"strings"
+)
+
+const indentWidth = 2
+const maxLineBytes = 255
+
+// indent applies abaplint's default two-space indentation to generated ABAP.
+// It is deliberately a small lexer and block tracker rather than a formatter
+// for arbitrary ABAP syntax: generated statements retain their original text.
+func indent(src string) string {
+	lines := strings.Split(src, "\n")
+	var out strings.Builder
+	state := formatState{}
+	for i, line := range lines {
+		body := strings.TrimSuffix(line, "\r")
+		trimmed := strings.TrimLeft(body, " \t")
+		if trimmed == "" {
+			if i < len(lines)-1 || body != "" {
+				out.WriteByte('\n')
+			}
+			continue
+		}
+		if state.lex == lexNormal && strings.HasPrefix(trimmed, "*") {
+			out.WriteString(trimmed)
+			if i < len(lines)-1 {
+				out.WriteByte('\n')
+			}
+			continue
+		}
+
+		lineIndent := state.currentIndent()
+		if state.statementActive {
+			lineIndent = state.statementIndent
+		} else if head := firstStatementCode(trimmed); strings.TrimSpace(head) != "" {
+			lineIndent = state.indentFor(head)
+		}
+		if lineIndent < 0 {
+			lineIndent = 0
+		}
+		out.WriteString(strings.Repeat(" ", lineIndent))
+		out.WriteString(trimmed)
+		if i < len(lines)-1 {
+			out.WriteByte('\n')
+		}
+
+		state.scanLine(trimmed, lineIndent)
+	}
+	return out.String()
+}
+
+// Format applies fixed two-space indentation and wraps generated statements
+// without splitting literals or comments. The 255-byte limit includes leading
+// spaces. It returns an error when a single literal or comment cannot fit.
+func Format(src string) (string, error) {
+	return wrapFormatted(indent(src))
+}
+
+type lexMode uint8
+
+const (
+	lexNormal lexMode = iota
+	lexSingle
+	lexBacktick
+	lexTemplate
+)
+
+type blockFrame struct {
+	kind       string
+	openIndent int
+	bodyIndent int
+}
+
+type formatState struct {
+	frames          []blockFrame
+	eventBody       bool
+	statement       strings.Builder
+	statementActive bool
+	statementIndent int
+	lex             lexMode
+}
+
+func (s *formatState) currentIndent() int {
+	if n := len(s.frames); n > 0 {
+		return s.frames[n-1].bodyIndent
+	}
+	if s.eventBody {
+		return indentWidth
+	}
+	return 0
+}
+
+func (s *formatState) indentFor(code string) int {
+	w := statementWords(code)
+	if len(w) == 0 {
+		return s.currentIndent()
+	}
+	first := w[0]
+	if isReportEvent(w) || first == "CLASS" || first == "INTERFACE" || first == "FORM" {
+		return 0
+	}
+	if idx := s.matchingFrame(closeKind(first)); idx >= 0 {
+		return s.frames[idx].openIndent
+	}
+	switch first {
+	case "ELSE", "ELSEIF":
+		if idx := s.matchingFrame("if"); idx >= 0 {
+			return s.frames[idx].openIndent
+		}
+	case "WHEN":
+		if idx := s.matchingFrame("case"); idx >= 0 {
+			return s.frames[idx].openIndent + indentWidth
+		}
+	case "CATCH", "CLEANUP":
+		if idx := s.matchingFrame("try"); idx >= 0 {
+			return s.frames[idx].openIndent + indentWidth
+		}
+	case "PUBLIC", "PROTECTED", "PRIVATE":
+		if len(w) > 1 && w[1] == "SECTION" {
+			if idx := s.classDefinitionFrame(); idx >= 0 {
+				return s.frames[idx].openIndent + indentWidth
+			}
+		}
+	}
+	return s.currentIndent()
+}
+
+func (s *formatState) scanLine(line string, lineIndent int) {
+	activeAtStart := s.statementActive
+	for i := 0; i < len(line); i++ {
+		c := line[i]
+		switch s.lex {
+		case lexSingle:
+			if c == '\'' {
+				if i+1 < len(line) && line[i+1] == '\'' {
+					i++
+				} else {
+					s.lex = lexNormal
+				}
+			}
+			continue
+		case lexBacktick:
+			if c == '`' {
+				if i+1 < len(line) && line[i+1] == '`' {
+					i++
+				} else {
+					s.lex = lexNormal
+				}
+			}
+			continue
+		case lexTemplate:
+			if c == '\\' && i+1 < len(line) {
+				i++
+			} else if c == '|' {
+				s.lex = lexNormal
+			}
+			continue
+		}
+
+		if c == '"' {
+			break
+		}
+		if c == '\'' {
+			s.lex = lexSingle
+			continue
+		}
+		if c == '`' {
+			s.lex = lexBacktick
+			continue
+		}
+		if c == '|' {
+			s.lex = lexTemplate
+			continue
+		}
+		if c == '.' && !(i > 0 && i+1 < len(line) && isDigit(line[i-1]) && isDigit(line[i+1])) {
+			s.processStatement(s.statement.String())
+			s.statement.Reset()
+			s.statementActive = false
+			continue
+		}
+		if !s.statementActive && (c == ' ' || c == '\t') {
+			continue
+		}
+		if !s.statementActive {
+			s.statementIndent = lineIndent
+			s.statementActive = true
+		}
+		s.statement.WriteByte(c)
+	}
+	if s.statementActive {
+		if !activeAtStart {
+			s.statementIndent = s.indentFor(s.statement.String())
+		}
+		s.statement.WriteByte(' ')
+	}
+}
+
+func (s *formatState) processStatement(code string) {
+	w := statementWords(code)
+	if len(w) == 0 {
+		return
+	}
+	first := w[0]
+
+	if isReportEvent(w) {
+		s.eventBody = true
+		return
+	}
+	if isClassHeader(w) {
+		mode := "class-definition"
+		if containsWord(w, "IMPLEMENTATION") {
+			mode = "class-implementation"
+		}
+		s.eventBody = false
+		s.frames = append(s.frames, blockFrame{kind: mode, openIndent: 0, bodyIndent: indentWidth})
+		return
+	}
+	if first == "INTERFACE" {
+		s.eventBody = false
+		s.frames = append(s.frames, blockFrame{kind: "interface", openIndent: 0, bodyIndent: indentWidth})
+		return
+	}
+	if first == "FORM" {
+		s.eventBody = false
+		s.frames = append(s.frames, blockFrame{kind: "form", openIndent: 0, bodyIndent: indentWidth})
+		return
+	}
+	if end := closeKind(first); end != "" {
+		s.closeFrame(end)
+		return
+	}
+
+	if len(w) >= 2 {
+		switch {
+		case first == "PUBLIC" || first == "PROTECTED" || first == "PRIVATE":
+			if w[1] == "SECTION" {
+				if idx := s.classDefinitionFrame(); idx >= 0 {
+					s.frames[idx].bodyIndent = s.frames[idx].openIndent + 2*indentWidth
+				}
+			}
+		case first == "ELSE" || first == "ELSEIF":
+			if idx := s.matchingFrame("if"); idx >= 0 {
+				s.frames[idx].bodyIndent = s.frames[idx].openIndent + indentWidth
+			}
+		case first == "WHEN":
+			if idx := s.matchingFrame("case"); idx >= 0 {
+				s.frames[idx].bodyIndent = s.frames[idx].openIndent + 2*indentWidth
+			}
+		case first == "CATCH" || first == "CLEANUP":
+			if idx := s.matchingFrame("try"); idx >= 0 {
+				s.frames[idx].bodyIndent = s.frames[idx].openIndent + 2*indentWidth
+			}
+		}
+	}
+
+	if kind := openKind(w); kind != "" {
+		base := s.currentIndent()
+		body := base + indentWidth
+		if kind == "try" {
+			body = base + 2*indentWidth
+		}
+		s.frames = append(s.frames, blockFrame{kind: kind, openIndent: base, bodyIndent: body})
+	}
+}
+
+func (s *formatState) closeFrame(kind string) {
+	idx := s.matchingFrame(kind)
+	if idx < 0 {
+		return
+	}
+	closed := s.frames[idx].kind
+	s.frames = s.frames[:idx]
+	if closed == "class-implementation" || closed == "class-definition" || closed == "interface" {
+		s.eventBody = false
+	}
+}
+
+func (s *formatState) matchingFrame(kind string) int {
+	for i := len(s.frames) - 1; i >= 0; i-- {
+		if s.frames[i].kind == kind || (kind == "class" && (s.frames[i].kind == "class-definition" || s.frames[i].kind == "class-implementation")) {
+			return i
+		}
+	}
+	return -1
+}
+
+func (s *formatState) classDefinitionFrame() int {
+	for i := len(s.frames) - 1; i >= 0; i-- {
+		if s.frames[i].kind == "class-definition" {
+			return i
+		}
+		if s.frames[i].kind == "class-implementation" || s.frames[i].kind == "interface" {
+			return -1
+		}
+	}
+	return -1
+}
+
+func closeKind(first string) string {
+	switch first {
+	case "ENDCLASS":
+		return "class"
+	case "ENDINTERFACE":
+		return "interface"
+	case "ENDMETHOD":
+		return "method"
+	case "ENDFORM":
+		return "form"
+	case "ENDIF":
+		return "if"
+	case "ENDCASE":
+		return "case"
+	case "ENDTRY":
+		return "try"
+	case "ENDDO":
+		return "do"
+	case "ENDWHILE":
+		return "while"
+	case "ENDLOOP":
+		return "loop"
+	case "ENDSELECT":
+		return "select"
+	case "ENDAT":
+		return "at"
+	case "ENDON":
+		return "on-change"
+	case "ENDEXEC":
+		return "exec-sql"
+	case "END-OF-DEFINITION":
+		return "define"
+	case "ENDCHAIN":
+		return "chain"
+	case "ENDPROVIDE":
+		return "provide"
+	case "ENDMODULE":
+		return "module"
+	case "ENDFUNCTION":
+		return "function"
+	case "ENDENHANCEMENT":
+		return "enhancement"
+	}
+	return ""
+}
+
+func openKind(w []string) string {
+	if len(w) == 0 {
+		return ""
+	}
+	switch w[0] {
+	case "METHOD":
+		return "method"
+	case "IF":
+		return "if"
+	case "CASE":
+		return "case"
+	case "TRY":
+		return "try"
+	case "DO":
+		return "do"
+	case "WHILE":
+		return "while"
+	case "LOOP":
+		return "loop"
+	case "SELECT":
+		if !containsSequence(w, "INTO", "TABLE") && !containsSequence(w, "APPENDING", "TABLE") && !containsWord(w, "SINGLE") {
+			return "select"
+		}
+	case "AT":
+		if len(w) > 1 && w[1] != "SELECTION-SCREEN" {
+			return "at"
+		}
+	case "ON":
+		if len(w) > 1 && w[1] == "CHANGE" {
+			return "on-change"
+		}
+	case "DEFINE":
+		return "define"
+	case "CHAIN":
+		return "chain"
+	case "PROVIDE":
+		return "provide"
+	case "MODULE":
+		return "module"
+	case "FUNCTION":
+		return "function"
+	case "EXEC":
+		if len(w) > 1 && w[1] == "SQL" {
+			return "exec-sql"
+		}
+	case "ENHANCEMENT":
+		return "enhancement"
+	}
+	return ""
+}
+
+func isClassHeader(w []string) bool {
+	if len(w) < 3 || w[0] != "CLASS" {
+		return false
+	}
+	if containsWord(w, "DEFERRED") || containsWord(w, "LOAD") {
+		return false
+	}
+	return containsWord(w, "DEFINITION") || containsWord(w, "IMPLEMENTATION")
+}
+
+func isReportEvent(w []string) bool {
+	if len(w) == 0 {
+		return false
+	}
+	switch w[0] {
+	case "START-OF-SELECTION", "END-OF-SELECTION", "INITIALIZATION", "TOP-OF-PAGE", "END-OF-PAGE", "LOAD-OF-PROGRAM":
+		return true
+	case "AT":
+		if len(w) < 2 {
+			return false
+		}
+		return w[1] == "SELECTION-SCREEN" || w[1] == "LINE-SELECTION" || w[1] == "USER-COMMAND" || strings.HasPrefix(w[1], "PF")
+	case "GET":
+		if len(w) < 2 {
+			return false
+		}
+		switch w[1] {
+		case "RUN", "TIME", "PARAMETER", "REFERENCE", "CURSOR", "BIT":
+			return false
+		}
+		return true
+	}
+	return false
+}
+
+func firstStatementCode(line string) string {
+	var b strings.Builder
+	mode := lexNormal
+	for i := 0; i < len(line); i++ {
+		c := line[i]
+		switch mode {
+		case lexSingle:
+			if c == '\'' {
+				if i+1 < len(line) && line[i+1] == '\'' {
+					i++
+				} else {
+					mode = lexNormal
+				}
+			}
+			continue
+		case lexBacktick:
+			if c == '`' {
+				if i+1 < len(line) && line[i+1] == '`' {
+					i++
+				} else {
+					mode = lexNormal
+				}
+			}
+			continue
+		case lexTemplate:
+			if c == '\\' && i+1 < len(line) {
+				i++
+			} else if c == '|' {
+				mode = lexNormal
+			}
+			continue
+		}
+		if c == '"' || (c == '.' && !(i > 0 && i+1 < len(line) && isDigit(line[i-1]) && isDigit(line[i+1]))) {
+			break
+		}
+		if c == '\'' {
+			mode = lexSingle
+		} else if c == '`' {
+			mode = lexBacktick
+		} else if c == '|' {
+			mode = lexTemplate
+		} else {
+			b.WriteByte(c)
+		}
+	}
+	return b.String()
+}
+
+func statementWords(code string) []string {
+	fields := strings.Fields(code)
+	for i := range fields {
+		fields[i] = strings.ToUpper(strings.Trim(fields[i], ":,()"))
+	}
+	return fields
+}
+
+func containsWord(words []string, want string) bool {
+	for _, word := range words {
+		if word == want {
+			return true
+		}
+	}
+	return false
+}
+
+func containsSequence(words []string, first, second string) bool {
+	for i := 0; i+1 < len(words); i++ {
+		if words[i] == first && words[i+1] == second {
+			return true
+		}
+	}
+	return false
+}
+
+func isDigit(c byte) bool { return c >= '0' && c <= '9' }
+
+func wrapFormatted(src string) (string, error) {
+	if src == "" {
+		return "", nil
+	}
+	lines := strings.Split(src, "\n")
+	ended := strings.HasSuffix(src, "\n")
+	if ended {
+		lines = lines[:len(lines)-1]
+	}
+	var out strings.Builder
+	mode := lexNormal
+	for lineNo, line := range lines {
+		wrapped, err := wrapLine(line, mode)
+		if err != nil {
+			return "", fmt.Errorf("line %d: %w", lineNo+1, err)
+		}
+		out.WriteString(wrapped)
+		if lineNo < len(lines)-1 || ended {
+			out.WriteByte('\n')
+		}
+		mode = advanceLexMode(line, mode)
+	}
+	return out.String(), nil
+}
+
+func wrapLine(line string, initial lexMode) (string, error) {
+	var out strings.Builder
+	mode := initial
+	for len(line) > maxLineBytes {
+		indent := 0
+		for indent < len(line) && line[indent] == ' ' {
+			indent++
+		}
+		cut := -1
+		state := mode
+		commentAt := -1
+		for i := 0; i < len(line) && i <= maxLineBytes; i++ {
+			c := line[i]
+			switch state {
+			case lexSingle:
+				if c == '\'' {
+					if i+1 < len(line) && line[i+1] == '\'' {
+						i++
+					} else {
+						state = lexNormal
+					}
+				}
+			case lexBacktick:
+				if c == '`' {
+					if i+1 < len(line) && line[i+1] == '`' {
+						i++
+					} else {
+						state = lexNormal
+					}
+				}
+			case lexTemplate:
+				if c == '\\' && i+1 < len(line) {
+					i++
+				} else if c == '|' {
+					state = lexNormal
+				}
+			default:
+				if c == '"' {
+					commentAt = i
+					break
+				}
+				if c == '\'' {
+					state = lexSingle
+				} else if c == '`' {
+					state = lexBacktick
+				} else if c == '|' {
+					state = lexTemplate
+				} else if c == ' ' && i >= indent && (commentAt < 0 || i < commentAt) {
+					cut = i
+				}
+			}
+			if commentAt >= 0 {
+				break
+			}
+		}
+		if cut <= indent {
+			return "", fmt.Errorf("cannot wrap %d-byte line without splitting a literal or comment", len(line))
+		}
+		left := strings.TrimRight(line[:cut], " ")
+		rest := strings.TrimLeft(line[cut:], " ")
+		if len(left) > maxLineBytes {
+			return "", fmt.Errorf("cannot wrap %d-byte line within %d bytes", len(line), maxLineBytes)
+		}
+		out.WriteString(left)
+		out.WriteByte('\n')
+		line = strings.Repeat(" ", indent) + rest
+		mode = lexNormal
+	}
+	out.WriteString(line)
+	return out.String(), nil
+}
+
+func advanceLexMode(line string, mode lexMode) lexMode {
+	if mode == lexNormal && strings.HasPrefix(strings.TrimLeft(line, " \t"), "*") {
+		return mode
+	}
+	for i := 0; i < len(line); i++ {
+		c := line[i]
+		switch mode {
+		case lexSingle:
+			if c == '\'' {
+				if i+1 < len(line) && line[i+1] == '\'' {
+					i++
+				} else {
+					mode = lexNormal
+				}
+			}
+		case lexBacktick:
+			if c == '`' {
+				if i+1 < len(line) && line[i+1] == '`' {
+					i++
+				} else {
+					mode = lexNormal
+				}
+			}
+		case lexTemplate:
+			if c == '\\' && i+1 < len(line) {
+				i++
+			} else if c == '|' {
+				mode = lexNormal
+			}
+		default:
+			if c == '"' {
+				return mode
+			}
+			if c == '\'' {
+				mode = lexSingle
+			} else if c == '`' {
+				mode = lexBacktick
+			} else if c == '|' {
+				mode = lexTemplate
+			}
+		}
+	}
+	return mode
+}
