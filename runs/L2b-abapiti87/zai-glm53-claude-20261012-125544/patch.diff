diff --git a/lint_debug.mjs b/lint_debug.mjs
new file mode 100644
index 0000000..b74c642
--- /dev/null
+++ b/lint_debug.mjs
@@ -0,0 +1,31 @@
+import core from "@abaplint/core";
+import {createRequire} from "module";
+import {readFileSync} from "fs";
+
+const require = createRequire(import.meta.url);
+const {Indent, IndentationConf} = {Indent: require("/work/node_modules/@abaplint/core/build/src/pretty_printer/indent.js").Indent};
+const {Registry, MemoryFile} = core;
+
+const path = process.argv[2];
+const reg = new Registry();
+reg.addFile(new MemoryFile(path.split("/").pop(), readFileSync(path, "utf8")));
+reg.parse();
+let file = null;
+for (const o of reg.getObjects()) {
+  for (const f of o.getABAPFiles()) {
+    if (f.getFilename() === path.split("/").pop()) file = f;
+  }
+}
+const expected = new Indent({}).getExpectedIndents(file);
+const lines = readFileSync(path, "utf8").split("\n");
+let k = 0;
+for (const st of file.getStatements()) {
+  const row = st.getFirstToken().getStart().getRow();
+  const col = st.getFirstToken().getStart().getCol();
+  const exp = expected[k++];
+  const note = exp === undefined || exp < 0 ? "" : `EXPECT ${exp - 1}`;
+  if (exp > 0 && exp !== col) {
+    console.log(`row ${row} col ${col} ${note}  <<< ${lines[row - 1].trim().slice(0, 80)}`);
+  }
+}
+console.log("statements:", k, "issues:", file.getStatements().length ? "" : "");
diff --git a/lint_scratch.mjs b/lint_scratch.mjs
new file mode 100644
index 0000000..192b7fa
--- /dev/null
+++ b/lint_scratch.mjs
@@ -0,0 +1,40 @@
+import core from "@abaplint/core";
+import {createRequire} from "module";
+import {readFileSync, readdirSync} from "fs";
+
+const require = createRequire(import.meta.url);
+const {Indentation, IndentationConf} = require("/work/node_modules/@abaplint/core/build/src/rules/indentation.js");
+const {Registry, MemoryFile} = core;
+
+const dir = "/tmp/lintcheck/src";
+const reg = new Registry();
+let n = 0;
+for (const f of readdirSync(dir)) {
+  if (!f.endsWith(".abap")) continue;
+  reg.addFile(new MemoryFile(f, readFileSync(dir + "/" + f, "utf8")));
+  n++;
+}
+console.log("files:", n);
+reg.parse();
+let syntax = 0;
+for (const issue of reg.findIssues()) {
+  // only the two configured rules run? findIssues runs all default rules; skip.
+}
+const issues = [];
+for (const o of reg.getObjects()) {
+  const rule = new Indentation();
+  rule.initialize(reg);
+  rule.setConfig(new IndentationConf()); // defaults: alignTryCatch=false
+  for (const file of o.getABAPFiles()) {
+    issues.push(...rule.runParsed(file, o));
+  }
+}
+console.log("indentation issues:", issues.length);
+const byKey = {};
+for (const i of issues) {
+  byKey[i.data.message] = (byKey[i.data.message] ?? 0) + 1;
+}
+console.log(byKey);
+for (const i of issues.slice(0, 40)) {
+  console.log(i.data.filename, i.data.start.row, i.data.message);
+}
