index 0000000..b497100
--- /dev/null
+++ b/hir/abap/format.go
@@ -0,0 +1,393 @@
+package abap
+
+import (
+	"fmt"
+	"strings"
+)
+
+// Generated ABAP carries abaplint's default indentation, the one its
+// indentation rule checks: two spaces per open block, closers and branches
+// back on their opener's column, sections and WHEN, CATCH and CLEANUP two
+// spaces inside the block they belong to, TRY bodies four spaces deep, class
+// headers, report events and forms in column zero. The emitter writes one
+// statement per line, but a statement may still span lines (wrapped, or
+// emitted as a comparison chain); every line of it keeps the statement's
+// indentation. Apparent keywords and statement-ending periods inside
+// literals, string templates and comments never count.
+
+// maxLine is the kernel's source line limit in bytes, leading spaces
+// included.
+const maxLine = 255
+
+// wrapScan is the last byte of an over-long line a split may still land on,
+// leaving room for the continuation's indentation.
+const wrapScan = 240
+
+// indent re-indents src with abaplint's default indentation style. Statement
+// text, literals and comment contents are left byte-identical; only leading
+// whitespace changes, and full-line * comments stay in column zero.
+func indent(src string) string {
+	if src == "" {
+		return ""
+	}
+	f := &formatter{}
+	lines := strings.Split(strings.TrimSuffix(src, "\n"), "\n")
+	for i, line := range lines {
+		lines[i] = f.line(line)
+	}
+	return strings.Join(lines, "\n") + "\n"
+}
+
+// Format indents like indent and additionally wraps lines longer than 255
+// bytes, splitting outside literals; the wrapped continuation keeps the
+// statement's indentation. A line without a split point is an error. Both
+// operations are idempotent.
+func Format(src string) (string, error) {
+	if src == "" {
+		return "", nil
+	}
+	var out []string
+	for _, line := range strings.Split(strings.TrimSuffix(indent(src), "\n"), "\n") {
+		prefix := line[:len(line)-len(strings.TrimLeft(line, " "))]
+		for len(line) > maxLine {
+			cut := splitPoint(line, len(prefix))
+			if cut < 0 {
+				return "", fmt.Errorf("unbreakable source line (%d bytes)", len(line))
+			}
+			out = append(out, line[:cut])
+			line = prefix + strings.TrimLeft(line[cut:], " ")
+		}
+		out = append(out, line)
+	}
+	return strings.Join(out, "\n") + "\n", nil
+}
+
+// formatter carries the indentation state across the statements of one
+// source: the running indent, the stack of TRY, CASE and CLASS blocks (their
+// closers, and WHEN and the sections, align against its top), and the
+// statement that is still open because its period has not been seen yet.
+type formatter struct {
+	indent     int
+	stack      []int
+	event      bool // the last column-zero header was a report event
+	open       bool // a statement continues from the previous line
+	stmtIndent int  // indentation of that statement
+	words      []string
+	lits       []byte // open ' ` | literals, { marks a template part
+}
+
+// line lays out one physical line. A line holds whatever its first statement
+// requires: the statement starting it, or the one continuing onto it.
+func (f *formatter) line(raw string) string {
+	body := strings.TrimLeft(raw, " \t")
+	switch {
+	case body == "":
+		return ""
+	case body[0] == '*':
+		return body // full-line comments stay in column zero
+	case body[0] == '"':
+		return strings.Repeat(" ", f.current()) + body
+	}
+	at := -1
+	if f.open {
+		at = f.stmtIndent
+	}
+	f.scan(body, &at)
+	return strings.Repeat(" ", max(at, 0)) + body
+}
+
+// current is the indentation a line without a statement of its own takes.
+func (f *formatter) current() int {
+	if f.open {
+		return f.stmtIndent
+	}
+	return f.indent
+}
+
+// scan walks one line, starting statements, ending them at their periods and
+// tracking literals, and records in *at the indentation the line takes.
+func (f *formatter) scan(s string, at *int) {
+	for i := 0; i < len(s); {
+		c := s[i]
+		if len(f.lits) > 0 {
+			i = f.literal(s, i)
+			continue
+		}
+		switch {
+		case c == ' ' || c == '\t':
+			i++
+		case c == '\'' || c == '`' || c == '|':
+			f.lits = append(f.lits, c)
+			i++
+		case c == '"':
+			return // line comment; an open statement continues below
+		case c == '.' && !decimalPoint(s, i):
+			f.end()
+			i++
+		case !f.open:
+			var used int
+			f.words, used = statementWords(s[i:])
+			f.open = true
+			f.before(f.words)
+			f.stmtIndent = f.indent
+			if *at < 0 {
+				*at = f.indent
+			}
+			i += used
+		default:
+			i++
+		}
+	}
+	f.lits = f.lits[:0] // literals never span lines
+}
+
+// literal consumes s[i] inside a literal: doubled quotes, template escapes
+// and the { } parts of a string template, where nested literals may appear.
+func (f *formatter) literal(s string, i int) int {
+	c := s[i]
+	switch f.lits[len(f.lits)-1] {
+	case '\'', '`':
+		if c == f.lits[len(f.lits)-1] {
+			if i+1 < len(s) && s[i+1] == c {
+				return i + 2 // escaped delimiter
+			}
+			f.lits = f.lits[:len(f.lits)-1]
+		}
+	case '|':
+		switch c {
+		case '\\':
+			return i + 2
+		case '{':
+			f.lits = append(f.lits, '{')
+		case '|':
+			f.lits = f.lits[:len(f.lits)-1]
+		}
+	case '{':
+		switch c {
+		case '\'', '`', '|':
+			f.lits = append(f.lits, c)
+		case '}':
+			f.lits = f.lits[:len(f.lits)-1]
+		}
+	}
+	return i + 1
+}
+
+// end closes the open statement and opens the blocks it starts.
+func (f *formatter) end() {
+	if !f.open {
+		return
+	}
+	f.open = false
+	f.after(f.words)
+}
+
+// statementWords reads the leading words of a statement in code context,
+// stopping at a literal, a comment or a period, so none of what they contain
+// can classify the statement.
+func statementWords(s string) ([]string, int) {
+	var words []string
+	i := 0
+	for len(words) < 4 {
+		for i < len(s) && (s[i] == ' ' || s[i] == '\t') {
+			i++
+		}
+		if i >= len(s) {
+			break
+		}
+		if c := s[i]; c == '\'' || c == '`' || c == '|' || c == '"' || c == '.' {
+			break
+		}
+		j := i
+		for j < len(s) && isWordByte(s[j]) {
+			j++
+		}
+		if j == i {
+			break
+		}
+		words = append(words, strings.ToUpper(s[i:j]))
+		i = j
+	}
+	return words, i
+}
+
+func isWordByte(c byte) bool {
+	return c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '-' || c == '_' || c == '/'
+}
+
+// decimalPoint reports whether the period at s[i] belongs to a decimal
+// literal (1.5) instead of ending the statement.
+func decimalPoint(s string, i int) bool {
+	if i == 0 || s[i-1] < '0' || s[i-1] > '9' {
+		return false
+	}
+	for j := i + 1; j < len(s); j++ {
+		if s[j] != ' ' && s[j] != '\t' {
+			return s[j] >= '0' && s[j] <= '9'
+		}
+	}
+	return false
+}
+
+// before sets the indentation the statement itself takes: closers and
+// branches return to their opener's column, report events, forms, modules
+// and class headers start in column zero, WHEN and the sections sit on the
+// top of the block stack, and CATCH and CLEANUP two spaces above it.
+func (f *formatter) before(w []string) {
+	if len(w) == 0 {
+		return
+	}
+	switch {
+	case closer(w[0]):
+		f.indent -= 2
+	case eventHeader(w):
+		f.indent = 0
+		f.event = true
+	case w[0] == "FORM" || w[0] == "MODULE" || classBlock(w) || w[0] == "INCLUDE" && f.event:
+		f.indent = 0
+		f.event = false
+	case w[0] == "CLEANUP" || w[0] == "CATCH" && !systemExceptions(w):
+		f.indent = f.peek() - 2
+	case sectionHeader(w) || w[0] == "WHEN":
+		f.indent = f.peek()
+	case w[0] == "ENDTRY":
+		f.indent = f.pop() - 4
+	case w[0] == "ENDCLASS" || w[0] == "ENDCASE":
+		f.indent = max(f.pop()-2, 0)
+	}
+	f.indent = max(f.indent, 0)
+}
+
+// after opens the blocks the finished statement starts: two spaces for
+// ordinary blocks and events, four and a stack entry for TRY, two and a
+// stack entry for CASE and the class headers whose closers align over them.
+func (f *formatter) after(w []string) {
+	if len(w) == 0 {
+		return
+	}
+	switch t := w[0]; {
+	case t == "TRY":
+		f.indent += 4
+		f.stack = append(f.stack, f.indent)
+	case classBlock(w) || t == "CASE":
+		f.indent += 2
+		f.stack = append(f.stack, f.indent)
+	case opener(w):
+		f.indent += 2
+	}
+}
+
+// opener reports whether the statement starts an ordinary two-space block.
+func opener(w []string) bool {
+	switch w[0] {
+	case "IF", "WHILE", "DO", "LOOP", "FORM", "METHOD", "ELSE", "ELSEIF",
+		"CATCH", "CLEANUP", "WHEN", "MODULE", "CHAIN", "FUNCTION", "DEFINE",
+		"EXEC", "TEST-INJECTION", "TEST-SEAM":
+		return true
+	case "INTERFACE":
+		return len(w) < 2 || w[1] != "DEFERRED" && w[1] != "LOAD"
+	case "SELECT":
+		return len(w) < 2 || w[1] != "SINGLE" // only loop selects open a block
+	case "AT":
+		return true // control-level AT; the event forms are covered below
+	}
+	return sectionHeader(w) || eventHeader(w)
+}
+
+// closer reports whether the statement ends an ordinary two-space block;
+// ELSE and ELSEIF return to their branch's column first.
+func closer(t string) bool {
+	switch t {
+	case "ENDIF", "ENDWHILE", "ENDMODULE", "ENDSELECT", "ENDMETHOD", "ENDCHAIN",
+		"ENDAT", "ELSE", "ENDEXEC", "END-OF-DEFINITION", "ENDLOOP",
+		"END-TEST-INJECTION", "END-TEST-SEAM", "ENDFORM", "ENDCATCH",
+		"ELSEIF", "ENDFUNCTION", "ENDINTERFACE", "ENDDO":
+		return true
+	}
+	return false
+}
+
+// eventHeader reports whether the statement is a report event: it starts in
+// column zero and its body is indented. The runtime GET statements (GET RUN
+// TIME FIELD and friends) are ordinary statements, not events.
+func eventHeader(w []string) bool {
+	switch w[0] {
+	case "START-OF-SELECTION", "INITIALIZATION", "TOP-OF-PAGE",
+		"END-OF-SELECTION", "LOAD-OF-PROGRAM":
+		return true
+	case "AT":
+		return len(w) > 1 && (w[1] == "SELECTION-SCREEN" || w[1] == "LINE-SELECTION" || w[1] == "USER-COMMAND" || strings.HasPrefix(w[1], "PF"))
+	case "GET":
+		if len(w) > 1 {
+			switch w[1] {
+			case "RUN", "PARAMETER", "BIT", "REFERENCE", "LOCALE", "BADI",
+				"CURSOR", "DATASET", "PERMISSIONS", "PF-STATUS", "PROPERTY", "TIME":
+				return false
+			}
+		}
+		return true
+	case "PROCESS":
+		return true
+	}
+	return false
+}
+
+// classBlock reports whether a CLASS header owns a block. Forward
+// declarations (DEFINITION DEFERRED, DEFINITION LOAD) do not open one.
+func classBlock(w []string) bool {
+	if w[0] != "CLASS" || len(w) < 3 || w[2] != "DEFINITION" && w[2] != "IMPLEMENTATION" {
+		return false
+	}
+	return !(w[2] == "DEFINITION" && len(w) > 3 && (w[3] == "DEFERRED" || w[3] == "LOAD"))
+}
+
+func sectionHeader(w []string) bool {
+	return len(w) > 1 && (w[0] == "PUBLIC" || w[0] == "PROTECTED" || w[0] == "PRIVATE") && w[1] == "SECTION"
+}
+
+func systemExceptions(w []string) bool {
+	return len(w) > 2 && w[1] == "SYSTEM" && w[2] == "EXCEPTIONS"
+}
+
+func (f *formatter) peek() int {
+	if len(f.stack) == 0 {
+		return 0
+	}
+	return f.stack[len(f.stack)-1]
+}
+
+func (f *formatter) pop() int {
+	top := f.peek()
+	if len(f.stack) > 0 {
+		f.stack = f.stack[:len(f.stack)-1]
+	}
+	return top
+}
+
+// splitPoint finds where an over-long line splits: the last space at or
+// before byte wrapScan that lies outside every literal and after the
+// indentation, or -1 if there is none. String templates stay whole; a
+// template cannot span lines.
+func splitPoint(line string, min int) int {
+	quote := byte(0)
+	cut := -1
+	for i := 0; i < len(line) && i <= wrapScan; i++ {
+		c := line[i]
+		if quote != 0 {
+			if quote == '|' && c == '\\' {
+				i++
+			} else if c == quote {
+				if quote != '|' && i+1 < len(line) && line[i+1] == quote {
+					i++
+				} else {
+					quote = 0
+				}
+			}
+		} else if c == '`' || c == '\'' || c == '|' {
+			quote = c
+		} else if c == ' ' && i >= min {
+			cut = i
+		}
+	}
+	return cut
+}
