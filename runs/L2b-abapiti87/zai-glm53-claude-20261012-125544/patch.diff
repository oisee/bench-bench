@@ -0,0 +1,41 @@
+package abap
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestScratchCorpusIdempotent(t *testing.T) {
+	root := "/tmp/abaplint-out/classes"
+	entries, err := os.ReadDir(root)
+	if err != nil {
+		t.Skip(err)
+	}
+	n := 0
+	for _, e := range entries {
+		src, err := os.ReadFile(filepath.Join(root, e.Name()))
+		if err != nil {
+			t.Fatal(err)
+		}
+		s := string(src)
+		if again := indent(s); again != s {
+			t.Fatalf("%s: indent not idempotent", e.Name())
+		}
+		f1, err := Format(s)
+		if err != nil {
+			t.Fatalf("%s: %v", e.Name(), err)
+		}
+		if f2, err := Format(f1); err != nil || f2 != f1 {
+			t.Fatalf("%s: Format not idempotent", e.Name())
+		}
+		for _, line := range strings.Split(s, "\n") {
+			if len(line) > 255 {
+				t.Fatalf("%s: line of %d bytes: %q", e.Name(), len(line), line)
+			}
+		}
+		n++
+	}
+	t.Logf("checked %d files", n)
+}
