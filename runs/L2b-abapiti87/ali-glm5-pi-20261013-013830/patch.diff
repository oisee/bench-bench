+package abap
+
+import (
+	"testing"
+)
+
+func TestIndentClass(t *testing.T) {
+	src := `CLASS z_test DEFINITION PUBLIC CREATE PUBLIC.
+PUBLIC SECTION.
+METHODS run RETURNING VALUE(result) TYPE i.
+PROTECTED SECTION.
+PRIVATE SECTION.
+ENDCLASS.
+CLASS z_test IMPLEMENTATION.
+METHOD run.
+DATA(t1) = CONV i( 3 ).
+result = t1.
+RETURN.
+ENDMETHOD.
+ENDCLASS.`
+
+	want := `CLASS z_test DEFINITION PUBLIC CREATE PUBLIC.
+  PUBLIC SECTION.
+    METHODS run RETURNING VALUE(result) TYPE i.
+  PROTECTED SECTION.
+  PRIVATE SECTION.
+ENDCLASS.
+CLASS z_test IMPLEMENTATION.
+  METHOD run.
+    DATA(t1) = CONV i( 3 ).
+    result = t1.
+    RETURN.
+  ENDMETHOD.
+ENDCLASS.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestIndentIf(t *testing.T) {
+	src := `IF x = 1.
+result = 1.
+ELSEIF x = 2.
+result = 2.
+ELSE.
+result = 3.
+ENDIF.`
+
+	want := `IF x = 1.
+  result = 1.
+ELSEIF x = 2.
+  result = 2.
+ELSE.
+  result = 3.
+ENDIF.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestIndentCase(t *testing.T) {
+	src := `CASE x.
+WHEN 1.
+result = 'one'.
+WHEN 2.
+result = 'two'.
+WHEN OTHERS.
+result = 'other'.
+ENDCASE.`
+
+	want := `CASE x.
+  WHEN 1.
+    result = 'one'.
+  WHEN 2.
+    result = 'two'.
+  WHEN OTHERS.
+    result = 'other'.
+ENDCASE.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestIndentTry(t *testing.T) {
+	src := `TRY.
+result = risky( ).
+CATCH cx_root.
+result = 0.
+ENDTRY.`
+
+	// TRY bodies sit four spaces inside TRY.
+	// CATCH sits two spaces inside TRY, with body two spaces further in.
+	want := `TRY.
+    result = risky( ).
+  CATCH cx_root.
+    result = 0.
+ENDTRY.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestIndentForm(t *testing.T) {
+	src := `FORM do_something.
+DATA x TYPE i.
+x = 1.
+ENDFORM.`
+
+	want := `FORM do_something.
+  DATA x TYPE i.
+  x = 1.
+ENDFORM.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestIndentWhile(t *testing.T) {
+	src := `WHILE x < 10.
+x = x + 1.
+ENDWHILE.`
+
+	want := `WHILE x < 10.
+  x = x + 1.
+ENDWHILE.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestFormatIdempotent(t *testing.T) {
+	src := `CLASS z_test DEFINITION PUBLIC CREATE PUBLIC.
+PUBLIC SECTION.
+METHODS run RETURNING VALUE(result) TYPE i.
+ENDCLASS.
+CLASS z_test IMPLEMENTATION.
+METHOD run.
+IF x = 1.
+result = 1.
+ENDIF.
+ENDMETHOD.
+ENDCLASS.`
+
+	// Format should be idempotent
+	first, err := Format(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := Format(first)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first != second {
+		t.Errorf("Format not idempotent:\nfirst:\n%s\nsecond:\n%s", first, second)
+	}
+}
+
+func TestIndentNestedIf(t *testing.T) {
+	src := `IF a = 1.
+IF b = 1.
+result = 1.
+ENDIF.
+result = 2.
+ENDIF.`
+
+	want := `IF a = 1.
+  IF b = 1.
+    result = 1.
+  ENDIF.
+  result = 2.
+ENDIF.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestIndentCleanup(t *testing.T) {
+	src := `TRY.
+result = risky( ).
+CLEANUP.
+result = 0.
+ENDTRY.`
+
+	want := `TRY.
+    result = risky( ).
+  CLEANUP.
+    result = 0.
+ENDTRY.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestIndentReportEvents(t *testing.T) {
+	src := `START-OF-SELECTION.
+DATA x TYPE i.
+x = 1.
+END-OF-SELECTION.
+x = 2.`
+
+	want := `START-OF-SELECTION.
+  DATA x TYPE i.
+  x = 1.
+END-OF-SELECTION.
+  x = 2.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestIndentInterface(t *testing.T) {
+	src := `INTERFACE z_test PUBLIC.
+METHODS run RETURNING VALUE(result) TYPE i.
+ENDINTERFACE.`
+
+	want := `INTERFACE z_test PUBLIC.
+  METHODS run RETURNING VALUE(result) TYPE i.
+ENDINTERFACE.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestIndentFullLineComment(t *testing.T) {
+	src := `IF x = 1.
+* This is a comment
+result = 1.
+ENDIF.`
+
+	want := `IF x = 1.
+* This is a comment
+  result = 1.
+ENDIF.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestIndentMultipleStatementsOnOneLine(t *testing.T) {
+	// Multiple statements on one line are not generated by the emitter,
+	// but we should handle them if they appear
+	src := `IF x = 1. result = 1. ENDIF.`
+
+	want := `IF x = 1. result = 1. ENDIF.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestIndentFormAfterForm(t *testing.T) {
+	// A subsequent form starts at column zero
+	src := `FORM first.
+DATA x TYPE i.
+ENDFORM.
+FORM second.
+DATA y TYPE i.
+ENDFORM.`
+
+	want := `FORM first.
+  DATA x TYPE i.
+ENDFORM.
+FORM second.
+  DATA y TYPE i.
+ENDFORM.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestIndentForwardDeclaration(t *testing.T) {
+	// Forward class declarations do not open blocks
+	src := `CLASS z_fwd DEFINITION DEFERRED.
+CLASS z_test DEFINITION PUBLIC CREATE PUBLIC.
+PUBLIC SECTION.
+ENDCLASS.`
+
+	want := `CLASS z_fwd DEFINITION DEFERRED.
+CLASS z_test DEFINITION PUBLIC CREATE PUBLIC.
+  PUBLIC SECTION.
+ENDCLASS.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestIndentRuntimeGet(t *testing.T) {
+	// Runtime GET statements (with -> or =>) do not open report events
+	src := `METHOD test.
+result = obj->get( ).
+ENDMETHOD.`
+
+	want := `METHOD test.
+    result = obj->get( ).
+  ENDMETHOD.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestIndentLoop(t *testing.T) {
+	src := `LOOP AT items INTO DATA(row).
+result = row-value.
+ENDLOOP.`
+
+	want := `LOOP AT items INTO DATA(row).
+  result = row-value.
+ENDLOOP.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestIndentDo(t *testing.T) {
+	src := `DO 10 TIMES.
+result = result + 1.
+ENDDO.`
+
+	want := `DO 10 TIMES.
+  result = result + 1.
+ENDDO.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestIndentNestedTry(t *testing.T) {
+	src := `TRY.
+TRY.
+result = inner( ).
+CATCH cx_inner.
+result = 0.
+ENDTRY.
+CATCH cx_outer.
+result = -1.
+ENDTRY.`
+
+	want := `TRY.
+    TRY.
+        result = inner( ).
+      CATCH cx_inner.
+        result = 0.
+    ENDTRY.
+  CATCH cx_outer.
+    result = -1.
+ENDTRY.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestIndentMethodWithInterfacePrefix(t *testing.T) {
+	// Method implementations with interface prefix (e.g., z_interface~method)
+	src := `CLASS z_test IMPLEMENTATION.
+METHOD z_interface~method.
+result = 1.
+ENDMETHOD.
+ENDCLASS.`
+
+	want := `CLASS z_test IMPLEMENTATION.
+  METHOD z_interface~method.
+    result = 1.
+  ENDMETHOD.
+ENDCLASS.
+`
+
+	got := indent(src)
+	if got != want {
+		t.Errorf("indent mismatch:\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestFormatLongLine(t *testing.T) {
+	// Lines exceeding 255 bytes should be wrapped
+	long := strings.Repeat("a ", 130) + "."
+	src := "result = " + long
+
+	formatted, err := Format(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	for _, line := range strings.Split(formatted, "\n") {
+		if len(line) > 255 {
+			t.Errorf("line exceeds 255 bytes: %d", len(line))
+		}
+	}
+}
+
+func TestIndentIdempotent(t *testing.T) {
+	src := `CLASS z_test DEFINITION PUBLIC CREATE PUBLIC.
+PUBLIC SECTION.
+METHODS run.
+ENDCLASS.
+CLASS z_test IMPLEMENTATION.
+METHOD run.
+IF x = 1.
+result = 1.
+ENDIF.
+ENDMETHOD.
+ENDCLASS.`
+
+	first := indent(src)
+	second := indent(first)
+	if first != second {
