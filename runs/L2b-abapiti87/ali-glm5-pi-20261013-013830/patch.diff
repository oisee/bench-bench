+package abap
+
+import (
+	"fmt"
+	"strings"
+)
+
+// indent applies abaplint's default indentation style to ABAP source code.
+// It uses two spaces per ordinary block level, including method bodies,
+// control flow, interfaces, and forms.
+func indent(src string) string {
+	lines := strings.Split(strings.TrimSuffix(src, "\n"), "\n")
+	var out strings.Builder
+
+	// Track current indentation level
+	indentLevel := 0
+
+	// Track context for special handling
+	inCase := false     // Inside CASE block
+	caseIndent := 0     // Indentation level when entering CASE
+	inTry := false      // Inside TRY block
+	tryIndent := 0      // Indentation level when entering TRY
+
+	// Track previous line's indentation for continuation lines
+	prevIndent := 0
+
+	for _, line := range lines {
+		trimmed := strings.TrimSpace(line)
+
+		// Skip empty lines
+		if trimmed == "" {
+			out.WriteString("\n")
+			continue
+		}
+
+		// Full-line * comments remain at column zero
+		if strings.HasPrefix(trimmed, "*") {
+			out.WriteString(line)
+			out.WriteString("\n")
+			continue
+		}
+
+		// Check if this is a continuation line (starts with OR, AND, etc. and doesn't end with .)
+		isContinuation := false
+		continuationStarts := []string{"OR ", "AND ", "OR(", "AND("}
+		for _, cs := range continuationStarts {
+			if strings.HasPrefix(trimmed, cs) || trimmed == "OR" || trimmed == "AND" {
+				isContinuation = true
+				break
+			}
+		}
+		// Also check for lines that start with closing parentheses/brackets but no period
+		if strings.HasPrefix(trimmed, ").") || strings.HasPrefix(trimmed, "].") || strings.HasPrefix(trimmed, ")") {
+			// These could be continuation endings
+			if !strings.HasSuffix(trimmed, ".") || trimmed == ")." {
+				isContinuation = true
+			}
+		}
+
+		// Calculate indentation for this line
+		currentIndent := indentLevel
+
+		// Continuation lines retain the previous line's indentation
+		if isContinuation {
+			currentIndent = prevIndent
+		} else {
+			// Handle block closers first
+			switch {
+			case strings.HasPrefix(trimmed, "ENDCLASS"):
+				// ENDCLASS always at column 0
+				currentIndent = 0
+				indentLevel = 0
+
+			case trimmed == "ENDINTERFACE." || strings.HasPrefix(trimmed, "ENDINTERFACE"):
+				currentIndent = 0
+				indentLevel = 0
+
+			case strings.HasPrefix(trimmed, "ENDMETHOD"):
+				// ENDMETHOD aligns with METHOD (2 spaces)
+				currentIndent = 2
+				indentLevel = 2
+
+			case trimmed == "ENDFORM.":
+				currentIndent = 0
+				indentLevel = 0
+
+			case strings.HasPrefix(trimmed, "ENDIF"):
+				if indentLevel >= 2 {
+					indentLevel -= 2
+				}
+				currentIndent = indentLevel
+
+			case strings.HasPrefix(trimmed, "ELSE.") || strings.HasPrefix(trimmed, "ELSEIF"):
+				// ELSE/ELSEIF aligns with IF
+				if indentLevel >= 2 {
+					currentIndent = indentLevel - 2
+				}
+
+			case strings.HasPrefix(trimmed, "ENDWHILE"):
+				if indentLevel >= 2 {
+					indentLevel -= 2
+				}
+				currentIndent = indentLevel
+
+			case strings.HasPrefix(trimmed, "ENDLOOP"):
+				if indentLevel >= 2 {
+					indentLevel -= 2
+				}
+				currentIndent = indentLevel
+
+			case strings.HasPrefix(trimmed, "ENDTRY"):
+				// ENDTRY aligns with TRY
+				currentIndent = tryIndent
+				indentLevel = tryIndent
+				inTry = false
+
+			case strings.HasPrefix(trimmed, "CATCH"):
+				// CATCH sits two spaces inside TRY
+				if inTry {
+					currentIndent = tryIndent + 2
+				}
+
+			case trimmed == "CLEANUP.":
+				// CLEANUP sits two spaces inside TRY
+				if inTry {
+					currentIndent = tryIndent + 2
+				}
+
+			case strings.HasPrefix(trimmed, "ENDCASE"):
+				// ENDCASE aligns with CASE
+				currentIndent = caseIndent
+				indentLevel = caseIndent
+				inCase = false
+
+			case strings.HasPrefix(trimmed, "WHEN"):
+				// WHEN sits two spaces inside CASE
+				if inCase {
+					currentIndent = caseIndent + 2
+				}
+
+			case strings.HasPrefix(trimmed, "ENDFORM"):
+				currentIndent = 0
+				indentLevel = 0
+			}
+
+			// Handle section declarations in class definitions
+			if trimmed == "PUBLIC SECTION." || trimmed == "PROTECTED SECTION." || trimmed == "PRIVATE SECTION." {
+				currentIndent = 2
+				indentLevel = 4 // Declarations inside section get 4 spaces
+			}
+
+			// Handle class definition start
+			if strings.HasPrefix(trimmed, "CLASS ") && strings.Contains(trimmed, "DEFINITION") && !strings.Contains(trimmed, "DEFERRED") {
+				currentIndent = 0
+				indentLevel = 0
+			}
+
+			// Handle interface definition start
+			if strings.HasPrefix(trimmed, "INTERFACE ") && !strings.HasPrefix(trimmed, "INTERFACES") {
+				currentIndent = 0
+				indentLevel = 2 // Interface members get 2 spaces
+			}
+
+			// Handle METHOD implementation (not declaration with METHODS)
+			if strings.HasPrefix(trimmed, "METHOD ") && !strings.HasPrefix(trimmed, "METHODS") {
+				currentIndent = 2
+				indentLevel = 4 // Body gets 4 spaces
+			}
+
+			// Handle FORM
+			if strings.HasPrefix(trimmed, "FORM ") {
+				currentIndent = 0
+				indentLevel = 2
+			}
+
+			// Handle report events
+			reportEvents := []string{"START-OF-SELECTION", "END-OF-SELECTION", "INITIALIZATION", "AT SELECTION-SCREEN", "TOP-OF-PAGE", "END-OF-PAGE"}
+			for _, evt := range reportEvents {
+				if trimmed == evt+"." || trimmed == evt || strings.HasPrefix(trimmed, evt+" ") {
+					currentIndent = 0
+					indentLevel = 2
+					break
+				}
+			}
+
+			// Handle GET as report event (but not runtime GET with -> or =>)
+			if strings.HasPrefix(trimmed, "GET ") && !strings.Contains(trimmed, "->") && !strings.Contains(trimmed, "=>") {
+				currentIndent = 0
+				indentLevel = 2
+			}
+
+			// Handle forward class declarations (don't open blocks)
+			if strings.HasPrefix(trimmed, "CLASS ") && strings.Contains(trimmed, "DEFINITION DEFERRED") {
+				currentIndent = 0
+				indentLevel = 0
+			}
+		}
+
+		// Write the line with current indentation
+		if currentIndent < 0 {
+			currentIndent = 0
+		}
+		out.WriteString(strings.Repeat(" ", currentIndent))
+		out.WriteString(trimmed)
+		out.WriteString("\n")
+
+		// Track this line's indentation for continuation lines
+		prevIndent = currentIndent
+
+		// Update indent level for following lines based on opening keywords
+		// Skip if this is a continuation line
+		if !isContinuation {
+			switch {
+			case (strings.HasPrefix(trimmed, "IF ") || trimmed == "IF.") && !strings.HasPrefix(trimmed, "INTERFACE"):
+				indentLevel += 2
+
+			case strings.HasPrefix(trimmed, "WHILE ") || trimmed == "WHILE.":
+				indentLevel += 2
+
+			case strings.HasPrefix(trimmed, "LOOP ") || trimmed == "LOOP." || strings.HasPrefix(trimmed, "LOOP AT"):
+				indentLevel += 2
+
+			case strings.HasPrefix(trimmed, "DO ") || trimmed == "DO.":
+				indentLevel += 2
+
+			case strings.HasPrefix(trimmed, "CASE ") || trimmed == "CASE.":
+				caseIndent = indentLevel
+				indentLevel += 4 // CASE adds 4: 2 for CASE block, 2 for WHEN level
+				inCase = true
+
+			case trimmed == "TRY." || trimmed == "TRY":
+				tryIndent = indentLevel
+				// TRY body sits 4 spaces inside TRY
+				indentLevel = tryIndent + 4
+				inTry = true
+
+			case strings.HasPrefix(trimmed, "CATCH"):
+				// After CATCH, body is 2 more indented than CATCH (which is at tryIndent + 2)
+				indentLevel = tryIndent + 4
+
+			case trimmed == "CLEANUP.":
+				// After CLEANUP, body is 2 more indented than CLEANUP (which is at tryIndent + 2)
+				indentLevel = tryIndent + 4
+
+			case strings.HasPrefix(trimmed, "WHEN") && inCase:
+				// WHEN body is 2 more than WHEN itself (WHEN is at caseIndent + 2)
+				indentLevel = caseIndent + 4
+			}
+		}
+	}
+
+	return out.String()
+}
+
+// Format applies indentation and line wrapping to ABAP source code.
+// Lines are wrapped to not exceed 255 bytes including leading spaces.
+// Both formatting operations are idempotent.
+func Format(src string) (string, error) {
+	// First apply indentation
+	indented := indent(src)
+
+	// Then apply line wrapping
+	var out strings.Builder
+	for _, line := range strings.Split(strings.TrimSuffix(indented, "\n"), "\n") {
+		leading := 0
+		for _, c := range line {
+			if c == ' ' {
+				leading++
+			} else {
+				break
+			}
+		}
+
+		for len(line) > 255 {
+			quote := byte(0)
+			cut := -1
+
+			// Find a safe cut point (at a space, outside of literals)
+			for i := 0; i < len(line) && i <= 240; i++ {
+				c := line[i]
+				if quote != 0 {
+					// Inside a literal
+					if quote == '|' && c == '\\' {
+						i++ // Skip escaped character in string template
+					} else if c == quote {
+						if quote != '|' && i+1 < len(line) && line[i+1] == quote {
+							i++ // Skip doubled quote in text literal
+						} else {
+							quote = 0 // End of literal
+						}
+					}
+				} else if c == '`' || c == '\'' || c == '|' {
+					quote = c // Start of literal
+				} else if c == ' ' {
+					cut = i // Safe cut point
+				}
+			}
+
+			if cut <= 0 {
+				return "", fmt.Errorf("unbreakable source line (%d bytes)", len(line))
+			}
+
+			// Write first part
+			out.WriteString(line[:cut] + "\n")
+
+			// Continue with remainder, preserving leading spaces
+			line = strings.Repeat(" ", leading) + strings.TrimLeft(line[cut:], " ")
+		}
+		out.WriteString(line + "\n")
+	}
+
+	return out.String(), nil
+}
