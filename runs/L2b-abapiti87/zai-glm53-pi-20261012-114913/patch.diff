+package abap
+
+import (
+	"strings"
+	"testing"
+)
+
+// Every case checks indentation (the wanted string), Format's line limit and
+// both operations' idempotency.
+func TestIndent(t *testing.T) {
+	cases := []struct{ name, in, want string }{
+		{
+			name: "class",
+			in: "CLASS cl DEFINITION PUBLIC.\n" +
+				"PUBLIC SECTION.\n" +
+				"METHODS m IMPORTING p TYPE i RETURNING VALUE(r) TYPE i.\n" +
+				"PROTECTED SECTION.\n" +
+				"PRIVATE SECTION.\n" +
+				"DATA f TYPE i.\n" +
+				"ENDCLASS.\n" +
+				"CLASS cl IMPLEMENTATION.\n" +
+				"METHOD m.\n" +
+				"DATA x TYPE i.\n" +
+				"IF p = 1.\n" +
+				"x = 1.\n" +
+				"ELSEIF p = 2.\n" +
+				"x = 2.\n" +
+				"ELSE.\n" +
+				"x = 3.\n" +
+				"ENDIF.\n" +
+				"r = x.\n" +
+				"ENDMETHOD.\n" +
+				"ENDCLASS.\n",
+			want: "CLASS cl DEFINITION PUBLIC.\n" +
+				"  PUBLIC SECTION.\n" +
+				"    METHODS m IMPORTING p TYPE i RETURNING VALUE(r) TYPE i.\n" +
+				"  PROTECTED SECTION.\n" +
+				"  PRIVATE SECTION.\n" +
+				"    DATA f TYPE i.\n" +
+				"ENDCLASS.\n" +
+				"CLASS cl IMPLEMENTATION.\n" +
+				"  METHOD m.\n" +
+				"    DATA x TYPE i.\n" +
+				"    IF p = 1.\n" +
+				"      x = 1.\n" +
+				"    ELSEIF p = 2.\n" +
+				"      x = 2.\n" +
+				"    ELSE.\n" +
+				"      x = 3.\n" +
+				"    ENDIF.\n" +
+				"    r = x.\n" +
+				"  ENDMETHOD.\n" +
+				"ENDCLASS.\n",
+		},
+		{
+			name: "interface",
+			in:   "INTERFACE if PUBLIC.\nMETHODS m RETURNING VALUE(r) TYPE i.\nENDINTERFACE.\n",
+			want: "INTERFACE if PUBLIC.\n  METHODS m RETURNING VALUE(r) TYPE i.\nENDINTERFACE.\n",
+		},
+		{
+			name: "case",
+			in: "METHOD m.\n" +
+				"CASE x.\n" +
+				"WHEN 1.\n" +
+				"y = 1.\n" +
+				"WHEN 2 OR 3.\n" +
+				"y = 2.\n" +
+				"WHEN OTHERS.\n" +
+				"y = 3.\n" +
+				"ENDCASE.\n" +
+				"ENDMETHOD.\n",
+			want: "METHOD m.\n" +
+				"  CASE x.\n" +
+				"    WHEN 1.\n" +
+				"      y = 1.\n" +
+				"    WHEN 2 OR 3.\n" +
+				"      y = 2.\n" +
+				"    WHEN OTHERS.\n" +
+				"      y = 3.\n" +
+				"  ENDCASE.\n" +
+				"ENDMETHOD.\n",
+		},
+		{
+			name: "try",
+			in: "METHOD m.\n" +
+				"TRY.\n" +
+				"a = 1.\n" +
+				"CATCH cx_root INTO e.\n" +
+				"a = 2.\n" +
+				"CLEANUP.\n" +
+				"a = 3.\n" +
+				"ENDTRY.\n" +
+				"ENDMETHOD.\n",
+			want: "METHOD m.\n" +
+				"  TRY.\n" +
+				"      a = 1.\n" +
+				"    CATCH cx_root INTO e.\n" +
+				"      a = 2.\n" +
+				"    CLEANUP.\n" +
+				"      a = 3.\n" +
+				"  ENDTRY.\n" +
+				"ENDMETHOD.\n",
+		},
+		{
+			name: "report and form",
+			in: "REPORT zprog LINE-SIZE 1023.\n" +
+				"PARAMETERS p TYPE i.\n" +
+				"DATA x TYPE i.\n" +
+				"START-OF-SELECTION.\n" +
+				"GET RUN TIME FIELD t.\n" +
+				"IF p = 1.\n" +
+				"x = 1.\n" +
+				"ENDIF.\n" +
+				"FORM f USING p TYPE i.\n" +
+				"x = p.\n" +
+				"ENDFORM.\n",
+			want: "REPORT zprog LINE-SIZE 1023.\n" +
+				"PARAMETERS p TYPE i.\n" +
+				"DATA x TYPE i.\n" +
+				"START-OF-SELECTION.\n" +
+				"  GET RUN TIME FIELD t.\n" +
+				"  IF p = 1.\n" +
+				"    x = 1.\n" +
+				"  ENDIF.\n" +
+				"FORM f USING p TYPE i.\n" +
+				"  x = p.\n" +
+				"ENDFORM.\n",
+		},
+		{
+			name: "deferred and loops",
+			in: "CLASS cl DEFINITION DEFERRED.\n" +
+				"DO 3 TIMES.\n" +
+				"WHILE x < 4.\n" +
+				"x = x + 1.\n" +
+				"ENDWHILE.\n" +
+				"ENDDO.\n" +
+				"LOOP AT t INTO row.\n" +
+				"APPEND row TO out.\n" +
+				"ENDLOOP.\n",
+			want: "CLASS cl DEFINITION DEFERRED.\n" +
+				"DO 3 TIMES.\n" +
+				"  WHILE x < 4.\n" +
+				"    x = x + 1.\n" +
+				"  ENDWHILE.\n" +
+				"ENDDO.\n" +
+				"LOOP AT t INTO row.\n" +
+				"  APPEND row TO out.\n" +
+				"ENDLOOP.\n",
+		},
+		{
+			name: "continuation lines",
+			in: "METHOD m.\n" +
+				"ok = xsdbool( a = 1\n" +
+				"OR a = 2\n" +
+				"OR a = 3 ).\n" +
+				"ENDMETHOD.\n",
+			want: "METHOD m.\n" +
+				"  ok = xsdbool( a = 1\n" +
+				"  OR a = 2\n" +
+				"  OR a = 3 ).\n" +
+				"ENDMETHOD.\n",
+		},
+		{
+			name: "several statements per line",
+			in: "IF a = 1. b = 2. ENDIF.\n" +
+				"c = 3.\n",
+			want: "IF a = 1. b = 2. ENDIF.\n" +
+				"c = 3.\n",
+		},
+		{
+			name: "statements after a period mid-line",
+			in: "METHOD m.\n" +
+				"IF a = 1. b = 2.\n" +
+				"ENDIF.\n" +
+				"c = 3.\n" +
+				"ENDMETHOD.\n",
+			want: "METHOD m.\n" +
+				"  IF a = 1. b = 2.\n" +
+				"  ENDIF.\n" +
+				"  c = 3.\n" +
+				"ENDMETHOD.\n",
+		},
+		{
+			name: "literals and comments",
+			in: "* comment with METHOD and ENDCLASS. at column zero\n" +
+				"METHOD m.\n" +
+				"a = 'ENDIF. WHEN'.\n" +
+				"b = `ENDCLASS.`.\n" +
+				"c = |{ a } and ENDTRY. { b }|.\n" +
+				"d = 'it''s a period. inside'.\n" +
+				"\" comment line with IF. and ENDIF.\n" +
+				"e = 1. \" trailing comment with CASE.\n" +
+				"ENDMETHOD.\n",
+			want: "* comment with METHOD and ENDCLASS. at column zero\n" +
+				"METHOD m.\n" +
+				"  a = 'ENDIF. WHEN'.\n" +
+				"  b = `ENDCLASS.`.\n" +
+				"  c = |{ a } and ENDTRY. { b }|.\n" +
+				"  d = 'it''s a period. inside'.\n" +
+				"\" comment line with IF. and ENDIF.\n" +
+				"  e = 1. \" trailing comment with CASE.\n" +
+				"ENDMETHOD.\n",
+		},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			got := indent(c.in)
+			if got != c.want {
+				t.Fatalf("indent:\n%s\nwant:\n%s", got, c.want)
+			}
+			if again := indent(got); again != got {
+				t.Fatalf("indent not idempotent:\n%s", again)
+			}
+			formatted, err := Format(c.in)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if again, err := Format(formatted); err != nil || again != formatted {
+				t.Fatalf("Format not idempotent: %v", err)
+			}
+			for _, line := range strings.Split(formatted, "\n") {
+				if len(line) > 255 {
+					t.Fatalf("line of %d bytes: %s", len(line), line)
+				}
+			}
+		})
+	}
+}
+
+func TestFormatWrapsIndentedLines(t *testing.T) {
+	src := "METHOD m.\n" +
+		strings.Repeat("IF a = 1.\n", 1) +
+		"doit( " + strings.TrimSpace(strings.Repeat("x ", 140)) + " ).\n" +
+		"ENDIF.\n" +
+		"ENDMETHOD.\n"
+	out, err := Format(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	lines := strings.Split(strings.TrimSuffix(out, "\n"), "\n")
+	var pieces []string
+	for i, line := range lines {
+		if len(line) > 255 {
+			t.Fatalf("line %d has %d bytes", i, len(line))
+		}
+		if strings.Contains(line, "doit(") || strings.HasPrefix(strings.TrimLeft(line, " "), "x ") {
+			pieces = append(pieces, line)
+		}
+	}
+	if len(pieces) < 2 {
+		t.Fatalf("statement was not wrapped:\n%s", out)
+	}
+	for _, p := range pieces {
+		if !strings.HasPrefix(p, "    ") {
+			t.Fatalf("wrapped line lost the statement's indentation: %q", p)
+		}
+	}
+	if again, err := Format(out); err != nil || again != out {
+		t.Fatalf("Format not idempotent: %v", err)
+	}
+}
+
+func TestFormatRejectsUnbreakableLine(t *testing.T) {
+	if _, err := Format(strings.Repeat("x", 300) + "\n"); err == nil {
+		t.Fatal("expected unbreakable line error")
+	}
+}
+
+// The emitted fixtures of the package must be indented, wrapped and stable
+// under both formatting operations.
+func TestFormatEmittedFiles(t *testing.T) {
+	for _, f := range fixtures() {
+		files, err := Emit(f.p)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for name, src := range files {
+			again, err := Format(src)
+			if err != nil {
+				t.Fatalf("%s: %v", name, err)
+			}
+			if again != src {
+				t.Fatalf("%s: emitted source is not a fixed point of Format", name)
+			}
+			if reindented := indent(src); reindented != src {
+				t.Fatalf("%s: emitted source is not a fixed point of indent", name)
+			}
+		}
+	}
+}
