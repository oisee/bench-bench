diff --git a/hir/abap/format.go b/hir/abap/format.go
new file mode 100644
index 0000000..988a6d6
--- /dev/null
+++ b/hir/abap/format.go
@@ -0,0 +1,411 @@
+package abap
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// Generated ABAP is indented with one fixed style, abaplint's default
+// indentation: two spaces per ordinary block level, closing statements
+// aligned with their openers and alternative branches (ELSE, ELSEIF, WHEN,
+// CATCH, CLEANUP) with their opening branch. Class headers, report event
+// headers and forms sit at column zero. The indentation follows from the
+// statement structure alone: keywords and statement-ending periods inside
+// literals, string templates and comments are ignored, comment lines keep
+// their position, and lines that only continue a statement keep the
+// statement's indentation. There are no configuration options.
+const (
+	spacesPerLevel = 2
+	maxLineBytes   = 255
+	// maxIndentWords bounds how many leading words of a statement classify it.
+	maxIndentWords = 8
+)
+
+// indent re-indents ABAP source with two spaces per block level.
+func indent(src string) string {
+	lines := strings.Split(src, "\n")
+	stmts := scanStatements(lines)
+	levels := blockLevels(stmts)
+	target := make([]int, len(lines))
+	for i := range target {
+		target[i] = -1
+	}
+	// A line is indented like the first statement starting on it; statements
+	// that only follow another statement on the same line stay with it.
+	for k, s := range stmts {
+		if s.lineStart {
+			target[s.startLine] = levels[k]
+		}
+	}
+	// Continuation lines of a multiline statement keep its indentation.
+	for k, s := range stmts {
+		for i := s.startLine + 1; i <= s.endLine && i < len(lines); i++ {
+			if target[i] == -1 && isCodeLine(lines[i]) {
+				target[i] = levels[k]
+			}
+		}
+	}
+	for i, line := range lines {
+		if target[i] >= 1 {
+			lines[i] = strings.Repeat(" ", target[i]-1) + strings.TrimLeft(line, " \t")
+		}
+	}
+	return strings.Join(lines, "\n")
+}
+
+// Format indents src and wraps its lines so that none exceeds 255 bytes,
+// leading spaces included. Wrapped lines keep their statement's
+// indentation. Format is idempotent.
+func Format(src string) (string, error) {
+	return wrapLines(indent(src))
+}
+
+// isCodeLine reports whether a line holds ABAP code: not blank and not a
+// comment. Full-line * comments start in the first column; " comments may
+// be indented. Comment and blank lines keep their position.
+func isCodeLine(line string) bool {
+	t := strings.TrimLeft(line, " \t")
+	return t != "" && !strings.HasPrefix(t, "*") && !strings.HasPrefix(t, "\"")
+}
+
+// abapStmt is one statement: the line its first token sits on, the line its
+// terminating period sits on, whether that token is the line's first, and
+// the statement's leading words (upper case, without trailing separators).
+type abapStmt struct {
+	startLine, endLine int
+	lineStart          bool
+	words              []string
+}
+
+// scanStatements splits source lines into statements. Periods inside
+// literals (”, “, |...| with escaped delimiters) and comments never end a
+// statement; a statement without a period runs to the last line.
+func scanStatements(lines []string) []abapStmt {
+	var stmts []abapStmt
+	var cur *abapStmt
+	terminate := func(line int) {
+		if cur == nil {
+			return
+		}
+		cur.endLine = line
+		stmts = append(stmts, *cur)
+		cur = nil
+	}
+	for i, line := range lines {
+		if strings.HasPrefix(line, "*") { // full-line comment
+			continue
+		}
+		j, token := 0, false
+		for j < len(line) {
+			c := line[j]
+			switch {
+			case c == ' ' || c == '\t' || c == '\r':
+				j++
+			case c == '"': // comment to end of line
+				j = len(line)
+			case c == '\'' || c == '`' || c == '|':
+				j = skipLiteral(line, j)
+				if cur == nil {
+					cur = &abapStmt{startLine: i, lineStart: !token}
+				}
+				token = true
+			case c == '.':
+				j++
+				terminate(i)
+				token = true
+			default:
+				start := j
+				for j < len(line) {
+					ch := line[j]
+					if ch == ' ' || ch == '\t' || ch == '\r' || ch == '"' || ch == '\'' || ch == '`' || ch == '|' || ch == '.' {
+						break
+					}
+					j++
+				}
+				if cur == nil {
+					cur = &abapStmt{startLine: i, lineStart: !token}
+				}
+				if len(cur.words) < maxIndentWords {
+					word := strings.ToUpper(strings.TrimRight(line[start:j], ",:;"))
+					cur.words = append(cur.words, word)
+				}
+				token = true
+			}
+		}
+	}
+	terminate(len(lines) - 1)
+	return stmts
+}
+
+// skipLiteral returns the index after the literal starting at j: the quote
+// character's escape rules (doubled delimiters, backslash escapes in string
+// templates) are respected.
+func skipLiteral(line string, j int) int {
+	quote := line[j]
+	j++
+	for j < len(line) {
+		c := line[j]
+		if quote == '|' && c == '\\' {
+			j += 2
+			continue
+		}
+		if c == quote {
+			if quote != '|' && j+1 < len(line) && line[j+1] == quote {
+				j += 2 // escaped delimiter
+				continue
+			}
+			return j + 1
+		}
+		j++
+	}
+	return j
+}
+
+type stmtKind int
+
+const (
+	kindPlain      stmtKind = iota // no indentation change
+	kindOpen                       // opens a block: IF, DO, LOOP, METHOD, ...
+	kindEnder                      // closes a block: ENDIF, ENDLOOP, ...
+	kindElse                       // alternative branch: closes, then opens again
+	kindEvent                      // report event header: level one, opens a block
+	kindReset                      // FORM, MODULE: level one, opens a block
+	kindClassBlock                 // CLASS ...: level one, opens a stacked block
+	kindInclude                    // INCLUDE after an event: level one
+	kindWhen                       // WHEN, sections: aligned in the enclosing block
+	kindCatch                      // CATCH, CLEANUP: aligned inside TRY, opens a block
+	kindTry                        // TRY: body four spaces further in
+	kindPush                       // CASE: opens a block on the stack
+	kindEndBlock                   // ENDCLASS, ENDCASE: closes a stacked block
+	kindEndTry                     // ENDTRY: closes a TRY block
+)
+
+// blockLevels computes the indentation level (1 = column zero) of every
+// statement, mirroring abaplint's default indentation.
+func blockLevels(stmts []abapStmt) []int {
+	levels := make([]int, len(stmts))
+	level := 1
+	parentIsEvent := false
+	var stack []int
+	peek := func() int {
+		if len(stack) == 0 {
+			return level
+		}
+		return stack[len(stack)-1]
+	}
+	pop := func() int {
+		if len(stack) == 0 {
+			return level
+		}
+		top := stack[len(stack)-1]
+		stack = stack[:len(stack)-1]
+		return top
+	}
+	for k, s := range stmts {
+		kind := classify(s.words)
+		switch kind {
+		case kindEnder, kindElse:
+			level -= spacesPerLevel
+		case kindEvent:
+			level, parentIsEvent = 1, true
+		case kindReset, kindClassBlock:
+			level, parentIsEvent = 1, false
+		case kindInclude:
+			if parentIsEvent {
+				level, parentIsEvent = 1, false
+			}
+		case kindWhen:
+			level = peek()
+		case kindCatch:
+			if len(stack) > 0 {
+				level = peek() - spacesPerLevel
+			}
+		case kindEndTry:
+			level = pop() - 2*spacesPerLevel
+		case kindEndBlock:
+			level = pop() - spacesPerLevel
+		}
+		if level < 1 {
+			level = 1
+		}
+		levels[k] = level
+		switch kind {
+		case kindTry: // TRY bodies sit four spaces inside TRY
+			level += 2 * spacesPerLevel
+			stack = append(stack, level)
+		case kindPush, kindClassBlock:
+			level += spacesPerLevel
+			stack = append(stack, level)
+		case kindOpen, kindWhen, kindCatch, kindEvent, kindReset, kindElse:
+			level += spacesPerLevel
+		}
+	}
+	return levels
+}
+
+// classify maps a statement's leading words to its indentation behaviour.
+func classify(words []string) stmtKind {
+	first, second, third, fourth := wordAt(words, 0), wordAt(words, 1), wordAt(words, 2), wordAt(words, 3)
+	switch first {
+	case "ENDIF", "ENDWHILE", "ENDMODULE", "ENDSELECT", "ENDMETHOD", "ENDCHAIN",
+		"ENDAT", "ENDEXEC", "END-OF-DEFINITION", "ENDLOOP", "END-TEST-INJECTION",
+		"END-TEST-SEAM", "ENDFORM", "ENDCATCH", "ENDFUNCTION", "ENDDO", "ENDINTERFACE":
+		return kindEnder
+	case "ELSE", "ELSEIF":
+		return kindElse
+	case "ENDCLASS", "ENDCASE":
+		return kindEndBlock
+	case "ENDTRY":
+		return kindEndTry
+	case "TRY":
+		return kindTry
+	case "CASE": // CASE and CASE TYPE share one shape
+		return kindPush
+	case "CLASS":
+		switch {
+		case third == "DEFINITION" && fourth == "DEFERRED":
+			return kindPlain // forward declaration, no block
+		case third == "DEFINITION", third == "IMPLEMENTATION":
+			return kindClassBlock
+		}
+		return kindPlain
+	case "FORM", "MODULE":
+		return kindReset
+	case "INTERFACE":
+		return kindOpen
+	case "WHEN": // WHEN, WHEN OTHERS, WHEN TYPE
+		return kindWhen
+	case "PUBLIC", "PROTECTED", "PRIVATE":
+		if second == "SECTION" {
+			return kindWhen
+		}
+		return kindPlain
+	case "CATCH":
+		if second == "SYSTEM" {
+			return kindOpen // CATCH SYSTEM EXCEPTIONS
+		}
+		return kindCatch
+	case "CLEANUP":
+		return kindCatch
+	case "AT":
+		switch {
+		case second == "SELECTION-SCREEN", second == "LINE-SELECTION", second == "USER-COMMAND", strings.HasPrefix(second, "PF"):
+			return kindEvent
+		}
+		return kindOpen // AT FIRST/LAST/NEW/END OF/GROUP inside loops
+	case "GET":
+		if second != "" && !runtimeGet(second) {
+			return kindEvent // GET <node> report event
+		}
+		return kindPlain
+	case "PROCESS", "START-OF-SELECTION", "END-OF-SELECTION", "TOP-OF-PAGE",
+		"INITIALIZATION", "LOAD-OF-PROGRAM":
+		return kindEvent
+	case "INCLUDE":
+		return kindInclude
+	case "SELECT":
+		if selectOpensLoop(words) {
+			return kindOpen
+		}
+		return kindPlain
+	case "IF", "WHILE", "DO", "LOOP", "METHOD", "FUNCTION", "EXEC", "DEFINE",
+		"CHAIN", "TEST-INJECTION", "TEST-SEAM":
+		return kindOpen
+	}
+	return kindPlain
+}
+
+// runtimeGet reports whether the word after GET starts a runtime statement
+// (GET RUN TIME FIELD, GET PARAMETER, ...) instead of a report event.
+func runtimeGet(word string) bool {
+	switch word {
+	case "RUN", "BIT", "PARAMETER", "PARAMETERS", "REFERENCE", "CURSOR",
+		"LOCALE", "PF-STATUS", "TIME", "BADI", "DATASET":
+		return true
+	}
+	return false
+}
+
+// selectOpensLoop separates SELECT ... ENDSELECT loops from single-row and
+// aggregate reads, which close with a period only.
+func selectOpensLoop(words []string) bool {
+	for _, w := range words[1:] {
+		if w == "SINGLE" { // SELECT SINGLE reads one row, no ENDSELECT
+			return false
+		}
+		for _, agg := range []string{"COUNT(", "SUM(", "MIN(", "MAX(", "AVG("} {
+			if strings.HasPrefix(w, agg) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func wordAt(words []string, i int) string {
+	if i < len(words) && words[i] != "" {
+		return words[i]
+	}
+	return ""
+}
+
+// wrapLines splits long lines at spaces outside literals and comments. The
+// pieces keep the line's indentation, which is the statement's, and no line
+// exceeds 255 bytes, leading spaces included. Long strings are already
+// chunked; full-line comments are left alone.
+func wrapLines(src string) (string, error) {
+	var out strings.Builder
+	for _, line := range strings.Split(strings.TrimSuffix(src, "\n"), "\n") {
+		if strings.HasPrefix(line, "*") { // comment: never split
+			out.WriteString(line + "\n")
+			continue
+		}
+		for len(line) > maxLineBytes {
+			pad := len(line) - len(strings.TrimLeft(line, " "))
+			content := line[pad:]
+			cut := wrapCut(content, maxLineBytes-pad)
+			if cut <= 0 {
+				return "", fmt.Errorf("unbreakable source line (%s bytes)", strconv.Itoa(len(line)))
+			}
+			out.WriteString(line[:pad+cut] + "\n")
+			line = strings.Repeat(" ", pad) + strings.TrimLeft(content[cut:], " ")
+		}
+		out.WriteString(line + "\n")
+	}
+	return out.String(), nil
+}
+
+// wrapCut returns the position of the last space at or before budget that is
+// outside literals and comments and not followed by a comment or a
+// multiplication (a continuation line must not look like a * comment).
+func wrapCut(content string, budget int) int {
+	cut := -1
+	quote := byte(0)
+	for i := 0; i < len(content) && i <= budget; i++ {
+		c := content[i]
+		if quote != 0 {
+			if quote == '|' && c == '\\' {
+				i++
+			} else if c == quote {
+				if quote != '|' && i+1 < len(content) && content[i+1] == quote {
+					i++
+				} else {
+					quote = 0
+				}
+			}
+			continue
+		}
+		switch c {
+		case '`', '\'', '|':
+			quote = c
+		case '"':
+			return cut // comment: no cut beyond here
+		case ' ':
+			if j := i + 1; j < len(content) && content[j] != '*' {
+				cut = i
+			}
+		}
+	}
+	return cut
+}
