new file mode 100644
index 0000000..f3edb90
--- /dev/null
+++ b/tsfront/format.go
@@ -0,0 +1,15 @@
+package tsfront
+
+import "github.com/oisee/abapiti/hir/abap"
+
+// formatABAP passes generated driver and report sources through the ABAP
+// backend's formatter, so the auxiliary code around the translated classes
+// carries the same fixed indentation and line wrapping. A source line too
+// long to break keeps the source unchanged: it is still valid ABAP.
+func formatABAP(src string) string {
+	out, err := abap.Format(src)
+	if err != nil {
+		return src
+	}
+	return out
+}
