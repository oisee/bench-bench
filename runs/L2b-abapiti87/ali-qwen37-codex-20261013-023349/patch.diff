index 0000000..56a4403
--- /dev/null
+++ b/hir/abap/indent.go
@@ -0,0 +1,163 @@
+// Package abap indentation and formatting.
+package abap
+
+import (
+	"fmt"
+	"strings"
+)
+
+// Indent applies consistent indentation to ABAP source following abaplint's
+// default style: two spaces per block level.
+func Indent(src string) string {
+	var out strings.Builder
+	lines := strings.Split(strings.TrimSuffix(src, "\n"), "\n")
+	
+	indentLevel := 0
+	inClassDef := false
+	inClassImpl := false
+	inCase := false
+	inTry := false
+	
+	for _, line := range lines {
+		trimmed := strings.TrimSpace(line)
+		
+		// Skip empty lines
+		if trimmed == "" {
+			out.WriteString("\n")
+			continue
+		}
+		
+		// Full-line comments stay at column zero
+		if strings.HasPrefix(trimmed, "*") {
+			out.WriteString(trimmed + "\n")
+			continue
+		}
+		
+		// Check if this line closes a block (decrease indent before writing)
+		upper := strings.ToUpper(trimmed)
+		
+		// ENDCLASS closes class definition or implementation
+		if strings.HasPrefix(upper, "ENDCLASS") {
+			inClassDef = false
+			inClassImpl = false
+			indentLevel = 0
+		} else if strings.HasPrefix(upper, "ENDMETHOD") {
+			indentLevel = 1 // Back to class implementation level (METHOD statements)
+		} else if strings.HasPrefix(upper, "ENDIF") {
+			indentLevel--
+		} else if strings.HasPrefix(upper, "ENDCASE") {
+			inCase = false
+			indentLevel--
+		} else if strings.HasPrefix(upper, "ENDTRY") {
+			inTry = false
+			indentLevel--
+		} else if strings.HasPrefix(upper, "ENDLOOP") || strings.HasPrefix(upper, "ENDDO") || strings.HasPrefix(upper, "ENDWHILE") {
+			indentLevel--
+		} else if strings.HasPrefix(upper, "ELSE") || strings.HasPrefix(upper, "ELSEIF") {
+			indentLevel--
+		} else if strings.HasPrefix(upper, "WHEN") {
+			indentLevel--
+		} else if strings.HasPrefix(upper, "CATCH") || strings.HasPrefix(upper, "CLEANUP") {
+			indentLevel--
+		} else if strings.HasPrefix(upper, "PUBLIC SECTION") || strings.HasPrefix(upper, "PROTECTED SECTION") || strings.HasPrefix(upper, "PRIVATE SECTION") {
+			if inClassDef {
+				indentLevel = 1
+			}
+		}
+		
+		// Write the line with current indentation
+		out.WriteString(strings.Repeat("  ", indentLevel) + trimmed + "\n")
+		
+		// Check if this line opens a block (increase indent after writing)
+		if strings.HasPrefix(upper, "CLASS ") && strings.Contains(upper, "DEFINITION") {
+			inClassDef = true
+		} else if strings.HasPrefix(upper, "CLASS ") && strings.Contains(upper, "IMPLEMENTATION") {
+			inClassImpl = true
+			indentLevel = 1 // METHOD statements are at 2 spaces
+		} else if inClassDef && (strings.HasPrefix(upper, "PUBLIC SECTION") || strings.HasPrefix(upper, "PROTECTED SECTION") || strings.HasPrefix(upper, "PRIVATE SECTION")) {
+			indentLevel = 2
+		} else if inClassImpl && strings.HasPrefix(upper, "METHOD ") {
+			indentLevel = 2 // Method body has 4 spaces
+		} else if strings.HasPrefix(upper, "IF ") || strings.HasPrefix(upper, "IF(") {
+			indentLevel++
+		} else if strings.HasPrefix(upper, "CASE ") {
+			inCase = true
+			indentLevel++
+		} else if (strings.HasPrefix(upper, "TRY") || strings.HasPrefix(upper, "TRY.")) && !strings.HasPrefix(upper, "TRY ") {
+			inTry = true
+			indentLevel++
+		} else if strings.HasPrefix(upper, "LOOP ") || strings.HasPrefix(upper, "DO ") || strings.HasPrefix(upper, "WHILE ") {
+			indentLevel++
+		} else if strings.HasPrefix(upper, "ELSE") || strings.HasPrefix(upper, "ELSEIF") {
+			indentLevel++
+		} else if inCase && strings.HasPrefix(upper, "WHEN") {
+			indentLevel++
+		} else if inTry && (strings.HasPrefix(upper, "CATCH") || strings.HasPrefix(upper, "CLEANUP")) {
+			indentLevel++
+		}
+	}
+	
+	return out.String()
+}
+
+// Format applies indentation and line wrapping to ABAP source.
+// Wrapped lines retain their statement's indentation and do not exceed 255 bytes.
+// Both operations are idempotent.
+func Format(src string) (string, error) {
+	indented := Indent(src)
+	return wrapLines(indented)
+}
+
+// wrapLines splits lines that exceed 255 bytes, preserving indentation.
+func wrapLines(src string) (string, error) {
+	var out strings.Builder
+	lines := strings.Split(strings.TrimSuffix(src, "\n"), "\n")
+	
+	for _, line := range lines {
+		for len([]byte(line)) > 255 {
+			// Find the indentation
+			indent := ""
+			for _, ch := range line {
+				if ch == ' ' {
+					indent += " "
+				} else {
+					break
+				}
+			}
+			
+			// Find a break point outside literals
+			quote := byte(0)
+			cut := -1
+			maxCut := 240 - len([]byte(indent))
+			
+			for i := len(indent); i < len(line) && i <= len(indent)+maxCut; i++ {
+				c := line[i]
+				if quote != 0 {
+					if quote == '|' && c == '\\' {
+						i++
+					} else if c == quote {
+						if quote != '|' && i+1 < len(line) && line[i+1] == quote {
+							i++
+						} else {
+							quote = 0
+						}
+					}
+				} else if c == '`' || c == '\'' || c == '|' {
+					quote = c
+				} else if c == ' ' {
+					cut = i
+				}
+			}
+			
+			if cut <= 0 {
+				return "", fmt.Errorf("unbreakable source line (%d bytes)", len([]byte(line)))
+			}
+			
+			out.WriteString(line[:cut] + "\n")
+			line = indent + strings.TrimLeft(line[cut:], " ")
+		}
+		out.WriteString(line + "\n")
+	}
+	
+	return out.String(), nil
+}
