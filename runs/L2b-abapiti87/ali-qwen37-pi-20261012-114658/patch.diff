diff --git a/hir/abap/indent.go b/hir/abap/indent.go
new file mode 100644
index 0000000..d671315
--- /dev/null
+++ b/hir/abap/indent.go
@@ -0,0 +1,325 @@
+package abap
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// indent applies consistent ABAP indentation to src following abaplint's
+// default style: two spaces per block level.
+func indent(src string) string {
+	lines := strings.Split(strings.TrimSuffix(src, "\n"), "\n")
+	var out strings.Builder
+	level := 0
+	inClassDef := false
+	inClassImpl := false
+	inWhen := false
+	
+	for i := 0; i < len(lines); i++ {
+		line := lines[i]
+		// Handle multiple statements on one line
+		stmts := splitStatements(line)
+		for _, stmt := range stmts {
+			stmt = strings.TrimSpace(stmt)
+			if stmt == "" {
+				continue
+			}
+			
+			upper := strings.ToUpper(stmt)
+			upperNoDot := strings.TrimSuffix(upper, ".")
+			upperNoDot = strings.TrimSpace(upperNoDot)
+			fields := strings.Fields(upperNoDot)
+			
+			// Track class definition/implementation context
+			if len(fields) > 0 {
+				if fields[0] == "CLASS" {
+					if strings.Contains(upper, "DEFINITION") {
+						inClassDef = true
+						inClassImpl = false
+					} else if strings.Contains(upper, "IMPLEMENTATION") {
+						inClassDef = false
+						inClassImpl = true
+					}
+				} else if fields[0] == "ENDCLASS" {
+					inClassDef = false
+					inClassImpl = false
+				}
+			}
+			
+			// Check if this statement closes a block
+			if closesBlock(stmt) {
+				// ENDCASE needs to close both WHEN body and CASE block
+				if len(fields) > 0 && fields[0] == "ENDCASE" && inWhen {
+					level -= 2
+					inWhen = false
+				} else {
+					level--
+				}
+				if level < 0 {
+					level = 0
+				}
+			}
+			
+			// Check if this is CATCH or CLEANUP (special handling for TRY)
+			if isCatchOrCleanup(stmt) {
+				// CATCH/CLEANUP align with TRY (level-1 from current TRY body level)
+				writeIndented(&out, stmt, level-1)
+				out.WriteString("\n")
+				// CATCH body is at the same level as TRY body
+				// level stays at level (TRY body level)
+				continue
+			}
+			
+			// Check if this is WHEN (special handling for CASE)
+			if isWhen(stmt) {
+				// WHEN is 2 spaces inside CASE
+				// First WHEN: write at level (CASE body level), increment
+				// Subsequent WHEN: decrement (close previous WHEN body), write at level, increment
+				if inWhen {
+					// Subsequent WHEN: decrement to close previous WHEN body
+					level--
+				}
+				writeIndented(&out, stmt, level)
+				out.WriteString("\n")
+				level++
+				inWhen = true
+				continue
+			}
+			
+			// Check if this is an alternative branch (ELSE, ELSEIF)
+			if isAlternativeBranch(stmt) {
+				// ELSE/ELSEIF align with IF (level-1)
+				writeIndented(&out, stmt, level-1)
+				out.WriteString("\n")
+				// Body of alternative branch is at the same level as the original body
+				// level stays at level
+				continue
+			}
+			
+			// Special handling for class definition sections
+			if inClassDef && len(fields) > 0 {
+				keyword := fields[0]
+				if keyword == "PUBLIC" || keyword == "PROTECTED" || keyword == "PRIVATE" {
+					// Section headers at level 1 (2 spaces)
+					writeIndented(&out, stmt, 1)
+					out.WriteString("\n")
+					continue
+				}
+				// Declarations within sections at level 2 (4 spaces)
+				if keyword == "DATA" || keyword == "CLASS-DATA" || keyword == "METHODS" || 
+				   keyword == "CLASS-METHODS" || keyword == "INTERFACES" || keyword == "TYPES" ||
+				   keyword == "CONSTANTS" || keyword == "ALIASES" || keyword == "EVENTS" {
+					writeIndented(&out, stmt, 2)
+					out.WriteString("\n")
+					continue
+				}
+			}
+			
+			// Special handling for class implementation
+			if inClassImpl && len(fields) > 0 {
+				keyword := fields[0]
+				if keyword == "METHOD" {
+					// Method in implementation at level 1 (2 spaces)
+					writeIndented(&out, stmt, 1)
+					out.WriteString("\n")
+					level = 2 // Method body at level 2 (4 spaces)
+					continue
+				}
+			}
+			
+			// Write the statement at current level
+			writeIndented(&out, stmt, level)
+			out.WriteString("\n")
+			
+			// Check if this statement opens a block
+			if opensBlock(stmt) {
+				level++
+			}
+		}
+	}
+	return out.String()
+}
+
+// Format applies indentation and line wrapping to src.
+func Format(src string) (string, error) {
+	indented := indent(src)
+	return wrapIndented(indented)
+}
+
+// splitStatements splits a line into individual statements, respecting literals.
+func splitStatements(line string) []string {
+	var stmts []string
+	var current strings.Builder
+	inString := false
+	stringChar := byte(0)
+	escaped := false
+	for i := 0; i < len(line); i++ {
+		c := line[i]
+		if escaped {
+			current.WriteByte(c)
+			escaped = false
+			continue
+		}
+		if inString {
+			current.WriteByte(c)
+			if stringChar == '|' && c == '\\' {
+				escaped = true
+			} else if c == stringChar {
+				if stringChar != '|' && i+1 < len(line) && line[i+1] == stringChar {
+					// Escaped quote in single/double quotes
+					current.WriteByte(line[i+1])
+					i++
+				} else {
+					inString = false
+				}
+			}
+			continue
+		}
+		if c == '\'' || c == '`' || c == '|' {
+			inString = true
+			stringChar = c
+			current.WriteByte(c)
+			continue
+		}
+		if c == '"' {
+			// Comment - rest of line
+			current.WriteString(line[i:])
+			break
+		}
+		if c == '.' {
+			current.WriteByte(c)
+			stmts = append(stmts, current.String())
+			current.Reset()
+			continue
+		}
+		current.WriteByte(c)
+	}
+	if current.Len() > 0 {
+		stmts = append(stmts, current.String())
+	}
+	return stmts
+}
+
+// closesBlock returns true if stmt closes a block.
+func closesBlock(stmt string) bool {
+	upper := strings.ToUpper(strings.TrimSpace(stmt))
+	// Remove trailing period
+	upper = strings.TrimSuffix(upper, ".")
+	upper = strings.TrimSpace(upper)
+	// Check for END* keywords
+	if strings.HasPrefix(upper, "END") {
+		keyword := strings.Fields(upper)[0]
+		switch keyword {
+		case "ENDIF", "ENDWHILE", "ENDLOOP", "ENDDO", "ENDCASE", "ENDTRY",
+			"ENDMETHOD", "ENDCLASS", "ENDINTERFACE", "ENDFORM", "ENDFUNCTION":
+			return true
+		}
+	}
+	return false
+}
+
+// isAlternativeBranch returns true if stmt is an alternative branch (ELSE, ELSEIF).
+func isAlternativeBranch(stmt string) bool {
+	upper := strings.ToUpper(strings.TrimSpace(stmt))
+	upper = strings.TrimSuffix(upper, ".")
+	upper = strings.TrimSpace(upper)
+	fields := strings.Fields(upper)
+	if len(fields) == 0 {
+		return false
+	}
+	keyword := fields[0]
+	switch keyword {
+	case "ELSE", "ELSEIF":
+		return true
+	}
+	return false
+}
+
+// isWhen returns true if stmt is WHEN.
+func isWhen(stmt string) bool {
+	upper := strings.ToUpper(strings.TrimSpace(stmt))
+	upper = strings.TrimSuffix(upper, ".")
+	upper = strings.TrimSpace(upper)
+	fields := strings.Fields(upper)
+	if len(fields) == 0 {
+		return false
+	}
+	keyword := fields[0]
+	return keyword == "WHEN"
+}
+
+// isCatchOrCleanup returns true if stmt is CATCH or CLEANUP.
+func isCatchOrCleanup(stmt string) bool {
+	upper := strings.ToUpper(strings.TrimSpace(stmt))
+	upper = strings.TrimSuffix(upper, ".")
+	upper = strings.TrimSpace(upper)
+	fields := strings.Fields(upper)
+	if len(fields) == 0 {
+		return false
+	}
+	keyword := fields[0]
+	return keyword == "CATCH" || keyword == "CLEANUP"
+}
+
+// opensBlock returns true if stmt opens a block.
+func opensBlock(stmt string) bool {
+	upper := strings.ToUpper(strings.TrimSpace(stmt))
+	upper = strings.TrimSuffix(upper, ".")
+	upper = strings.TrimSpace(upper)
+	fields := strings.Fields(upper)
+	if len(fields) == 0 {
+		return false
+	}
+	keyword := fields[0]
+	switch keyword {
+	case "IF", "WHILE", "LOOP", "DO", "CASE", "TRY",
+		"METHOD", "CLASS", "INTERFACE", "FORM", "FUNCTION":
+		return true
+	}
+	return false
+}
+
+// writeIndented writes stmt with the given indentation level.
+func writeIndented(out *strings.Builder, stmt string, level int) {
+	for i := 0; i < level*2; i++ {
+		out.WriteByte(' ')
+	}
+	out.WriteString(stmt)
+}
+
+// wrapIndented wraps lines that exceed 255 bytes.
+func wrapIndented(src string) (string, error) {
+	var out strings.Builder
+	for _, line := range strings.Split(strings.TrimSuffix(src, "\n"), "\n") {
+		for len(line) > 255 {
+			quote := byte(0)
+			cut := -1
+			for i := 0; i < len(line) && i <= 240; i++ {
+				c := line[i]
+				if quote != 0 {
+					if quote == '|' && c == '\\' {
+						i++
+					} else if c == quote {
+						if quote != '|' && i+1 < len(line) && line[i+1] == quote {
+							i++
+						} else {
+							quote = 0
+						}
+					}
+				} else if c == '`' || c == '\'' || c == '|' {
+					quote = c
+				} else if c == ' ' {
+					cut = i
+				}
+			}
+			if cut <= 0 {
+				return "", fmt.Errorf("unbreakable source line (%s bytes)", strconv.Itoa(len(line)))
+			}
+			out.WriteString(line[:cut] + "\n")
+			line = strings.TrimLeft(line[cut:], " ")
+		}
+		out.WriteString(line + "\n")
+	}
+	return out.String(), nil
+}
