+++ b/hir/abap/indent_test.go
@@ -0,0 +1,129 @@
+package abap
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestIndent(t *testing.T) {
+	// Test basic indentation
+	src := `CLASS test DEFINITION.
+PUBLIC SECTION.
+DATA foo TYPE i.
+METHODS bar.
+ENDCLASS.
+`
+	expected := `CLASS test DEFINITION.
+  PUBLIC SECTION.
+    DATA foo TYPE i.
+    METHODS bar.
+ENDCLASS.
+`
+	result := Indent(src)
+	if result != expected {
+		t.Errorf("Indent mismatch:\nExpected:\n%q\nGot:\n%q", expected, result)
+	}
+}
+
+
+func TestIndentBasic(t *testing.T) {
+	// Test class definition indentation
+	src := `CLASS test DEFINITION.
+PUBLIC SECTION.
+DATA foo TYPE i.
+METHODS bar.
+ENDCLASS.
+`
+	expected := `CLASS test DEFINITION.
+  PUBLIC SECTION.
+    DATA foo TYPE i.
+    METHODS bar.
+ENDCLASS.
+`
+	result := Indent(src)
+	if result != expected {
+		t.Errorf("Indent mismatch:\nExpected:\n%q\nGot:\n%q", expected, result)
+	}
+}
+
+func TestIndentPreservesStringLiterals(t *testing.T) {
+	// String literals with periods should not be treated as statement ends
+	src := `DATA foo TYPE string VALUE 'hello.world'.
+`
+	result := Indent(src)
+	if !strings.Contains(result, "'hello.world'") {
+		t.Errorf("String literal corrupted:\n%q", result)
+	}
+}
+
+func TestIndentPreservesStringTemplates(t *testing.T) {
+	// String templates with escaped delimiters
+	src := `foo = |hello \| world|.
+`
+	result := Indent(src)
+	if !strings.Contains(result, "|hello \\| world|") {
+		t.Errorf("String template corrupted:\n%q", result)
+	}
+}
+
+func TestIndentPreservesComments(t *testing.T) {
+	// Inline comments should be preserved
+	src := `DATA foo TYPE i. " this is a comment
+`
+	result := Indent(src)
+	if !strings.Contains(result, "\" this is a comment") {
+		t.Errorf("Comment corrupted:\n%q", result)
+	}
+}
+
+func TestFormatIdempotent(t *testing.T) {
+	src := `IF foo = 1.
+bar = 2.
+ENDIF.
+`
+	result, err := Format(src)
+	if err != nil {
+		t.Fatalf("Format error: %v", err)
+	}
+
+	// Format should be idempotent
+	result2, err := Format(result)
+	if err != nil {
+		t.Fatalf("Format error on second pass: %v", err)
+	}
+
+	if result != result2 {
+		t.Errorf("Format is not idempotent:\nFirst:\n%q\nSecond:\n%q", result, result2)
+	}
+}
+
+func TestFormatLineLimit(t *testing.T) {
+	// Create a very long line that should be wrapped
+	longVar := strings.Repeat("a", 100)
+	src := `DATA ` + longVar + ` TYPE i.` + "\n"
+
+	result, err := Format(src)
+	if err != nil {
+		t.Fatalf("Format error: %v", err)
+	}
+
+	// Check that no line exceeds 255 bytes
+	for _, line := range strings.Split(result, "\n") {
+		if len(line) > 255 {
+			t.Errorf("Line exceeds 255 bytes: %d bytes", len(line))
+		}
+	}
+}
+
+func TestIndentFullLineComment(t *testing.T) {
+	src := `* This is a comment
+DATA foo TYPE i.
+`
+	expected := `* This is a comment
+DATA foo TYPE i.
+`
+	result := Indent(src)
+	if result != expected {
+		t.Errorf("Indent mismatch:\nExpected:\n%q\nGot:\n%q", expected, result)
+	}
+}
