+++ b/hir/abap/indent.go
@@ -0,0 +1,406 @@
+// Package abap lowers verified object HIR to ABAP 7.50.
+package abap
+
+import (
+	"fmt"
+	"strings"
+	"unicode"
+)
+
+// Indent applies consistent indentation to ABAP source code.
+// It uses two spaces per block level and preserves semantics, literals, and comments.
+// It follows abaplint's default indentation style:
+// - Class headers and ENDCLASS start at column zero
+// - Class sections (PUBLIC SECTION, etc.) have 2 leading spaces
+// - Declarations in sections have 4 leading spaces
+// - Methods in implementations have 2 leading spaces
+// - Method bodies have 4 leading spaces
+// - Control flow blocks add 2 spaces per level
+// - WHEN clauses are 2 spaces inside CASE, bodies 2 spaces further
+// - CATCH/CLEANUP are 2 spaces inside TRY, bodies 2 spaces further
+// - Continuation lines retain the statement's indentation
+// - ELSE/ELSEIF align with IF
+// - Closing statements align with their openers
+func Indent(src string) string {
+	lines := strings.Split(strings.TrimSuffix(src, "\n"), "\n")
+	result := make([]string, 0, len(lines))
+
+	var indentLevel int
+	var stmtIndent int
+	var inContinuation bool
+	var inClassDef bool
+	var inClassImpl bool
+
+	for _, line := range lines {
+		trimmed := strings.TrimSpace(line)
+		if trimmed == "" {
+			result = append(result, "")
+			continue
+		}
+
+		// Full-line comment: preserve at column zero
+		if strings.HasPrefix(trimmed, "*") {
+			result = append(result, trimmed)
+			continue
+		}
+
+		// Detect context from line content
+		upper := strings.ToUpper(trimmed)
+
+		// Track class context
+		if strings.HasPrefix(upper, "CLASS ") && strings.Contains(upper, " DEFINITION") {
+			inClassDef = true
+			inClassImpl = false
+		} else if strings.HasPrefix(upper, "CLASS ") && strings.Contains(upper, " IMPLEMENTATION") {
+			inClassDef = false
+			inClassImpl = true
+		} else if strings.HasPrefix(upper, "ENDCLASS.") || strings.HasPrefix(upper, "ENDCLASS ") {
+			inClassDef = false
+			inClassImpl = false
+		}
+
+		// Calculate base indentation
+		indentSpaces := indentLevel * 2
+
+		// Check for END statements - reduce indent BEFORE applying indentation
+		if isEndStatement(trimmed) {
+			indentLevel--
+			if indentLevel < 0 {
+				indentLevel = 0
+			}
+			indentSpaces = indentLevel * 2
+		}
+
+		// Special handling for class sections
+		if isClassSection(trimmed) {
+			indentSpaces = 2
+		}
+
+		// Special handling for declarations in class definitions
+		if inClassDef && !inClassImpl && !isClassSection(trimmed) && !isEndStatement(trimmed) {
+			if isDeclaration(trimmed) || isMethodDeclaration(trimmed) {
+				indentSpaces = 4
+			}
+		}
+
+		// Special handling for method in implementation
+		if isMethodStart(trimmed) {
+			if inClassImpl {
+				indentSpaces = 2
+			}
+			// Track that we're entering a method
+		}
+
+		// Method body content has 4 spaces (when inside a method)
+		if inClassImpl && !isMethodStart(trimmed) && !isEndStatement(trimmed) {
+			indentSpaces = 4
+		}
+
+		// Alternative branches align with their opener
+		if isAlternativeBranch(trimmed) {
+			indentSpaces = stmtIndent
+			// Don't change indentLevel for alternative branches
+		}
+
+		// Continuation lines retain the statement's indentation
+		if inContinuation && !isAlternativeBranch(trimmed) {
+			indentSpaces = stmtIndent
+		}
+
+		// Apply indentation
+		indentedLine := strings.Repeat(" ", indentSpaces) + trimmed
+		result = append(result, indentedLine)
+
+		// Update continuation tracking
+		statementEnd := findStatementEnd(trimmed)
+		if statementEnd >= 0 {
+			inContinuation = false
+			stmtIndent = indentSpaces
+
+			// Check for block openers AFTER processing the current line
+			if isBlockOpener(trimmed) {
+				indentLevel++
+			}
+		} else {
+			// Line doesn't end with period - continuation
+			if !inContinuation {
+				stmtIndent = indentSpaces
+				inContinuation = true
+			}
+		}
+	}
+
+	return strings.Join(result, "\n") + "\n"
+}
+
+func isClassSection(line string) bool {
+	upper := strings.ToUpper(strings.TrimSpace(line))
+	return strings.HasPrefix(upper, "PUBLIC SECTION") ||
+		strings.HasPrefix(upper, "PROTECTED SECTION") ||
+		strings.HasPrefix(upper, "PRIVATE SECTION")
+}
+
+func isDeclaration(line string) bool {
+	upper := strings.ToUpper(strings.TrimSpace(line))
+	return strings.HasPrefix(upper, "DATA ") ||
+		strings.HasPrefix(upper, "CLASS-DATA ") ||
+		strings.HasPrefix(upper, "CONSTANTS ") ||
+		strings.HasPrefix(upper, "TYPES ") ||
+		strings.HasPrefix(upper, "TYPES:") ||
+		strings.HasPrefix(upper, "ALIASES ") ||
+		strings.HasPrefix(upper, "TYPE-POOLS ") ||
+		strings.HasPrefix(upper, "INCLUDE ") ||
+		strings.HasPrefix(upper, "INTERFACES ")
+}
+
+func isMethodDeclaration(line string) bool {
+	upper := strings.ToUpper(strings.TrimSpace(line))
+	return strings.HasPrefix(upper, "METHODS ") ||
+		strings.HasPrefix(upper, "CLASS-METHODS ")
+}
+
+func isMethodStart(line string) bool {
+	upper := strings.ToUpper(strings.TrimSpace(line))
+	// METHODS is a declaration, METHOD is the start of implementation
+	if !strings.Contains(upper, "METHODS") && strings.HasPrefix(upper, "METHOD ") {
+		return true
+	}
+	return false
+}
+
+// isBlockOpener returns true if the line starts a new block
+func isBlockOpener(line string) bool {
+	end := findStatementEnd(line)
+	if end < 0 {
+		return false
+	}
+
+	stmt := strings.ToUpper(strings.TrimSpace(line[:end+1]))
+
+	blockStarters := []string{
+		"IF.",
+		"IF ",
+		"ELSEIF.",
+		"ELSEIF ",
+		"ELSE.",
+		"ELSE ",
+		"CASE.",
+		"CASE ",
+		"WHEN ",
+		"WHEN.",
+		"DO.",
+		"DO ",
+		"WHILE.",
+		"WHILE ",
+		"LOOP.",
+		"LOOP ",
+		"TRY.",
+		"TRY ",
+	}
+
+	for _, starter := range blockStarters {
+		if strings.HasPrefix(stmt, starter) {
+			return true
+		}
+	}
+
+	return false
+}
+
+// isEndStatement returns true if the line is an END statement
+func isEndStatement(line string) bool {
+	endPos := findStatementEnd(line)
+	if endPos < 0 {
+		endPos = len(line) - 1
+	}
+	if endPos < 0 {
+		return false
+	}
+
+	stmt := strings.ToUpper(strings.TrimSpace(line[:endPos+1]))
+	endKeywords := []string{
+		"ENDIF.",
+		"ENDIF ",
+		"ENDCASE.",
+		"ENDCASE ",
+		"ENDDO.",
+		"ENDDO ",
+		"ENDWHILE.",
+		"ENDWHILE ",
+		"ENDLOOP.",
+		"ENDLOOP ",
+		"ENDTRY.",
+		"ENDTRY ",
+		"ENDMETHOD.",
+		"ENDMETHOD ",
+		"ENDFORM.",
+		"ENDFORM ",
+		"ENDFUNCTION.",
+		"ENDFUNCTION ",
+		"ENDCLASS.",
+		"ENDCLASS ",
+		"ENDINTERFACE.",
+		"ENDINTERFACE ",
+		"ENDPROVIDED.",
+		"ENDPROVIDED ",
+		"ENDAT.",
+		"ENDAT ",
+		"ENDON.",
+		"ENDON ",
+	}
+
+	for _, endKw := range endKeywords {
+		if strings.HasPrefix(stmt, endKw) {
+			return true
+		}
+	}
+
+	return false
+}
+
+// isAlternativeBranch returns true for ELSE, ELSEIF, WHEN, etc.
+// These align with their opening statement, not indented inside the block
+func isAlternativeBranch(line string) bool {
+	endPos := findStatementEnd(line)
+	if endPos < 0 {
+		endPos = len(line) - 1
+	}
+	if endPos < 0 {
+		return false
+	}
+
+	stmt := strings.ToUpper(strings.TrimSpace(line[:endPos+1]))
+	return strings.HasPrefix(stmt, "ELSE.") ||
+		strings.HasPrefix(stmt, "ELSEIF ") ||
+		strings.HasPrefix(stmt, "ELSEIF.") ||
+		strings.HasPrefix(stmt, "ELSE ") ||
+		strings.HasPrefix(stmt, "WHEN ") ||
+		strings.HasPrefix(stmt, "WHEN.")
+}
+
+// findStatementEnd returns the index of the period that ends the statement,
+// or -1 if the statement continues. It correctly handles literals, string
+// templates, and escaped delimiters.
+func findStatementEnd(line string) int {
+	var inQuote byte
+	inStringTemplate := false
+
+	for i := 0; i < len(line); i++ {
+		c := line[i]
+
+		if inStringTemplate {
+			if c == '\\' && i+1 < len(line) {
+				i++
+				continue
+			}
+			if c == '|' {
+				inStringTemplate = false
+			}
+			continue
+		}
+
+		if inQuote != 0 {
+			if c == inQuote {
+				if inQuote == '\'' || inQuote == '`' {
+					if i+1 < len(line) && line[i+1] == inQuote {
+						i++
+						continue
+					}
+				}
+				inQuote = 0
+			}
+			continue
+		}
+
+		if c == '\'' || c == '`' {
+			inQuote = c
+			continue
+		}
+
+		if c == '|' {
+			inStringTemplate = true
+			continue
+		}
+
+		// ABAP inline comment
+		if c == '"' {
+			// Look for a period before this position
+			for j := i - 1; j >= 0; j-- {
+				if line[j] == '.' {
+					return j
+				}
+				if !unicode.IsSpace(rune(line[j])) {
+					break
+				}
+			}
+			return -1
+		}
+
+		if c == '.' {
+			return i
+		}
+	}
+
+	return -1
+}
+
+// Format applies indentation and wraps lines to 255 bytes max.
+// It is idempotent.
+func Format(src string) (string, error) {
+	indented := Indent(src)
+	return wrapLines(indented)
+}
+
+// wrapLines splits lines that exceed 255 bytes while respecting literals.
+func wrapLines(src string) (string, error) {
+	var out strings.Builder
+	lines := strings.Split(strings.TrimSuffix(src, "\n"), "\n")
+
+	for _, line := range lines {
+		for len(line) > 255 {
+			quote := byte(0)
+			inStringTemplate := false
+			cut := -1
+
+			for i := 0; i < len(line) && i <= 240; i++ {
+				c := line[i]
+
+				if inStringTemplate {
+					if c == '\\' && i+1 < len(line) {
+						i++
+					} else if c == '|' {
+						inStringTemplate = false
+					}
+					continue
+				}
+
+				if quote != 0 {
+					if c == quote {
+						if quote != '|' && i+1 < len(line) && line[i+1] == quote {
+							i++
+						} else {
+							quote = 0
+						}
+					}
+					continue
+				}
+
+				if c == '\'' || c == '`' || c == '|' {
+					quote = c
+				} else if c == ' ' && !inStringTemplate && quote == 0 {
+					cut = i
+				}
+			}
+
+			if cut <= 0 {
+				return "", fmt.Errorf("unbreakable source line (%d bytes)", len(line))
+			}
+
+			out.WriteString(line[:cut] + "\n")
+			line = strings.TrimLeft(line[cut:], " ")
+		}
+		out.WriteString(line + "\n")
+	}
+
+	return out.String(), nil
+}
