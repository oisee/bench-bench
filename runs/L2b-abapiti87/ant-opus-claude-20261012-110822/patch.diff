+package abap
+
+import (
+	"strings"
+	"testing"
+)
+
+func lines(s ...string) string { return strings.Join(s, "\n") + "\n" }
+
+func TestIndentLayout(t *testing.T) {
+	for _, tc := range []struct{ name, in, want string }{
+		{"class", lines(
+			"* TS: a.ts:1:1 X",
+			"CLASS zcl DEFINITION PUBLIC CREATE PUBLIC.",
+			"PUBLIC SECTION.",
+			"INTERFACES zif.",
+			"METHODS run IMPORTING p TYPE i.",
+			"PROTECTED SECTION.",
+			"PRIVATE SECTION.",
+			"DATA x TYPE i.",
+			"ENDCLASS.",
+			"CLASS zcl IMPLEMENTATION.",
+			"METHOD run.",
+			"IF p = 1.",
+			"x = 1.",
+			"ELSEIF p = 2.",
+			"WHILE x < 3.",
+			"x = x + 1.",
+			"ENDWHILE.",
+			"ELSE.",
+			"DO 2 TIMES.",
+			"LOOP AT t INTO x.",
+			"ENDLOOP.",
+			"ENDDO.",
+			"ENDIF.",
+			"ENDMETHOD.",
+			"ENDCLASS.",
+		), lines(
+			"* TS: a.ts:1:1 X",
+			"CLASS zcl DEFINITION PUBLIC CREATE PUBLIC.",
+			"  PUBLIC SECTION.",
+			"    INTERFACES zif.",
+			"    METHODS run IMPORTING p TYPE i.",
+			"  PROTECTED SECTION.",
+			"  PRIVATE SECTION.",
+			"    DATA x TYPE i.",
+			"ENDCLASS.",
+			"CLASS zcl IMPLEMENTATION.",
+			"  METHOD run.",
+			"    IF p = 1.",
+			"      x = 1.",
+			"    ELSEIF p = 2.",
+			"      WHILE x < 3.",
+			"        x = x + 1.",
+			"      ENDWHILE.",
+			"    ELSE.",
+			"      DO 2 TIMES.",
+			"        LOOP AT t INTO x.",
+			"        ENDLOOP.",
+			"      ENDDO.",
+			"    ENDIF.",
+			"  ENDMETHOD.",
+			"ENDCLASS.",
+		)},
+		{"interface", lines(
+			"INTERFACE zif PUBLIC.",
+			"METHODS m.",
+			"ENDINTERFACE.",
+		), lines(
+			"INTERFACE zif PUBLIC.",
+			"  METHODS m.",
+			"ENDINTERFACE.",
+		)},
+		{"case and try", lines(
+			"CASE x.",
+			"WHEN 1.",
+			"TRY.",
+			"y = 1.",
+			"CATCH cx_a INTO e.",
+			"y = 2.",
+			"CATCH cx_b.",
+			"CLEANUP.",
+			"y = 3.",
+			"ENDTRY.",
+			"WHEN OTHERS.",
+			"CASE y.",
+			"WHEN 2.",
+			"ENDCASE.",
+			"ENDCASE.",
+			"z = 1.",
+		), lines(
+			"CASE x.",
+			"  WHEN 1.",
+			"    TRY.",
+			"        y = 1.",
+			"      CATCH cx_a INTO e.",
+			"        y = 2.",
+			"      CATCH cx_b.",
+			"      CLEANUP.",
+			"        y = 3.",
+			"    ENDTRY.",
+			"  WHEN OTHERS.",
+			"    CASE y.",
+			"      WHEN 2.",
+			"    ENDCASE.",
+			"ENDCASE.",
+			"z = 1.",
+		)},
+		{"report", lines(
+			"REPORT zr.",
+			"CLASS lcl DEFINITION DEFERRED.",
+			"INTERFACE lif DEFERRED.",
+			"PARAMETERS p TYPE i.",
+			"DATA t TYPE i.",
+			"INITIALIZATION.",
+			"p = 1.",
+			"START-OF-SELECTION.",
+			"GET RUN TIME FIELD t.",
+			"GET TIME STAMP FIELD t.",
+			"IF p = 1.",
+			"PERFORM f.",
+			"ENDIF.",
+			"FORM f.",
+			"WRITE / p.",
+			"ENDFORM.",
+		), lines(
+			"REPORT zr.",
+			"CLASS lcl DEFINITION DEFERRED.",
+			"INTERFACE lif DEFERRED.",
+			"PARAMETERS p TYPE i.",
+			"DATA t TYPE i.",
+			"INITIALIZATION.",
+			"  p = 1.",
+			"START-OF-SELECTION.",
+			"  GET RUN TIME FIELD t.",
+			"  GET TIME STAMP FIELD t.",
+			"  IF p = 1.",
+			"    PERFORM f.",
+			"  ENDIF.",
+			"FORM f.",
+			"  WRITE / p.",
+			"ENDFORM.",
+		)},
+		{"literals and comments", lines(
+			"METHOD m.",
+			"s = 'ENDIF. ''IF x.'.",
+			"s = `ENDMETHOD. ``IF`.",
+			"s = |IF \\| { x }. ENDIF. \\{ ELSE.|.",
+			"s = |{ |ENDIF.| } IF.|.",
+			"x = 1. \" IF x. ENDMETHOD.",
+			"* ENDMETHOD.",
+			"\" IF x.",
+			"y = 2.",
+			"ENDMETHOD.",
+		), lines(
+			"METHOD m.",
+			"  s = 'ENDIF. ''IF x.'.",
+			"  s = `ENDMETHOD. ``IF`.",
+			"  s = |IF \\| { x }. ENDIF. \\{ ELSE.|.",
+			"  s = |{ |ENDIF.| } IF.|.",
+			"  x = 1. \" IF x. ENDMETHOD.",
+			"* ENDMETHOD.",
+			"  \" IF x.",
+			"  y = 2.",
+			"ENDMETHOD.",
+		)},
+		{"continuation and shared lines", lines(
+			"IF a = 1. x = 1. ELSE.",
+			"x = 2. ENDIF. IF b = 1.",
+			"x = 3 +",
+			"         4",
+			"* inside",
+			"  + 5.",
+			"ENDIF.",
+			"DATA: a TYPE i,",
+			"b TYPE i.",
+		), lines(
+			"IF a = 1. x = 1. ELSE.",
+			"  x = 2. ENDIF. IF b = 1.",
+			"  x = 3 +",
+			"  4",
+			"* inside",
+			"  + 5.",
+			"ENDIF.",
+			"DATA: a TYPE i,",
+			"b TYPE i.",
+		)},
+		{"keyword-named variables", lines(
+			"IF a = 1.",
+			"case = 1.",
+			"do = when( ).",
+			"data(x) = 1.",
+			"ENDIF.",
+		), lines(
+			"IF a = 1.",
+			"  case = 1.",
+			"  do = when( ).",
+			"  data(x) = 1.",
+			"ENDIF.",
+		)},
+		{"select loop", lines(
+			"SELECT * FROM t INTO TABLE r.",
+			"SELECT SINGLE * FROM t INTO w.",
+			"SELECT * FROM t INTO w.",
+			"x = 1.",
+			"ENDSELECT.",
+			"SELECT COUNT(*) FROM t INTO n.",
+			"y = 1.",
+		), lines(
+			"SELECT * FROM t INTO TABLE r.",
+			"SELECT SINGLE * FROM t INTO w.",
+			"SELECT * FROM t INTO w.",
+			"  x = 1.",
+			"ENDSELECT.",
+			"SELECT COUNT(*) FROM t INTO n.",
+			"y = 1.",
+		)},
+		{"reindent and blank lines", lines(
+			"      METHOD m.",
+			"   ",
+			"  x = 1.",
+			"ENDMETHOD.",
+		), lines(
+			"METHOD m.",
+			"",
+			"  x = 1.",
+			"ENDMETHOD.",
+		)},
+		{"leading star continuation", lines(
+			"x = a",
+			"    * b.",
+		), lines(
+			"x = a",
+			"  * b.",
+		)},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got := indent(tc.in)
+			if got != tc.want {
+				t.Fatalf("got\n%s\nwant\n%s", got, tc.want)
+			}
+			if again := indent(got); again != got {
+				t.Fatalf("indent is not idempotent:\n%s", again)
+			}
+			formatted, err := Format(tc.in)
+			if err != nil || formatted != tc.want {
+				t.Fatalf("Format: %v\n%s", err, formatted)
+			}
+		})
+	}
+}
+
+func TestFormatWraps(t *testing.T) {
+	var b strings.Builder
+	b.WriteString("CLASS zcl IMPLEMENTATION.\nMETHOD m.\nIF a = 1.\nIF b = 1.\nIF c = 1. x = f(")
+	for i := 0; i < 60; i++ {
+		b.WriteString(" p = 'a b c d'")
+	}
+	b.WriteString(" ). y = 1.\nENDIF.\nENDIF.\nENDIF.\nENDMETHOD.\nENDCLASS.\n")
+	src := b.String()
+	out, err := Format(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if again, err := Format(out); err != nil || again != out {
+		t.Fatalf("Format is not idempotent: %v\n%s", err, again)
+	}
+	if indent(out) != out {
+		t.Fatal("wrapped output is not stable under indent")
+	}
+	if strings.Join(strings.Fields(out), " ") != strings.Join(strings.Fields(src), " ") {
+		t.Fatal("wrapping changed the tokens")
+	}
+	if strings.Count(out, "'a b c d'") != 60 {
+		t.Fatal("wrapping split a literal")
+	}
+	wrapped := 0
+	for _, l := range strings.Split(strings.TrimSuffix(out, "\n"), "\n") {
+		if len(l) > 255 {
+			t.Fatalf("line of %d bytes", len(l))
+		}
+		if strings.Contains(l, "p = 'a b c d'") {
+			wrapped++
+			if !strings.HasPrefix(l, "        ") || strings.HasPrefix(l, "         ") {
+				t.Fatalf("wrapped line lost its statement's indentation: %q", l)
+			}
+		}
+	}
+	if wrapped < 2 {
+		t.Fatalf("expected the long statement to wrap:\n%s", out)
+	}
+}
+
+func TestFormatUnbreakable(t *testing.T) {
+	if _, err := Format("x = '" + strings.Repeat("a", 300) + "'.\n"); err == nil {
+		t.Fatal("a long literal cannot be wrapped")
+	}
+	if _, err := Format("* " + strings.Repeat("a ", 150) + "\n"); err == nil {
+		t.Fatal("a long comment cannot be wrapped")
+	}
+}
+
+func TestFormatWrapsBetweenStatements(t *testing.T) {
+	src := "METHOD m.\nIF a = 1." + strings.Repeat(" RETURN.", 40) + " ENDIF. \" " + strings.Repeat("c", 200) + "\nENDMETHOD.\n"
+	out, err := Format(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if again, err := Format(out); err != nil || again != out {
+		t.Fatalf("Format is not idempotent: %v\n%s", err, again)
+	}
+	if strings.Join(strings.Fields(out), " ") != strings.Join(strings.Fields(src), " ") {
+		t.Fatal("wrapping changed the tokens")
+	}
+	got := strings.Split(strings.TrimSuffix(out, "\n"), "\n")
+	if len(got) != 5 || !strings.HasPrefix(got[1], "  IF a = 1. RETURN.") {
+		t.Fatalf("unexpected layout:\n%s", out)
+	}
+	for i, want := range []string{"    RETURN.", "  \" c", "ENDMETHOD."} {
+		if l := got[i+2]; len(l) > 255 || !strings.HasPrefix(l, want) {
+			t.Fatalf("line %q should start with %q:\n%s", l, want, out)
+		}
+	}
+}
