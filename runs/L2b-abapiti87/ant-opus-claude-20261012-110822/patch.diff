index 0000000..6ad3030
--- /dev/null
+++ b/hir/abap/format.go
@@ -0,0 +1,461 @@
+package abap
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// maxLine is the longest source line the ABAP editor accepts, leading
+// blanks included.
+const maxLine = 255
+
+// Format indents src (see indent) and wraps lines longer than maxLine. Every
+// generated ABAP source passes through it; it is idempotent.
+func Format(src string) (string, error) {
+	if src == "" {
+		return "", nil
+	}
+	return layout(strings.TrimSuffix(src, "\n"), true)
+}
+
+// indent re-indents src in abaplint's default style: two blanks per block,
+// class sections and WHEN one level inside their opener with their contents
+// one level further, TRY bodies two levels inside TRY with CATCH and CLEANUP
+// in between, report events and forms at column zero. Continuation lines
+// take the indentation of the line their statement starts on. Only leading
+// blanks change: full-line * comments and lines starting inside string
+// template text are kept as they are.
+func indent(src string) string {
+	out, _ := layout(src, false)
+	return out
+}
+
+// srcLine is what the lexer records about one physical line.
+type srcLine struct {
+	text    string
+	lead    int  // leading blanks and tabs
+	comment bool // * in column zero
+	inText  bool // starts inside string template text
+	cont    int  // statement in progress at the line start, -1 if none
+	first   int  // first statement starting on the line, -1 if none
+	before  int  // statements started before the line
+	cuts    []cut
+}
+
+// cut is a blank where a line may be wrapped: inside a statement, or between
+// statements, where next is the statement the rest of the line starts with.
+type cut struct {
+	pos, next int
+}
+
+// srcStmt is one statement (a colon chain counts as one): the line it starts
+// on and its leading words, upper case, literals replaced by a placeholder.
+type srcStmt struct {
+	line  int
+	words []string
+}
+
+func layout(src string, wrap bool) (string, error) {
+	lines, stmts := lex(src)
+	stmtIndent, curAfter := indentStatements(stmts)
+	lineIndent := make([]int, len(lines))
+	var out strings.Builder
+	for i, l := range lines {
+		if i > 0 {
+			out.WriteByte('\n')
+		}
+		switch {
+		case l.cont >= 0:
+			lineIndent[i] = lineIndent[stmts[l.cont].line]
+		case l.first >= 0:
+			lineIndent[i] = stmtIndent[l.first]
+		case l.before > 0:
+			lineIndent[i] = curAfter[l.before-1]
+		}
+		if l.comment || l.inText {
+			if wrap && len(l.text) > maxLine {
+				return "", fmt.Errorf("unbreakable source line (%s bytes)", strconv.Itoa(len(l.text)))
+			}
+			out.WriteString(l.text)
+			continue
+		}
+		content := l.text[l.lead:]
+		if strings.TrimSpace(content) == "" {
+			continue
+		}
+		if !wrap {
+			out.WriteString(pad(lineIndent[i], content) + content)
+			continue
+		}
+		pos, ind := 0, lineIndent[i]
+		for {
+			piece := content[pos:]
+			pre := pad(ind, piece)
+			if len(pre)+len(piece) <= maxLine {
+				out.WriteString(pre + piece)
+				break
+			}
+			best := cut{-1, -1}
+			for _, c := range l.cuts {
+				at := c.pos - l.lead
+				if at > pos && len(pre)+at-pos <= maxLine && strings.TrimLeft(content[at:], " \t") != "" {
+					best = cut{at, c.next}
+				}
+			}
+			if best.pos < 0 {
+				return "", fmt.Errorf("unbreakable source line (%s bytes)", strconv.Itoa(len(pre)+len(piece)))
+			}
+			out.WriteString(pre + strings.TrimRight(content[pos:best.pos], " \t") + "\n")
+			pos = best.pos
+			for pos < len(content) && (content[pos] == ' ' || content[pos] == '\t') {
+				pos++
+			}
+			// The rest starts a line of its own: a statement takes its own
+			// column, a trailing comment the column of the next statement.
+			if best.next >= 0 {
+				if best.next < len(stmts) && content[pos] != '"' {
+					ind = stmtIndent[best.next]
+				} else {
+					ind = curAfter[best.next-1]
+				}
+			}
+		}
+	}
+	if wrap {
+		out.WriteByte('\n')
+	}
+	return out.String(), nil
+}
+
+// pad is the indentation of a code line. A line starting with * must not
+// land in column zero, where it would become a comment.
+func pad(n int, content string) string {
+	if n == 0 && strings.HasPrefix(content, "*") {
+		n = 2
+	}
+	return strings.Repeat(" ", n)
+}
+
+// lex splits src into lines and statements. Periods, colons and quotes
+// inside literals, string templates and comments are ignored; cuts are the
+// blanks outside literals and templates where a line may be wrapped.
+func lex(src string) ([]srcLine, []srcStmt) {
+	var lines []srcLine
+	var stmts []srcStmt
+	var modes []byte // 't' template text, 'e' embedded expression
+	var norm strings.Builder
+	started := false
+	finish := func() {
+		if started {
+			words := strings.Fields(strings.ToUpper(norm.String()))
+			if len(words) > 64 {
+				words = words[:64]
+			}
+			stmts[len(stmts)-1].words = words
+		}
+		norm.Reset()
+		started = false
+	}
+	for i, text := range strings.Split(src, "\n") {
+		l := srcLine{text: text, cont: -1, first: -1, before: len(stmts)}
+		for l.lead < len(text) && (text[l.lead] == ' ' || text[l.lead] == '\t') {
+			l.lead++
+		}
+		if started {
+			l.cont = len(stmts) - 1
+		}
+		l.inText = len(modes) > 0 && modes[len(modes)-1] == 't'
+		if !l.inText && strings.HasPrefix(text, "*") {
+			l.comment = true
+			lines = append(lines, l)
+			continue
+		}
+		mark := func() {
+			if !started {
+				started = true
+				if l.first < 0 {
+					l.first = len(stmts)
+				}
+				stmts = append(stmts, srcStmt{line: i})
+			}
+		}
+	scan:
+		for j := 0; j < len(text); j++ {
+			c := text[j]
+			if len(modes) > 0 && modes[len(modes)-1] == 't' {
+				switch c {
+				case '\\':
+					j++
+				case '{':
+					modes = append(modes, 'e')
+				case '|':
+					modes = modes[:len(modes)-1]
+				}
+				continue
+			}
+			switch c {
+			case ' ', '\t', '\r':
+				if len(modes) == 0 && j >= l.lead {
+					if started {
+						l.cuts = append(l.cuts, cut{j, -1})
+					} else if len(stmts) > 0 {
+						l.cuts = append(l.cuts, cut{j, len(stmts)})
+					}
+				}
+				norm.WriteByte(' ')
+			case '"':
+				break scan
+			case '\'', '`':
+				mark()
+				k := j + 1
+				for k < len(text) {
+					if text[k] == c {
+						if k+1 < len(text) && text[k+1] == c {
+							k += 2
+							continue
+						}
+						break
+					}
+					k++
+				}
+				j = k
+				norm.WriteString(" ' ")
+			case '|':
+				mark()
+				modes = append(modes, 't')
+				norm.WriteString(" ' ")
+			case '}':
+				if len(modes) > 0 {
+					modes = modes[:len(modes)-1]
+				}
+				norm.WriteByte(' ')
+			case '.':
+				if len(modes) == 0 {
+					finish()
+				} else {
+					norm.WriteByte(c)
+				}
+			case ':':
+				mark()
+				norm.WriteByte(' ')
+			default:
+				mark()
+				norm.WriteByte(c)
+			}
+		}
+		lines = append(lines, l)
+	}
+	finish()
+	return lines, stmts
+}
+
+// endOf maps each block end to the opener it closes.
+var endOf = map[string]string{
+	"ENDIF": "IF", "ENDWHILE": "WHILE", "ENDDO": "DO", "ENDLOOP": "LOOP",
+	"ENDAT": "AT", "ENDSELECT": "SELECT", "ENDWITH": "WITH", "ENDMETHOD": "METHOD",
+	"ENDFORM": "FORM", "ENDMODULE": "MODULE", "ENDFUNCTION": "FUNCTION",
+	"ENDINTERFACE": "INTERFACE", "ENDCLASS": "CLASS", "ENDCASE": "CASE",
+	"ENDTRY": "TRY", "ENDCATCH": "CATCH", "ENDEXEC": "EXEC",
+	"END-OF-DEFINITION": "DEFINE", "END-TEST-SEAM": "TEST-SEAM",
+	"END-TEST-INJECTION": "TEST-INJECTION",
+}
+
+// opens are the statements that always open a block closed by its end. Like
+// abaplint, PROVIDE, ON CHANGE OF and enhancements do not indent.
+var opens = map[string]bool{
+	"IF": true, "WHILE": true, "DO": true, "LOOP": true, "METHOD": true,
+	"FUNCTION": true, "DEFINE": true, "TEST-SEAM": true, "TEST-INJECTION": true,
+	"EXEC": true,
+}
+
+var events = map[string]bool{
+	"START-OF-SELECTION": true, "END-OF-SELECTION": true, "INITIALIZATION": true,
+	"TOP-OF-PAGE": true, "END-OF-PAGE": true, "LOAD-OF-PROGRAM": true,
+}
+
+// runtimeGet are the GET statements that are not the logical database event.
+var runtimeGet = map[string]bool{
+	"RUN": true, "TIME": true, "REFERENCE": true, "BIT": true, "PARAMETER": true,
+	"CURSOR": true, "LOCALE": true, "PF-STATUS": true, "PROPERTY": true,
+	"DATASET": true, "BADI": true, "PERMISSION": true,
+}
+
+var assignments = map[string]bool{"=": true, "?=": true, "+=": true, "-=": true, "*=": true, "/=": true, "&&=": true}
+
+func hasWord(words []string, w string) bool {
+	for _, x := range words {
+		if x == w {
+			return true
+		}
+	}
+	return false
+}
+
+// keyword is the statement's block role: its first word, or "" for a
+// statement that neither opens nor closes anything.
+func keyword(words []string) string {
+	if len(words) == 0 || len(words) > 1 && assignments[words[1]] {
+		return ""
+	}
+	w := words[0]
+	switch w {
+	case "CLASS":
+		switch {
+		case hasWord(words, "IMPLEMENTATION"):
+			return "CLASS"
+		case !hasWord(words, "DEFINITION") || hasWord(words, "DEFERRED") || hasWord(words, "LOAD"):
+			return ""
+		}
+		for i := 0; i+1 < len(words); i++ {
+			if words[i] == "LOCAL" && words[i+1] == "FRIENDS" {
+				return ""
+			}
+		}
+		return "CLASS"
+	case "INTERFACE":
+		if hasWord(words, "DEFERRED") || hasWord(words, "LOAD") {
+			return ""
+		}
+		return w
+	case "CATCH":
+		if len(words) > 1 && words[1] == "SYSTEM-EXCEPTIONS" {
+			return "CATCH SYSTEM-EXCEPTIONS"
+		}
+		return w
+	case "AT":
+		if len(words) > 1 && (words[1] == "SELECTION-SCREEN" || words[1] == "LINE-SELECTION" || words[1] == "USER-COMMAND" || strings.HasPrefix(words[1], "PF")) {
+			return "EVENT"
+		}
+		return w
+	case "GET":
+		if len(words) > 1 && !runtimeGet[words[1]] && (len(words) == 2 || words[2] == "LATE" || words[2] == "FIELDS") {
+			return "EVENT"
+		}
+		return ""
+	case "PUBLIC", "PROTECTED", "PRIVATE":
+		if len(words) > 1 && words[1] == "SECTION" {
+			return "SECTION"
+		}
+		return ""
+	case "EXEC":
+		if len(words) > 1 && words[1] == "SQL" {
+			return w
+		}
+		return ""
+	}
+	if events[w] {
+		return "EVENT"
+	}
+	return w
+}
+
+type frame struct {
+	kind string
+	base int
+}
+
+// indentStatements runs the indentation state machine: the column of each
+// statement and the column of the next statement after it.
+func indentStatements(stmts []srcStmt) ([]int, []int) {
+	kinds := make([]string, len(stmts))
+	// SELECT opens a loop only when an ENDSELECT closes it. Macro bodies are
+	// plain text.
+	var pending []int
+	macro := false
+	for i, s := range stmts {
+		k := keyword(s.words)
+		switch {
+		case macro:
+			if k != "END-OF-DEFINITION" {
+				k = ""
+			}
+			macro = k == ""
+		case k == "DEFINE":
+			macro = true
+		case k == "SELECT":
+			k = ""
+			if !hasWord(s.words, "SINGLE") && !(hasWord(s.words, "TABLE") && (hasWord(s.words, "INTO") || hasWord(s.words, "APPENDING"))) {
+				pending = append(pending, i)
+			}
+		case k == "ENDSELECT" && len(pending) > 0:
+			kinds[pending[len(pending)-1]] = "SELECT"
+			pending = pending[:len(pending)-1]
+		}
+		kinds[i] = k
+	}
+	at := make([]int, len(stmts))
+	after := make([]int, len(stmts))
+	var stack []frame
+	cur := 0
+	// find returns the innermost open frame of the kind, or -1.
+	find := func(kind string) int {
+		for j := len(stack) - 1; j >= 0; j-- {
+			if stack[j].kind == kind {
+				return j
+			}
+		}
+		return -1
+	}
+	for i := range stmts {
+		ind := cur
+		switch k := kinds[i]; {
+		case k == "CLASS" || k == "FORM" || k == "MODULE":
+			ind = 0
+			stack = append(stack[:0], frame{k, 0})
+			cur = 2
+		case k == "EVENT":
+			ind = 0
+			stack = stack[:0]
+			cur = 2
+		case k == "SECTION":
+			if j := find("CLASS"); j >= 0 {
+				stack = stack[:j+1]
+				ind = stack[j].base + 2
+				cur = ind + 2
+			}
+		case k == "ELSE" || k == "ELSEIF":
+			if j := find("IF"); j >= 0 {
+				stack = stack[:j+1]
+				ind = stack[j].base
+			} else {
+				ind = max(cur-2, 0)
+			}
+			cur = ind + 2
+		case k == "WHEN" || k == "CATCH" || k == "CLEANUP":
+			opener := "CASE"
+			if k != "WHEN" {
+				opener = "TRY"
+			}
+			if j := find(opener); j >= 0 {
+				stack = stack[:j+1]
+				ind = stack[j].base + 2
+			} else {
+				ind = max(cur-2, 0)
+			}
+			cur = ind + 2
+		case k == "CASE":
+			stack = append(stack, frame{k, cur})
+			cur += 2
+		case k == "TRY":
+			stack = append(stack, frame{k, cur})
+			cur += 4
+		case k == "CATCH SYSTEM-EXCEPTIONS":
+			stack = append(stack, frame{"CATCH", cur})
+			cur += 2
+		case k == "AT" || k == "SELECT" || k == "INTERFACE" || opens[k]:
+			stack = append(stack, frame{k, cur})
+			cur += 2
+		case endOf[k] != "":
+			if j := find(endOf[k]); j >= 0 {
+				ind = stack[j].base
+				stack = stack[:j]
+			} else {
+				ind = max(cur-2, 0)
+			}
+			cur = ind
+		}
+		at[i], after[i] = ind, cur
+	}
+	return at, after
+}
