+package tsfront
+
+import (
+	"fmt"
+
+	"github.com/oisee/abapiti/hir/abap"
+)
+
+func formatGeneratedABAP(src string) string {
+	out, err := abap.Format(src)
+	if err != nil {
+		panic(fmt.Errorf("format generated ABAP: %w", err))
+	}
+	return out
+}
