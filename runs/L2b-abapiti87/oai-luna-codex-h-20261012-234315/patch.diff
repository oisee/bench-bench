index 0000000..9c5d8bb
--- /dev/null
+++ b/hir/abap/format.go
@@ -0,0 +1,452 @@
+package abap
+
+import (
+	"fmt"
+	"strings"
+)
+
+// indent applies abaplint's fixed two-space indentation style.
+func indent(src string) string { return indentABAP(src) }
+
+// Format indents ABAP and wraps source lines at 255 bytes.
+func Format(src string) (string, error) {
+	if src == "" {
+		return "", nil
+	}
+	return wrapABAP(indentABAP(src))
+}
+
+type abapBlock struct {
+	word string
+	base int
+	body int
+}
+
+func indentABAP(src string) string {
+	if src == "" {
+		return ""
+	}
+	lines := strings.Split(strings.TrimSuffix(strings.ReplaceAll(src, "\r\n", "\n"), "\n"), "\n")
+	var out strings.Builder
+	var blocks []abapBlock
+	depth := 0
+	continuing := false
+	continuationIndent := 0
+	var pending strings.Builder
+	for li, raw := range lines {
+		trim := strings.TrimLeft(raw, " \t")
+		if trim == "" {
+			out.WriteByte('\n')
+			continue
+		}
+		if strings.HasPrefix(trim, "*") {
+			out.WriteString(trim)
+			out.WriteByte('\n')
+			continue
+		}
+		if strings.HasPrefix(trim, "\"") {
+			out.WriteString(strings.Repeat(" ", depth*2))
+			out.WriteString(trim)
+			out.WriteByte('\n')
+			continue
+		}
+		// Keep comment-only lines at the current block level. Their contents
+		// are copied byte for byte after the indentation prefix.
+		first := firstCodeWord(trim)
+		lineDepth := depth
+		if continuing {
+			lineDepth = continuationIndent
+		} else if isReportEvent(first, trim) || first == "FORM" || (len(blocks) > 0 && blocks[len(blocks)-1].word == "EVENT" && (first == "CLASS" || first == "INTERFACE")) {
+			lineDepth = 0
+		} else if isClosing(first) {
+			lineDepth = closingDepth(first, blocks, depth)
+		} else if first == "ELSE" || first == "ELSEIF" || first == "WHEN" || first == "CATCH" || first == "CLEANUP" {
+			lineDepth = branchDepth(first, blocks, depth)
+		}
+		if lineDepth < 0 {
+			lineDepth = 0
+		}
+		out.WriteString(strings.Repeat(" ", lineDepth*2))
+		out.WriteString(trim)
+		if li+1 < len(lines) || raw != "" {
+			out.WriteByte('\n')
+		}
+
+		// Scan statements on this physical line. Periods in quoted strings,
+		// templates, escaped literals, and comments cannot end a statement.
+		segments, ended := splitStatements(trim)
+		for si, seg := range segments {
+			if strings.TrimSpace(seg) == "" && pending.Len() == 0 {
+				continue
+			}
+			if continuing || pending.Len() > 0 {
+				pending.WriteByte(' ')
+				pending.WriteString(seg)
+			} else {
+				pending.WriteString(seg)
+			}
+			if si < len(ended) && ended[si] {
+				word := firstCodeWord(pending.String())
+				depth = applyStatement(word, pending.String(), depth, &blocks)
+				pending.Reset()
+				continuing = false
+			} else {
+				if pending.Len() > 0 && !continuing {
+					continuationIndent = lineDepth
+				}
+				continuing = true
+			}
+		}
+	}
+	return out.String()
+}
+
+// splitStatements returns text between statement periods, plus whether each
+// piece ended in a period. It also excludes a trailing ABAP quote comment.
+func splitStatements(s string) ([]string, []bool) {
+	var parts []string
+	var ended []bool
+	start, quote := 0, byte(0)
+	end := len(s)
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if quote != 0 {
+			if quote == '|' && c == '\\' {
+				i++
+				continue
+			}
+			if c == quote {
+				if quote != '|' && i+1 < len(s) && s[i+1] == quote {
+					i++
+					continue
+				}
+				quote = 0
+			}
+			continue
+		}
+		if c == '"' {
+			end = i
+			break
+		}
+		if c == '\'' || c == '`' || c == '|' {
+			quote = c
+			continue
+		}
+		if c == '.' && !(i > 0 && i+1 < len(s) && isDigit(s[i-1]) && isDigit(s[i+1])) {
+			parts = append(parts, s[start:i+1])
+			ended = append(ended, true)
+			start = i + 1
+		}
+	}
+	parts = append(parts, s[start:end])
+	ended = append(ended, false)
+	return parts, ended
+}
+
+func isDigit(b byte) bool { return b >= '0' && b <= '9' }
+
+func firstCodeWord(s string) string {
+	var b strings.Builder
+	quote := byte(0)
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if quote != 0 {
+			if quote == '|' && c == '\\' {
+				i++
+				continue
+			}
+			if c == quote {
+				if quote != '|' && i+1 < len(s) && s[i+1] == quote {
+					i++
+					continue
+				}
+				quote = 0
+			}
+			continue
+		}
+		if c == '"' {
+			break
+		}
+		if c == '\'' || c == '`' || c == '|' {
+			quote = c
+			continue
+		}
+		if isWord(c) {
+			b.WriteByte(c)
+		} else if b.Len() > 0 {
+			break
+		}
+	}
+	return strings.ToUpper(b.String())
+}
+
+func isWord(c byte) bool { return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_' || c == '-' }
+
+func isClosing(w string) bool {
+	return w == "ENDCLASS" || w == "ENDINTERFACE" || w == "ENDMETHOD" || w == "ENDFORM" || w == "ENDIF" || w == "ENDCASE" || w == "ENDTRY" || w == "ENDLOOP" || w == "ENDWHILE" || w == "ENDDO" || w == "ENDSELECT" || w == "ENDAT" || w == "ENDMODULE" || w == "ENDFUNCTION"
+}
+
+func closingDepth(w string, stack []abapBlock, depth int) int {
+	for i := len(stack) - 1; i >= 0; i-- {
+		if matchingEnd(stack[i].word) == w {
+			return stack[i].base
+		}
+	}
+	return depth
+}
+
+func isReportEvent(w, full string) bool {
+	if w == "INITIALIZATION" || w == "START-OF-SELECTION" || w == "END-OF-SELECTION" || w == "TOP-OF-PAGE" || w == "LOAD-OF-PROGRAM" || w == "TOP-OF-PAGE-DURING-LINE-SELECTION" || w == "END-OF-PAGE" {
+		return true
+	}
+	if w == "GET" {
+		fields := strings.Fields(strings.ToUpper(full))
+		if len(fields) > 1 && fields[1] != "RUN" && fields[1] != "PARAMETER" && fields[1] != "REFERENCE" {
+			return true
+		}
+	}
+	if w == "AT" {
+		u := strings.ToUpper(strings.TrimSpace(full))
+		return strings.HasPrefix(u, "AT SELECTION-SCREEN") || strings.HasPrefix(u, "AT LINE-SELECTION") || strings.HasPrefix(u, "AT USER-COMMAND") || strings.HasPrefix(u, "AT PF-")
+	}
+	return false
+}
+
+func matchingEnd(w string) string {
+	switch w {
+	case "IF":
+		return "ENDIF"
+	case "CASE":
+		return "ENDCASE"
+	case "TRY":
+		return "ENDTRY"
+	case "LOOP":
+		return "ENDLOOP"
+	case "WHILE":
+		return "ENDWHILE"
+	case "DO":
+		return "ENDDO"
+	case "SELECT":
+		return "ENDSELECT"
+	case "CLASS":
+		return "ENDCLASS"
+	case "INTERFACE":
+		return "ENDINTERFACE"
+	case "METHOD":
+		return "ENDMETHOD"
+	case "FORM":
+		return "ENDFORM"
+	case "MODULE":
+		return "ENDMODULE"
+	case "FUNCTION":
+		return "ENDFUNCTION"
+	case "AT":
+		return "ENDAT"
+	}
+	return ""
+}
+
+func branchDepth(w string, stack []abapBlock, depth int) int {
+	if len(stack) == 0 {
+		return depth
+	}
+	top := stack[len(stack)-1]
+	if (w == "WHEN" && top.word == "CASE") || ((w == "CATCH" || w == "CLEANUP") && top.word == "TRY") {
+		return top.base + 1
+	}
+	if (w == "ELSE" || w == "ELSEIF") && top.word == "IF" {
+		return top.base
+	}
+	return depth
+}
+
+func applyStatement(w, full string, depth int, dst *[]abapBlock) int {
+	if (w == "CLASS" || w == "INTERFACE") && len(*dst) > 0 && (*dst)[len(*dst)-1].word == "EVENT" {
+		*dst = (*dst)[:len(*dst)-1]
+		depth = 0
+	}
+	if isClosing(w) {
+		for len(*dst) > 0 && (*dst)[len(*dst)-1].word == "SECTION" {
+			*dst = (*dst)[:len(*dst)-1]
+		}
+		if len(*dst) > 0 && matchingEnd((*dst)[len(*dst)-1].word) == w {
+			depth = (*dst)[len(*dst)-1].base
+			*dst = (*dst)[:len(*dst)-1]
+		}
+		return depth
+	}
+	if w == "ELSE" || w == "ELSEIF" || w == "WHEN" || w == "CATCH" || w == "CLEANUP" {
+		if len(*dst) > 0 {
+			top := &(*dst)[len(*dst)-1]
+			if (w == "WHEN" && top.word == "CASE") || ((w == "CATCH" || w == "CLEANUP") && top.word == "TRY") {
+				top.body = top.base + 2
+				return top.body
+			}
+		}
+		return depth
+	}
+	if w == "CLASS" {
+		upper := strings.ToUpper(full)
+		if (strings.Contains(upper, " DEFINITION") || strings.Contains(upper, " IMPLEMENTATION")) && !strings.Contains(upper, " DEFERRED") {
+			*dst = append(*dst, abapBlock{word: "CLASS", base: depth, body: depth + 1})
+			return depth + 1
+		}
+	}
+	if w == "INTERFACE" {
+		*dst = append(*dst, abapBlock{word: w, base: depth, body: depth + 1})
+		return depth + 1
+	}
+	if w == "GET" && isReportEvent(w, full) {
+		for len(*dst) > 0 && (*dst)[len(*dst)-1].word == "EVENT" {
+			*dst = (*dst)[:len(*dst)-1]
+		}
+		*dst = append(*dst, abapBlock{word: "EVENT", base: 0, body: 1})
+		return 1
+	}
+	if w == "AT" { // Only report events open a report-level body.
+		upper := strings.ToUpper(strings.TrimSpace(full))
+		if strings.HasPrefix(upper, "AT SELECTION-SCREEN") || strings.HasPrefix(upper, "AT LINE-SELECTION") || strings.HasPrefix(upper, "AT USER-COMMAND") || strings.HasPrefix(upper, "AT PF-") {
+			for len(*dst) > 0 && (*dst)[len(*dst)-1].word == "EVENT" {
+				*dst = (*dst)[:len(*dst)-1]
+			}
+			*dst = append(*dst, abapBlock{word: "EVENT", base: 0, body: 1})
+			return 1
+		}
+		*dst = append(*dst, abapBlock{word: "AT", base: depth, body: depth + 1})
+		return depth + 1
+	}
+	if w == "START-OF-SELECTION" || w == "INITIALIZATION" || w == "END-OF-SELECTION" || w == "TOP-OF-PAGE" || w == "LOAD-OF-PROGRAM" || w == "TOP-OF-PAGE-DURING-LINE-SELECTION" || w == "END-OF-PAGE" {
+		for len(*dst) > 0 && (*dst)[len(*dst)-1].word == "EVENT" {
+			*dst = (*dst)[:len(*dst)-1]
+		}
+		*dst = append(*dst, abapBlock{word: "EVENT", base: 0, body: 1})
+		return 1
+	}
+	if w == "FORM" && len(*dst) > 0 && (*dst)[len(*dst)-1].word == "EVENT" {
+		*dst = (*dst)[:len(*dst)-1]
+		depth = 0
+	}
+	if w == "PUBLIC" || w == "PROTECTED" || w == "PRIVATE" {
+		upper := strings.ToUpper(full)
+		if strings.Contains(upper, "SECTION") {
+			if len(*dst) > 0 && (*dst)[len(*dst)-1].word == "SECTION" {
+				depth = (*dst)[len(*dst)-1].base
+				*dst = (*dst)[:len(*dst)-1]
+			}
+			*dst = append(*dst, abapBlock{word: "SECTION", base: depth, body: depth + 1})
+			return depth + 1
+		}
+	}
+	if end := matchingEnd(w); end != "" && w != "CLASS" && w != "INTERFACE" {
+		if w == "SELECT" {
+			upper := strings.ToUpper(full)
+			if strings.Contains(upper, " SINGLE ") || strings.Contains(upper, " INTO TABLE ") {
+				return depth
+			}
+		}
+		body := depth + 1
+		if w == "TRY" {
+			body = depth + 2
+		}
+		*dst = append(*dst, abapBlock{word: w, base: depth, body: body})
+		return body
+	}
+	if len(*dst) > 0 {
+		return (*dst)[len(*dst)-1].body
+	}
+	return depth
+}
+
+func wrapABAP(src string) (string, error) {
+	var out strings.Builder
+	for _, line := range strings.Split(strings.TrimSuffix(src, "\n"), "\n") {
+		if strings.HasPrefix(line, "*") {
+			parts, err := wrapComment(line[1:], 1)
+			if err != nil {
+				return "", err
+			}
+			for _, part := range parts {
+				out.WriteByte('*')
+				out.WriteString(part)
+				out.WriteByte('\n')
+			}
+			continue
+		}
+		indent := len(line) - len(strings.TrimLeft(line, " "))
+		if trim := strings.TrimLeft(line, " "); strings.HasPrefix(trim, "\"") {
+			parts, err := wrapComment(trim[1:], indent+1)
+			if err != nil {
+				return "", err
+			}
+			for _, part := range parts {
+				out.WriteString(strings.Repeat(" ", indent))
+				out.WriteByte('"')
+				out.WriteString(part)
+				out.WriteByte('\n')
+			}
+			continue
+		}
+		for len(line) > 255 {
+			cut := lastSafeSpace(line, 255)
+			if cut <= indent {
+				return "", fmt.Errorf("unbreakable source line (%d bytes)", len(line))
+			}
+			out.WriteString(line[:cut])
+			out.WriteByte('\n')
+			line = strings.Repeat(" ", indent) + strings.TrimLeft(line[cut:], " ")
+		}
+		out.WriteString(line)
+		out.WriteByte('\n')
+	}
+	return out.String(), nil
+}
+
+// wrapComment splits a full-line comment at spaces while retaining every
+// comment byte. The caller adds the ABAP comment marker to each piece.
+func wrapComment(body string, markerBytes int) ([]string, error) {
+	var parts []string
+	for markerBytes+len(body) > 255 {
+		limit := 255 - markerBytes
+		cut := strings.LastIndexByte(body[:limit+1], ' ')
+		if cut < 0 {
+			return nil, fmt.Errorf("unbreakable comment (%d bytes)", markerBytes+len(body))
+		}
+		parts = append(parts, body[:cut+1])
+		body = body[cut+1:]
+	}
+	parts = append(parts, body)
+	return parts, nil
+}
+
+func lastSafeSpace(s string, limit int) int {
+	quote := byte(0)
+	cut := -1
+	for i := 0; i < len(s) && i < limit; i++ {
+		c := s[i]
+		if quote != 0 {
+			if quote == '|' && c == '\\' {
+				i++
+				continue
+			}
+			if c == quote {
+				if quote != '|' && i+1 < len(s) && s[i+1] == quote {
+					i++
+					continue
+				}
+				quote = 0
+			}
+			continue
+		}
+		if c == '"' {
+			break
+		}
+		if c == '\'' || c == '`' || c == '|' {
+			quote = c
+			continue
+		}
+		if c == ' ' {
+			cut = i
+		}
+	}
+	return cut
+}
