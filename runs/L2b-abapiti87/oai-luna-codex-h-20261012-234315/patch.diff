@@ -0,0 +1,64 @@
+package abap
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestIndentBlocksAndGeneratedStructures(t *testing.T) {
+	in := "CLASS zcl_x DEFINITION.\nPUBLIC SECTION.\nMETHODS run.\nENDCLASS.\nCLASS zcl_x IMPLEMENTATION.\nMETHOD run.\nIF ok = abap_true.\nCASE x.\nWHEN 1.\nWRITE 'yes'.\nENDCASE.\nELSE.\nTRY.\nfoo( ).\nCATCH cx_root.\nbar( ).\nCLEANUP.\nbaz( ).\nENDTRY.\nENDIF.\nENDMETHOD.\nENDCLASS.\n"
+	want := "CLASS zcl_x DEFINITION.\n  PUBLIC SECTION.\n    METHODS run.\nENDCLASS.\nCLASS zcl_x IMPLEMENTATION.\n  METHOD run.\n    IF ok = abap_true.\n      CASE x.\n        WHEN 1.\n          WRITE 'yes'.\n      ENDCASE.\n    ELSE.\n      TRY.\n          foo( ).\n        CATCH cx_root.\n          bar( ).\n        CLEANUP.\n          baz( ).\n      ENDTRY.\n    ENDIF.\n  ENDMETHOD.\nENDCLASS.\n"
+	if got := indent(in); got != want {
+		t.Fatalf("indent mismatch\n--- got ---\n%s--- want ---\n%s", got, want)
+	}
+	if got := indent(want); got != want {
+		t.Fatalf("indent is not idempotent\n%s", got)
+	}
+}
+
+func TestIndentLexingEventsAndSameLineStatements(t *testing.T) {
+	in := "CLASS lcl DEFINITION DEFERRED.\nSTART-OF-SELECTION.\nIF text = 'ENDIF.'. WRITE |ENDCASE.|. ENDIF.\nGET RUN TIME FIELD start.\nFORM work.\nWRITE `ENDMETHOD.`.\nENDFORM.\n"
+	want := "CLASS lcl DEFINITION DEFERRED.\nSTART-OF-SELECTION.\n  IF text = 'ENDIF.'. WRITE |ENDCASE.|. ENDIF.\n  GET RUN TIME FIELD start.\nFORM work.\n  WRITE `ENDMETHOD.`.\nENDFORM.\n"
+	if got := indent(in); got != want {
+		t.Fatalf("indent mismatch\n--- got ---\n%s--- want ---\n%s", got, want)
+	}
+}
+
+func TestReportGetEventDoesNotCatchRuntimeGet(t *testing.T) {
+	in := "GET flight.\nWRITE 'event'.\nGET RUN TIME FIELD start.\nWRITE 'still event'.\nFORM finish.\nWRITE 'form'.\nENDFORM.\n"
+	want := "GET flight.\n  WRITE 'event'.\n  GET RUN TIME FIELD start.\n  WRITE 'still event'.\nFORM finish.\n  WRITE 'form'.\nENDFORM.\n"
+	if got := indent(in); got != want {
+		t.Fatalf("indent mismatch\n--- got ---\n%s--- want ---\n%s", got, want)
+	}
+}
+
+func TestIndentPreservesCommentsAndIgnoresTheirKeywords(t *testing.T) {
+	in := "CLASS c DEFINITION.\nPUBLIC SECTION.\nENDCLASS.\nCLASS c IMPLEMENTATION.\nMETHOD m.\nIF ok = abap_true.\n  * ENDIF. remains a comment\n  \" ENDCASE. remains text\nWRITE 'it''s. IF harmless'. \" ENDIF. not a block\nENDIF.\nENDMETHOD.\nENDCLASS.\n"
+	want := "CLASS c DEFINITION.\n  PUBLIC SECTION.\nENDCLASS.\nCLASS c IMPLEMENTATION.\n  METHOD m.\n    IF ok = abap_true.\n* ENDIF. remains a comment\n      \" ENDCASE. remains text\n      WRITE 'it''s. IF harmless'. \" ENDIF. not a block\n    ENDIF.\n  ENDMETHOD.\nENDCLASS.\n"
+	if got := indent(in); got != want {
+		t.Fatalf("indent mismatch\n--- got ---\n%s--- want ---\n%s", got, want)
+	}
+}
+
+func TestFormatWrapsWithIndentAndIsIdempotent(t *testing.T) {
+	long := "METHOD run.\nWRITE: / " + strings.Repeat("value, ", 45) + "value.\n*" + strings.Repeat(" comment", 40) + "\n  \"" + strings.Repeat(" note", 60) + "\nENDMETHOD.\n"
+	got, err := Format(long)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, l := range strings.Split(strings.TrimSuffix(got, "\n"), "\n") {
+		if len(l) > 255 {
+			t.Fatalf("line is %d bytes", len(l))
+		}
+	}
+	if !strings.Contains(got, "\n* comment") {
+		t.Fatalf("full-line * comment moved from column zero:\n%s", got)
+	}
+	got2, err := Format(got)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got2 != got {
+		t.Fatalf("format is not idempotent\n%s", got2)
+	}
+}
