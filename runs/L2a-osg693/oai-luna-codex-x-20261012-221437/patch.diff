+++ b/tools/gogen/go/abap/parse_i8_test.go
@@ -0,0 +1,66 @@
+package abap
+
+import (
+	"math"
+	"testing"
+)
+
+func TestParseI8(t *testing.T) {
+	cases := []struct {
+		text  string
+		value int64
+	}{
+		{"", 0},
+		{"   ", 0},
+		{"  +12  ", 12},
+		{"-12", -12},
+		{"9007199254740993", 9007199254740993},
+		{"2.49", 2},
+		{"2.5", 3},
+		{"-2.5", -3},
+		{".5", 1},
+		{"5.", 5},
+		{"9223372036854775807", math.MaxInt64},
+		{"-9223372036854775808", math.MinInt64},
+		{"9223372036854775807.4", math.MaxInt64},
+		{"-9223372036854775808.4", math.MinInt64},
+	}
+	for _, tc := range cases {
+		t.Run(tc.text, func(t *testing.T) {
+			if got := ParseI8(tc.text); got != tc.value {
+				t.Fatalf("ParseI8(%q) = %d, want %d", tc.text, got, tc.value)
+			}
+		})
+	}
+
+	for _, tc := range []struct{ text, class string }{
+		{"9223372036854775807.5", "CX_SY_CONVERSION_OVERFLOW"},
+		{"-9223372036854775808.5", "CX_SY_CONVERSION_OVERFLOW"},
+		{"9223372036854775808", "CX_SY_CONVERSION_OVERFLOW"},
+		{"-9223372036854775809", "CX_SY_CONVERSION_OVERFLOW"},
+		{"abc", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"1e2", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"+", "CX_SY_CONVERSION_NO_NUMBER"},
+	} {
+		t.Run(tc.text, func(t *testing.T) {
+			defer func() {
+				r := recover()
+				e, ok := r.(ArithmeticError)
+				if !ok || e.Class != tc.class {
+					t.Fatalf("ParseI8(%q) panic = %#v, want ArithmeticError{Class:%q}", tc.text, r, tc.class)
+				}
+			}()
+			ParseI8(tc.text)
+			t.Fatalf("ParseI8(%q) did not panic", tc.text)
+		})
+	}
+}
+
+func TestMoveDataStringToI8(t *testing.T) {
+	text := "9007199254740993"
+	var got int64
+	MoveData(Data{P: &got, T: TInt8}, Data{P: &text, T: TString})
+	if got != 9007199254740993 {
+		t.Fatalf("MoveData string to int8 = %d, want 9007199254740993", got)
+	}
+}
diff --git a/tools/gogen/js/abap.mjs b/tools/gogen/js/abap.mjs
index d4b8241..2160fc8 100644
--- a/tools/gogen/js/abap.mjs
+++ b/tools/gogen/js/abap.mjs
@@ -162,6 +162,39 @@ export function ParseI(v) {
   if (n > 2147483647 || n < -2147483648) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->i");
   return n;
 }
+const I8_MAX = 9223372036854775807n;
+const I8_MIN = -9223372036854775808n;
+function incrementDecimal(v) {
+  const digits = [...v];
+  for (let i = digits.length - 1; i >= 0; i--) {
+    if (digits[i] !== "9") {
+      digits[i] = String.fromCharCode(digits[i].charCodeAt(0) + 1);
+      return digits.join("");
+    }
+    digits[i] = "0";
+  }
+  return `1${digits.join("")}`;
+}
+export function ParseI8(v) {
+  const t = v.replace(/^ +| +$/g, "");
+  if (t === "") return 0n;
+  const {neg, body: raw, ok} = numSign(t);
+  const body = raw.replace(/^ +| +$/g, "");
+  if (!ok || !decimalDigits(body)) throw new AbapError("CX_SY_CONVERSION_NO_NUMBER", "c->int8");
+  const dot = body.indexOf(".");
+  let whole = (dot < 0 ? body : body.slice(0, dot)).replace(/^0+/, "");
+  const frac = dot < 0 ? "" : body.slice(dot + 1);
+  if (whole === "") whole = "0";
+  if (frac !== "" && frac[0] >= "5") whole = incrementDecimal(whole);
+  const limit = neg ? "9223372036854775808" : "9223372036854775807";
+  if (whole.length > limit.length || (whole.length === limit.length && whole > limit)) {
+    throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  }
+  const n = BigInt(whole);
+  const result = neg ? -n : n;
+  if (result > I8_MAX || result < I8_MIN) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  return result;
+}
