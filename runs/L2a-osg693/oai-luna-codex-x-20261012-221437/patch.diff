diff --git a/tools/gogen/parse-i8.test.mjs b/tools/gogen/parse-i8.test.mjs
new file mode 100644
index 0000000..d19aa9d
--- /dev/null
+++ b/tools/gogen/parse-i8.test.mjs
@@ -0,0 +1,109 @@
+import {test} from "node:test";
+import assert from "node:assert/strict";
+import {spawnSync} from "node:child_process";
+import {mkdirSync, mkdtempSync, rmSync, writeFileSync} from "node:fs";
+import {basename, dirname, join} from "node:path";
+import {tmpdir} from "node:os";
+import {fileURLToPath, pathToFileURL} from "node:url";
+import {compileProgram} from "./frontend.mjs";
+import {emitGo} from "./emit-go.mjs";
+import {emitJs} from "./emit-js.mjs";
+import {AbapError, MoveData, ParseI8, TInt8, TString, cell} from "./js/abap.mjs";
+
+const here = dirname(fileURLToPath(import.meta.url));
+const cases = [
+  ["", "0"],
+  ["   ", "0"],
+  [" +12 ", "12"],
+  ["-12", "-12"],
+  ["9007199254740993", "9007199254740993"],
+  ["2.49", "2"],
+  ["2.5", "3"],
+  ["-2.5", "-3"],
+  [".5", "1"],
+  ["5.", "5"],
+  ["9223372036854775807", "9223372036854775807"],
+  ["-9223372036854775808", "-9223372036854775808"],
+  ["9223372036854775807.4", "9223372036854775807"],
+  ["-9223372036854775808.4", "-9223372036854775808"],
+  ["9223372036854775807.5", "OVERFLOW"],
+  ["-9223372036854775808.5", "OVERFLOW"],
+  ["9223372036854775808", "OVERFLOW"],
+  ["-9223372036854775809", "OVERFLOW"],
+  ["abc", "NO_NUMBER"],
+  ["1e2", "NO_NUMBER"],
+];
+
+test("ParseI8 returns exact signed 64-bit BigInts and reports ABAP conversion classes", () => {
+  for (const [input, expected] of cases) {
+    if (expected === "OVERFLOW" || expected === "NO_NUMBER") continue;
+    assert.equal(ParseI8(input).toString(), expected, JSON.stringify(input));
+  }
+  assert.throws(() => ParseI8("9223372036854775807.5"), (e) => e instanceof AbapError && e.cls === "CX_SY_CONVERSION_OVERFLOW");
+  assert.throws(() => ParseI8("abc"), (e) => e instanceof AbapError && e.cls === "CX_SY_CONVERSION_NO_NUMBER");
+});
+
+test("generic data moves parse string values into int8", () => {
+  const dst = cell(0n, TInt8);
+  MoveData(dst, cell("9007199254740993", TString));
+  assert.equal(dst.get(), 9007199254740993n);
+});
+
+test("generated Go and JavaScript programs assign string to int8, format exactly, and catch overflow", {timeout: 120000}, async () => {
+  const core = join(here, "../../.local/lars/open-abap-core/src");
+  const sourceDir = mkdtempSync(join(tmpdir(), "gogen-parse-i8-source-"));
+  mkdirSync(join(here, ".out"), {recursive: true});
+  let jsDir, goDir;
+  try {
+    writeFileSync(join(sourceDir, "zcl_gogen_t_c2i8.clas.abap"), `
+CLASS zcl_gogen_t_c2i8 DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run IMPORTING iv_text TYPE string RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+CLASS zcl_gogen_t_c2i8 IMPLEMENTATION.
+  METHOD run.
+    DATA lv_i8 TYPE int8.
+    TRY.
+        lv_i8 = iv_text.
+        rv = |{ lv_i8 }|.
+      CATCH cx_sy_conversion_overflow.
+        rv = 'OVERFLOW'.
+      CATCH cx_sy_conversion_no_number.
+        rv = 'NO_NUMBER'.
+    ENDTRY.
+  ENDMETHOD.
+ENDCLASS.
+`);
+    const program = compileProgram({folders: [sourceDir, core], objects: ["ZCL_GOGEN_T_C2I8", "CX_ROOT", "CX_STATIC_CHECK", "CX_DYNAMIC_CHECK", "CX_NO_CHECK"]});
+    assert.deepEqual(program.skipped, []);
+
+    jsDir = mkdtempSync(join(here, ".out", "parse-i8-js-"));
+    goDir = mkdtempSync(join(here, "go", "cmd", "gogen-parse-i8-"));
+    writeFileSync(join(jsDir, "generated.mjs"), emitJs(program, pathToFileURL(join(here, "js", "abap.mjs")).href));
+    const {ZCL_GOGEN_T_C2I8: cls} = await import(pathToFileURL(join(jsDir, "generated.mjs")).href);
+    for (const [input, expected] of cases) {
+      assert.equal(cls.RUN({sy: {}}, input), expected, `JS assignment ${JSON.stringify(input)}`);
+    }
+
+    writeFileSync(join(goDir, "zz_generated.go"), emitGo(program));
+    const goCases = cases.map(([input, expected]) => `{${JSON.stringify(input)}, ${JSON.stringify(expected)}}`).join(",\n");
+    writeFileSync(join(goDir, "parse_i8_test.go"), `package main
+import ("testing"; "osg/gogen/abap")
+func TestGeneratedStringToInt8(t *testing.T) {
+ cases := []struct{ input, want string }{${goCases}}
+ for _, tc := range cases {
+  if got := ZCL_GOGEN_T_C2I8_RUN(&abap.Session{}, tc.input); got != tc.want { t.Errorf("RUN(%q) = %q, want %q", tc.input, got, tc.want) }
+ }
+}
+`);
+    const run = spawnSync("go", ["test", "-timeout=30s", `./cmd/${basename(goDir)}`], {
+      cwd: join(here, "go"), encoding: "utf8", timeout: 110000,
+      env: {...process.env, GOFLAGS: "-buildvcs=false", GOCACHE: join(here, ".out/go-cache")},
+    });
+    assert.equal(run.status, 0, run.stdout + run.stderr);
+  } finally {
+    rmSync(sourceDir, {recursive: true, force: true});
+    if (jsDir) rmSync(jsDir, {recursive: true, force: true});
+    if (goDir) rmSync(goDir, {recursive: true, force: true});
+  }
+});
