diff --git a/tools/gogen/go/abap/conv.go b/tools/gogen/go/abap/conv.go
index 17c7e05..71a049e 100644
--- a/tools/gogen/go/abap/conv.go
+++ b/tools/gogen/go/abap/conv.go
@@ -195,6 +195,69 @@ func ParseI(v string) int32 {
 	return int32(n)
 }
 
+// ParseI8 converts a character value to int8 by ParseI's text rules, with
+// the range widened to the 64-bit one: no value of that range, either bound
+// included, passes through a float, so the magnitude stays on the digits and
+// the check compares them with the bound's own. A fraction that rounds up
+// past the bound raises as well.
+func ParseI8(v string) int64 {
+	t := strings.Trim(v, " ")
+	if t == "" {
+		return 0
+	}
+	neg, body, ok := numSign(t)
+	body = strings.Trim(body, " ")
+	if !ok || !decimalDigits(body) {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_NO_NUMBER", Op: "c->int8"})
+	}
+	whole, frac := body, ""
+	if i := strings.IndexByte(body, '.'); i >= 0 {
+		whole, frac = body[:i], body[i+1:]
+	}
+	whole = strings.TrimLeft(whole, "0")
+	if frac != "" && frac[0] >= '5' {
+		whole = roundUpDigits(whole)
+	}
+	if whole == "" {
+		return 0
+	}
+	// the negative bound is one past int64's maximum, so it is compared as
+	// a digit string too and only then taken as MinInt64
+	const pos, negBound = "9223372036854775807", "9223372036854775808"
+	limit := pos
+	if neg {
+		limit = negBound
+	}
+	if len(whole) > len(limit) || len(whole) == len(limit) && whole > limit {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	if whole == negBound {
+		return math.MinInt64
+	}
+	n, _ := strconv.ParseInt(whole, 10, 64)
+	if neg {
+		n = -n
+	}
+	return n
+}
+
+// roundUpDigits adds one to a string of digits, carrying ("19" is "20",
+// "99" is "100", "" -- a fraction alone -- is "1").
+func roundUpDigits(s string) string {
+	if s == "" {
+		return "1"
+	}
+	b := []byte(s)
+	for i := len(b) - 1; i >= 0; i-- {
+		if b[i] < '9' {
+			b[i]++
+			return string(b)
+		}
+		b[i] = '0'
+	}
+	return "1" + string(b)
+}
+
 // I8ToI and F2I8: int8 into i with an overflow check, f into int8 rounded.
 func I8ToI(v int64) int32 { return check(v, "int8->i") }
 
