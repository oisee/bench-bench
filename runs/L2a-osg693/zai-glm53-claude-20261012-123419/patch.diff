+CLASS zcl_gogen_t_c2n8 DEFINITION PUBLIC FINAL CREATE PUBLIC.
+* a text moved into an int8: the text rules are the ones ZCL_GOGEN_T_C2NUM
+* measured for an i (one sign, digits with at most one point, the fraction
+* rounded half away from zero), and the value keeps every bit of the 64-bit
+* range, both bounds included -- not measured on A4H, the rules and the
+* endpoints of the task
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+  PRIVATE SECTION.
+    CLASS-METHODS to_int8
+      IMPORTING iv_text   TYPE string
+      RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_c2n8 IMPLEMENTATION.
+  METHOD to_int8.
+    DATA lv TYPE int8.
+    TRY.
+        lv = iv_text.
+        rv = |{ lv }|.
+      CATCH cx_sy_conversion_no_number.
+        rv = 'NN'.
+      CATCH cx_sy_conversion_overflow.
+        rv = 'OV'.
+    ENDTRY.
+  ENDMETHOD.
+
+  METHOD run.
+    DATA lt_text TYPE STANDARD TABLE OF string WITH DEFAULT KEY.
+    DATA lv_text TYPE string.
+    APPEND `12` TO lt_text.
+    APPEND ` 12 ` TO lt_text.
+    APPEND `-12` TO lt_text.
+    APPEND `12-` TO lt_text.
+    APPEND `+12` TO lt_text.
+    APPEND `- 12` TO lt_text.
+    APPEND `2.5` TO lt_text.
+    APPEND `-2.5` TO lt_text.
+    APPEND `.5` TO lt_text.
+    APPEND `5.` TO lt_text.
+    APPEND `1.49999` TO lt_text.
+    APPEND `1E3` TO lt_text.
+    APPEND `abc` TO lt_text.
+    APPEND `` TO lt_text.
+    APPEND `   ` TO lt_text.
+* past the i range, inside the int8 one
+    APPEND `3000000000` TO lt_text.
+* 2**53 + 1, exact only off the float path
+    APPEND `9007199254740993` TO lt_text.
+    APPEND `-9007199254740993` TO lt_text.
+* both bounds of the 64-bit range
+    APPEND `9223372036854775807` TO lt_text.
+    APPEND `-9223372036854775808` TO lt_text.
+    APPEND `9223372036854775807.4` TO lt_text.
+    APPEND `-9223372036854775808.4` TO lt_text.
+* one past them, and a fraction that rounds one past them
+    APPEND `9223372036854775808` TO lt_text.
+    APPEND `-9223372036854775809` TO lt_text.
+    APPEND `9223372036854775807.5` TO lt_text.
+    APPEND `-9223372036854775808.5` TO lt_text.
+    LOOP AT lt_text INTO lv_text.
+      IF rv IS INITIAL.
+        rv = |[{ lv_text }]{ to_int8( lv_text ) }|.
+      ELSE.
+        rv = |{ rv } [{ lv_text }]{ to_int8( lv_text ) }|.
+      ENDIF.
+    ENDLOOP.
+  ENDMETHOD.
+ENDCLASS.
