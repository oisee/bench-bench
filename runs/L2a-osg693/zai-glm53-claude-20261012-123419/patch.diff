--- /dev/null
+++ b/tools/gogen/c2n8.test.mjs
@@ -0,0 +1,124 @@
+import {test} from "node:test";
+import assert from "node:assert/strict";
+import {mkdtempSync, writeFileSync, rmSync} from "node:fs";
+import {tmpdir} from "node:os";
+import {dirname, join} from "node:path";
+import {fileURLToPath} from "node:url";
+import {compileProgram} from "./frontend.mjs";
+import {emitGo} from "./emit-go.mjs";
+import {emitJs} from "./emit-js.mjs";
+import {ParseI8} from "./js/abap.mjs";
+import {libraryPath} from "../osd-lib-path.mjs";
+import {home} from "./home.mjs";
+
+const here = dirname(fileURLToPath(import.meta.url));
+// the CATCH classes live in open-abap-core (semantics.mjs compiles them the
+// same way); the clone is what tools/osd-libs.mjs makes
+const core = join(libraryPath(home, "open-abap-core"), "src");
+
+// a text into an int8: the rules go/abap conv.go ParseI8 spells out (the
+// text grammar ZCL_GOGEN_T_C2NUM measured for an i), over the 64-bit range
+const run = (v) => {
+  try {
+    return ParseI8(v);
+  } catch (e) {
+    return e.cls;
+  }
+};
+
+test("the JS runtime parses a text into an exact int8", () => {
+  for (const [text, want] of [
+    [" 12 ", 12n], ["-12", -12n], ["12-", -12n], ["+12", 12n], ["- 12", -12n], ["12 -", -12n],
+    ["2.5", 3n], ["-2.5", -3n], ["2.4", 2n], ["-2.4", -2n], [".5", 1n], ["-.5", -1n], ["5.", 5n],
+    ["-0.4", 0n], ["", 0n], ["   ", 0n], ["0012", 12n],
+    ["1E3", "CX_SY_CONVERSION_NO_NUMBER"], ["abc", "CX_SY_CONVERSION_NO_NUMBER"], ["1,5", "CX_SY_CONVERSION_NO_NUMBER"],
+    ["12 3", "CX_SY_CONVERSION_NO_NUMBER"], [".", "CX_SY_CONVERSION_NO_NUMBER"], ["+-1", "CX_SY_CONVERSION_NO_NUMBER"],
+    ["--1", "CX_SY_CONVERSION_NO_NUMBER"], ["-1-", "CX_SY_CONVERSION_NO_NUMBER"],
+    // every value of the range, both bounds included, exact off the float path
+    ["0", 0n],
+    ["9223372036854775807", 9223372036854775807n],
+    ["-9223372036854775808", -9223372036854775808n],
+    ["00009223372036854775807", 9223372036854775807n],
+    ["9007199254740993", 9007199254740993n],
+    ["-9007199254740993", -9007199254740993n],
+    // one past the range, and a fraction that rounds one past it
+    ["9223372036854775808", "CX_SY_CONVERSION_OVERFLOW"],
+    ["-9223372036854775809", "CX_SY_CONVERSION_OVERFLOW"],
+    ["99999999999999999999", "CX_SY_CONVERSION_OVERFLOW"],
+    ["9223372036854775807.5", "CX_SY_CONVERSION_OVERFLOW"],
+    ["-9223372036854775808.5", "CX_SY_CONVERSION_OVERFLOW"],
+    ["9223372036854775807.4", 9223372036854775807n],
+    ["-9223372036854775808.4", -9223372036854775808n],
+  ]) assert.equal(run(text), want, text);
+  assert.equal(typeof ParseI8("1"), "bigint");
+});
+
+test("both emitters lower a string into an int8 through ParseI8", () => {
+  const dir = mkdtempSync(join(tmpdir(), "gogen-c2n8-"));
+  try {
+    writeFileSync(join(dir, "zcl_gogen_c2n8.clas.abap"), `
+CLASS zcl_gogen_c2n8 DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run IMPORTING in TYPE string RETURNING VALUE(rv) TYPE int8.
+ENDCLASS.
+CLASS zcl_gogen_c2n8 IMPLEMENTATION.
+  METHOD run.
+    rv = in.
+  ENDMETHOD.
+ENDCLASS.
+`);
+    const program = compileProgram({folders: [dir], objects: ["ZCL_GOGEN_C2N8"]});
+    assert.match(emitGo(program), /abap\.ParseI8\(/);
+    assert.match(emitJs(program, new URL("./js/abap.mjs", import.meta.url).href), /abap\.ParseI8\(/);
+  } finally { rmSync(dir, {recursive: true, force: true}); }
+});
+
+test("a generated program assigns, formats and catches the overflow", async () => {
+  const dir = mkdtempSync(join(tmpdir(), "gogen-c2n8-run-"));
+  try {
+    writeFileSync(join(dir, "zcl_gogen_c2n8r.clas.abap"), `
+CLASS zcl_gogen_c2n8r DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS parse IMPORTING in TYPE string RETURNING VALUE(rv) TYPE string.
+    CLASS-METHODS twice IMPORTING in TYPE string RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+CLASS zcl_gogen_c2n8r IMPLEMENTATION.
+  METHOD parse.
+    DATA v TYPE int8.
+    TRY.
+        v = in.
+        rv = |{ v }|.
+      CATCH cx_sy_conversion_no_number.
+        rv = 'NN'.
+      CATCH cx_sy_conversion_overflow.
+        rv = 'OV'.
+    ENDTRY.
+  ENDMETHOD.
+  METHOD twice.
+    DATA v TYPE int8.
+    TRY.
+        v = in.
+        v = v * 2.
+        rv = |{ v }|.
+      CATCH cx_sy_conversion_overflow.
+        rv = 'OV'.
+    ENDTRY.
+  ENDMETHOD.
+ENDCLASS.
+`);
+    const program = compileProgram({folders: [dir, core], objects: ["ZCL_GOGEN_C2N8R"]});
+    const js = emitJs(program, new URL("./js/abap.mjs", import.meta.url).href);
+    const m = await import(`data:text/javascript;base64,${Buffer.from(js).toString("base64")}`);
+    const session = {sy: {index: 0, tabix: 0, subrc: 0, dbcnt: 0}};
+    for (const [text, want] of [
+      ["-9223372036854775808", "-9223372036854775808"],
+      ["9223372036854775808", "OV"],
+      [" 9007199254740993 ", "9007199254740993"],
+      ["abc", "NN"],
+    ]) assert.equal(m.ZCL_GOGEN_C2N8R.PARSE(session, text), want, text);
+    assert.equal(m.ZCL_GOGEN_C2N8R.TWICE(session, "4611686018427387903"), "9223372036854775806");
+    // half the negative bound, doubled onto it exactly
+    assert.equal(m.ZCL_GOGEN_C2N8R.TWICE(session, "-4611686018427387904"), "-9223372036854775808");
+    assert.equal(m.ZCL_GOGEN_C2N8R.TWICE(session, " -3.5 "), "-8");
+  } finally { rmSync(dir, {recursive: true, force: true}); }
+});
