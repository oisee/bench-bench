+package abap
+
+import (
+	"math"
+	"math/big"
+	"math/rand"
+	"strconv"
+	"testing"
+)
+
+// ParseI8: the text rules ParseI measured on A4H (conv.go), over the 64-bit
+// range the assignment keeps exact. CO and NN as the probes abbreviate them.
+func TestParseI8(t *testing.T) {
+	cases := []struct {
+		in   string
+		want string
+	}{
+		{" 12 ", "12"}, {"-12", "-12"}, {"12-", "-12"}, {"+12", "12"}, {"- 12", "-12"}, {"12 -", "-12"},
+		{"2.5", "3"}, {"-2.5", "-3"}, {"2.4", "2"}, {"-2.4", "-2"}, {"1.49999", "1"},
+		{".5", "1"}, {"-.5", "-1"}, {"5.", "5"}, {"-0.4", "0"},
+		{"", "0"}, {"   ", "0"}, {"0012", "12"},
+		{"1E3", "NN"}, {"abc", "NN"}, {"1,5", "NN"}, {"12 3", "NN"}, {".", "NN"},
+		{"+-1", "NN"}, {"--1", "NN"}, {"-1-", "NN"}, {"+", "NN"}, {"-", "NN"},
+		// every value of the range, both bounds included
+		{"0", "0"},
+		{"9223372036854775807", "9223372036854775807"},
+		{"-9223372036854775808", "-9223372036854775808"},
+		{"00009223372036854775807", "9223372036854775807"},
+		{"4611686018427387903", "4611686018427387903"},
+		{"-4611686018427387904", "-4611686018427387904"},
+		// past it, and a fraction that rounds past it
+		{"9223372036854775808", "CO"},
+		{"-9223372036854775809", "CO"},
+		{"99999999999999999999", "CO"},
+		{"9223372036854775807.5", "CO"},
+		{"-9223372036854775808.5", "CO"},
+		{"9223372036854775807.4", "9223372036854775807"},
+		{"-9223372036854775808.4", "-9223372036854775808"},
+	}
+	run := func(in string) (out string) {
+		defer func() {
+			if r := recover(); r != nil {
+				e, ok := r.(ArithmeticError)
+				if !ok {
+					panic(r)
+				}
+				out = map[string]string{"CX_SY_CONVERSION_OVERFLOW": "CO", "CX_SY_CONVERSION_NO_NUMBER": "NN"}[e.Class]
+			}
+		}()
+		return strconv.FormatInt(ParseI8(in), 10)
+	}
+	for _, c := range cases {
+		if got := run(c.in); got != c.want {
+			t.Errorf("ParseI8(%q) = %s, want %s", c.in, got, c.want)
+		}
+	}
+}
+
+// the digits path stays exact where a float would not: random values of the
+// range, parsed and compared with math/big
+func TestParseI8Exact(t *testing.T) {
+	r := rand.New(rand.NewSource(8))
+	for i := 0; i < 2000; i++ {
+		n := new(big.Int).Rand(r, new(big.Int).Lsh(big.NewInt(1), 64))
+		if n.Bit(63) == 1 {
+			n.Sub(n, new(big.Int).Lsh(big.NewInt(1), 64))
+		}
+		text := n.String()
+		if i%2 == 0 {
+			if text[0] == '-' {
+				text = "-000" + text[1:]
+			} else {
+				text = "000" + text
+			}
+		}
+		if got := ParseI8(text); got != n.Int64() {
+			t.Fatalf("ParseI8(%q) = %d, want %d", text, got, n.Int64())
+		}
+	}
+	if ParseI8("9007199254740993") != 9007199254740993 || ParseI8("-9007199254740993") != -9007199254740993 {
+		t.Fatal("2**53 + 1 must stay exact")
+	}
+	if ParseI8("9007199254740992.9") != 9007199254740993 {
+		t.Fatal("a fraction under a float-exact value rounds on the digits")
+	}
+	_ = math.MaxInt64
+}
