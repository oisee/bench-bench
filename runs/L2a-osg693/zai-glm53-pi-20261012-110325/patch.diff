+import {test} from "node:test";
+import assert from "node:assert/strict";
+import {dirname, join} from "node:path";
+import {fileURLToPath} from "node:url";
+import {compileProgram} from "./frontend.mjs";
+import {emitGo} from "./emit-go.mjs";
+import {emitJs} from "./emit-js.mjs";
+import {ParseI8, AbapError} from "./js/abap.mjs";
+import {libraryPath} from "../osd-lib-path.mjs";
+import {home} from "./home.mjs";
+
+const here = dirname(fileURLToPath(import.meta.url));
+const core = join(libraryPath(home, "open-abap-core"), "src");
+
+// js/abap.mjs ParseI8 (= go/abap conv.go ParseI8, both tested by the ABAP
+// walk of ZCL_GOGEN_T_C2INT8 in semantics.mjs): blanks around the text, one
+// sign anywhere, digits with at most one point rounded half away from zero,
+// and every value of the signed 64-bit range exact as a BigInt, both
+// endpoints included.
+test("ParseI8 keeps the signed 64-bit range exactly", () => {
+  for (const [inText, want] of [
+    ["42", 42n], [" 42 ", 42n], ["+42", 42n], ["-42", -42n], ["42-", -42n], ["- 42", -42n],
+    ["2.5", 3n], ["-2.5", -3n], ["2.4", 2n], [".5", 1n], ["5.", 5n], ["-0.5", -1n],
+    ["0", 0n], ["", 0n], ["   ", 0n], ["0012", 12n],
+    ["9223372036854775807", 9223372036854775807n],
+    ["+9223372036854775807", 9223372036854775807n],
+    ["-9223372036854775808", -9223372036854775808n],
+    ["9223372036854775806.5", 9223372036854775807n],
+    ["-9223372036854775808.4", -9223372036854775808n],
+    ["00009223372036854775807", 9223372036854775807n],
+  ]) assert.equal(ParseI8(inText), want, inText);
+  for (const [inText, cls] of [
+    ["-", "CX_SY_CONVERSION_NO_NUMBER"], ["abc", "CX_SY_CONVERSION_NO_NUMBER"],
+    ["1E3", "CX_SY_CONVERSION_NO_NUMBER"], ["12 abc", "CX_SY_CONVERSION_NO_NUMBER"],
+    ["+-1", "CX_SY_CONVERSION_NO_NUMBER"], ["0000-9223372036854775808", "CX_SY_CONVERSION_NO_NUMBER"],
+    ["9223372036854775808", "CX_SY_CONVERSION_OVERFLOW"],
+    ["-9223372036854775809", "CX_SY_CONVERSION_OVERFLOW"],
+    ["9223372036854775807.5", "CX_SY_CONVERSION_OVERFLOW"],
+    ["-9223372036854775808.5", "CX_SY_CONVERSION_OVERFLOW"],
+    ["99999999999999999999", "CX_SY_CONVERSION_OVERFLOW"],
+    ["00009223372036854775808", "CX_SY_CONVERSION_OVERFLOW"],
+  ]) assert.throws(() => ParseI8(inText), (e) => e instanceof AbapError && e.cls === cls, inText);
+});
+
