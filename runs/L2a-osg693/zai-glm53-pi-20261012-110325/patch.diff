+    + "[9223372036854775807]9223372036854775807 [+9223372036854775807]9223372036854775807 [-9223372036854775808]-9223372036854775808 "
+    + "[9223372036854775808]OV [-9223372036854775809]OV [9223372036854775807.4]9223372036854775807 [9223372036854775807.5]OV "
+    + "[-9223372036854775808.4]-9223372036854775808 [-9223372036854775808.5]OV [99999999999999999999]OV n:42 move:[7-] gen:8");
