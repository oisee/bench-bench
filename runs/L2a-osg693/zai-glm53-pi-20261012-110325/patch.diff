+  let n = whole === "" ? 0n : BigInt(whole);
+  if (frac !== "" && frac[0] >= "5") n += 1n;
+  // the positive end is one below the negative's: MaxInt64 against MinInt64
+  if (n > (neg ? 9223372036854775808n : 9223372036854775807n)) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  return neg ? -n : n;
+}
