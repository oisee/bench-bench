--- /dev/null
+++ b/tools/gogen/go/abap/parsei8_test.go
@@ -0,0 +1,94 @@
+package abap
+
+import "testing"
+
+// ParseI8 is ParseI's rule on int8's range (conv.go): blanks around the
+// text, one sign anywhere, digits with at most one point rounded half away
+// from zero, and every value of the signed 64-bit range exact, both
+// endpoints included. The JS twin is js/abap.mjs ParseI8; the ABAP-level
+// walk is ZCL_GOGEN_T_C2INT8 (semantics.mjs).
+func TestParseI8(t *testing.T) {
+	for _, row := range [...]struct {
+		in   string
+		want int64
+	}{
+		{"42", 42},
+		{" 42 ", 42},
+		{"+42", 42},
+		{"-42", -42},
+		{"42-", -42},
+		{"- 42", -42},
+		{"2.5", 3},
+		{"-2.5", -3},
+		{"2.4", 2},
+		{".5", 1},
+		{"5.", 5},
+		{"-0.5", -1},
+		{"0", 0},
+		{"", 0},
+		{"   ", 0},
+		{"0012", 12},
+		{"9223372036854775807", 9223372036854775807},
+		{"+9223372036854775807", 9223372036854775807},
+		{"-9223372036854775808", -9223372036854775808},
+		// the endpoints' own fraction rounds inside, and back
+		{"9223372036854775806.5", 9223372036854775807},
+		{"-9223372036854775808.4", -9223372036854775808},
+		// leading zeros past the digits an int64 spells
+		{"00009223372036854775807", 9223372036854775807},
+	} {
+		got, err := tryParseI8(row.in)
+		if err != nil {
+			t.Errorf("ParseI8(%q) raised %v", row.in, err)
+			continue
+		}
+		if got != row.want {
+			t.Errorf("ParseI8(%q) = %d, want %d", row.in, got, row.want)
+		}
+	}
+}
+
+// no-number and overflow texts, and the class each raises
+func TestParseI8Errors(t *testing.T) {
+	for _, row := range [...]struct {
+		in, class string
+	}{
+		{"-", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"abc", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"1E3", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"12 abc", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"1,5", "CX_SY_CONVERSION_NO_NUMBER"},
+		{".", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"+-1", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"0000-9223372036854775808", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"9223372036854775808", "CX_SY_CONVERSION_OVERFLOW"},
+		{"-9223372036854775809", "CX_SY_CONVERSION_OVERFLOW"},
+		{"9223372036854775807.5", "CX_SY_CONVERSION_OVERFLOW"},
+		{"-9223372036854775808.5", "CX_SY_CONVERSION_OVERFLOW"},
+		{"99999999999999999999", "CX_SY_CONVERSION_OVERFLOW"},
+		{"00009223372036854775808", "CX_SY_CONVERSION_OVERFLOW"},
+		{"1000000000000000000000000000000000", "CX_SY_CONVERSION_OVERFLOW"},
+	} {
+		got, err := tryParseI8(row.in)
+		if err == nil {
+			t.Errorf("ParseI8(%q) = %d, want %v", row.in, got, row.class)
+			continue
+		}
+		if e, ok := err.(ArithmeticError); !ok || e.Class != row.class {
+			t.Errorf("ParseI8(%q) raised %v, want %v", row.in, err, row.class)
+		}
+	}
+}
+
+func tryParseI8(v string) (out int64, err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			if e, ok := r.(ArithmeticError); ok {
+				err = e
+				return
+			}
+			panic(r)
+		}
+	}()
+	return ParseI8(v), nil
+}
