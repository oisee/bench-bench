diff --git a/tools/gogen/go/abap/conv.go b/tools/gogen/go/abap/conv.go
index 17c7e05..b93318a 100644
--- a/tools/gogen/go/abap/conv.go
+++ b/tools/gogen/go/abap/conv.go
@@ -195,6 +195,57 @@ func ParseI(v string) int32 {
 	return int32(n)
 }
 
+// ParseI8 is ParseI for int8: the same texts are numbers, the fraction
+// rounds half away from zero, and every value of the signed 64-bit range
+// survives, both endpoints included. Past it -- a rounded value too -- is
+// CX_SY_CONVERSION_OVERFLOW. The digits are read as a uint64 so the
+// minimum's own value, 9223372036854775808, is exact before the sign is
+// applied (an int64 accumulation would wrap there).
+func ParseI8(v string) int64 {
+	const maxAbs = 1 << 63 // 9223372036854775808, |MinInt64|
+	t := strings.Trim(v, " ")
+	if t == "" {
+		return 0
+	}
+	neg, body, ok := numSign(t)
+	body = strings.Trim(body, " ")
+	if !ok || !decimalDigits(body) {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_NO_NUMBER", Op: "c->int8"})
+	}
+	whole, frac := body, ""
+	if i := strings.IndexByte(body, '.'); i >= 0 {
+		whole, frac = body[:i], body[i+1:]
+	}
+	whole = strings.TrimLeft(whole, "0")
+	// twenty digits or more cannot fit however they round (the check also
+	// keeps the accumulation below uint64's own range)
+	if len(whole) > 19 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	var n uint64
+	for i := 0; i < len(whole); i++ {
+		n = n*10 + uint64(whole[i]-'0')
+	}
+	if frac != "" && frac[0] >= '5' {
+		n++
+	}
+	// the negative end reaches one further than the positive's: MinInt64's
+	// own value is 9223372036854775808 in absolute terms
+	if neg {
+		if n > maxAbs {
+			panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+		}
+		if n == maxAbs {
+			return math.MinInt64
+		}
+		return -int64(n)
+	}
+	if n > maxAbs-1 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	return int64(n)
+}
+
 // I8ToI and F2I8: int8 into i with an overflow check, f into int8 rounded.
 func I8ToI(v int64) int32 { return check(v, "int8->i") }
 
