+CLASS zcl_gogen_t_c2int8 DEFINITION PUBLIC FINAL CREATE PUBLIC.
+* a text moved into an int8: the same texts are numbers as for i
+* (zcl_gogen_t_c2num, A4H 2026-09-23), and the whole signed 64-bit range
+* survives a move, both endpoints included -- a rounded value past it is
+* CX_SY_CONVERSION_OVERFLOW (unmeasured on A4H: the rules are i's, applied
+* to int8's documented range)
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+  PRIVATE SECTION.
+    CLASS-METHODS to_int8
+      IMPORTING iv_text   TYPE string
+      RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_c2int8 IMPLEMENTATION.
+  METHOD to_int8.
+    DATA lv_i8 TYPE int8.
+    TRY.
+        lv_i8 = iv_text.
+        rv = |{ lv_i8 }|.
+      CATCH cx_sy_conversion_no_number.
+        rv = 'NN'.
+      CATCH cx_sy_conversion_overflow.
+        rv = 'OV'.
+    ENDTRY.
+  ENDMETHOD.
+
+  METHOD run.
+    DATA lt_text TYPE STANDARD TABLE OF string WITH DEFAULT KEY.
+    DATA lv_text TYPE string.
+    APPEND `42` TO lt_text.
+    APPEND ` 42 ` TO lt_text.
+    APPEND `+42` TO lt_text.
+    APPEND `-42` TO lt_text.
+    APPEND `42-` TO lt_text.
+    APPEND `- 42` TO lt_text.
+    APPEND `2.5` TO lt_text.
+    APPEND `-2.5` TO lt_text.
+    APPEND `2.4` TO lt_text.
+    APPEND `.5` TO lt_text.
+    APPEND `5.` TO lt_text.
+    APPEND `-0.5` TO lt_text.
+    APPEND `0` TO lt_text.
+    APPEND `` TO lt_text.
+    APPEND `   ` TO lt_text.
+    APPEND `-` TO lt_text.
+    APPEND `abc` TO lt_text.
+    APPEND `1E3` TO lt_text.
+    APPEND `12 abc` TO lt_text.
+    APPEND `0012` TO lt_text.
+    APPEND `9223372036854775807` TO lt_text.
+    APPEND `+9223372036854775807` TO lt_text.
+    APPEND `-9223372036854775808` TO lt_text.
+    APPEND `9223372036854775808` TO lt_text.
+    APPEND `-9223372036854775809` TO lt_text.
+    APPEND `9223372036854775807.4` TO lt_text.
+    APPEND `9223372036854775807.5` TO lt_text.
+    APPEND `-9223372036854775808.4` TO lt_text.
+    APPEND `-9223372036854775808.5` TO lt_text.
+    APPEND `99999999999999999999` TO lt_text.
+    LOOP AT lt_text INTO lv_text.
+      rv = |{ rv }[{ lv_text }]{ to_int8( lv_text ) } |.
+    ENDLOOP.
+* an n read as a number, and the move back into a string (i82s)
+    DATA lv_n TYPE n LENGTH 4.
+    DATA lv_i8 TYPE int8.
+    DATA lv_move TYPE string.
+    lv_n = '0042'.
+    lv_i8 = lv_n.
+    lv_move = lv_i8.
+    rv = |{ rv }n:{ lv_i8 } |.
+    lv_i8 = -7.
+    lv_move = lv_i8.
+    rv = |{ rv }move:[{ lv_move }] |.
+* a text moved into generic data bound to an int8, read back in arithmetic
+    DATA lr TYPE REF TO data.
+    FIELD-SYMBOLS <fs> TYPE any.
+    lv_text = `7`.
+    CREATE DATA lr TYPE int8.
+    ASSIGN lr->* TO <fs>.
+    <fs> = lv_text.
+    lv_i8 = <fs> + 1.
+    rv = |{ rv }gen:{ lv_i8 }|.
+  ENDMETHOD.
+ENDCLASS.
