index 0000000..82ae277
--- /dev/null
+++ b/tools/gogen/go/abap/conv_i8_test.go
@@ -0,0 +1,69 @@
+package abap
+
+import (
+	"strconv"
+	"testing"
+)
+
+// ParseI8: ParseI's rule with int8's range. The semantics fixture
+// ZCL_GOGEN_T_C2I8 runs it through both emitters; this is the host
+// function itself: blanks, one sign, the fraction rounded half away from
+// zero, both endpoints exact, the classes raised past them and for
+// texts that are not numbers.
+func TestParseI8(t *testing.T) {
+	for _, c := range []struct {
+		text string
+		want int64
+	}{
+		{"12", 12},
+		{" 12 ", 12},
+		{"-12", -12},
+		{"12-", -12},
+		{"+12", 12},
+		{"", 0},
+		{"   ", 0},
+		{"0012", 12},
+		{"- 12", -12},
+		{"12 -", -12},
+		{"2.5", 3},
+		{"-2.5", -3},
+		{".5", 1},
+		{"5.", 5},
+		{"1.49999", 1},
+		{"3000000000", 3000000000},
+		{"9223372036854775807", 9223372036854775807},
+		{"-9223372036854775808", -9223372036854775808},
+		{"9223372036854775807.4", 9223372036854775807},
+		{"-9223372036854775807.5", -9223372036854775808},
+		{"-9223372036854775808.4", -9223372036854775808},
+	} {
+		if got := ParseI8(c.text); got != c.want {
+			t.Fatalf("ParseI8(%q) = %d, want %d", c.text, got, c.want)
+		}
+	}
+	for _, c := range []struct {
+		text string
+		want string
+	}{
+		{"abc", "NN"},
+		{"-", "NN"},
+		{"+", "NN"},
+		{".", "NN"},
+		{"1E3", "NN"},
+		{"12 3", "NN"},
+		{"12 abc", "NN"},
+		{"+-1", "NN"},
+		{"--1", "NN"},
+		{"-1-", "NN"},
+		{"9223372036854775808", "CO"},
+		{"-9223372036854775809", "CO"},
+		{"9223372036854775807.5", "CO"},
+		{"-9223372036854775808.5", "CO"},
+		{"99999999999999999999", "CO"},
+		{"-99999999999999999999", "CO"},
+	} {
+		if got := catch(func() string { return strconv.FormatInt(ParseI8(c.text), 10) }); got != c.want {
+			t.Fatalf("ParseI8(%q): %s, want %s", c.text, got, c.want)
+		}
+	}
+}
diff --git a/tools/gogen/js/abap.mjs b/tools/gogen/js/abap.mjs
index d4b8241..2045dc3 100644
--- a/tools/gogen/js/abap.mjs
+++ b/tools/gogen/js/abap.mjs
@@ -162,6 +162,25 @@ export function ParseI(v) {
   if (n > 2147483647 || n < -2147483648) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->i");
   return n;
 }
+// ParseI8: the same rule into int8, exact in BigInt -- both endpoints of
+// int8's range are kept, a value past them (the rounded one too) is
+// CX_SY_CONVERSION_OVERFLOW
+export function ParseI8(v) {
+  const t = v.replace(/^ +| +$/g, "");
+  if (t === "") return 0n;
+  const {neg, body: raw, ok} = numSign(t);
+  const body = raw.replace(/^ +| +$/g, "");
+  if (!ok || !decimalDigits(body)) throw new AbapError("CX_SY_CONVERSION_NO_NUMBER", "c->int8");
+  const dot = body.indexOf(".");
+  const whole = (dot < 0 ? body : body.slice(0, dot)).replace(/^0+/, "");
+  const frac = dot < 0 ? "" : body.slice(dot + 1);
+  if (whole.length > 19) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  let n = whole === "" ? 0n : BigInt(whole);
+  if (frac !== "" && frac[0] >= "5") n++;
+  if (neg) n = -n;
+  if (n > 9223372036854775807n || n < -9223372036854775808n) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  return n;
+}
