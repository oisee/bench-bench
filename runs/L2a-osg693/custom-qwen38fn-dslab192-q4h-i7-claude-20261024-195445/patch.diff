diff --git a/tools/gogen/go/abap/conv.go b/tools/gogen/go/abap/conv.go
index 17c7e05..ea9e6ac 100644
--- a/tools/gogen/go/abap/conv.go
+++ b/tools/gogen/go/abap/conv.go
@@ -195,6 +195,57 @@ func ParseI(v string) int32 {
 	return int32(n)
 }
 
+// ParseI8 converts a character value to int8: ParseI's rule -- blanks
+// around it, one sign (a leading + or -, or a trailing -), digits with at
+// most one point, no exponent -- with int8's range instead of i's. The
+// fraction rounds half away from zero; both endpoints are exact, a value
+// past them (the rounded value too) is CX_SY_CONVERSION_OVERFLOW, anything
+// else CX_SY_CONVERSION_NO_NUMBER. Blanks are 0.
+func ParseI8(v string) int64 {
+	t := strings.Trim(v, " ")
+	if t == "" {
+		return 0
+	}
+	neg, body, ok := numSign(t)
+	body = strings.Trim(body, " ")
+	if !ok || !decimalDigits(body) {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_NO_NUMBER", Op: "c->int8"})
+	}
+	whole, frac := body, ""
+	if i := strings.IndexByte(body, '.'); i >= 0 {
+		whole, frac = body[:i], body[i+1:]
+	}
+	whole = strings.TrimLeft(whole, "0")
+	if len(whole) > 19 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	// the magnitude of at most 19 digits fits uint64 (10^19 - 1 < 2^64 - 1)
+	var mag uint64
+	for i := 0; i < len(whole); i++ {
+		mag = mag*10 + uint64(whole[i]-'0')
+	}
+	if frac != "" && frac[0] >= '5' {
+		// the largest magnitude int8 can hold, rounded up: out either way
+		if mag >= 9223372036854775808 {
+			panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+		}
+		mag++
+	}
+	if neg {
+		if mag > 9223372036854775808 {
+			panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+		}
+		if mag == 9223372036854775808 {
+			return -9223372036854775808
+		}
+		return -int64(mag)
+	}
+	if mag > 9223372036854775807 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	return int64(mag)
+}
+
 // I8ToI and F2I8: int8 into i with an overflow check, f into int8 rounded.
 func I8ToI(v int64) int32 { return check(v, "int8->i") }
 
