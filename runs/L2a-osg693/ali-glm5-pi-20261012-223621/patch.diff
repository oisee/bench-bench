+* String-to-int8 conversion tests
+CLASS ltcl_int8_string_conv DEFINITION FINAL FOR TESTING
+  DURATION SHORT RISK LEVEL HARMLESS.
+  PRIVATE SECTION.
+    METHODS empty_is_zero FOR TESTING.
+    METHODS spaces_is_zero FOR TESTING.
+    METHODS positive FOR TESTING.
+    METHODS negative FOR TESTING.
+    METHODS leading_plus FOR TESTING.
+    METHODS trailing_minus FOR TESTING.
+    METHODS rounding_half_up FOR TESTING.
+    METHODS rounding_half_down FOR TESTING.
+    METHODS rounding_negative FOR TESTING.
+    METHODS max_int8 FOR TESTING.
+    METHODS min_int8 FOR TESTING.
+    METHODS overflow_positive FOR TESTING.
+    METHODS overflow_negative FOR TESTING.
+    METHODS overflow_rounded FOR TESTING.
+    METHODS no_number FOR TESTING.
+    METHODS format_back FOR TESTING.
+    METHODS format_back_negative FOR TESTING.
+    METHODS catch_overflow FOR TESTING.
+ENDCLASS.
+
+CLASS ltcl_int8_string_conv IMPLEMENTATION.
+
+  METHOD empty_is_zero.
+    DATA lv_str TYPE string VALUE ``.
+    DATA lv_int8 TYPE int8.
+    lv_int8 = lv_str.
+    cl_abap_unit_assert=>assert_equals( act = lv_int8 exp = 0 ).
+  ENDMETHOD.
+
+  METHOD spaces_is_zero.
+    DATA lv_str TYPE string VALUE `   `.
+    DATA lv_int8 TYPE int8.
+    lv_int8 = lv_str.
+    cl_abap_unit_assert=>assert_equals( act = lv_int8 exp = 0 ).
+  ENDMETHOD.
+
+  METHOD positive.
+    DATA lv_str TYPE string VALUE `42`.
+    DATA lv_int8 TYPE int8.
+    lv_int8 = lv_str.
+    cl_abap_unit_assert=>assert_equals( act = lv_int8 exp = 42 ).
+  ENDMETHOD.
+
+  METHOD negative.
+    DATA lv_str TYPE string VALUE `-42`.
+    DATA lv_int8 TYPE int8.
+    lv_int8 = lv_str.
+    cl_abap_unit_assert=>assert_equals( act = lv_int8 exp = -42 ).
+  ENDMETHOD.
+
+  METHOD leading_plus.
+    DATA lv_str TYPE string VALUE `+42`.
+    DATA lv_int8 TYPE int8.
+    lv_int8 = lv_str.
+    cl_abap_unit_assert=>assert_equals( act = lv_int8 exp = 42 ).
+  ENDMETHOD.
+
+  METHOD trailing_minus.
+    DATA lv_str TYPE string VALUE `42-`.
+    DATA lv_int8 TYPE int8.
+    lv_int8 = lv_str.
+    cl_abap_unit_assert=>assert_equals( act = lv_int8 exp = -42 ).
+  ENDMETHOD.
+
+  METHOD rounding_half_up.
+    DATA lv_str TYPE string VALUE `2.5`.
+    DATA lv_int8 TYPE int8.
+    lv_int8 = lv_str.
+    cl_abap_unit_assert=>assert_equals( act = lv_int8 exp = 3 ).
+  ENDMETHOD.
+
+  METHOD rounding_half_down.
+    DATA lv_str TYPE string VALUE `2.4`.
+    DATA lv_int8 TYPE int8.
+    lv_int8 = lv_str.
+    cl_abap_unit_assert=>assert_equals( act = lv_int8 exp = 2 ).
+  ENDMETHOD.
+
+  METHOD rounding_negative.
+    DATA lv_str TYPE string VALUE `-2.5`.
+    DATA lv_int8 TYPE int8.
+    lv_int8 = lv_str.
+    cl_abap_unit_assert=>assert_equals( act = lv_int8 exp = -3 ).
+  ENDMETHOD.
+
+  METHOD max_int8.
+    DATA lv_str TYPE string VALUE `9223372036854775807`.
+    DATA lv_int8 TYPE int8.
+    lv_int8 = lv_str.
+    cl_abap_unit_assert=>assert_equals( act = lv_int8 exp = 9223372036854775807 ).
+  ENDMETHOD.
+
+  METHOD min_int8.
+    DATA lv_str TYPE string VALUE `-9223372036854775808`.
+    DATA lv_int8 TYPE int8.
+    lv_int8 = lv_str.
+    cl_abap_unit_assert=>assert_equals( act = lv_int8 exp = -9223372036854775808 ).
+  ENDMETHOD.
+
+  METHOD overflow_positive.
+    DATA lv_str TYPE string VALUE `9223372036854775808`.
+    DATA lv_int8 TYPE int8.
+    DATA lv_caught TYPE abap_bool.
+    TRY.
+        lv_int8 = lv_str.
+      CATCH cx_sy_conversion_overflow.
+        lv_caught = abap_true.
+    ENDTRY.
+    cl_abap_unit_assert=>assert_equals( act = lv_caught exp = abap_true ).
+  ENDMETHOD.
+
+  METHOD overflow_negative.
+    DATA lv_str TYPE string VALUE `-9223372036854775809`.
+    DATA lv_int8 TYPE int8.
+    DATA lv_caught TYPE abap_bool.
+    TRY.
+        lv_int8 = lv_str.
+      CATCH cx_sy_conversion_overflow.
+        lv_caught = abap_true.
+    ENDTRY.
+    cl_abap_unit_assert=>assert_equals( act = lv_caught exp = abap_true ).
+  ENDMETHOD.
+
+  METHOD overflow_rounded.
+    DATA lv_str TYPE string VALUE `9223372036854775807.5`.
+    DATA lv_int8 TYPE int8.
+    DATA lv_caught TYPE abap_bool.
+    TRY.
+        lv_int8 = lv_str.
+      CATCH cx_sy_conversion_overflow.
+        lv_caught = abap_true.
+    ENDTRY.
+    cl_abap_unit_assert=>assert_equals( act = lv_caught exp = abap_true ).
+  ENDMETHOD.
+
+  METHOD no_number.
+    DATA lv_str TYPE string VALUE `abc`.
+    DATA lv_int8 TYPE int8.
+    DATA lv_caught TYPE abap_bool.
+    TRY.
+        lv_int8 = lv_str.
+      CATCH cx_sy_conversion_no_number.
+        lv_caught = abap_true.
+    ENDTRY.
+    cl_abap_unit_assert=>assert_equals( act = lv_caught exp = abap_true ).
+  ENDMETHOD.
+
+  METHOD format_back.
+    DATA lv_int8 TYPE int8 VALUE 42.
+    DATA lv_str TYPE string.
+    lv_str = |{ lv_int8 }|.
+    cl_abap_unit_assert=>assert_equals( act = lv_str exp = `42` ).
+  ENDMETHOD.
+
+  METHOD format_back_negative.
+    DATA lv_int8 TYPE int8 VALUE -42.
+    DATA lv_str TYPE string.
+    lv_str = |{ lv_int8 }|.
+    cl_abap_unit_assert=>assert_equals( act = lv_str exp = `-42` ).
+  ENDMETHOD.
+
+  METHOD catch_overflow.
+    DATA lv_str TYPE string VALUE `999999999999999999999999`.
+    DATA lv_int8 TYPE int8.
+    DATA lx TYPE REF TO cx_sy_conversion_overflow.
+    TRY.
+        lv_int8 = lv_str.
+        cl_abap_unit_assert=>fail( 'expected exception' ).
+      CATCH cx_sy_conversion_overflow INTO lx.
+        cl_abap_unit_assert=>assert_not_initial( lx ).
+    ENDTRY.
+  ENDMETHOD.
+
+ENDCLASS.
