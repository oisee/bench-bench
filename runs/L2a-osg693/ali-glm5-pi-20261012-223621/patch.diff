diff --git a/tools/gogen/js/abap.mjs b/tools/gogen/js/abap.mjs
index d4b8241..980b1e7 100644
--- a/tools/gogen/js/abap.mjs
+++ b/tools/gogen/js/abap.mjs
@@ -162,6 +162,46 @@ export function ParseI(v) {
   if (n > 2147483647 || n < -2147483648) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->i");
   return n;
 }
+// int8 limits as BigInts
+const MAX_I8 = 9223372036854775807n;
+const MIN_I8 = -9223372036854775808n;
+export function ParseI8(v) {
+  const t = v.replace(/^ +| +$/g, "");
+  if (t === "") return 0n;
+  const {neg, body: raw, ok} = numSign(t);
+  const body = raw.replace(/^ +| +$/g, "");
+  if (!ok || !decimalDigits(body)) throw new AbapError("CX_SY_CONVERSION_NO_NUMBER", "c->int8");
+  const dot = body.indexOf(".");
+  const whole = (dot < 0 ? body : body.slice(0, dot)).replace(/^0+/, "");
+  const frac = dot < 0 ? "" : body.slice(dot + 1);
+  // 9223372036854775807 has 19 digits, so more than 19 whole digits overflows
+  if (whole.length > 19) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  // Special case: "9223372036854775808" is MinInt64's absolute value
+  // Only valid when neg=true (so result is MinInt64)
+  if (whole === "9223372036854775808" && frac === "") {
+    if (neg) return MIN_I8;
+    throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  }
+  let n = whole === "" ? 0n : BigInt(whole);
+  // After the special case above, n must not exceed MAX_I8 for positive,
+  // and must not exceed MAX_I8+1 for negative (which we already handled)
+  if (!neg && n > MAX_I8) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  if (neg && n > MAX_I8) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  if (frac !== "" && frac[0] >= "5") {
+    // Rounding up: if n == MAX_I8 and this is not a negative number, overflow
+    // For negative numbers, MAX_I8 + 1 becomes MIN_I8 after negation
+    if (n === MAX_I8) {
+      if (!neg) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+      // neg=true and we round MAX_I8 up to (MAX_I8+1), which becomes MIN_I8
+      return MIN_I8;
+    }
+    n++;
+  }
+  if (neg) {
+    n = -n;
+  }
+  return n;
+}
 export const ToUpper = (v) => v.toUpperCase();
 export const ToLower = (v) => v.toLowerCase();
