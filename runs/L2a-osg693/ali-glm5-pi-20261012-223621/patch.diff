diff --git a/tools/gogen/go/abap/conv.go b/tools/gogen/go/abap/conv.go
index 17c7e05..85cebfd 100644
--- a/tools/gogen/go/abap/conv.go
+++ b/tools/gogen/go/abap/conv.go
@@ -195,6 +195,65 @@ func ParseI(v string) int32 {
 	return int32(n)
 }
 
+// ParseI8 converts a character value to int8, same rules as ParseI (A4H
+// parity-wave2, ZCL_GOGEN_T_C2NUM) but for the 64-bit range: blanks are 0,
+// one sign, digits with at most one point, fraction rounded half away from
+// zero, overflow raises CX_SY_CONVERSION_OVERFLOW, no number raises
+// CX_SY_CONVERSION_NO_NUMBER.
+func ParseI8(v string) int64 {
+	t := strings.Trim(v, " ")
+	if t == "" {
+		return 0
+	}
+	neg, body, ok := numSign(t)
+	body = strings.Trim(body, " ")
+	if !ok || !decimalDigits(body) {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_NO_NUMBER", Op: "c->int8"})
+	}
+	whole, frac := body, ""
+	if i := strings.IndexByte(body, '.'); i >= 0 {
+		whole, frac = body[:i], body[i+1:]
+	}
+	whole = strings.TrimLeft(whole, "0")
+	// 9223372036854775807 has 19 digits, so more than 19 whole digits overflows
+	if len(whole) > 19 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	// Special case: "9223372036854775808" is MinInt64's absolute value
+	// Only valid when neg=true (so result is MinInt64)
+	if whole == "9223372036854775808" && frac == "" {
+		if neg {
+			return math.MinInt64
+		}
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	var n int64
+	for i := 0; i < len(whole); i++ {
+		d := int64(whole[i] - '0')
+		// Check for overflow before it happens: n > (MaxInt64 - d) / 10
+		if n > (math.MaxInt64-d)/10 {
+			panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+		}
+		n = n*10 + d
+	}
+	if frac != "" && frac[0] >= '5' {
+		// Rounding up: if n == MaxInt64 and this is not a negative number, overflow
+		// For negative numbers, MaxInt64 + 1 becomes MinInt64 after negation
+		if n == math.MaxInt64 {
+			if !neg {
+				panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+			}
+			// neg=true and we round MaxInt64 up to (MaxInt64+1), which becomes MinInt64
+			return math.MinInt64
+		}
+		n++
+	}
+	if neg {
+		n = -n
+	}
+	return n
+}
+
 // I8ToI and F2I8: int8 into i with an overflow check, f into int8 rounded.
 func I8ToI(v int64) int32 { return check(v, "int8->i") }
 
