@@ -0,0 +1,95 @@
+package abap
+
+import (
+	"testing"
+
+	"osg/gogen/abaperr"
+)
+
+func TestParseI8(t *testing.T) {
+	tests := []struct {
+		in   string
+		want int64
+	}{
+		{"", 0},
+		{"   ", 0},
+		{"0", 0},
+		{"42", 42},
+		{"+42", 42},
+		{"-42", -42},
+		{"42-", -42},
+		{" 42", 42},
+		{"42 ", 42},
+		{"  42  ", 42},
+		{"2.4", 2},
+		{"2.5", 3},
+		{"-2.5", -3},
+		{"-2.4", -2},
+		{"9223372036854775807", 9223372036854775807},
+		{"-9223372036854775808", -9223372036854775808},
+		{"9223372036854775806.5", 9223372036854775807},
+		{"-9223372036854775807.5", -9223372036854775808},
+	}
+	for _, tt := range tests {
+		t.Run(tt.in, func(t *testing.T) {
+			got := ParseI8(tt.in)
+			if got != tt.want {
+				t.Errorf("ParseI8(%q) = %d, want %d", tt.in, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestParseI8Overflow(t *testing.T) {
+	tests := []string{
+		"9223372036854775808",
+		"-9223372036854775809",
+		"9223372036854775807.6",
+		"999999999999999999999999",
+		"999999999999999999999999.0",
+	}
+	for _, in := range tests {
+		defer func() {
+			r := recover()
+			if r == nil {
+				t.Errorf("ParseI8(%q) expected overflow", in)
+				return
+			}
+			e, ok := r.(abaperr.ArithmeticError)
+			if !ok || e.Class != "CX_SY_CONVERSION_OVERFLOW" {
+				t.Errorf("ParseI8(%q) expected CX_SY_CONVERSION_OVERFLOW, got %v", in, r)
+			}
+		}()
+		ParseI8(in)
+	}
+}
+
+func TestParseI8NoNumber(t *testing.T) {
+	tests := []string{
+		"abc",
+		"12abc",
+		"++42",
+		"--42",
+		"+-42",
+		"42+-",
+		"",
+	}
+	for _, in := range tests {
+		defer func() {
+			r := recover()
+			if r == nil {
+				t.Errorf("ParseI8(%q) expected no number", in)
+				return
+			}
+			e, ok := r.(abaperr.ArithmeticError)
+			if !ok || e.Class != "CX_SY_CONVERSION_NO_NUMBER" {
+				t.Errorf("ParseI8(%q) expected CX_SY_CONVERSION_NO_NUMBER, got %v", in, r)
+			}
+		}()
+		// Empty string is 0, not an error, so skip it
+		if in == "" {
+			return
+		}
+		ParseI8(in)
+	}
+}
