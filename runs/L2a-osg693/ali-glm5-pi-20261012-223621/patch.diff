diff --git a/tools/gogen/parse_i8.test.mjs b/tools/gogen/parse_i8.test.mjs
new file mode 100644
index 0000000..edcae07
--- /dev/null
+++ b/tools/gogen/parse_i8.test.mjs
@@ -0,0 +1,47 @@
+import {test} from "node:test";
+import assert from "node:assert/strict";
+import {ParseI8} from "./js/abap.mjs";
+
+test("ParseI8 basic cases", () => {
+  assert.equal(ParseI8(""), 0n);
+  assert.equal(ParseI8("   "), 0n);
+  assert.equal(ParseI8("0"), 0n);
+  assert.equal(ParseI8("42"), 42n);
+  assert.equal(ParseI8("+42"), 42n);
+  assert.equal(ParseI8("-42"), -42n);
+  assert.equal(ParseI8("42-"), -42n);
+  assert.equal(ParseI8(" 42"), 42n);
+  assert.equal(ParseI8("42 "), 42n);
+  assert.equal(ParseI8("  42  "), 42n);
+});
+
+test("ParseI8 rounding half away from zero", () => {
+  assert.equal(ParseI8("2.4"), 2n);
+  assert.equal(ParseI8("2.5"), 3n);
+  assert.equal(ParseI8("-2.5"), -3n);
+  assert.equal(ParseI8("-2.4"), -2n);
+});
+
+test("ParseI8 boundaries", () => {
+  assert.equal(ParseI8("9223372036854775807"), 9223372036854775807n);
+  assert.equal(ParseI8("-9223372036854775808"), -9223372036854775808n);
+  assert.equal(ParseI8("9223372036854775806.5"), 9223372036854775807n);
+  assert.equal(ParseI8("-9223372036854775807.5"), -9223372036854775808n);
+});
+
+test("ParseI8 overflow", () => {
+  assert.throws(() => ParseI8("9223372036854775808"), /CX_SY_CONVERSION_OVERFLOW/);
+  assert.throws(() => ParseI8("-9223372036854775809"), /CX_SY_CONVERSION_OVERFLOW/);
+  assert.throws(() => ParseI8("9223372036854775807.6"), /CX_SY_CONVERSION_OVERFLOW/);
+  assert.throws(() => ParseI8("999999999999999999999999"), /CX_SY_CONVERSION_OVERFLOW/);
+  assert.throws(() => ParseI8("999999999999999999999999.0"), /CX_SY_CONVERSION_OVERFLOW/);
+});
+
+test("ParseI8 no number", () => {
+  assert.throws(() => ParseI8("abc"), /CX_SY_CONVERSION_NO_NUMBER/);
+  assert.throws(() => ParseI8("12abc"), /CX_SY_CONVERSION_NO_NUMBER/);
+  assert.throws(() => ParseI8("++42"), /CX_SY_CONVERSION_NO_NUMBER/);
+  assert.throws(() => ParseI8("--42"), /CX_SY_CONVERSION_NO_NUMBER/);
+  assert.throws(() => ParseI8("+-42"), /CX_SY_CONVERSION_NO_NUMBER/);
+  assert.throws(() => ParseI8("42+-"), /CX_SY_CONVERSION_NO_NUMBER/);
+});
