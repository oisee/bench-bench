diff --git a/tools/gogen/parse-i8.test.mjs b/tools/gogen/parse-i8.test.mjs
new file mode 100644
index 0000000..e4e6e6f
--- /dev/null
+++ b/tools/gogen/parse-i8.test.mjs
@@ -0,0 +1,32 @@
+import {test} from "node:test";
+import assert from "node:assert/strict";
+import {AbapError, ParseI8} from "./js/abap.mjs";
+
+test("ParseI8 parses and rounds decimal text without losing int64 precision", () => {
+  const valid = new Map([
+    ["", 0n], ["   ", 0n], [" +1 ", 1n], ["1.499", 1n], ["1.5", 2n], ["-1.5", -2n],
+    [".5", 1n], ["-.5", -1n], ["5.", 5n],
+    ["+9223372036854775807.49", 9223372036854775807n],
+    ["9223372036854775807", 9223372036854775807n],
+    ["-9223372036854775808.49", -9223372036854775808n],
+    ["-9223372036854775808", -9223372036854775808n],
+    ["00000000000000000000000000000000001", 1n],
+  ]);
+  for (const [input, want] of valid) assert.equal(ParseI8(input), want, input);
+});
+
+test("ParseI8 distinguishes malformed text from rounded overflow", () => {
+  const cases = new Map([
+    ["abc", "CX_SY_CONVERSION_NO_NUMBER"], ["1.2.3", "CX_SY_CONVERSION_NO_NUMBER"],
+    ["1e2", "CX_SY_CONVERSION_NO_NUMBER"], ["1 2", "CX_SY_CONVERSION_NO_NUMBER"],
+    ["+", "CX_SY_CONVERSION_NO_NUMBER"],
+    ["9223372036854775808", "CX_SY_CONVERSION_OVERFLOW"],
+    ["9223372036854775807.5", "CX_SY_CONVERSION_OVERFLOW"],
+    ["-9223372036854775809", "CX_SY_CONVERSION_OVERFLOW"],
+    ["-9223372036854775808.5", "CX_SY_CONVERSION_OVERFLOW"],
+    ["999999999999999999999999999", "CX_SY_CONVERSION_OVERFLOW"],
+  ]);
+  for (const [input, cls] of cases) {
+    assert.throws(() => ParseI8(input), (e) => e instanceof AbapError && e.cls === cls, input);
+  }
+});
