index 0000000..e23e956
--- /dev/null
+++ b/tools/gogen/go/abap/conv_i8_test.go
@@ -0,0 +1,55 @@
+package abap
+
+import (
+	"math"
+	"testing"
+)
+
+func TestParseI8(t *testing.T) {
+	valid := map[string]int64{
+		"":                                    0,
+		"   ":                                 0,
+		" +1 ":                                1,
+		"1.499":                               1,
+		"1.5":                                 2,
+		"-1.5":                                -2,
+		".5":                                  1,
+		"-.5":                                 -1,
+		"5.":                                  5,
+		"+9223372036854775807.49":             math.MaxInt64,
+		"9223372036854775807":                 math.MaxInt64,
+		"-9223372036854775808.49":             math.MinInt64,
+		"-9223372036854775808":                math.MinInt64,
+		"00000000000000000000000000000000001": 1,
+	}
+	for input, want := range valid {
+		if got := ParseI8(input); got != want {
+			t.Errorf("ParseI8(%q) = %d, want %d", input, got, want)
+		}
+	}
+
+	for input, wantClass := range map[string]string{
+		"abc":                         "CX_SY_CONVERSION_NO_NUMBER",
+		"1.2.3":                       "CX_SY_CONVERSION_NO_NUMBER",
+		"1e2":                         "CX_SY_CONVERSION_NO_NUMBER",
+		"1 2":                         "CX_SY_CONVERSION_NO_NUMBER",
+		"+":                           "CX_SY_CONVERSION_NO_NUMBER",
+		"9223372036854775808":         "CX_SY_CONVERSION_OVERFLOW",
+		"9223372036854775807.5":       "CX_SY_CONVERSION_OVERFLOW",
+		"-9223372036854775809":        "CX_SY_CONVERSION_OVERFLOW",
+		"-9223372036854775808.5":      "CX_SY_CONVERSION_OVERFLOW",
+		"999999999999999999999999999": "CX_SY_CONVERSION_OVERFLOW",
+	} {
+		t.Run(input, func(t *testing.T) {
+			defer func() {
+				r := recover()
+				e, ok := r.(ArithmeticError)
+				if !ok || e.Class != wantClass {
+					t.Fatalf("ParseI8(%q) panic = %#v, want ArithmeticError{%s}", input, r, wantClass)
+				}
+			}()
+			_ = ParseI8(input)
+			t.Fatalf("ParseI8(%q) did not panic", input)
+		})
+	}
+}
