+++ b/tools/gogen/testdata/zcl_gogen_t_c2i8.clas.abap
@@ -0,0 +1,27 @@
+* String-to-int8 conversion: exact decimal bounds and runtime exception classes.
+CLASS zcl_gogen_t_c2i8 DEFINITION PUBLIC FINAL CREATE PUBLIC.
+ PUBLIC SECTION.
+ CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+CLASS zcl_gogen_t_c2i8 IMPLEMENTATION.
+ METHOD run.
+ DATA lv_s TYPE string.
+ DATA lv_i8 TYPE int8.
+ lv_s = '  +9223372036854775807.49  '.
+ lv_i8 = lv_s. rv = |max:{ lv_i8 }|.
+ lv_s = '-9223372036854775808.49'.
+ lv_i8 = lv_s. rv = rv && | min:{ lv_i8 }|.
+ lv_s = '2.5'. lv_i8 = lv_s. rv = rv && | ties:{ lv_i8 }|.
+ lv_s = '-2.5'. lv_i8 = lv_s. rv = rv && |,{ lv_i8 }|.
+ lv_s = '   '. lv_i8 = lv_s. rv = rv && | blank:{ lv_i8 }|.
+ lv_s = '9223372036854775807.5'.
+ TRY. lv_i8 = lv_s. rv = rv && ' bad-max'.
+ CATCH cx_sy_conversion_overflow. rv = rv && ' over:max'. ENDTRY.
+ lv_s = '-9223372036854775808.5'.
+ TRY. lv_i8 = lv_s. rv = rv && ' bad-min'.
+ CATCH cx_sy_conversion_overflow. rv = rv && ',min'. ENDTRY.
+ lv_s = 'abc'.
+ TRY. lv_i8 = lv_s. rv = rv && ' bad-number'.
+ CATCH cx_sy_conversion_no_number. rv = rv && ' no:number'. ENDTRY.
+ ENDMETHOD.
+ENDCLASS.
