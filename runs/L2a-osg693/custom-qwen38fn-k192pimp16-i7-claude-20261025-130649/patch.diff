diff --git a/tools/gogen/go/abap/conv.go b/tools/gogen/go/abap/conv.go
index 17c7e05..8186b44 100644
--- a/tools/gogen/go/abap/conv.go
+++ b/tools/gogen/go/abap/conv.go
@@ -195,6 +195,51 @@ func ParseI(v string) int32 {
 	return int32(n)
 }
 
+// ParseI8 is ParseI's rule with int8's range (SAP's character-like to
+// int8 conversion: the same text rule, the wider limit). The magnitude
+// travels unsigned, as intarith.Mul's does, so MIN keeps its own
+// magnitude: 19 digits are the widest a uint64 holds and a 20th digit
+// is out of range either way, so the accumulation never wraps. The
+// fraction rounds before the limit is judged, so a value that rounds
+// out of range overflows.
+func ParseI8(v string) int64 {
+	t := strings.Trim(v, " ")
+	if t == "" {
+		return 0
+	}
+	neg, body, ok := numSign(t)
+	body = strings.Trim(body, " ")
+	if !ok || !decimalDigits(body) {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_NO_NUMBER", Op: "c->int8"})
+	}
+	whole, frac := body, ""
+	if i := strings.IndexByte(body, '.'); i >= 0 {
+		whole, frac = body[:i], body[i+1:]
+	}
+	whole = strings.TrimLeft(whole, "0")
+	if len(whole) > 19 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	var u uint64
+	for i := 0; i < len(whole); i++ {
+		u = u*10 + uint64(whole[i]-'0')
+	}
+	if frac != "" && frac[0] >= '5' {
+		u++
+	}
+	limit := uint64(math.MaxInt64)
+	if neg {
+		limit++
+	}
+	if u > limit {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	if neg {
+		return -int64(u)
+	}
+	return int64(u)
+}
+
 // I8ToI and F2I8: int8 into i with an overflow check, f into int8 rounded.
 func I8ToI(v int64) int32 { return check(v, "int8->i") }
 
diff --git a/tools/gogen/go/abap/conv_i8_test.go b/tools/gogen/go/abap/conv_i8_test.go
new file mode 100644
index 0000000..e980af6
--- /dev/null
+++ b/tools/gogen/go/abap/conv_i8_test.go
@@ -0,0 +1,130 @@
+package abap
+
+import (
+	"math"
+	"math/rand"
+	"strconv"
+	"testing"
+)
+
+// ParseI8: the text rule ParseI was measured for (ZCL_GOGEN_T_C2NUM), at
+// int8's range. Every value inside int8 stays exact, both endpoints included;
+// a value that rounds out of it is CX_SY_CONVERSION_OVERFLOW, text that is
+// no number CX_SY_CONVERSION_NO_NUMBER. Documentation-backed rows (SAP's
+// character-like to int8 rule), the same the semantics fixture ZCL_GOGEN_T_C2INT8
+// pins for both backends.
+func TestParseI8(t *testing.T) {
+	rows := []struct{ text, want string }{
+		{"42", "42"},
+		{" 42 ", "42"},
+		{"+42", "42"},
+		{"-42", "-42"},
+		{"42-", "-42"},
+		{"- 42", "-42"},
+		{"42 -", "-42"},
+		{"00042", "42"},
+		{"", "0"},
+		{"   ", "0"},
+		{"-", "NN"},
+		{"+", "NN"},
+		{".", "NN"},
+		{"1E3", "NN"},
+		{"1e3", "NN"},
+		{"abc", "NN"},
+		{"1_0", "NN"},
+		{"0x10", "NN"},
+		{"1,5", "NN"},
+		{"12 3", "NN"},
+		{"1.5.2", "NN"},
+		{"+-1", "NN"},
+		{"-1-", "NN"},
+		{"2.5", "3"},
+		{"-2.5", "-3"},
+		{"2.4999", "2"},
+		{"2.5000", "3"},
+		{".5", "1"},
+		{"5.", "5"},
+		{"0.5", "1"},
+		{"-0.5", "-1"},
+		// int8's endpoints, and the values one past them
+		{"9223372036854775807", "9223372036854775807"},
+		{"-9223372036854775808", "-9223372036854775808"},
+		{"9223372036854775808", "CO"},
+		{"-9223372036854775809", "CO"},
+		{"9999999999999999999", "CO"},
+		{"92233720368547758070", "CO"},
+		// the fraction decides before the range is judged
+		{"9223372036854775807.4", "9223372036854775807"},
+		{"9223372036854775807.5", "CO"},
+		{"-9223372036854775808.4", "-9223372036854775808"},
+		{"-9223372036854775808.5", "CO"},
+		{"-9223372036854775807.5", "-9223372036854775808"},
+		// a leading zero does not push the digits past the range, and the
+		// digits past what a double represents exactly survive
+		{"09223372036854775807", "9223372036854775807"},
+		{"9007199254740993", "9007199254740993"},
+		{"7205000000000000001", "7205000000000000001"},
+		{"9007199254740993.5", "9007199254740994"},
+	}
+	for _, r := range rows {
+		if got := catch(func() string { return strconv.FormatInt(ParseI8(r.text), 10) }); got != r.want {
+			t.Errorf("ParseI8(%q) = %s, want %s", r.text, got, r.want)
+		}
+	}
+}
+
+// A raised error carries the ABAP class a CATCH names, so the generated
+// TRY takes it by name.
+func TestParseI8Classes(t *testing.T) {
+	for _, c := range [][2]string{
+		{"9223372036854775808", "CX_SY_CONVERSION_OVERFLOW"},
+		{"9223372036854775807.5", "CX_SY_CONVERSION_OVERFLOW"},
+		{"1E3", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"12 3", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"-", "CX_SY_CONVERSION_NO_NUMBER"},
+	} {
+		func() {
+			defer func() {
+				e, ok := recover().(ArithmeticError)
+				if !ok || e.Class != c[1] {
+					t.Errorf("ParseI8(%q): %v, want %s", c[0], e, c[1])
+				}
+			}()
+			ParseI8(c[0])
+		}()
+	}
+}
+
+// Every int8 formats back in exactly, and a text one digit wider than the
+// range overflows whichever way it is signed.
+func TestParseI8RoundTrip(t *testing.T) {
+	edges := []int64{math.MinInt64, math.MinInt64 + 1, -7205000000000000001, -1, 0, 1, 9007199254740993, 7205000000000000001, math.MaxInt64 - 1, math.MaxInt64}
+	random := rand.New(rand.NewSource(8))
+	for i := 0; i < 1000; i++ {
+		edges = append(edges, int64(random.Uint64()))
+	}
+	for _, v := range edges {
+		text := strconv.FormatInt(v, 10)
+		if got := ParseI8(text); got != v {
+			t.Fatalf("ParseI8(%q) = %d, want %d", text, got, v)
+		}
+		// a fraction below the half rounds to the same value, at the
+		// endpoints too
+		if got := ParseI8(text + ".4"); got != v {
+			t.Fatalf("ParseI8(%q) = %d, want %d", text+".4", got, v)
+		}
+	}
+	for _, v := range []int64{math.MaxInt64, math.MinInt64} {
+		// one digit past the widest int8 text, either sign
+		mag := strconv.FormatInt(v, 10)
+		if v < 0 {
+			mag = mag[1:]
+		}
+		wide := mag + "0"
+		for _, text := range []string{wide, "-" + wide} {
+			if got := catch(func() string { return strconv.FormatInt(ParseI8(text), 10) }); got != "CO" {
+				t.Fatalf("ParseI8(%q) = %s, want CO", text, got)
+			}
+		}
+	}
+}
