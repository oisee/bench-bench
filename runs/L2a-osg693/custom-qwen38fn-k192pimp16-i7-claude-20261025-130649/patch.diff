diff --git a/tools/gogen/testdata/zcl_gogen_t_c2int8.clas.abap b/tools/gogen/testdata/zcl_gogen_t_c2int8.clas.abap
new file mode 100644
index 0000000..13fa7d5
--- /dev/null
+++ b/tools/gogen/testdata/zcl_gogen_t_c2int8.clas.abap
@@ -0,0 +1,85 @@
+* A text moved into an int8: the text rule of the c to i conversion (ZCL_GOGEN_T_C2NUM)
+* with int8's range, so every value up to 9223372036854775807 and down to
+* -9223372036854775808 stays exact, and a value that rounds out of it
+* overflows. Documentation-backed (SAP's conversion rules for a character-like
+* source into int8); no new SAP measurement.
+CLASS zcl_gogen_t_c2int8 DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+  PRIVATE SECTION.
+    CLASS-METHODS to_8
+      IMPORTING iv_text   TYPE string
+      RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_c2int8 IMPLEMENTATION.
+  METHOD to_8.
+    DATA lv_i8 TYPE int8.
+    TRY.
+        lv_i8 = iv_text.
+        rv = |{ lv_i8 }|.
+      CATCH cx_sy_conversion_no_number.
+        rv = 'NN'.
+      CATCH cx_sy_conversion_overflow.
+        rv = 'OV'.
+    ENDTRY.
+  ENDMETHOD.
+
+  METHOD run.
+    DATA lt_text TYPE STANDARD TABLE OF string WITH DEFAULT KEY.
+    DATA lv_text TYPE string.
+    APPEND `42` TO lt_text.
+    APPEND ` 42 ` TO lt_text.
+    APPEND `+42` TO lt_text.
+    APPEND `-42` TO lt_text.
+    APPEND `42-` TO lt_text.
+    APPEND `- 42` TO lt_text.
+    APPEND `42 -` TO lt_text.
+    APPEND `` TO lt_text.
+    APPEND `   ` TO lt_text.
+    APPEND `-` TO lt_text.
+    APPEND `+` TO lt_text.
+    APPEND `00042` TO lt_text.
+    APPEND `2.5` TO lt_text.
+    APPEND `-2.5` TO lt_text.
+    APPEND `2.4999` TO lt_text.
+    APPEND `2.5000` TO lt_text.
+    APPEND `.5` TO lt_text.
+    APPEND `5.` TO lt_text.
+    APPEND `0.5` TO lt_text.
+    APPEND `-0.5` TO lt_text.
+    APPEND `1E3` TO lt_text.
+    APPEND `1e3` TO lt_text.
+    APPEND `abc` TO lt_text.
+    APPEND `1_0` TO lt_text.
+    APPEND `0x10` TO lt_text.
+    APPEND `1,5` TO lt_text.
+    APPEND `12 3` TO lt_text.
+    APPEND `1.5.2` TO lt_text.
+    APPEND `+-1` TO lt_text.
+    APPEND `-1-` TO lt_text.
+    APPEND `.` TO lt_text.
+* int8's endpoints and the values one past them
+    APPEND `9223372036854775807` TO lt_text.
+    APPEND `-9223372036854775808` TO lt_text.
+    APPEND `9223372036854775808` TO lt_text.
+    APPEND `-9223372036854775809` TO lt_text.
+    APPEND `9999999999999999999` TO lt_text.
+    APPEND `92233720368547758070` TO lt_text.
+* the fraction decides before the range is judged
+    APPEND `9223372036854775807.4` TO lt_text.
+    APPEND `9223372036854775807.5` TO lt_text.
+    APPEND `-9223372036854775808.4` TO lt_text.
+    APPEND `-9223372036854775808.5` TO lt_text.
+    APPEND `-9223372036854775807.5` TO lt_text.
+* a leading zero does not push the digits past the range
+    APPEND `09223372036854775807` TO lt_text.
+* a digit past what a double represents exactly survives
+    APPEND `9007199254740993` TO lt_text.
+    APPEND `7205000000000000001` TO lt_text.
+    APPEND `9007199254740993.5` TO lt_text.
+    LOOP AT lt_text INTO lv_text.
+      rv = |{ rv }[{ lv_text }]{ to_8( lv_text ) } |.
+    ENDLOOP.
+  ENDMETHOD.
+ENDCLASS.
