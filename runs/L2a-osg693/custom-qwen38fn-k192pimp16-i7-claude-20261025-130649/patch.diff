new file mode 100644
index 0000000..4dc10ba
--- /dev/null
+++ b/tools/gogen/conv-i8.test.mjs
@@ -0,0 +1,43 @@
+import {test} from "node:test";
+import assert from "node:assert/strict";
+import {ParseI8} from "./js/abap.mjs";
+
+// The text rule ParseI was measured for (ZCL_GOGEN_T_C2NUM), at int8's
+// range: documentation-backed rows (SAP's character-like to int8 rule),
+// the same go/abap/conv_i8_test.go holds for Go and the semantics fixture
+// ZCL_GOGEN_T_C2INT8 for both emitters. A BigInt carries every digit, so
+// both endpoints and the values past 2^53 stay exact.
+const OK = [
+  ["42", 42n], [" 42 ", 42n], ["+42", 42n], ["-42", -42n], ["42-", -42n], ["- 42", -42n], ["42 -", -42n], ["00042", 42n],
+  ["", 0n], ["   ", 0n],
+  ["2.5", 3n], ["-2.5", -3n], ["2.4999", 2n], ["2.5000", 3n], [".5", 1n], ["5.", 5n], ["0.5", 1n], ["-0.5", -1n],
+  ["9223372036854775807", 9223372036854775807n],
+  ["-9223372036854775808", -9223372036854775808n],
+  ["9223372036854775807.4", 9223372036854775807n],
+  ["-9223372036854775808.4", -9223372036854775808n],
+  ["-9223372036854775807.5", -9223372036854775808n],
+  ["09223372036854775807", 9223372036854775807n],
+  ["9007199254740993", 9007199254740993n],
+  ["7205000000000000001", 7205000000000000001n],
+  ["9007199254740993.5", 9007199254740994n],
+];
+const OVERFLOW = ["9223372036854775808", "-9223372036854775809", "9999999999999999999", "92233720368547758070",
+  "9223372036854775807.5", "-9223372036854775808.5", "92233720368547758070.9"];
+const NO_NUMBER = ["-", "+", ".", "1E3", "1e3", "abc", "1_0", "0x10", "1,5", "12 3", "1.5.2", "+-1", "-1-"];
+
+test("c into int8: every value in range stays exact, both endpoints included", () => {
+  for (const [text, want] of OK) assert.equal(ParseI8(text), want, text);
+  // a value that rounds to an int8 stays exact whichever way it is signed
+  for (const v of [-9223372036854775808n, -7205000000000000001n, -1n, 0n, 1n, 9007199254740993n, 7205000000000000001n, 9223372036854775807n]) {
+    const text = String(v);
+    assert.equal(ParseI8(text), v, text);
+    assert.equal(ParseI8(text + ".4"), v, text + ".4");
+  }
+  // one digit past the widest int8 text, either sign
+  for (const text of ["92233720368547758070", "-92233720368547758080"]) assert.throws(() => ParseI8(text), /CX_SY_CONVERSION_OVERFLOW/, text);
+});
+
+test("c into int8 raises the class an ABAP CATCH names", () => {
+  for (const text of OVERFLOW) assert.throws(() => ParseI8(text), /CX_SY_CONVERSION_OVERFLOW/, text);
+  for (const text of NO_NUMBER) assert.throws(() => ParseI8(text), /CX_SY_CONVERSION_NO_NUMBER/, text);
+});
