+// ParseI8 converts a character value to int8: ParseI's rule for the wider
+// range (the same texts are numbers, the fraction rounds half away from
+// zero, blanks are 0), and CX_SY_CONVERSION_OVERFLOW only past int8's
+// range, so '3000000000' fits where it is an overflow for i. The magnitude
+// goes into a uint64 -- 20 digits fit, past that ParseUint says range,
+// which is where int8's range ends too -- and the negative endpoint is
+// taken from the magnitude one out of int64 rather than negated in it.
+func ParseI8(v string) int64 {
+	t := strings.Trim(v, " ")
+	if t == "" {
+		return 0
+	}
+	neg, body, ok := numSign(t)
+	body = strings.Trim(body, " ")
+	if !ok || !decimalDigits(body) {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_NO_NUMBER", Op: "c->int8"})
+	}
+	whole, frac := body, ""
+	if i := strings.IndexByte(body, '.'); i >= 0 {
+		whole, frac = body[:i], body[i+1:]
+	}
+	whole = strings.TrimLeft(whole, "0")
+	var mag uint64
+	if whole != "" {
+		u, err := strconv.ParseUint(whole, 10, 64)
+		if err != nil {
+			panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+		}
+		mag = u
+	}
+	if frac != "" && frac[0] >= '5' {
+		mag++
+	}
+	if neg {
+		if mag > math.MaxInt64+1 {
+			panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+		}
+		if mag == math.MaxInt64+1 {
+			return math.MinInt64
+		}
+		return -int64(mag)
+	}
+	if mag > math.MaxInt64 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	return int64(mag)
+}
+
 // I8ToI and F2I8: int8 into i with an overflow check, f into int8 rounded.
 func I8ToI(v int64) int32 { return check(v, "int8->i") }
 
diff --git a/tools/gogen/go/abap/parsei8_test.go b/tools/gogen/go/abap/parsei8_test.go
new file mode 100644
index 0000000..fd7c55b
--- /dev/null
+++ b/tools/gogen/go/abap/parsei8_test.go
@@ -0,0 +1,67 @@
+package abap
+
+import (
+	"math"
+	"testing"
+)
+
+// ParseI8: the c2num rule (ParseI) with int8's range. The same values are
+// pinned through both emitters by testdata/zcl_gogen_t_c2int8 in
+// semantics.mjs; here the runtime itself, including the class of the
+// panic, which is what a CATCH cx_sy_conversion_* matches on.
+func TestParseI8(t *testing.T) {
+	for _, tc := range []struct {
+		text string
+		want int64
+	}{{"12", 12}, {" 12 ", 12}, {"-12", -12}, {"12-", -12}, {"+12", 12},
+		{"2.5", 3}, {"-2.5", -3}, {"2.4", 2}, {"-2.4", -2}, {".5", 1}, {"5.", 5},
+		{"0012", 12}, {"- 12", -12}, {"12 -", -12}, {"", 0}, {"   ", 0},
+		{"9223372036854775807", math.MaxInt64}, {"-9223372036854775808", math.MinInt64},
+		{"9223372036854775807.4", math.MaxInt64}, {"-9223372036854775808.4", math.MinInt64},
+		{"3000000000", 3000000000}, {"-3000000000", -3000000000},
+		{"9223372036854775807.4999", math.MaxInt64},
+		{"-9223372036854775808.4999", math.MinInt64},
+		{"000", 0}, {"000000000000000000000000000000000000", 0}, {"-0", 0}} {
+		if got := ParseI8(tc.text); got != tc.want {
+			t.Errorf("ParseI8(%q) = %d, want %d", tc.text, got, tc.want)
+		}
+	}
+	for _, tc := range []struct {
+		text  string
+		class string
+	}{{"9223372036854775808", "CX_SY_CONVERSION_OVERFLOW"},
+		{"-9223372036854775809", "CX_SY_CONVERSION_OVERFLOW"},
+		{"99999999999999999999", "CX_SY_CONVERSION_OVERFLOW"},
+		{"123456789012345678901", "CX_SY_CONVERSION_OVERFLOW"},
+		// a magnitude that fits a uint64 and not an int64
+		{"1844674836470000000000", "CX_SY_CONVERSION_OVERFLOW"},
+		{"-1844674836470000000000", "CX_SY_CONVERSION_OVERFLOW"},
+		// out of range only after the rounding
+		{"9223372036854775807.5", "CX_SY_CONVERSION_OVERFLOW"},
+		{"-9223372036854775808.5", "CX_SY_CONVERSION_OVERFLOW"},
+		// a magnitude just above the halfway point rounds away from zero
+		{"-9223372036854775808.5000000000000000001", "CX_SY_CONVERSION_OVERFLOW"},
+		{"abc", "CX_SY_CONVERSION_NO_NUMBER"}, {"12a", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"1E3", "CX_SY_CONVERSION_NO_NUMBER"}, {"12 3", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"+-1", "CX_SY_CONVERSION_NO_NUMBER"}, {"-", "CX_SY_CONVERSION_NO_NUMBER"},
+		{".", "CX_SY_CONVERSION_NO_NUMBER"}, {"1,5", "CX_SY_CONVERSION_NO_NUMBER"}} {
+		func() {
+			defer func() {
+				r := recover()
+				if r == nil {
+					t.Errorf("ParseI8(%q) answered instead of raising %s", tc.text, tc.class)
+					return
+				}
+				e, ok := r.(ArithmeticError)
+				if !ok {
+					t.Errorf("ParseI8(%q) panicked %v, want an ArithmeticError %s", tc.text, r, tc.class)
+					return
+				}
+				if e.Class != tc.class {
+					t.Errorf("ParseI8(%q) raised %s, want %s", tc.text, e.Class, tc.class)
+				}
+			}()
+			ParseI8(tc.text)
+		}()
+	}
+}
diff --git a/tools/gogen/js/abap.mjs b/tools/gogen/js/abap.mjs
index d4b8241..169c81d 100644
--- a/tools/gogen/js/abap.mjs
+++ b/tools/gogen/js/abap.mjs
@@ -162,6 +162,26 @@ export function ParseI(v) {
   if (n > 2147483647 || n < -2147483648) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->i");
   return n;
 }
+// text into int8, ParseI's rule for the wider range (go/abap conv.go
+// ParseI8): the same texts are numbers and round the same way (half away
+// from zero), and only a value past int8's range -- after the rounding --
+// overflows, so '3000000000' fits where it is an overflow for i. A BigInt,
+// which is how int8 is held.
+export function ParseI8(v) {
+  const t = v.replace(/^ +| +$/g, "");
+  if (t === "") return 0n;
+  const {neg, body: raw, ok} = numSign(t);
+  const body = raw.replace(/^ +| +$/g, "");
+  if (!ok || !decimalDigits(body)) throw new AbapError("CX_SY_CONVERSION_NO_NUMBER", "c->int8");
+  const dot = body.indexOf(".");
+  const whole = (dot < 0 ? body : body.slice(0, dot)).replace(/^0+/, "");
+  const frac = dot < 0 ? "" : body.slice(dot + 1);
+  let n = whole === "" ? 0n : BigInt(whole);
+  if (frac !== "" && frac[0] >= "5") n++;
+  if (neg) n = -n;
+  if (n > 9223372036854775807n || n < -9223372036854775808n) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  return n;
+}
