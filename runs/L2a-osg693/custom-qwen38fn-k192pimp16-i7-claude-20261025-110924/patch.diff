@@ -0,0 +1,81 @@
+CLASS zcl_gogen_t_c2int8 DEFINITION PUBLIC FINAL CREATE PUBLIC.
+* a text moved into an int8: ParseI's rule for the wider range (the same
+* texts are numbers, the fraction rounds half away from zero), and only a
+* value past int8's range -- after the rounding -- overflows. Unmeasured
+* on A4H: the rule is the one pinned for i (ZCL_GOGEN_T_C2NUM) with the
+* range widened, which is what the int8 endpoints ask for here.
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+  PRIVATE SECTION.
+    CLASS-METHODS to_i8
+      IMPORTING iv_text   TYPE string
+      RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_c2int8 IMPLEMENTATION.
+  METHOD to_i8.
+    DATA lv_i8 TYPE int8.
+    TRY.
+        lv_i8 = iv_text.
+        rv = |{ lv_i8 }|.
+      CATCH cx_sy_conversion_no_number.
+        rv = 'NN'.
+      CATCH cx_sy_conversion_overflow.
+        rv = 'OV'.
+    ENDTRY.
+  ENDMETHOD.
+
+  METHOD run.
+    DATA lt_text TYPE STANDARD TABLE OF string WITH DEFAULT KEY.
+    DATA lv_text TYPE string.
+    APPEND `12` TO lt_text.
+    APPEND ` 12 ` TO lt_text.
+    APPEND `-12` TO lt_text.
+    APPEND `12-` TO lt_text.
+    APPEND `+12` TO lt_text.
+    APPEND `2.5` TO lt_text.
+    APPEND `-2.5` TO lt_text.
+    APPEND `2.4` TO lt_text.
+    APPEND `-2.4` TO lt_text.
+    APPEND `.5` TO lt_text.
+    APPEND `5.` TO lt_text.
+    APPEND `0012` TO lt_text.
+    APPEND `- 12` TO lt_text.
+    APPEND `12 -` TO lt_text.
+    APPEND `` TO lt_text.
+    APPEND `   ` TO lt_text.
+    APPEND `-` TO lt_text.
+    APPEND `.` TO lt_text.
+    APPEND `abc` TO lt_text.
+    APPEND `12a` TO lt_text.
+    APPEND `1E3` TO lt_text.
+    APPEND `12 3` TO lt_text.
+    APPEND `+-1` TO lt_text.
+    APPEND `-1-` TO lt_text.
+* the endpoints of int8, both ways, and the values one out of range
+    APPEND `9223372036854775807` TO lt_text.
+    APPEND `9223372036854775808` TO lt_text.
+    APPEND `-9223372036854775808` TO lt_text.
+    APPEND `-9223372036854775809` TO lt_text.
+    APPEND `9223372036854775807.4` TO lt_text.
+    APPEND `9223372036854775807.5` TO lt_text.
+    APPEND `-9223372036854775808.5` TO lt_text.
+    APPEND `-9223372036854775808.4` TO lt_text.
+* a value past i's range is an overflow for i and fits an int8
+    APPEND `3000000000` TO lt_text.
+    APPEND `-3000000000` TO lt_text.
+* a run of zeros longer than int8 has digits, and a magnitude that fits a
+* uint64 (Go's magnitude) and not an int64
+    APPEND `00000000000000000000000000000000000000000000` TO lt_text.
+    APPEND `1844674836470000000000` TO lt_text.
+    LOOP AT lt_text INTO lv_text.
+      rv = |{ rv }[{ lv_text }]{ to_i8( lv_text ) }|.
+    ENDLOOP.
+* the result out of a template: the exact decimal digits, sign first
+    DATA lv_max TYPE int8.
+    DATA lv_min TYPE int8.
+    lv_max = 9223372036854775807.
+    lv_min = -9223372036854775808.
+    rv = |{ rv }[{ lv_max }]{ lv_min }|.
+  ENDMETHOD.
+ENDCLASS.
