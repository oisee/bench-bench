new file mode 100644
index 0000000..38aec10
--- /dev/null
+++ b/tools/gogen/parsei8.test.mjs
@@ -0,0 +1,41 @@
+import {test} from "node:test";
+import assert from "node:assert/strict";
+import {AbapError, ParseI8} from "./js/abap.mjs";
+
+// A text moved into an int8: the c2num rule with int8's range (go/abap
+// conv.go ParseI8; testdata/zcl_gogen_t_c2int8 in semantics.mjs pins the
+// same values through both emitters). The result is a BigInt, which is how
+// int8 is held, and the class of the error is what a CATCH
+// cx_sy_conversion_* matches on.
+test("ParseI8 keeps every int8 exactly", () => {
+  for (const [text, want] of [
+    ["12", 12n], [" 12 ", 12n], ["-12", -12n], ["12-", -12n], ["+12", 12n],
+    ["2.5", 3n], ["-2.5", -3n], ["2.4", 2n], ["-2.4", -2n], [".5", 1n], ["5.", 5n],
+    ["0012", 12n], ["- 12", -12n], ["12 -", -12n], ["", 0n], ["   ", 0n],
+    ["9223372036854775807", 9223372036854775807n], ["-9223372036854775808", -9223372036854775808n],
+    ["9223372036854775807.4", 9223372036854775807n], ["-9223372036854775808.4999", -9223372036854775808n],
+    ["3000000000", 3000000000n], ["-3000000000", -3000000000n],
+    ["000", 0n], ["000000000000000000000000000000000000", 0n], ["-0", 0n],
+  ]) assert.equal(ParseI8(text), want, text);
+});
+
+test("ParseI8 raises what a CATCH of the conversion classes takes", () => {
+  for (const [text, cls] of [
+    ["9223372036854775808", "CX_SY_CONVERSION_OVERFLOW"],
+    ["-9223372036854775809", "CX_SY_CONVERSION_OVERFLOW"],
+    ["123456789012345678901", "CX_SY_CONVERSION_OVERFLOW"],
+    ["1844674836470000000000", "CX_SY_CONVERSION_OVERFLOW"], ["-1844674836470000000000", "CX_SY_CONVERSION_OVERFLOW"],
+    ["9223372036854775807.5", "CX_SY_CONVERSION_OVERFLOW"],
+    ["-9223372036854775808.5", "CX_SY_CONVERSION_OVERFLOW"],
+    ["-9223372036854775808.5000000000000000001", "CX_SY_CONVERSION_OVERFLOW"],
+    ["abc", "CX_SY_CONVERSION_NO_NUMBER"], ["12a", "CX_SY_CONVERSION_NO_NUMBER"],
+    ["1E3", "CX_SY_CONVERSION_NO_NUMBER"], ["12 3", "CX_SY_CONVERSION_NO_NUMBER"],
+    ["+-1", "CX_SY_CONVERSION_NO_NUMBER"], ["-", "CX_SY_CONVERSION_NO_NUMBER"],
+    [".", "CX_SY_CONVERSION_NO_NUMBER"], ["1,5", "CX_SY_CONVERSION_NO_NUMBER"],
+  ]) {
+    let got = null;
+    try { ParseI8(text); } catch (e) { got = e; }
+    assert.ok(got instanceof AbapError, `${text}: no error`);
+    assert.equal(got.cls, cls, text);
+  }
+});
