@@ -0,0 +1,68 @@
+CLASS zcl_gogen_t_c2int8 DEFINITION PUBLIC FINAL CREATE PUBLIC.
+* a text moved into an int8: the c2num rules of ZCL_GOGEN_T_C2NUM over the
+* int8 range -- both endpoints exact, a value past them (also one the
+* rounding carries into) is CX_SY_CONVERSION_OVERFLOW, anything that is no
+* number CX_SY_CONVERSION_NO_NUMBER; the template writes plain decimal digits
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+  PRIVATE SECTION.
+    CLASS-METHODS to_i8
+      IMPORTING iv_text   TYPE string
+      RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_c2int8 IMPLEMENTATION.
+  METHOD to_i8.
+    DATA lv_i8 TYPE int8.
+    TRY.
+        lv_i8 = iv_text.
+        rv = |{ lv_i8 }|.
+      CATCH cx_sy_conversion_no_number.
+        rv = 'NN'.
+      CATCH cx_sy_conversion_overflow.
+        rv = 'OV'.
+    ENDTRY.
+  ENDMETHOD.
+
+  METHOD run.
+    DATA lt_text TYPE STANDARD TABLE OF string WITH DEFAULT KEY.
+    DATA lv_text TYPE string.
+    APPEND `12` TO lt_text.
+    APPEND ` 12 ` TO lt_text.
+    APPEND `-12` TO lt_text.
+    APPEND `12-` TO lt_text.
+    APPEND `+12` TO lt_text.
+    APPEND `2.5` TO lt_text.
+    APPEND `-2.5` TO lt_text.
+    APPEND `.5` TO lt_text.
+    APPEND `5.` TO lt_text.
+    APPEND `1.49999` TO lt_text.
+    APPEND `0.5` TO lt_text.
+    APPEND `-0.5` TO lt_text.
+    APPEND `- 12` TO lt_text.
+    APPEND `12 -` TO lt_text.
+    APPEND `0012` TO lt_text.
+    APPEND `` TO lt_text.
+    APPEND `   ` TO lt_text.
+* past i, an int8 like any other
+    APPEND `3000000000` TO lt_text.
+* the endpoints, exact, and one tenth away from tipping over
+    APPEND `9223372036854775807` TO lt_text.
+    APPEND `-9223372036854775808` TO lt_text.
+    APPEND `9223372036854775807.4` TO lt_text.
+    APPEND `-9223372036854775808.4` TO lt_text.
+* the range, the rounding, the 20 digits no int8 can hold
+    APPEND `9223372036854775808` TO lt_text.
+    APPEND `-9223372036854775809` TO lt_text.
+    APPEND `9223372036854775807.5` TO lt_text.
+    APPEND `-9223372036854775808.5` TO lt_text.
+    APPEND `99999999999999999999` TO lt_text.
+* no number: an exponent, letters, a blank inside
+    APPEND `1E3` TO lt_text.
+    APPEND `abc` TO lt_text.
+    APPEND `12 3` TO lt_text.
+    LOOP AT lt_text INTO lv_text.
+      rv = |{ rv }[{ lv_text }]{ to_i8( lv_text ) } |.
+    ENDLOOP.
+  ENDMETHOD.
+ENDCLASS.
