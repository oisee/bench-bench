@@ -0,0 +1,60 @@
+package abap
+
+import "testing"
+
+// text into int8: the ParseI rules (measured as ZCL_GOGEN_T_C2NUM on A4H)
+// over the int8 range, the endpoints exact, the fraction half away from zero
+func TestParseI8(t *testing.T) {
+	cases := []struct {
+		v    string
+		want int64
+	}{
+		{"12", 12}, {" 12 ", 12}, {"-12", -12}, {"12-", -12}, {"+12", 12},
+		{"0012", 12}, {"", 0}, {"   ", 0},
+		{"2.5", 3}, {"-2.5", -3}, {".5", 1}, {"5.", 5}, {"1.49999", 1}, {"0.5", 1}, {"-0.5", -1},
+		{"- 12", -12}, {"12 -", -12}, {" -12 ", -12},
+		{"3000000000", 3000000000}, // past i, an int8 like any other
+		{"9223372036854775807", 9223372036854775807},
+		{"-9223372036854775808", -9223372036854775808},
+		{"9223372036854775807.4", 9223372036854775807},
+		{"-9223372036854775808.4", -9223372036854775808},
+		{"0009223372036854775807", 9223372036854775807},
+	}
+	for _, c := range cases {
+		if got := ParseI8(c.v); got != c.want {
+			t.Errorf("ParseI8(%q) = %d, want %d", c.v, got, c.want)
+		}
+	}
+}
+
+// the classes raised at the edges: OV past the range (also what the
+// rounding carries into), NN for anything else that is no number (catch's
+// abbreviations, packed_test.go)
+func TestParseI8Raises(t *testing.T) {
+	cases := map[string]string{
+		"9223372036854775808":    "CO",
+		"-9223372036854775809":   "CO",
+		"99999999999999999999":   "CO",
+		"9223372036854775807.5":  "CO",
+		"-9223372036854775808.5": "CO",
+		"1E3":                    "NN",
+		"abc":                    "NN",
+		"1_0":                    "NN",
+		"0x10":                   "NN",
+		"12 3":                   "NN",
+		"-":                      "NN",
+		"+":                      "NN",
+		".":                      "NN",
+		"1.5.2":                  "NN",
+		"+-1":                    "NN",
+		"-1-":                    "NN",
+	}
+	for in, want := range cases {
+		if got := catch(func() string {
+			ParseI8(in)
+			return "none"
+		}); got != want {
+			t.Errorf("ParseI8(%q) = %s, want %s", in, got, want)
+		}
+	}
+}
