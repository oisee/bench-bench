+// ParseI8 is ParseI's text rules over the int8 range: blanks around, one
+// sign, digits with at most one point, the fraction rounded half away from
+// zero -- and both endpoints kept exactly, the magnitude of MinInt64
+// included. A value outside the range, also after the rounding, is
+// CX_SY_CONVERSION_OVERFLOW; anything that is not such a number is
+// CX_SY_CONVERSION_NO_NUMBER. Blanks are 0.
+func ParseI8(v string) int64 {
+	t := strings.Trim(v, " ")
+	if t == "" {
+		return 0
+	}
+	neg, body, ok := numSign(t)
+	body = strings.Trim(body, " ")
+	if !ok || !decimalDigits(body) {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_NO_NUMBER", Op: "c->int8"})
+	}
+	whole, frac := body, ""
+	if i := strings.IndexByte(body, '.'); i >= 0 {
+		whole, frac = body[:i], body[i+1:]
+	}
+	whole = strings.TrimLeft(whole, "0")
+	// nineteen digits is int8's widest text: more cannot fit whatever they
+	// say, and nineteen fit in the uint64 the magnitude accumulates into
+	if len(whole) > 19 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	var n uint64
+	for i := 0; i < len(whole); i++ {
+		n = n*10 + uint64(whole[i]-'0')
+	}
+	if frac != "" && frac[0] >= '5' {
+		n++
+	}
+	// the negative side owns one magnitude past MaxInt64: MinInt64's
+	const minMag = uint64(math.MaxInt64) + 1
+	if neg {
+		if n > minMag {
+			panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+		}
+		if n == minMag {
+			return math.MinInt64
+		}
+		return -int64(n)
+	}
+	if n > math.MaxInt64 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	return int64(n)
+}
+
 // I8ToI and F2I8: int8 into i with an overflow check, f into int8 rounded.
 func I8ToI(v int64) int32 { return check(v, "int8->i") }
 
