diff --git a/tools/gogen/parsei8.test.mjs b/tools/gogen/parsei8.test.mjs
new file mode 100644
index 0000000..819c2a9
--- /dev/null
+++ b/tools/gogen/parsei8.test.mjs
@@ -0,0 +1,91 @@
+import {test} from "node:test";
+import assert from "node:assert/strict";
+import {spawnSync} from "node:child_process";
+import {mkdtempSync, rmSync, writeFileSync} from "node:fs";
+import {basename, join} from "node:path";
+import {compileProgram} from "./frontend.mjs";
+import {emitGo} from "./emit-go.mjs";
+import {emitJs} from "./emit-js.mjs";
+import {AbapError, ParseI8} from "./js/abap.mjs";
+import {libraryPath} from "../osd-lib-path.mjs";
+import {home} from "./home.mjs";
+
+const here = import.meta.dirname;
+const values = [
+  ["", "0"], ["   ", "0"], [" +12 ", "12"], [" -12 ", "-12"],
+  ["12-", "-12"], ["- 12", "-12"], ["12 -", "-12"],
+  ["2.5", "3"], ["-2.5", "-3"], [".5", "1"], ["-.5", "-1"],
+  ["5.", "5"], ["-0.49", "0"], ["1.499999999999999999999", "1"],
+  ["9007199254740993", "9007199254740993"],
+  ["9007199254740993.5", "9007199254740994"],
+  ["9223372036854775807", "9223372036854775807"],
+  ["-9223372036854775808", "-9223372036854775808"],
+  ["9223372036854775806.5", "9223372036854775807"],
+  ["-9223372036854775807.5", "-9223372036854775808"],
+  ["9223372036854775807.49999999999999999999", "9223372036854775807"],
+  ["-9223372036854775808.49999999999999999999", "-9223372036854775808"],
+  ["0".repeat(1000) + "42.50", "43"],
+];
+const errors = [
+  ["CX_SY_CONVERSION_OVERFLOW", ["9223372036854775808", "-9223372036854775809",
+    "9223372036854775807.5", "-9223372036854775808.5", "9999999999999999999.5", "9".repeat(1000)]],
+  ["CX_SY_CONVERSION_NO_NUMBER", ["abc", "-", "+", ".", "1.2.3", "12 3", "12 abc", "+-1", "-1-",
+    "1E3", "0x10", "1_0", "1,5", "nan", "Infinity", "\t12", "12\n", "9".repeat(1000) + "x"]],
+];
+
+test("ParseI8 preserves int64 values and rounds decimal text exactly", () => {
+  for (const [text, want] of values) assert.equal(ParseI8(text), BigInt(want), text);
+  for (const [cls, texts] of errors) for (const text of texts)
+    assert.throws(() => ParseI8(text), (e) => e instanceof AbapError && e.cls === cls, text);
+});
+
+test("generated Go and JS assign string to int8, format it exactly, and catch conversion errors", async () => {
+  const sourceDir = mkdtempSync(join(here, "testdata-parsei8-"));
+  const goDir = mkdtempSync(join(here, "go", "cmd", "gogen-parsei8-test-"));
+  try {
+    writeFileSync(join(sourceDir, "zcl_gogen_parsei8.clas.abap"), `
+CLASS zcl_gogen_parsei8 DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run IMPORTING iv_text TYPE string RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+CLASS zcl_gogen_parsei8 IMPLEMENTATION.
+  METHOD run.
+    DATA lv TYPE int8.
+    TRY.
+        lv = iv_text.
+        rv = |{ lv }|.
+      CATCH cx_sy_conversion_overflow.
+        rv = 'CX_SY_CONVERSION_OVERFLOW'.
+      CATCH cx_sy_conversion_no_number.
+        rv = 'CX_SY_CONVERSION_NO_NUMBER'.
+    ENDTRY.
+  ENDMETHOD.
+ENDCLASS.
+`);
+    const program = compileProgram({folders: [libraryPath(home, "open-abap-core"), sourceDir], objects: ["ZCL_GOGEN_PARSEI8"]});
+    assert.deepEqual(program.partial, []);
+    const rows = [...values, ...errors.flatMap(([cls, texts]) => texts.map((text) => [text, cls]))];
+    const js = emitJs(program, new URL("./js/abap.mjs", import.meta.url).href);
+    const m = await import(`data:text/javascript;base64,${Buffer.from(js).toString("base64")}`);
+    for (const [text, want] of rows)
+      assert.equal(m.ZCL_GOGEN_PARSEI8.RUN({sy: {}}, text), want, text);
+    writeFileSync(join(goDir, "zz_generated.go"), emitGo(program));
+    writeFileSync(join(goDir, "zz_generated_test.go"), `package main
+import ("testing"; "osg/gogen/abap")
+func TestConversion(t *testing.T) {
+  for _, row := range [][2]string{${rows.map(([text, want]) => `{${JSON.stringify(text)}, ${JSON.stringify(want)}}`).join(",\n")}} {
+    if got := ZCL_GOGEN_PARSEI8_RUN(&abap.Session{}, row[0]); got != row[1] {
+      t.Fatalf("%q: got %q, want %q", row[0], got, row[1])
+    }
+  }
+}
+`);
+    const run = spawnSync("go", ["test", `./cmd/${basename(goDir)}`], {
+      cwd: join(here, "go"), encoding: "utf8", timeout: 120000,
+    });
+    assert.equal(run.status, 0, run.stdout + run.stderr);
+  } finally {
+    rmSync(sourceDir, {recursive: true, force: true});
+    rmSync(goDir, {recursive: true, force: true});
+  }
+});
