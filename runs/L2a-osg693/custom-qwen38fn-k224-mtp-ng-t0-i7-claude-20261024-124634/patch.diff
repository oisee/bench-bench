+// ParseI8 converts a character value to int8: the rules of ParseI with int8's
+// range (the same c2n of a text, ZCL_GOGEN_T_C2NUM's to_8). Every value of
+// the signed 64-bit range is kept exactly, both endpoints included; a value
+// past it -- after the rounding of the fraction -- is CX_SY_CONVERSION_OVERFLOW,
+// anything that is not a number CX_SY_CONVERSION_NO_NUMBER.
+func ParseI8(v string) int64 {
+	t := strings.Trim(v, " ")
+	if t == "" {
+		return 0
+	}
+	neg, body, ok := numSign(t)
+	body = strings.Trim(body, " ")
+	if !ok || !decimalDigits(body) {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_NO_NUMBER", Op: "c->int8"})
+	}
+	whole, frac := body, ""
+	if i := strings.IndexByte(body, '.'); i >= 0 {
+		whole, frac = body[:i], body[i+1:]
+	}
+	whole = strings.TrimLeft(whole, "0")
+	if len(whole) > 19 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	// 19 digits fit a uint64, so the magnitude is counted unsigned and only
+	// turned signed after the rounding, against the two endpoints
+	var n uint64
+	for i := 0; i < len(whole); i++ {
+		n = n*10 + uint64(whole[i]-'0')
+	}
+	if frac != "" && frac[0] >= '5' {
+		n++
+	}
+	if neg {
+		if n > 9223372036854775808 {
+			panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+		}
+		if n == 9223372036854775808 {
+			return math.MinInt64
+		}
+		return -int64(n)
+	}
+	if n > 9223372036854775807 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	return int64(n)
+}
+
 // I8ToI and F2I8: int8 into i with an overflow check, f into int8 rounded.
 func I8ToI(v int64) int32 { return check(v, "int8->i") }
 
