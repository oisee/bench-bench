diff --git a/tools/gogen/go/abap/parsei8_test.go b/tools/gogen/go/abap/parsei8_test.go
new file mode 100644
index 0000000..22af0ad
--- /dev/null
+++ b/tools/gogen/go/abap/parsei8_test.go
@@ -0,0 +1,142 @@
+package abap
+
+import (
+	"math"
+	"testing"
+)
+
+func TestParseI8(t *testing.T) {
+	tests := []struct {
+		in   string
+		want int64
+	}{
+		{"", 0},
+		{"   ", 0},
+		{"0", 0},
+		{"42", 42},
+		{"-42", -42},
+		{"+42", 42},
+		{"  42  ", 42},
+		{"  -42  ", -42},
+		{"- 42", -42},
+		{"42-", -42}, // trailing minus sign
+		{"9223372036854775807", math.MaxInt64},
+		{"-9223372036854775808", math.MinInt64},
+		{"+9223372036854775807", math.MaxInt64},
+		{"0000000000000000042", 42},
+		{"3.14", 3},
+		{"3.5", 4},
+		{"-3.5", -4},
+		{"2.5", 3},
+		{"-2.5", -3},
+		{"0.5", 1},
+		{"-0.5", -1},
+		{"0.4", 0},
+		{"-0.4", 0},
+	}
+	for _, tt := range tests {
+		got := ParseI8(tt.in)
+		if got != tt.want {
+			t.Errorf("ParseI8(%q) = %d, want %d", tt.in, got, tt.want)
+		}
+	}
+}
+
+func TestParseI8Overflow(t *testing.T) {
+	overflows := []string{
+		"9223372036854775808",
+		"-9223372036854775809",
+		"99999999999999999999",
+		"10000000000000000000",
+	}
+	for _, s := range overflows {
+		func() {
+			defer func() {
+				r := recover()
+				if r == nil {
+					t.Errorf("ParseI8(%q) should have panicked", s)
+					return
+				}
+				e, ok := r.(ArithmeticError)
+				if !ok || e.Class != "CX_SY_CONVERSION_OVERFLOW" {
+					t.Errorf("ParseI8(%q) panic = %v, want CX_SY_CONVERSION_OVERFLOW", s, r)
+				}
+			}()
+			ParseI8(s)
+		}()
+	}
+}
+
+func TestParseI8NoNumber(t *testing.T) {
+	noNumbers := []string{
+		"abc",
+		"12abc",
+		"++5",
+		"--5",
+		"+-5",
+		".",
+	}
+	for _, s := range noNumbers {
+		func() {
+			defer func() {
+				r := recover()
+				if r == nil {
+					t.Errorf("ParseI8(%q) should have panicked", s)
+					return
+				}
+				e, ok := r.(ArithmeticError)
+				if !ok || e.Class != "CX_SY_CONVERSION_NO_NUMBER" {
+					t.Errorf("ParseI8(%q) panic = %v, want CX_SY_CONVERSION_NO_NUMBER", s, r)
+				}
+			}()
+			ParseI8(s)
+		}()
+	}
+}
+
+func TestParseI8ExactEndpoints(t *testing.T) {
+	// Verify both endpoints are preserved exactly
+	if v := ParseI8("9223372036854775807"); v != math.MaxInt64 {
+		t.Errorf("max int64: got %d", v)
+	}
+	if v := ParseI8("-9223372036854775808"); v != math.MinInt64 {
+		t.Errorf("min int64: got %d", v)
+	}
+}
+
+func TestParseI8RoundedOverflow(t *testing.T) {
+	// 9223372036854775807.5 rounds to 9223372036854775808 which overflows
+	func() {
+		defer func() {
+			r := recover()
+			if r == nil {
+				t.Error("ParseI8(9223372036854775807.5) should have panicked")
+				return
+			}
+			e, ok := r.(ArithmeticError)
+			if !ok || e.Class != "CX_SY_CONVERSION_OVERFLOW" {
+				t.Errorf("ParseI8(9223372036854775807.5) panic = %v, want CX_SY_CONVERSION_OVERFLOW", r)
+			}
+		}()
+		ParseI8("9223372036854775807.5")
+	}()
+	// -9223372036854775808.5 rounds to -9223372036854775809 which overflows
+	func() {
+		defer func() {
+			r := recover()
+			if r == nil {
+				t.Error("ParseI8(-9223372036854775808.5) should have panicked")
+				return
+			}
+			e, ok := r.(ArithmeticError)
+			if !ok || e.Class != "CX_SY_CONVERSION_OVERFLOW" {
+				t.Errorf("ParseI8(-9223372036854775808.5) panic = %v, want CX_SY_CONVERSION_OVERFLOW", r)
+			}
+		}()
+		ParseI8("-9223372036854775808.5")
+	}()
+	// -9223372036854775807.5 rounds to -9223372036854775808 which is exactly MinInt64, should NOT overflow
+	if v := ParseI8("-9223372036854775807.5"); v != math.MinInt64 {
+		t.Errorf("ParseI8(-9223372036854775807.5) = %d, want %d", v, math.MinInt64)
+	}
+}
