diff --git a/tools/gogen/go/abap/conv.go b/tools/gogen/go/abap/conv.go
index 17c7e05..b6ddcf0 100644
--- a/tools/gogen/go/abap/conv.go
+++ b/tools/gogen/go/abap/conv.go
@@ -195,6 +195,54 @@ func ParseI(v string) int32 {
 	return int32(n)
 }
 
+// ParseI8 is ParseI read at int8's width: the same rule -- blanks, one sign,
+// digits with at most one point, rounded half away from zero, blanks are 0 --
+// with int8's range, so the whole part must be read as a magnitude rather
+// than as an int32, and the range is checked after the rounding: 9223372036854775807
+// and -9223372036854775808 are exact, and a value the rounding carries past
+// either is CX_SY_CONVERSION_OVERFLOW. Not measured on A4H; the rule is the
+// one parity-wave2 measured for i, at the documented width of int8.
+func ParseI8(v string) int64 {
+	t := strings.Trim(v, " ")
+	if t == "" {
+		return 0
+	}
+	neg, body, ok := numSign(t)
+	body = strings.Trim(body, " ")
+	if !ok || !decimalDigits(body) {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_NO_NUMBER", Op: "c->int8"})
+	}
+	whole, frac := body, ""
+	if i := strings.IndexByte(body, '.'); i >= 0 {
+		whole, frac = body[:i], body[i+1:]
+	}
+	whole = strings.TrimLeft(whole, "0")
+	if len(whole) > 19 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	var mag uint64
+	for i := 0; i < len(whole); i++ {
+		mag = mag*10 + uint64(whole[i]-'0')
+	}
+	if frac != "" && frac[0] >= '5' {
+		mag += 1
+	}
+	var limit uint64 = uint64(math.MaxInt64)
+	if neg {
+		limit += 1
+	}
+	if mag > limit {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	if neg && mag == limit {
+		return math.MinInt64
+	}
+	if neg {
+		return -int64(mag)
+	}
+	return int64(mag)
+}
+
 // I8ToI and F2I8: int8 into i with an overflow check, f into int8 rounded.
 func I8ToI(v int64) int32 { return check(v, "int8->i") }
 
diff --git a/tools/gogen/go/abap/parsei8_test.go b/tools/gogen/go/abap/parsei8_test.go
new file mode 100644
index 0000000..8816e39
--- /dev/null
+++ b/tools/gogen/go/abap/parsei8_test.go
@@ -0,0 +1,33 @@
+package abap
+
+import (
+	"strconv"
+	"testing"
+)
+
+// ParseI8 read at int8's width: the rule parity-wave2 measured for i
+// (ZCL_GOGEN_T_C2NUM), the documented range of int8, so both endpoints are
+// exact and the rounding can carry past the maximum. Not measured on A4H:
+// these are the rule, and the same ones the harness fixture zcl_gogen_t_c2int8
+// answers as ABAP in both emitters.
+func TestParseI8(t *testing.T) {
+	for in, w := range map[string]string{
+		"12": "12", " 12 ": "12", "-12": "-12", "12-": "-12", "+12": "12",
+		"2.5": "3", "-2.5": "-3", ".5": "1", "5.": "5", "0012": "12", "1.49999": "1", "1.5-": "-2",
+		"": "0", "   ": "0", "-": "NN", "+": "NN", ".": "NN", "+-1": "NN", "--1": "NN", "-1-": "NN",
+		"1E3": "NN", "1,5": "NN", "12 3": "NN", "12 abc": "NN", "abc": "NN", "12a": "NN", "0x10": "NN", "1_0": "NN",
+		"- 12": "-12", "12 -": "-12", " -12 ": "-12",
+		// int8's own width: past i's range but exact here, both endpoints, and
+		// the rounding carries past the maximum
+		"2147483648": "2147483648", "1234567890123456789": "1234567890123456789",
+		"9223372036854775807": "9223372036854775807", "-9223372036854775808": "-9223372036854775808",
+		"9223372036854775807.4": "9223372036854775807", "-9223372036854775808.4": "-9223372036854775808",
+		"9223372036854775808": "CO", "-9223372036854775809": "CO", "9223372036854775807.5": "CO",
+		"-9223372036854775808.5": "CO", "12345678901234567890": "CO",
+	} {
+		g := catch(func() string { return strconv.FormatInt(ParseI8(in), 10) })
+		if g != w {
+			t.Fatalf("ParseI8(%s) = %s, want %s", in, g, w)
+		}
+	}
+}
diff --git a/tools/gogen/js/abap.mjs b/tools/gogen/js/abap.mjs
index d4b8241..73bab86 100644
--- a/tools/gogen/js/abap.mjs
+++ b/tools/gogen/js/abap.mjs
@@ -162,6 +162,25 @@ export function ParseI(v) {
   if (n > 2147483647 || n < -2147483648) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->i");
   return n;
 }
+// ParseI8 is ParseI read at int8's width (the same rule, the documented range
+// of int8: both endpoints exact, so the whole part is read as a BigInt and the
+// range is checked after the rounding). Not measured on A4H.
+export function ParseI8(v) {
+  const t = v.replace(/^ +| +$/g, "");
+  if (t === "") return 0n;
+  const {neg, body: raw, ok} = numSign(t);
+  const body = raw.replace(/^ +| +$/g, "");
+  if (!ok || !decimalDigits(body)) throw new AbapError("CX_SY_CONVERSION_NO_NUMBER", "c->int8");
+  const dot = body.indexOf(".");
+  const whole = (dot < 0 ? body : body.slice(0, dot)).replace(/^0+/, "");
+  const frac = dot < 0 ? "" : body.slice(dot + 1);
+  if (whole.length > 19) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  let n = whole === "" ? 0n : BigInt(whole);
+  if (frac !== "" && frac[0] >= "5") n += 1n;
+  if (neg) n = -n;
+  if (n > MAX8 || n < MIN8) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  return n;
+}
