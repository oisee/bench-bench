diff --git a/tools/gogen/go/abap/conv.go b/tools/gogen/go/abap/conv.go
index 17c7e05..e189d94 100644
--- a/tools/gogen/go/abap/conv.go
+++ b/tools/gogen/go/abap/conv.go
@@ -195,6 +195,77 @@ func ParseI(v string) int32 {
 	return int32(n)
 }
 
+// ParseI8 converts a character value to int8, as ParseI does for i, over
+// int8's range: the same texts (blanks around, one sign, a blank between the
+// sign and the digits, digits with at most one point), the same rounding
+// (half away from zero), and the same exceptions. Every value in the signed
+// 64-bit range is exact, both endpoints included; a value past it -- a
+// rounded value too -- is CX_SY_CONVERSION_OVERFLOW, anything that is not a
+// number CX_SY_CONVERSION_NO_NUMBER. Blanks are 0.
+func ParseI8(v string) int64 {
+	t := strings.Trim(v, " ")
+	if t == "" {
+		return 0
+	}
+	neg, body, ok := numSign(t)
+	body = strings.Trim(body, " ")
+	if !ok || !decimalDigits(body) {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_NO_NUMBER", Op: "c->int8"})
+	}
+	whole, frac := body, ""
+	if i := strings.IndexByte(body, '.'); i >= 0 {
+		whole, frac = body[:i], body[i+1:]
+	}
+	whole = strings.TrimLeft(whole, "0")
+	// the magnitude, rounded half away from zero before the range is judged
+	if frac != "" && frac[0] >= '5' {
+		whole = addOne(whole)
+	}
+	// the magnitude's bound: 9223372036854775807 for +, 9223372036854775808 for -
+	bound := "9223372036854775807"
+	if neg {
+		bound = "9223372036854775808"
+	}
+	if magExceeds(whole, bound) {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	// the minimum's magnitude is one past MaxInt64 and would not fit the
+	// accumulation below, so it is returned as itself
+	if neg && whole == "9223372036854775808" {
+		return math.MinInt64
+	}
+	var n int64
+	for i := 0; i < len(whole); i++ {
+		n = n*10 + int64(whole[i]-'0')
+	}
+	if neg {
+		n = -n
+	}
+	return n
+}
+
+// addOne increments a digit string without leading zeros; "" is 0.
+func addOne(d string) string {
+	b := []byte(d)
+	i := len(b) - 1
+	for ; i >= 0 && b[i] == '9'; i-- {
+		b[i] = '0'
+	}
+	if i < 0 {
+		return "1" + string(b)
+	}
+	b[i]++
+	return string(b)
+}
+
+// magExceeds is a > b for two digit strings without leading zeros
+func magExceeds(a, b string) bool {
+	if len(a) != len(b) {
+		return len(a) > len(b)
+	}
+	return a > b
+}
+
 // I8ToI and F2I8: int8 into i with an overflow check, f into int8 rounded.
 func I8ToI(v int64) int32 { return check(v, "int8->i") }
 
diff --git a/tools/gogen/go/abap/parsei8_test.go b/tools/gogen/go/abap/parsei8_test.go
new file mode 100644
index 0000000..6af3b45
--- /dev/null
+++ b/tools/gogen/go/abap/parsei8_test.go
@@ -0,0 +1,95 @@
+package abap
+
+import "testing"
+
+// ParseI8: string to int8, exact over the whole signed 64-bit range, rounded
+// half away from zero, with the two conversion exceptions (go/abap conv.go).
+func TestParseI8(t *testing.T) {
+	for _, tc := range []struct {
+		v    string
+		want int64
+	}{
+		{"", 0},
+		{"   ", 0},
+		{"0", 0},
+		{"000", 0},
+		{"12", 12},
+		{" 12 ", 12},
+		{"-12", -12},
+		{"12-", -12},
+		{"+12", 12},
+		{"- 12", -12},
+		{"12 -", -12},
+		{"2.5", 3},
+		{"-2.5", -3},
+		{".5", 1},
+		{"-.5", -1},
+		{"0.5", 1},
+		{"5.", 5},
+		{"2.4999", 2},
+		{"2.5001", 3},
+		{"-2.4999", -2},
+		{"-2.5001", -3},
+		{"9223372036854775807", 9223372036854775807},
+		{"-9223372036854775808", -9223372036854775808},
+		{"9223372036854775806.5", 9223372036854775807},
+		{"-9223372036854775807.5", -9223372036854775808},
+	} {
+		if got := ParseI8(tc.v); got != tc.want {
+			t.Errorf("ParseI8(%q) = %d, want %d", tc.v, got, tc.want)
+		}
+	}
+}
+
+func TestParseI8Overflow(t *testing.T) {
+	for _, tc := range []struct{ v, want string }{
+		{"9223372036854775808", "CX_SY_CONVERSION_OVERFLOW"},
+		{"-9223372036854775809", "CX_SY_CONVERSION_OVERFLOW"},
+		{"9223372036854775807.5", "CX_SY_CONVERSION_OVERFLOW"},
+		{"-9223372036854775808.5", "CX_SY_CONVERSION_OVERFLOW"},
+		{"9999999999999999999", "CX_SY_CONVERSION_OVERFLOW"},
+		{"12345678901234567890", "CX_SY_CONVERSION_OVERFLOW"},
+		// an exponent is no number for an integer, not an overflow
+		{"1E3", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"1e3", "CX_SY_CONVERSION_NO_NUMBER"},
+	} {
+		func() {
+			defer func() {
+				if r := recover(); r == nil {
+					t.Errorf("ParseI8(%q) did not panic", tc.v)
+				} else if e, ok := r.(ArithmeticError); !ok || e.Class != tc.want {
+					t.Errorf("ParseI8(%q) panicked with %v, want class %s", tc.v, r, tc.want)
+				}
+			}()
+			_ = ParseI8(tc.v)
+		}()
+	}
+}
+
+func TestParseI8NoNumber(t *testing.T) {
+	for _, v := range []string{
+		"abc",
+		"-",
+		"+",
+		"1 2",
+		"1.5.2",
+		"0x10",
+		"1_0",
+		"1,5",
+		"nan",
+		"inf",
+		".",
+		"12a",
+	} {
+		func() {
+			defer func() {
+				if r := recover(); r == nil {
+					t.Errorf("ParseI8(%q) did not panic", v)
+				} else if e, ok := r.(ArithmeticError); !ok || e.Class != "CX_SY_CONVERSION_NO_NUMBER" {
+					t.Errorf("ParseI8(%q) panicked with %v, want CX_SY_CONVERSION_NO_NUMBER", v, r)
+				}
+			}()
+			_ = ParseI8(v)
+		}()
+	}
+}
