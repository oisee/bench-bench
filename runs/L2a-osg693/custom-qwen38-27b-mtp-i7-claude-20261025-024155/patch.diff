diff --git a/tools/gogen/testdata/zcl_gogen_t_i8str.clas.abap b/tools/gogen/testdata/zcl_gogen_t_i8str.clas.abap
new file mode 100644
index 0000000..de2c256
--- /dev/null
+++ b/tools/gogen/testdata/zcl_gogen_t_i8str.clas.abap
@@ -0,0 +1,56 @@
+CLASS zcl_gogen_t_i8str DEFINITION PUBLIC FINAL CREATE PUBLIC.
+* a text moved into an int8: the c2n texts and rounding of ZCL_GOGEN_T_C2NUM
+* over the signed 64-bit range -- which texts are numbers, the exact round
+* trip of every value in the range (both endpoints), and what raises
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+  PRIVATE SECTION.
+    CLASS-METHODS to_i8
+      IMPORTING iv_text   TYPE string
+      RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_i8str IMPLEMENTATION.
+  METHOD to_i8.
+    DATA lv_i8 TYPE int8.
+    TRY.
+        lv_i8 = iv_text.
+        rv = |{ lv_i8 }|.
+      CATCH cx_sy_conversion_no_number.
+        rv = 'NN'.
+      CATCH cx_sy_conversion_overflow.
+        rv = 'OV'.
+    ENDTRY.
+  ENDMETHOD.
+
+  METHOD run.
+    DATA lt_text TYPE STANDARD TABLE OF string WITH DEFAULT KEY.
+    DATA lv_text TYPE string.
+    APPEND `` TO lt_text.
+    APPEND `   ` TO lt_text.
+    APPEND `0` TO lt_text.
+    APPEND `12` TO lt_text.
+    APPEND ` 12 ` TO lt_text.
+    APPEND `-12` TO lt_text.
+    APPEND `12-` TO lt_text.
+    APPEND `+12` TO lt_text.
+    APPEND `2.5` TO lt_text.
+    APPEND `-2.5` TO lt_text.
+    APPEND `.5` TO lt_text.
+    APPEND `-0.5` TO lt_text.
+    APPEND `2.4999` TO lt_text.
+    APPEND `9223372036854775807` TO lt_text.
+    APPEND `-9223372036854775808` TO lt_text.
+    APPEND `9223372036854775808` TO lt_text.
+    APPEND `-9223372036854775809` TO lt_text.
+    APPEND `9223372036854775807.5` TO lt_text.
+    APPEND `-9223372036854775807.5` TO lt_text.
+    APPEND `abc` TO lt_text.
+    APPEND `-` TO lt_text.
+    APPEND `1 2` TO lt_text.
+    APPEND `1E3` TO lt_text.
+    LOOP AT lt_text INTO lv_text.
+      rv = |{ rv }[{ lv_text }]{ to_i8( lv_text ) } |.
+    ENDLOOP.
+  ENDMETHOD.
+ENDCLASS.
