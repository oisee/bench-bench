diff --git a/tools/gogen/go/abap/parsei8_test.go b/tools/gogen/go/abap/parsei8_test.go
new file mode 100644
index 0000000..8c1d4dd
--- /dev/null
+++ b/tools/gogen/go/abap/parsei8_test.go
@@ -0,0 +1,39 @@
+package abap
+
+import (
+	"testing"
+)
+
+func TestParseI8(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected int64
+		panic    bool
+	}{
+		{"", 0, false},
+		{"123", 123, false},
+		{"123.4", 123, false},
+		{"123.5", 124, false},
+		{"-123.5", -124, false},
+		{"9223372036854775807", 9223372036854775807, false},
+		{"-9223372036854775808", -9223372036854775808, false},
+		{"9223372036854775808", 0, true},
+	}
+	for _, tt := range tests {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					if !tt.panic {
+						t.Errorf("ParseI8(%q) panicked unexpectedly: %v", tt.input, r)
+					}
+				}
+			}()
+			result := ParseI8(tt.input)
+			if tt.panic {
+				t.Errorf("ParseI8(%q) = %d, expected panic", tt.input, result)
+			} else if result != tt.expected {
+				t.Errorf("ParseI8(%q) = %d, expected %d", tt.input, result, tt.expected)
+			}
+		}()
+	}
+}
