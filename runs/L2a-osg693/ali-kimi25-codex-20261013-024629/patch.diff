+// ParseI8 converts a character value to int8, as A4H does: blanks around it,
+// one sign -- a leading + or -, or a trailing -, a blank between it and the
+// digits allowed ('- 12' and '12 -' are -12) -- and digits with at most one
+// point; no exponent, nothing after a blank. The fraction rounds half away
+// from zero; past int8's range is CX_SY_CONVERSION_OVERFLOW, anything else
+// CX_SY_CONVERSION_NO_NUMBER. Blanks are 0. Returns a BigInt.
+export function ParseI8(v) {
+  const t = v.replace(/^ +| +$/g, "");
+  if (t === "") return 0n;
+  const {neg, body: raw, ok} = numSign(t);
+  const body = raw.replace(/^ +| +$/g, "");
+  if (!ok || !decimalDigits(body)) throw new AbapError("CX_SY_CONVERSION_NO_NUMBER", "c->int8");
+  const dot = body.indexOf(".");
+  const whole = (dot < 0 ? body : body.slice(0, dot)).replace(/^0+/, "");
+  const frac = dot < 0 ? "" : body.slice(dot + 1);
+  if (whole.length > 19) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  let n = whole === "" ? 0n : BigInt(whole);
+  const MAX_INT64 = 9223372036854775807n;
+  const MIN_INT64_ABS = 9223372036854775808n;
+  if (n > MIN_INT64_ABS) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  if (frac !== "" && frac[0] >= "5") {
+    if (n === MIN_INT64_ABS) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+    n = n + 1n;
+  }
+  if (neg) {
+    if (n === MIN_INT64_ABS) return -MIN_INT64_ABS;
+    if (n > MAX_INT64) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+    return -n;
+  } else {
+    if (n > MAX_INT64) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+    return n;
+  }
+}
