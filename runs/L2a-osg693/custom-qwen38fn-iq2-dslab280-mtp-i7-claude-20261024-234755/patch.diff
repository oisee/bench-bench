@@ -0,0 +1,90 @@
+package abap
+
+import (
+	"strconv"
+	"testing"
+)
+
+// The c2num rules of ParseI, taken to int8's range: the same reading, the
+// same rounding half away from zero, and the endpoints exact rather than a
+// value a number of 19 digits would round.
+func TestParseI8(t *testing.T) {
+	cases := []struct{ text, want string }{
+		{"12", "12"},
+		{" 12 ", "12"},
+		{"-12", "-12"},
+		{"12-", "-12"},
+		{"+12", "12"},
+		{"2.5", "3"},
+		{"-2.5", "-3"},
+		{".5", "1"},
+		{"5.", "5"},
+		{"0.4", "0"},
+		{"-0.4", "0"},
+		{"0.5", "1"},
+		{"-0.5", "-1"},
+		{"0012", "12"},
+		{"- 12", "-12"},
+		{"12 -", "-12"},
+		{"", "0"},
+		{"   ", "0"},
+		{"4611686018427387904", "4611686018427387904"},
+		// the endpoints, and a rounding that reaches them from inside
+		{"9223372036854775807", "9223372036854775807"},
+		{"9223372036854775807.4", "9223372036854775807"},
+		{"9223372036854775806.5", "9223372036854775807"},
+		{"-9223372036854775808", "-9223372036854775808"},
+		{"-9223372036854775808.4", "-9223372036854775808"},
+		{"-9223372036854775807.5", "-9223372036854775808"},
+		// past them, by a digit or by the rounding
+		{"9223372036854775807.5", "CO"},
+		{"9223372036854775808", "CO"},
+		{"-9223372036854775808.5", "CO"},
+		{"-9223372036854775809", "CO"},
+		{"123456789012345678901", "CO"},
+		// not numbers: an exponent, a second sign, anything but digits and
+		// at most one point
+		{"1E3", "NN"},
+		{"abc", "NN"},
+		{"-", "NN"},
+		{"+", "NN"},
+		{".", "NN"},
+		{"+-1", "NN"},
+		{"-1-", "NN"},
+		{"12 abc", "NN"},
+		{"1_0", "NN"},
+		{"1,5", "NN"},
+	}
+	for _, c := range cases {
+		got := catch(func() string { return strconv.FormatInt(ParseI8(c.text), 10) })
+		if got != c.want {
+			t.Fatalf("%q: got %s, want %s", c.text, got, c.want)
+		}
+	}
+}
+
+// the class a ParseI8 panic carries, not only its abbreviation
+func TestParseI8Classes(t *testing.T) {
+	for _, text := range []string{"9223372036854775807.5", "123456789012345678901"} {
+		e := raised(func() { ParseI8(text) })
+		if e.Class != "CX_SY_CONVERSION_OVERFLOW" {
+			t.Fatalf("%q: %v", text, e)
+		}
+	}
+	for _, text := range []string{"abc", "1E3", "-", "12 abc"} {
+		e := raised(func() { ParseI8(text) })
+		if e.Class != "CX_SY_CONVERSION_NO_NUMBER" {
+			t.Fatalf("%q: %v", text, e)
+		}
+	}
+}
+
+func raised(f func()) (e ArithmeticError) {
+	defer func() {
+		if r := recover(); r != nil {
+			e, _ = r.(ArithmeticError)
+		}
+	}()
+	f()
+	return e
+}
