+
+const here = dirname(fileURLToPath(import.meta.url));
+const MAX = 9223372036854775807n, MIN = -9223372036854775808n;
+
+// the contract of the string -> int8 conversion, in the JS runtime: blanks,
+// one sign, digits with at most one point, the fraction rounded half away
+// from zero, and int8's range exact to both endpoints
+test("ParseI8 reads a text exactly, to both endpoints", () => {
+  const want = [
+    ["12", 12n], [" 12 ", 12n], ["-12", -12n], ["12-", -12n], ["+12", 12n],
+    ["2.5", 3n], ["-2.5", -3n], [".5", 1n], ["5.", 5n],
+    ["0.4", 0n], ["-0.4", 0n], ["0.5", 1n], ["-0.5", -1n],
+    ["- 12", -12n], ["12 -", -12n], ["0012", 12n],
+    ["", 0n], ["   ", 0n],
+    ["4611686018427387904", 4611686018427387904n],
+    [String(MAX), MAX], ["9223372036854775807.4", MAX], ["9223372036854775806.5", MAX],
+    [String(MIN), MIN], ["-9223372036854775808.4", MIN], ["-9223372036854775807.5", MIN],
+  ];
+  for (const [text, n] of want) assert.equal(ParseI8(text), n, text);
+});
+
