+// ParseI8 converts a character value to int8, as A4H does: the same reading
+// as ParseI -- blanks around it, one sign, digits with at most one point,
+// the fraction rounded half away from zero -- but to int8's range, whose
+// endpoints are exact. A value past them, including one a rounding takes
+// past them, is CX_SY_CONVERSION_OVERFLOW; anything else a number could not
+// be read as is CX_SY_CONVERSION_NO_NUMBER. Blanks are 0. The magnitude is
+// counted in a uint64 because the minimum, which no int64 holds as a
+// positive, is still a value.
+func ParseI8(v string) int64 {
+	t := strings.Trim(v, " ")
+	if t == "" {
+		return 0
+	}
+	neg, body, ok := numSign(t)
+	body = strings.Trim(body, " ")
+	if !ok || !decimalDigits(body) {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_NO_NUMBER", Op: "c->int8"})
+	}
+	whole, frac := body, ""
+	if i := strings.IndexByte(body, '.'); i >= 0 {
+		whole, frac = body[:i], body[i+1:]
+	}
+	whole = strings.TrimLeft(whole, "0")
+	if len(whole) > 19 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	var mag uint64
+	for i := 0; i < len(whole); i++ {
+		mag = mag*10 + uint64(whole[i]-'0')
+	}
+	if frac != "" && frac[0] >= '5' {
+		mag++
+	}
+	if neg {
+		if mag > 9223372036854775808 {
+			panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+		}
+		if mag == 9223372036854775808 {
+			return math.MinInt64
+		}
+		return -int64(mag)
+	}
+	if mag > math.MaxInt64 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	return int64(mag)
+}
+
 // I8ToI and F2I8: int8 into i with an overflow check, f into int8 rounded.
 func I8ToI(v int64) int32 { return check(v, "int8->i") }
 
