index 0000000..8f665e2
--- /dev/null
+++ b/tools/gogen/go/abap/conv_test.go
@@ -0,0 +1,55 @@
+package abap
+
+import "testing"
+
+func TestParseI8(t *testing.T) {
+	for _, test := range []struct {
+		input string
+		want  int64
+	}{
+		{"", 0},
+		{"   ", 0},
+		{" 42 ", 42},
+		{"+42", 42},
+		{"-42", -42},
+		{"2.4", 2},
+		{"2.5", 3},
+		{"-2.4", -2},
+		{"-2.5", -3},
+		{".5", 1},
+		{"-.5", -1},
+		{"9223372036854775807", 9223372036854775807},
+		{"9223372036854775807.4", 9223372036854775807},
+		{"-9223372036854775808", -9223372036854775808},
+		{"-9223372036854775808.4", -9223372036854775808},
+	} {
+		if got := ParseI8(test.input); got != test.want {
+			t.Errorf("ParseI8(%q) = %d, want %d", test.input, got, test.want)
+		}
+	}
+	for _, test := range []struct {
+		input string
+		class string
+	}{
+		{"9223372036854775808", "CX_SY_CONVERSION_OVERFLOW"},
+		{"9223372036854775807.5", "CX_SY_CONVERSION_OVERFLOW"},
+		{"-9223372036854775808.5", "CX_SY_CONVERSION_OVERFLOW"},
+		{"-9223372036854775809", "CX_SY_CONVERSION_OVERFLOW"},
+		{"abc", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"1E3", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"1,5", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"12 3", "CX_SY_CONVERSION_NO_NUMBER"},
+	} {
+		func() {
+			defer func() {
+				recovered := recover()
+				arithmeticError, ok := recovered.(ArithmeticError)
+				if !ok || arithmeticError.Class != test.class {
+					t.Errorf("ParseI8(%q) recovered %v, want %s", test.input, recovered, test.class)
+				}
+			}()
+			ParseI8(test.input)
+			t.Errorf("ParseI8(%q) did not panic", test.input)
+		}()
+	}
+}
diff --git a/tools/gogen/js/abap.mjs b/tools/gogen/js/abap.mjs
index d4b8241..9dcdbbe 100644
--- a/tools/gogen/js/abap.mjs
+++ b/tools/gogen/js/abap.mjs
@@ -162,6 +162,22 @@ export function ParseI(v) {
   if (n > 2147483647 || n < -2147483648) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->i");
   return n;
 }
+export function ParseI8(v) {
+  const t = String(v).replace(/^ +| +$/g, "");
+  if (t === "") return 0n;
+  const {neg, body: raw, ok} = numSign(t);
+  const body = raw.replace(/^ +| +$/g, "");
+  if (!ok || !decimalDigits(body)) throw new AbapError("CX_SY_CONVERSION_NO_NUMBER", "c->int8");
+  const dot = body.indexOf(".");
+  const whole = (dot < 0 ? body : body.slice(0, dot)).replace(/^0+/, "");
+  const frac = dot < 0 ? "" : body.slice(dot + 1);
+  if (whole.length > 19) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  let n = whole === "" ? 0n : BigInt(whole);
+  if (frac !== "" && frac[0] >= "5") n++;
+  if (neg) n = -n;
+  if (n > MAX8 || n < MIN8) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  return n;
+}
