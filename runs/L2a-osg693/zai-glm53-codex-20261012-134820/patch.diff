diff --git a/tools/gogen/parsei8.test.mjs b/tools/gogen/parsei8.test.mjs
new file mode 100644
index 0000000..3735fef
--- /dev/null
+++ b/tools/gogen/parsei8.test.mjs
@@ -0,0 +1,73 @@
+import {test} from "node:test";
+import assert from "node:assert/strict";
+import {basename, join} from "node:path";
+import {mkdtempSync, rmSync, writeFileSync} from "node:fs";
+import {tmpdir} from "node:os";
+import {compileProgram} from "./frontend.mjs";
+import {emitGo} from "./emit-go.mjs";
+import {emitJs} from "./emit-js.mjs";
+import {AbapError, ParseI8} from "./js/abap.mjs";
+import {home} from "./home.mjs";
+import {libraryPath} from "../osd-lib-path.mjs";
+
+const core = libraryPath(home, "open-abap-core");
+
+const cases = new Map([
+  ["", 0n],
+  ["   ", 0n],
+  [" 42 ", 42n],
+  ["+42", 42n],
+  ["-42", -42n],
+  ["2.4", 2n],
+  ["2.5", 3n],
+  ["-2.4", -2n],
+  ["-2.5", -3n],
+  [".5", 1n],
+  ["-.5", -1n],
+  ["9223372036854775807", 9223372036854775807n],
+  ["9223372036854775807.4", 9223372036854775807n],
+  ["-9223372036854775808", -9223372036854775808n],
+  ["-9223372036854775808.4", -9223372036854775808n],
+]);
+
+test("JavaScript ParseI8 keeps int8 decimal conversion exact", () => {
+  for (const [input, want] of cases) assert.equal(ParseI8(input), want);
+  for (const [input, cls] of [
+    ["9223372036854775808", "CX_SY_CONVERSION_OVERFLOW"],
+    ["9223372036854775807.5", "CX_SY_CONVERSION_OVERFLOW"],
+    ["-9223372036854775808.5", "CX_SY_CONVERSION_OVERFLOW"],
+    ["-9223372036854775809", "CX_SY_CONVERSION_OVERFLOW"],
+    ["abc", "CX_SY_CONVERSION_NO_NUMBER"],
+    ["1E3", "CX_SY_CONVERSION_NO_NUMBER"],
+    ["1,5", "CX_SY_CONVERSION_NO_NUMBER"],
+    ["12 3", "CX_SY_CONVERSION_NO_NUMBER"],
+  ]) assert.throws(() => ParseI8(input), (error) => error instanceof AbapError && error.cls === cls);
+});
+
+test("both emitters support string to int8 assignment and overflow catches", async () => {
+  const program = compileProgram({folders: [core, join(import.meta.dirname, "testdata")], objects: ["ZCL_GOGEN_T_C2INT8"]});
+  assert.deepEqual(program.partial, []);
+  const expected = "9223372036854775807/-9223372036854775808/overflow";
+  const js = emitJs(program, new URL("./js/abap.mjs", import.meta.url).href);
+  assert.match(js, /abap\.ParseI8/);
+  const module = await import(`data:text/javascript,${encodeURIComponent(js)}`);
+  assert.equal(module.ZCL_GOGEN_T_C2INT8.RUN({sy: {index: 0, tabix: 0, subrc: 0}}), expected);
+
+  const goDir = mkdtempSync(join(import.meta.dirname, "go", "cmd", "gogen-c2int8-"));
+  try {
+    writeFileSync(join(goDir, "zz_generated.go"), emitGo(program));
+    writeFileSync(join(goDir, "zz_generated_test.go"), `package main
+import ("testing"; "osg/gogen/abap")
+func TestRun(t *testing.T) {
+  if got := ZCL_GOGEN_T_C2INT8_RUN(&abap.Session{}); got != ${JSON.stringify(expected)} { t.Fatalf("got %s", got) }
+}
+`);
+    const {spawnSync} = await import("node:child_process");
+    const run = spawnSync("go", ["test", `./cmd/${basename(goDir)}`], {
+      cwd: join(import.meta.dirname, "go"), encoding: "utf8", timeout: 120000,
+    });
+    assert.equal(run.status, 0, run.stderr || run.stdout);
+  } finally {
+    rmSync(goDir, {recursive: true, force: true});
+  }
+});
diff --git a/tools/gogen/testdata/zcl_gogen_t_c2int8.clas.abap b/tools/gogen/testdata/zcl_gogen_t_c2int8.clas.abap
new file mode 100644
index 0000000..a0dddc9
--- /dev/null
+++ b/tools/gogen/testdata/zcl_gogen_t_c2int8.clas.abap
@@ -0,0 +1,19 @@
+CLASS zcl_gogen_t_c2int8 DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_c2int8 IMPLEMENTATION.
+  METHOD run.
+    DATA value TYPE int8.
+    value = ` 9223372036854775807 `.
+    rv = |{ value }|.
+    value = `-9223372036854775808.4`.
+    rv = |{ rv }/{ value }|.
+    TRY.
+        value = `9223372036854775807.5`.
+      CATCH cx_sy_conversion_overflow.
+        rv = |{ rv }/overflow|.
+    ENDTRY.
+  ENDMETHOD.
+ENDCLASS.
