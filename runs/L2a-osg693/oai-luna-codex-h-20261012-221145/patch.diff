diff --git a/tools/gogen/go/abap/parsei8_test.go b/tools/gogen/go/abap/parsei8_test.go
new file mode 100644
index 0000000..c8f6ce4
--- /dev/null
+++ b/tools/gogen/go/abap/parsei8_test.go
@@ -0,0 +1,44 @@
+package abap
+
+import (
+	"math"
+	"testing"
+)
+
+func TestParseI8ExactAndRounded(t *testing.T) {
+	cases := map[string]int64{
+		"": 0, "   ": 0, " +0 ": 0,
+		"9223372036854775807":  math.MaxInt64,
+		"-9223372036854775808": math.MinInt64,
+		"9007199254740993":     9007199254740993,
+		"1.5":                  2, "-1.5": -2, "1.49": 1, "-1.49": -1,
+		"9223372036854775806.5":  math.MaxInt64,
+		"-9223372036854775807.5": math.MinInt64,
+	}
+	for input, want := range cases {
+		if got := ParseI8(input); got != want {
+			t.Errorf("ParseI8(%q) = %d, want %d", input, got, want)
+		}
+	}
+}
+
+func TestParseI8Errors(t *testing.T) {
+	for _, tc := range []struct{ input, class string }{
+		{"9223372036854775807.5", "CX_SY_CONVERSION_OVERFLOW"},
+		{"-9223372036854775808.5", "CX_SY_CONVERSION_OVERFLOW"},
+		{"9223372036854775808", "CX_SY_CONVERSION_OVERFLOW"},
+		{"1x", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"1e2", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"12-", "CX_SY_CONVERSION_NO_NUMBER"},
+	} {
+		func() {
+			defer func() {
+				got, ok := recover().(ArithmeticError)
+				if !ok || got.Class != tc.class {
+					t.Errorf("ParseI8(%q) panic = %#v, want ArithmeticError %s", tc.input, got, tc.class)
+				}
+			}()
+			ParseI8(tc.input)
+		}()
+	}
+}
