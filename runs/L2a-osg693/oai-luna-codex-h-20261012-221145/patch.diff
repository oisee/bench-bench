diff --git a/tools/gogen/parsei8.test.mjs b/tools/gogen/parsei8.test.mjs
new file mode 100644
index 0000000..f922cdb
--- /dev/null
+++ b/tools/gogen/parsei8.test.mjs
@@ -0,0 +1,61 @@
+import {test} from "node:test";
+import assert from "node:assert/strict";
+import {ParseI8, AbapError} from "./js/abap.mjs";
+import {compileProgram} from "./frontend.mjs";
+import {emitGo} from "./emit-go.mjs";
+import {emitJs} from "./emit-js.mjs";
+import {mkdtempSync, rmSync, writeFileSync} from "node:fs";
+import {tmpdir} from "node:os";
+import {join} from "node:path";
+
+test("ParseI8 preserves signed 64-bit decimal values and rounds exactly", () => {
+  for (const [input, expected] of [
+    ["", 0n], ["   ", 0n], [" +0 ", 0n],
+    ["9223372036854775807", 9223372036854775807n],
+    ["-9223372036854775808", -9223372036854775808n],
+    ["9007199254740993", 9007199254740993n],
+    ["1.5", 2n], ["-1.5", -2n], ["1.49", 1n], ["-1.49", -1n],
+    ["9223372036854775806.5", 9223372036854775807n],
+    ["-9223372036854775807.5", -9223372036854775808n],
+  ]) assert.equal(ParseI8(input), expected, input);
+});
+
+test("ParseI8 distinguishes overflow from invalid text", () => {
+  for (const [input, className] of [
+    ["9223372036854775807.5", "CX_SY_CONVERSION_OVERFLOW"],
+    ["-9223372036854775808.5", "CX_SY_CONVERSION_OVERFLOW"],
+    ["9223372036854775808", "CX_SY_CONVERSION_OVERFLOW"],
+    ["1x", "CX_SY_CONVERSION_NO_NUMBER"], ["1e2", "CX_SY_CONVERSION_NO_NUMBER"],
+    ["12-", "CX_SY_CONVERSION_NO_NUMBER"],
+  ]) assert.throws(() => ParseI8(input), (error) => error instanceof AbapError && error.cls === className);
+});
+
+test("both emitters generate string-to-int8 assignments and overflow catches", () => {
+  const dir = mkdtempSync(join(tmpdir(), "gogen-parsei8-"));
+  try {
+    writeFileSync(join(dir, "zcl_parse_i8.clas.abap"), `
+CLASS zcl_parse_i8 DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run IMPORTING iv TYPE string RETURNING VALUE(rv) TYPE int8.
+ENDCLASS.
+CLASS zcl_parse_i8 IMPLEMENTATION.
+  METHOD run.
+    TRY.
+      rv = iv.
+    CATCH cx_sy_conversion_overflow.
+      rv = 0.
+    ENDTRY.
+  ENDMETHOD.
+ENDCLASS.
+`);
+    const program = compileProgram({folders: [dir], objects: ["ZCL_PARSE_I8"]});
+    const go = emitGo(program);
+    const js = emitJs(program);
+    assert.match(go, /abap\.ParseI8\(iv\)/);
+    assert.match(js, /abap\.ParseI8\(iv\)/);
+    assert.match(go, /CX_SY_CONVERSION_OVERFLOW/);
+    assert.match(js, /CX_SY_CONVERSION_OVERFLOW/);
+  } finally {
+    rmSync(dir, {recursive: true, force: true});
+  }
+});
