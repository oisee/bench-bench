 }
+const I8_MIN = -9223372036854775808n;
+const I8_MAX = 9223372036854775807n;
+export function ParseI8(v) {
+  const t = v.replace(/^ +| +$/g, "");
+  if (t === "") return 0n;
+  const sign = t[0] === "-" ? -1n : 1n;
+  const body = (t[0] === "+" || t[0] === "-" ? t.slice(1) : t);
+  if (!decimalDigits(body)) throw new AbapError("CX_SY_CONVERSION_NO_NUMBER", "c->int8");
+  const dot = body.indexOf(".");
+  const whole = (dot < 0 ? body : body.slice(0, dot)).replace(/^0+/, "");
+  const frac = dot < 0 ? "" : body.slice(dot + 1);
+  let n = whole === "" ? 0n : BigInt(whole);
+  if (frac !== "" && frac[0] >= "5") n++;
+  n *= sign;
+  if (n < I8_MIN || n > I8_MAX) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  return n;
+}
