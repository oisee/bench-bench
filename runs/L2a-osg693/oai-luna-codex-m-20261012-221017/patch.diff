--- /dev/null
+++ b/tools/gogen/go/abap/parsei8_test.go
@@ -0,0 +1,31 @@
+package abap
+
+import "testing"
+
+func TestParseI8ExactDecimal(t *testing.T) {
+	for _, tc := range []struct{ in, want string }{
+		{"", "0"}, {"   ", "0"}, {" +12.4 ", "12"}, {"-12.5", "-13"},
+		{"9223372036854775807", "9223372036854775807"},
+		{"-9223372036854775808", "-9223372036854775808"},
+		{"9223372036854775806.5", "9223372036854775807"},
+	} {
+		if got := FmtI8(ParseI8(tc.in)); got != tc.want {
+			t.Errorf("ParseI8(%q) = %s, want %s", tc.in, got, tc.want)
+		}
+	}
+	for _, tc := range []struct{ in, class string }{
+		{"9223372036854775807.5", "CX_SY_CONVERSION_OVERFLOW"},
+		{"-9223372036854775808.5", "CX_SY_CONVERSION_OVERFLOW"},
+		{"12x", "CX_SY_CONVERSION_NO_NUMBER"},
+	} {
+		func() {
+			defer func() {
+				r := recover()
+				if e, ok := r.(ArithmeticError); !ok || e.Class != tc.class {
+					t.Errorf("ParseI8(%q) panic = %#v, want %s", tc.in, r, tc.class)
+				}
+			}()
+			ParseI8(tc.in)
+		}()
+	}
+}
