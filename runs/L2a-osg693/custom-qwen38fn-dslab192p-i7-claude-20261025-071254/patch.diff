diff --git a/tools/gogen/testdata/zcl_gogen_t_c2i8.clas.abap b/tools/gogen/testdata/zcl_gogen_t_c2i8.clas.abap
new file mode 100644
index 0000000..8dc0fdf
--- /dev/null
+++ b/tools/gogen/testdata/zcl_gogen_t_c2i8.clas.abap
@@ -0,0 +1,81 @@
+CLASS zcl_gogen_t_c2i8 DEFINITION PUBLIC FINAL CREATE PUBLIC.
+* a text moved into an int8: the text rules A4H measured for an i
+* (ZCL_GOGEN_T_C2NUM, $ZOSG_TMP_0082) over int8's range -- the endpoints
+* exact, one past either a conversion overflow, a text that is no number a
+* no number; the template writes the value's digits, so a value of nineteen
+* of them comes back whole
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+  PRIVATE SECTION.
+    CLASS-METHODS to_i8
+      IMPORTING iv_text   TYPE string
+      RETURNING VALUE(rv) TYPE string.
+    CLASS-METHODS doubled
+      IMPORTING iv_text   TYPE string
+      RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_c2i8 IMPLEMENTATION.
+  METHOD to_i8.
+    DATA lv_i8 TYPE int8.
+    TRY.
+        lv_i8 = iv_text.
+        rv = |{ lv_i8 }|.
+      CATCH cx_sy_conversion_no_number.
+        rv = 'NN'.
+      CATCH cx_sy_conversion_overflow.
+        rv = 'OV'.
+    ENDTRY.
+  ENDMETHOD.
+
+  METHOD doubled.
+    DATA lv_i8 TYPE int8.
+    TRY.
+        lv_i8 = iv_text.
+        rv = |{ lv_i8 * 2 }|.
+      CATCH cx_sy_arithmetic_overflow.
+        rv = 'AO'.
+      CATCH cx_sy_conversion_no_number.
+        rv = 'NN'.
+    ENDTRY.
+  ENDMETHOD.
+
+  METHOD run.
+    DATA lt_text TYPE STANDARD TABLE OF string WITH DEFAULT KEY.
+    DATA lv_text TYPE string.
+    APPEND `0` TO lt_text.
+    APPEND ` 12 ` TO lt_text.
+    APPEND `-12` TO lt_text.
+    APPEND `12-` TO lt_text.
+    APPEND `+12` TO lt_text.
+    APPEND `2.5` TO lt_text.
+    APPEND `-2.5` TO lt_text.
+    APPEND `2.4999` TO lt_text.
+    APPEND `.5` TO lt_text.
+    APPEND `5.` TO lt_text.
+    APPEND `` TO lt_text.
+    APPEND `   ` TO lt_text.
+    APPEND `0012` TO lt_text.
+    APPEND `-0` TO lt_text.
+    APPEND `9223372036854775807` TO lt_text.
+    APPEND `-9223372036854775808` TO lt_text.
+    APPEND `9223372036854775807.4` TO lt_text.
+    APPEND `-9223372036854775808.4` TO lt_text.
+    APPEND `9223372036854775807.5` TO lt_text.
+    APPEND `-9223372036854775808.5` TO lt_text.
+    APPEND `9223372036854775808` TO lt_text.
+    APPEND `-9223372036854775809` TO lt_text.
+    APPEND `17077210000000000000` TO lt_text.
+    APPEND `abc` TO lt_text.
+    APPEND `1E3` TO lt_text.
+    APPEND `12 3` TO lt_text.
+    APPEND `-` TO lt_text.
+    APPEND `+-1` TO lt_text.
+    APPEND `.` TO lt_text.
+    LOOP AT lt_text INTO lv_text.
+      rv = |{ rv }/{ lv_text }={ to_i8( iv_text = lv_text ) }|.
+    ENDLOOP.
+    rv = |{ rv }/double:9223372036854775807={ doubled( iv_text = '9223372036854775807' ) }|.
+    rv = |{ rv }/4611686018427387904={ doubled( iv_text = '2305843009213693952' ) }|.
+  ENDMETHOD.
+ENDCLASS.
