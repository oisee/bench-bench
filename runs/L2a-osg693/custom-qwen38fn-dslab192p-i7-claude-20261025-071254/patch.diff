diff --git a/tools/gogen/go/abap/conv.go b/tools/gogen/go/abap/conv.go
index 17c7e05..dfe9e96 100644
--- a/tools/gogen/go/abap/conv.go
+++ b/tools/gogen/go/abap/conv.go
@@ -195,6 +195,76 @@ func ParseI(v string) int32 {
 	return int32(n)
 }
 
+// ParseI8 is ParseI's text rules over int8's range: blanks around it, one
+// sign, digits with at most one point, the fraction rounded half away from
+// zero, Blanks are 0 -- and a value that lands outside int64, rounded or not,
+// is CX_SY_CONVERSION_OVERFLOW; the text rules and the rounding are A4H's for
+// i (parity-wave2, ZCL_GOGEN_T_C2NUM), the range is int8's as F2I8 and PToI8
+// take it, so both endpoints are exact and one past either raises.
+func ParseI8(v string) int64 {
+	t := strings.Trim(v, " ")
+	if t == "" {
+		return 0
+	}
+	neg, body, ok := numSign(t)
+	body = strings.Trim(body, " ")
+	if !ok || !decimalDigits(body) {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_NO_NUMBER", Op: "c->int8"})
+	}
+	whole, frac := body, ""
+	if i := strings.IndexByte(body, '.'); i >= 0 {
+		whole, frac = body[:i], body[i+1:]
+	}
+	// the magnitude kept as digits, so no accumulation can overflow on its way
+	// to the range check; the fraction adds one to it when it rounds up
+	digits := strings.TrimLeft(whole, "0")
+	if frac != "" && frac[0] >= '5' {
+		digits = bumpDigits(digits)
+	}
+	if digits == "" {
+		return 0
+	}
+	if len(digits) > 19 || (len(digits) == 19 && digits > "9223372036854775808") {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	// int64 holds one magnitude more than its maximum: the minimum's, and only
+	// with the minus in front of it
+	if digits == "9223372036854775808" {
+		if !neg {
+			panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+		}
+		return math.MinInt64
+	}
+	n, err := strconv.ParseInt(digits, 10, 64)
+	if err != nil {
+		// unreachable: the length and text checks above bound digits to int64
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	if neg {
+		n = -n
+	}
+	return n
+}
+
+// bumpDigits adds one to a run of decimal digits, growing it when it was all
+// nines: 999 becomes 1000, an empty run (a value below 1) becomes 1
+func bumpDigits(d string) string {
+	b := []byte(d)
+	i := len(b) - 1
+	for ; i >= 0; i-- {
+		if b[i] == '9' {
+			b[i] = '0'
+			continue
+		}
+		b[i]++
+		break
+	}
+	if i < 0 {
+		b = append([]byte{'1'}, b...)
+	}
+	return string(b)
+}
+
 // I8ToI and F2I8: int8 into i with an overflow check, f into int8 rounded.
 func I8ToI(v int64) int32 { return check(v, "int8->i") }
 
diff --git a/tools/gogen/go/abap/parsei8_test.go b/tools/gogen/go/abap/parsei8_test.go
new file mode 100644
index 0000000..84ea096
--- /dev/null
+++ b/tools/gogen/go/abap/parsei8_test.go
@@ -0,0 +1,35 @@
+package abap
+
+import (
+	"strconv"
+	"testing"
+)
+
+// A text into an int8: the text rules A4H measured for an i (parity-wave2,
+// ZCL_GOGEN_T_C2NUM) over int64's range -- both endpoints exact, one past
+// either a conversion overflow, a text that is no number a no number.
+func TestParseI8(t *testing.T) {
+	read := func(v string) string { return strconv.FormatInt(ParseI8(v), 10) }
+	cases := []struct{ in, want string }{
+		{"0", "0"}, {" 12 ", "12"}, {"12-", "-12"}, {"+12", "12"}, {"- 12", "-12"},
+		{"2.5", "3"}, {"-2.5", "-3"}, {"2.4999", "2"}, {".5", "1"}, {"5.", "5"},
+		{"", "0"}, {"   ", "0"}, {"0012", "12"},
+		{"9223372036854775807", "9223372036854775807"},
+		{"-9223372036854775808", "-9223372036854775808"},
+		{"9223372036854775807.4", "9223372036854775807"},
+		{"-9223372036854775808.4", "-9223372036854775808"},
+		// the rounded value may be the one that does not fit
+		{"9223372036854775807.5", "CO"},
+		{"-9223372036854775808.5", "CO"},
+		{"9223372036854775808", "CO"}, {"-9223372036854775809", "CO"},
+		{"17077210000000000000", "CO"},
+		// no number: the same texts that are no number into an i
+		{"abc", "NN"}, {"1E3", "NN"}, {"1,5", "NN"}, {"12 3", "NN"}, {"-", "NN"},
+		{"+-1", "NN"}, {"--1", "NN"}, {".", "NN"}, {"0x10", "NN"},
+	}
+	for _, c := range cases {
+		if got := catch(func() string { return read(c.in) }); got != c.want {
+			t.Errorf("'%s' = %s, want %s", c.in, got, c.want)
+		}
+	}
+}
