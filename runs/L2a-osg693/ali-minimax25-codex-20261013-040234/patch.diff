+// ParseI8 converts a character value to int8, following the same rules as
+// ParseI but for the int64 range. Blanks are 0.
+func ParseI8(v string) int64 {
+	t := strings.Trim(v, " ")
+	if t == "" {
+		return 0
+	}
+	neg, body, ok := numSign(t)
+	body = strings.Trim(body, " ")
+	if !ok || !decimalDigits(body) {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_NO_NUMBER", Op: "c->int8"})
+	}
+	whole, frac := body, ""
+	if i := strings.IndexByte(body, '.'); i >= 0 {
+		whole, frac = body[:i], body[i+1:]
+	}
+	whole = strings.TrimLeft(whole, "0")
+	// int64 max is 9223372036854775807 (19 digits), but we need room for rounding
+	if len(whole) > 19 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	var n int64
+	for i := 0; i < len(whole); i++ {
+		digit := int64(whole[i] - '0')
+		// Check prospective value n*10 + digit doesn't overflow
+		// Using unsigned to avoid signed overflow issues
+		prospective := uint64(n)*10 + uint64(digit)
+		// For negative numbers, allow up to abs(min int64) = 9223372036854775808
+		maxVal := uint64(9223372036854775807)
+		if neg {
+			maxVal = uint64(9223372036854775808)
+		}
+		if prospective > maxVal {
+			panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+		}
+		n = n*10 + digit
+	}
+	if frac != "" && frac[0] >= '5' {
+		// Check if adding 1 would overflow
+		if !neg && n > 9223372036854775807-1 {
+			panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+		}
+		if neg && n > 9223372036854775808-1 {
+			panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+		}
+		n++
+	}
+	if neg {
+		// Check if negation would overflow - only if n > abs(min int64)
+		// n = 9223372036854775808 is exactly abs(min int64), which is valid to negate
+		if uint64(n) > 9223372036854775808 {
+			panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+		}
+		n = -n
+	}
+	return n
+}
+
 // I8ToI and F2I8: int8 into i with an overflow check, f into int8 rounded.
 func I8ToI(v int64) int32 { return check(v, "int8->i") }
 
