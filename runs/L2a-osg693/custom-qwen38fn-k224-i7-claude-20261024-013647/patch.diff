diff --git a/tools/gogen/go/abap/conv.go b/tools/gogen/go/abap/conv.go
index 17c7e05..9adeb7d 100644
--- a/tools/gogen/go/abap/conv.go
+++ b/tools/gogen/go/abap/conv.go
@@ -195,6 +195,57 @@ func ParseI(v string) int32 {
 	return int32(n)
 }
 
+// ParseI8 is ParseI widened to the int8 range, same text rules (c->int8,
+// the same contract as c->i measured in ZCL_GOGEN_T_C2NUM, the range read
+// off int64): blanks around, one sign, digits with at most one point, the
+// fraction rounds half away from zero, blanks are 0. Both endpoints are
+// exact: 9223372036854775807 and -9223372036854775808; a value that after
+// rounding falls outside them is CX_SY_CONVERSION_OVERFLOW, anything that
+// is not a number CX_SY_CONVERSION_NO_NUMBER. The digits accumulate in a
+// uint64 (10^19 fits 2^64), so the magnitude is exact before the range
+// is judged.
+func ParseI8(v string) int64 {
+	t := strings.Trim(v, " ")
+	if t == "" {
+		return 0
+	}
+	neg, body, ok := numSign(t)
+	body = strings.Trim(body, " ")
+	if !ok || !decimalDigits(body) {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_NO_NUMBER", Op: "c->int8"})
+	}
+	whole, frac := body, ""
+	if i := strings.IndexByte(body, '.'); i >= 0 {
+		whole, frac = body[:i], body[i+1:]
+	}
+	whole = strings.TrimLeft(whole, "0")
+	if len(whole) > 19 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	var n uint64
+	for i := 0; i < len(whole); i++ {
+		n = n*10 + uint64(whole[i]-'0')
+	}
+	if frac != "" && frac[0] >= '5' {
+		n++
+	}
+	if neg {
+		// -9223372036854775808 is the minimum, its magnitude one past the
+		// maximum, so the negative bound is judged on the magnitude
+		if n > 9223372036854775808 {
+			panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+		}
+		if n == 9223372036854775808 {
+			return math.MinInt64
+		}
+		return -int64(n)
+	}
+	if n > 9223372036854775807 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	return int64(n)
+}
+
 // I8ToI and F2I8: int8 into i with an overflow check, f into int8 rounded.
 func I8ToI(v int64) int32 { return check(v, "int8->i") }
 
