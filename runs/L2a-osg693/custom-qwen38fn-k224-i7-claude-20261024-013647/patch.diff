@@ -0,0 +1,77 @@
+CLASS zcl_gogen_t_c2i8 DEFINITION PUBLIC FINAL CREATE PUBLIC.
+* a text moved into an int8: c2num's text rules (A4H, parity-wave2,
+* ZCL_GOGEN_T_C2NUM) widened to the int8 range -- both endpoints exact,
+* a value that after the rounding falls outside it CX_SY_CONVERSION_
+* OVERFLOW -- and the template of an int8: the digits exactly.
+* Not a re-measurement: the grammar is c2num's measured one, the bounds
+* those of TYPE int8 (go/abap conv.go ParseI8, js/abap.mjs ParseI8).
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+  PRIVATE SECTION.
+    CLASS-METHODS to_i8
+      IMPORTING iv_text   TYPE string
+      RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_c2i8 IMPLEMENTATION.
+  METHOD to_i8.
+    DATA lv_i8 TYPE int8.
+    TRY.
+        lv_i8 = iv_text.
+        rv = |{ lv_i8 }|.
+      CATCH cx_sy_conversion_no_number.
+        rv = 'NN'.
+      CATCH cx_sy_conversion_overflow.
+        rv = 'OV'.
+    ENDTRY.
+  ENDMETHOD.
+
+  METHOD run.
+    DATA lt_text TYPE STANDARD TABLE OF string WITH DEFAULT KEY.
+    DATA lv_text TYPE string.
+    APPEND `12` TO lt_text.
+    APPEND ` 12 ` TO lt_text.
+    APPEND `-12` TO lt_text.
+    APPEND `12-` TO lt_text.
+    APPEND `+12` TO lt_text.
+    APPEND `2.5` TO lt_text.
+    APPEND `-2.5` TO lt_text.
+    APPEND `.5` TO lt_text.
+    APPEND `5.` TO lt_text.
+    APPEND `1.5` TO lt_text.
+    APPEND `-1.5` TO lt_text.
+    APPEND `1.49999` TO lt_text.
+    APPEND `12.5-` TO lt_text.
+    APPEND `1E3` TO lt_text.
+    APPEND `nan` TO lt_text.
+    APPEND `12 3` TO lt_text.
+    APPEND `abc` TO lt_text.
+    APPEND `` TO lt_text.
+    APPEND `   ` TO lt_text.
+    APPEND `-` TO lt_text.
+    APPEND `+` TO lt_text.
+    APPEND `.` TO lt_text.
+    APPEND `+-1` TO lt_text.
+    APPEND `0012` TO lt_text.
+    APPEND `12 -` TO lt_text.
+    APPEND `- 12` TO lt_text.
+    APPEND `2147483648` TO lt_text.
+    APPEND `3000000000` TO lt_text.
+    APPEND `9223372036854775807` TO lt_text.
+    APPEND `-9223372036854775808` TO lt_text.
+    APPEND `09223372036854775807` TO lt_text.
+    APPEND `9223372036854775808` TO lt_text.
+    APPEND `-9223372036854775809` TO lt_text.
+    APPEND `9223372036854775807.4` TO lt_text.
+    APPEND `9223372036854775807.5` TO lt_text.
+    APPEND `-9223372036854775808.4` TO lt_text.
+    APPEND `-9223372036854775808.5` TO lt_text.
+    APPEND `999999999999999999.5` TO lt_text.
+    APPEND `-999999999999999999.5` TO lt_text.
+    APPEND `9999999999999999999` TO lt_text.
+    APPEND `99999999999999999999` TO lt_text.
+    LOOP AT lt_text INTO lv_text.
+      rv = |{ rv }[{ lv_text }]{ to_i8( lv_text ) } |.
+    ENDLOOP.
+  ENDMETHOD.
+ENDCLASS.
diff --git a/tools/gogen/testdata/zcl_gogen_t_genmov8.clas.abap b/tools/gogen/testdata/zcl_gogen_t_genmov8.clas.abap
new file mode 100644
index 0000000..a6e514a
--- /dev/null
+++ b/tools/gogen/testdata/zcl_gogen_t_genmov8.clas.abap
@@ -0,0 +1,52 @@
+* a string moved into generic data bound to an int8 (go/abap move.go
+* MoveData case '8', js/abap.mjs MoveData case "8"), beside the typed
+* move of the same text: the generic move takes the ParseI8 rule, and the
+* two agree. Not a re-measurement: the grammar is c2num's (A4H,
+* parity-wave2), the bounds those of TYPE int8; open-abap's int8 set(
+* converts a string the same way, so the generic move converting is what
+* the Node runtime already does.
+CLASS zcl_gogen_t_genmov8 DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+  PRIVATE SECTION.
+    CLASS-METHODS b IMPORTING iv TYPE abap_bool RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_genmov8 IMPLEMENTATION.
+  METHOD b.
+    IF iv = abap_true.
+      rv = `=`.
+    ELSE.
+      rv = `!`.
+    ENDIF.
+  ENDMETHOD.
+
+  METHOD run.
+    DATA lv_i8 TYPE int8.
+    DATA lv_i8b TYPE int8.
+    DATA lt_s TYPE STANDARD TABLE OF string WITH DEFAULT KEY.
+    DATA lv_s TYPE string.
+    FIELD-SYMBOLS <v> TYPE any.
+    ASSIGN lv_i8 TO <v>.
+    APPEND `12` TO lt_s.
+    APPEND ` 12 ` TO lt_s.
+    APPEND `12.5` TO lt_s.
+    APPEND `-12.5-` TO lt_s.
+    APPEND `9223372036854775807` TO lt_s.
+    APPEND `-9223372036854775808` TO lt_s.
+    APPEND `9223372036854775808` TO lt_s.
+    APPEND `abc` TO lt_s.
+    APPEND `` TO lt_s.
+    LOOP AT lt_s INTO lv_s.
+      TRY.
+          <v> = lv_s.
+          lv_i8b = lv_s.
+          rv = |{ rv }[{ lv_s }]{ lv_i8 }={ lv_i8b }{ b( xsdbool( lv_i8 = lv_i8b ) ) } |.
+        CATCH cx_sy_conversion_no_number.
+          rv = |{ rv }[{ lv_s }]NN |.
+        CATCH cx_sy_conversion_overflow.
+          rv = |{ rv }[{ lv_s }]OV |.
+      ENDTRY.
+    ENDLOOP.
+  ENDMETHOD.
+ENDCLASS.
