index 0000000..e0aa0fb
--- /dev/null
+++ b/tools/gogen/go/abap/parsei8_test.go
@@ -0,0 +1,47 @@
+package abap
+
+import (
+	"math"
+	"testing"
+)
+
+func TestParseI8(t *testing.T) {
+	for _, c := range []struct {
+		in   string
+		want int64
+	}{
+		{"", 0}, {"   ", 0}, {" 12 ", 12}, {"+12", 12}, {"-12", -12}, {"12-", -12}, {"- 12", -12},
+		{"0012", 12}, {"2.5", 3}, {"-2.5", -3}, {"2.4", 2}, {"-0.5", -1}, {".5", 1}, {"5.", 5},
+		{"9223372036854775807", math.MaxInt64}, {"-9223372036854775808", math.MinInt64},
+		{" 9223372036854775807 ", math.MaxInt64}, {"9223372036854775806.5", math.MaxInt64},
+		{"9223372036854775807.4", math.MaxInt64}, {"-9223372036854775808.4", math.MinInt64},
+		{"-9223372036854775807.5", math.MinInt64}, {"00009223372036854775807", math.MaxInt64},
+		{"1234567890123456789", 1234567890123456789},
+	} {
+		if got := ParseI8(c.in); got != c.want {
+			t.Errorf("ParseI8(%q) = %d, want %d", c.in, got, c.want)
+		}
+	}
+	for _, c := range []struct{ in, class string }{
+		{"9223372036854775808", "CX_SY_CONVERSION_OVERFLOW"},
+		{"-9223372036854775809", "CX_SY_CONVERSION_OVERFLOW"},
+		{"9223372036854775807.5", "CX_SY_CONVERSION_OVERFLOW"},
+		{"-9223372036854775808.5", "CX_SY_CONVERSION_OVERFLOW"},
+		{"99999999999999999999", "CX_SY_CONVERSION_OVERFLOW"},
+		{"9999999999999999999.9", "CX_SY_CONVERSION_OVERFLOW"},
+		{"abc", "CX_SY_CONVERSION_NO_NUMBER"}, {"-", "CX_SY_CONVERSION_NO_NUMBER"},
+		{".", "CX_SY_CONVERSION_NO_NUMBER"}, {"1E3", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"12 3", "CX_SY_CONVERSION_NO_NUMBER"}, {"+-1", "CX_SY_CONVERSION_NO_NUMBER"},
+		{"1.5.2", "CX_SY_CONVERSION_NO_NUMBER"}, {"12a", "CX_SY_CONVERSION_NO_NUMBER"},
+	} {
+		func() {
+			defer func() {
+				e, ok := recover().(ArithmeticError)
+				if !ok || e.Class != c.class {
+					t.Errorf("ParseI8(%q) raised %v, want %s", c.in, e, c.class)
+				}
+			}()
+			ParseI8(c.in)
+		}()
+	}
+}
diff --git a/tools/gogen/js/abap.mjs b/tools/gogen/js/abap.mjs
index d4b8241..8824b7c 100644
--- a/tools/gogen/js/abap.mjs
+++ b/tools/gogen/js/abap.mjs
@@ -162,6 +162,24 @@ export function ParseI(v) {
   if (n > 2147483647 || n < -2147483648) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->i");
   return n;
 }
+// text into int8 by ParseI's rules, as a BigInt so every value is exact
+// (go/abap/conv.go ParseI8)
+export function ParseI8(v) {
+  const t = String(v).replace(/^ +| +$/g, "");
+  if (t === "") return 0n;
+  const {neg, body: raw, ok} = numSign(t);
+  const body = raw.replace(/^ +| +$/g, "");
+  if (!ok || !decimalDigits(body)) throw new AbapError("CX_SY_CONVERSION_NO_NUMBER", "c->int8");
+  const dot = body.indexOf(".");
+  const whole = (dot < 0 ? body : body.slice(0, dot)).replace(/^0+/, "");
+  const frac = dot < 0 ? "" : body.slice(dot + 1);
+  if (whole.length > 19) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  let n = whole === "" ? 0n : BigInt(whole);
+  if (frac !== "" && frac[0] >= "5") n++;
+  if (neg) n = -n;
+  if (n > 9223372036854775807n || n < -9223372036854775808n) throw new AbapError("CX_SY_CONVERSION_OVERFLOW", "c->int8");
+  return n;
+}
 export const ToUpper = (v) => v.toUpperCase();
