diff --git a/tools/gogen/go/abap/conv.go b/tools/gogen/go/abap/conv.go
index 17c7e05..81f1ee2 100644
--- a/tools/gogen/go/abap/conv.go
+++ b/tools/gogen/go/abap/conv.go
@@ -195,6 +195,50 @@ func ParseI(v string) int32 {
 	return int32(n)
 }
 
+// ParseI8 converts a character value to int8 by ParseI's rules, exactly over
+// the whole signed 64-bit range: blanks around it, one sign, digits with at
+// most one point, the fraction rounded half away from zero. Past int8's
+// range (after rounding) is CX_SY_CONVERSION_OVERFLOW, anything else
+// CX_SY_CONVERSION_NO_NUMBER. Blanks are 0.
+func ParseI8(v string) int64 {
+	t := strings.Trim(v, " ")
+	if t == "" {
+		return 0
+	}
+	neg, body, ok := numSign(t)
+	body = strings.Trim(body, " ")
+	if !ok || !decimalDigits(body) {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_NO_NUMBER", Op: "c->int8"})
+	}
+	whole, frac := body, ""
+	if i := strings.IndexByte(body, '.'); i >= 0 {
+		whole, frac = body[:i], body[i+1:]
+	}
+	whole = strings.TrimLeft(whole, "0")
+	// 19 digits and a rounding step stay below 2^64
+	if len(whole) > 19 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	var n uint64
+	for i := 0; i < len(whole); i++ {
+		n = n*10 + uint64(whole[i]-'0')
+	}
+	if frac != "" && frac[0] >= '5' {
+		n++
+	}
+	limit := uint64(math.MaxInt64)
+	if neg {
+		limit++
+	}
+	if n > limit {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	if neg {
+		return int64(-n)
+	}
+	return int64(n)
+}
+
 // I8ToI and F2I8: int8 into i with an overflow check, f into int8 rounded.
 func I8ToI(v int64) int32 { return check(v, "int8->i") }
 
