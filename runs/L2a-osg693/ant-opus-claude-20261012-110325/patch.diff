diff --git a/tools/gogen/parsei8.test.mjs b/tools/gogen/parsei8.test.mjs
new file mode 100644
index 0000000..14af9bb
--- /dev/null
+++ b/tools/gogen/parsei8.test.mjs
@@ -0,0 +1,96 @@
+import {test} from "node:test";
+import assert from "node:assert/strict";
+import {spawnSync} from "node:child_process";
+import {mkdtempSync, rmSync, writeFileSync} from "node:fs";
+import {tmpdir} from "node:os";
+import {basename, dirname, join} from "node:path";
+import {fileURLToPath} from "node:url";
+import {compileProgram} from "./frontend.mjs";
+import {emitGo} from "./emit-go.mjs";
+import {emitJs} from "./emit-js.mjs";
+import {ParseI8} from "./js/abap.mjs";
+import {libraryPath} from "../osd-lib-path.mjs";
+import {home} from "./home.mjs";
+
+const here = dirname(fileURLToPath(import.meta.url));
+const core = `${libraryPath(home, "open-abap-core")}/src`;
+const MAX = 9223372036854775807n, MIN = -9223372036854775808n;
+
+test("ParseI8 in the JS runtime: exact, rounded half away from zero", () => {
+  for (const [v, want] of [
+    ["", 0n], ["   ", 0n], [" 12 ", 12n], ["+12", 12n], ["-12", -12n], ["12-", -12n], ["- 12", -12n],
+    ["0012", 12n], ["2.5", 3n], ["-2.5", -3n], ["2.4", 2n], ["-0.5", -1n], [".5", 1n], ["5.", 5n],
+    ["9223372036854775807", MAX], ["-9223372036854775808", MIN], [" 9223372036854775807 ", MAX],
+    ["9223372036854775806.5", MAX], ["9223372036854775807.4", MAX], ["-9223372036854775808.4", MIN],
+    ["-9223372036854775807.5", MIN], ["00009223372036854775807", MAX], ["1234567890123456789", 1234567890123456789n],
+  ]) assert.equal(ParseI8(v), want, v);
+  for (const [v, cls] of [
+    ["9223372036854775808", "CX_SY_CONVERSION_OVERFLOW"], ["-9223372036854775809", "CX_SY_CONVERSION_OVERFLOW"],
+    ["9223372036854775807.5", "CX_SY_CONVERSION_OVERFLOW"], ["-9223372036854775808.5", "CX_SY_CONVERSION_OVERFLOW"],
+    ["99999999999999999999", "CX_SY_CONVERSION_OVERFLOW"], ["9999999999999999999.9", "CX_SY_CONVERSION_OVERFLOW"],
+    ["abc", "CX_SY_CONVERSION_NO_NUMBER"], ["-", "CX_SY_CONVERSION_NO_NUMBER"], [".", "CX_SY_CONVERSION_NO_NUMBER"],
+    ["1E3", "CX_SY_CONVERSION_NO_NUMBER"], ["12 3", "CX_SY_CONVERSION_NO_NUMBER"], ["+-1", "CX_SY_CONVERSION_NO_NUMBER"],
+    ["1.5.2", "CX_SY_CONVERSION_NO_NUMBER"], ["12a", "CX_SY_CONVERSION_NO_NUMBER"],
+  ]) assert.throws(() => ParseI8(v), (e) => e.cls === cls, v);
+});
+
+const SOURCE = `
+CLASS zcl_gogen_t_s2i8 DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+  PRIVATE SECTION.
+    CLASS-METHODS to_i8 IMPORTING iv_text TYPE string RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+CLASS zcl_gogen_t_s2i8 IMPLEMENTATION.
+  METHOD to_i8.
+    DATA lv_i8 TYPE int8.
+    TRY.
+        lv_i8 = iv_text.
+        rv = |{ lv_i8 }|.
+      CATCH cx_sy_conversion_overflow.
+        rv = 'OV'.
+      CATCH cx_sy_conversion_no_number.
+        rv = 'NN'.
+    ENDTRY.
+  ENDMETHOD.
+  METHOD run.
+    DATA lt_text TYPE STANDARD TABLE OF string WITH DEFAULT KEY.
+    DATA lv_text TYPE string.
+    APPEND \`9223372036854775807\` TO lt_text.
+    APPEND \` -9223372036854775808 \` TO lt_text.
+    APPEND \`9223372036854775808\` TO lt_text.
+    APPEND \`9223372036854775806.5\` TO lt_text.
+    APPEND \`9223372036854775807.5\` TO lt_text.
+    APPEND \`-2.5\` TO lt_text.
+    APPEND \`\` TO lt_text.
+    APPEND \`abc\` TO lt_text.
+    LOOP AT lt_text INTO lv_text.
+      rv = rv && to_i8( lv_text ) && \`;\`.
+    ENDLOOP.
+  ENDMETHOD.
+ENDCLASS.
+`;
+const WANT = "9223372036854775807;-9223372036854775808;OV;9223372036854775807;OV;-3;0;NN;";
+
+test("string to int8 assignment in generated Go and JS", async () => {
+  const sourceDir = mkdtempSync(join(tmpdir(), "gogen-s2i8-"));
+  const goDir = mkdtempSync(join(here, "go", "cmd", "gogen-s2i8-test-"));
+  try {
+    writeFileSync(join(sourceDir, "zcl_gogen_t_s2i8.clas.abap"), SOURCE);
+    const program = compileProgram({folders: [sourceDir, core], objects: ["ZCL_GOGEN_T_S2I8", "CX_ROOT", "CX_STATIC_CHECK", "CX_DYNAMIC_CHECK", "CX_NO_CHECK", "CL_MESSAGE_HELPER"]});
+    assert.deepEqual(program.partial.filter((p) => p.startsWith("ZCL_GOGEN_T_S2I8")), []);
+    const js = emitJs(program, new URL("./js/abap.mjs", import.meta.url).href);
+    assert.match(js, /abap\.ParseI8\(/);
+    const m = await import(`data:text/javascript;base64,${Buffer.from(js).toString("base64")}`);
+    assert.equal(m.ZCL_GOGEN_T_S2I8.RUN({sy: {index: 0, tabix: 0, subrc: 0, dbcnt: 0}}), WANT);
+    const go = emitGo(program);
+    assert.match(go, /abap\.ParseI8\(/);
+    writeFileSync(join(goDir, "zz_generated.go"), go);
+    writeFileSync(join(goDir, "zz_generated_test.go"), `package main\nimport ("testing"; "osg/gogen/abap")\nfunc TestS2I8(t *testing.T) { if got := ZCL_GOGEN_T_S2I8_RUN(&abap.Session{}); got != ${JSON.stringify(WANT)} { t.Fatalf("got %q", got) } }\n`);
+    const run = spawnSync("go", ["test", "-vet=off", `./cmd/${basename(goDir)}`], {cwd: join(here, "go"), encoding: "utf8", timeout: 120000});
+    assert.equal(run.status, 0, run.stderr || run.stdout);
+  } finally {
+    rmSync(sourceDir, {recursive: true, force: true});
+    rmSync(goDir, {recursive: true, force: true});
+  }
+});
