+// ParseI8 converts a character value to int8 (int64), as A4H does.
+// Blanks around it, one sign -- a leading + or -, or a trailing -, a blank
+// between it and the digits allowed -- and digits with at most one point;
+// no exponent, nothing after a blank. The fraction rounds half away from
+// zero; past int64's range is CX_SY_CONVERSION_OVERFLOW, anything else
+// CX_SY_CONVERSION_NO_NUMBER. Blanks are 0.
+func ParseI8(v string) int64 {
+	t := strings.Trim(v, " ")
+	if t == "" {
+		return 0
+	}
+	neg, body, ok := numSign(t)
+	body = strings.Trim(body, " ")
+	if !ok || !decimalDigits(body) {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_NO_NUMBER", Op: "c->int8"})
+	}
+	whole, frac := body, ""
+	if i := strings.IndexByte(body, '.'); i >= 0 {
+		whole, frac = body[:i], body[i+1:]
+	}
+	whole = strings.TrimLeft(whole, "0")
+	if len(whole) > 19 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	var n uint64
+	for i := 0; i < len(whole); i++ {
+		n = n*10 + uint64(whole[i]-'0')
+	}
+	if frac != "" && frac[0] >= '5' {
+		n++
+	}
+	const minI8Mag = uint64(math.MaxInt64) + 1 // 9223372036854775808
+	if neg {
+		if n > minI8Mag {
+			panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+		}
+		if n == minI8Mag {
+			return math.MinInt64
+		}
+		return -int64(n)
+	}
+	if n > math.MaxInt64 {
+		panic(ArithmeticError{Class: "CX_SY_CONVERSION_OVERFLOW", Op: "c->int8"})
+	}
+	return int64(n)
+}
