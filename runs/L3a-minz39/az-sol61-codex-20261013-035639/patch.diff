diff --git a/minzc/pkg/nanz/logical_test.go b/minzc/pkg/nanz/logical_test.go
new file mode 100644
index 0000000..27a2293
--- /dev/null
+++ b/minzc/pkg/nanz/logical_test.go
@@ -0,0 +1,141 @@
+package nanz_test
+
+import (
+	"fmt"
+	"regexp"
+	"testing"
+
+	"github.com/minz/minzc/pkg/emulator"
+	"github.com/minz/minzc/pkg/hir"
+	"github.com/minz/minzc/pkg/mir2"
+	"github.com/minz/minzc/pkg/nanz"
+	"github.com/minz/minzc/pkg/pipeline"
+	"github.com/minz/minzc/pkg/z80asm"
+)
+
+func TestLogicalPrecedence(t *testing.T) {
+	cases := []struct{ expr, tree string }{
+		{"a || b && c", "(|| a (&& b c))"},
+		{"a && b || c", "(|| (&& a b) c)"},
+		{"(a || b) && c", "(&& (|| a b) c)"},
+		{"a || b | c xor d & e == f < g << h + i * j", "(|| a (| b (^ c (& d (== e (< f (<< g (+ h (* i j)))))))))"},
+		{"a && b | c", "(&& a (| b c))"},
+		{"a || b || c", "(|| (|| a b) c)"},
+		{"a && b && c", "(&& (&& a b) c)"},
+	}
+	var tree func(hir.Expr) string
+	tree = func(e hir.Expr) string {
+		if b, ok := e.(*hir.BinExpr); ok {
+			return fmt.Sprintf("(%s %s %s)", b.Op, tree(b.L), tree(b.R))
+		}
+		return e.(*hir.VarRefExpr).Name
+	}
+	for _, tc := range cases {
+		t.Run(tc.expr, func(t *testing.T) {
+			m, err := nanz.Parse("fun entry(a:u8,b:u8,c:u8,d:u8,e:u8,f:u8,g:u8,h:u8,i:u8,j:u8) -> bool { return "+tc.expr+" }", "precedence")
+			if err != nil {
+				t.Fatal(err)
+			}
+			e := m.Funcs[0].Body.Body[0].(*hir.ReturnStmt).Val
+			if got := tree(e); got != tc.tree {
+				t.Fatalf("got %s, want %s", got, tc.tree)
+			}
+			if e.ExprTy() != mir2.TyBool {
+				t.Fatalf("logical type = %v, want bool", e.ExprTy())
+			}
+			// The printed HIR must retain distinct logical operators on reparsing.
+			if _, err := nanz.Parse(nanz.Print(m), "roundtrip"); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+// The return value encodes the canonical boolean in the units digit and the
+// number of RHS/LHS calls in the tens digit. Run the same programs in MIR2's VM
+// and as compiled Z80 code to catch eager evaluation and flag/value mistakes.
+func TestLogicalExecution(t *testing.T) {
+	cases := []struct {
+		name, body  string
+		input, want int
+	}{
+		{"constant_false", "let r = false && bump(3)\nreturn (r as u8) + calls * 10", 0, 0},
+		{"constant_true", "let r = true || bump(3)\nreturn (r as u8) + calls * 10", 0, 1},
+		{"lhs_false_and", "let r = bump(a) && bump(3)\nreturn (r as u8) + calls * 10", 0, 10},
+		{"lhs_false_or", "let r = bump(a) || bump(3)\nreturn (r as u8) + calls * 10", 0, 21},
+		{"and_skip", "let r = a && bump(3)\nreturn (r as u8) + calls * 10", 0, 0},
+		{"and_true", "let r = a && bump(3)\nreturn (r as u8) + calls * 10", 2, 11},
+		{"and_false", "let r = a && bump(0)\nreturn (r as u8) + calls * 10", 2, 10},
+		{"or_skip", "let r = a || bump(3)\nreturn (r as u8) + calls * 10", 2, 1},
+		{"or_true", "let r = a || bump(3)\nreturn (r as u8) + calls * 10", 0, 11},
+		{"or_false", "let r = a || bump(0)\nreturn (r as u8) + calls * 10", 0, 10},
+		{"lhs_once_and", "let r = bump(a) && bump(3)\nreturn (r as u8) + calls * 10", 2, 21},
+		{"lhs_once_or", "let r = bump(a) || bump(3)\nreturn (r as u8) + calls * 10", 2, 11},
+		{"nested_skip", "let r = a || bump(0) && bump(3)\nreturn (r as u8) + calls * 10", 2, 1},
+		{"nested_rhs_skip", "let r = a || bump(0) && bump(3)\nreturn (r as u8) + calls * 10", 0, 10},
+		{"nested_parentheses", "let r = (a || bump(2)) && bump(3)\nreturn (r as u8) + calls * 10", 0, 21},
+		{"comparison", "let r = a > 1 && bump(3) == 3\nreturn (r as u8) + calls * 10", 2, 11},
+		{"bitwise_and", "let r = a & 3\nreturn r", 2, 2},
+		{"bitwise_or", "let r = a | 4\nreturn r", 2, 6},
+		{"bitwise_xor", "let r = a xor 3\nreturn r", 2, 1},
+		{"if_and_skip", "if a && bump(3) { return 99 }\nreturn calls", 0, 0},
+		{"if_or_skip", "if a || bump(3) { return 1 + calls * 10 }\nreturn 99", 2, 1},
+		{"while_and", "let i: u8 = 0\nwhile i < a && bump(3) { i = i + 1 }\nreturn i + calls * 10", 2, 22},
+		{"while_or", "let i: u8 = 0\nwhile i < a || bump(0) { i = i + 1 }\nreturn i + calls * 10", 2, 12},
+		{"bool_return", "return flag(a) as u8", 2, 1},
+		{"negated", "let r = !(a && bump(3))\nreturn (r as u8) + calls * 10", 2, 10},
+		{"wide_truth", "let r = (a as u16) << 8 && bump(3)\nreturn (r as u8) + calls * 10", 2, 11},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			src := `global calls: u8
+fun bump(v: u8) -> u8 { calls = calls + 1 return v }
+fun flag(v: u8) -> bool { return v && 3 }
+fun entry(a: u8) -> u8 { calls = 0
+` + tc.body + "\n}"
+			m, err := nanz.Parse(src, tc.name)
+			if err != nil {
+				t.Fatal(err)
+			}
+			vm := mir2.NewVM(hir.LowerModule(m))
+			got, err := vm.Call("entry", []mir2.Value{{I: int64(tc.input)}})
+			if err != nil || len(got) != 1 || got[0].I != int64(tc.want) {
+				t.Fatalf("VM result %v, error %v; want %d", got, err, tc.want)
+			}
+			asm, err := pipeline.CompileHIR(m)
+			if err != nil {
+				t.Fatal(err)
+			}
+			abi := regexp.MustCompile(`; fun entry\(a: u8 = ([A-Z]+)\)`).FindStringSubmatch(asm)
+			if len(abi) != 2 {
+				t.Fatalf("missing entry ABI: %s", asm)
+			}
+			boot := fmt.Sprintf("ORG 0x8000\nLD SP, 0xFF00\nLD %s, %d\nCALL entry\nDI\nHALT\n", abi[1], tc.input)
+			res, err := z80asm.NewAssembler().AssembleString(boot + asm)
+			if err != nil || len(res.Errors) > 0 {
+				t.Fatalf("assemble: %v, %v\n%s", err, res.Errors, asm)
+			}
+			cpu := emulator.NewRemogattoZ80()
+			if err := cpu.LoadMemory(0x8000, res.Binary); err != nil {
+				t.Fatal(err)
+			}
+			cpu.SetPC(0x8000)
+			if err := cpu.Run(); err != nil {
+				t.Fatal(err)
+			}
+			if got := cpu.GetRegisters().A; int(got) != tc.want {
+				t.Fatalf("Z80 result %d, want %d\n%s", got, tc.want, asm)
+			}
+		})
+	}
+}
+
+func TestLogicalEmptyLambda(t *testing.T) {
+	m, err := nanz.Parse("fun entry() -> u8 { let f = || { return 3 } return 0 }", "empty_lambda")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(m.Funcs) != 2 || len(m.Funcs[1].Params) != 0 {
+		t.Fatalf("empty lambda was not preserved: %v", m.Funcs)
+	}
+}
