+package nanz_test
+
+// Parser-level tests for the short-circuit logical operators && and ||:
+// tokenisation, precedence, associativity, constant folding, and type checks.
+// Execution semantics (short-circuit evaluation, canonical bool result) are
+// covered by logical_e2e_test.go.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/minz/minzc/pkg/hir"
+	"github.com/minz/minzc/pkg/mir2"
+	"github.com/minz/minzc/pkg/nanz"
+)
+
+// parseReturnExpr parses "fun probe(...) -> T { return <expr> }" and returns
+// the returned expression.
+func parseReturnExpr(t *testing.T, expr string) hir.Expr {
+	t.Helper()
+	src := "fun probe(a: u8, b: u8, c: u8) -> bool { return " + expr + " }"
+	m, err := nanz.Parse(src, "logical_parse_test")
+	if err != nil {
+		t.Fatalf("parse %q: %v", expr, err)
+	}
+	ret, ok := m.Funcs[0].Body.Body[0].(*hir.ReturnStmt)
+	if !ok {
+		t.Fatalf("first statement of %q is %T, want ReturnStmt", expr, m.Funcs[0].Body.Body[0])
+	}
+	return ret.Val
+}
+
+// expectBin asserts e is a BinExpr with the given op and returns it.
+func expectBin(t *testing.T, e hir.Expr, op string) *hir.BinExpr {
+	t.Helper()
+	bin, ok := e.(*hir.BinExpr)
+	if !ok {
+		t.Fatalf("got %T, want BinExpr %s", e, op)
+	}
+	if bin.Op != op {
+		t.Fatalf("got BinExpr %q, want %q", bin.Op, op)
+	}
+	return bin
+}
+
+func TestLogicalAndOrParse(t *testing.T) {
+	for _, tc := range []struct {
+		expr string
+		op   string
+	}{{"a > 0 && b > 0", "&&"}, {"a > 0 || b > 0", "||"}} {
+		e := parseReturnExpr(t, tc.expr)
+		bin := expectBin(t, e, tc.op)
+		if bin.Ty != mir2.TyBool {
+			t.Errorf("%s: result type %s, want bool", tc.expr, bin.Ty)
+		}
+		if _, ok := bin.L.(*hir.BinExpr); !ok {
+			t.Errorf("%s: left operand is %T, want comparison BinExpr", tc.expr, bin.L)
+		}
+		if _, ok := bin.R.(*hir.BinExpr); !ok {
+			t.Errorf("%s: right operand is %T, want comparison BinExpr", tc.expr, bin.R)
+		}
+	}
+}
+
+// TestLogicalPrecedence verifies the relative binding strength of && and ||
+// against each other and against the bitwise and comparison operators.
+// || binds loosest, then &&, then |, xor, &, ==/!=, relational, shifts,
+// additive, multiplicative.
+func TestLogicalPrecedence(t *testing.T) {
+	cases := []struct {
+		expr   string
+		topOp  string // operator expected at the root of the tree
+		lhsOp  string // operator expected on the left subtree ("-" = variable ref)
+		rhsOp  string // operator expected on the right subtree
+	}{
+		// && binds tighter than ||
+		{"a || b && c", "||", "-", "&&"},
+		{"a && b || c", "||", "&&", "-"},
+		// bitwise OR binds tighter than both logical operators
+		{"a || b | c", "||", "-", "|"},
+		{"a && b | c", "&&", "-", "|"},
+		// xor sits between | and &
+		{"a || b xor c", "||", "-", "^"},
+		{"a && b xor c", "&&", "-", "^"},
+		{"a xor b && c", "&&", "^", "-"},
+		// bitwise AND binds tighter than xor and the logical operators
+		{"a && b & c", "&&", "-", "&"},
+		{"a xor b & c", "^", "-", "&"},
+		// comparisons bind tighter than bitwise AND (as before)
+		{"a & b == c", "&", "-", "=="},
+		// comparisons bind tighter than the logical operators
+		{"a == 1 && b == 2", "&&", "==", "=="},
+		{"a < 1 || b > 2", "||", "<", ">"},
+		// shifts still bind tighter than additive, which binds tighter than
+		// comparisons and the logical operators
+		{"a << 1 + 2 == 3 && b", "&&", "==", "-"},
+		{"a + 1 << 2 || b", "||", "<<", "-"},
+	}
+	for _, tc := range cases {
+		e := parseReturnExpr(t, tc.expr)
+		bin := expectBin(t, e, tc.topOp)
+		checkSide := func(side hir.Expr, wantOp string, name string) {
+			t.Helper()
+			if wantOp == "-" {
+				if _, ok := side.(*hir.VarRefExpr); !ok {
+					t.Errorf("%s: %s operand is %T, want VarRefExpr", tc.expr, name, side)
+				}
+				return
+			}
+			sideBin, ok := side.(*hir.BinExpr)
+			if !ok {
+				t.Errorf("%s: %s operand is %T, want BinExpr", tc.expr, name, side)
+				return
+			}
+			if sideBin.Op != wantOp {
+				t.Errorf("%s: %s operand op %q, want %q", tc.expr, name, sideBin.Op, wantOp)
+			}
+		}
+		checkSide(bin.L, tc.lhsOp, "left")
+		checkSide(bin.R, tc.rhsOp, "right")
+	}
+}
+
+// TestLogicalAssociativity: both operators are left-associative.
+func TestLogicalAssociativity(t *testing.T) {
+	bin := expectBin(t, parseReturnExpr(t, "a > 0 && b > 0 && c > 0"), "&&")
+	if _, ok := bin.L.(*hir.BinExpr); !ok {
+		t.Errorf("left of &&-chain is %T, want nested BinExpr (left-associative)", bin.L)
+	}
+	bin = expectBin(t, parseReturnExpr(t, "a > 0 || b > 0 || c > 0"), "||")
+	if _, ok := bin.L.(*hir.BinExpr); !ok {
+		t.Errorf("left of ||-chain is %T, want nested BinExpr (left-associative)", bin.L)
+	}
+}
+
+// TestLogicalBitwiseDistinct: && / || are single tokens, distinct from the
+// bitwise & / | — "a && b" must not parse as "a & (&b)".
+func TestLogicalBitwiseDistinct(t *testing.T) {
+	bin := expectBin(t, parseReturnExpr(t, "a && b"), "&&")
+	if _, ok := bin.R.(*hir.VarRefExpr); !ok {
+		t.Errorf("right operand of && is %T, want VarRefExpr (no address-of)", bin.R)
+	}
+	bin = expectBin(t, parseReturnExpr(t, "a || b"), "||")
+	if _, ok := bin.R.(*hir.VarRefExpr); !ok {
+		t.Errorf("right operand of || is %T, want VarRefExpr", bin.R)
+	}
+	// Bitwise forms keep working (right side of & may be an address-of).
+	amp := expectBin(t, parseReturnExpr(t, "a & b"), "&")
+	if amp.L.(*hir.VarRefExpr).Name != "a" {
+		t.Errorf("bitwise & left operand changed: %v", amp.L)
+	}
+}
+
+// TestLogicalConstantFoldShapes: a literal left operand that decides the
+// result folds to a literal (and the fold cascades); every other case keeps
+// the operator so the lowerer can preserve evaluation order and produce a
+// canonical 0/1 result.
+func TestLogicalConstantFoldShapes(t *testing.T) {
+	// Decided cases fold to literals; the other operand is dropped entirely.
+	for _, tc := range []struct {
+		expr string
+		want bool
+	}{{"false && a", false}, {"true || a", true}, {"false && true", false}, {"true || false", true}} {
+		lit, ok := parseReturnExpr(t, tc.expr).(*hir.BoolLitExpr)
+		if !ok {
+			t.Errorf("%s: not folded to BoolLitExpr", tc.expr)
+			continue
+		}
+		if lit.Val != tc.want {
+			t.Errorf("%s: folded to %v, want %v", tc.expr, lit.Val, tc.want)
+		}
+	}
+	// Undecided literal operands keep the operator node.
+	for _, expr := range []string{
+		"true && a", "false || a", "a > 0 && true", "a > 0 || false",
+		"(true && false) || a",
+	} {
+		if _, ok := parseReturnExpr(t, expr).(*hir.BinExpr); !ok {
+			t.Errorf("%s: expected unfolded BinExpr", expr)
+		}
+	}
+}
+
+// TestLogicalOperandTypeErrors: aggregates cannot be used as boolean operands.
+func TestLogicalOperandTypeErrors(t *testing.T) {
+	bad := []string{
+		"struct Point { x: u8, y: u8 }\nfun probe() -> bool { var p: Point\n return true && p }",
+		"struct Point { x: u8, y: u8 }\nfun probe() -> bool { var p: Point\n return p || false }",
+	}
+	for _, src := range bad {
+		if _, err := nanz.Parse(src, "logical_err_test"); err == nil {
+			t.Errorf("parsed %q without error, want type error", src)
+		} else if !strings.Contains(err.Error(), "want bool or scalar") {
+			t.Errorf("error for %q mentions no operand type: %v", src, err)
+		}
+	}
+}
