+// lowerLogical lowers a short-circuit && / || expression to a canonical bool
+// value (exactly 0 or 1).  The right operand lives in its own block so its
+// side effects run only when the left operand leaves the result undecided:
+//
+//	a && b  →  if a { b != 0 } else { false }
+//	a || b  →  if a { true }  else { b != 0 }
+//
+// Every edge into the join block carries a constant.  Materialising flags
+// into registers on join edges is avoided on purpose: the Z80 backend's
+// flag→register copy assumes the carry convention (SBC A,A), which corrupts
+// Z-convention comparisons such as "x != 0" (emitted as AND A, which clears
+// carry).  Constant-only edges also guarantee the canonical 0/1 result
+// independent of each backend's bool representation (the Z80 comparison
+// idiom materialises true as 0xFF).
+//
+// The nanz parser folds literal operands away (see foldLogical); the literal
+// checks below keep direct HIR builders (objc, frill) correct as well.
+func (l *lowerer) lowerLogical(ex *BinExpr) mir2.Reg {
+	isAnd := ex.Op == "&&"
+
+	if v, ok := constBool(ex.L); ok {
+		if isAnd != v {
+			// false && R | true || R — the right operand is skipped entirely.
+			return l.bld.Const(boolInt(!isAnd), mir2.TyBool, mir2.ClassGeneral)
+		}
+		// true && R | false || R — R is always evaluated; result is its truth.
+		return l.lowerTruth(ex.R)
+	}
+	if v, ok := constBool(ex.R); ok {
+		if isAnd == v {
+			// L && true | L || false — result is the truth of L.
+			return l.lowerTruth(ex.L)
+		}
+		// L && false | L || true — L still runs (side effects), result is fixed.
+		l.lowerCond(ex.L)
+		return l.bld.Const(boolInt(!isAnd), mir2.TyBool, mir2.ClassGeneral)
+	}
+
+	rhsLabel := l.fresh("logic_rhs")
+	shortLabel := l.fresh("logic_short")
+	joinLabel := l.fresh("logic_join")
+
+	condL := l.lowerCond(ex.L)
+	if isAnd {
+		// false → result decided, skip the right operand entirely
+		l.bld.BrIf(condL, rhsLabel, nil, shortLabel, nil)
+	} else {
+		// true → result decided, skip the right operand entirely
+		l.bld.BrIf(condL, shortLabel, nil, rhsLabel, nil)
+	}
+
+	// Short-circuit arm: the left operand alone fixes the result.
+	l.bld.SwitchToNewBlock(shortLabel)
+	l.bld.Jmp(joinLabel, l.bld.Const(boolInt(!isAnd), mir2.TyBool, mir2.ClassGeneral))
+
+	// Right-operand arm: evaluate R (its side effects happen only here), then
+	// route through constant arms so the join receives exactly 0 or 1.
+	l.bld.SwitchToNewBlock(rhsLabel)
+	l.bld.Jmp(joinLabel, l.lowerTruth(ex.R))
+
+	join := l.bld.SwitchToNewBlock(joinLabel)
+	return l.bld.BlockParam(join, mir2.TyBool, classForExpr(mir2.TyBool))
+}
+
+// lowerTruth lowers e to its canonical bool value (0/1) by branching on its
+// truth and joining through two constant arms — the flag itself is never
+// materialised into a register (see lowerLogical for why).
+func (l *lowerer) lowerTruth(e Expr) mir2.Reg {
+	if v, ok := constBool(e); ok {
+		return l.bld.Const(boolInt(v), mir2.TyBool, mir2.ClassGeneral)
+	}
+	cond := l.lowerCond(e)
+	trueLabel := l.fresh("logic_true")
+	falseLabel := l.fresh("logic_false")
+	joinLabel := l.fresh("logic_join")
+	l.bld.BrIf(cond, trueLabel, nil, falseLabel, nil)
+
+	l.bld.SwitchToNewBlock(trueLabel)
+	l.bld.Jmp(joinLabel, l.bld.Const(1, mir2.TyBool, mir2.ClassGeneral))
+	l.bld.SwitchToNewBlock(falseLabel)
+	l.bld.Jmp(joinLabel, l.bld.Const(0, mir2.TyBool, mir2.ClassGeneral))
+
+	join := l.bld.SwitchToNewBlock(joinLabel)
+	return l.bld.BlockParam(join, mir2.TyBool, classForExpr(mir2.TyBool))
+}
+
+// constBool mirrors the nanz parser's constant-bool detection for HIR built
+// directly by other frontends.
+func constBool(e Expr) (val bool, isConst bool) {
+	switch ex := e.(type) {
+	case *BoolLitExpr:
+		return ex.Val, true
+	case *IntLitExpr:
+		return ex.Val != 0, true
+	}
+	return false, false
+}
+
+func boolInt(v bool) int64 {
+	if v {
+		return 1
+	}
+	return 0
+}
