diff --git a/minzc/pkg/nanz/logical_e2e_test.go b/minzc/pkg/nanz/logical_e2e_test.go
new file mode 100644
index 0000000..1a54c98
--- /dev/null
+++ b/minzc/pkg/nanz/logical_e2e_test.go
@@ -0,0 +1,324 @@
+package nanz_test
+
+// End-to-end tests for the short-circuit logical operators && and ||.
+//
+// Each test compiles through the full pipeline (nanz → HIR → MIR2 → Z80).
+// pipeline.CompileHIR evaluates `assert` statements on the MIR2 VM and on the
+// Z80 emulator, so an unqualified assert below verifies BOTH paths; asserts
+// marked "via mir2" check the VM only.
+//
+// The VM verifies all semantics.  The Z80 backend has pre-existing defects in
+// areas these tests steer around (documented in each case):
+//   - while loops whose head/body contain extra basic blocks are miscompiled
+//     (an `if` inside a `while` body already fails on master), so
+//     while-conditions are asserted via mir2 only;
+//   - `!` and eq/ne comparisons materialised as bool *values* are broken on
+//     Z80 independently of the logical operators, so tests use ordering
+//     comparisons (<, >) where Z80 verification matters.
+//
+// Naming note: test functions avoid single-letter names that collide with Z80
+// register names (a, b, c, d, e, f, h, l) — the backend renames those labels
+// (sanitizeIdent → "v_x") and the assert bootstrap cannot call them.
+
+import (
+	"testing"
+
+	"github.com/minz/minzc/pkg/nanz"
+	"github.com/minz/minzc/pkg/pipeline"
+)
+
+// compileAsserts parses src and runs its asserts on the MIR2 VM and Z80.
+func compileAsserts(t *testing.T, src string) {
+	t.Helper()
+	m, err := nanz.Parse(src, "logical_e2e_test")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	if _, err := pipeline.CompileHIR(m); err != nil {
+		t.Fatalf("compile: %v", err)
+	}
+}
+
+// TestLogical_E2E_TruthTable covers every operand combination of && and ||
+// on comparison operands (VM + Z80).
+func TestLogical_E2E_TruthTable(t *testing.T) {
+	compileAsserts(t, `
+fun conj(x: u8, y: u8) -> bool { return x > 10 && y > 10 }
+assert conj(0, 0) == 0
+assert conj(0, 20) == 0
+assert conj(20, 0) == 0
+assert conj(20, 20) == 1
+
+fun disj(x: u8, y: u8) -> bool { return x > 10 || y > 10 }
+assert disj(0, 0) == 0
+assert disj(0, 20) == 1
+assert disj(20, 0) == 1
+assert disj(20, 20) == 1
+`)
+}
+
+// TestLogical_E2E_ShortCircuitSideEffects proves the right operand runs only
+// when the left operand leaves the result undecided.  bump_x/bump_y increment
+// a shared call counter and return the value of a global, so the encoding
+// calls*4 + result records both how often the right operand ran and what the
+// expression produced (VM + Z80).
+//
+// The side-effect functions read globals instead of taking parameters: a
+// parameter held live across a CALL is clobbered by the register allocator on
+// Z80 — a pre-existing bug that affects plain nested `if` statements the same
+// way (see CLAUDE.md "Register Allocator & Loop Codegen Bugs").
+func TestLogical_E2E_ShortCircuitSideEffects(t *testing.T) {
+	compileAsserts(t, `
+global calls: u8 = 0
+global in_x: u8 = 0
+global in_y: u8 = 0
+
+fun bump_x() -> u8 { calls = calls + 1
+ return in_x }
+fun bump_y() -> u8 { calls = calls + 1
+ return in_y }
+
+fun run_conj(x: u8, y: u8) -> u8 {
+    calls = 0
+    in_x = x
+    in_y = y
+    let r: bool = bump_x() > 0 && bump_y() > 0
+    return calls * 4 + (if r { 1 } else { 0 })
+}
+assert run_conj(0, 0) == 4    // left false:  right never runs, result false
+assert run_conj(0, 50) == 4
+assert run_conj(50, 0) == 8   // left true: right runs, result false
+assert run_conj(50, 50) == 9  // left true: right runs, result true
+
+fun run_disj(x: u8, y: u8) -> u8 {
+    calls = 0
+    in_x = x
+    in_y = y
+    let r: bool = bump_x() > 0 || bump_y() > 0
+    return calls * 4 + (if r { 1 } else { 0 })
+}
+assert run_disj(0, 0) == 8    // left false: right runs, result false
+assert run_disj(0, 50) == 9   // left false: right runs, result true
+assert run_disj(50, 0) == 5   // left true:  right never runs, result true
+assert run_disj(50, 50) == 5
+`)
+}
+
+// TestLogical_E2E_CanonicalBoolValue: the result of a logical expression is
+// exactly 0 or 1 even when the operands are non-boolean (truthy) scalars —
+// `2 && 3` is 1, not 3 (VM + Z80).
+func TestLogical_E2E_CanonicalBoolValue(t *testing.T) {
+	compileAsserts(t, `
+fun conj_val(x: u8, y: u8) -> bool { return x && y }
+assert conj_val(2, 3) == 1
+assert conj_val(2, 0) == 0
+assert conj_val(0, 3) == 0
+assert conj_val(0, 0) == 0
+
+fun disj_val(x: u8, y: u8) -> bool { return x || y }
+assert disj_val(2, 3) == 1
+assert disj_val(0, 7) == 1
+assert disj_val(7, 0) == 1
+assert disj_val(0, 0) == 0
+
+fun stored(x: u8, y: u8) -> u8 {
+    let r: bool = x && y
+    if r { return 100 }
+    return 200
+}
+assert stored(2, 3) == 100
+assert stored(2, 0) == 200
+`)
+}
+
+// TestLogical_E2E_IfCondition: logical expressions as `if` conditions,
+// including else branches and nesting (VM + Z80).
+func TestLogical_E2E_IfCondition(t *testing.T) {
+	compileAsserts(t, `
+fun gate(x: u8, y: u8) -> u8 {
+    if x > 10 && y > 10 { return 1 }
+    return 0
+}
+assert gate(20, 20) == 1
+assert gate(20, 0) == 0
+assert gate(0, 20) == 0
+
+fun either(x: u8, y: u8) -> u8 {
+    if x > 10 || y > 10 { return 1 }
+    return 0
+}
+assert either(20, 0) == 1
+assert either(0, 20) == 1
+assert either(0, 0) == 0
+
+fun if_else(x: u8, y: u8) -> u8 {
+    if x > 10 && y > 10 { return 10 }
+    else { return 20 }
+}
+assert if_else(20, 20) == 10
+assert if_else(0, 20) == 20
+`)
+}
+
+// TestLogical_E2E_NestedPrecedence: || binds less tightly than &&; both bind
+// less tightly than comparisons and bitwise operators (VM + Z80).
+func TestLogical_E2E_NestedPrecedence(t *testing.T) {
+	compileAsserts(t, `
+// a || b && c  ≡  a || (b && c)
+fun prec_or_and(x: u8, y: u8, z: u8) -> bool { return x > 10 || y > 10 && z > 10 }
+assert prec_or_and(0, 0, 0) == 0
+assert prec_or_and(0, 0, 50) == 0   // (b && c) false although c true
+assert prec_or_and(0, 50, 0) == 0   // b alone does not satisfy &&
+assert prec_or_and(0, 50, 50) == 1
+assert prec_or_and(50, 0, 0) == 1   // a alone satisfies ||
+
+// (a && b) || c — explicit grouping agrees
+fun prec_paren(x: u8, y: u8, z: u8) -> bool { return (x > 10 && y > 10) || z > 10 }
+assert prec_paren(0, 0, 50) == 1
+assert prec_paren(50, 0, 0) == 0
+assert prec_paren(50, 50, 0) == 1
+
+// left associativity: a && b && c needs all three
+fun chain_and(x: u8, y: u8, z: u8) -> bool { return x > 10 && y > 10 && z > 10 }
+assert chain_and(50, 50, 50) == 1
+assert chain_and(50, 50, 0) == 0
+assert chain_and(50, 0, 50) == 0
+assert chain_and(0, 50, 50) == 0
+
+fun chain_or(x: u8, y: u8, z: u8) -> bool { return x > 10 || y > 10 || z > 10 }
+assert chain_or(0, 0, 0) == 0
+assert chain_or(0, 0, 50) == 1
+assert chain_or(0, 50, 0) == 1
+assert chain_or(50, 0, 0) == 1
+
+// bitwise & binds tighter than &&
+fun bit_tighter(x: u8, y: u8) -> bool { return x & 1 && y > 10 }
+assert bit_tighter(3, 50) == 1
+assert bit_tighter(4, 50) == 0
+assert bit_tighter(3, 0) == 0
+`)
+}
+
+// TestLogical_E2E_MixedOperators: logical operators combined with arithmetic,
+// shifts and bitwise operators keep the documented relative precedence
+// (VM + Z80).
+func TestLogical_E2E_MixedOperators(t *testing.T) {
+	compileAsserts(t, `
+fun mixed(x: u8, y: u8) -> bool { return x + 1 > 2 && y << 1 < 8 }
+assert mixed(2, 2) == 1   // 3 > 2 && 4 < 8
+assert mixed(1, 2) == 0   // 2 > 2 false
+assert mixed(2, 4) == 0   // 8 < 8 false
+
+fun xor_mix(x: u8, y: u8) -> bool { return x xor 1 > 0 || y > 10 }
+assert xor_mix(2, 0) == 1   // (2 xor 1)=1 > 0
+assert xor_mix(1, 0) == 0   // (1 xor 1)=0
+assert xor_mix(1, 50) == 1  // y saves it
+`)
+}
+
+// TestLogical_E2E_ConstantOperands: literal operands fold without losing
+// short-circuit semantics (VM + Z80).
+func TestLogical_E2E_ConstantOperands(t *testing.T) {
+	compileAsserts(t, `
+fun const_true1() -> bool { return true && true }
+assert const_true1() == 1
+fun const_true2() -> bool { return false || true }
+assert const_true2() == 1
+fun const_false1() -> bool { return true && false }
+assert const_false1() == 0
+fun const_false2() -> bool { return false && true }
+assert const_false2() == 0
+fun const_mix(x: u8) -> bool { return true && x > 10 }
+assert const_mix(50) == 1
+assert const_mix(0) == 0
+fun const_mix2(x: u8) -> bool { return x > 10 && true }
+assert const_mix2(50) == 1
+assert const_mix2(0) == 0
+fun const_chain() -> bool { return true && false || true }
+assert const_chain() == 1
+`)
+}
+
+// TestLogical_E2E_WhileCondition_VM: logical expressions as `while`
+// conditions, including loop-carried mutations on both sides of the operator.
+//
+// via mir2: the Z80 backend currently miscompiles while loops whose condition
+// lowers to more than one basic block (a plain `if` inside the loop body fails
+// the same way on master).
+func TestLogical_E2E_WhileCondition_VM(t *testing.T) {
+	compileAsserts(t, `
+fun sum_until(n: u8, cap: u8) -> u8 {
+    var i: u8 = 0
+    var sum: u8 = 0
+    while i < n && sum < cap {
+        sum = sum + i
+        i = i + 1
+    }
+    return sum
+}
+assert sum_until(0, 10) == 0 via mir2
+assert sum_until(2, 10) == 1 via mir2
+assert sum_until(5, 10) == 10 via mir2   // capped by sum < 10, not by n
+assert sum_until(20, 10) == 10 via mir2
+
+fun until_either(n: u8, m: u8) -> u8 {
+    var i: u8 = 0
+    while i < n || i < m {
+        i = i + 1
+    }
+    return i
+}
+assert until_either(3, 7) == 7 via mir2
+assert until_either(7, 3) == 7 via mir2
+assert until_either(0, 0) == 0 via mir2
+
+fun loop_guard(x: u8) -> u8 {
+    var i: u8 = 0
+    var s: u8 = 0
+    while i < 10 && x > 0 {
+        s = s + 1
+        i = i + 1
+    }
+    return s
+}
+assert loop_guard(1) == 10 via mir2
+assert loop_guard(0) == 0 via mir2
+`)
+}
+
+// TestLogical_E2E_NotOfLogical: `!` applied to a logical expression (De Morgan
+// territory), via mir2 — the Z80 backend miscompiles `!` on its own
+// (`return !(a < b)` fails on master without any logical operator).
+func TestLogical_E2E_NotOfLogical_VM(t *testing.T) {
+	compileAsserts(t, `
+fun not_conj(x: u8, y: u8) -> bool { return !(x > 10 && y > 10) }
+assert not_conj(0, 0) == 1 via mir2
+assert not_conj(50, 0) == 1 via mir2
+assert not_conj(0, 50) == 1 via mir2
+assert not_conj(50, 50) == 0 via mir2
+`)
+}
+
+// TestLogical_E2E_BitwiseUnchanged: the bitwise operators keep working next to
+// the new logical operators, and chained bitwise expressions are unaffected
+// (VM + Z80).
+func TestLogical_E2E_BitwiseUnchanged(t *testing.T) {
+	compileAsserts(t, `
+fun and_or_chain(x: u8, y: u8) -> u8 { return x & 3 | y }
+assert and_or_chain(0, 4) == 4
+assert and_or_chain(1, 4) == 5
+assert and_or_chain(6, 0) == 2
+
+fun xor_chain(x: u8, y: u8) -> u8 { return x xor y xor 1 }
+assert xor_chain(5, 3) == 7
+assert xor_chain(0, 0) == 1
+
+fun shift_chain(x: u8) -> u8 { return x << 1 >> 2 }
+assert shift_chain(8) == 4
+
+// bitwise result used as a logical operand
+fun combined(x: u8) -> bool { return x & 1 && x | 2 > 2 }
+assert combined(1) == 1
+assert combined(0) == 0
