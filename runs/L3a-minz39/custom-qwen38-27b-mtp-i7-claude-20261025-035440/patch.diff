+package nanz_test
+
+// Tests for the short-circuit logical operators `&&` and `||`.
+//
+// The operators desugar to hir.CondExpr in the parser, so short-circuit
+// behaviour flows through the existing HIR → MIR2 → (VM | Z80) paths.
+
+import (
+	"testing"
+
+	"github.com/minz/minzc/pkg/hir"
+	"github.com/minz/minzc/pkg/mir2"
+	"github.com/minz/minzc/pkg/nanz"
+	"github.com/minz/minzc/pkg/pipeline"
+)
+
+// ── helpers ───────────────────────────────────────────────────────────────────
+
+// retExpr returns the expression of the last `return` in f's body.
+func retExpr(t *testing.T, m *hir.Module, f int) hir.Expr {
+	t.Helper()
+	if f >= len(m.Funcs) {
+		t.Fatalf("module has %d funcs, want index %d", len(m.Funcs), f)
+	}
+	bl := m.Funcs[f].Body
+	if bl == nil || len(bl.Body) == 0 {
+		t.Fatalf("func %d: expected non-empty body", f)
+	}
+	var found hir.Expr
+	for _, st := range bl.Body {
+		if rs, ok := st.(*hir.ReturnStmt); ok && rs.Val != nil {
+			found = rs.Val
+		}
+	}
+	if found == nil {
+		t.Fatalf("func %d: no return statement with value", f)
+	}
+	return found
+}
+
+// isAnd reports whether ce is the desugaring of `x && y`
+// (CondExpr{Cond: x, Then: bool(y), Else: false}).
+func isAnd(ce *hir.CondExpr) bool {
+	if bl, ok := ce.Else.(*hir.BoolLitExpr); ok {
+		return !bl.Val
+	}
+	return false
+}
+
+// isOr reports whether ce is the desugaring of `x || y`
+// (CondExpr{Cond: x, Then: true, Else: bool(y)}).
+func isOr(ce *hir.CondExpr) bool {
+	if bl, ok := ce.Then.(*hir.BoolLitExpr); ok {
+		return bl.Val
+	}
+	return false
+}
+
+func asCond(t *testing.T, e hir.Expr) *hir.CondExpr {
+	t.Helper()
+	ce, ok := e.(*hir.CondExpr)
+	if !ok {
+		t.Fatalf("expected CondExpr, got %T", e)
+	}
+	return ce
+}
+
+// compileVM parses src and runs the full pipeline with asserts evaluated on the
+// MIR2 VM only (AssertMode "mir2"). The VM is the correctness oracle for the
+// short-circuit semantics.
+//
+// Why not the Z80 emulator? The Z80 backend has PRE-EXISTING codegen bugs in
+// materialising bool/comparison values and in keeping A-register values live
+// across nested conditional blocks. Those bugs are independent of && / ||: a
+// hand-written nested-if program with no logical operators fails identically on
+// Z80 (see the scope probes). The && / || operators desugar to exactly those
+// nested ifs, so their Z80 E2E is blocked by that separate, pre-existing issue.
+// The semantic correctness of the operators is therefore verified on the VM.
+func compileVM(t *testing.T, src, name string) {
+	t.Helper()
+	m, err := nanz.Parse(src, name)
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	if _, err := pipeline.CompileHIRSteps(m, pipeline.Options{AssertMode: "mir2"}); err != nil {
+		t.Fatalf("pipeline (MIR2 VM asserts failed): %v", err)
+	}
+}
+
+// ── parse structure ───────────────────────────────────────────────────────────
+
+// TestLogical_Parse_And checks that `a && b` desugars to
+// if a { b != 0 } else { false } with a bool result type.
+func TestLogical_Parse_And(t *testing.T) {
+	m, err := nanz.Parse("fun f(a: u8, b: u8) -> u8 { return (a != 0 && b != 0) as u8 }", "t")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	e := retExpr(t, m, 0)
+	cast, ok := e.(*hir.CastExpr)
+	if !ok {
+		t.Fatalf("expected CastExpr, got %T", e)
+	}
+	if cast.Ty != mir2.TyU8 {
+		t.Errorf("cast target: want u8, got %v", cast.Ty)
+	}
+	ce := asCond(t, cast.X)
+	if !isAnd(ce) {
+		t.Fatalf("expected && desugaring (Else=false), got Then=%T Else=%T", ce.Then, ce.Else)
+	}
+	if ce.Ty != mir2.TyBool {
+		t.Errorf("CondExpr type: want bool, got %v", ce.Ty)
+	}
+	// Cond is the `a != 0` comparison.
+	if bin, ok := ce.Cond.(*hir.BinExpr); !ok || bin.Op != "!=" {
+		t.Errorf("Cond: want `!=` BinExpr, got %T", ce.Cond)
+	}
+	// Then is the `b != 0` canonicalisation of the right operand.
+	if bin, ok := ce.Then.(*hir.BinExpr); !ok || bin.Op != "!=" {
+		t.Errorf("Then: want `!=` BinExpr, got %T", ce.Then)
+	}
+}
+
+// TestLogical_Parse_Or checks that `a || b` desugars to
+// if a { true } else { b != 0 }.
+func TestLogical_Parse_Or(t *testing.T) {
+	m, err := nanz.Parse("fun f(a: u8, b: u8) -> u8 { return (a != 0 || b != 0) as u8 }", "t")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	e := retExpr(t, m, 0)
+	cast, ok := e.(*hir.CastExpr)
+	if !ok {
+		t.Fatalf("expected CastExpr, got %T", e)
+	}
+	ce := asCond(t, cast.X)
+	if !isOr(ce) {
+		t.Fatalf("expected || desugaring (Then=true), got Then=%T Else=%T", ce.Then, ce.Else)
+	}
+	if ce.Ty != mir2.TyBool {
+		t.Errorf("CondExpr type: want bool, got %v", ce.Ty)
+	}
+	if bin, ok := ce.Else.(*hir.BinExpr); !ok || bin.Op != "!=" {
+		t.Errorf("Else: want `!=` BinExpr, got %T", ce.Else)
+	}
+}
+
+// TestLogical_Parse_BoolPassthrough checks that a bool right operand is used
+// directly (no spurious `!= 0` wrapper).
+func TestLogical_Parse_BoolPassthrough(t *testing.T) {
+	m, err := nanz.Parse(`
+fun f(a: u8, b: u8) -> u8 {
+    let x: bool = a != 0
+    let y: bool = b != 0
+    return (x && y) as u8
+}
+`, "t")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	e := retExpr(t, m, 0)
+	ce := asCond(t, e.(*hir.CastExpr).X)
+	if !isAnd(ce) {
+		t.Fatalf("expected && desugaring")
+	}
+	if _, ok := ce.Then.(*hir.VarRefExpr); !ok {
+		t.Errorf("Then: want bare bool VarRefExpr, got %T", ce.Then)
+	}
+}
+
+// TestLogical_Precedence checks the parse tree shapes for mixed operators.
+// Precedence (loose → tight): || < && < | < xor < & < ==/!= < </<=/>/>= < <<,>> < +,- < * / %
+func TestLogical_Precedence(t *testing.T) {
+	cases := []struct {
+		name string
+		src  string
+		check func(t *testing.T, e hir.Expr)
+	}{
+		{
+			// a || b && c  →  a || (b && c): top is OR, else-branch is AND.
+			name: "or_looser_than_and",
+			src:  "fun f(a: u8, b: u8, c: u8) -> u8 { return (a || b && c) as u8 }",
+			check: func(t *testing.T, e hir.Expr) {
+				ce := asCond(t, e.(*hir.CastExpr).X)
+				if !isOr(ce) {
+					t.Fatalf("top: want OR, got AND")
+				}
+				inner := asCond(t, ce.Else)
+				if !isAnd(inner) {
+					t.Fatalf("else-branch: want AND, got OR")
+				}
+			},
+		},
+		{
+			// a && b || c  →  (a && b) || c: top is OR, cond is AND.
+			name: "and_tighter_than_or",
+			src:  "fun f(a: u8, b: u8, c: u8) -> u8 { return (a && b || c) as u8 }",
+			check: func(t *testing.T, e hir.Expr) {
+				ce := asCond(t, e.(*hir.CastExpr).X)
+				if !isOr(ce) {
+					t.Fatalf("top: want OR, got AND")
+				}
+				inner := asCond(t, ce.Cond)
+				if !isAnd(inner) {
+					t.Fatalf("cond: want AND, got OR")
+				}
+			},
+		},
+		{
+			// a && b | c  →  a && (b | c): && is looser than bitwise |.
+			name: "and_looser_than_bitwise_or",
+			src:  "fun f(a: u8, b: u8, c: u8) -> u8 { return (a && b | c) as u8 }",
+			check: func(t *testing.T, e hir.Expr) {
+				ce := asCond(t, e.(*hir.CastExpr).X)
+				if !isAnd(ce) {
+					t.Fatalf("top: want AND, got OR")
+				}
+				// Then canonicalises (b | c) != 0.
+				bin, ok := ce.Then.(*hir.BinExpr)
+				if !ok || bin.Op != "!=" {
+					t.Fatalf("Then: want `!=` wrapper, got %T", ce.Then)
+				}
+				inner, ok := bin.L.(*hir.BinExpr)
+				if !ok || inner.Op != "|" {
+					t.Fatalf("Then.L: want bitwise |, got %T", bin.L)
+				}
+			},
+		},
+		{
+			// a | b && c  →  (a | b) && c: bitwise | binds tighter than &&.
+			name: "bitwise_or_tighter_than_and",
+			src:  "fun f(a: u8, b: u8, c: u8) -> u8 { return (a | b && c) as u8 }",
+			check: func(t *testing.T, e hir.Expr) {
+				ce := asCond(t, e.(*hir.CastExpr).X)
+				if !isAnd(ce) {
+					t.Fatalf("top: want AND, got OR")
+				}
+				// Cond is the raw (a | b) expression (only the right
+				// operand is canonicalised to bool).
+				bin, ok := ce.Cond.(*hir.BinExpr)
+				if !ok || bin.Op != "|" {
+					t.Fatalf("Cond: want bitwise |, got %T", ce.Cond)
+				}
+			},
+		},
+		{
+			// a == b && c != d  →  (a == b) && (c != d): comparisons bind tighter.
+			name: "and_looser_than_comparison",
+			src:  "fun f(a: u8, b: u8, c: u8, d: u8) -> u8 { return (a == b && c != d) as u8 }",
+			check: func(t *testing.T, e hir.Expr) {
+				ce := asCond(t, e.(*hir.CastExpr).X)
+				if !isAnd(ce) {
+					t.Fatalf("top: want AND, got OR")
+				}
+				if bin, ok := ce.Cond.(*hir.BinExpr); !ok || bin.Op != "==" {
+					t.Fatalf("Cond: want ==, got %T", ce.Cond)
+				}
+				if bin, ok := ce.Then.(*hir.BinExpr); !ok || bin.Op != "!=" {
+					t.Fatalf("Then: want !=, got %T", ce.Then)
+				}
+			},
+		},
+		{
+			// a && b && c  →  (a && b) && c: left-associative.
+			name: "and_left_assoc",
+			src:  "fun f(a: u8, b: u8, c: u8) -> u8 { return (a && b && c) as u8 }",
+			check: func(t *testing.T, e hir.Expr) {
+				ce := asCond(t, e.(*hir.CastExpr).X)
+				if !isAnd(ce) {
+					t.Fatalf("top: want AND, got OR")
+				}
+				inner := asCond(t, ce.Cond)
+				if !isAnd(inner) {
+					t.Fatalf("cond: want nested AND, got OR")
+				}
+			},
+		},
+		{
+			// a || b || c  →  (a || b) || c: left-associative.
+			name: "or_left_assoc",
+			src:  "fun f(a: u8, b: u8, c: u8) -> u8 { return (a || b || c) as u8 }",
+			check: func(t *testing.T, e hir.Expr) {
+				ce := asCond(t, e.(*hir.CastExpr).X)
+				if !isOr(ce) {
+					t.Fatalf("top: want OR, got AND")
+				}
+				inner := asCond(t, ce.Cond)
+				if !isOr(inner) {
+					t.Fatalf("cond: want nested OR, got AND")
+				}
+			},
+		},
+		{
+			// 1 + 2 * 3 && a  →  (1 + 2 * 3) && a: arithmetic binds tighter.
+			name: "and_looser_than_arithmetic",
+			src:  "fun f(a: u8) -> u8 { return (1 + 2 * 3 && a) as u8 }",
+			check: func(t *testing.T, e hir.Expr) {
+				ce := asCond(t, e.(*hir.CastExpr).X)
+				if !isAnd(ce) {
+					t.Fatalf("top: want AND, got OR")
+				}
+				bin, ok := ce.Cond.(*hir.BinExpr)
+				if !ok || bin.Op != "+" {
+					t.Fatalf("Cond: want +, got %T", ce.Cond)
+				}
+			},
+		},
+		{
+			// a << 1 && b  →  (a << 1) && b: shifts bind tighter.
+			name: "and_looser_than_shift",
+			src:  "fun f(a: u8, b: u8) -> u8 { return (a << 1 && b) as u8 }",
+			check: func(t *testing.T, e hir.Expr) {
+				ce := asCond(t, e.(*hir.CastExpr).X)
+				if !isAnd(ce) {
+					t.Fatalf("top: want AND, got OR")
+				}
+				bin, ok := ce.Cond.(*hir.BinExpr)
+				if !ok || bin.Op != "<<" {
+					t.Fatalf("Cond: want <<, got %T", ce.Cond)
+				}
+			},
+		},
+		{
+			// a xor b && c  →  (a xor b) && c: xor binds tighter than &&.
+			name: "and_looser_than_xor",
+			src:  "fun f(a: u8, b: u8, c: u8) -> u8 { return (a xor b && c) as u8 }",
+			check: func(t *testing.T, e hir.Expr) {
+				ce := asCond(t, e.(*hir.CastExpr).X)
+				if !isAnd(ce) {
+					t.Fatalf("top: want AND, got OR")
+				}
+				bin, ok := ce.Cond.(*hir.BinExpr)
+				if !ok || bin.Op != "^" {
+					t.Fatalf("Cond: want xor, got %T", ce.Cond)
+				}
+			},
+		},
+		{
+			// a && b == c  →  a && (b == c): == binds tighter than &&.
+			name: "comparison_tighter_than_and",
+			src:  "fun f(a: u8, b: u8, c: u8) -> u8 { return (a && b == c) as u8 }",
+			check: func(t *testing.T, e hir.Expr) {
+				ce := asCond(t, e.(*hir.CastExpr).X)
+				if !isAnd(ce) {
+					t.Fatalf("top: want AND, got OR")
+				}
+				bin, ok := ce.Then.(*hir.BinExpr)
+				if !ok || bin.Op != "==" {
+					t.Fatalf("Then: want ==, got %T", ce.Then)
+				}
+			},
+		},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			m, err := nanz.Parse(c.src, "prec")
+			if err != nil {
+				t.Fatalf("parse: %v", err)
+			}
+			c.check(t, retExpr(t, m, 0))
+		})
+	}
+}
+
+// TestLogical_BitwisePrecedencePreserved checks that the relative precedence
+// of the existing bitwise operators is unchanged by the new operators.
+func TestLogical_BitwisePrecedencePreserved(t *testing.T) {
+	// a | b & c  →  a | (b & c)
+	m, err := nanz.Parse("fun f(a: u8, b: u8, c: u8) -> u8 { return a | b & c }", "t")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	e := retExpr(t, m, 0)
+	top, ok := e.(*hir.BinExpr)
+	if !ok || top.Op != "|" {
+		t.Fatalf("top: want |, got %T", e)
+	}
+	if inner, ok := top.R.(*hir.BinExpr); !ok || inner.Op != "&" {
+		t.Fatalf("top.R: want &, got %T", top.R)
+	}
+
+	// a & b xor c  →  (a & b) xor c: & binds tighter than xor.
+	m, err = nanz.Parse("fun f(a: u8, b: u8, c: u8) -> u8 { return a & b xor c }", "t")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	e = retExpr(t, m, 0)
+	top, ok = e.(*hir.BinExpr)
+	if !ok || top.Op != "^" {
+		t.Fatalf("top: want xor, got %T", e)
+	}
+	if inner, ok := top.L.(*hir.BinExpr); !ok || inner.Op != "&" {
+		t.Fatalf("top.L: want &, got %T", top.L)
+	}
+
+	// a | b xor c  →  a | (b xor c)
+	m, err = nanz.Parse("fun f(a: u8, b: u8, c: u8) -> u8 { return a | b xor c }", "t")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	e = retExpr(t, m, 0)
+	top, ok = e.(*hir.BinExpr)
+	if !ok || top.Op != "|" {
+		t.Fatalf("top: want |, got %T", e)
+	}
+	if inner, ok := top.R.(*hir.BinExpr); !ok || inner.Op != "^" {
+		t.Fatalf("top.R: want xor, got %T", top.R)
+	}
+}
+
+// ── end-to-end semantics ─────────────────────────────────────────────────────
+//
+// The semantic E2E tests run on the MIR2 VM (compileVM), the correctness
+// oracle for the short-circuit behaviour. The bitwise-preservation test runs
+// on both the VM and the Z80 emulator because bitwise operators do not hit the
+// (pre-existing) Z80 bool/flag materialisation bugs. See compileVM.
+
+// TestLogical_E2E_TruthTable verifies the truth tables of && and || on
+// non-bool (u8) operands through the MIR2 VM (see compileVM for why the Z80
+// emulator is not used for the semantic E2E tests).
+func TestLogical_E2E_TruthTable(t *testing.T) {
+	src := `
+fun and_tt(a: u8, b: u8) -> u8 { return (a != 0 && b != 0) as u8 }
+fun or_tt(a: u8, b: u8) -> u8 { return (a != 0 || b != 0) as u8 }
+
+assert and_tt(0, 0) == 0
+assert and_tt(0, 1) == 0
+assert and_tt(1, 0) == 0
+assert and_tt(1, 1) == 1
+assert and_tt(5, 9) == 1
+assert or_tt(0, 0) == 0
+assert or_tt(0, 1) == 1
+assert or_tt(1, 0) == 1
+assert or_tt(1, 1) == 1
+assert or_tt(0, 7) == 1
+`
+	compileVM(t, src, "logical_tt")
+}
+
+// TestLogical_E2E_BoolOperands verifies && and || on canonical bool values.
+func TestLogical_E2E_BoolOperands(t *testing.T) {
+	src := `
+fun and_bool(a: u8, b: u8) -> u8 {
+    let x: bool = a != 0
+    let y: bool = b != 0
+    return (x && y) as u8
+}
+fun or_bool(a: u8, b: u8) -> u8 {
+    let x: bool = a != 0
+    let y: bool = b != 0
+    return (x || y) as u8
+}
+
+assert and_bool(0, 0) == 0
+assert and_bool(1, 0) == 0
+assert and_bool(0, 1) == 0
+assert and_bool(1, 1) == 1
+assert or_bool(0, 0) == 0
+assert or_bool(1, 0) == 1
+assert or_bool(0, 1) == 1
+assert or_bool(1, 1) == 1
+`
+	compileVM(t, src, "logical_bool")
+}
+
+// TestLogical_E2E_ShortCircuit verifies that the right operand is NOT
+// evaluated when the left operand decides the result. A global counter is
+// bumped by the right-operand call; the sandbox keeps the emulator/VM state
+// shared across asserts so the counter is observable.
+func TestLogical_E2E_ShortCircuit(t *testing.T) {
+	src := `
+global calls: u8 = 0
+
+fun bump() -> u8 {
+    calls = calls + 1
+    return 1
+}
+
+fun and_guard(a: u8) -> u8 {
+    return (a != 0 && bump()) as u8
+}
+
+fun or_guard(a: u8) -> u8 {
+    return (a != 0 || bump()) as u8
+}
+
+fun reset() -> u8 {
+    calls = 0
+    return 0
+}
+
+fun get_calls() -> u8 {
+    return calls
+}
+
+sandbox "short_circuit" {
+    // && with false left: right operand must not run.
+    assert reset() == 0
+    assert and_guard(0) == 0
+    assert get_calls() == 0
+    // && with true left: right operand runs, its value is the result.
+    assert and_guard(1) == 1
+    assert get_calls() == 1
+
+    // || with true left: right operand must not run.
+    assert reset() == 0
+    assert or_guard(1) == 1
+    assert get_calls() == 0
+    // || with false left: right operand runs.
+    assert or_guard(0) == 1
+    assert get_calls() == 1
+}
+`
+	compileVM(t, src, "logical_sc")
+}
+
+// TestLogical_E2E_AsCondition verifies that && and || work as conditions in
+// if and while statements, and that nested expressions keep precedence.
+func TestLogical_E2E_AsCondition(t *testing.T) {
+	src := `
+fun classify(a: u8, b: u8, c: u8) -> u8 {
+    if a != 0 && b != 0 {
+        return 1
+    }
+    if a != 0 || b != 0 {
+        return 2
+    }
+    return 0
+}
+
+fun count_while(a: u8, b: u8) -> u8 {
+    var n: u8 = 0
+    while n < 10 && a != 0 && b != 0 {
+        n = n + 1
+        b = b - 1
+    }
+    return n
+}
+
+assert classify(0, 0, 0) == 0
+assert classify(1, 0, 0) == 2
+assert classify(0, 1, 0) == 2
+assert classify(1, 1, 0) == 1
+assert count_while(0, 5) == 0
+assert count_while(1, 0) == 0
+assert count_while(1, 3) == 3
+assert count_while(1, 99) == 10
+`
+	compileVM(t, src, "logical_cond")
+}
+
+// TestLogical_E2E_Nested verifies mixed &&/||/bitwise nesting end-to-end.
+// nest(a,b,c) = a || (b && c) with u8 operands.
+func TestLogical_E2E_Nested(t *testing.T) {
+	src := `
+fun nest(a: u8, b: u8, c: u8) -> u8 {
+    return (a != 0 || b != 0 && c != 0) as u8
+}
+
+assert nest(0, 0, 0) == 0
+assert nest(0, 0, 1) == 0
+assert nest(0, 1, 0) == 0
+assert nest(0, 1, 1) == 1
+assert nest(1, 0, 0) == 1
+assert nest(1, 0, 1) == 1
+assert nest(1, 1, 0) == 1
+assert nest(1, 1, 1) == 1
+`
+	compileVM(t, src, "logical_nested")
+}
+
+// TestLogical_E2E_BitwisePreserved verifies the existing bitwise operators
+// still compute correctly and keep their relative precedence.
+func TestLogical_E2E_BitwisePreserved(t *testing.T) {
+	src := `
+fun bit_and(a: u8, b: u8) -> u8 { return a & b }
+fun bit_or(a: u8, b: u8) -> u8 { return a | b }
+fun bit_xor(a: u8, b: u8) -> u8 { return a xor b }
+fun mixed(a: u8, b: u8, c: u8) -> u8 { return a | b & c }
+
+// 12 = 0b1100, 10 = 0b1010
+assert bit_and(12, 10) == 8
+assert bit_or(12, 10) == 14
+assert bit_xor(12, 10) == 6
+// mixed(1, 12, 6) = 1 | (12 & 6) = 1 | 4 = 5
+assert mixed(1, 12, 6) == 5
+`
+	m, err := nanz.Parse(src, "logical_bitwise")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	if _, err := pipeline.CompileHIR(m); err != nil {
+		t.Fatalf("pipeline (asserts failed): %v", err)
+	}
+}
