+// lowerLogicalExpr lowers && and || through conditional expressions so the
+// right side is evaluated only when required.  Wrapping the right side in a
+// bool-valued conditional also normalizes arbitrary integer operands to 0/1.
+func (l *lowerer) lowerLogicalExpr(ex *BinExpr) mir2.Reg {
+	boolValue := func(cond Expr) Expr {
+		return &CondExpr{
+			Cond: cond,
+			Then: &BoolLitExpr{Val: true},
+			Else: &BoolLitExpr{Val: false},
+			Ty:   mir2.TyBool,
+		}
+	}
+	trueValue := &BoolLitExpr{Val: true}
+	falseValue := &BoolLitExpr{Val: false}
+
+	switch ex.Op {
+	case "&&":
+		return l.lowerCondExpr(&CondExpr{
+			Cond: ex.L,
+			Then: boolValue(ex.R),
+			Else: falseValue,
+			Ty:   mir2.TyBool,
+		})
+	case "||":
+		return l.lowerCondExpr(&CondExpr{
+			Cond: ex.L,
+			Then: trueValue,
+			Else: boolValue(ex.R),
+			Ty:   mir2.TyBool,
+		})
+	default:
+		panic(fmt.Sprintf("hir/lower: unhandled logical op %q", ex.Op))
+	}
+}
