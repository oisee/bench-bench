diff --git a/minzc/pkg/nanz/logical_ops_test.go b/minzc/pkg/nanz/logical_ops_test.go
new file mode 100644
index 0000000..66afd1e
--- /dev/null
+++ b/minzc/pkg/nanz/logical_ops_test.go
@@ -0,0 +1,116 @@
+package nanz_test
+
+import (
+	"testing"
+
+	"github.com/minz/minzc/pkg/hir"
+	"github.com/minz/minzc/pkg/mir2"
+	"github.com/minz/minzc/pkg/nanz"
+)
+
+func TestLogicalOperatorsShortCircuitAndNormalize(t *testing.T) {
+	src := `
+global hits: u8
+
+fun touch() -> u8 {
+	hits = hits + 1
+	return 7
+}
+
+fun and_skip() -> bool { return 0 && touch() }
+fun or_skip() -> bool { return 1 || touch() }
+fun and_eval() -> bool { return 1 && touch() }
+fun or_eval() -> bool { return 0 || touch() }
+fun logical_precedence() -> bool { return true || false && false }
+fun comparison_precedence() -> bool { return 1 == 1 && 2 < 3 }
+fun bitwise_precedence() -> bool { return true || 1 & 0 }
+
+fun compiled_side_effects() -> u8 {
+	hits = 0
+	0 && touch()
+	1 || touch()
+	1 && touch()
+	0 || touch()
+	return hits
+}
+
+fun conditions() -> u8 {
+	var n: u8 = 0
+	if true || false && false { n = n + 1 }
+	var i: u8 = 0
+	while i < 2 && true {
+		n = n + 1
+		i = i + 1
+	}
+	return n
+}
+`
+	hm, err := nanz.Parse(src, "logical_ops")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+
+	// The HIR must distinguish the operators and preserve their precedence.
+	precedence := hm.FuncByName("logical_precedence").Body.Body[0].(*hir.ReturnStmt).Val
+	root, ok := precedence.(*hir.BinExpr)
+	if !ok || root.Op != "||" {
+		t.Fatalf("logical root = %#v, want ||", precedence)
+	}
+	right, ok := root.R.(*hir.BinExpr)
+	if !ok || right.Op != "&&" {
+		t.Fatalf("right operand of || = %#v, want &&", root.R)
+	}
+
+	// Keep the preexisting bitwise ordering: | < xor < &.
+	bitwiseModule, err := nanz.Parse(`fun bits() -> u8 { return 1 | 2 xor 3 & 4 }`, "bitwise_precedence")
+	if err != nil {
+		t.Fatalf("parse bitwise precedence: %v", err)
+	}
+	bits := bitwiseModule.FuncByName("bits").Body.Body[0].(*hir.ReturnStmt).Val.(*hir.BinExpr)
+	if bits.Op != "|" {
+		t.Fatalf("bitwise root = %q, want |", bits.Op)
+	}
+	xor, ok := bits.R.(*hir.BinExpr)
+	if !ok || xor.Op != "xor" && xor.Op != "^" {
+		t.Fatalf("right operand of | = %#v, want xor", bits.R)
+	}
+	and, ok := xor.R.(*hir.BinExpr)
+	if !ok || and.Op != "&" {
+		t.Fatalf("right operand of xor = %#v, want &", xor.R)
+	}
+
+	vm := mir2.NewVM(hir.LowerModule(hm))
+	hits := func() int64 { return int64(vm.ReadHeap(vm.GlobalAddr("hits"), 1)[0]) }
+	check := func(name string, want int64) {
+		t.Helper()
+		got, callErr := vm.Call(name, nil)
+		if callErr != nil {
+			t.Fatalf("%s: %v", name, callErr)
+		}
+		if len(got) != 1 || got[0].I != want {
+			t.Fatalf("%s = %v, want %d", name, got, want)
+		}
+	}
+
+	check("and_skip", 0)
+	check("or_skip", 1)
+	if got := hits(); got != 0 {
+		t.Fatalf("short-circuited calls ran %d times, want 0", got)
+	}
+	check("and_eval", 1)
+	check("or_eval", 1)
+	if got := hits(); got != 2 {
+		t.Fatalf("evaluated calls ran %d times, want 2", got)
+	}
+	check("logical_precedence", 1)
+	check("comparison_precedence", 1)
+	check("bitwise_precedence", 1)
+	check("conditions", 3)
+
+	// Run generated Z80 code as well as the MIR2 VM to cover the compiler path.
+	if got, err := compileAndRunEnum(t, src, "compiled_side_effects"); err != nil {
+		t.Fatalf("compile/run short-circuit side effects: %v", err)
+	} else if got != 2 {
+		t.Fatalf("compiled short-circuit side effects = %d, want 2", got)
+	}
+}
