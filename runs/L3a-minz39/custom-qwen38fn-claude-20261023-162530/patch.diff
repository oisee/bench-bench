+package nanz_test
+
+// Tests for the short-circuit logical operators && and ||.
+// Covers parser precedence / associativity, MIR2 VM evaluation (truth tables,
+// canonical boolean values, side-effect short-circuiting), and Z80 E2E via the
+// emulator.  Bitwise & | xor keep their existing precedence and behavior.
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/minz/minzc/pkg/emulator"
+	"github.com/minz/minzc/pkg/hir"
+	"github.com/minz/minzc/pkg/mir2"
+	"github.com/minz/minzc/pkg/nanz"
+	"github.com/minz/minzc/pkg/pipeline"
+	"github.com/minz/minzc/pkg/z80asm"
+)
+
+// ── Parser structure ──────────────────────────────────────────────────────────
+
+func logicalReturn(t *testing.T, src string) hir.Expr {
+	t.Helper()
+	m, err := nanz.Parse(src, "logical_parse")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	ret, ok := m.Funcs[0].Body.Body[0].(*hir.ReturnStmt)
+	if !ok {
+		t.Fatalf("want ReturnStmt, got %T", m.Funcs[0].Body.Body[0])
+	}
+	return ret.Val
+}
+
+func TestLogical_Parse_AndOrAsCondExpr(t *testing.T) {
+	// a && b  →  CondExpr{Cond: a, Then: bool(b), Else: false}
+	e := logicalReturn(t, "fun f(a: bool, b: bool) -> bool { return a && b }")
+	ce, ok := e.(*hir.CondExpr)
+	if !ok {
+		t.Fatalf("&& : want *hir.CondExpr, got %T", e)
+	}
+	if ce.Ty != mir2.TyBool {
+		t.Errorf("&& : result type want bool, got %v", ce.Ty)
+	}
+	if _, ok := ce.Cond.(*hir.VarRefExpr); !ok {
+		t.Errorf("&& : Cond want VarRefExpr, got %T", ce.Cond)
+	}
+	bl, ok := ce.Else.(*hir.BoolLitExpr)
+	if !ok || bl.Val {
+		t.Errorf("&& : Else want BoolLitExpr(false), got %#v", ce.Else)
+	}
+
+	// a || b  →  CondExpr{Cond: a, Then: true, Else: bool(b)}
+	e = logicalReturn(t, "fun f(a: bool, b: bool) -> bool { return a || b }")
+	ce, ok = e.(*hir.CondExpr)
+	if !ok {
+		t.Fatalf("|| : want *hir.CondExpr, got %T", e)
+	}
+	if bl, ok := ce.Then.(*hir.BoolLitExpr); !ok || !bl.Val {
+		t.Errorf("|| : Then want BoolLitExpr(true), got %#v", ce.Then)
+	}
+}
+
+func TestLogical_Parse_Precedence(t *testing.T) {
+	// || binds looser than &&:  a && b || c  →  (a && b) || c
+	// top node must be the || (Cond = &&-CondExpr, Else = bool(c)).
+	e := logicalReturn(t, "fun f(a: bool, b: bool, c: bool) -> bool { return a && b || c }")
+	top, ok := e.(*hir.CondExpr)
+	if !ok {
+		t.Fatalf("want CondExpr, got %T", e)
+	}
+	if _, ok := top.Cond.(*hir.CondExpr); !ok {
+		t.Fatalf("&& should group first: top Cond want nested CondExpr, got %T", top.Cond)
+	}
+	// c is already bool → canonical result passes the operand through.
+	if _, ok := top.Else.(*hir.VarRefExpr); !ok {
+		t.Errorf("|| : Else want VarRefExpr(c), got %T", top.Else)
+	}
+
+	// a || b && c  →  a || (b && c): top is ||, nested && in Else.
+	e = logicalReturn(t, "fun f(a: bool, b: bool, c: bool) -> bool { return a || b && c }")
+	top, ok = e.(*hir.CondExpr)
+	if !ok {
+		t.Fatalf("want CondExpr, got %T", e)
+	}
+	if _, ok := top.Cond.(*hir.VarRefExpr); !ok {
+		t.Fatalf("|| : Cond want VarRefExpr(a), got %T", top.Cond)
+	}
+	if _, ok := top.Else.(*hir.CondExpr); !ok {
+		t.Fatalf("|| : Else want nested CondExpr(b && c), got %T", top.Else)
+	}
+
+	// Comparisons bind tighter than &&:  x > 0 && y > 0
+	// → Cond = BinExpr(">"), Then = BinExpr(">").
+	e = logicalReturn(t, "fun f(x: u8, y: u8) -> bool { return x > 0 && y > 0 }")
+	top, ok = e.(*hir.CondExpr)
+	if !ok {
+		t.Fatalf("want CondExpr, got %T", e)
+	}
+	if c, ok := top.Cond.(*hir.BinExpr); !ok || c.Op != ">" {
+		t.Errorf("Cond want comparison BinExpr, got %#v", top.Cond)
+	}
+	if th, ok := top.Then.(*hir.BinExpr); !ok || th.Op != ">" {
+		t.Errorf("Then want comparison BinExpr, got %#v", top.Then)
+	}
+
+	// Bitwise binds tighter than logical:  a & 1 && b & 2
+	// → Cond = BinExpr("&"), Then = BinExpr("!=") over BinExpr("&").
+	e = logicalReturn(t, "fun f(a: u8, b: u8) -> bool { return a & 1 && b & 2 }")
+	top, ok = e.(*hir.CondExpr)
+	if !ok {
+		t.Fatalf("want CondExpr, got %T", e)
+	}
+	if c, ok := top.Cond.(*hir.BinExpr); !ok || c.Op != "&" {
+		t.Errorf("bitwise-tighter: Cond want BinExpr(&), got %#v", top.Cond)
+	}
+
+	// | binds tighter than &&:  a | b && c  →  (a | b) && c
+	e = logicalReturn(t, "fun f(a: u8, b: u8, c: bool) -> bool { return a | b && c }")
+	top, ok = e.(*hir.CondExpr)
+	if !ok {
+		t.Fatalf("want CondExpr, got %T", e)
+	}
+	if c, ok := top.Cond.(*hir.BinExpr); !ok || c.Op != "|" {
+		t.Errorf("pipe-tighter: Cond want BinExpr(|), got %#v", top.Cond)
+	}
+
+	// xor binds tighter than &&:  a xor b && c
+	e = logicalReturn(t, "fun f(a: u8, b: u8, c: bool) -> bool { return a xor b && c }")
+	top, ok = e.(*hir.CondExpr)
+	if !ok {
+		t.Fatalf("want CondExpr, got %T", e)
+	}
+	if c, ok := top.Cond.(*hir.BinExpr); !ok || c.Op != "^" {
+		t.Errorf("xor-tighter: Cond want BinExpr(^), got %#v", top.Cond)
+	}
+
+	// Left associativity:  a && b && c  →  (a && b) && c
+	// top Cond = inner CondExpr; top Then = bool(c).
+	e = logicalReturn(t, "fun f(a: bool, b: bool, c: bool) -> bool { return a && b && c }")
+	top, ok = e.(*hir.CondExpr)
+	if !ok {
+		t.Fatalf("want CondExpr, got %T", e)
+	}
+	inner, ok := top.Cond.(*hir.CondExpr)
+	if !ok {
+		t.Fatalf("left-assoc: top Cond want nested CondExpr, got %T", top.Cond)
+	}
+	if _, ok := inner.Cond.(*hir.VarRefExpr); !ok {
+		t.Errorf("left-assoc: inner Cond want VarRefExpr(a), got %T", inner.Cond)
+	}
+}
+
+func TestLogical_Parse_ParenthesizedReturn(t *testing.T) {
+	// A leading parenthesised value must be able to continue into a larger
+	// expression (parseReturn tuple speculation must not truncate it).
+	m, err := nanz.Parse(`
+fun p1(a: u8, b: u8) -> u8 { return (a) + b }
+fun p2(a: u8, b: u8) -> u8 { return (a & 1) | b }
+fun p3(x: u8, y: u8, z: u8) -> bool { return (x != 0 || y != 0) && z != 0 }
+`, "logical_paren")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	if _, err := pipeline.CompileHIR(m); err != nil {
+		t.Fatalf("compile: %v", err)
+	}
+	// p3 must be (x||y) && z: outer && whose Cond is the inner ||.
+	ret := m.Funcs[2].Body.Body[0].(*hir.ReturnStmt)
+	top, ok := ret.Val.(*hir.CondExpr)
+	if !ok {
+		t.Fatalf("p3: want CondExpr, got %T", ret.Val)
+	}
+	if _, ok := top.Cond.(*hir.CondExpr); !ok {
+		t.Errorf("p3: outer && Cond want nested ||-CondExpr, got %T", top.Cond)
+	}
+	// VM-level check of the same shape.
+	if got := vmCall(t, `
+fun p3(x: u8, y: u8, z: u8) -> u8 { if (x != 0 || y != 0) && z != 0 { return 1 } return 0 }
+`, "p3", 1, 0, 0); got != 0 {
+		t.Errorf("p3(1,0,0) = %d, want 0", got)
+	}
+	if got := vmCall(t, `
+fun p3(x: u8, y: u8, z: u8) -> u8 { if (x != 0 || y != 0) && z != 0 { return 1 } return 0 }
+`, "p3", 0, 1, 1); got != 1 {
+		t.Errorf("p3(0,1,1) = %d, want 1", got)
+	}
+}
+
+func TestLogical_Parse_BitwiseAddressOfIntact(t *testing.T) {
+	// Single & is still bitwise AND / unary address-of, single | still bitwise OR.
+	m, err := nanz.Parse(`
+global g: u8
+fun band(a: u8, b: u8) -> u8 { return a & b }
+fun bor(a: u8, b: u8) -> u8 { return a | b }
+fun bxor(a: u8, b: u8) -> u8 { return a xor b }
+fun gaddr() -> ptr { return &g }
+`, "logical_bitwise")
+	if err != nil {
+		t.Fatalf("parse bitwise: %v", err)
+	}
+	if _, err := pipeline.CompileHIR(m); err != nil {
+		t.Fatalf("compile bitwise: %v", err)
+	}
+}
+
+// ── MIR2 VM evaluation ────────────────────────────────────────────────────────
+
+func vmCall(t *testing.T, src, fn string, args ...int64) int64 {
+	t.Helper()
+	m, err := nanz.Parse(src, "logical_vm")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	vm := mir2.NewVM(hir.LowerModule(m))
+	vals, err := vm.Call(fn, mkVals(args...))
+	if err != nil {
+		t.Fatalf("vm call @%s: %v", fn, err)
+	}
+	if len(vals) == 0 {
+		t.Fatalf("vm call @%s: no return value", fn)
+	}
+	return vals[0].I
+}
+
+func mkVals(xs ...int64) []mir2.Value {
+	vs := make([]mir2.Value, len(xs))
+	for i, x := range xs {
+		vs[i] = mir2.Value{I: x}
+	}
+	return vs
+}
+
+const logicalTruthSrc = `
+fun land(x: u8, y: u8) -> u8 { if x != 0 && y != 0 { return 1 } return 0 }
+fun lor(x: u8, y: u8) -> u8 { if x != 0 || y != 0 { return 1 } return 0 }
+fun lnest(x: u8, y: u8, z: u8) -> u8 { if x != 0 || y != 0 && z != 0 { return 1 } return 0 }
+fun lp2(x: u8, y: u8, z: u8) -> u8 { if (x != 0 || y != 0) && z != 0 { return 1 } return 0 }
+fun landv(x: u8, y: u8) -> bool { return x != 0 && y != 0 }
+fun lorv(x: u8, y: u8) -> bool { return x != 0 || y != 0 }
+fun lnotland(x: u8, y: u8) -> bool { return !(x != 0 && y != 0) }
+`
+
+func TestLogical_VM_TruthTable(t *testing.T) {
+	cases := []struct {
+		fn   string
+		args []int64
+		want int64
+	}{
+		{"land", []int64{0, 0}, 0},
+		{"land", []int64{0, 1}, 0},
+		{"land", []int64{1, 0}, 0},
+		{"land", []int64{1, 1}, 1},
+		{"land", []int64{200, 3}, 1},
+		{"lor", []int64{0, 0}, 0},
+		{"lor", []int64{0, 1}, 1},
+		{"lor", []int64{1, 0}, 1},
+		{"lor", []int64{1, 1}, 1},
+		// nesting: x || (y && z)
+		{"lnest", []int64{1, 0, 0}, 1},
+		{"lnest", []int64{0, 1, 1}, 1},
+		{"lnest", []int64{0, 1, 0}, 0},
+		{"lnest", []int64{0, 0, 1}, 0},
+		// parens override: (x || y) && z
+		{"lp2", []int64{1, 0, 0}, 0},
+		{"lp2", []int64{1, 0, 1}, 1},
+		{"lp2", []int64{0, 1, 1}, 1},
+	}
+	for _, tc := range cases {
+		got := vmCall(t, logicalTruthSrc, tc.fn, tc.args...)
+		if got != tc.want {
+			t.Errorf("%s%v = %d, want %d", tc.fn, tc.args, got, tc.want)
+		}
+	}
+}
+
+func TestLogical_VM_CanonicalBoolValue(t *testing.T) {
+	// Logical results used as values must be exactly 0 or 1.
+	cases := []struct {
+		fn   string
+		args []int64
+		want int64
+	}{
+		{"landv", []int64{5, 7}, 1},
+		{"landv", []int64{5, 0}, 0},
+		{"lorv", []int64{0, 9}, 1},
+		{"lorv", []int64{0, 0}, 0},
+		{"lnotland", []int64{1, 1}, 0},
+		{"lnotland", []int64{1, 0}, 1},
+	}
+	for _, tc := range cases {
+		got := vmCall(t, logicalTruthSrc, tc.fn, tc.args...)
+		if got != tc.want {
+			t.Errorf("%s%v = %d, want %d (canonical bool)", tc.fn, tc.args, got, tc.want)
+		}
+	}
+}
