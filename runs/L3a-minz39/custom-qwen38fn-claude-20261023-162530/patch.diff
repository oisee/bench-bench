+const logicalSideSrc = `
+global side: u8 = 0
+
+fun bump() -> u8 {
+    side = side + 1
+    return side
+}
+
+// right operand of && evaluated only when left is true
+fun land_side(x: u8) -> u8 {
+    let r: bool = x != 0 && bump() > 0
+    if r { return side }
+    return 100 + side
+}
+
+// right operand of || evaluated only when left is false
+fun lor_side(x: u8) -> u8 {
+    let r: bool = x == 0 || bump() > 0
+    if r { return side }
+    return 200 + side
+}
+
+// while condition short-circuits too: bump runs only while i < 3
+fun while_side(x: u8) -> u8 {
+    let i: u8 = 0
+    while x != 0 && bump() > 0 && i < 3 {
+        i = i + 1
+    }
+    return side
+}
+`
+
+func TestLogical_VM_ShortCircuit(t *testing.T) {
+	// && left false → bump() never runs: returns 100 + side(0).
+	if got := vmCall(t, logicalSideSrc, "land_side", 0); got != 100 {
+		t.Errorf("land_side(0) = %d, want 100 (right operand must not run)", got)
+	}
+	// && left true → bump() runs once: returns side == 1.
+	if got := vmCall(t, logicalSideSrc, "land_side", 1); got != 1 {
+		t.Errorf("land_side(1) = %d, want 1 (bump called once)", got)
+	}
+	// || left (x == 0) true for x=0 → bump() never runs: returns side == 0.
+	if got := vmCall(t, logicalSideSrc, "lor_side", 0); got != 0 {
+		t.Errorf("lor_side(0) = %d, want 0 (right operand must not run)", got)
+	}
+	// || left false for x=1 → bump() runs once: returns side == 1.
+	if got := vmCall(t, logicalSideSrc, "lor_side", 1); got != 1 {
+		t.Errorf("lor_side(1) = %d, want 1 (bump called once)", got)
+	}
+	// while: x == 0 → body and right operands never run.
+	if got := vmCall(t, logicalSideSrc, "while_side", 0); got != 0 {
+		t.Errorf("while_side(0) = %d, want 0 (no bumps)", got)
+	}
+	// while: runs until i reaches 3 → bump called 4 times (3 body passes +
+	// the failing guard that exits the loop).
+	if got := vmCall(t, logicalSideSrc, "while_side", 1); got != 4 {
+		t.Errorf("while_side(1) = %d, want 4", got)
+	}
+}
+
+func TestLogical_VM_BoolValuesThroughLetsAndCalls(t *testing.T) {
+	// Logical results stored via let, passed as call arguments, and negated —
+	// all must stay canonical 0/1 and preserve short-circuit order.
+	src := `
+global side: u8 = 0
+
+fun bump() -> u8 {
+    side = side + 1
+    return side
+}
+
+fun addup(a: u8, b: u8) -> u8 { return a + b }
+
+fun via_let(x: u8, y: u8) -> u8 {
+    let r: bool = x != 0 && y != 0
+    let s: bool = r || y != 0
+    if s { return 1 }
+    return 0
+}
+
+// r must be exactly 0/1 when consumed arithmetically
+fun as_operand(x: u8, y: u8) -> u8 {
+    let r: bool = x != 0 && y != 0
+    return addup(r, r)
+}
+
+// short-circuit in the second operand of a call
+fun call_short(x: u8) -> u8 {
+    let r: bool = x != 0 && bump() > 0
+    return addup(r, side)
+}
+`
+	if got := vmCall(t, src, "via_let", 0, 0); got != 0 {
+		t.Errorf("via_let(0,0) = %d, want 0", got)
+	}
+	if got := vmCall(t, src, "via_let", 0, 1); got != 1 {
+		t.Errorf("via_let(0,1) = %d, want 1", got)
+	}
+	if got := vmCall(t, src, "via_let", 1, 1); got != 1 {
+		t.Errorf("via_let(1,1) = %d, want 1", got)
+	}
+	if got := vmCall(t, src, "as_operand", 3, 4); got != 2 {
+		t.Errorf("as_operand(3,4) = %d, want 2 (1+1)", got)
+	}
+	if got := vmCall(t, src, "as_operand", 0, 4); got != 0 {
+		t.Errorf("as_operand(0,4) = %d, want 0 (0+0)", got)
+	}
+	// x=0: bump never runs → addup(0, 0) = 0.
+	if got := vmCall(t, src, "call_short", 0); got != 0 {
+		t.Errorf("call_short(0) = %d, want 0", got)
+	}
+	// x=1: bump runs once → addup(1, 1) = 2.
+	if got := vmCall(t, src, "call_short", 1); got != 2 {
+		t.Errorf("call_short(1) = %d, want 2", got)
+	}
+}
+
+func TestLogical_VM_BitwiseIntact(t *testing.T) {
+	src := `
+fun band(a: u8, b: u8) -> u8 { return a & b }
+fun bor(a: u8, b: u8) -> u8 { return a | b }
+fun bxor(a: u8, b: u8) -> u8 { return a xor b }
+fun mix(a: u8) -> u8 { return (a & 1) | ((a xor 4) & 2) }
+fun logicmix(a: u8, b: u8) -> u8 { if a & 1 && b & 2 { return 7 } return 8 }
+`
+	if got := vmCall(t, src, "band", 0xF0, 0x3C); got != 0x30 {
+		t.Errorf("band = %X, want 30", got)
+	}
+	if got := vmCall(t, src, "bor", 0xF0, 0x0F); got != 0xFF {
+		t.Errorf("bor = %X, want FF", got)
+	}
+	if got := vmCall(t, src, "bxor", 0xFF, 0x0F); got != 0xF0 {
+		t.Errorf("bxor = %X, want F0", got)
+	}
+	// a=7: (7&1)=1 | ((7^4)&2)=(3&2)=2 → 3
+	if got := vmCall(t, src, "mix", 7); got != 3 {
+		t.Errorf("mix(7) = %d, want 3", got)
+	}
+	// bitwise inside &&: a&1 and b&2 both nonzero → 7
+	if got := vmCall(t, src, "logicmix", 3, 2); got != 7 {
+		t.Errorf("logicmix(3,2) = %d, want 7", got)
+	}
+	if got := vmCall(t, src, "logicmix", 2, 2); got != 8 {
+		t.Errorf("logicmix(2,2) = %d, want 8", got)
+	}
+}
+
+// ── Z80 E2E ───────────────────────────────────────────────────────────────────
+
+const logicalE2ELoadAddr = 0x8000
+
+const logicalE2ESrc = `
+global side: u8 = 0
+global gy: u8 = 0
+
+fun bump() -> u8 {
+    side = side + 1
+    return side
+}
+
+fun land_side(x: u8) -> u8 {
+    if x != 0 && bump() > 0 { return 1 }
+    return 0
+}
+
+fun lor_side(x: u8) -> u8 {
+    if x == 0 || bump() > 0 { return 1 }
+    return 0
+}
+
+fun land_g(x: u8) -> u8 {
+    if x != 0 && gy != 0 { return 1 }
+    return 0
+}
+
+fun lor_g(x: u8) -> u8 {
+    if x != 0 || gy != 0 { return 1 }
+    return 0
+}
+
+// bool result returned directly as a value (join-block phi → return)
+fun landv(x: u8) -> u8 { return x != 0 && gy != 0 }
+fun lorv(x: u8) -> u8 { return x != 0 || gy != 0 }
+
+// while condition short-circuits: bump only runs while x != 0
+fun while_side(x: u8) -> u8 {
+    let i: u8 = 0
+    while x != 0 && bump() > 0 && i < 3 {
+        i = i + 1
+    }
+    return i
+}
+`
+
+// fnABI extracts the physical registers for the first u8 parameter and the
+// u8 result from the codegen ABI comment:
+//
+//	; fun land_side(x: u8 = A) -> u8 = A ; clobbers: …
+//
+// The register assignment is PBQP-dependent, so the test must read it from
+// the generated assembly instead of hardcoding.
+func fnABI(t *testing.T, genAsm, fn string) (paramReg, retReg string) {
+	t.Helper()
+	re := regexp.MustCompile(`; fun ` + regexp.QuoteMeta(fn) + `\(.*?\) -> u8 = (\w+)`)
+	m := re.FindString(genAsm)
+	if m == "" {
+		t.Fatalf("no ABI comment for %s", fn)
+	}
+	retReg = re.FindStringSubmatch(genAsm)[1]
+	pm := regexp.MustCompile(`u8 = (\w+)`).FindStringSubmatch(m)
+	if pm == nil {
+		t.Fatalf("no u8 param in ABI for %s", fn)
+	}
+	return pm[1], retReg
+}
+
+// runLogicalZ80 assembles the generated Z80 plus a boot stub, runs it on the
+// emulator and returns (function result, side).  The boot stub loads x into
+// the parameter register declared by the ABI comment and pins the globals.
+func runLogicalZ80(t *testing.T, genAsm, fn string, x, gyInit int) (int, int) {
+	t.Helper()
+	paramReg, retReg := fnABI(t, genAsm, fn)
+	boot := fmt.Sprintf(`
+    ORG 0x%04X
+    LD SP, 0xFF00
+    LD HL, side
+    LD (HL), 0
+    LD HL, gy
+    LD (HL), %d
+    LD %s, %d
+    CALL %s
+    LD B, %s
+    LD HL, side
+    LD A, (HL)
+    DI
+    HALT
+`, logicalE2ELoadAddr, gyInit, paramReg, x, fn, retReg)
+	fullSrc := boot + "\n" + genAsm
+	as := z80asm.NewAssembler()
+	res, err := as.AssembleString(fullSrc)
+	if err != nil {
+		t.Fatalf("assemble: %v", err)
+	}
+	if len(res.Errors) > 0 {
+		var sb strings.Builder
+		for _, e := range res.Errors {
+			sb.WriteString(e.Error())
+			sb.WriteByte('\n')
+		}
+		t.Fatalf("assemble errors:\n%s", sb.String())
+	}
+	z80 := emulator.NewRemogattoZ80()
+	if err := z80.LoadMemory(logicalE2ELoadAddr, res.Binary); err != nil {
+		t.Fatalf("load: %v", err)
+	}
+	z80.SetPC(logicalE2ELoadAddr)
+	if err := z80.Run(); err != nil {
+		t.Fatalf("run: %v", err)
+	}
+	regs := z80.GetRegisters()
+	return int(regs.BC >> 8), int(regs.A) // B = result, A = side
+}
+
+func TestLogical_Z80_E2E(t *testing.T) {
+	m, err := nanz.Parse(logicalE2ESrc, "logical_z80")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	genAsm, err := pipeline.CompileHIR(m)
+	if err != nil {
+		t.Fatalf("compile: %v", err)
+	}
+
+	cases := []struct {
+		fn       string
+		x        int
+		gy       int
+		wantRes  int
+		wantSide int
+	}{
+		// && short-circuits on Z80: x=0 must not call bump.
+		{"land_side", 0, 0, 0, 0},
+		{"land_side", 1, 0, 1, 1},
+		// || short-circuits on Z80: left (x == 0) true for x=0 → no bump;
+		// x=1 falls through and must call bump exactly once.
+		{"lor_side", 1, 0, 1, 1},
+		{"lor_side", 0, 0, 1, 0},
+		// truth tables via a pinned global operand
+		{"land_g", 1, 1, 1, 0},
+		{"land_g", 1, 0, 0, 0},
+		{"land_g", 0, 1, 0, 0},
+		{"land_g", 0, 0, 0, 0},
+		{"lor_g", 0, 0, 0, 0},
+		{"lor_g", 1, 0, 1, 0},
+		{"lor_g", 0, 1, 1, 0},
+		// && / || results returned directly as values on Z80
+		{"landv", 1, 1, 1, 0},
+		{"landv", 1, 0, 0, 0},
+		{"landv", 0, 1, 0, 0},
+		{"lorv", 0, 0, 0, 0},
+		{"lorv", 1, 0, 1, 0},
+		{"lorv", 0, 1, 1, 0},
+		// while guard short-circuits on Z80: x=0 → no iterations, no bumps;
+		// x=1 → 3 iterations, 4 guard evaluations (last one exits the loop).
+		{"while_side", 0, 0, 0, 0},
+		{"while_side", 1, 0, 3, 4},
+	}
+	for _, tc := range cases {
+		gotRes, gotSide := runLogicalZ80(t, genAsm, tc.fn, tc.x, tc.gy)
+		if gotRes != tc.wantRes || gotSide != tc.wantSide {
+			t.Errorf("%s(x=%d, gy=%d): res=%d side=%d, want res=%d side=%d",
+				tc.fn, tc.x, tc.gy, gotRes, gotSide, tc.wantRes, tc.wantSide)
+		}
+	}
+}
