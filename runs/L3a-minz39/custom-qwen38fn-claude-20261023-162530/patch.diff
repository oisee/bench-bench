+// isBoolValuedExpr reports whether e is a boolean-valued expression whose
+// evaluation naturally ends up in a CPU flag: a comparison, logical NOT, or
+// a CondExpr of bool type (the shape the && / || operators desugar to).
+// Used by ReturnStmt lowering to route these through branch + constant
+// returns so the returned value is canonical 0/1 on VM and Z80 alike.
+func isBoolValuedExpr(e Expr) bool {
+	switch ex := e.(type) {
+	case *BinExpr:
+		switch ex.Op {
+		case "==", "!=", "<", "<=", ">", ">=":
+			return true
+		}
+	case *UnaryExpr:
+		return ex.Op == "!"
+	case *CondExpr:
+		return ex.Ty == mir2.TyBool
+	}
+	return false
+}
