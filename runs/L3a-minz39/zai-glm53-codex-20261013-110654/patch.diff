diff --git a/minzc/pkg/nanz/logical_test.go b/minzc/pkg/nanz/logical_test.go
new file mode 100644
index 0000000..65c5209
--- /dev/null
+++ b/minzc/pkg/nanz/logical_test.go
@@ -0,0 +1,142 @@
+package nanz_test
+
+import (
+	"testing"
+
+	"github.com/minz/minzc/pkg/hir"
+	"github.com/minz/minzc/pkg/nanz"
+	"github.com/minz/minzc/pkg/pipeline"
+)
+
+func TestLogicalOperatorsShortCircuit(t *testing.T) {
+	src := `
+global effects: u8 = 0
+
+fun bump(value: u8) -> u8 {
+    effects = effects + 1
+    return value
+}
+
+fun and_skips_right() -> u8 {
+    let result: bool = false && bump(true) != 0
+    if result { return 255 }
+    return effects
+}
+
+fun and_evaluates_right() -> u8 {
+    let result: bool = true && bump(true) != 0
+    if !result { return 255 }
+    return effects
+}
+
+fun or_skips_right() -> u8 {
+    let result: bool = true || bump(false) != 0
+    if !result { return 255 }
+    return effects
+}
+
+fun or_evaluates_right() -> u8 {
+    let result: bool = false || bump(true) != 0
+    if !result { return 255 }
+    return effects
+}
+
+fun while_condition() -> u8 {
+    var index: u8 = 0
+    while index < 2 && bump(true) != 0 {
+        index = index + 1
+    }
+    return effects
+}
+
+fun canonical_value() -> bool {
+    return false || true
+}
+
+fun canonical_runtime(value: u8) -> bool {
+    return value != 0 && value < 10
+}
+
+assert and_skips_right() == 0
+assert and_evaluates_right() == 1
+assert or_skips_right() == 0
+assert or_evaluates_right() == 1
+assert while_condition() == 2
+assert canonical_value() == 1
+assert canonical_runtime(2) == 1
+assert canonical_runtime(0) == 0
+`
+	module, err := nanz.Parse(src, "logical_short_circuit.nanz")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	if _, err := pipeline.CompileHIR(module); err != nil {
+		t.Fatalf("compile: %v", err)
+	}
+}
+
+func TestLogicalOperatorPrecedence(t *testing.T) {
+	src := `
+fun and_before_or() -> bool {
+    return false && true || true
+}
+
+fun bitwise_before_logical() -> bool {
+    return false & true || true
+}
+
+fun bitwise_chain() -> bool {
+    return false | false xor true & true == true
+}
+
+fun arithmetic_shift_chain() -> u8 {
+    return 1 + 2 << 3 * 4
+}
+`
+	module, err := nanz.Parse(src, "logical_precedence.nanz")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+
+	andBeforeOr := findReturnedBinary(module, "and_before_or")
+	andBeforeOrLeft, andBeforeOrLeftOk := andBeforeOr.L.(*hir.BinExpr)
+	if andBeforeOr == nil || andBeforeOr.Op != "||" || !andBeforeOrLeftOk || andBeforeOrLeft.Op != "&&" {
+		t.Fatalf("expected (false && true) || true, got %#v", andBeforeOr)
+	}
+	bitwiseBeforeLogical := findReturnedBinary(module, "bitwise_before_logical")
+	bitwiseBeforeLogicalLeft, bitwiseBeforeLogicalLeftOk := bitwiseBeforeLogical.L.(*hir.BinExpr)
+	if bitwiseBeforeLogical == nil || bitwiseBeforeLogical.Op != "||" || !bitwiseBeforeLogicalLeftOk || bitwiseBeforeLogicalLeft.Op != "&" {
+		t.Fatalf("expected (false & true) || true, got %#v", bitwiseBeforeLogical)
+	}
+	bitwiseChain := findReturnedBinary(module, "bitwise_chain")
+	bitwiseXor, bitwiseXorOk := bitwiseChain.R.(*hir.BinExpr)
+	bitwiseAnd, bitwiseAndOk := bitwiseXor.R.(*hir.BinExpr)
+	bitwiseEquality, bitwiseEqualityOk := bitwiseAnd.R.(*hir.BinExpr)
+	if bitwiseChain == nil || bitwiseChain.Op != "|" || !bitwiseXorOk || bitwiseXor.Op != "^" ||
+		!bitwiseAndOk || bitwiseAnd.Op != "&" || !bitwiseEqualityOk || bitwiseEquality.Op != "==" {
+		t.Fatalf("expected false | (false xor (true & (true == true))), got %#v", bitwiseChain)
+	}
+	shiftChain := findReturnedBinary(module, "arithmetic_shift_chain")
+	shiftAdd, shiftAddOk := shiftChain.L.(*hir.BinExpr)
+	shiftMul, shiftMulOk := shiftChain.R.(*hir.BinExpr)
+	if shiftChain == nil || shiftChain.Op != "<<" || !shiftAddOk || shiftAdd.Op != "+" ||
+		!shiftMulOk || shiftMul.Op != "*" {
+		t.Fatalf("expected (1 + 2) << (3 * 4), got %#v", shiftChain)
+	}
+}
+
+func findReturnedBinary(module *hir.Module, functionName string) *hir.BinExpr {
+	function := module.FuncByName(functionName)
+	if function == nil {
+		return nil
+	}
+	var result *hir.BinExpr
+	for _, statement := range function.Body.Body {
+		if returned, ok := statement.(*hir.ReturnStmt); ok {
+			if binary, ok := returned.Val.(*hir.BinExpr); ok {
+				result = binary
+			}
+		}
+	}
+	return result
+}
