+func (l *lowerer) lowerLogicalExpr(ex *BinExpr) mir2.Reg {
+	entry := l.bld.Cur
+	evalBlock := l.bld.SwitchToNewBlock(l.fresh("logical_eval"))
+	joinBlock := l.bld.SwitchToNewBlock(l.fresh("logical_join"))
+	result := l.bld.BlockParam(joinBlock, mir2.TyBool, classForExpr(mir2.TyBool))
+	l.bld.SwitchTo(entry)
+
+	cond := l.lowerCond(ex.L)
+	shortCircuit := l.bld.Const(0, mir2.TyBool, classForExpr(mir2.TyBool))
+	if ex.Op == "||" {
+		shortCircuit = l.bld.Const(1, mir2.TyBool, classForExpr(mir2.TyBool))
+		l.bld.BrIf(cond, joinBlock.Label, []mir2.Reg{shortCircuit}, evalBlock.Label, nil)
+	} else {
+		l.bld.BrIf(cond, evalBlock.Label, nil, joinBlock.Label, []mir2.Reg{shortCircuit})
+	}
+
+	l.bld.SwitchTo(evalBlock)
+	if value, ok := literalBool(ex.R); ok {
+		var literalValue int64
+		if value {
+			literalValue = 1
+		}
+		literalResult := l.bld.Const(literalValue, mir2.TyBool, classForExpr(mir2.TyBool))
+		l.bld.Jmp(joinBlock.Label, literalResult)
+		l.bld.SwitchTo(joinBlock)
+		return result
+	}
+
+	right := l.lowerCond(ex.R)
+	rightFalse := l.bld.Const(0, mir2.TyBool, classForExpr(mir2.TyBool))
+	rightTrue := l.bld.Const(1, mir2.TyBool, classForExpr(mir2.TyBool))
+	l.bld.BrIf(right, joinBlock.Label, []mir2.Reg{rightTrue}, joinBlock.Label, []mir2.Reg{rightFalse})
+
+	l.bld.SwitchTo(joinBlock)
+	return result
+}
+
+func literalBool(e Expr) (value bool, ok bool) {
+	switch literal := e.(type) {
+	case *BoolLitExpr:
+		return literal.Val, true
+	case *IntLitExpr:
+		return literal.Val != 0, true
+	default:
+		return false, false
+	}
+}
