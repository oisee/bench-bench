+func TestLogicalOps_E2E_Values(t *testing.T) {
+	src := `
+fun and_val(a: u8, b: u8) -> u8 {
+    let r: bool = a > 0 && b > 0
+    if r { return 1 }
+    return 0
+}
+
+fun or_val(a: u8, b: u8) -> u8 {
+    if a > 0 || b > 0 { return 1 }
+    return 0
+}
+
+fun truthy_and(a: u8, b: u8) -> u8 {
+    if a && b { return 1 }
+    return 0
+}
+
+fun truthy_or(a: u8, b: u8) -> u8 {
+    if a || b { return 1 }
+    return 0
+}
+
+fun canon(a: u8, b: u8) -> u8 {
+    return u8(a && b)
+}
+
+fun canon_or(a: u8, b: u8) -> u8 {
+    return u8(a || b)
+}
+
+fun wide(x: u16, y: u16) -> u8 {
+    if x > 300 && y < 1000 { return 1 }
+    return 0
+}
+
+fun prec(a: u8, b: u8, c: u8) -> u8 {
+    if a == 1 || b == 1 && c == 1 { return 1 }
+    return 0
+}
+
+fun grouped(a: u8, b: u8, c: u8) -> u8 {
+    if (a > 0 || b > 0) && c > 0 { return 1 }
+    return 0
+}
+
+fun nor(a: u8, b: u8) -> u8 {
+    if !(a > 0 || b > 0) { return 1 }
+    return 0
+}
+
+fun bits(a: u8, b: u8) -> u8 {
+    if (a & 1) != 0 && (b | 2) == 3 { return 1 }
+    return 0
+}
+
+fun bitwise_kept(a: u8, b: u8) -> u8 {
+    return a & 3 | b
+}
+
+fun ret_grouped(a: u8, b: u8, c: u8) -> bool {
+    return (a || b) && c
+}
+
+fun ret_paren_tail(a: u8, b: u8, c: u8) -> u8 {
+    return (a | b) & c
+}
+
+assert and_val(1, 1) == 1
+assert and_val(1, 0) == 0
+assert and_val(0, 1) == 0
+assert or_val(0, 0) == 0
+assert or_val(0, 5) == 1
+assert or_val(5, 0) == 1
+assert truthy_and(2, 4) == 1
+assert truthy_and(2, 0) == 0
+assert truthy_and(0, 4) == 0
+assert truthy_or(0, 0) == 0
+assert truthy_or(0, 4) == 1
+assert truthy_or(4, 0) == 1
+assert canon(7, 9) == 1
+assert canon(7, 0) == 0
+assert canon(0, 9) == 0
+assert canon_or(0, 9) == 1
+assert canon_or(0, 0) == 0
+assert wide(301, 999) == 1
+assert wide(300, 999) == 0
+assert wide(400, 1000) == 0
+assert prec(1, 0, 0) == 1
+assert prec(0, 1, 1) == 1
+assert prec(0, 1, 0) == 0
+assert grouped(1, 0, 1) == 1
+assert grouped(0, 1, 1) == 1
+assert grouped(0, 0, 1) == 0
+assert grouped(1, 1, 0) == 0
+assert nor(0, 0) == 1
+assert nor(0, 1) == 0
+assert nor(1, 0) == 0
+assert bits(1, 1) == 1
+assert bits(2, 1) == 0
+assert bits(1, 4) == 0
+assert bitwise_kept(1, 4) == 5
+assert bitwise_kept(7, 8) == 11
+assert ret_grouped(0, 1, 1) == true
+assert ret_grouped(1, 0, 0) == false
+assert ret_grouped(0, 0, 1) == false
+assert ret_paren_tail(1, 2, 6) == 2
+`
+	compileWithAsserts(t, src, "logical_values")
+}
