+func TestLogicalOps_E2E_Loops(t *testing.T) {
+	src := `
+fun count_and(n: u8, lim: u8) -> u8 {
+    let i: u8 = 0
+    while i < n && i < lim {
+        i = i + 1
+    }
+    return i
+}
+
+fun count_or(n: u8) -> u8 {
+    let i: u8 = 0
+    while i < 3 || i < n {
+        i = i + 1
+    }
+    return i
+}
+
+assert count_and(10, 3) == 3
+assert count_and(2, 3) == 2
+assert count_and(0, 3) == 0
+assert count_and(3, 0) == 0
+assert count_or(0) == 3
+assert count_or(7) == 7
+`
+	compileWithAsserts(t, src, "logical_loops")
+}
