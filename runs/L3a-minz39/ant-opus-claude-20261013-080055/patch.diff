+// isLogicalExpr reports whether e is a short-circuit && / || expression,
+// possibly under one or more boolean "!".
+func isLogicalExpr(e Expr) bool {
+	switch ex := e.(type) {
+	case *BinExpr:
+		return ex.Op == "&&" || ex.Op == "||"
+	case *UnaryExpr:
+		return ex.Op == "!" && isLogicalExpr(ex.X)
+	}
+	return false
+}
+
+// lowerBranch emits a conditional branch on e: to tLabel(tArgs...) when e is
+// true, to fLabel(fArgs...) otherwise.  Short-circuit && and || become a chain
+// of branches, so the right operand is evaluated only when the left operand
+// does not already decide the result:
+//
+//	a && b:  brif a @rhs @false;  rhs: brif b @true @false
+//	a || b:  brif a @true @rhs;   rhs: brif b @true @false
+//
+// Any other condition lowers exactly as lowerCond + BrIf.
+func (l *lowerer) lowerBranch(e Expr, tLabel string, tArgs []mir2.Reg, fLabel string, fArgs []mir2.Reg) {
+	switch ex := e.(type) {
+	case *BinExpr:
+		if ex.Op == "&&" || ex.Op == "||" {
+			rhsLabel := l.fresh("sc_rhs")
+			if ex.Op == "&&" {
+				l.lowerBranch(ex.L, rhsLabel, nil, fLabel, fArgs)
+			} else {
+				l.lowerBranch(ex.L, tLabel, tArgs, rhsLabel, nil)
+			}
+			l.bld.SwitchToNewBlock(rhsLabel)
+			l.lowerBranch(ex.R, tLabel, tArgs, fLabel, fArgs)
+			return
+		}
+	case *UnaryExpr:
+		if ex.Op == "!" && isLogicalExpr(ex.X) {
+			l.lowerBranch(ex.X, fLabel, fArgs, tLabel, tArgs)
+			return
+		}
+	}
+	cond := l.lowerCond(e)
+	l.bld.BrIf(cond, tLabel, tArgs, fLabel, fArgs)
+}
+
+// lowerLogicalValue lowers a short-circuit && / || used as a value.  The
+// result is a canonical bool (0 or 1) delivered through a join block param.
+func (l *lowerer) lowerLogicalValue(ex *BinExpr) mir2.Reg {
+	trueLabel := l.fresh("sc_true")
+	falseLabel := l.fresh("sc_false")
+	joinLabel := l.fresh("sc_join")
+
+	l.lowerBranch(ex, trueLabel, nil, falseLabel, nil)
+
+	l.bld.SwitchToNewBlock(trueLabel)
+	one := l.bld.Const(1, mir2.TyBool, mir2.ClassGeneral)
+	l.bld.Jmp(joinLabel, one)
+
+	l.bld.SwitchToNewBlock(falseLabel)
+	zero := l.bld.Const(0, mir2.TyBool, mir2.ClassGeneral)
+	l.bld.Jmp(joinLabel, zero)
+
+	join := l.bld.SwitchToNewBlock(joinLabel)
+	return l.bld.BlockParam(join, mir2.TyBool, mir2.ClassGeneral)
+}
