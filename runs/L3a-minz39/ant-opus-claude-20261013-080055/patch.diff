diff --git a/minzc/pkg/nanz/logical_ops_test.go b/minzc/pkg/nanz/logical_ops_test.go
new file mode 100644
index 0000000..d3a6ce0
--- /dev/null
+++ b/minzc/pkg/nanz/logical_ops_test.go
@@ -0,0 +1,382 @@
+package nanz_test
+
+// Short-circuit logical operators && and || — parsing, precedence and
+// end-to-end behaviour on the MIR2 VM and the Z80 binary (dual-VM asserts).
+
+import (
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/minz/minzc/pkg/hir"
+	"github.com/minz/minzc/pkg/mir2"
+	"github.com/minz/minzc/pkg/nanz"
+	"github.com/minz/minzc/pkg/pipeline"
+)
+
+// retExpr parses src and returns the value of the first statement (a return)
+// of the function named fn.
+func retExpr(t *testing.T, src, fn string) hir.Expr {
+	t.Helper()
+	m, err := nanz.Parse(src, "logical_parse")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	for _, f := range m.Funcs {
+		if f.Name != fn {
+			continue
+		}
+		ret, ok := f.Body.Body[0].(*hir.ReturnStmt)
+		if !ok {
+			t.Fatalf("%s: first stmt is %T, want *hir.ReturnStmt", fn, f.Body.Body[0])
+		}
+		return ret.Val
+	}
+	t.Fatalf("function %q not found", fn)
+	return nil
+}
+
+// shape renders an expression tree as fully-parenthesised prefix form so
+// precedence can be checked with a single string comparison.
+func shape(e hir.Expr) string {
+	switch ex := e.(type) {
+	case *hir.BinExpr:
+		return "(" + ex.Op + " " + shape(ex.L) + " " + shape(ex.R) + ")"
+	case *hir.UnaryExpr:
+		return "(" + ex.Op + " " + shape(ex.X) + ")"
+	case *hir.VarRefExpr:
+		return ex.Name
+	case *hir.IntLitExpr:
+		return strconv.FormatInt(ex.Val, 10)
+	case *hir.CallExpr:
+		return ex.Fn + "()"
+	}
+	return "?"
+}
+
+func TestLogicalOps_Precedence(t *testing.T) {
+	cases := []struct {
+		expr string
+		want string
+	}{
+		// || is loosest, then &&.
+		{"a || b && c", "(|| a (&& b c))"},
+		{"a && b || c", "(|| (&& a b) c)"},
+		{"a || b || c", "(|| (|| a b) c)"},
+		{"a && b && c", "(&& (&& a b) c)"},
+		// Both are looser than comparisons...
+		{"a < b && b < c", "(&& (< a b) (< b c))"},
+		{"a == 1 || b != 2", "(|| (== a 1) (!= b 2))"},
+		// ...and than every bitwise operator.
+		{"a & 1 && b | 2", "(&& (& a 1) (| b 2))"},
+		{"a | b || c xor 1", "(|| (| a b) (^ c 1))"},
+		{"a & b || c & 1 && b", "(|| (& a b) (&& (& c 1) b))"},
+		// Arithmetic / shifts are unaffected.
+		{"a + 1 && b << 1", "(&& (+ a 1) (<< b 1))"},
+		// Existing bitwise precedence is preserved: | < xor < & < == < + .
+		{"a | b xor c & 1", "(| a (^ b (& c 1)))"},
+		{"a & b == c", "(& a (== b c))"},
+		{"a | b + c", "(| a (+ b c))"},
+		// Parentheses and ! still work.
+		{"(a || b) && c", "(&& (|| a b) c)"},
+		{"!(a && b) || c", "(|| (! (&& a b)) c)"},
+	}
+	for _, c := range cases {
+		src := "fun f(a: u8, b: u8, c: u8) -> bool {\n    return " + c.expr + "\n}\n"
+		e := retExpr(t, src, "f")
+		if got := shape(e); got != c.want {
+			t.Errorf("%s: got %s, want %s", c.expr, got, c.want)
+		}
+	}
+}
+
+func TestLogicalOps_ResultIsBool(t *testing.T) {
+	src := `fun f(a: u16, b: u8) -> bool {
+    return a && b
+}
+`
+	e := retExpr(t, src, "f")
+	bin, ok := e.(*hir.BinExpr)
+	if !ok || bin.Op != "&&" {
+		t.Fatalf("got %T %v, want && BinExpr", e, e)
+	}
+	if bin.Ty != mir2.TyBool {
+		t.Errorf("&& type: got %v, want bool", bin.Ty)
+	}
+}
