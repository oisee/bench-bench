+// compileWithAsserts runs every assert in src on both the MIR2 VM and the
+// Z80 binary.
+func compileWithAsserts(t *testing.T, src, name string) string {
+	t.Helper()
+	m, err := nanz.Parse(src, name)
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	asm, err := pipeline.CompileHIR(m)
+	if err != nil {
+		t.Fatalf("compile/asserts: %v", err)
+	}
+	return asm
+}
