+// The right operand must run only when the left operand does not already
+// decide the result.  The callee counts its invocations in a global.
+func TestLogicalOps_E2E_ShortCircuitSideEffects(t *testing.T) {
+	src := `
+global calls: u8 = 0
+
+fun t(v: u8) -> u8 {
+    calls = calls + 1
+    return v
+}
+
+fun bump(r: bool) -> bool {
+    calls = calls + 1
+    return r
+}
+
+fun and_sc(a: u8) -> u8 {
+    calls = 0
+    if a > 0 && bump(true) { return calls + 10 }
+    return calls
+}
+
+fun or_sc(a: u8) -> u8 {
+    calls = 0
+    if a > 0 || bump(false) { return calls + 10 }
+    return calls
+}
+
+fun and3(a: u8, b: u8, c: u8) -> u8 {
+    calls = 0
+    if t(a) > 0 && t(b) > 0 && t(c) > 0 { return calls + 100 }
+    return calls
+}
+
+fun or3(a: u8, b: u8, c: u8) -> u8 {
+    calls = 0
+    if t(a) > 0 || t(b) > 0 || t(c) > 0 { return calls + 100 }
+    return calls
+}
+
+fun val_and(a: u8, b: u8) -> u8 {
+    calls = 0
+    let r: bool = t(a) != 0 && t(b) != 0
+    if r { return calls + 100 }
+    return calls
+}
+
+fun val_or(a: u8, b: u8) -> u8 {
+    calls = 0
+    let r: bool = t(a) != 0 || t(b) != 0
+    if r { return calls + 100 }
+    return calls
+}
+
+assert and_sc(0) == 0
+assert and_sc(1) == 11
+assert or_sc(1) == 10
+assert or_sc(0) == 1
+assert and3(1, 1, 1) == 103
+assert and3(0, 1, 1) == 1
+assert and3(1, 0, 1) == 2
+assert and3(1, 1, 0) == 3
+assert or3(1, 0, 0) == 101
+assert or3(0, 1, 0) == 102
+assert or3(0, 0, 1) == 103
+assert or3(0, 0, 0) == 3
+assert val_and(0, 1) == 1
+assert val_and(1, 0) == 2
+assert val_and(1, 1) == 102
+assert val_or(1, 0) == 101
+assert val_or(0, 1) == 102
+assert val_or(0, 0) == 2
+`
+	compileWithAsserts(t, src, "logical_side_effects")
+}
+
+// In a condition, && / || lower to branches only — no 0/1 materialisation.
+func TestLogicalOps_ConditionLowersToBranches(t *testing.T) {
+	src := `
+fun both(a: u8, b: u8) -> u8 {
+    if a && b { return 1 }
+    return 0
+}
+`
+	asm := compileWithAsserts(t, src, "logical_branches")
+	start := strings.Index(asm, "\nboth:")
+	if start < 0 {
+		t.Fatalf("function both not found:\n%s", asm)
+	}
+	body := asm[start:]
+	if end := strings.Index(body, "\n\n"); end > 0 {
+		body = body[:end]
+	}
+	if strings.Contains(body, "sc_join") {
+		t.Errorf("condition use should not build a value join block:\n%s", body)
+	}
+	if strings.Count(body, "JR") < 2 && strings.Count(body, "JP") < 2 {
+		t.Errorf("expected two conditional branches:\n%s", body)
+	}
+}
