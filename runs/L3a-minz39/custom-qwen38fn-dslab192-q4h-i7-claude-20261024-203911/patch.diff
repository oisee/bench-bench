diff --git a/examples/nanz/logical_short_circuit.nanz b/examples/nanz/logical_short_circuit.nanz
new file mode 100644
index 0000000..a660e8e
--- /dev/null
+++ b/examples/nanz/logical_short_circuit.nanz
@@ -0,0 +1,74 @@
+// Nanz — short-circuit logical operators.
+//
+// && and || evaluate the right operand only when the left one demands it,
+// so a side effect in the right operand is conditional. The desugaring happens
+// at parse time (a conditional branch, not a bitwise AND), which is what makes
+// the guard below work: seen() never runs when `a` already settles the answer.
+//
+// Results are canonical bool (1/0) regardless of how the operands happen to be
+// represented — on Z80 a comparison leaves a 0xFF flag in A, and that must not
+// leak into the result. Operands may be of any scalar type: non-bool operands
+// are tested against zero, as in C.
+
+global probe: u8
+
+fun seen(v: bool) -> bool {
+    probe = 1
+    return v
+}
+
+fun is_alpha(c: u8) -> bool {
+    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
+}
+
+// probe stays 0 when the left operand already settles the answer.
+fun and_guard(a: bool) -> u8 {
+    probe = 0
+    if a && seen(true) {
+        return probe
+    }
+    return probe
+}
+
+fun or_guard(a: bool) -> u8 {
+    probe = 0
+    if a || seen(true) {
+        return probe
+    }
+    return probe
+}
+
+// && binds looser than &: this is (x & y) && x, not x & (y && x).
+fun bit_then_logical(x: u8, y: u8) -> bool {
+    return x & y && x
+}
+
+// Logical operators as a loop condition: both must hold to continue.
+fun count_and(n: u8) -> u8 {
+    var i: u8 = 0
+    var c: u8 = 0
+    while i < n && c < 3 {
+        c = c + 1
+        i = i + 1
+    }
+    return c
+}
+
+assert is_alpha(65) == 1 via z80
+assert is_alpha(97) == 1 via z80
+assert is_alpha(48) == 0 via z80
+assert is_alpha(122) == 1 via z80
+assert bit_then_logical(6, 3) == 1 via z80
+assert bit_then_logical(0, 3) == 0 via z80
+assert and_guard(0) == 0 via z80
+assert and_guard(1) == 1 via z80
+assert or_guard(1) == 0 via z80
+assert or_guard(0) == 1 via z80
+
+// count_and is verified on the MIR2 VM only: its Z80 output is wrong today.
+// A loop condition whose value is materialised (here: the result of `&&`)
+// clobbers the accumulator that holds the loop's exit value — see BUG-015
+// in docs/Open_Bugs_RCA.md. The MIR2 is correct; the codegen is not.
+assert count_and(10) == 3 via mir2
+assert count_and(1) == 1 via mir2
+assert count_and(0) == 0 via mir2
