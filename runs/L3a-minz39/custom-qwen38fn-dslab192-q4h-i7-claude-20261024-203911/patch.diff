diff --git a/minzc/pkg/nanz/logical_e2e_test.go b/minzc/pkg/nanz/logical_e2e_test.go
new file mode 100644
index 0000000..ddcb9f6
--- /dev/null
+++ b/minzc/pkg/nanz/logical_e2e_test.go
@@ -0,0 +1,250 @@
+package nanz_test
+
+// Short-circuit logical operators (&&, ||) for Nanz.
+//
+// Covers:
+// - precedence (|| looser than &&, both looser than bitwise/comparison)
+// - short-circuit evaluation with side effects (right operand skipped)
+// - canonical boolean results usable as values and as if/while conditions
+// - bitwise operators (&, |, xor) and their precedences left intact
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/minz/minzc/pkg/nanz"
+	"github.com/minz/minzc/pkg/pipeline"
+)
+
+// ── Precedence / AST shape ───────────────────────────────────────────────────
+
+func TestLogical_Precedence(t *testing.T) {
+	src := `
+fun f(a: bool, b: bool, c: bool, x: u8, y: u8, z: u8) -> bool {
+    let r1 = a || b && c
+    let r2 = x | y && z
+    let r3 = x && y | z
+    let r4 = x xor y && z
+    let r5 = x & y == z
+    let r6 = x + y | z
+    let r7 = x << y + z
+    let r8 = x + y * z
+    return r1
+}
+`
+	m, err := nanz.Parse(src, "prec.nanz")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	dump := m.Dump()
+
+	// a || b && c  →  a || (b && c)
+	const r1 = "var r1: bool = (if (a:bool) then 1:bool else (if (if (b:bool) then (c:bool) else 0:bool):bool then 1:bool else 0:bool):bool):bool"
+	if !strings.Contains(dump, r1) {
+		t.Errorf("a || b && c did not nest as a || (b && c):\n%s", dump)
+	}
+
+	// x | y && z  →  (x | y) && z   — bitwise binds tighter than logical
+	const r2 = "var r2: bool = (if ((x:u8) | (y:u8)):u8 then (if (z:u8) then 1:bool else 0:bool):bool else 0:bool):bool"
+	if !strings.Contains(dump, r2) {
+		t.Errorf("x | y && z did not nest as (x | y) && z:\n%s", dump)
+	}
+
+	// x && y | z  →  x && (y | z)
+	const r3 = "var r3: bool = (if (x:u8) then (if ((y:u8) | (z:u8)):u8 then 1:bool else 0:bool):bool else 0:bool):bool"
+	if !strings.Contains(dump, r3) {
+		t.Errorf("x && y | z did not nest as x && (y | z):\n%s", dump)
+	}
+
+	// x xor y && z  →  (x xor y) && z  — xor still binds between | and &
+	const r4 = "var r4: bool = (if ((x:u8) ^ (y:u8)):u8 then (if (z:u8) then 1:bool else 0:bool):bool else 0:bool):bool"
+	if !strings.Contains(dump, r4) {
+		t.Errorf("x xor y && z did not nest as (x xor y) && z:\n%s", dump)
+	}
+
+	// Precedences that must not regress: comparisons inside &, arithmetic inside
+	// |, arithmetic inside shifts, * inside +.
+	const r5 = "var r5: u8 = ((x:u8) & ((y:u8) == (z:u8)):bool):u8"
+	const r6 = "var r6: u8 = (((x:u8) + (y:u8)):u8 | (z:u8)):u8"
+	const r7 = "var r7: u8 = ((x:u8) << ((y:u8) + (z:u8)):u8):u8"
+	const r8 = "var r8: u8 = ((x:u8) + ((y:u8) * (z:u8)):u8):u8"
+	for _, want := range []string{r5, r6, r7, r8} {
+		if !strings.Contains(dump, want) {
+			t.Errorf("missing precedenced shape %s:\n%s", want, dump)
+		}
+	}
+}
+
+// ── Behaviour through MIR2 VM + Z80 emulator asserts ────────────────────────
+
+const logicalSrc = `
+global side: u8
+
+fun note(v: bool) -> bool {
+    side = side + 1
+    return v
+}
+
+// Right operand must run only when the left one demands it.
+fun and_side(a: bool) -> u8 {
+    side = 0
+    if a && note(true) {
+        return side
+    }
+    return side
+}
+
+fun or_side(a: bool) -> u8 {
+    side = 0
+    if a || note(true) {
+        return side
+    }
+    return side
+}
+
+// Values: canonical bool 0/1, including non-bool operands (C-style truthiness).
+fun and_bool(a: bool, b: bool) -> bool {
+    return a && b
+}
+
+fun or_bool(a: bool, b: bool) -> bool {
+    return a || b
+}
+
+fun and_flag(a: u8, b: u8) -> bool {
+    return a && b
+}
+
+fun flag_or_byte(a: u8, b: u8) -> u8 {
+    if (a | b) && 3 {
+        return 1
+    }
+    return 0
+}
+
+// Nested logicals in a condition — mirrors examples/c89/logical.c.
+fun is_alpha(c: u8) -> bool {
+    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
+}
+
+fun is_alnum(c: u8) -> bool {
+    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
+}
+
+// Logical operators under a leading not, as in examples/feature_tests/01_basic_types.minz.
+fun bool_ops(t: bool, f: bool) -> bool {
+    if !(t && t) {
+        return false
+    }
+    if t && f {
+        return false
+    }
+    if !(t || f) {
+        return false
+    }
+    if f || f {
+        return false
+    }
+    if !t {
+        return false
+    }
+    if !!f {
+        return false
+    }
+    return true
+}
+
+// Logical operator as a loop condition. Verified on the MIR2 VM only: the
+// Z80 output is wrong today — a value-valued loop condition clobbers the
+// accumulator holding the loop's exit value (BUG-015 in docs/Open_Bugs_RCA.md).
+fun count_and(n: u8) -> u8 {
+    var i: u8 = 0
+    var c: u8 = 0
+    while i < n && c < 3 {
+        c = c + 1
+        i = i + 1
+    }
+    return c
+}
+
+// Bitwise operators must keep working.
+fun bit_and(a: u8, b: u8) -> u8 {
+    return a & b
+}
+
+fun bit_or(a: u8, b: u8) -> u8 {
+    return a | b
+}
+
+fun bit_xor(a: u8, b: u8) -> u8 {
+    return a xor b
+}
+
+assert and_side(0) == 0 via mir2
+assert and_side(1) == 1 via mir2
+assert or_side(1) == 0 via mir2
+assert or_side(0) == 1 via mir2
+assert and_bool(1, 1) == 1 via mir2
+assert and_bool(1, 0) == 0 via mir2
+assert and_bool(0, 1) == 0 via mir2
+assert or_bool(0, 0) == 0 via mir2
+assert or_bool(0, 1) == 1 via mir2
+assert or_bool(1, 0) == 1 via mir2
+assert and_flag(3, 5) == 1 via mir2
+assert and_flag(0, 5) == 0 via mir2
+assert and_flag(2, 0) == 0 via mir2
+assert flag_or_byte(4, 3) == 1 via mir2
+assert flag_or_byte(0, 0) == 0 via mir2
+assert is_alpha(65) via mir2
+assert is_alpha(122) via mir2
+assert not is_alpha(48) via mir2
+assert not is_alpha(127) via mir2
+assert is_alnum(48) via mir2
+assert is_alnum(97) via mir2
+assert not is_alnum(32) via mir2
+assert count_and(10) == 3 via mir2
+assert count_and(1) == 1 via mir2
+assert count_and(0) == 0 via mir2
+assert bool_ops(1, 0) == 1 via mir2
+assert bool_ops(0, 1) == 0 via mir2
+assert bool_ops(1, 0) == 1 via z80
+assert bit_and(6, 3) == 2 via mir2
+assert bit_or(4, 3) == 7 via mir2
+assert bit_xor(6, 3) == 5 via mir2
+assert and_bool(1, 1) == 1 via z80
+assert or_side(0) == 1 via z80
+assert is_alpha(97) via z80
+`
+
+func TestLogical_Asserts(t *testing.T) {
+	m, err := nanz.Parse(logicalSrc, "logical.nanz")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	// Default options run every assert on the MIR2 VM and on the Z80 emulator.
+	_, err = pipeline.CompileHIRSteps(m)
+	if err != nil {
+		t.Fatalf("pipeline: %v", err)
+	}
+}
+
+// ── Return-statement paren disambiguation must not clip the expression ──────
+
+func TestLogical_ReturnParen(t *testing.T) {
+	src := `
+fun in_range(c: u8) -> bool {
+    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
+}
+assert in_range(89) == 1 via mir2
+assert in_range(122) == 1 via mir2
+assert in_range(64) == 0 via mir2
+`
+	m, err := nanz.Parse(src, "retparen.nanz")
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	_, err = pipeline.CompileHIRSteps(m)
+	if err != nil {
+		t.Fatalf("pipeline: %v", err)
+	}
+}
