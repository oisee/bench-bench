+++ b/tools/gogen/go/nodeutf8/decode.go
@@ -0,0 +1,247 @@
+// Package nodeutf8 provides Node-compatible UTF-8 decoding with U+FFFD
+// replacement for malformed sequences, matching Buffer.from(bytes).toString().
+package nodeutf8
+
+import (
+	"unicode/utf8"
+)
+
+// Decode interprets a string of raw bytes as UTF-8 text, using the same
+// replacement-character behavior as Node's Buffer.toString():
+//   - Valid UTF-8 sequences decode to their corresponding characters.
+//   - An incomplete sequence at end of input emits one U+FFFD if the partial
+//     sequence could become valid, or one U+FFFD per byte if it would be
+//     overlong or out of range even if completed.
+//   - A sequence that is complete but invalid (overlong, surrogate, or
+//     out of range) emits one U+FFFD per byte.
+//   - A sequence with an invalid continuation byte emits one U+FFFD for the
+//     start byte, then the bad byte is reprocessed.
+//   - A continuation byte without a start byte emits one U+FFFD.
+func Decode(b string) string {
+	if utf8.ValidString(b) {
+		return b
+	}
+
+	var out []byte
+	// Track multi-byte sequence state
+	var seq [4]byte
+	n := 0 // bytes in current sequence
+
+	for i := 0; i < len(b); i++ {
+		c := b[i]
+
+		if n == 0 {
+			// Starting fresh
+			if c < 0x80 {
+				// ASCII
+				if out == nil {
+					out = make([]byte, 0, len(b))
+				}
+				out = append(out, c)
+				continue
+			}
+
+			// Continuation byte without start
+			if c >= 0x80 && c <= 0xBF {
+				if out == nil {
+					out = make([]byte, 0, len(b)+4)
+				}
+				out = utf8.AppendRune(out, 0xFFFD)
+				continue
+			}
+
+			// C0, C1: always overlong
+			if c == 0xC0 || c == 0xC1 {
+				if out == nil {
+					out = make([]byte, 0, len(b)+4)
+				}
+				out = utf8.AppendRune(out, 0xFFFD)
+				continue
+			}
+
+			// F5-FF: invalid start
+			if c >= 0xF5 {
+				if out == nil {
+					out = make([]byte, 0, len(b)+4)
+				}
+				out = utf8.AppendRune(out, 0xFFFD)
+				continue
+			}
+
+			// Start of a valid multi-byte sequence
+			seq[0] = c
+			n = 1
+			continue
+		}
+
+		// We're in a multi-byte sequence
+		seq[n] = c
+		n++
+
+		// Check if this is a valid continuation byte
+		if c < 0x80 || c > 0xBF {
+			// Invalid continuation: emit U+FFFD for the start byte,
+			// then reprocess this byte
+			if out == nil {
+				out = make([]byte, 0, len(b)+4)
+			}
+			out = utf8.AppendRune(out, 0xFFFD)
+			n = 0
+			i-- // reprocess this byte
+			continue
+		}
+
+		// Valid continuation so far, check if we need more
+		expected := expectedLen(seq[0])
+		if n < expected {
+			// Need more bytes
+			continue
+		}
+
+		// We have a complete sequence, check if it's valid
+		r := decodeSequence(seq[:n])
+
+		if r < 0 {
+			// Invalid sequence (overlong, surrogate, out of range):
+			// emit U+FFFD for each byte
+			if out == nil {
+				out = make([]byte, 0, len(b)+4)
+			}
+			for j := 0; j < n; j++ {
+				out = utf8.AppendRune(out, 0xFFFD)
+			}
+			n = 0
+			continue
+		}
+
+		// Valid sequence
+		if out == nil {
+			out = make([]byte, 0, len(b))
+		}
+		out = utf8.AppendRune(out, r)
+		n = 0
+	}
+
+	// Handle incomplete sequence at end of input
+	if n > 0 {
+		if out == nil {
+			out = make([]byte, 0, n*3)
+		}
+		// Check if the partial sequence would be valid if completed
+		if wouldBeValid(seq[:n]) {
+			out = utf8.AppendRune(out, 0xFFFD)
+		} else {
+			// Would be overlong or out of range: emit one per byte
+			for j := 0; j < n; j++ {
+				out = utf8.AppendRune(out, 0xFFFD)
+			}
+		}
+	}
+
+	if out == nil {
+		return b
+	}
+	return string(out)
+}
+
+// expectedLen returns the expected length of a sequence starting with b
+func expectedLen(b byte) int {
+	switch {
+	case b >= 0xC2 && b <= 0xDF:
+		return 2
+	case b >= 0xE0 && b <= 0xEF:
+		return 3
+	case b >= 0xF0 && b <= 0xF4:
+		return 4
+	default:
+		return 1
+	}
+}
+
+// decodeSequence decodes a complete UTF-8 sequence.
+// Returns -1 if the sequence is invalid (overlong, surrogate, out of range).
+func decodeSequence(b []byte) rune {
+	switch len(b) {
+	case 2:
+		return rune(b[0]&0x1F)<<6 | rune(b[1]&0x3F)
+	case 3:
+		r := rune(b[0]&0x0F)<<12 | rune(b[1]&0x3F)<<6 | rune(b[2]&0x3F)
+		if r < 0x800 {
+			return -1 // overlong
+		}
+		if r >= 0xD800 && r <= 0xDFFF {
+			return -1 // surrogate
+		}
+		return r
+	case 4:
+		r := rune(b[0]&0x07)<<18 | rune(b[1]&0x3F)<<12 | rune(b[2]&0x3F)<<6 | rune(b[3]&0x3F)
+		if r < 0x10000 {
+			return -1 // overlong
+		}
+		if r > 0x10FFFF {
+			return -1 // out of range
+		}
+		return r
+	default:
+		return rune(b[0])
+	}
+}
+
+// wouldBeValid checks if a partial sequence could become valid if completed.
+func wouldBeValid(b []byte) bool {
+	if len(b) == 0 {
+		return false
+	}
+
+	first := b[0]
+	partialLen := len(b)
+
+	switch {
+	case first >= 0xC2 && first <= 0xDF:
+		// 2-byte sequence: always valid if we got a valid continuation
+		return partialLen == 1 || (partialLen == 2 && b[1] >= 0x80 && b[1] <= 0xBF)
+
+	case first == 0xE0:
+		// E0 xx yy: second byte must be >= A0 to avoid overlong
+		if partialLen == 1 {
+			return true // could still get valid continuation
+		}
+		return b[1] >= 0xA0 && b[1] <= 0xBF
+
+	case first >= 0xE1 && first <= 0xEC:
+		// These are always valid if continuations are in range
+		return true
+
+	case first == 0xED:
+		// ED xx yy: second byte must be <= 9F to avoid surrogates
+		if partialLen == 1 {
+			return true
+		}
+		return b[1] >= 0x80 && b[1] <= 0x9F
+
+	case first >= 0xEE && first <= 0xEF:
+		// These are always valid if continuations are in range
+		return true
+
+	case first == 0xF0:
+		// F0 xx yy zz: second byte must be >= 90 to avoid overlong
+		if partialLen == 1 {
+			return true
+		}
+		return b[1] >= 0x90 && b[1] <= 0xBF
+
+	case first >= 0xF1 && first <= 0xF3:
+		// These are always valid if continuations are in range
+		return true
+
+	case first == 0xF4:
+		// F4 xx yy zz: second byte must be <= 8F to stay in range
+		if partialLen == 1 {
+			return true
+		}
+		return b[1] >= 0x80 && b[1] <= 0x8F
+
+	default:
+		return false
+	}
+}
