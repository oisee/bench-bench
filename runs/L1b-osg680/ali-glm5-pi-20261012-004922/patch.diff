index 0000000..e3ec5e4
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/decode_test.go
@@ -0,0 +1,137 @@
+package nodeutf8
+
+import (
+	"testing"
+)
+
+func TestDecode(t *testing.T) {
+	tests := []struct {
+		name  string
+		input string
+		want  string
+	}{
+		// Valid ASCII
+		{"empty", "", ""},
+		{"ASCII", "hello", "hello"},
+
+		// Valid UTF-8
+		{"valid 2-byte", "\xC2\x80", "\u0080"},
+		{"valid 3-byte", "\xE0\xA0\x80", "\u0800"},
+		{"valid 4-byte", "\xF0\x90\x80\x80", "\U00010000"},
+		{"UTF-8 text", "Hello, 世界!", "Hello, 世界!"},
+
+		// Isolated continuation bytes (emit one U+FFFD each)
+		{"isolated continuation", "\x80", "\uFFFD"},
+		{"two continuations", "\x80\x80", "\uFFFD\uFFFD"},
+		{"continuation then ASCII", "\x80a", "\uFFFDa"},
+
+		// Incomplete sequences that could become valid (emit one U+FFFD)
+		{"incomplete 2-byte C2", "\xC2", "\uFFFD"},
+		{"incomplete 3-byte E0 A0 (valid partial)", "\xE0\xA0", "\uFFFD"},
+		{"incomplete 4-byte F0 90 80 (valid partial)", "\xF0\x90\x80", "\uFFFD"},
+		{"incomplete F4 80 (valid partial)", "\xF4\x80", "\uFFFD"},
+
+		// Incomplete sequences that would be invalid (emit U+FFFD per byte)
+		{"incomplete E0 80 (overlong partial)", "\xE0\x80", "\uFFFD\uFFFD"},
+		{"incomplete E0 9F (overlong partial)", "\xE0\x9F", "\uFFFD\uFFFD"},
+		{"incomplete F0 80 (overlong partial)", "\xF0\x80", "\uFFFD\uFFFD"},
+		{"incomplete F0 8F (overlong partial)", "\xF0\x8F", "\uFFFD\uFFFD"},
+		{"incomplete F4 90 (out of range partial)", "\xF4\x90", "\uFFFD\uFFFD"},
+
+		// Overlong sequences (emit one U+FFFD per byte)
+		{"overlong 2-byte C0 80", "\xC0\x80", "\uFFFD\uFFFD"},
+		{"overlong 2-byte C1 80", "\xC1\x80", "\uFFFD\uFFFD"},
+		{"overlong 3-byte E0 80 80", "\xE0\x80\x80", "\uFFFD\uFFFD\uFFFD"},
+		{"overlong 4-byte F0 80 80 80", "\xF0\x80\x80\x80", "\uFFFD\uFFFD\uFFFD\uFFFD"},
+
+		// Surrogates (emit one U+FFFD per byte)
+		{"surrogate ED A0 80", "\xED\xA0\x80", "\uFFFD\uFFFD\uFFFD"},
+		{"surrogate ED BF BF", "\xED\xBF\xBF", "\uFFFD\uFFFD\uFFFD"},
+
+		// Out of range (emit one U+FFFD per byte)
+		{"out of range F4 90 80 80", "\xF4\x90\x80\x80", "\uFFFD\uFFFD\uFFFD\uFFFD"},
+
+		// Invalid start bytes (emit one U+FFFD)
+		{"invalid F5", "\xF5", "\uFFFD"},
+		{"invalid FF", "\xFF", "\uFFFD"},
+
+		// Invalid continuation in middle of sequence
+		// E0 41 A0: E0 starts 3-byte, 41 is not continuation -> U+FFFD, then 'A', then A0 is continuation without start -> U+FFFD
+		{"bad continuation E0 41 A0", "\xE0\x41\xA0", "\uFFFDA\uFFFD"},
+		// E0 A0 41: E0 A0 is valid partial, 41 breaks it -> U+FFFD, then 'A'
+		{"bad continuation E0 A0 41", "\xE0\xA0\x41", "\uFFFDA"},
+
+		// Mixed valid and invalid
+		{"valid then invalid", "\xC2\x80\x80", "\u0080\uFFFD"},
+		{"invalid then valid", "\x80\xC2\x80", "\uFFFD\u0080"},
+		{"valid invalid valid", "a\x80b", "a\uFFFDb"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := Decode(tt.input)
+			if got != tt.want {
+				t.Errorf("Decode(%q) = %q (len %d), want %q (len %d)",
+					tt.input, got, len(got), tt.want, len(tt.want))
+				// Show character by character
+				t.Logf("Got:  %v", chars(got))
+				t.Logf("Want: %v", chars(tt.want))
+			}
+		})
+	}
+}
+
+func chars(s string) []string {
+	var result []string
+	for _, r := range s {
+		result = append(result, string(r))
+	}
+	return result
+}
+
+// TestDecodeMatchesNode verifies our implementation matches Node.js behavior.
+// These test cases were generated by running Node.js to get expected output.
+func TestDecodeMatchesNode(t *testing.T) {
+	// These cases were verified against Node.js:
+	// node -e "console.log(JSON.stringify(Buffer.from([...]).toString()))"
+	nodeCases := []struct {
+		bytes []byte
+		want  string
+	}{
+		// From Node tests above
+		{[]byte{0x80, 0x61}, "\uFFFDa"},
+		{[]byte{0xC2}, "\uFFFD"},
+		{[]byte{0xC0, 0x80}, "\uFFFD\uFFFD"},
+		{[]byte{0xED, 0xA0, 0x80}, "\uFFFD\uFFFD\uFFFD"},
+		{[]byte{0xF4, 0x90, 0x80, 0x80}, "\uFFFD\uFFFD\uFFFD\uFFFD"},
+		{[]byte{0xE0, 0x80}, "\uFFFD\uFFFD"},
+		{[]byte{0xE0}, "\uFFFD"},
+		{[]byte{0xC2, 0x80}, "\u0080"},
+		{[]byte{0xC2, 0x30}, "\uFFFD0"},
+		{[]byte{0xE0, 0xA0, 0x30}, "\uFFFD0"},
+		{[]byte{0xE0, 0xA0, 0x80}, "\u0800"},
+		{[]byte{0xF0, 0x90, 0x80, 0x80}, "\U00010000"},
+		{[]byte{0xF0, 0x90, 0x80}, "\uFFFD"},
+		{[]byte{0xFF}, "\uFFFD"},
+		{[]byte{0xFE}, "\uFFFD"},
+		{[]byte{0xE0, 0x41}, "\uFFFDA"},
+		{[]byte{0xE0, 0x41, 0x41}, "\uFFFDAA"},
+		{[]byte{0xE0, 0xA0, 0x41}, "\uFFFDA"},
+		{[]byte{0xE0, 0x80, 0x80}, "\uFFFD\uFFFD\uFFFD"},
+		{[]byte{0xF0, 0x80, 0x80, 0x80}, "\uFFFD\uFFFD\uFFFD\uFFFD"},
+		{[]byte{0xE0, 0x9F}, "\uFFFD\uFFFD"},
+		{[]byte{0xF0, 0x80}, "\uFFFD\uFFFD"},
+		{[]byte{0xF0, 0x8F}, "\uFFFD\uFFFD"},
+		{[]byte{0xF0, 0x90}, "\uFFFD"},
+		{[]byte{0xF4, 0x80}, "\uFFFD"},
+		{[]byte{0xF4, 0x90}, "\uFFFD\uFFFD"},
+	}
+
+	for _, tt := range nodeCases {
+		got := Decode(string(tt.bytes))
+		if got != tt.want {
+			t.Errorf("Decode(%x) = %q (len %d), want %q (len %d)",
+				tt.bytes, got, len(got), tt.want, len(tt.want))
+		}
+	}
+}
