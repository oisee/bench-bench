+func TestDecodeBase64(t *testing.T) {
+	tests := []struct {
+		name    string
+		encoded string
+		want    string
+	}{
+		// Basic decoding
+		{"empty", "", ""},
+		{"hello", "aGVsbG8=", "hello"},
+		{"open sesame", "b3BlbiBzZXNhbWU=", "open sesame"},
+
+		// Unpadded input
+		{"unpadded", "b3BlbiBzZXNhbWU", "open sesame"},
+
+		// URL-safe alphabet
+		{"URL-safe", "_-__", "\uFFFD\uFFFD\uFFFD"}, // decodes to bytes FF BE FF -> all invalid UTF-8
+
+		// Whitespace ignored
+		{"whitespace", "Y WJhcA==", "abap"},
+
+		// Other characters ignored
+		{"ignored chars", "Y@WJhcA==", "abap"},
+
+		// UTF-8 text
+		{"UTF-8 text", "5LiW55WM", "世界"},
+		{"UTF-8 emoji", "8J+Zgg==", "🙂"},
+
+		// Malformed UTF-8 (bytes 80 61 -> U+FFFD + 'a')
+		{"malformed UTF-8", "gGE=", "\uFFFDa"},
+
+		// Overlong UTF-8 sequence (C0 80 = overlong NUL -> 2 U+FFFD)
+		{"overlong UTF-8", "wIA=", "\uFFFD\uFFFD"},
+
+		// Surrogate (ED A0 80 -> 3 U+FFFD)
+		{"surrogate", "7aCA", "\uFFFD\uFFFD\uFFFD"},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got := DecodeBase64(&Session{}, tc.encoded)
+			if got != tc.want {
+				t.Errorf("DecodeBase64(%q) = %q, want %q", tc.encoded, got, tc.want)
+			}
+		})
+	}
+}
