--- a/tools/gogen/go/abap/http_utility.go
+++ b/tools/gogen/go/abap/http_utility.go
@@ -1,5 +1,7 @@
 package abap
 
+import "osg/gogen/nodeutf8"
+
 // EncodeBase64 is cl_http_utility=>encode_base64: Buffer.from(text), its
 // UTF-8 bytes, as base64 (open-abap-core's kernel lines; authenticate's
 // Basic header). A system converts the text in its own code page first;
@@ -7,3 +9,13 @@ package abap
 func EncodeBase64(s *Session, unencoded string) string {
 	return EncodeXBase64(s, unencoded)
 }
+
+// DecodeBase64 is cl_http_utility=>decode_base64: the bytes of a Base64
+// string, interpreted as UTF-8 text. Padded and unpadded Base64 produce
+// the same decoded text. Standard and URL-safe alphabets follow Node's
+// Buffer.from(s, "base64") behavior. Malformed UTF-8 produces Node-
+// compatible U+FFFD replacements.
+func DecodeBase64(s *Session, encoded string) string {
+	bytes := DecodeXBase64(s, encoded)
+	return nodeutf8.Decode(bytes)
+}
