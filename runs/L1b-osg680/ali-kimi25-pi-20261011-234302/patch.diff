@@ -0,0 +1,31 @@
+CLASS zcl_gogen_t_b64text DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_b64text IMPLEMENTATION.
+  METHOD run.
+    DATA lv_decoded TYPE string.
+    DATA lv_encoded TYPE string.
+
+    " Basic decoding
+    lv_decoded = cl_http_utility=>decode_base64( 'b3BlbiBzZXNhbWU=' ).
+    rv = |basic:{ lv_decoded }|.
+
+    " Unpadded
+    lv_decoded = cl_http_utility=>decode_base64( 'b3BlbiBzZXNhbWU' ).
+    rv = |{ rv } unpadded:{ lv_decoded }|.
+
+    " Unicode
+    lv_decoded = cl_http_utility=>decode_base64( 'w6TDtsO8' ).
+    rv = |{ rv } umlauts:{ lv_decoded }|.
+
+    " URL-safe characters
+    lv_decoded = cl_http_utility=>decode_base64( 'P-4' ).
+    rv = |{ rv } urlsafe:{ lv_decoded }|.
+
+    " Empty
+    lv_decoded = cl_http_utility=>decode_base64( '' ).
+    rv = |{ rv } empty:[{ lv_decoded }]|.
+  ENDMETHOD.
+ENDCLASS.
