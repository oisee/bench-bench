diff --git a/tools/gogen/go/abap/b64text_test.go b/tools/gogen/go/abap/b64text_test.go
new file mode 100644
index 0000000..afa9ba3
--- /dev/null
+++ b/tools/gogen/go/abap/b64text_test.go
@@ -0,0 +1,33 @@
+package abap
+
+import "testing"
+
+// DecodeBase64 is open-abap-core's kernel pair for cl_http_utility=>
+// decode_base64: Buffer.from(encoded, "base64") (DecodeXBase64's Node
+// leniency) and buffer.toString() (go/nodeutf8: one U+FFFD per maximal
+// ill-formed subpart). The wants are Node v26.9's answers, measured
+// 2026-10-24, the same cases the ZCL_GOGEN_T_B64TEXT fixture pins.
+func TestDecodeBase64(t *testing.T) {
+	const F = "\uFFFD"
+	for _, tc := range []struct{ encoded, want string }{
+		{"YWJhcA==", "abap"},             // padded
+		{"YWJhcA", "abap"},               // unpadded, same text
+		{"fn5+", "~~~"},                  // standard alphabet
+		{"fn5-", "~~~"},                  // URL-safe alphabet
+		{"a!G V=", "he"},                 // non-alphabet bytes ignored
+		{"aGV=c2V9", "he"},               // the read stops at padding
+		{"a=", ""},                       // one leftover character is dropped
+		{"8JCAgA==", "\xf0\x90\x80\x80"}, // U+10000: a valid astral character
+		{"4KBB", F + "A"},                // E0 A0 41: one replacement, then "A"
+		{"wkHCqQ==", F + "A©"},           // C2 41 C2 A9: replacement, "A", ©
+		{"7aCg", F + F + F},              // ED A0 A0: an encoded surrogate
+		{"wg==", F},                      // C2 alone: one replacement
+		{"/v8=", F + F},                  // FE FF: two impossible leads
+		{"Z_-__8", "g" + F + F + F},      // both alphabets mixed, invalid bytes
+		{"", ""},
+	} {
+		if got := DecodeBase64(&Session{}, tc.encoded); got != tc.want {
+			t.Errorf("DecodeBase64(%q) = %q, want %q", tc.encoded, got, tc.want)
+		}
+	}
+}
