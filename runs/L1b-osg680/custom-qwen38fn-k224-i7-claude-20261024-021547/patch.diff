+import "osg/gogen/nodeutf8"
+
 // EncodeBase64 is cl_http_utility=>encode_base64: Buffer.from(text), its
 // UTF-8 bytes, as base64 (open-abap-core's kernel lines; authenticate's
 // Basic header). A system converts the text in its own code page first;
@@ -7,3 +9,14 @@ package abap
 func EncodeBase64(s *Session, unencoded string) string {
 	return EncodeXBase64(s, unencoded)
 }
+
+// DecodeBase64 is cl_http_utility=>decode_base64: open-abap-core's kernel
+// lines are Buffer.from(encoded, "base64") and buffer.toString(). The
+// first is DecodeXBase64's Node leniency (both alphabets, non-alphabet
+// bytes ignored, the read stops at padding); the second reads the
+// decoded bytes as UTF-8 the way Node reads them -- go/nodeutf8: one
+// U+FFFD per maximal ill-formed subpart, the valid text around them
+// kept. Node is the oracle, not A4H, same as ENCODE_BASE64 above.
+func DecodeBase64(s *Session, encoded string) string {
+	return nodeutf8.Decode(DecodeXBase64(s, encoded))
+}
diff --git a/tools/gogen/go/nodeutf8/README.md b/tools/gogen/go/nodeutf8/README.md
new file mode 100644
index 0000000..6d2faf5
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/README.md
@@ -0,0 +1,19 @@
+# nodeutf8
+
+Reads raw bytes as text exactly the way Node does: `Buffer.prototype.toString()`
+with its default `"utf8"`, the WHATWG UTF-8 decode.
+
+`Decode(b)` returns valid UTF-8: every byte of `b` either survives as itself or
+becomes one U+FFFD.
+One replacement stands for a *maximal subpart* of an ill-formed subsequence,
+and the scan resumes after it, so `E0 A0 41` is one U+FFFD and `"A"`, not two
+replacements and three.
+The first continuation byte's range is what makes `E0 80`, `ED A0` and `F4 90`
+ill-formed: an overlong form, an encoded surrogate, a code point above U+10FFFF;
+`C0`, `C1`, `F5 .. FF` and a lone continuation byte are not leads at all, and a
+sequence cut at the end of the input takes its replacement.
+A valid U+FFFD in the input is one character of its own, indistinguishable from
+one the decoder wrote.
+Node v26.9 measured the table on 2026-10-24 and is the oracle, not a SAP system:
+a system reads the same bytes in its own code page.
+The package uses only Go standard types and never imports the ABAP runtime.
diff --git a/tools/gogen/go/nodeutf8/nodeutf8.go b/tools/gogen/go/nodeutf8/nodeutf8.go
new file mode 100644
index 0000000..2e2f1f8
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/nodeutf8.go
@@ -0,0 +1,97 @@
+// Package nodeutf8 is how Node reads raw bytes as text: Buffer.prototype
+// toString(), its default "utf8" -- the WHATWG UTF-8 decode. One U+FFFD
+// replaces a maximal subpart of an ill-formed subsequence and the scan
+// resumes after it, so E0 A0 41 is one replacement and "A", not two and
+// three: the bytes read so far could still start a well-formed sequence.
+// Overlong forms (C0 80, E0 80 80), encoded surrogates (ED A0 A0), the
+// leads FE and FF, a lone continuation byte, and a sequence cut at the
+// end of the input each take their replacement; the valid text around
+// them survives, and a valid U+FFFD in the input is one character of its
+// own. A4H was not measured here: Node's Buffer.from(bytes).toString()
+// is the oracle, as it is for ENCODE_BASE64.
+package nodeutf8
+
+import (
+	"strings"
+	"unicode/utf8"
+)
+
+const repl = "\uFFFD"
+
+// Decode interprets b -- its bytes, whatever they are -- as text the
+// way Node reads a Buffer: the result is valid UTF-8, every byte of b
+// either surviving as itself or becoming one replacement character.
+func Decode(b string) string {
+	if utf8.ValidString(b) {
+		return b
+	}
+	var sb strings.Builder
+	i := 0
+	for i < len(b) {
+		c := byte(b[i])
+		if c < 0x80 {
+			sb.WriteByte(c)
+			i += 1
+			continue
+		}
+		// the lead decides the length of the sequence and the range of the
+		// first continuation byte (the ranges are what makes E0 9F, ED A0
+		// and F4 90 ill-formed: overlongs, encoded surrogates, and the
+		// code points above U+10FFFF)
+		var need int
+		var lo byte
+		var hi byte
+		lo = 0x80
+		hi = 0xBF
+		if c >= 0xC2 && c <= 0xDF {
+			need = 2
+		} else if c >= 0xE0 && c <= 0xEC {
+			need = 3
+			if c == 0xE0 {
+				lo = 0xA0
+			}
+		} else if c == 0xED {
+			need = 3
+			hi = 0x9F
+		} else if c >= 0xEE && c <= 0xEF {
+			need = 3
+		} else if c >= 0xF0 && c <= 0xF3 {
+			need = 4
+			if c == 0xF0 {
+				lo = 0x90
+			}
+		} else if c == 0xF4 {
+			need = 4
+			hi = 0x8F
+		} else {
+			// 0x80 .. 0xC1 and 0xF5 .. 0xFF: not a lead at all -- a lone
+			// continuation byte or an impossible lead, one byte of a
+			// maximal subpart
+			sb.WriteString(repl)
+			i += 1
+			continue
+		}
+		var k int
+		for k = 1; k < need; k += 1 {
+			var clo byte = 0x80
+			var chi byte = 0xBF
+			if k == 1 {
+				clo = lo
+				chi = hi
+			}
+			if i+k >= len(b) || byte(b[i+k]) < clo || byte(b[i+k]) > chi {
+				break
+			}
+		}
+		if k < need {
+			// cut short or a continuation out of range: one replacement for
+			// the bytes read so far, then the scan resumes after them
+			sb.WriteString(repl)
+			i += k
+		} else {
+			sb.WriteString(b[i : i+need])
+			i += need
+		}
+	}
+	return sb.String()
+}
diff --git a/tools/gogen/go/nodeutf8/nodeutf8_test.go b/tools/gogen/go/nodeutf8/nodeutf8_test.go
new file mode 100644
index 0000000..9cb80c6
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/nodeutf8_test.go
@@ -0,0 +1,74 @@
+package nodeutf8
+
+import "testing"
+
+// each row is Node's Buffer.from(hex, "hex").toString(), measured on
+// 2026-10-24 (Node v26.9): one U+FFFD per maximal subpart of an ill-formed
+// byte subsequence, the scan resuming after it, and the valid text around
+// it kept. E0 A0 41 is one replacement and "A", not two and three: the
+// bytes read so far could still start a well-formed sequence.
+func TestDecode(t *testing.T) {
+	for _, tc := range []struct{ hex, want string }{
+		{"", ""},
+		{"41", "A"},
+		{"C3A9", "\u00E9"},
+		{"61C2A962", "a\u00A9b"},
+		{"E483A4", "\u40E4"},
+		{"F09F9FA0", hexBytes("F09F9FA0")},
+		{"F48FBFBF", hexBytes("F48FBFBF")},
+		{"F0908080", hexBytes("F0908080")},
+		{"E1A0BF", "\u183F"},
+		{"ED9FA0", hexBytes("ED9FA0")},
+		{"EE8080", "\uE000"},
+		{"E0BF8080", "\u0FC0" + "\uFFFD"},
+		{"C241C2A9", "\uFFFD" + "A" + "\u00A9"},
+		{"C2E0A041C2A9", "\uFFFD" + "\uFFFD" + "A" + "\u00A9"},
+		{"E0A041", "\uFFFD" + "A"},
+		{"F09F20", "\uFFFD" + " "},
+		{"E08080", "\uFFFD" + "\uFFFD" + "\uFFFD"},
+		{"E09FA0", "\uFFFD" + "\uFFFD" + "\uFFFD"},
+		{"C080", "\uFFFD" + "\uFFFD"},
+		{"C180", "\uFFFD" + "\uFFFD"},
+		{"EDA0A0", "\uFFFD" + "\uFFFD" + "\uFFFD"},
+		{"EDE08080", "\uFFFD" + "\uFFFD" + "\uFFFD" + "\uFFFD"},
+		{"F490BF80", "\uFFFD" + "\uFFFD" + "\uFFFD" + "\uFFFD"},
+		{"F4918080", "\uFFFD" + "\uFFFD" + "\uFFFD" + "\uFFFD"},
+		{"F5808080", "\uFFFD" + "\uFFFD" + "\uFFFD" + "\uFFFD"},
+		{"F08080BF", "\uFFFD" + "\uFFFD" + "\uFFFD" + "\uFFFD"},
+		{"FE", "\uFFFD"},
+		{"FF", "\uFFFD"},
+		{"C2", "\uFFFD"},
+		{"E0A0", "\uFFFD"},
+		{"F09F9F", "\uFFFD"},
+		{"ED80", "\uFFFD"},
+		{"80", "\uFFFD"},
+		{"BF", "\uFFFD"},
+	} {
+		if got := Decode(hexBytes(tc.hex)); got != tc.want {
+			t.Errorf("Decode(%s) = %q, want %q", tc.hex, got, tc.want)
+		}
+	}
+}
+
+// F is U+FFFD, the replacement character; a raw one in a table would be
+// invisible, so every want writes the escape.
+const F = "\uFFFD"
+
+// hexBytes reads hex pairs as raw bytes: the input of Decode is bytes,
+// and a Go string literal could not hold a lone continuation byte.
+func hexBytes(h string) string {
+	var out []byte
+	for i := 0; i < len(h); i += 2 {
+		out = append(out, byte(hexVal(h[i])*16+hexVal(h[i+1])))
+	}
+	return string(out)
+}
+
+func hexVal(c byte) int {
+	var v int
+	v = int(c & 0xF)
+	if c >= 'A' {
+		v += 9
+	}
+	return v
+}
