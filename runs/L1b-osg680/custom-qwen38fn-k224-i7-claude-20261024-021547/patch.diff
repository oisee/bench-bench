@@ -0,0 +1,43 @@
+CLASS zcl_gogen_t_b64text DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+* decode_base64 read as text: Buffer.from(encoded, "base64") plus
+* buffer.toString(). Not an A4H value: the oracle is Node v26.9 (measured
+* 2026-10-24), the same alphabet leniency as DECODE_X_BASE64 and one
+* U+FFFD per maximal ill-formed subpart of the bytes (go/nodeutf8).
+CLASS zcl_gogen_t_b64text IMPLEMENTATION.
+  METHOD run.
+    DATA lv_p TYPE string.
+    DATA lv_q TYPE string.
+    DATA lv_u TYPE string.
+    DATA lv_s TYPE string.
+    DATA lv_x TYPE string.
+    DATA lv_a TYPE string.
+    DATA lv_m TYPE string.
+    DATA lv_i TYPE string.
+    DATA lv_k TYPE string.
+    DATA lv_c TYPE string.
+    DATA lv_e TYPE string.
+* padded and unpadded base64 give the same text
+    lv_p = cl_http_utility=>decode_base64( 'w6k=' ).
+    lv_q = cl_http_utility=>decode_base64( 'w6k' ).
+* the standard and the URL-safe alphabet, as Node accepts both
+    lv_u = cl_http_utility=>decode_base64( 'fn5+' ).
+    lv_s = cl_http_utility=>decode_base64( 'fn5-' ).
+* non-alphabet characters are ignored, the read stops at padding
+    lv_x = cl_http_utility=>decode_base64( 'a!G V=' ).
+    lv_a = cl_http_utility=>decode_base64( 'aGV=c2V9' ).
+* one replacement per maximal ill-formed subpart, the text around
+* it survives: E0 A0 41 (4KBB), C2 41 C2 A9 (wkHCqQ==), the encoded
+* surrogate ED A0 A0 (7aCg), a C2 cut at the end (wg==)
+    lv_m = cl_http_utility=>decode_base64( '4KBB' ).
+    lv_i = cl_http_utility=>decode_base64( 'wkHCqQ==' ).
+    lv_k = cl_http_utility=>decode_base64( '7aCg' ).
+    lv_c = cl_http_utility=>decode_base64( 'wg==' ).
+* a valid astral character: strlen counts its two UTF-16 units
+    lv_e = cl_http_utility=>decode_base64( '8JCAgA==' ).
+    rv = |p:[{ lv_p }{ strlen( lv_p ) }]q:[{ lv_q }]u:[{ lv_u }{ lv_s }]x:[{ lv_x }{ lv_a }]m:[{ lv_m }{ strlen( lv_m ) }]i:[{ lv_i }]k:{ strlen( lv_k ) }c:[{ lv_c }]e:[{ strlen( lv_e ) }]|.
+  ENDMETHOD.
+ENDCLASS.
