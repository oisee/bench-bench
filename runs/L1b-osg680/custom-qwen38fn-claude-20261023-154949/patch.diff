+
+// cl_http_utility=>decode_base64: the bytes as Node's Buffer.from(encoded,
+// "base64") decodes them (both alphabets, padding optional, extraneous
+// bytes ignored), read as UTF-8 the way Node's toString() reads them
+// (answers pinned from Buffer.from(x, "base64").toString() on Node 26.9)
+func TestDecodeBase64(t *testing.T) {
+	for _, tc := range []struct{ encoded, want string }{
+		{"YWJhcA==", "abap"},
+		{"YWJhcA", "abap"}, // the same text without its padding
+		{"", ""},
+		{"Y WJhcA==", "abap"}, // bytes outside the alphabet are ignored
+		{"5L2g", "你"},
+		{"P8O/", "?ÿ"},
+		{"P8O_", "?ÿ"},  // the URL-safe spelling of the same bytes
+		{"--__", "���"}, // FB EF FF: three bytes that are no leads
+		{"5L0=", "�"},   // E4 BD: a truncated sequence is one character
+		{"5L0", "�"},
+		{"wIA=", "��"}, // C0 80: an overlong, both bytes bad
+		{"wIA", "��"},
+		{"7aCA", "���"}, // ED A0 80: an encoded surrogate
+		{"QcBC", "A�B"}, // the text around a broken byte survives
+		{"5A==", "�"},   // a lone E4
+		{"AB", "\x00"},  // trailing bits are dropped, as Node drops them
+	} {
+		if got := DecodeBase64(&Session{}, tc.encoded); got != tc.want {
+			t.Errorf("DecodeBase64(%q) = %q, want %q", tc.encoded, got, tc.want)
+		}
+	}
+}
