diff --git a/tools/gogen/testdata/zcl_gogen_t_b64dec.clas.abap b/tools/gogen/testdata/zcl_gogen_t_b64dec.clas.abap
new file mode 100644
index 0000000..95137b8
--- /dev/null
+++ b/tools/gogen/testdata/zcl_gogen_t_b64dec.clas.abap
@@ -0,0 +1,40 @@
+CLASS zcl_gogen_t_b64dec DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_b64dec IMPLEMENTATION.
+  METHOD run.
+    DATA lv   TYPE string.
+    DATA lv_n TYPE i.
+    lv = cl_http_utility=>decode_base64( 'YWJhcA==' ).
+    rv = |p:{ lv }|.
+    lv = cl_http_utility=>decode_base64( 'YWJhcA' ).
+    rv = |{ rv } u:{ lv }|.
+    lv = cl_http_utility=>decode_base64( '' ).
+    rv = |{ rv } e:[{ lv }]|.
+    lv = cl_http_utility=>decode_base64( 'Y WJhcA==' ).
+    rv = |{ rv } x:[{ lv }]|.
+    lv = cl_http_utility=>decode_base64( '5L2g' ).
+    lv_n = strlen( lv ).
+    rv = |{ rv } m:{ lv } n:{ lv_n }|.
+    lv = cl_http_utility=>decode_base64( 'P8O/' ).
+    rv = |{ rv } s:{ lv }|.
+    lv = cl_http_utility=>decode_base64( 'P8O_' ).
+    rv = |{ rv } r:{ lv }|.
+    lv = cl_http_utility=>decode_base64( '--__' ).
+    rv = |{ rv } f:[{ lv }]|.
+    lv = cl_http_utility=>decode_base64( '5L0=' ).
+    rv = |{ rv } d:{ lv }|.
+    lv = cl_http_utility=>decode_base64( '5L0' ).
+    rv = |{ rv } t:{ lv }|.
+    lv = cl_http_utility=>decode_base64( 'wIA=' ).
+    rv = |{ rv } o:[{ lv }]|.
+    lv = cl_http_utility=>decode_base64( '7aCA' ).
+    rv = |{ rv } g:[{ lv }]|.
+    lv = cl_http_utility=>decode_base64( 'QcBC' ).
+    rv = |{ rv } b:[{ lv }]|.
+    lv = cl_http_utility=>decode_base64( '5A==' ).
+    rv = |{ rv } k:{ lv }|.
+  ENDMETHOD.
+ENDCLASS.
