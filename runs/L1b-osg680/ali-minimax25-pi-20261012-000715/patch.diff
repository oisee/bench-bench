index 0000000..7db66ca
--- /dev/null
+++ b/tools/gogen/go/abap/decode_base64_test.go
@@ -0,0 +1,35 @@
+package abap
+
+import (
+	"testing"
+)
+
+func TestDecodeBase64(t *testing.T) {
+	for _, tc := range []struct {
+		encoded, want string
+		desc          string
+	}{
+		// Basic ASCII
+		{"YWJhcA==", "abap", "standard padded"},
+		{"YWJhcA", "abap", "standard unpadded"},
+		// URL-safe alphabet
+		{"PDw_Pz8-", "<<???>", "URL-safe"},
+		// Padded vs unpadded
+		{"YQ==", "a", "padded single char"},
+		{"YQ", "a", "unpadded single char"},
+		// With whitespace (should be ignored)
+		{"YW JhcA==", "abap", "whitespace in input"},
+		// Non-base64 characters (should be ignored, Node behavior)
+		{"YWJhcA==!", "abap", "trailing exclamation"},
+		// Empty
+		{"", "", "empty string"},
+		// Multi-byte UTF-8 (Chinese)
+		{"5L2g5aW9", "你好", "Chinese (padded)"},
+		{"5L2g5aW9", "你好", "Chinese (unpadded)"},
+	} {
+		got := DecodeBase64(&Session{}, tc.encoded)
+		if got != tc.want {
+			t.Errorf("DecodeBase64(%q) = %q, want %q (%s)", tc.encoded, got, tc.want, tc.desc)
+		}
+	}
+}
diff --git a/tools/gogen/go/nodeutf8/decode.go b/tools/gogen/go/nodeutf8/decode.go
new file mode 100644
index 0000000..cc4ef65
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/decode.go
@@ -0,0 +1,64 @@
+// Package nodeutf8 provides Node-compatible UTF-8 text decoding.
+package nodeutf8
+
+import (
+	"strings"
+	"unicode/utf8"
+)
+
+// Decode interprets a string of raw bytes as UTF-8 text, replacing invalid
+// sequences with the Unicode replacement character U+FFFD (), consistent
+// with Node.js's Buffer.toString() behavior.
+func Decode(b string) string {
+	// Fast path: if valid UTF-8, return as-is
+	if utf8.ValidString(b) {
+		return b
+	}
+
+	// Replace invalid UTF-8 sequences with U+FFFD
+	// This matches Node.js's Buffer.toString() behavior
+	var builder strings.Builder
+	builder.Grow(len(b))
+
+	i := 0
+	for i < len(b) {
+		r, size := utf8.DecodeRuneInString(b[i:])
+		if r == utf8.RuneError {
+			// Invalid UTF-8: replace with U+FFFD
+			// If this is part of an incomplete multi-byte sequence (size=1 but
+			// we have more bytes that might be continuations), check if we should
+			// skip the whole sequence
+			builder.WriteRune(utf8.RuneError)
+
+			// Check if this byte could be a lead of a multi-byte sequence
+			// and there aren't enough continuation bytes
+			if size == 1 && i+1 < len(b) {
+				c := b[i]
+				// Count expected continuation bytes for this lead
+				expected := 0
+				if c >= 0xC0 && c <= 0xC1 {
+					expected = 1 // 2-byte sequence
+				} else if c >= 0xC2 && c <= 0xDF {
+					expected = 1 // 2-byte sequence
+				} else if c >= 0xE0 && c <= 0xEF {
+					expected = 2 // 3-byte sequence
+				} else if c >= 0xF0 && c <= 0xF4 {
+					expected = 3 // 4-byte sequence
+				}
+
+				// If we don't have enough bytes for the sequence, skip them all
+				remaining := len(b) - i - 1
+				if expected > remaining && remaining > 0 {
+					// Skip the remaining bytes of this incomplete sequence
+					i += remaining
+				}
+			}
+			i++
+		} else {
+			builder.WriteRune(r)
+			i += size
+		}
+	}
+
+	return builder.String()
+}
diff --git a/tools/gogen/go/nodeutf8/decode_test.go b/tools/gogen/go/nodeutf8/decode_test.go
new file mode 100644
index 0000000..21d6cff
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/decode_test.go
@@ -0,0 +1,34 @@
+package nodeutf8
+
+import (
+	"testing"
+)
+
+func TestDecode(t *testing.T) {
+	for _, tc := range []struct {
+		input string
+		want  string
+		desc  string
+	}{
+		// Valid ASCII
+		{"abap", "abap", "valid ASCII"},
+		// Valid multi-byte UTF-8
+		{string([]byte{0xE4, 0xBD, 0xA0}), "你", "valid 3-byte Chinese"},
+		{string([]byte{0xE4, 0xBD, 0xA0, 0xE5, 0xA5, 0xBD}), "你好", "valid 6-byte Chinese"},
+		// Invalid continuation byte (0xEF alone)
+		{string([]byte{0x60, 0xEF}), "`\ufffd", "backtick + invalid 0xEF"},
+		// Overlong NUL (invalid)
+		{string([]byte{0xC0, 0x80}), "\ufffd\ufffd", "overlong NUL"},
+		// Invalid single byte
+		{string([]byte{0xFF}), "\ufffd", "invalid 0xFF"},
+		// Empty
+		{"", "", "empty string"},
+		// Truncated sequences - Node replaces entire incomplete sequence with one replacement
+		{string([]byte{0xE4, 0xBD}), "\ufffd", "truncated 3-byte sequence"},
+	} {
+		got := Decode(tc.input)
+		if got != tc.want {
+			t.Errorf("Decode(%q) = %q, want %q (%s)", tc.input, got, tc.want, tc.desc)
+		}
+	}
+}
