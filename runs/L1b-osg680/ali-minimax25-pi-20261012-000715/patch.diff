+// DecodeBase64 is cl_http_utility=>decode_base64: base64-decoded bytes
+// interpreted as UTF-8 text, with invalid sequences replaced by U+FFFD,
+// consistent with Node.js Buffer.from(s, "base64").toString().
+func DecodeBase64(s *Session, encoded string) string {
+	// Decode base64 (same logic as DecodeXBase64)
+	clean := make([]byte, 0, len(encoded))
+	for i := 0; i < len(encoded); i++ {
+		c := encoded[i]
+		if c == '=' {
+			break
+		}
+		switch {
+		case c >= 'A' && c <= 'Z', c >= 'a' && c <= 'z', c >= '0' && c <= '9', c == '+' || c == '/':
+			clean = append(clean, c)
+		case c == '-':
+			clean = append(clean, '+')
+		case c == '_':
+			clean = append(clean, '/')
+		}
+	}
+	if len(clean)%4 == 1 {
+		clean = clean[:len(clean)-1]
+	}
+	bytes, _ := base64.RawStdEncoding.DecodeString(string(clean))
+	// Convert bytes to UTF-8 text with Node-compatible replacement
+	return nodeutf8.Decode(string(bytes))
+}
+
