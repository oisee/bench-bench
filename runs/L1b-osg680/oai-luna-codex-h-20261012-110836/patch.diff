+package nodeutf8
+
+import "testing"
+
+func TestDecodeNodeMalformedUTF8(t *testing.T) {
+	for _, tc := range []struct{ input, want string }{
+		{"hello", "hello"},
+		{"caf\xc3\xa9", "café"},
+		{"\xe1\x80A", "�A"},
+		{"\xf0\x9f", "�"},
+		{"\xed\xa0\x80", "���"},
+		{"\xf4\x90\x80\x80", "����"},
+		{"\xe0\x80\x80", "���"},
+		{"x\xe2\x82y", "x�y"},
+		{"\xf0\x80\x80A", "���A"},
+	} {
+		if got := Decode(tc.input); got != tc.want {
+			t.Errorf("Decode(% x) = %q, want %q", tc.input, got, tc.want)
+		}
+	}
+}
