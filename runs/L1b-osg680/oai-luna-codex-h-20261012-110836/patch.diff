 package abap
 
+import "osg/gogen/nodeutf8"
+
 // EncodeBase64 is cl_http_utility=>encode_base64: Buffer.from(text), its
 // UTF-8 bytes, as base64 (open-abap-core's kernel lines; authenticate's
 // Basic header). A system converts the text in its own code page first;
@@ -7,3 +9,9 @@ package abap
 func EncodeBase64(s *Session, unencoded string) string {
 	return EncodeXBase64(s, unencoded)
 }
+
+// DecodeBase64 is cl_http_utility=>decode_base64: lenient Node-compatible
+// base64 decoding followed by Buffer.toString()'s lossy UTF-8 interpretation.
+func DecodeBase64(s *Session, encoded string) string {
+	return nodeutf8.Decode(DecodeXBase64(s, encoded))
+}
diff --git a/tools/gogen/go/nodeutf8/decode.go b/tools/gogen/go/nodeutf8/decode.go
new file mode 100644
index 0000000..aadf7e1
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/decode.go
@@ -0,0 +1,74 @@
+// Package nodeutf8 interprets arbitrary bytes the way Node's
+// Buffer.toString() does: malformed UTF-8 is replaced with U+FFFD.
+package nodeutf8
+
+import "unicode/utf8"
+
+// Decode returns the UTF-8 text interpretation of b using Node-compatible
+// replacement behavior for malformed and incomplete sequences.
+func Decode(b string) string {
+	out := make([]byte, 0, len(b))
+	for i := 0; i < len(b); {
+		c := b[i]
+		if c < 0x80 {
+			out = append(out, c)
+			i++
+			continue
+		}
+
+		// Each leading byte defines the continuation count and the allowed
+		// range of its first continuation (which excludes overlong forms,
+		// surrogate code points, and values above U+10FFFF).
+		need := 0
+		lo, hi := byte(0x80), byte(0xbf)
+		switch {
+		case c >= 0xc2 && c <= 0xdf:
+			need = 2
+		case c == 0xe0:
+			need, lo = 3, 0xa0
+		case c >= 0xe1 && c <= 0xec, c >= 0xee && c <= 0xef:
+			need = 3
+		case c == 0xed:
+			need, hi = 3, 0x9f
+		case c == 0xf0:
+			need, lo = 4, 0x90
+		case c >= 0xf1 && c <= 0xf3:
+			need = 4
+		case c == 0xf4:
+			need, hi = 4, 0x8f
+		default:
+			out = appendReplacement(out)
+			i++
+			continue
+		}
+
+		valid := 1 // The leading byte is part of the malformed subsequence.
+		for valid < need && i+valid < len(b) {
+			n := b[i+valid]
+			min, max := byte(0x80), byte(0xbf)
+			if valid == 1 {
+				min, max = lo, hi
+			}
+			if n < min || n > max {
+				break
+			}
+			valid++
+		}
+		if valid == need {
+			out = append(out, b[i:i+need]...)
+			i += need
+			continue
+		}
+
+		// Node consumes a valid prefix of a multibyte sequence as one bad
+		// subsequence, then retries the byte that broke it. An incomplete
+		// valid prefix at end of input is also one replacement.
+		out = appendReplacement(out)
+		i += valid
+	}
+	return string(out)
+}
+
+func appendReplacement(dst []byte) []byte {
+	return utf8.AppendRune(dst, utf8.RuneError)
+}
