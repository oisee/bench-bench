+CLASS zcl_gogen_t_b64text DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_b64text IMPLEMENTATION.
+  METHOD run.
+    DATA lv TYPE string.
+    lv = cl_http_utility=>decode_base64( 'aMOp==' ).
+    rv = |{ lv }/{ strlen( lv ) }|.
+    lv = cl_http_utility=>decode_base64( '8J-YgA' ).
+    rv = |{ rv } { lv }/{ strlen( lv ) }|.
+    lv = cl_http_utility=>decode_base64( 'eOGAQXo=' ).
+    rv = |{ rv } { lv }/{ strlen( lv ) }|.
+  ENDMETHOD.
+ENDCLASS.
