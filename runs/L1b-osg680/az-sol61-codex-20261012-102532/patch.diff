+package nodeutf8_test
+
+import (
+	"osg/gogen/nodeutf8"
+	"testing"
+)
+
+func TestDecode(t *testing.T) {
+	for _, tc := range []struct{ raw, text string }{
+		{"", ""},
+		{"ASCII\x00", "ASCII\x00"},
+		{"\xef\xbb\xbfGrüße 世界 😀", "\ufeffGrüße 世界 😀"},
+		{"\x80\xbf\xff", "���"},
+		{"a\xe2\x82z", "a�z"},
+		{"\xe2\x82", "�"},
+		{"\xf0\x9f\x92", "�"},
+		{"\xe2(\xa1", "�(�"},
+		{"\xc0\xaf", "��"},
+		{"\xe0\x80\x80", "���"},
+		{"\xed\xa0\x80", "���"},
+		{"\xf4\x90\x80\x80", "����"},
+		{"\xf0\x90\x80z", "�z"},
+		{"\xf4\x8f\xbf\xbf", "\U0010ffff"},
+		{"\xef\xbf\xbd", "�"},
+	} {
+		if got := nodeutf8.Decode(tc.raw); got != tc.text {
+			t.Errorf("Decode(%x) = %q, want %q", tc.raw, got, tc.text)
+		}
+	}
+}
