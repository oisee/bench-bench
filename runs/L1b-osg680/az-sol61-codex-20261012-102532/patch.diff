@@ -0,0 +1,103 @@
+import {test} from "node:test";
+import assert from "node:assert/strict";
+import {spawnSync} from "node:child_process";
+import {mkdtempSync, writeFileSync, rmSync} from "node:fs";
+import {dirname, join} from "node:path";
+import {fileURLToPath} from "node:url";
+import {compileProgram} from "./frontend.mjs";
+import {emitGo} from "./emit-go.mjs";
+import {libraryPath} from "../osd-lib-path.mjs";
+import {home} from "./home.mjs";
+
+const here = dirname(fileURLToPath(import.meta.url));
+
+test("compiled Base64 text and raw UTF-8 decoding match Node", () => {
+  const dir = mkdtempSync(join(here, "go", "cmd", "base64-text-test-"));
+  try {
+    writeFileSync(join(dir, "zcl_b64_text.clas.abap"), `
+CLASS zcl_b64_text DEFINITION PUBLIC FINAL CREATE PUBLIC.
+ PUBLIC SECTION.
+ CLASS-METHODS decode IMPORTING encoded TYPE string RETURNING VALUE(rv) TYPE string.
+ CLASS-METHODS length IMPORTING encoded TYPE string RETURNING VALUE(rv) TYPE i.
+ENDCLASS.
+CLASS zcl_b64_text IMPLEMENTATION.
+ METHOD decode.
+ rv = cl_http_utility=>decode_base64( encoded ).
+ ENDMETHOD.
+ METHOD length.
+ DATA text TYPE string.
+ cl_http_utility=>decode_base64( EXPORTING encoded = encoded RECEIVING decoded = text ).
+ rv = strlen( text ).
+ ENDMETHOD.
+ENDCLASS.
+`);
+    const program = compileProgram({folders: [dir, libraryPath(home, "open-abap-core")],
+      objects: ["ZCL_B64_TEXT", "CL_HTTP_UTILITY"]});
+    assert.deepEqual(program.partial.filter(p => /ZCL_B64_TEXT|~DECODE_BASE64/.test(p)), []);
+    const generated = emitGo(program);
+    assert.match(generated, /abap\.DecodeBase64/);
+    writeFileSync(join(dir, "zz_generated.go"), generated);
+
+    const raw = ["", "00", "efbbbf", "e282", "f09f92", "e228a1", "eda080", "f4908080",
+      Buffer.from("Grüße 世界 😀").toString("hex")];
+    // Every one- and two-byte input, plus all continuation boundary
+    // combinations for three- and four-byte sequences (complete or cut short).
+    for (let a = 0; a < 256; a++) {
+      raw.push(Buffer.from([a]).toString("hex"));
+      for (let b = 0; b < 256; b++) raw.push(Buffer.from([a, b]).toString("hex"));
+    }
+    const boundaries = [0, 0x41, 0x7f, 0x80, 0x8f, 0x90, 0x9f, 0xa0, 0xbf, 0xc0, 0xff];
+    for (const lead of [0xe0, 0xe1, 0xed, 0xef, 0xf0, 0xf1, 0xf4, 0xf5]) {
+      for (const b of boundaries) for (const c of boundaries) for (const d of boundaries) {
+        for (const n of [3, 4]) raw.push(Buffer.from([lead, b, c, d].slice(0, n)).toString("hex"));
+      }
+    }
+    const utf8 = raw.map(hex => ({hex, text: Buffer.from(hex, "hex").toString()}));
+    const inputs = ["", "Zg==", "Zg", "Z", "Zg=ignored", "=Zg", "abcde", "+/+/", "-_-_",
+      "Y @W\nJ\thcA?==", "ZŁg", "Z😀g", "ZĽg", "Z\u2028g", "!!", "===="];
+    for (const hex of raw.slice(0, 10)) {
+      const padded = Buffer.from(hex, "hex").toString("base64");
+      inputs.push(padded, padded.replace(/=/g, ""), padded.replace(/\+/g, "-").replace(/\//g, "_"));
+    }
+    const base64 = inputs.map(encoded => {
+      const bytes = Buffer.from(encoded, "base64");
+      const text = bytes.toString();
+      return {encoded, hex: bytes.toString("hex"), text, length: text.length};
+    });
+    writeFileSync(join(dir, "cases.json"), JSON.stringify({utf8, base64}));
+    writeFileSync(join(dir, "zz_generated_test.go"), `package main
+import (
+ _ "embed"
+ "encoding/hex"
+ "encoding/json"
+ "testing"
+ "osg/gogen/abap"
+ "osg/gogen/nodeutf8"
+)
+//go:embed cases.json
+var data []byte
+func TestNodeParity(t *testing.T) {
+ var cases struct {
+  UTF8 []struct { Hex, Text string }
+  Base64 []struct { Encoded, Hex, Text string; Length int32 }
+ }
+ if err := json.Unmarshal(data, &cases); err != nil { t.Fatal(err) }
+ for _, c := range cases.UTF8 {
+  b, err := hex.DecodeString(c.Hex); if err != nil { t.Fatal(err) }
+  if got := nodeutf8.Decode(string(b)); got != c.Text { t.Fatalf("UTF-8 %s: got %q, want %q", c.Hex, got, c.Text) }
+  if got := nodeutf8.Decode("prefix" + string(b) + "世界"); got != "prefix" + c.Text + "世界" { t.Fatalf("UTF-8 context %s: got %q", c.Hex, got) }
+ }
+ for _, c := range cases.Base64 {
+  s := &abap.Session{}
+  if got := hex.EncodeToString([]byte(abap.DecodeXBase64(s, c.Encoded))); got != c.Hex { t.Errorf("bytes %q: got %q, want %q", c.Encoded, got, c.Hex) }
+  if got := ZCL_B64_TEXT_DECODE(s, c.Encoded); got != c.Text { t.Errorf("text %q: got %q, want %q", c.Encoded, got, c.Text) }
+  if got := ZCL_B64_TEXT_LENGTH(s, c.Encoded); got != c.Length { t.Errorf("strlen %q: got %d, want %d", c.Encoded, got, c.Length) }
+ }
+}
+`);
+    const result = spawnSync("go", ["test", "."], {cwd: dir, encoding: "utf8", timeout: 120000});
+    assert.equal(result.status, 0, result.stdout + result.stderr);
+  } finally {
+    rmSync(dir, {recursive: true, force: true});
+  }
+});
