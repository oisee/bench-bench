diff --git a/tools/gogen/go/nodeutf8/decode.go b/tools/gogen/go/nodeutf8/decode.go
new file mode 100644
index 0000000..7afac9c
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/decode.go
@@ -0,0 +1,60 @@
+// Package nodeutf8 interprets raw bytes as text like Node's Buffer.toString().
+package nodeutf8
+
+import (
+	"strings"
+	"unicode/utf8"
+)
+
+// Decode returns the UTF-8 interpretation of the raw bytes in b. Each
+// malformed sequence is replaced by U+FFFD, consuming its valid prefix
+// without swallowing the byte that invalidated it. A BOM is preserved.
+func Decode(b string) string {
+	if utf8.ValidString(b) {
+		return b
+	}
+	var out strings.Builder
+	out.Grow(len(b))
+	for i := 0; i < len(b); {
+		start := i
+		c := b[i]
+		i++
+		if c < 0x80 {
+			out.WriteByte(c)
+			continue
+		}
+		n, lo, hi := 0, byte(0x80), byte(0xbf)
+		switch {
+		case c >= 0xc2 && c <= 0xdf:
+			n = 2
+		case c >= 0xe0 && c <= 0xef:
+			n = 3
+			// Exclude overlong and surrogate code points.
+			if c == 0xe0 {
+				lo = 0xa0
+			}
+			if c == 0xed {
+				hi = 0x9f
+			}
+		case c >= 0xf0 && c <= 0xf4:
+			n = 4
+			if c == 0xf0 {
+				lo = 0x90
+			}
+			if c == 0xf4 {
+				// At most U+10FFFF.
+				hi = 0x8f
+			}
+		}
+		for n > 0 && i-start < n && i < len(b) && b[i] >= lo && b[i] <= hi {
+			i++
+			lo, hi = 0x80, 0xbf
+		}
+		if n > 0 && i-start == n {
+			out.WriteString(b[start:i])
+		} else {
+			out.WriteRune(utf8.RuneError)
+		}
+	}
+	return out.String()
+}
