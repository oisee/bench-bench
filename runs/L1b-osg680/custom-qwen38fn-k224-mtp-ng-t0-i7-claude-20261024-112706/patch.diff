diff --git a/tools/gogen/testdata/zcl_gogen_t_b64dec.clas.abap b/tools/gogen/testdata/zcl_gogen_t_b64dec.clas.abap
new file mode 100644
index 0000000..08f62ae
--- /dev/null
+++ b/tools/gogen/testdata/zcl_gogen_t_b64dec.clas.abap
@@ -0,0 +1,35 @@
+CLASS zcl_gogen_t_b64dec DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_b64dec IMPLEMENTATION.
+  METHOD run.
+    DATA lv_s TYPE string.
+    DATA lv_t TYPE string.
+    lv_s = cl_http_utility=>decode_base64( 'YWJhcA==' ).
+    rv = |pad:{ lv_s }|.
+    lv_s = cl_http_utility=>decode_base64( 'YWJhcA' ).
+    rv = |{ rv } nopal:{ lv_s }|.
+    lv_s = cl_http_utility=>decode_base64( '////' ).
+    lv_t = cl_http_utility=>decode_base64( '____' ).
+    rv = |{ rv } both:{ lv_s }={ lv_t }|.
+    lv_s = cl_http_utility=>decode_base64( '77+9' ).
+    lv_t = cl_http_utility=>decode_base64( '77-9' ).
+    rv = |{ rv } fffd:{ lv_s }={ lv_t }|.
+    lv_s = cl_http_utility=>decode_base64( 'YeCggGI=' ).
+    rv = |{ rv } u800:{ lv_s } len:{ strlen( lv_s ) }|.
+    lv_s = cl_http_utility=>decode_base64( '8JCAgA==' ).
+    rv = |{ rv } u10000:{ lv_s } len:{ strlen( lv_s ) }|.
+    lv_s = cl_http_utility=>decode_base64( '4ICA' ).
+    rv = |{ rv } over:{ lv_s } len:{ strlen( lv_s ) }|.
+    lv_s = cl_http_utility=>decode_base64( 'QeCAgEI=' ).
+    rv = |{ rv } around:{ lv_s } len:{ strlen( lv_s ) }|.
+    lv_s = cl_http_utility=>decode_base64( 'YcOAYg==' ).
+    rv = |{ rv } badcont:{ lv_s } len:{ strlen( lv_s ) }|.
+    lv_s = cl_http_utility=>decode_base64( 'Y WJhcA==' ).
+    rv = |{ rv } space:{ lv_s }|.
+    lv_s = cl_http_utility=>decode_base64( 'a=b' ).
+    rv = |{ rv } stop:[{ lv_s }]|.
+  ENDMETHOD.
+ENDCLASS.
