diff --git a/tools/gogen/go/nodeutf8/README.md b/tools/gogen/go/nodeutf8/README.md
new file mode 100644
index 0000000..fa1e373
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/README.md
@@ -0,0 +1,6 @@
+# nodeutf8
+
+Node `Buffer#toString()` UTF-8 decoding: the WHATWG maximal-subpart rule,
+one U+FFFD per malformed sequence, the offending byte read again as a
+start byte. `Decode` gives the text Node answers for the same bytes.
+Used by `abap.DecodeBase64` (`cl_http_utility=>decode_base64`).
diff --git a/tools/gogen/go/nodeutf8/nodeutf8.go b/tools/gogen/go/nodeutf8/nodeutf8.go
new file mode 100644
index 0000000..e788159
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/nodeutf8.go
@@ -0,0 +1,93 @@
+// Package nodeutf8 interprets raw bytes as text the way Node does:
+// Buffer#toString() decodes UTF-8 by the WHATWG algorithm — the maximal
+// subpart of a maximal sequence is decoded, every malformed sequence
+// becomes one U+FFFD, and the byte that broke a sequence is read again
+// as a start byte. A stream that ends inside a sequence is one error.
+package nodeutf8
+
+import "strings"
+
+// Decode returns the Node-compatible UTF-8 text of the bytes of b.
+// A well-formed sequence becomes its code point; an invalid lead byte,
+// an overlong form, a surrogate half, a value past U+10FFFF, a bad
+// continuation and a truncated tail each give one U+FFFD. Valid text
+// around a malformed sequence is kept.
+func Decode(b string) string {
+	n := len(b)
+	ascii := true
+	for i := 0; i < n; i++ {
+		if b[i] >= 0x80 {
+			ascii = false
+			break
+		}
+	}
+	if ascii {
+		return b
+	}
+	var out strings.Builder
+	i := 0
+	for i < n {
+		c := b[i]
+		if c < 0x80 {
+			out.WriteByte(c)
+			i++
+			continue
+		}
+		// the sequence the lead byte opens: its length and the range of
+		// its first continuation byte (the rest are 80..BF); C0, C1,
+		// F5..FF and a bare 80..BF open nothing
+		var length int
+		var lo, hi byte
+		switch {
+		case c >= 0xC2 && c <= 0xDF:
+			length, lo, hi = 2, byte(0x80), byte(0xBF)
+		case c == 0xE0:
+			length, lo, hi = 3, byte(0xA0), byte(0xBF)
+		case c >= 0xE1 && c <= 0xEC:
+			length, lo, hi = 3, byte(0x80), byte(0xBF)
+		case c == 0xED:
+			length, lo, hi = 3, byte(0x80), byte(0x9F)
+		case c >= 0xEE && c <= 0xEF:
+			length, lo, hi = 3, byte(0x80), byte(0xBF)
+		case c == 0xF0:
+			length, lo, hi = 4, byte(0x90), byte(0xBF)
+		case c >= 0xF1 && c <= 0xF3:
+			length, lo, hi = 4, byte(0x80), byte(0xBF)
+		case c == 0xF4:
+			length, lo, hi = 4, byte(0x80), byte(0x8F)
+		default:
+			out.WriteRune(0xFFFD)
+			i++
+			continue
+		}
+		mask := byte(0x07)
+		if length == 2 {
+			mask = 0x1F
+		} else if length == 3 {
+			mask = 0x0F
+		}
+		cp := uint32(c & mask)
+		var k int
+		for k = 1; k < length; k++ {
+			if i+k >= n {
+				break // the stream ends inside the sequence: one error
+			}
+			d := b[i+k]
+			if d < lo || d > hi {
+				break // the maximal subpart ends here; d starts the next
+			}
+			cp = (cp << 6) | uint32(d-0x80)
+			lo, hi = 0x80, 0xBF
+		}
+		if k == length {
+			out.WriteRune(rune(cp))
+			i += length
+		} else {
+			out.WriteRune(0xFFFD)
+			// k is the failing byte's offset, or the stream's end when
+			// the sequence was cut short
+			i += k
+		}
+	}
+	return out.String()
+}
diff --git a/tools/gogen/go/nodeutf8/nodeutf8_test.go b/tools/gogen/go/nodeutf8/nodeutf8_test.go
new file mode 100644
index 0000000..c87bb79
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/nodeutf8_test.go
@@ -0,0 +1,58 @@
+package nodeutf8
+
+import "testing"
+
+const R = "\uFFFD" // one U+FFFD, what Node gives for a malformed sequence
+
+// The cases are Buffer.from([...]).toString() answers measured on Node.
+func TestDecode(t *testing.T) {
+	for _, tc := range []struct {
+		in  []byte
+		out string
+	}{
+		// well-formed: ASCII, 2-, 3- and 4-byte sequences, the boundaries
+		{[]byte{}, ""},
+		{[]byte{'a', 'b'}, "ab"},
+		{[]byte{0xC3, 0x84}, "Ä"},                     // U+00C4
+		{[]byte{0xE0, 0xA0, 0x80}, "ࠀ"},               // U+0800, the E0 lower bound
+		{[]byte{0xED, 0x9F, 0xBF}, "\uD7FF"},          // U+D7FF, the ED upper bound
+		{[]byte{0xEF, 0xBF, 0xBF}, "￿"},               // U+FFFF
+		{[]byte{0xF0, 0x90, 0x80, 0x80}, "𐀀"},         // U+10000, the F0 lower bound
+		{[]byte{0xF4, 0x8F, 0xBF, 0xBF}, "􏿿"},         // U+10FFFF
+		{[]byte{0xF0, 0x9F, 0xBF, 0xBF}, "\U0001FFFF"}, // F0 byte2 9F is inside 90..BF
+		{[]byte{0xF1, 0x80, 0x80, 0x80}, "\U00040000"}, // F1 takes 80..BF, not 90..
+		{[]byte{0xE1, 0x9F, 0x9F}, "៟"},               // U+17DF, E1 takes 80..BF
+		{[]byte{0x41, 0xE0, 0xA0, 0x80, 0x42}, "AࠀB"}, // valid around a 3-byte sequence
+		{[]byte{0xC2, 0x80, 0x80}, "\u0080" + R},      // the third byte is a bare continuation
+		// malformed: one U+FFFD per error, the offending byte read again
+		{[]byte{0x80}, R},
+		{[]byte{0xC0, 0x80}, R + R}, // overlong 2-byte lead
+		{[]byte{0xC1, 0xBF}, R + R},
+		{[]byte{0xE0, 0x80, 0x80}, R + R + R},           // overlong 3-byte lead
+		{[]byte{0xED, 0xA0, 0xBF}, R + R + R},           // surrogate half D800
+		{[]byte{0xF5, 0x80, 0x80, 0x80}, R + R + R + R}, // invalid lead
+		{[]byte{0xF4, 0x90, 0x80, 0x80}, R + R + R + R}, // past U+10FFFF
+		{[]byte{0xF0, 0x8F, 0xBF, 0xBF}, R + R + R + R}, // overlong 4-byte: F0 takes 90..BF
+		{[]byte{0xF0, 0x80, 0x80, 0x80}, R + R + R + R}, // overlong 4-byte lead
+		{[]byte{0xF0, 0xE0, 0xA0, 0x80}, R + "ࠀ"},       // byte2 past BF, E0 A0 80 read again
+		{[]byte{0xF1, 0x8D, 0xD5, 0xBF}, R + "\u057F"},      // byte3 fails, D5 BF is a 2-byte pair
+		{[]byte{0xE2, 0x82}, R},                         // truncated 3-byte
+		{[]byte{0xC2}, R},                               // truncated 2-byte
+		{[]byte{0xE0, 0x80}, R + R},                     // bad continuation, then a bare one
+		{[]byte{0x61, 0xC3, 0x80, 0x62}, "aÀb"},         // valid around a 2-byte sequence
+	} {
+		if got := Decode(string(tc.in)); got != tc.out {
+			t.Errorf("Decode(%v) = %q, want %q", tc.in, got, tc.out)
+		}
+	}
+}
+
+// Decode is byte-for-byte what Node's Buffer#toString gives for the same
+// bytes: the output is always valid UTF-8, so re-decoding it is the identity.
+func TestDecodeIdempotent(t *testing.T) {
+	for _, s := range []string{"", "ab", "ä", "ࠀ", "𐀀", R + R, "a" + R + "b"} {
+		if got := Decode(s); got != s {
+			t.Errorf("Decode(%q) = %q, want the text itself", s, got)
+		}
+	}
+}
