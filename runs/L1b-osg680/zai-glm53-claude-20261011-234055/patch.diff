diff --git a/tools/gogen/testdata/zcl_gogen_t_d64.clas.abap b/tools/gogen/testdata/zcl_gogen_t_d64.clas.abap
new file mode 100644
index 0000000..a139129
--- /dev/null
+++ b/tools/gogen/testdata/zcl_gogen_t_d64.clas.abap
@@ -0,0 +1,51 @@
+CLASS zcl_gogen_t_d64 DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_d64 IMPLEMENTATION.
+  METHOD run.
+    DATA lv_s TYPE string.
+    DATA lv_t TYPE string.
+    DATA lv_i TYPE i.
+    " decode_base64 is open-abap-core's kernel pair
+    " Buffer.from(encoded, "base64").toString( ): both alphabets, padding
+    " optional, junk ignored, and the bytes read as UTF-8 with one
+    " replacement character per maximal invalid subpart
+    lv_s = cl_http_utility=>decode_base64( 'b3BlbiBzZXNhbWU=' ).
+    rv = |d:{ lv_s }|.
+    lv_s = cl_http_utility=>decode_base64( 'b3BlbiBzZXNhbWU' ).
+    rv = |{ rv } pad:{ lv_s }|.
+    lv_s = cl_http_utility=>decode_base64( '-_8=' ).
+    rv = |{ rv } url:{ lv_s }|.
+    lv_t = cl_http_utility=>decode_base64( '+/8=' ).
+    IF lv_s = lv_t.
+      rv = |{ rv } eq:X|.
+    ENDIF.
+    lv_s = cl_http_utility=>decode_base64( '8J+YgA==' ).
+    lv_i = strlen( lv_s ).
+    rv = |{ rv } mb:{ lv_s }/{ lv_i }|.
+    lv_s = cl_http_utility=>decode_base64( 'ZcOpcg' ).
+    lv_i = strlen( lv_s ).
+    rv = |{ rv } acc:{ lv_s }/{ lv_i }|.
+    lv_s = cl_http_utility=>decode_base64( 'wkE=' ).
+    rv = |{ rv } cont:{ lv_s }|.
+    lv_s = cl_http_utility=>decode_base64( '7aCA' ).
+    rv = |{ rv } surr:{ lv_s }|.
+    lv_s = cl_http_utility=>decode_base64( '8ICAgA==' ).
+    rv = |{ rv } over:{ lv_s }|.
+    lv_s = cl_http_utility=>decode_base64( '9JCAgA==' ).
+    rv = |{ rv } range:{ lv_s }|.
+    lv_s = cl_http_utility=>decode_base64( '8J+Y' ).
+    rv = |{ rv } cut:{ lv_s }|.
+    lv_s = cl_http_utility=>decode_base64( '4pyTIMOg8a5v' ).
+    lv_i = strlen( lv_s ).
+    rv = |{ rv } mix:{ lv_s }/{ lv_i }|.
+    lv_s = cl_http_utility=>decode_base64( ' QUJD ' ).
+    rv = |{ rv } junk:{ lv_s }|.
+    lv_s = cl_http_utility=>decode_base64( 'QUJD=QUJD' ).
+    rv = |{ rv } padstop:{ lv_s }|.
+    lv_s = cl_http_utility=>decode_base64( '' ).
+    rv = |{ rv } empty:[{ lv_s }]|.
+  ENDMETHOD.
+ENDCLASS.
