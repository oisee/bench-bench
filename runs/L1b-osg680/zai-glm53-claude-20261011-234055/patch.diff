@@ -1,5 +1,7 @@
 package abap
 
+import "osg/gogen/nodeutf8"
+
 // EncodeBase64 is cl_http_utility=>encode_base64: Buffer.from(text), its
 // UTF-8 bytes, as base64 (open-abap-core's kernel lines; authenticate's
 // Basic header). A system converts the text in its own code page first;
@@ -7,3 +9,12 @@ package abap
 func EncodeBase64(s *Session, unencoded string) string {
 	return EncodeXBase64(s, unencoded)
 }
+
+// DecodeBase64 is cl_http_utility=>decode_base64, the other kernel pair:
+// Buffer.from(encoded, "base64").toString( ). The base64 step is
+// decode_x_base64's (both alphabets, padding optional, junk ignored), and
+// the bytes are read as UTF-8 the way Node does, one U+FFFD per maximal
+// invalid subpart (go/nodeutf8). Also not measured on A4H.
+func DecodeBase64(s *Session, encoded string) string {
+	return nodeutf8.Decode(DecodeXBase64(s, encoded))
+}
diff --git a/tools/gogen/go/nodeutf8/nodeutf8.go b/tools/gogen/go/nodeutf8/nodeutf8.go
new file mode 100644
index 0000000..76bbf6f
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/nodeutf8.go
@@ -0,0 +1,94 @@
+// Package nodeutf8 reads raw bytes as text the way Node does. Node's
+// Buffer.prototype.toString( ) decodes UTF-8 by the WHATWG encoding standard
+// (V8's decoder): each maximal invalid subpart of the byte stream becomes
+// one U+FFFD, and the byte that broke a sequence is decoded again on its
+// own, so what is valid around it survives.
+package nodeutf8
+
+import (
+	"strings"
+	"unicode/utf8"
+)
+
+const replacement = "�"
+
+// Decode returns the Node-compatible UTF-8 text interpretation of b, a
+// string of raw bytes. Valid UTF-8 passes through unchanged; the rest is
+// measured against Buffer.prototype.toString( ) (2026-10-11):
+//
+//	e2 82 ac      U+20AC        a valid sequence
+//	c2 41         FFFD 0041     41 is no continuation: the lead alone is the
+//	                           subpart, the A is decoded on its own
+//	c2 c2         FFFD FFFD     a continuation expected, then that byte again
+//	                           as a lead cut off at the end
+//	e1 80 41      FFFD 0041     a three-byte lead with one continuation
+//	f4 8f bf c2   FFFD FFFD     the fourth byte breaks it (F4's first
+//	                           continuation ends at 8F), then c2 as a lead
+//	                           cut off at the end
+//	ed a0 80      FFFD FFFD FFFD   a surrogate: ED's first continuation ends
+//	                           at 9F, so a0 breaks it after the lead alone
+//	f0 80 80 80   FFFD FFFD FFFD FFFD   overlong: F0 wants 90..BF first
+//	f0 9f 98      FFFD          cut off: the rest of the input is one subpart
+func Decode(b string) string {
+	if utf8.ValidString(b) {
+		return b
+	}
+	var out strings.Builder
+	out.Grow(len(b))
+	// the WHATWG utf-8 decoder's state: how many continuation bytes are
+	// still expected, the code point under construction, and the range the
+	// next byte must be in (the lead's own for the first continuation,
+	// 80..BF for the rest)
+	need := 0
+	var lo, hi byte = 0x80, 0xBF
+	cp := rune(0)
+	for i := 0; i < len(b); i++ {
+		c := b[i]
+		if need > 0 {
+			if c >= lo && c <= hi {
+				cp = cp<<6 | rune(c&0x3F)
+				need--
+				lo, hi = 0x80, 0xBF
+				if need == 0 {
+					out.WriteRune(cp)
+				}
+				continue
+			}
+			// the byte ends the sequence: one replacement for the subpart,
+			// and the byte itself is decoded again as the next one (the
+			// WHATWG decoder prepends it to the stream)
+			out.WriteString(replacement)
+			need = 0
+		}
+		// state empty: what the lead byte promises. The ranges are what
+		// keeps out overlong forms, surrogates and anything past U+10FFFF;
+		// C0, C1 and F5..FF promise nothing and are subparts of their own.
+		cp = 0
+		lo, hi = 0x80, 0xBF
+		switch {
+		case c < utf8.RuneSelf:
+			out.WriteByte(c)
+		case c >= 0xC2 && c <= 0xDF:
+			cp, need = rune(c&0x1F), 1
+		case c == 0xE0:
+			cp, need, lo = rune(c&0x0F), 2, 0xA0
+		case (c >= 0xE1 && c <= 0xEC) || (c >= 0xEE && c <= 0xEF):
+			cp, need = rune(c&0x0F), 2
+		case c == 0xED:
+			cp, need, hi = rune(c&0x0F), 2, 0x9F
+		case c == 0xF0:
+			cp, need, lo = rune(c&0x07), 3, 0x90
+		case c >= 0xF1 && c <= 0xF3:
+			cp, need = rune(c&0x07), 3
+		case c == 0xF4:
+			cp, need, hi = rune(c&0x07), 3, 0x8F
+		default:
+			out.WriteString(replacement)
+		}
+	}
+	if need > 0 {
+		// cut off at the end of the input: one subpart, one replacement
+		out.WriteString(replacement)
+	}
+	return out.String()
+}
diff --git a/tools/gogen/go/nodeutf8/nodeutf8_test.go b/tools/gogen/go/nodeutf8/nodeutf8_test.go
new file mode 100644
index 0000000..cb042ac
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/nodeutf8_test.go
@@ -0,0 +1,77 @@
+package nodeutf8
+
+import (
+	"encoding/hex"
+	"fmt"
+	"strings"
+	"testing"
+)
+
+// every row is Buffer.from(bytes).toString( ) on Node 26.9, 2026-10-11: the
+// hex of the bytes, and the result as one four-digit code point per
+// character
+func TestDecode(t *testing.T) {
+	for _, tc := range []struct{ bytes, want string }{
+		{"", ""},
+		{"41", "0041"},
+		{"61 62 63", "0061 0062 0063"},
+		{"00", "0000"},
+		// valid multibyte
+		{"c3 a4", "00e4"},
+		{"e2 82 ac", "20ac"},
+		{"f0 9f 98 80", "1f600"},
+		{"e0 a0 80", "0800"},
+		{"ed 9f bf", "d7ff"},
+		{"ee 80 80", "e000"},
+		{"f0 90 80 80", "10000"},
+		{"f4 8f bf bf", "10ffff"},
+		{"c3 a9 65", "00e9 0065"},
+		// invalid continuations: the lead is the subpart, the byte that broke
+		// it is decoded on its own
+		{"c2 41", "fffd 0041"},
+		{"c2 ff", "fffd fffd"},
+		{"c2 c2", "fffd fffd"},
+		{"c2 db", "fffd fffd"},
+		{"e1 80 41", "fffd 0041"},
+		{"f0 9f 41", "fffd 0041"},
+		{"f0 9f 98 41", "fffd 0041"},
+		{"e1 80 c2 82", "fffd 0082"},
+		{"e2 28 a1", "fffd 0028 fffd"},
+		{"80", "fffd"},
+		{"ff", "fffd"},
+		{"fe", "fffd"},
+		// invalid code points: the range of the first continuation breaks the
+		// sequence after the lead alone
+		{"c0 80", "fffd fffd"},
+		{"c1 bf", "fffd fffd"},
+		{"e0 9f 80", "fffd fffd fffd"},
+		{"e0 9f bf", "fffd fffd fffd"},
+		{"ed a0 80", "fffd fffd fffd"},
+		{"f0 80 80 80", "fffd fffd fffd fffd"},
+		{"f0 82 82 ac", "fffd fffd fffd fffd"},
+		{"f4 90 80 80", "fffd fffd fffd fffd"},
+		// a later continuation breaks it after the bytes that were fine
+		{"f4 8f bf c2", "fffd fffd"},
+		// incomplete sequences at the end: the rest is one subpart
+		{"c2", "fffd"},
+		{"e2 82", "fffd"},
+		{"f0 9f 98", "fffd"},
+		{"f4 8f bf", "fffd"},
+		// valid text around malformed bytes is preserved
+		{"41 c3 a4 80 42", "0041 00e4 fffd 0042"},
+		{"61 ed a1 b4 62", "0061 fffd fffd fffd 0062"},
+	} {
+		raw, err := hex.DecodeString(strings.ReplaceAll(tc.bytes, " ", ""))
+		if err != nil {
+			t.Fatalf("bad hex %q", tc.bytes)
+		}
+		got := ""
+		for _, r := range Decode(string(raw)) {
+			got += fmt.Sprintf("%04x ", r)
+		}
+		got = strings.TrimSuffix(got, " ")
+		if got != tc.want {
+			t.Errorf("Decode(%q) = %q, want %q", tc.bytes, got, tc.want)
+		}
+	}
+}
