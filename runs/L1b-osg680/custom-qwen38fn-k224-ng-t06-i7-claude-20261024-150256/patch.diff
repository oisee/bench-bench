+CLASS zcl_gogen_t_b64d DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_b64d IMPLEMENTATION.
+  METHOD run.
+    DATA lv_e TYPE string.
+    DATA lv_d TYPE string.
+    DATA lv_n TYPE i.
+    lv_e = 'aGVl='.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |pad:{ lv_d }|.
+    lv_e = 'aGVl'.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |{ rv } nopad:{ lv_d }|.
+    lv_e = 'a-_/'.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |{ rv } url:{ lv_d }|.
+    lv_e = 'a+//'.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |{ rv } std:{ lv_d }|.
+    lv_e = 'aGVl ZGV4'.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |{ rv } gap:{ lv_d }|.
+    lv_e = 'aGVl=ZGV4'.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |{ rv } cut:{ lv_d }|.
+    lv_e = 'aGVl!'.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |{ rv } bang:{ lv_d }|.
+    lv_e = 'a'.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |{ rv } one:[{ lv_d }]|.
+    lv_e = 'aMOpbGxv'.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    lv_n = strlen( lv_d ).
+    rv = |{ rv } u8:{ lv_d } len:{ lv_n }|.
+    lv_e = '/w=='.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |{ rv } ff:[{ lv_d }]|.
+    lv_e = 'wIA='.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |{ rv } c080:[{ lv_d }]|.
+    lv_e = '4ICA'.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |{ rv } e08080:[{ lv_d }]|.
+    lv_e = '7aCg'.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |{ rv } surro:[{ lv_d }]|.
+    lv_e = '4YA='.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |{ rv } cut3:[{ lv_d }]|.
+    lv_e = '8I+AgA=='.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |{ rv } f08f:[{ lv_d }]|.
+    lv_e = '9Y4='.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |{ rv } f58e:[{ lv_d }]|.
+    lv_e = 'zoDO'.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |{ rv } ce80:[{ lv_d }]|.
+    lv_e = 'QfRB'.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |{ rv } mid:[{ lv_d }]|.
+    lv_e = '4KCA'.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    rv = |{ rv } a000:[{ lv_d }]|.
+    lv_e = 'QcOpQg=='.
+    lv_d = cl_http_utility=>decode_base64( lv_e ).
+    lv_n = strlen( lv_d ).
+    rv = |{ rv } mix:[{ lv_d }] len:{ lv_n }|.
+  ENDMETHOD.
+ENDCLASS.
