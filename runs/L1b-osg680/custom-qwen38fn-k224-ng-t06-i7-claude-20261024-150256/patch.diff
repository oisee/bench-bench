+func DecodeBase64(s *Session, encoded string) string {
+	return nodeutf8.Decode(DecodeXBase64(s, encoded))
+}
diff --git a/tools/gogen/go/nodeutf8/README.md b/tools/gogen/go/nodeutf8/README.md
new file mode 100644
index 0000000..6bce441
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/README.md
@@ -0,0 +1,10 @@
+# nodeutf8
+
+Node's UTF-8 text interpretation of raw bytes (`Buffer.toString("utf8")`),
+shared by the base64 host functions and any other byte-to-text seam.
+`Decode` returns valid UTF-8 unchanged; every maximal subpart of an ill-formed
+byte subsequence becomes one U+FFFD, and valid text around it survives.
+The counts follow V8, not the WHATWG table: an out-of-range continuation
+byte replaces the lead alone and is re-read (0xE0 0x9F 0xBF is three),
+a sequence cut by the end of the input is one. The rows of
+`nodeutf8_test.go` are Node 22's answers.
diff --git a/tools/gogen/go/nodeutf8/nodeutf8.go b/tools/gogen/go/nodeutf8/nodeutf8.go
new file mode 100644
index 0000000..15149fd
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/nodeutf8.go
@@ -0,0 +1,100 @@
+// Package nodeutf8 interprets a string of raw bytes as text the way Node's
+// Buffer.toString("utf8") does: every maximal subpart of an ill-formed byte
+// subsequence becomes one U+FFFD, the valid text around it survives, and a
+// sequence cut by the end of the input is one replacement too. Node (V8),
+// not the WHATWG table, is the oracle: an out-of-range continuation byte
+// ends the sequence at its lead and the byte itself is replaced again (0xE0
+// 0x9F 0xBF is three U+FFFD, not two; 0xC0 0x80 is two, not one), while
+// 0xE1 0x80 cut short is one. Measured on Node 22, 2026-10-24.
+package nodeutf8
+
+import "strings"
+
+const replacement = "\uFFFD"
+
+// Decode returns the Node-compatible UTF-8 text of a string of raw bytes:
+// valid UTF-8 comes back unchanged, each ill-formed subpart of the rest
+// becomes one U+FFFD.
+func Decode(b string) string {
+	ascii := true
+	for i := 0; i < len(b); i++ {
+		if b[i] >= 0x80 {
+			ascii = false
+			break
+		}
+	}
+	if ascii {
+		return b
+	}
+	var out strings.Builder
+	n := len(b)
+	i := 0
+	for i < n {
+		c := b[i]
+		if c < 0x80 {
+			out.WriteByte(c)
+			i++
+			continue
+		}
+		// 0x80..0xC1: a continuation byte used as a lead, or an overlong
+		// lead; 0xF5..0xFF: no sequence starts here. One replacement, one
+		// byte.
+		if c <= 0xC1 || c >= 0xF5 {
+			out.WriteString(replacement)
+			i++
+			continue
+		}
+		// the lead's range for the second byte: E0 excludes the overlong
+		// 80..9F, ED the surrogates A0..BF, F0 the overlong 80..8F and F4
+		// the beyond-10FFFF 90..BF
+		lo := byte(0x80)
+		hi := byte(0xBF)
+		total := 2
+		var cp uint32
+		if c <= 0xDF {
+			cp = uint32(c&0x1F) << 6
+		} else if c <= 0xEF {
+			cp = uint32(c&0x0F) << 12
+			total = 3
+			if c == 0xE0 {
+				lo = 0xA0
+			} else if c == 0xED {
+				hi = 0x9F
+			}
+		} else {
+			cp = uint32(c&0x07) << 18
+			total = 4
+			if c == 0xF0 {
+				lo = 0x90
+			} else if c == 0xF4 {
+				hi = 0x8F
+			}
+		}
+		if i+1 >= n || b[i+1] < lo || b[i+1] > hi {
+			// the second byte is not in the lead's range: Node replaces the
+			// lead and re-reads that byte, it is not part of the sequence
+			out.WriteString(replacement)
+			i++
+			continue
+		}
+		cp |= uint32(b[i+1]&0x3F) << uint32(6*(total-2))
+		k := 2
+		for ; k < total; k++ {
+			if i+k >= n || b[i+k] < 0x80 || b[i+k] > 0xBF {
+				break
+			}
+			cp |= uint32(b[i+k]&0x3F) << uint32(6*(total-1-k))
+		}
+		if k < total {
+			// a missing or non-continuation byte mid-sequence: one
+			// replacement for the valid prefix of the sequence, and the
+			// scan resumes at the byte that broke it
+			out.WriteString(replacement)
+			i += k
+			continue
+		}
+		out.WriteRune(rune(cp))
+		i += total
+	}
+	return out.String()
+}
diff --git a/tools/gogen/go/nodeutf8/nodeutf8_test.go b/tools/gogen/go/nodeutf8/nodeutf8_test.go
new file mode 100644
index 0000000..5c15d53
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/nodeutf8_test.go
@@ -0,0 +1,60 @@
+package nodeutf8
+
+import "testing"
+
+// the rows are Buffer.from(<bytes>).toString() on Node 22 (2026-10-24):
+// one U+FFFD per maximal ill-formed subpart, Node's counts for an
+// out-of-range continuation byte (the lead is replaced alone and the byte
+// re-read) and for a sequence cut by the end of the input
+func TestDecode(t *testing.T) {
+	for _, tc := range []struct {
+		in, want string
+	}{
+		{"", ""},
+		{"abc", "abc"},
+		{"héllo", "héllo"},
+		{"AéB", "AéB"},
+		// a lone continuation byte, an invalid lead
+		{"\xff", "�"},
+		{"\x80", "�"},
+		{"\xf5\x8e", "��"},
+		{"\xf8\x80\x80\x80", "����"},
+		// overlong leads: Node replaces the lead and re-reads the byte
+		{"\xc0\x80", "��"},
+		{"\xc1\xbf", "��"},
+		{"\xe0\x80\x80", "���"},
+		{"\xe0\x9f\xbf", "���"},
+		{"\xf0\x8f\x80\x80", "����"},
+		{"\xf4\x90\x80\x80", "����"},
+		// the surrogate range
+		{"\xed\xa0\xa0", "���"},
+		// cut by the end of the input: one replacement for the prefix
+		{"\xc2", "�"},
+		{"\xe1\x80", "�"},
+		{"\xe0\xa0", "�"},
+		{"\xf0\x90\x80", "�"},
+		// a non-continuation byte mid-sequence: one replacement, resume
+		// at that byte
+		{"\xc2(", "�("},
+		{"\xe1\x80(", "�("},
+		{"\xf0\x90(", "�("},
+		{"\xf0\x90\x80(", "�("},
+		{"\xf0\x90( ", "�( "},
+		// valid text around the malformed bytes
+		{"\xce\x80\xce", "΀�"},
+		{"A\xf4A", "A�A"},
+		{"h\xc3\xa9e", "hée"},
+		// valid multibyte, all ranges
+		{"\xc2\x80", "\u0080"},
+		{"\xdf\xbf", "\u07ff"},
+		{"\xe0\xa0\x80", "ࠀ"},
+		{"\xef\xbf\xbf", "￿"},
+		{"\xf0\x90\x80\x80", "𐀀"},
+		{"\xf4\x8f\xbf\xbf", "􏿿"},
+		{"\xed\x9f\xbf", "\ud7ff"},
+	} {
+		if got := Decode(tc.in); got != tc.want {
+			t.Errorf("Decode(%q) = %q, want %q", tc.in, got, tc.want)
+		}
+	}
+}
