diff --git a/tools/gogen/go/nodeutf8/nodeutf8.go b/tools/gogen/go/nodeutf8/nodeutf8.go
new file mode 100644
index 0000000..aee10b2
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/nodeutf8.go
@@ -0,0 +1,78 @@
+// Package nodeutf8 interprets raw bytes as UTF-8 with Node's replacement
+// behavior for malformed sequences.
+package nodeutf8
+
+import (
+	"strings"
+	"unicode/utf8"
+)
+
+const replacement = "\uFFFD"
+
+// Decode returns the Node-compatible UTF-8 text interpretation of b.
+func Decode(b string) string {
+	if utf8.ValidString(b) {
+		return b
+	}
+
+	out := strings.Builder{}
+	out.Grow(len(b))
+	var codePoint rune
+	var bytesNeeded, bytesSeen int
+	lowerBoundary, upperBoundary := byte(0x80), byte(0xBF)
+
+	for index := 0; index < len(b); index++ {
+		value := b[index]
+		if bytesNeeded == 0 {
+			switch {
+			case value < utf8.RuneSelf:
+				out.WriteByte(value)
+			case value >= 0xC2 && value <= 0xDF:
+				bytesNeeded, bytesSeen = 1, 0
+				codePoint = rune(value & 0x1F)
+			case value >= 0xE0 && value <= 0xEF:
+				lowerBoundary, upperBoundary = 0x80, 0xBF
+				if value == 0xE0 {
+					lowerBoundary = 0xA0
+				} else if value == 0xED {
+					upperBoundary = 0x9F
+				}
+				bytesNeeded, bytesSeen = 2, 0
+				codePoint = rune(value & 0x0F)
+			case value >= 0xF0 && value <= 0xF4:
+				lowerBoundary, upperBoundary = 0x80, 0xBF
+				if value == 0xF0 {
+					lowerBoundary = 0x90
+				} else if value == 0xF4 {
+					upperBoundary = 0x8F
+				}
+				bytesNeeded, bytesSeen = 3, 0
+				codePoint = rune(value & 0x07)
+			default:
+				out.WriteString(replacement)
+			}
+			continue
+		}
+
+		if value < lowerBoundary || value > upperBoundary {
+			codePoint, bytesNeeded, bytesSeen = 0, 0, 0
+			lowerBoundary, upperBoundary = 0x80, 0xBF
+			out.WriteString(replacement)
+			index--
+			continue
+		}
+
+		lowerBoundary, upperBoundary = 0x80, 0xBF
+		codePoint = codePoint<<6 | rune(value&0x3F)
+		bytesSeen++
+		if bytesSeen == bytesNeeded {
+			out.WriteRune(codePoint)
+			codePoint, bytesNeeded, bytesSeen = 0, 0, 0
+		}
+	}
+
+	if bytesNeeded != 0 {
+		out.WriteString(replacement)
+	}
+	return out.String()
+}
diff --git a/tools/gogen/go/nodeutf8/nodeutf8_test.go b/tools/gogen/go/nodeutf8/nodeutf8_test.go
