@@ -0,0 +1,32 @@
+package nodeutf8
+
+import "testing"
+
+func TestDecode(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		bytes []byte
+		want  string
+	}{
+		{"empty", nil, ""},
+		{"ascii", []byte("Node compatible"), "Node compatible"},
+		{"nul", []byte{0}, "\x00"},
+		{"two bytes", []byte{0xC2, 0x80}, ""},
+		{"three bytes", []byte{0xE2, 0x82, 0xAC}, "€"},
+		{"four bytes", []byte{0xF0, 0x9F, 0x98, 0x80}, "😀"},
+		{"invalid continuation", []byte{0x80}, "�"},
+		{"incomplete two bytes", []byte{0xC2}, "�"},
+		{"incomplete three bytes", []byte{0xE2, 0x82}, "�"},
+		{"incomplete four bytes", []byte{0xF0, 0x9F, 0x98}, "�"},
+		{"invalid continuation is not masked when ascii", []byte{0xE2, 0x82, 'A'}, "�A"},
+		{"invalid continuation is restored", []byte{0xE0, 0x80}, "��"},
+		{"overlong sequence", []byte{0xE0, 0x9F, 0xBF}, "���"},
+		{"surrogate", []byte{0xED, 0xA0, 0x80}, "���"},
+		{"above unicode", []byte{0xF4, 0x90, 0x80, 0x80}, "����"},
+		{"valid text around malformed bytes", []byte{0xC3, 0xA9, 0x80, 0xC3, 0xA9}, "é�é"},
+	} {
+		if got := Decode(string(tc.bytes)); got != tc.want {
+			t.Errorf("%s: Decode() = %q, want %q", tc.name, got, tc.want)
+		}
+	}
+}
