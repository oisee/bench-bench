@@ -7,3 +9,11 @@ package abap
 func EncodeBase64(s *Session, unencoded string) string {
 	return EncodeXBase64(s, unencoded)
 }
+
+// DecodeBase64 is cl_http_utility=>decode_base64: Buffer.from(encoded,
+// "base64").toString(), the bytes of decode_x_base64 read as UTF-8 with
+// Node's replacement characters for malformed sequences (go/nodeutf8).
