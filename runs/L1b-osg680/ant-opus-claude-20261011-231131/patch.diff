+test("cl_http_utility=>decode_base64 reads the bytes as Node's Buffer.toString() does", (t) => {
+  const core = join(here, "..", "..", ".local", "lars", "open-abap-core", "src");
+  if (!existsSync(core)) return t.skip("no open-abap-core clone in .local/lars");
+  const sourceDir = mkdtempSync(join(tmpdir(), "gogen-b64text-"));
+  const goDir = mkdtempSync(join(here, "go", "cmd", "gogen-b64text-"));
+  try {
+    writeFileSync(join(sourceDir, "zcl_gogen_b64text.clas.abap"), `
+CLASS zcl_gogen_b64text DEFINITION PUBLIC FINAL CREATE PUBLIC.
+PUBLIC SECTION.
+CLASS-METHODS run IMPORTING encoded TYPE string EXPORTING ev_text TYPE string ev_len TYPE i.
+ENDCLASS.
+CLASS zcl_gogen_b64text IMPLEMENTATION.
+METHOD run.
+ev_text = cl_http_utility=>decode_base64( encoded ).
+ev_len = strlen( ev_text ).
+ENDMETHOD.
+ENDCLASS.
+`);
+    const program = compileProgram({folders: [sourceDir, core], objects: ["ZCL_GOGEN_B64TEXT", "CL_HTTP_UTILITY"]});
+    assert.ok(!program.partial.some((x) => /DECODE_BASE64/.test(x)), program.partial.join("\n"));
+    // the bytes of each case, encoded padded, unpadded, URL-safe and with
+    // characters base64 does not have; Node's answer is the expectation
+    const hexes = ["", "61626170", "c3a4e282acf09f9880", "efbbbf41", "e28241", "f0908041", "eda080", "c0af",
+      "f4908080", "f09f98", "61e282ac62ff63", "fbff", "3e3f3e"];
+    const rows = [];
+    for (const hex of hexes) {
+      const std = Buffer.from(hex, "hex").toString("base64");
+      for (const encoded of [std, std.replace(/=+$/, ""), Buffer.from(hex, "hex").toString("base64url"), ` ${std.slice(0, 2)}\n${std.slice(2)}!`]) {
+        const text = Buffer.from(encoded, "base64").toString();
+        assert.equal(text, Buffer.from(hex, "hex").toString());
+        rows.push(`{${JSON.stringify(encoded)}, "${Buffer.from(text).toString("hex")}", ${text.length}},`);
+      }
+    }
+    writeFileSync(join(goDir, "zz_generated.go"), emitGo(program));
+    writeFileSync(join(goDir, "zz_generated_test.go"), `package main
+import ("encoding/hex"; "testing"; "osg/gogen/abap")
+func TestDecodeBase64Text(t *testing.T) {
+ for _, tc := range []struct{ encoded, hex string; n int32 }{
+${rows.join("\n")}
+ } {
+  var text string
+  var n int32
+  ZCL_GOGEN_B64TEXT_RUN(&abap.Session{}, tc.encoded, &text, &n)
+  if got := hex.EncodeToString([]byte(text)); got != tc.hex || n != tc.n {
+   t.Errorf("decode_base64(%q) = %s (strlen %d), want %s (strlen %d)", tc.encoded, got, n, tc.hex, tc.n)
+  }
+ }
+}
+`);
+    const run = spawnSync("go", ["test", `./cmd/${basename(goDir)}`], {cwd: join(here, "go"), encoding: "utf8", timeout: 120000});
+    assert.equal(run.status, 0, run.stderr || run.stdout);
+  } finally {
+    rmSync(sourceDir, {recursive: true, force: true});
+    rmSync(goDir, {recursive: true, force: true});
+  }
+});
