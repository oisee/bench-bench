index 0000000..4eb9305
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/README.md
@@ -0,0 +1,6 @@
+# nodeutf8
+
+Bytes read as UTF-8 the way Node's `Buffer.toString()` reads them.
+`Decode` returns valid UTF-8 unchanged and puts one U+FFFD per maximal
+subpart of a malformed sequence (the WHATWG decoder), keeping a BOM as text.
+`cl_http_utility=>decode_base64` uses it (`abap.DecodeBase64`).
diff --git a/tools/gogen/go/nodeutf8/nodeutf8.go b/tools/gogen/go/nodeutf8/nodeutf8.go
new file mode 100644
index 0000000..7fa9847
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/nodeutf8.go
@@ -0,0 +1,68 @@
+// Package nodeutf8 reads bytes as UTF-8 the way Node's Buffer.toString()
+// does: the WHATWG decoder, one U+FFFD per maximal subpart of a malformed
+// sequence, and a byte order mark kept as text.
+package nodeutf8
+
+import (
+	"strings"
+	"unicode/utf8"
+)
+
+// Decode returns the text of the raw bytes in b. Valid UTF-8 comes back as
+// it is; each malformed sequence becomes U+FFFD as Node replaces it.
+func Decode(b string) string {
+	if utf8.ValidString(b) {
+		return b
+	}
+	var out strings.Builder
+	out.Grow(len(b) + 8)
+	var cp rune
+	need, seen := 0, 0
+	lower, upper := byte(0x80), byte(0xBF)
+	for i := 0; i < len(b); i++ {
+		c := b[i]
+		if need == 0 {
+			switch {
+			case c < 0x80:
+				out.WriteByte(c)
+			case c >= 0xC2 && c <= 0xDF:
+				need, cp = 1, rune(c&0x1F)
+			case c >= 0xE0 && c <= 0xEF:
+				if c == 0xE0 {
+					lower = 0xA0
+				} else if c == 0xED {
+					upper = 0x9F
+				}
+				need, cp = 2, rune(c&0x0F)
+			case c >= 0xF0 && c <= 0xF4:
+				if c == 0xF0 {
+					lower = 0x90
+				} else if c == 0xF4 {
+					upper = 0x8F
+				}
+				need, cp = 3, rune(c&0x07)
+			default:
+				out.WriteRune(utf8.RuneError)
+			}
+			continue
+		}
+		if c < lower || c > upper {
+			// the sequence so far is one replacement; the byte starts afresh
+			need, seen, cp = 0, 0, 0
+			lower, upper = 0x80, 0xBF
+			out.WriteRune(utf8.RuneError)
+			i--
+			continue
+		}
+		lower, upper = 0x80, 0xBF
+		cp = cp<<6 | rune(c&0x3F)
+		if seen++; seen == need {
+			out.WriteRune(cp)
+			need, seen, cp = 0, 0, 0
+		}
+	}
+	if need != 0 {
+		out.WriteRune(utf8.RuneError)
+	}
+	return out.String()
+}
diff --git a/tools/gogen/go/nodeutf8/nodeutf8_test.go b/tools/gogen/go/nodeutf8/nodeutf8_test.go
new file mode 100644
index 0000000..f3b203b
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/nodeutf8_test.go
@@ -0,0 +1,43 @@
+package nodeutf8
+
+import (
+	"encoding/hex"
+	"testing"
+)
+
+// Both sides are hex: the bytes in, and the UTF-8 of
+// Buffer.from(in, "hex").toString() on Node 22 (efbfbd is U+FFFD).
+func TestDecode(t *testing.T) {
+	for _, tc := range []struct{ in, want string }{
+		{"", ""},
+		{"61626170", "61626170"},
+		{"efbbbf41", "efbbbf41"},
+		{"c3a4e282acf09f9880", "c3a4e282acf09f9880"},
+		{"e28241", "efbfbd41"},
+		{"f0908041", "efbfbd41"},
+		{"eda080", "efbfbdefbfbdefbfbd"},
+		{"c0af", "efbfbdefbfbd"},
+		{"e080af", "efbfbdefbfbdefbfbd"},
+		{"f4908080", "efbfbdefbfbdefbfbdefbfbd"},
+		{"f5", "efbfbd"},
+		{"80bf", "efbfbdefbfbd"},
+		{"e2", "efbfbd"},
+		{"f09f98", "efbfbd"},
+		{"41f09f98", "41efbfbd"},
+		{"ff41", "efbfbd41"},
+		{"c3c3a4", "efbfbdc3a4"},
+		{"61e282ac62ff63", "61e282ac62efbfbd63"},
+		{"f09f", "efbfbd"},
+		{"edbfbf", "efbfbdefbfbdefbfbd"},
+		{"ee8080", "ee8080"},
+		{"f48fbfbf", "f48fbfbf"},
+	} {
+		raw, err := hex.DecodeString(tc.in)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := hex.EncodeToString([]byte(Decode(string(raw)))); got != tc.want {
+			t.Errorf("Decode(%s) = %s, want %s", tc.in, got, tc.want)
+		}
+	}
+}
