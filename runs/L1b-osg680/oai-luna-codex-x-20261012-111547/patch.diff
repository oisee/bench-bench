diff --git a/tools/gogen/testdata/zcl_gogen_t_decode64.clas.abap b/tools/gogen/testdata/zcl_gogen_t_decode64.clas.abap
new file mode 100644
index 0000000..75e0e75
--- /dev/null
+++ b/tools/gogen/testdata/zcl_gogen_t_decode64.clas.abap
@@ -0,0 +1,48 @@
+CLASS zcl_gogen_t_decode64 DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_decode64 IMPLEMENTATION.
+  METHOD run.
+    DATA lv_text TYPE string.
+    DATA lv_len TYPE i.
+
+    lv_text = cl_http_utility=>decode_base64( 'w6k=' ).
+    lv_len = strlen( lv_text ).
+    rv = |padded:{ lv_text }/{ lv_len }|.
+
+    lv_text = cl_http_utility=>decode_base64( 'w6k' ).
+    lv_len = strlen( lv_text ).
+    rv = |{ rv } unpadded:{ lv_text }/{ lv_len }|.
+
+    lv_text = cl_http_utility=>decode_base64( '5pel5pys6Kqe' ).
+    lv_len = strlen( lv_text ).
+    rv = |{ rv } multibyte:{ lv_text }/{ lv_len }|.
+
+    lv_text = cl_http_utility=>decode_base64( '8J+YgA==' ).
+    rv = |{ rv } standard:{ lv_text }|.
+
+    lv_text = cl_http_utility=>decode_base64( '8J-YgA' ).
+    rv = |{ rv } url:{ lv_text }|.
+
+    lv_text = cl_http_utility=>decode_base64( '8J@+YgA==suffix' ).
+    rv = |{ rv } extraneous:{ lv_text }|.
+
+    lv_text = cl_http_utility=>decode_base64( '4YBB' ).
+    lv_len = strlen( lv_text ).
+    rv = |{ rv } continuation:{ lv_text }/{ lv_len }|.
+
+    lv_text = cl_http_utility=>decode_base64( '4ICA' ).
+    lv_len = strlen( lv_text ).
+    rv = |{ rv } codepoint:{ lv_text }/{ lv_len }|.
+
+    lv_text = cl_http_utility=>decode_base64( '4oI=' ).
+    lv_len = strlen( lv_text ).
+    rv = |{ rv } incomplete:{ lv_text }/{ lv_len }|.
+
+    lv_text = cl_http_utility=>decode_base64( 'QeGAQg==' ).
+    lv_len = strlen( lv_text ).
+    rv = |{ rv } around:{ lv_text }/{ lv_len }|.
+  ENDMETHOD.
+ENDCLASS.
