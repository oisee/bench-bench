diff --git a/tools/gogen/go/nodeutf8/nodeutf8.go b/tools/gogen/go/nodeutf8/nodeutf8.go
new file mode 100644
index 0000000..4605822
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/nodeutf8.go
@@ -0,0 +1,101 @@
+// Package nodeutf8 decodes raw bytes using Node.js Buffer's UTF-8 replacement
+// behavior.
+package nodeutf8
+
+import (
+	"strings"
+	"unicode/utf8"
+)
+
+// Decode interprets b as UTF-8, replacing malformed sequences with U+FFFD in
+// the same way as Buffer.from(b).toString() in Node.js.
+func Decode(b string) string {
+	if utf8.ValidString(b) {
+		return b
+	}
+
+	var out strings.Builder
+	out.Grow(len(b))
+	for i := 0; i < len(b); {
+		c := b[i]
+		if c < 0x80 {
+			out.WriteByte(c)
+			i++
+			continue
+		}
+
+		switch {
+		case c >= 0xC2 && c <= 0xDF:
+			if i+1 < len(b) && continuation(b[i+1]) {
+				out.WriteString(b[i : i+2])
+				i += 2
+			} else {
+				out.WriteRune(utf8.RuneError)
+				i++
+			}
+
+		case c >= 0xE0 && c <= 0xEF:
+			if i+1 >= len(b) || !validSecond(c, b[i+1]) {
+				out.WriteRune(utf8.RuneError)
+				i++
+				continue
+			}
+			if i+2 >= len(b) || !continuation(b[i+2]) {
+				// A valid lead and second byte form one maximal subpart even
+				// when the third byte is missing or is not a continuation.
+				out.WriteRune(utf8.RuneError)
+				i += 2
+				continue
+			}
+			out.WriteString(b[i : i+3])
+			i += 3
+
+		case c >= 0xF0 && c <= 0xF4:
+			if i+1 >= len(b) || !validSecond(c, b[i+1]) {
+				out.WriteRune(utf8.RuneError)
+				i++
+				continue
+			}
+			if i+2 >= len(b) || !continuation(b[i+2]) {
+				out.WriteRune(utf8.RuneError)
+				i += 2
+				continue
+			}
+			if i+3 >= len(b) || !continuation(b[i+3]) {
+				// The three-byte prefix is one maximal subpart.
+				out.WriteRune(utf8.RuneError)
+				i += 3
+				continue
+			}
+			out.WriteString(b[i : i+4])
+			i += 4
+
+		default:
+			// Continuation bytes, overlong leads, and leads beyond U+10FFFF
+			// each produce their own replacement character.
+			out.WriteRune(utf8.RuneError)
+			i++
+		}
+	}
+	return out.String()
+}
+
+func continuation(c byte) bool { return c >= 0x80 && c <= 0xBF }
+
+func validSecond(lead, second byte) bool {
+	if !continuation(second) {
+		return false
+	}
+	switch lead {
+	case 0xE0:
+		return second >= 0xA0 // prevent overlong encodings
+	case 0xED:
+		return second <= 0x9F // exclude UTF-16 surrogate code points
+	case 0xF0:
+		return second >= 0x90 // prevent overlong encodings
+	case 0xF4:
+		return second <= 0x8F // limit to U+10FFFF
+	default:
+		return true
+	}
+}
diff --git a/tools/gogen/go/nodeutf8/nodeutf8_test.go b/tools/gogen/go/nodeutf8/nodeutf8_test.go
new file mode 100644
index 0000000..f4b8b8b
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/nodeutf8_test.go
@@ -0,0 +1,31 @@
+package nodeutf8
+
+import "testing"
+
+func TestDecode(t *testing.T) {
+	tests := []struct {
+		name string
+		in   string
+		want string
+	}{
+		{name: "ascii", in: "plain ASCII", want: "plain ASCII"},
+		{name: "valid multibyte", in: "é日本語😀", want: "é日本語😀"},
+		{name: "bad second byte", in: string([]byte{0xE2, '(', 0xA1}), want: "�(�"},
+		{name: "bad third byte", in: string([]byte{0xE1, 0x80, 'A'}), want: "�A"},
+		{name: "bad fourth byte", in: string([]byte{0xF0, 0x90, 0x80, 'A'}), want: "�A"},
+		{name: "overlong", in: string([]byte{0xE0, 0x80, 0x80}), want: "���"},
+		{name: "surrogate", in: string([]byte{0xED, 0xA0, 0x80}), want: "���"},
+		{name: "above maximum", in: string([]byte{0xF4, 0x90, 0x80, 0x80}), want: "����"},
+		{name: "invalid lead", in: string([]byte{0xF5, 0x80, 0x80, 0x80}), want: "����"},
+		{name: "incomplete three byte sequence", in: string([]byte{0xE2, 0x82}), want: "�"},
+		{name: "incomplete four byte sequence", in: string([]byte{0xF0, 0x90, 0x80}), want: "�"},
+		{name: "valid text around malformed bytes", in: "left " + string([]byte{0xE1, 0x80}) + " right", want: "left � right"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := Decode(tt.in); got != tt.want {
+				t.Errorf("Decode(%q) = %q, want %q", tt.in, got, tt.want)
+			}
+		})
+	}
+}
