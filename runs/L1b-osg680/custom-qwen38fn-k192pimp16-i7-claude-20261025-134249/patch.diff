+// TestDecodeBase64: Buffer.from(encoded, "base64").toString() as Node 22
+// answers it (the vectors generated from Node): padded and unpadded the
+// same, the URL-safe alphabet, junk ignored and padding a stop, and the
+// bytes read as UTF-8 with one U+FFFD per ill-formed sequence.
+func TestDecodeBase64(t *testing.T) {
+	for _, tc := range []struct{ encoded, hex string }{
+		{"aGVsbG8=", "68656C6C6F"},
+		{"aGVsbG8", "68656C6C6F"},
+		{"w6Q=", "C3A4"},
+		{"w6Q", "C3A4"},
+		{"5LKt", "E4B2AD"},
+		{"8J+YuQ==", "F09F98B9"},
+		{"8J-YuQ==", "F09F98B9"}, // URL-safe
+		{"wIA=", "EFBFBDEFBFBD"}, // C0 80: overlong
+		{"YcCAYg==", "61EFBFBDEFBFBD62"},
+		{"7aCA", "EFBFBDEFBFBDEFBFBD"}, // ED A0 80: a surrogate
+		{"4KA=", "EFBFBD"},             // E0 A0: truncated
+		{"+/+/", "EFBFBDEFBFBDEFBFBD"},
+		{"-_-_", "EFBFBDEFBFBDEFBFBD"}, // the same bytes URL-safe
+		{"AA==", "00"},
+		{"", ""},
+		{"====", ""},
+		{"a=b", ""},
+		{"aGVsb3y=XX", "68656C6F7C"}, // stops at the padding
+		{"a b c", "69EFBFBD"},
+		{"aGVs_b3y", "68656CEFBFBDEFBFBDEFBFBD"},
+	} {
+		want, _ := hex.DecodeString(tc.hex)
+		if got := DecodeBase64(&Session{}, tc.encoded); got != string(want) {
+			t.Errorf("DecodeBase64(%q) = %x, want %x", tc.encoded, got, want)
+		}
+	}
+}
