 package abap
 
+import "osg/gogen/nodeutf8"
+
 // EncodeBase64 is cl_http_utility=>encode_base64: Buffer.from(text), its
 // UTF-8 bytes, as base64 (open-abap-core's kernel lines; authenticate's
 // Basic header). A system converts the text in its own code page first;
@@ -7,3 +9,12 @@ package abap
 func EncodeBase64(s *Session, unencoded string) string {
 	return EncodeXBase64(s, unencoded)
 }
+
+// DecodeBase64 is cl_http_utility=>decode_base64: Buffer.from(encoded,
+// "base64").toString() (open-abap-core's kernel lines). The bytes of
+// base64 as open-abap-core has them, read as UTF-8 the way Node does:
+// every ill-formed sequence becomes one U+FFFD (nodeutf8), so the
+// text's strlen counts characters, not bytes.
+func DecodeBase64(s *Session, encoded string) string {
+	return nodeutf8.Decode(DecodeXBase64(s, encoded))
+}
diff --git a/tools/gogen/go/nodeutf8/nodeutf8.go b/tools/gogen/go/nodeutf8/nodeutf8.go
new file mode 100644
index 0000000..9810ae5
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/nodeutf8.go
@@ -0,0 +1,103 @@
+// Package nodeutf8 decodes bytes as Node does: Buffer.from(b).toString()
+// reads them as UTF-8 and replaces every ill-formed sequence with one
+// U+FFFD, so the result is always valid UTF-8 and its characters are what
+// ABAP string operations then see.
+package nodeutf8
+
+import "unicode/utf8"
+
+// Decode is Node's Buffer.from(b).toString(): the raw bytes of b read as
+// UTF-8. Well-formed input passes through untouched; each ill-formed
+// sequence (an invalid lead, an unexpected continuation, an overlong,
+// surrogate or out-of-range encoding, a truncated one) becomes exactly
+// one U+FFFD, and the valid text around it is kept. The boundaries are
+// the Unicode maximal subparts, which Node's decoder (the WHATWG
+// encoding spec) follows and Go's utf8 package does not, so the state
+// machine is written out; the replacement counts agree byte for byte.
+func Decode(b string) string {
+	// valid UTF-8 is its own text: no scan, no copy
+	if utf8.ValidString(b) {
+		return b
+	}
+	out := make([]byte, 0, len(b))
+	for i := 0; i < len(b); {
+		c := b[i]
+		switch {
+		case c < 0x80:
+			out = append(out, c)
+			i++
+		case c < 0xC2, c >= 0xF5:
+			// 80 to BF: a continuation byte with nothing before it;
+			// C0 and C1 (overlong for nothing), F5 to FF: no encoding
+			// starts here, one byte is the whole maximal subpart
+			out = append(out, 0xEF, 0xBF, 0xBD)
+			i++
+		case c < 0xE0:
+			i = two(&out, b, i, 0x80, 0xBF)
+		case c == 0xE0:
+			i = three(&out, b, i, 0xA0, 0xBF)
+		case c == 0xED:
+			i = three(&out, b, i, 0x80, 0x9F)
+		case c < 0xF0:
+			i = three(&out, b, i, 0x80, 0xBF)
+		case c == 0xF0:
+			i = four(&out, b, i, 0x90, 0xBF)
+		case c == 0xF4:
+			i = four(&out, b, i, 0x80, 0x8F)
+		default:
+			// F1 to F3: the four-byte leads in range need any
+			// continuation bytes
+			i = four(&out, b, i, 0x80, 0xBF)
+		}
+	}
+	return string(out)
+}
+
+// two reads a lead of b[i] and its one constrained continuation byte:
+// the pair is kept when both are there, else one U+FFFD stands for the
+// maximal subpart, the lead alone, which is what the scan consumes
+func two(out *[]byte, b string, i int, lo, hi byte) int {
+	if i+1 < len(b) && b[i+1] >= lo && b[i+1] <= hi {
+		*out = append(*out, b[i], b[i+1])
+		return i + 2
+	}
+	*out = append(*out, 0xEF, 0xBF, 0xBD)
+	return i + 1
+}
+
+// three reads a lead with one constrained continuation byte and one
+// plain one: the bytes are kept when the sequence is complete, else one
+// U+FFFD stands for the maximal subpart, which is what the scan
+// consumes either way
+func three(out *[]byte, b string, i int, lo, hi byte) int {
+	n := 1
+	if i+1 < len(b) && b[i+1] >= lo && b[i+1] <= hi {
+		n = 2
+		if i+2 < len(b) && b[i+2] >= 0x80 && b[i+2] <= 0xBF {
+			*out = append(*out, b[i:i+3]...)
+			return i + 3
+		}
+	}
+	*out = append(*out, 0xEF, 0xBF, 0xBD)
+	return i + n
+}
+
+// four reads a lead with one constrained continuation byte and two
+// plain ones, three() one more: the bytes are kept when the sequence is
+// complete, else one U+FFFD stands for the maximal subpart, which is
+// what the scan consumes either way
+func four(out *[]byte, b string, i int, lo, hi byte) int {
+	n := 1
+	if i+1 < len(b) && b[i+1] >= lo && b[i+1] <= hi {
+		n = 2
+		if i+2 < len(b) && b[i+2] >= 0x80 && b[i+2] <= 0xBF {
+			n = 3
+			if i+3 < len(b) && b[i+3] >= 0x80 && b[i+3] <= 0xBF {
+				*out = append(*out, b[i:i+4]...)
+				return i + 4
+			}
+		}
+	}
+	*out = append(*out, 0xEF, 0xBF, 0xBD)
+	return i + n
+}
