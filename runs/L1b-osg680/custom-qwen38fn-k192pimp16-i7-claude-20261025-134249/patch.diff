+CLASS zcl_gogen_t_b64dec DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_b64dec IMPLEMENTATION.
+  METHOD run.
+    DATA lv_s TYPE string.
+    lv_s = cl_http_utility=>decode_base64( 'aGVsbG8=' ).
+    rv = |p:{ lv_s }/{ strlen( lv_s ) }|.
+    lv_s = cl_http_utility=>decode_base64( 'aGVsbG8' ).
+    rv = |{ rv } u:{ lv_s }/{ strlen( lv_s ) }|.
+    lv_s = cl_http_utility=>decode_base64( 'w6Q' ).
+    rv = |{ rv } mb:{ lv_s }/{ strlen( lv_s ) }|.
+    lv_s = cl_http_utility=>decode_base64( '-_-_' ).
+    rv = |{ rv } url:{ lv_s }/{ strlen( lv_s ) }|.
+    lv_s = cl_http_utility=>decode_base64( 'wIA=' ).
+    rv = |{ rv } bad:{ lv_s }/{ strlen( lv_s ) }|.
+    lv_s = cl_http_utility=>decode_base64( 'YcCAYg==' ).
+    rv = |{ rv } mix:{ lv_s }/{ strlen( lv_s ) }|.
+    IF cl_http_utility=>decode_base64( 'aGVsbG8=' ) = cl_http_utility=>decode_base64( 'aGVsbG8' ).
+      rv = |{ rv } eq:X|.
+    ENDIF.
+    lv_s = cl_http_utility=>decode_base64( 'a b c' ).
+    rv = |{ rv } garb:{ lv_s }/{ strlen( lv_s ) }|.
+    lv_s = cl_http_utility=>decode_base64( 'aGVsb3y=XX' ).
+    rv = |{ rv } stop:{ lv_s }/{ strlen( lv_s ) }|.
+  ENDMETHOD.
+ENDCLASS.
