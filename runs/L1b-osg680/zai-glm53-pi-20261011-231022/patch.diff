@@ -0,0 +1,50 @@
+* decode_base64 against Node 26.9 (Buffer.from(encoded, "base64").toString( )),
+* the kernel-line reference, not an A4H value.
+CLASS ltc DEFINITION FOR TESTING RISK LEVEL HARMLESS DURATION SHORT.
+  PRIVATE SECTION.
+    METHODS padded_and_unpadded FOR TESTING.
+    METHODS url_safe_alphabet FOR TESTING.
+    METHODS foreign_bytes_ignored FOR TESTING.
+    METHODS multibyte_text FOR TESTING.
+    METHODS replacement_characters FOR TESTING.
+    METHODS empty FOR TESTING.
+ENDCLASS.
+CLASS ltc IMPLEMENTATION.
+  METHOD padded_and_unpadded.
+    cl_abap_unit_assert=>assert_equals( act = cl_http_utility=>decode_base64( 'YWJhcA==' ) exp = 'abap' ).
+    cl_abap_unit_assert=>assert_equals( act = cl_http_utility=>decode_base64( 'YWJhcA' ) exp = 'abap' ).
+  ENDMETHOD.
+  METHOD url_safe_alphabet.
+    cl_abap_unit_assert=>assert_equals( act = cl_http_utility=>decode_base64( '++//' )
+                                        exp = cl_http_utility=>decode_base64( '--__' ) ).
+    " a-b_c: 6B E6 FF, the k kept, one U+FFFD per malformed byte
+    cl_abap_unit_assert=>assert_equals( act = strlen( cl_http_utility=>decode_base64( 'a-b_c' ) ) exp = 3 ).
+  ENDMETHOD.
+  METHOD foreign_bytes_ignored.
+    cl_abap_unit_assert=>assert_equals( act = cl_http_utility=>decode_base64( 'Y WJhcA==' ) exp = 'abap' ).
+    cl_abap_unit_assert=>assert_equals( act = cl_http_utility=>decode_base64( 'YQ==YQ==' ) exp = 'a' ).
+  ENDMETHOD.
+  METHOD multibyte_text.
+    " 入報键 (E585A5 E5A0B1 E994AE) and übf (C3BC 6266)
+    cl_abap_unit_assert=>assert_equals( act = cl_http_utility=>decode_base64( '5YWl5aCx6ZSu' ) exp = '入報键' ).
+    cl_abap_unit_assert=>assert_equals( act = strlen( cl_http_utility=>decode_base64( '5YWl5aCx6ZSu' ) ) exp = 3 ).
+    cl_abap_unit_assert=>assert_equals( act = cl_http_utility=>decode_base64( 'w7xiZg==' ) exp = 'übf' ).
+    " 8J+Mhgy=: F0 9F 8C 86 0C, one supplementary character plus \f, three units
+    cl_abap_unit_assert=>assert_equals( act = strlen( cl_http_utility=>decode_base64( '8J+Mhgy=' ) ) exp = 3 ).
+  ENDMETHOD.
+  METHOD replacement_characters.
+    DATA lv_repl TYPE string.
+    " 77+9 is U+FFFD itself; wIAB is C0 80 01: two U+FFFD, the \x01 kept
+    lv_repl = cl_http_utility=>decode_base64( '77+9' ).
+    cl_abap_unit_assert=>assert_equals( act = cl_http_utility=>decode_base64( 'wIAB' )
+                                        exp = lv_repl && lv_repl && cl_abap_conv_in_ce=>uccpi( 1 ) ).
+    " 8J+Q is an incomplete F0 9F 90 at the end: one U+FFFD
+    cl_abap_unit_assert=>assert_equals( act = cl_http_utility=>decode_base64( '8J+Q' ) exp = lv_repl ).
+    " hoky is 86 89 32: two U+FFFD, the 2 kept
+    cl_abap_unit_assert=>assert_equals( act = cl_http_utility=>decode_base64( 'hoky' )
+                                        exp = lv_repl && lv_repl && '2' ).
+  ENDMETHOD.
+  METHOD empty.
+    cl_abap_unit_assert=>assert_equals( act = cl_http_utility=>decode_base64( '' ) exp = '' ).
+  ENDMETHOD.
+ENDCLASS.
