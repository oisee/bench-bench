diff --git a/tools/gogen/go/abap/b64decode_test.go b/tools/gogen/go/abap/b64decode_test.go
index c690cca..682a3e9 100644
--- a/tools/gogen/go/abap/b64decode_test.go
+++ b/tools/gogen/go/abap/b64decode_test.go
@@ -19,3 +19,37 @@ func TestDecodeXBase64(t *testing.T) {
 		}
 	}
 }
+
+// cl_http_utility=>decode_base64: Buffer.from(encoded, "base64").toString( )
+// on Node 26.9 gave every answer (the text re-encoded as UTF-8, so the
+// replacements and the kept text are both pinned).
+func TestDecodeBase64(t *testing.T) {
+	for _, tc := range []struct{ encoded, text string }{
+		{"YWJhcA==", "abap"},  // padded
+		{"YWJhcA", "abap"},    // and unpadded: the same text
+		{"Y WJhcA==", "abap"}, // foreign bytes ignored
+		{"Y@WJhcA==", "abap"},
+		{"Y\r\nQ==", "a"},
+		{"YQ==YQ==", "a"},        // decoding stops at the padding
+		{"ab=cdef", "i"},         // a padding mid-stream stops it
+		{"abcde", "i�\x1d"},      // a lone trailing character is dropped
+		{"++//", "���"},          // standard alphabet
+		{"--__", "���"},          // URL-safe: the same bytes
+		{"a-b_c", "k��"},         // and both mixed
+		{"5YWl5aCx6ZSu", "入報键"},  // valid multibyte UTF-8 kept
+		{"5YWl5aCx6ZSu=", "入報键"}, // one padding on a multiple of three
+		{"w7xiZg==", "übf"},
+		{"8J+Mhgy=", "🌆\f"}, // a supplementary character, kept whole
+		{"77+9", "�"},       // an encoded U+FFFD is valid text
+		{"wIAB", "��\x01"},  // overlong NUL: two replacements, the \x01 kept
+		{"7aCg", "���"},     // a surrogate encoded (ED A0 80): three replacements
+		{"34Lk", "߂�"},      // a valid character, then a dangling lead
+		{"8J+Q", "�"},       // incomplete at the end
+		{"hoky", "��2"},     // invalid continuations, the 2 kept
+		{"", ""},
+	} {
+		if got := DecodeBase64(&Session{}, tc.encoded); got != tc.text {
+			t.Errorf("DecodeBase64(%q) = %q, want %q", tc.encoded, got, tc.text)
+		}
+	}
+}
