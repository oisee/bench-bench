diff --git a/tools/gogen/go/nodeutf8/nodeutf8.go b/tools/gogen/go/nodeutf8/nodeutf8.go
new file mode 100644
index 0000000..9efdd90
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/nodeutf8.go
@@ -0,0 +1,90 @@
+// Node's text interpretation of raw bytes: Buffer.prototype.toString("utf8"),
+// the WHATWG "UTF-8 decode" algorithm without BOM
+// (encoding.spec.whatwg.org#utf-8-decoder). Valid sequences become their
+// characters and are kept as they are; every maximal subpart of an
+// ill-formed sequence becomes exactly one U+FFFD, so the valid text around
+// malformed bytes survives; no byte order mark is stripped (Node keeps a
+// leading EF BB BF as U+FEFF). go/apc carries the same algorithm inline,
+// private to it, for query strings; this package is the public one for
+// text that came out of bytes the host decoded itself (base64 today).
+package nodeutf8
+
+import (
+	"strings"
+	"unicode/utf8"
+)
+
+// Decode returns the Node-compatible UTF-8 text interpretation of the raw
+// bytes b: what Buffer.from(b).toString( ) gives on Node. A Go string holds
+// raw bytes, so ill-formed UTF-8 reaches this unchanged, and the output is
+// always valid UTF-8 with U+FFFD (EF BF BD) where Node would put one:
+// an invalid continuation ends the subpart and is read again as the start
+// of the next sequence, an overlong form, a surrogate or a code point above
+// U+10FFFF fails on its narrowed first continuation byte, and a lead byte
+// without its continuations at the end is one U+FFFD.
+func Decode(b string) string {
+	if utf8.ValidString(b) {
+		// valid UTF-8 decodes to itself: the common case of a text that
+		// was UTF-8 all along, and Node's answer to it is the bytes
+		return b
+	}
+	var out strings.Builder
+	out.Grow(len(b))
+	// the decoder state: how many continuation bytes are still expected
+	// (need, of which seen are read), the partial code point, and the range
+	// the next continuation byte may lie in. The range is narrowed for the
+	// first continuation after E0, ED, F0 and F4, which is what rules out
+	// overlong forms, surrogates and code points above U+10FFFF.
+	need, seen := 0, 0
+	var cp rune
+	lower, upper := byte(0x80), byte(0xbf)
+	for i := 0; i < len(b); i++ {
+		c := b[i]
+		if need == 0 {
+			switch {
+			case c <= 0x7f:
+				out.WriteByte(c)
+			case c >= 0xc2 && c <= 0xdf:
+				need, cp = 1, rune(c&0x1f)
+			case c >= 0xe0 && c <= 0xef:
+				if c == 0xe0 {
+					lower = 0xa0
+				} else if c == 0xed {
+					upper = 0x9f
+				}
+				need, cp = 2, rune(c&0x0f)
+			case c >= 0xf0 && c <= 0xf4:
+				if c == 0xf0 {
+					lower = 0x90
+				} else if c == 0xf4 {
+					upper = 0x8f
+				}
+				need, cp = 3, rune(c&0x07)
+			default: // 0x80..0xc1 and 0xf5..0xff never begin a sequence
+				out.WriteRune(utf8.RuneError)
+			}
+			continue
+		}
+		if c < lower || c > upper {
+			// the maximal subpart of the ill-formed sequence ends here: one
+			// U+FFFD for it, and the byte that broke it is read again as
+			// the start of a sequence
+			need, seen, cp = 0, 0, 0
+			lower, upper = 0x80, 0xbf
+			out.WriteRune(utf8.RuneError)
+			i--
+			continue
+		}
+		lower, upper = 0x80, 0xbf
+		cp = cp<<6 | rune(c&0x3f)
+		seen++
+		if seen == need {
+			out.WriteRune(cp)
+			need, seen, cp = 0, 0, 0
+		}
+	}
+	if need != 0 { // a lead byte whose continuations ran out at the end
+		out.WriteRune(utf8.RuneError)
+	}
+	return out.String()
+}
diff --git a/tools/gogen/go/nodeutf8/nodeutf8_test.go b/tools/gogen/go/nodeutf8/nodeutf8_test.go
