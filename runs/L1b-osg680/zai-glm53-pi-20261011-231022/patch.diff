index 0000000..0674b5d
--- /dev/null
+++ b/tools/gogen/go/nodeutf8/nodeutf8_test.go
@@ -0,0 +1,50 @@
+package nodeutf8
+
+import (
+	"encoding/hex"
+	"testing"
+)
+
+// every expectation below is Node's answer: Buffer.from(bytes).toString( )
+// on Node 26.9, re-encoded as UTF-8 for the table (an all-oracle run of
+// every 1-, 2- and 3-byte string over a lead/continuation alphabet, and
+// 4-byte strings over a lead-focused one, agrees on all 12522 cases)
+func TestDecode(t *testing.T) {
+	for _, tc := range []struct{ bytes, text string }{
+		{"", ""},
+		{"61", "a"},
+		{"61c3a4e282ac", "aä€"},   // valid, multibyte kept
+		{"efbbbf61", "\ufeffa"},   // a byte order mark is a character, not stripped
+		{"efbfbd", "�"},           // an encoded U+FFFD is valid text
+		{"f09f9880c3a92a", "😀é*"}, // four-byte and two-byte around ASCII
+		{"f48fbfbf", "􏿿"},         // U+10FFFF, the largest code point
+		{"c328", "�("},            // invalid continuation: U+FFFD, the byte reread
+		{"c241", "�A"},
+		{"c080", "��"}, // overlong NUL: two maximal subparts
+		{"c1bf", "��"},
+		{"e08080", "���"},    // overlong three-byte form
+		{"e09f80", "���"},    // E0's first continuation must be A0..BF
+		{"f0808080", "����"}, // overlong four-byte form
+		{"f08fbfbf", "����"}, // F0's first continuation must be 90..BF
+		{"eda080", "���"},    // U+D800 encoded: a surrogate is ill-formed
+		{"edbfbf", "���"},    // U+DFFF
+		{"f4908080", "����"}, // above U+10FFFF
+		{"808080", "���"},    // continuations without a lead
+		{"fffe", "��"},       // never bytes of a sequence
+		{"c2", "�"},          // incomplete at the end: one U+FFFD
+		{"e282", "�"},
+		{"f09f98", "�"},
+		{"e180", "�"},
+		{"61ff62", "a�b"},             // valid text around a malformed byte survives
+		{"df82e4", "߂�"},              // a valid character, then a dangling lead
+		{"e282acf09f9880c3a9", "€😀é"}, // valid multibyte run
+	} {
+		b, err := hex.DecodeString(tc.bytes)
+		if err != nil {
+			t.Fatalf("bad hex %q: %v", tc.bytes, err)
+		}
+		if got := Decode(string(b)); got != tc.text {
+			t.Errorf("Decode(%s) = %q, want %q", tc.bytes, got, tc.text)
+		}
+	}
+}
