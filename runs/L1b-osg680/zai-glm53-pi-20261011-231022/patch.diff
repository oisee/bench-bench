diff --git a/tools/gogen/testdata/zcl_gogen_t_b64dec.clas.abap b/tools/gogen/testdata/zcl_gogen_t_b64dec.clas.abap
new file mode 100644
index 0000000..3a2fdbc
--- /dev/null
+++ b/tools/gogen/testdata/zcl_gogen_t_b64dec.clas.abap
@@ -0,0 +1,52 @@
+* Not an A4H value: decode_base64's kernel lines on Node are the reference
+* (Buffer.from(encoded, "base64").toString( )), as they are for encode. The
+* Go host function abap.DecodeBase64 is pinned against Node 26.9; a system
+* would decode the bytes in its code page instead. one( ) prints the decoded
+* text back as UTF-8 hex (so replacements and kept text are both visible)
+* and strlen( ) of it, which counts UTF-16 units.
+CLASS zcl_gogen_t_b64dec DEFINITION PUBLIC FINAL CREATE PUBLIC.
+  PUBLIC SECTION.
+    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
+  PRIVATE SECTION.
+    CLASS-METHODS hex IMPORTING encoded      TYPE string
+                      RETURNING VALUE(rv) TYPE string.
+    CLASS-METHODS one IMPORTING label        TYPE string
+                                encoded      TYPE string
+                      RETURNING VALUE(rv) TYPE string.
+ENDCLASS.
+
+CLASS zcl_gogen_t_b64dec IMPLEMENTATION.
+  METHOD run.
+    rv = one( label = 'std'  encoded = 'YWJhcA==' ).
+    rv = rv && one( label = 'nopad' encoded = 'YWJhcA' ).
+    rv = rv && one( label = 'space' encoded = 'Y WJhcA==' ).
+    rv = rv && one( label = 'std2'  encoded = '++//' ).
+    rv = rv && one( label = 'url'   encoded = '--__' ).
+    rv = rv && one( label = 'mix'   encoded = 'a-b_c' ).
+    rv = rv && one( label = 'cjk'   encoded = '5YWl5aCx6ZSu' ).
+    rv = rv && one( label = 'lat'   encoded = 'w7xiZg==' ).
+    rv = rv && one( label = 'sup'   encoded = '8J+Mhgy=' ).
+    rv = rv && one( label = 'over'  encoded = 'wIAB' ).
+    rv = rv && one( label = 'sur'   encoded = '7aCg' ).
+    rv = rv && one( label = 'cut'   encoded = '34Lk' ).
+    rv = rv && one( label = 'inc'   encoded = '8J+Q' ).
+    rv = rv && one( label = 'cont'  encoded = 'hoky' ).
+    rv = rv && one( label = 'pad'   encoded = 'YQ==YQ==' ).
+    rv = rv && one( label = 'drop'  encoded = 'abcde' ).
+    rv = rv && | e:[]:{ strlen( cl_http_utility=>decode_base64( '' ) ) }|.
+  ENDMETHOD.
+
+  METHOD hex.
+    DATA lo_out TYPE REF TO cl_abap_conv_out_ce.
+    DATA lv_x TYPE xstring.
+    DATA lv_s TYPE string.
+    lv_s = cl_http_utility=>decode_base64( encoded ).
+    lo_out = cl_abap_conv_out_ce=>create( encoding = 'UTF-8' ).
+    lo_out->convert( EXPORTING data = lv_s IMPORTING buffer = lv_x ).
+    rv = |{ lv_x }|.
+  ENDMETHOD.
+
+  METHOD one.
+    rv = | { label }:[{ hex( encoded ) }]:{ strlen( cl_http_utility=>decode_base64( encoded ) ) }|.
+  ENDMETHOD.
+ENDCLASS.
diff --git a/tools/gogen/testdata/zcl_gogen_t_b64dec.clas.testclasses.abap b/tools/gogen/testdata/zcl_gogen_t_b64dec.clas.testclasses.abap
