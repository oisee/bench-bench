# Copy to .env (git-ignored) and fill in what you use. bin/*.sh load it automatically;
# plain environment variables work too.

# --- Your own model: any OpenAI- or Anthropic-compatible endpoint (vLLM, SGLang, Ollama, OpenRouter, ...) ---
# Used by executors with "provider: custom" in matrix.yaml.
CUSTOM_BASE_URL=https://llm.example.com/v1       # OpenAI-style base URL, usually ends in /v1
CUSTOM_API_KEY=                                  # empty if the endpoint is open
# CUSTOM_ANTHROPIC_BASE_URL=https://llm.example.com   # for harness claude; default: CUSTOM_BASE_URL minus /v1
# CUSTOM_PI_API=openai-completions               # harness pi: openai-completions | openai-responses | anthropic-messages
# CUSTOM_CONTEXT_WINDOW=131072
# CUSTOM_MAX_TOKENS=32768                        # harness pi: max output tokens per call
# BENCH_RECORD=1                                 # log every request/response to runs/.../traffic.jsonl

# --- Hosted providers used in the published runs ---
# ANTHROPIC_API_KEY=      # only if you are not logged in to Claude Code (claude /login)
# OPENAI_API_KEY=         # only if you are not logged in to Codex (codex login)
# ZAI_API_KEY=
# ALI_CP_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
